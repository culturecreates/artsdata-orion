    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Ring In 2027 in Style!  End the year on a high note at The Rex! Enjoy a lively evening of&nbsp;live funk, soul, and R&B, our&nbsp;full dinner menu, and a&nbsp;bubbly toast at midnight.  This year’s returning headliners,&nbsp;Grooveyard, are guaranteed to keep you grooving all"
      }
