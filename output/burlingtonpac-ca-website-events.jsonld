        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "The Other Mozart - The forgotten story of Mozart’s genius sister - The Burlington Performing Arts Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "The Other Mozart is an award-winning, Drama Desk nominated play telling the true, forgotten story of Nannerl Mozart, the genius sister of Amadeus, who performed throughout Europe alongside him to equal acclaim, but her work and her story faded away, lost to history."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "en-ca",
