      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Few artists have shaped the soundtrack of Canadian life like Jim Cuddy. As the unmistakable voice behind countless beloved songs - both as a celebrated solo artist and as a founding member of Blue Rodeo - Cuddy returns with music from his acclaimed album All the World Fades Away."
      }
    ],
