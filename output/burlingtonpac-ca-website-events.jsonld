        "@language": "en-ca",
        "@value": "Classic Albums Live - Led Zeppelin IV - The Burlington Performing Arts Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A monumental album often considered a cornerstone of hard rock and heavy metal. Featuring iconic tracks like “Stairway to Heaven,” “Black Dog,” and “Rock and Roll,” it perfectly blended blues, folk, and hard rock, selling over 37 million copies worldwide."
      }
    ],
