    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Through direct storytelling, live music, and dance, the show examines misconceptions and varying perspectives around that battle, while drawing parallels to other formative events in our nation’s past."
      }
    ],
