        "@language": "en-ca",
        "@value": "WANDER - Free Culture Days Activity - The Burlington Performing Arts Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Wander will identify 15 unique spaces in and around the Centre - hidden corners, thresholds, and in-between places - and invite artists to animate them with bold, intimate, and imaginative work."
      }
    ],
