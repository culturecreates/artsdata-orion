    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "On Stage with Shakura S’Aida - The Burlington Performing Arts Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Acclaimed Canadian blues and soul vocalist Shakura S’Aida will lead an engaging behind-the-scenes session designed especially for high school music students."
