  {
    "@id": "https://burlingtonpac.ca/event/very-charlie-brown-christmas/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "en-ca",
        "@value": "en_US"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "A Very Charlie Brown Christmas Concert - The Burlington Performing Arts Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
