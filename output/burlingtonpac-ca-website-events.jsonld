      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Modern Biology has brought 'plant music' to the masses. Originally educated as a biologist, veteran musician Tarun Nayar brings his passion for nature and sound together in an ambient project that is organismic, immediate, uplifting, and deeply contextual."
      }
    ],
