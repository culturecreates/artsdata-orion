  {
    "@id": "https://spectart.com/genid/65caaadaf92860a4",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spectart.com/panama-au-rythme-du-monde/"
      }
    ],
    "http://schema.org/image": [
      {
