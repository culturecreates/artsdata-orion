    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Ludovick Bourgeois"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Plongez dans l&rsquo;univers festif des années 90 avec Karaoké 90, un spectacle où la nostalgie rencontre l&rsquo;énergie de la scène. Porté par un univers visuel immersif, le spectacle se déploie en plusieurs tableaux qui revisitent les plus grands succès ayant marqué cette décennie, d&rsquo;ici et d&rsquo;ailleurs. Entouré de ses musiciens, Ludovick Bourgeois invite le public à chanter, danser et revivre les classiques qui ont accompagné toute une génération. Entre pop, rock, ballades et incontournables québécois, chaque moment est pensé pour créer une expérience rassembleuse où les souvenirs prennent vie. Karaoké 90, c&rsquo;est une célébration de la musique qui rassemble, un spectacle interactif où le public devient lui aussi une partie du spectacle.n&nbsp;"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Ludovick Bourgeois"
      }
    ]
  },
