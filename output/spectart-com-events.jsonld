  {
    "@id": "https://spectart.com/temporary/cb3af2a0-21ce-47da-af7b-6f70841a63cc",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spectart.com/lobgesang/"
      }
    ],
    "http://schema.org/image": [
