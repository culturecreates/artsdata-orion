    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spectart.com/programmation/eve-cote/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Eve Côté"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Diplômée de l’École nationale de l’humour en 2014, Eve Côté revient sur la scène rimouskoise avec un spectacle-bénéfice au profit de la Fondation du Cégep de Rimouski. Avec son regard unique, son énergie contagieuse et son sens de la répartie, Eve Côté promet une soirée remplie de rires. À travers des anecdotes savoureuses et des observations du quotidien, laissez-vous séduire avec son charme gaspésien, sa dégaine et son humour imagé! Vous passerez un excellent moment… tout en soutenant une bonne cause !nUne soirée à ne pas manquer !"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Eve Côté"
      }
    ]
