    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Jean-Michel Blais"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Avec mirador, Jean-Michel Blais délaisse le minimalisme pour une œuvre ample et lumineuse inspirée de son enfance, de ses voyages et de ses racines. Accompagné sur scène d&rsquo;un trio de musiciens, cette une odyssée musicale mêle piano, chœurs, cordes et influences andines. Il puise dans les souvenirs de l’artiste – son refuge d’enfance à Nicolet, sa découverte de la musique latino-américaine et ses explorations en Amérique latine et en Estonie. Dans ce nouveau spectacle, Blais crée un univers riche où se croisent rêves, mémoire et imagination. À travers des pièces évocatrices comme « carnavalito », « kyrie » ou « granada », mirador devient une invitation à retrouver le regard émerveillé de l’enfance et à explorer ses paysages intérieurs."
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Jean-Michel Blais"
      }
    ]
  },
