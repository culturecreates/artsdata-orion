    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Véronic DiCaire"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Suite au succès de sa dernière tournée – gagnante du Félix du Spectacle de l’Année à l’ADISQ &#8211; Véronic DiCaire est enfin de retour avec son tout nouveau spectacle solo ! L’artiste aux multiples talents a le goût de se faire plaisir et propose au public un spectacle musical tissé des plus grands succès et des plus grandes voix qu’elle affectionne. Il y aura assurément de l’humour et des imitations, mais Véronic veut mettre cette fois-ci les émotions au premier plan.  Elle nous prépare donc un spectacle qui lui ressemble et qui promet de nous faire vivre une soirée exceptionnelle."
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Véronic DiCaire"
      }
    ]
  },
