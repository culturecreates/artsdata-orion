      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spectart.com/genid/26b4757236d99850"
      },
      {
        "@id": "https://spectart.com/genid/ae7ca649ad77e411"
      },
      {
        "@id": "https://spectart.com/genid/68b648b7983ec43e"
      },
      {
        "@id": "https://spectart.com/genid/3715c3be0513e9a0"
      },
      {
        "@id": "https://spectart.com/genid/7b1d78783562c6c4"
      },
      {
