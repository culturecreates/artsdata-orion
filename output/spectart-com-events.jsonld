  {
    "@id": "https://spectart.com/genid/87162e0e84cf36ae",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spectart.com/jean-michel-anctil/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://spectart.com/wp-content/uploads/2026/04/Jean-Michel20Anctil_-OqkuYs5LQor566sPZ9E_-1.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-02-28T16:00:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://spectart.com/genid/1f8756eb558472d8"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spectart.com/genid/66db6d9cf78aa0d7"
      },
      {
        "@id": "https://spectart.com/genid/59e4af017317ba28"
      },
      {
        "@id": "https://spectart.com/genid/f958f50207d713d2"
      },
      {
        "@id": "https://spectart.com/genid/6bb504dd7eddeeee"
