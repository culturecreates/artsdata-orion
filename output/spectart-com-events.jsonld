  {
    "@id": "https://spectart.com/genid/f1041f504f5a81c9",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spectart.com/devenir-fleuve/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://spectart.com/wp-content/uploads/2026/05/devenirfleuve-web.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-07T20:00:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://spectart.com/genid/1f8756eb558472d8"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spectart.com/genid/b80753461b95f48e"
      },
      {
        "@id": "https://spectart.com/genid/8cf08457bb9fb3a2"
      },
      {
        "@id": "https://spectart.com/genid/aa031f70b3e56867"
      },
      {
        "@id": "https://spectart.com/genid/44adc07c02f6ccb6"
      },
      {
        "@id": "https://spectart.com/genid/4405d1426aa2481c"
      },
      {
        "@id": "https://spectart.com/genid/cc98801290ebd748"
