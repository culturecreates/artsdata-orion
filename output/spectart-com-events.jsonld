    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Piaf & Aznavour : Les grandes chansons"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Retrouvez l’âme d’un Paris mythique, où les refrains deviennent des légendes et où chaque chanson raconte une histoire.nPorté par les voix de Mia Tinayre et Sam Champagne, et accompagnés sur scène par un groupe de musiciens, Piaf & Aznavour : Les grandes chansons vous convie à un voyage musical au cœur du Paris d’une autre époque, entre l’effervescence des cabarets, les amours passionnées et les nuits empreintes de poésie. De la ferveur bouleversante d’Édith Piaf à l’élégance intemporelle de Charles Aznavour, redécouvrez les chansons qui ont marqué des générations et fait rayonner la chanson française à travers le monde.n&nbsp;"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Piaf & Aznavour : Les grandes chansons"
      }
    ]
  },
