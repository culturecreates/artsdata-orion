  {
    "@id": "https://spectart.com/genid/89fe0315a6b35e88",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spectart.com/devenir-fleuve/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://spectart.com/wp-content/uploads/2026/05/devenirfleuve-web.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-07T20:00:00"
      }
    ],
    "http://schema.org/location": [
      {
