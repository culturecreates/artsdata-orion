      {
        "@id": "https://spectart.com/genid/f3f70cca085e899c"
      },
      {
        "@id": "https://spectart.com/genid/2b3f4a20130f9e5c"
      },
      {
        "@id": "https://spectart.com/genid/7e4b31352f685794"
