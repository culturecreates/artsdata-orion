  {
    "@id": "https://spectart.com/genid/2913d2cbbc2db7a7",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spectart.com/vitrine-de-spectacles-13/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://spectart.com/wp-content/uploads/2026/08/Vitrine20de20spectacles_-P-QT9vFIS7Wt6KlBRTG_.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-10-13T20:00:00"
      }
    ],
    "http://schema.org/location": [
      {
