      {
        "@id": "https://spectart.com/genid/47af081e90c8db2f"
      },
      {
        "@id": "https://spectart.com/genid/2a2180e5765699b6"
      },
      {
        "@id": "https://spectart.com/genid/ddfde253b6d0edae"
