    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Koriass"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Figure incontournable du rap québécois depuis le début des années 2000, Koriass s’est démarqué par sa plume percutante et son sens de la mélodie. Lauréat de plusieurs Félix et de distinctions SOCAN et GAMIQ, en plus d’avoir reçu des nominations aux JUNO, il a marqué la scène avec des albums comme Rue des Saules, Love Suprême et La Nuit des Longs Couteaux. Il revient avec Sept ans de malheur (titre temporaire), un nouvel album qui prendra bientôt vie sur scène dans un tout nouveau spectacle."
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Koriass"
      }
    ]
