      {
        "@id": "https://spectart.com/genid/2d3e2a72656d8712"
      },
      {
        "@id": "https://spectart.com/genid/456bab9c35bd74c9"
      },
      {
        "@id": "https://spectart.com/genid/3ae7366accb9da42"
