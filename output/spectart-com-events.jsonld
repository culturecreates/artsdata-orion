    ],
    "http://schema.org/image": [
      {
        "@id": "https://spectart.com/wp-content/uploads/2026/09/Patrick20Groulx_-P2ERBoKApZ6XLHMZrAe_.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-03-20T20:00:00"
      }
    ],
    "http://schema.org/location": [
