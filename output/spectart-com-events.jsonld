    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Sébastien Leblanc"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Plongez dans l&rsquo;univers envoûtant de Nordicité, le premier album instrumental du compositeur et guitariste Sébastien Leblanc. Accompagné du quatuor à cordes Esca, de Fred Bouchard à la batterie, d’Alex Lapointe à la basse et de Jocelyn Tellier à la guitare, Sébastien dévoile une suite de pièces à la fois douces et majestueuses. Inspiré par la nature, il nous transporte dans une expérience immersive où musique et projections s’imbriquent, évoquant la liberté et la solitude des grands espaces. Chaque note célèbre la beauté de notre nordicité, créant un refuge intime où s’entremêlent des souvenirs d’immensité, de joie et de tranquillité."
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Sébastien Leblanc"
      }
    ]
  },
