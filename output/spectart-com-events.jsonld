    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "MG3"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "​Considéré comme l’un des meilleurs ensembles au pays, le MG3: Montréal Guitare Trio impose sa virtuosité et son époustouflante présence scénique ici et à l’étranger depuis plus de 25 ans. Voilà que les trois guitaristes proposent un concert hommage à la mémoire du grand Ennio Morricone. Depuis les tout débuts, les musiques de cet illustre compositeur font partie du répertoire des trois comparses. Un concert lui est maintenant dédié, rehaussé comme il se doit de quelques surprises à la façon MG3 !n&nbsp;"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "MG3"
      }
    ]
  },
