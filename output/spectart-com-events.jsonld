      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spectart.com/genid/e32a9d296095ece1"
      },
      {
        "@id": "https://spectart.com/genid/a4ab7220eb33a94c"
      },
      {
        "@id": "https://spectart.com/genid/96018b14e46a4da4"
      },
      {
        "@id": "https://spectart.com/genid/8ac662bdb6e21ab5"
      },
      {
        "@id": "https://spectart.com/genid/b45fbf967f2f2bde"
      },
      {
