      {
        "@id": "https://spectart.com/wp-content/uploads/2026/05/Dom20Babin_-OtA4AQh3pkddvHQ6QiK_.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
