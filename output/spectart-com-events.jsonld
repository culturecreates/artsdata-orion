    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Concert annuel des professeurs"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Plongez au cœur d’un rendez-vous musical d’une rare intensité. Réunis sur scène, nos professeurs-musiciens conjuguent sensibilité, audace et virtuosité pour donner vie à un programme riche en nuances. Des élans fougueux aux moments les plus intimes, laissez-vous toucher par la sincérité de leur jeu et la force de leur complicité. Une soirée mémorable où la musique résonne avec âme et passion !n&nbsp;"
      }
    ],
