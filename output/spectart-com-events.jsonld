    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spectart.com/programmation/ensemble-antoine-perreault/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Ensemble Antoine-Perreault"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Joignez-vous à l’Ensemble Antoine-Perreault et à son directeur musical, Monsieur Simon Dolbec, dans cette odyssée fantastique qui vous fera traverser les océans, parfois déchaînés, et découvrir le monde en passant par tous les éléments, qu’ils soient naturels ou imaginaires! nVous entendrez un programme orchestral consacré exclusivement au répertoire pour ensemble à vent et percussion grâce à des compositions originales choisies parmi les plus marquantes de l’œuvre de deux compositeurs de renom : Robert W. Smith et Rossano Galante. nUn périple musical à ne pas manquer!n&nbsp;"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Ensemble Antoine-Perreault"
      }
    ]
  },
