        "@id": "https://spectart.com/genid/14d2c578ccf2c7b3"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spectart.com/programmation/simon-gouache/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Simon Gouache"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "« Je vais faire ça, pour l’instant&#8230; » C’est ce que Simon Gouache s&rsquo;est dit quand il s&rsquo;est lancé en stand-up, il y a maintenant plus de vingt ans. Visiblement, cet instant dure toujours. De ce qui devait être une courte aventure est née une grande passion, qui est au premier plan de ce quatrième spectacle."
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Simon Gouache"
      }
    ]
  },
