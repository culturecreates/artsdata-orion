    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spectart.com/genid/9d8781de13173068"
      },
      {
        "@id": "https://spectart.com/genid/8e16cdf483061ad9"
      },
      {
        "@id": "https://spectart.com/genid/095fd8029c7a5147"
