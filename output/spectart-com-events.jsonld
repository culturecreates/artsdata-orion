    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Lauriane Lalonde"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dans cette première heure de stand-up, je voulais recenser toutes les difficultés de se sentir comme une petite fille dans cette énorme expérience qu’est la vie, comme avoir un chum trop parfait, voir sa mère vieillir ou encore se réveiller avec un acrochordon (la pire affaire des trois, évidemment). Ce show-là, c’est toute moi et j’ai trop hâte de le partager avec vous."
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Lauriane Lalonde"
      }
    ]
  },
