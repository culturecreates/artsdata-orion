      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://spectart.com/wp-content/uploads/2026/08/Billy20Tellier_-P0NyU7mgqm6x7uQbW95_.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
