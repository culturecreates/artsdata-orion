    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Mentana"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le spectacle de Mentana, dans lequel s’entremêlent des pièces du nouvel album en français et des morceaux des albums précédents, est une véritable épopée! Aux chansons s’ajoutent les riches et réjouissants récits de Robin-Joël, qui a d’ailleurs confirmé ses talents humoristiques avec son personnage de Stéphane dans la série Temps de chien, diffusée sur les ondes d’ICI Radio-Canada Télé."
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Mentana"
      }
    ]
  },
