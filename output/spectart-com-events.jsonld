    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "30e Spectacle-Événement"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Pour son 30e anniversaire La Ressource vous invite à venir célébrer et à venir entendre des prestations de Martine St-Clair, du trio Valois Fauteux, de Benny Jones, Jeanick Fournier, Marco Calliari, Daniel Boucher, Véronique Bilodeau et Alexis Dumais. Ces généreux artistes seront accompagnés par le Bizz Bizz Band, sous la direction musicale de la Rimouskoise Marie-Anne Arsenault, ainsi que par la talentueuse choriste Julie Houde.nFidèle à la tradition, le Chœur Gospel de l’École de musique du Bas-Saint-Laurent, sous la direction de Natasha Poirier, viendra enrichir plusieurs prestations inédites. À cette impressionnante distribution s’ajouteront également David Richard ainsi que Marianne Bérubé de l’École de danse Quatre Temps.n&nbsp;nPARTENAIRE DE L&rsquo;ÉVÉNEMENTn     "
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "30e Spectacle-Événement"
      }
    ]
  },
