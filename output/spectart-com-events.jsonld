  {
    "@id": "https://spectart.com/genid/1e3d492f71c5bfae",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spectart.com/vitrine-de-spectacles-15/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://spectart.com/wp-content/uploads/2026/08/Vitrine20de20spectacles_-P-QTegmaq8xT6aw-VHQ_.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-10-15T20:00:00"
      }
    ],
    "http://schema.org/location": [
