    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "La Rentrée culturelle"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "C’est le grand retour de La Rentrée culturelle 🎉 Un événement festif et gratuit qui marque le coup d’envoi de la saison culturelle d’automne.nVenez célébrer avec nous et découvrir ce que la nouvelle saison vous réserve : nouveautés, incontournables, coups de cœur et belles découvertes seront au rendez-vous ! Vous aurez également le plaisir d’assister à des prestations artistiques uniques qui sauront vous surprendre et vous charmer. On se donne rendez-vous pour lancer la saison en beauté !n&nbsp;"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "La Rentrée culturelle"
      }
    ]
  },
