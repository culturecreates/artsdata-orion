        "@value": "Patrice Michaud"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Patrice Michaud revient sur scène et nous confie ses Héroïques fantaisies, quelque part entre le banal et l&rsquo;extraordinaire, entre les secrets chuchotés et les sourires contagieux. Un spectacle comme des retrouvailles, où les chansons neuves se mêlent à celles qui, dès les premières notes, nous donnent l&rsquo;impression de rentrer à la maison."
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Patrice Michaud"
      }
    ]
  },
