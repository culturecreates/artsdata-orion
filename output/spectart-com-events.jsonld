  {
    "@id": "https://spectart.com/genid/bb33f23e0decaa12",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spectart.com/terres-ditalie-entre-mer-et-montagne/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://spectart.com/wp-content/uploads/2026/04/Terres20d27Italie2C20entre20mer20et20montagne_-OqgSgAmRkLSXznf23MO_-1.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
