      },
      {
        "@id": "https://spectart.com/genid/6c7c8107d8173f34"
      },
      {
        "@id": "https://spectart.com/genid/31d021c036ba104b"
      },
      {
        "@id": "https://spectart.com/genid/ff7246903b231e18"
