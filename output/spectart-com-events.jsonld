      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://spectart.com/wp-content/uploads/2026/04/Virginie20Brunelle_-OqGbu5T28otEYxQCw5C_.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
