    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Boucar Diouf"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Vous ne verrez plus la cohabitation entre le chien, le chat et l’humain de la même façon après avoir assisté au spectacle de Boucar Diouf intitulé Trois prédateurs et un bungalow. Ici, la biologie rencontre l’histoire et la culture dans une exploration à la fois drôle, instructive et touchante. Vous sortirez de spectacle la rate bien dilatée en vous disant : « je ne verrai plus le chien et le chat de la même façon. »n&nbsp;"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Boucar Diouf"
      }
    ]
