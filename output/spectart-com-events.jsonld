  {
    "@id": "https://spectart.com/genid/a3b8313b50b621ae",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spectart.com/dialogues/"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://spectart.com/wp-content/uploads/2026/05/dialogue-web.jpg"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-02-13T20:00:00"
      }
    ],
    "http://schema.org/location": [
      {
