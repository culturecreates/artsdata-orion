    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Rachelle Elie"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Rachelle Elie, bête de scène à paillettes et humoriste anglophone préférée des Québécois, présente Lâchée Lousse, son tout premier one-woman show en français !nDans ce spectacle haut en couleur, Rachelle célèbre la liberté qu’elle a trouvée dans sa nouvelle vie au Québec, sa passion pour la culture d’ici et son affection pour nos expressions savoureuses.nAvec humour et franchise, elle nous parle de sa vie de femme nouvellement célibataire, de ses aventures amoureuses et de la mission (pas toujours simple!) d’élever des garçons pour en faire des hommes bons.nUne soirée éclatée, pleine de rires et de pur plaisir, à l’image de Rachelle!n&nbsp;"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Rachelle Elie"
      }
    ]
  },
