    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spectart.com/programmation/lisa-leblanc/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Lisa Leblanc"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Lisa LeBlanc surprend son public avec des rebondissements musicaux depuis maintenant 15 ans. Parmi ceux-ci, on compte un premier opus certifié platine, un album rock en anglais, un disque disco récompensé par de nombreux prix et un live enregistré avec l&rsquo;Orchestre symphonique de Québec. L’autrice-compositrice acadienne a remporté plusieurs Félix, a été nommée trois fois aux Junos et s&rsquo;est retrouvée à deux reprises sur la courte liste du Prix Polaris. Pour l’album *Patchwork*, dont la sortie est prévue en 2027, elle s&rsquo;est replongée dans l&rsquo;esprit des jam sessions, puisant son inspiration dans le folk et le rock des années 60 et 70, tout en y ajoutant une touche de swamp pop, un soupçon de soul et une dose de musique traditionnelle cajun et acadienne. Patchwork est une œuvre à la fois intime et rassembleuse qui allie l’ambiance des party de cuisine à la contemplation des escapades le long des petites et grandes routes. n&nbsp;"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Lisa Leblanc"
      }
    ]
  },
