    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "L&rsquo;héritage musical d&rsquo;Harmonium"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dans ce nouveau spectacle, vivez une expérience musicale émouvante où les grands classiques d’Harmonium reprennent vie sous un regard inédit et chargé de sens. Maude Locat (fille de Serge Locat) et Julie Valois (fille de Louis Valois & Monique Fauteux) évoluent sur scène auprès de leurs complices de Premier Ciel, la seule formation reconnue par Serge Fiori pour faire revivre cette œuvre mythique."
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "L&rsquo;héritage musical d&rsquo;Harmonium"
      }
    ]
  },
