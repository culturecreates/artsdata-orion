    ],
    "http://schema.org/image": [
      {
        "@id": "https://spectart.com/wp-content/uploads/2026/04/L27C389cho20des20racines_-OqGgYMk86i1cMR3e3NZ_.jpg"
      }
    ],
    "http://schema.org/startDate": [
