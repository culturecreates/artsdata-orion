    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spectart.com/programmation/le-livre-magique/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Le livre magique"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Conçu par des créateurs québécois, LE LIVRE MAGIQUE est un spectacle musical qui fera voyager petits et grands dans l’univers des contes fantastiques comme : Aladin et la lampe merveilleuse, La Belle et la Bête, Cendrillon et La Petite Sirène. C&rsquo;est à travers une histoire originale et un décor enchanteur que les six personnages magiques vous feront rêver sur des airs connus, tels que : Sous l’océan, Hakuna Matata, Libérée Délivrée et bien plus encore.nLes artistes aux voix et aux talents indéniables vous surprendront dans une mise en scène féérique aux chorégraphies dynamiques. Laissez-vous transporter et émerveiller par la magie de vos contes favoris. À la fin du spectacle, rencontrez vos personnages préférés afin de créer ce souvenir dont vos enfants se souviendront encore longtemps; un rêve de proximité devenu réalité !"
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Le livre magique"
      }
    ]
  },
