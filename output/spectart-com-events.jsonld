      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spectart.com/genid/3f942ace57dff18f"
      },
      {
        "@id": "https://spectart.com/genid/1fb73179cdde2ffc"
      },
      {
        "@id": "https://spectart.com/genid/fba8b8ef0bfa941a"
      },
      {
        "@id": "https://spectart.com/genid/d54808b01bb1cd03"
      },
      {
        "@id": "https://spectart.com/genid/2d8165163c097414"
      },
      {
