    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Natasha Kanapé"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "À remonter la course de ma mémoirenJe m&rsquo;accroche aux épines des horizons qui m&rsquo;échappentnNikan uapeteman – si je peux voir le futurnJe le dessinerai avec mes motsnPour que nous ne le perdions pasnDans cent ans.nUn nouveau spectacle de poésie et de musique que nous dévoile Natasha Kanapé. Elle nous dessine l&rsquo;avenir étincelant avec des mots tantôt tendres, tantôt tranchants. Un hommage à la force de son peuple et de son territoire, porté en musique avec toute la puissance du piano mélodieux de Simon Denizart."
      }
    ],
    "http://schema.org/performer": [
      {
        "@language": "fr",
        "@value": "Natasha Kanapé"
      }
    ]
  },
