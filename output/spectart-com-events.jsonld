  {
    "@id": "https://spectart.com/temporary/aa490d99-58fb-4b17-a829-b84510a5e9b2",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spectart.com/clair-obscur/"
      }
    ],
    "http://schema.org/image": [
      {
