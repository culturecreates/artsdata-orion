    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "5 chômeurs désespérés. 1 plan fou : se déshabiller !  Le phénomène qui fait rire (et rougir) le Québec depuis 25 ans est de retour avec sa distribution…"
      }
    ],
