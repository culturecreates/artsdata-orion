    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/06c259f998557c31"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/liliane-blanco-binette"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/liliane-blanco-binette"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Liliane Blanco-Binette"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Soirées Humour \nAvec une lucidité désarmante et une autodérision qui frappe juste, Liliane propose un premier One Woman Show où l'humour se mêle à l'intime. Ce n'est pas un simple spectacle, c'est une rencontre. Elle transforme ses vulnérabilités en matière comique, révélant une façon décalée d'observer le monde et d'assumer ses contradictions. Entre confidences crues et complicité partagée, elle entraîne le public dans un moment à la fois fragile et nécessaire, où l'on se reconnaît dans ce qui nous échappe et nous dépasse."
      }
    ]
  },
