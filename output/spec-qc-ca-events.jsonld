    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/5b47c651fe55a271"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/mibenson-sylvain"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/mibenson-sylvain"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Mibenson Sylvain"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Soirée Humour Comédie club 164\nJ'm'appelle Mibenson Sylvain. Mi pour Mireille ma mère. Ben pour Bernier mon père. Son pour fils. Mais appelle-moi juste Miben.\n\nJuste Miben, c'est un spectacle dans lequel je me présente moi et ma façon de voir la vie à travers tout ce qui m'est arrivé jusqu'ici. Le travail, les responsabilités, les changements qui viennent avec l'âge. C'est un mélange de vécu, de réflexions qui invite le public à voir la vie à travers mes lunettes. Ce n'est pas seulement un spectacle sur moi. C'est un peu le portrait de ce que je suis devenu, de ce que mes parents m'ont transmis. Un questionnement sur comment faire vivre leur héritage dans ma propre vie, ici, au Québec.\n\nParce qu'au fond, Miben, c'est moi. Mais Miben, c'est aussi le fils de Mireille et de Bernier.\n\n*18 ans et plus pour la représentation au 164."
      }
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/ComedyPerformance"
      }
    ]
  },
