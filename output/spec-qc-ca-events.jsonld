    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "France D'Amour et Geneviève Gagnon, deux belles sacoches sur le kombucha qui rient fort et qui parlent fort mais tellement attachantes animent un podcast…"
      }
    ],
