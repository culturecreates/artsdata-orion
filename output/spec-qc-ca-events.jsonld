        "@id": "https://spec.qc.ca/genid/d2f90fc4d162a0a0"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/mike-beaudoin"
