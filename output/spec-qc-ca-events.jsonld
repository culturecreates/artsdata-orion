      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/7ab6583724aedc38"
      },
      {
        "@id": "https://spec.qc.ca/genid/bb1a62b6c7f1fa5f"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/p-o-forget"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/p-o-forget"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "P-O Forget"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Prises de tête parce que je passe ben du temps dans la mienne juste pour faire vibrer la vôtre. \nParce que les temps sont fous et qu'il faut se prendre la tête pour se les expliquer.  \nParce que traiter de tout et même du lourd avec humour, c'est ce que je fais qui crée le plus de légèreté.\n\nMais surtout pour célébrer le plaisir que j'éprouve quand je pense à comment vous faire rire. \n\nVenez voir mon spectacle. Je me suis assez pris la tête pour vous faire rire avec le ventre. Beaucoup. Et si vous ne me connaissez pas encore, venez découvrir un humoriste qui pratique son métier avec tout son cœur. \n\nMerci, je vous apprécie."
      }
    ]
  },
  {
    "@id": "https://spec.qc.ca/genid/1dcbbb021dcd919a",
    "@type": [
      "http://schema.org/PerformingGroup"
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Prises de tête<br />\nHumour"
      }
    ]
  },
