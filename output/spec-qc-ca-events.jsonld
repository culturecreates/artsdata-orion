    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Pierre-Luc Pomerleau"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "18 ans et +\nL'humoriste Pierre-Luc Pomerleau est de retour sur scène pour roder du tout nouveau matériel et préparer son troisième one-man-show. Après avoir franchi le prestigieux cap des 100 000 billets vendus avec son dernier spectacle, Moqueur polyglotte, Pierre-Luc poursuit son ascension avec ce qui fait sa marque : un style analytique unique, un sens du jeu d'une grande précision et, surtout, des imitations aussi surprenantes qu'hilarantes. Pierre-Luc démontrera une fois de plus qu'il possède un talent hors du commun. \n \n\n  \n\n* Ce spectacle n'est pas admissible à la promotion « Spectacle gratuit à l'achat de 3 spectacles »."
      }
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/ComedyPerformance"
      }
    ]
