    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/6ecc1849b5febc81"
      },
      {
        "@id": "https://spec.qc.ca/genid/f1885d82e556681d"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/becky-a-la-plage"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/becky-a-la-plage"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Becky À La Plage"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\nBecky est un personnage adorable, plein d&#039;enthousiasme... et parfois un peu trop zélé ! Elle vit dans un paradis fantaisiste où sable, soleil et vagues la suivent partout. Grâce à son imagination débordante, son cerceau devient un véritable océan miniature.\n\nAu fil du spectacle, elle entraîne le public dans un voyage sous-marin extraordinaire où les prouesses de cirque se mêlent à la comédie et à de multiples surprises. Jonglerie, acrobaties, rires et poésie s&#039;enchaînent dans un univers coloré et fascinant.\n\nUne aventure magique où la plage rencontre le cirque !"
      }
    ]
  },
