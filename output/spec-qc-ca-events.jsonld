      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "18 ans et +\n\n\nPREMIER ONE-MAN-SHOW\n\nNatif et habitant toujours au Nord du Lac-Saint-Jean, Mat est un ''raconteux''.\nSa parlure et ses anecdotes colorées défilent à la vitesse d'une bonne toune punk.\nIl décrit lui-même son style en disant : ''C'est comme du Michel Barrette mais avec ben de la\nsauce piquante!''\n"
      }
    ]
