  {
    "@id": "https://spec.qc.ca/genid/7a33d59c5894d056",
    "@type": [
      "http://schema.org/VideoObject"
    ],
    "http://schema.org/thumbnailUrl": [
      {
        "@id": "https://spec.qc.ca/uploads/la-tourn%C3%A9e-mondiale-du-festival-du-film-de-montagne-de-banff-au-qu%C3%A9bec-horizontal-0a5e87908f968eaa3ce6.jpeg"
      }
    ],
    "http://schema.org/embedUrl": [
      {
        "@id": "https://www.youtube.com/watch?v=9TpZpNOoNd8"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/la-tournee-mondiale-du-festival-du-film-de-montagne-de-banff-au-quebec"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "LA TOURNÉE MONDIALE DU FESTIVAL DU FILM DE MONTAGNE DE BANFF AU QUÉBEC"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\nAvec sa 51e édition, la Tournée mondiale du Festival du film de montagne de Banff poursuit l'aventure!\n\nGrâce à une programmation exaltante, les mois de janvier et février insufflent à l'hiver québécois une dose massive d'adrénaline et d'inspiration. Avec 26 villes et 43 représentations à l'agenda, la tournée au Québec poursuit son développement. \n\nExpérience cinématographique incontournable qui célèbre la passion et l'audace, la Tournée expose les aventures d'hommes et de femmes qui optent pour le dépassement, la force de l'amitié et la créativité comme vecteurs de bonheur. \n\nCette année, 610 films ont été soumis au jury, un record. Du nombre, 84 ont été retenus et seront présentés aux festivaliers lors de la tenue du festival à Banff en novembre.  La programmation finale de la Tournée québécoise sera révélée en novembre 2026.\n\nInformations pratiques\n•\tDurée d'une représentation: trois heures au total, entracte et tirage compris.\n•\tProgramme identique pour chaque projection.\n•\tLes films sont présentés en version originale sous-titrée en français afin de préserver leur authenticité.\n•\tPlusieurs prix de présence sont tirés au sort après l'entracte.\n•\tUne exposition photographique accompagne la tournée.\n\nWeb site\n\nFacebook\n\nInstagram\n\n🎬 Voir la bande-annonce"
      }
    ],
    "http://schema.org/uploadDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-10-23T17:03:00"
      }
    ]
  },
