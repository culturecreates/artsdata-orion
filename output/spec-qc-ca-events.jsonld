      }
    ]
  },
  {
    "@id": "https://spec.qc.ca/genid/7deaf4841e29856e",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-07-17T20:00:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-07-17T23:00:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://spec.qc.ca/genid/a627fa1526ba077e"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://spec.qc.ca/genid/6a6e3d162f12ca99"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://spec.qc.ca/uploads/dom-babin-horizontal-d8bca1800b1d8d15061f.jpeg"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/795ce794dda4e0e7"
      },
      {
        "@id": "https://spec.qc.ca/genid/2883ef14887435de"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/dom-babin"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/dom-babin"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Dom Babin"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Soirée Humour \n\nSuivi par plus de 400 000 abonnés sur le Web, l'humoriste Dom Babin s'est imposé avec un style bien à lui. Il se distingue par un humour engagé à la parlure assumée, capable de faire sourire les gens sans dents et grincer ceux qui en ont. Celui que vous avez peut-être découvert dans la série À la poursuite du rêve glacé sur Crave est nommé au Gala Les Olivier 2026 dans les catégories Capsule web de l'année et Numéro d'humour de l'année. Avec son premier one-man-show, Américain du Nord français, mis en scène par Adib Alkhalidey, Dom Babin parcourt la province pour livrer un spectacle franc, mordant et sans filtre. Ni érudit, ni sociologue, ni politicien, ni anthropologue, l'humoriste se décrit comme trop Américain pour être Français, trop Canadien pour être Américain, trop Français pour être Canadien. Ni tout à fait l'un, ni complètement l'autre. Un gars qui a bûché pour se tailler une place et qui monte sur scène pour se brûler un peu, juste assez pour réchauffer son public."
      }
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/ComedyPerformance"
      }
    ]
  },
