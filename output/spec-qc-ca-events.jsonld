    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/ecoute-ce-corps-qui-crie"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/ecoute-ce-corps-qui-crie"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Écoute Ce Corps Qui Crie"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\nÉcoute ce corps qui crie, une histoire de courage, de résilience et de solidarité\n\nMarie-Soleil, une femme dans la quarantaine, entreprend un long parcours à travers les dédales du système de santé pour comprendre l&#039;origine de douleurs qui s&#039;intensifient progressivement. Les années passent avant qu&#039;un diagnostic de fibromyalgie soit enfin posé. Son histoire révèle avec sensibilité les répercussions de la maladie sur sa vie et celle de ses proches.\n\nUne production du Théâtre Loup-Garou, théâtre de proximité et d&#039;intervention sociale, en collaboration avec l&#039;Association de la fibromyalgie Région Montérégie."
      }
    ]
  },
