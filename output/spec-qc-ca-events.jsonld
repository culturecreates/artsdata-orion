      {
        "@id": "https://spec.qc.ca/genid/e064c243916af80c"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://spec.qc.ca/genid/ec72356afc7fc347"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://spec.qc.ca/uploads/pascal-cameron-horizontal-71127eaf2b014026cdf1.jpeg"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/e323694650eba1f1"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/pascal-cameron"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/pascal-cameron"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Pascal Cameron"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Pascal Cameron présente son premier one man show un spectacle. qui est une représentation humoristique qui veut parler à tout le monde et de tout le monde. \n\nPar contre, il est important de noter que c&#039;est un spectacle d&#039;humour, donc les propos de cette représentation seraient inappropriés au Parlement ou à des funérailles mais plus que correct dans un pool party, Noël, un accouchement, la St-Jean ou à crier à travers la fenêtre de ton char quand tu es pogné dans le trafic. \n\nDe plus, un spectacle. a comme objectif premier de faire rire. Fack, va pas me citer comme preuve quand tu t&#039;obstines avec du monde  «Pascal Cameron a dit ça l&#039;autre jour ». J&#039;ai aucun diplôme sauf celui du meilleur livreur de journaux de la Montérégie 1999. (Après, j&#039;ai lâché ma job pour me retirer au sommet)\n\nUn spectacle. c&#039;est un show de stand up traditionnel avec des blagues fraiches."
      }
    ]
  },
