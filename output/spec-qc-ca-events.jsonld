    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Guillaume Pineault est fier d'entamer la confection du petit 2e avec vous. Il sillonne donc le Québec avec le rodage de son prochain spectacle dans le but…"
      }
    ],
    "http://ogp.me/ns#image": [
