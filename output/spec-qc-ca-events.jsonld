      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/lunion-musicale-diberville"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "L'union Musicale D'iberville"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\nQuand la musique raconte...\n\nPlongez dans un univers féerique où l'orchestre donne vie aux récits ! Porté par le talent du conteur invité Thomas Hodgson, ce concert exceptionnel émerveillera petits et grands à travers quatre chefs-d'oeuvre :\n\n- Pierre et le Loup : le classique de Prokofiev.\n- L'Oiseau de feu : l'épopée flamboyante de Stravinsky.\n- Pinocchio : les aventures du célèbre pantin.\n- Hansel et Gretel : la magie de la forêt enchantée.\n\nUne expérience immersive unique pour toute la famille !"
      }
    ]
  },
