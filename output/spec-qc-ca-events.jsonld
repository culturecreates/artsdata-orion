    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/a061ef787196c0ed"
      },
      {
        "@id": "https://spec.qc.ca/genid/fb407ce9ebc8d70e"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/big-time-lew"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/big-time-lew"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Big Time Lew"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\nChanteur et pianiste à l&#039;énergie débordante, Big Time Lew, alias Louis-David Leclerc, fait rayonner un blues festif et vintage à travers le Québec depuis 2007. Inspiré des grands noms des années 50, tels que Ray Charles, Jerry Lee Lewis, Fats Domino et Little Richard, il propose un spectacle ancré dans le blues, le swing et le rock&#039;n&#039;roll. Avec sa voix puissante, son trémolo teinté de soul, son piano qui flambe et son charisme contagieux, il revisite les classiques avec panache tout en livrant ses propres compositions originales. Au programme : une ambiance rétro et festive, des arrangements cuivrés, des solos décoiffants, une dose d&#039;humour et une énergie scénique qui rappelle les grands performers d&#039;antan. Un party rock&#039;n&#039;roll qui vous fera danser et taper des mains toute la soirée."
      }
    ]
  },
