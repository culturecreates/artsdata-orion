    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/ad91c09c6df72b52"
      },
      {
        "@id": "https://spec.qc.ca/genid/da254b5953ccd3cb"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/jf-pauze"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/jf-pauze"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Jf Pauzé"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": " JF Pauzé, membre des Cowboys Fringants et récipiendaire du Félix de l'Auteur-compositeur de l'année 2024, s'apprête à faire ses débuts en solo. À l'automne 2025, il dévoilera un tout premier album comme interprète. En 2026, il retrouvera la scène, entouré de musiciens, avec un spectacle généreux et festif réunissant plus de 20 titres. En plus de présenter ses nouvelles chansons, il revisitera également de grands succès des Cowboys Fringants, pour le plus grand plaisir du public. Un retour marquant et rempli d'émotion pour cet artiste phare, qui promet de faire vibrer la salle. Un rendez-vous incontournable dans le paysage musical québécois.\n\n\n\n*Veuillez prendre note que 1.15$ par billet ira à la Fondation Cowboys Fringants."
      }
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/Chanson"
      }
    ]
  },
