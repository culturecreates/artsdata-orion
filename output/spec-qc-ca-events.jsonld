    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Soirées Humour  Nos bungalows sont le théâtre d'une cohabitation singulière entre trois prédateurs, réunis autour d'un frigidaire. Si l'humain et le chien…"
