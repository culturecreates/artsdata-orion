    "http://schema.org/copyrightYear": [
      {
        "@language": "fr",
        "@value": "2026"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Ciné-club du Haut-Richelieu  Juin 1940. La France s'effondre et signe l'armistice. Dans le chaos, un général inconnu refuse de céder et gagne Londres pour sauver ce qui reste d'un rêve : la liberté. Sans armée ni appui, il n'a qu'une conviction folle, sa France n'a pas déposé les armes. Il tente un pari : convaincre le monde que la bataille n'est ni terminée ni perdue. Autour de lui se lèvent peu à peu, de l'Angleterre à l'Afrique, des résistants de l'ombre, des lycéens révoltés, des soldats obstinés. Phénomène cinématographique de l'année en France, ce premier volet doit beaucoup à Simon Abkarian, qui parvient, selon le Journal de Montréal , « à humaniser ce monument ». Chronique historique d'Antonin Baudry. Avec Simon Abkarian, Simon Russell Beale, Florian Lesieur, Benoît Magimel. France 2026. 2 h 38. (Classement à confirmer). 🎬 Voir la bande-annonce"
      }
    ],
    "http://schema.org/headline": [
      {
        "@language": "fr",
        "@value": "BATAILLE DE GAULLE : LA RÉSISTANCE | SPEC du Haut-Richelieu"
      }
    ],
