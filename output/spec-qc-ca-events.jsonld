    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/cabaret-jazz-band"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/cabaret-jazz-band"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Cabaret Jazz Band"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le Cabaret Jazz Band célèbre le répertoire intemporel de Joe Dassin dans un spectacle porté par la voix de Jean-François Poulin. Accompagné de l'orchestre dirigé par Pierre-Armand Tremblay, l'artiste revisite les plus grands succès du chanteur français à travers des arrangements jazz élégants et raffinés. Une soirée remplie de souvenirs, de mélodies inoubliables et de chansons qui ont traversé les générations.\nCe qu'ils en disent :\n« Très beau spectacle! Nous rappelle de beaux souvenirs. Une scène pleine de talents avec beaucoup d'ambiance. »\n- André G.\n\n« Quel bon spectacle! Des chansons de mon enfance et adolescence... j'en veux encore! »\n- Francine B.\n\n« Très bien. Bon choix de pièces musicales. Excellents musiciens, solistes et chanteur invité. Merci! »\n- Richard L."
      }
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/Chanson"
      }
    ]
  },
