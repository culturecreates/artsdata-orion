      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://spec.qc.ca/genid/1d93d306e818e81d"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://spec.qc.ca/uploads/dave-morissette-horizontal-ee276a9ba43b1d99ed0a.jpeg"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/076c42fbd817b78f"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/dave-morissette"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/dave-morissette"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Dave Morissette"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le seul et unique Dave Morissette monte sur scène avec son tout premier one-man-show, David et il en a des histoires à raconter! Pour la première fois en tournée, le dur à cuire de la LNH devenu animateur adoré du public laisse tomber les gants pour vous offrir une soirée sans filtre, une vraie rencontre. Il vous invite à découvrir l'homme derrière le bagarreur, le doux derrière le colosse... mais surtout le raconteur capable de faire rire et de toucher droit au cœur. Avec une générosité désarmante et un sens du punch bien à lui, il vous amène de Baie-Comeau à Compostelle, en passant par le vestiaire des Canadiens de Montréal et les coulisses des émissions de sports. Avec ses anecdotes aussi drôles que touchantes, vous aurez l'impression de passer une soirée avec un ami de longue date. Vous pensez connaître Dave? Attendez de rencontrer David!\n\n\nPROMOTIONS\nCe spectacle est admissible aux promotions\n  Spectacle gratuit à l'achat de 3 spectacles\n  et\n  2 spectacles pour 85 $.\n  Ajoutez vos billets au panier et le tarif s'ajustera automatiquement selon la promotion applicable.\n"
      }
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/ComedyPerformance"
      }
    ]
  },
