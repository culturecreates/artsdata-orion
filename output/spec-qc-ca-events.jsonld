    ],
    "http://schema.org/copyrightYear": [
      {
        "@language": "fr",
        "@value": "2026"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Découverte 164  Avec plus de 10 millions de vues sur ses capsules web, Alex Lapointe vous entraîne dans son univers avec ses anecdotes bien senties, son style unique et un sens du punch qui frappe toujours dans le mille. Entre observations mordantes, anecdotes croustillantes et réflexions bien senties, Alex vous livre un rodage sans filtre où tout peut arriver. Une occasion en or de découvrir l'un des humoristes les plus prometteurs de sa génération ."
      }
    ],
    "http://schema.org/headline": [
      {
        "@language": "fr",
        "@value": "ALEX LAPOINTE - <br />Humour | SPEC du Haut-Richelieu"
