    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Une chatte amie avec une souris, un voisin disparu et une question immense : faut-il réussir sa vie pour être heureux ? Quand Dorice apprend que Monsieur…"
      }
    ],
