    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\nSalut, ici Guillaume Pineault.  \n \nSi vous êtes rendu ici, c'est que vous songez à acheter des billets pour mon troisième spectacle. J'aimerais vous dire MERCI, j'apprécie.  \n \nPour le descriptif de Pleurer dans mon char, comme disait si bien Yvon Deschamps : « On veut pas le savoir, on veut le voir ». Fait que, j'vous dirais que pour le savoir, venez le voir!!!"
      }
    ],
