    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/843f94889f73dc02"
      },
      {
        "@id": "https://spec.qc.ca/genid/37e570256f8112b0"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/waahli"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/waahli"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Waahli"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Jeudis Shows Hydro-Québec\nDésigné Révélation Radio-Canada 2023-2024, Waahli est un artiste montréalais d'origine haïtienne qui puise dans les mélodies traditionnelles de son enfance pour façonner un style unique et captivant. Cofondateur de Nomadic Massive, groupe emblématique de la scène hip-hop montréalaise, il explore également son identité artistique à travers un projet solo. Chantés en anglais, en français et en créole haïtien, ses projets fusionnent rap et afrobeat tout en rendant hommage à ses racines haïtiennes. Entre reggae, hip-hop et funk haïtien, sa musique témoigne de son inventivité et de son lien avec sa culture et son héritage. Avec ses rythmes ancestraux, ses performances captivantes et ses textes incisifs, Waahli propose un hip-hop alternatif qui nous fait voyager aux quatre coins du globe. Sur scène, il séduit par son interaction généreuse avec le public, célébrant la diversité culturelle avec une énergie communicative.\n \n\n* Ce spectacle n'est pas admissible à la promotion « Spectacle gratuit à l'achat de 3 spectacles »."
      }
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/Chanson"
      }
    ]
  },
