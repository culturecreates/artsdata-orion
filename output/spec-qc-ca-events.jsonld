    "@id": "https://spec.qc.ca/genid/9049749790dd2017",
    "@type": [
      "http://schema.org/PerformingGroup"
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Danser sous la pluie<br />\nHumour"
      }
    ]
  },
