    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/c13d2806ff890c41"
      },
      {
        "@id": "https://spec.qc.ca/genid/3ba3862950154c87"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/larbre-a-touski"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/larbre-a-touski"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "L'arbre À Touski"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\nKazou rencontre un étrange animal nommé Touski, qui possède une balle magique. Curieuse, elle souhaite s'en emparer, mais Touski n'est pas du même avis.\n\nÀ travers cette rencontre, Kazou devra apprendre à demander gentiment, respecter le consentement et partager. Aidée par les enfants, elle découvrira aussi l'importance de ranger et d'être attentive aux autres, le tout dans la bonne humeur et en chanson.\n\nCe spectacle aborde avec humour et sensibilité des thèmes essentiels pour les tout-petits : gestion des émotions, partage et respect, à travers un mélange de cirque, magie et interactions.\n\nUn moment à la fois ludique et éducatif, qui fait réfléchir en s'amusant."
      }
    ]
  },
