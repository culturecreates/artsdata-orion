      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://spec.qc.ca/genid/a627fa1526ba077e"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://spec.qc.ca/genid/9bcef09b13feda51"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://spec.qc.ca/uploads/boogie-wonder-band-horizontal-0c9370d70b88e29f2286.jpeg"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/c2074048a77e734e"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/boogie-wonder-band"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/boogie-wonder-band"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Boogie Wonder Band"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le Boogie Wonder Band, célèbre pour son énergie contagieuse et ses grooves irrésistibles, présente un tout nouveau spectacle électrisant «Disco Honey»! Plongez dans un tourbillon de paillettes et de boules miroirs, où les rythmes endiablés de la basse et les envolées des cuivres vous transportent instantanément dans l&#039;atmosphère exaltant des années disco.\n  \nDe Donna Summer aux Bee Gees, en passant par Gloria Gaynor et KC &amp;amp; the Sunshine Band, le répertoire du Boogie Wonder Band rassemble les plus grands hits qui ont marqué l&#039;histoire de la musique des années 70.\n  \nAttendez-vous à des costumes étincelants, à des chorégraphies captivantes et à une ambiance électrisante qui vous incitera à vous lever pour rejoindre la piste de danse.\n  \nQue vous soyez un nostalgique des années disco ou simplement en quête d&#039;une soirée inoubliable, le spectacle du Boogie Wonder Band est un incontournable pour tous les amateurs de musique. Préparez-vous à danser, à chanter et à célébrer, car, avec le Boogie Wonder Band, la fête ne fait que commencer!"
      }
    ]
  },
