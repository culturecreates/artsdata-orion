  {
    "@id": "https://spec.qc.ca/genid/e7914bb19201a848",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-01-14T20:00:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-01-14T23:00:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://spec.qc.ca/genid/b7e7e0d584d94a4d"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://spec.qc.ca/genid/4e0ef510a3b20f1a"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://spec.qc.ca/uploads/mehdi-bousaidan-horizontal-255eb901b3d6f0646d88.jpeg"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/2fadfa8484a5838f"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/mehdi-bousaidan"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/mehdi-bousaidan"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Mehdi Bousaidan"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": " Dans son tout nouveau spectacle, Mehdi Bousaidan se dévoile comme jamais. Avec ce troisième one-man show, il choisit l'introspection et partage une analyse intime avec l'humour efficace qu'on lui connaît. Ce spectacle invite à jeter un œil à travers la fenêtre de sa vie. C'est un voyage, de sa tendre enfance à l'homme qu'il est aujourd'hui, en se rapprochant un peu plus de sa réalité. À travers des anecdotes surprenantes, il brouille la frontière entre histoire personnelle et universel. C'est un Mehdi qu'on reconnaît, certes, pour son sens critique, ses analyses inhabituelles et ses punchs inattendus, mais aussi un Mehdi qu'on découvre sous un nouveau visage. Il ouvre le livre de sa vie privée pour la première fois, dans un humour toujours aussi rafraîchissant."
      }
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/ComedyPerformance"
      }
    ]
  },
