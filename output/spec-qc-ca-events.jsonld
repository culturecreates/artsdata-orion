    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/c3d2ba85f4db6760"
      },
      {
        "@id": "https://spec.qc.ca/genid/183793c5ec6fd612"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/aswell"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/aswell"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Aswell"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Phénomène de la streamosphère et nouvelle sensation du rap québécois, Aswell s'est imposé en quelques années seulement comme une voix incontournable de la scène musicale d'ici ainsi qu'une figure de proue des musiciens de sa génération.\n\nPorté par ses deux premiers projets en carrière, le EP Solo sorti en 2021 ainsi que l'album Banlieue sorti en 2024 et lancé dans un Club Soda à guichet fermé, le jeune artiste comptabilise déjà plus de 55 millions d'écoutes sur l'ensemble des plateformes de streaming et une certification single d'or pour son morceau Leaving. Il compte aussi à son actif des spectacles sur les plus grandes scènes de la province (Francos de Montréal, FEQ, Festivoix de Trois-Rivières, Le Festif! de Baie-Saint-Paul). \n\nNaviguant entre le emo rap, la pop et le folk québécois, Aswell se distingue par ses flows mélodiques et accrocheurs ainsi que par ses textes personnels, authentiques et empreints d'une grande volonté introspective dans lesquelles il explore notamment les tumultes amoureux, le vide existentiel et l'ambition de réussir entouré des siens."
      }
    ]
  },
