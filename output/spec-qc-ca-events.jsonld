    ],
    "http://schema.org/image": [
      {
        "@id": "https://spec.qc.ca/uploads/charles-beauchesne-horizontal-b73c6bf4d24440aebb14.jpeg"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/3b0638c48a6411cf"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/charles-beauchesne"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/charles-beauchesne"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Charles Beauchesne"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Soirées Humour\n\nL'humoriste Charles Beauchesne est de retour avec une autre de ses loufoques conférences sur des pires moments de l'Histoire. Dans ce volet, venez découvrir les dynamiques à l'interne de quelques-uns des plus méchants individus sur terre: le cercle rapproché d'Hitler. Qui étaient les nazis? À quoi croyaient-ils vraiment? Pourquoi se détestaient-ils tous entre eux en fin de compte? Toutes ces choses et bien plus dans un heureux moment d'humour ludique, et qui sait, peut-être éducatif, avec diapositives bien sûr!"
      }
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/ComedyPerformance"
      }
    ]
  },
