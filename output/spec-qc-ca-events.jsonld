      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/king-melrose"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/king-melrose"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "King Melrose"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\nAvec Viens nous rejoindre, King Melrose vous convie à un spectacle festif et rassembleur aux accents folk et roots. Dans une ambiance chaleureuse et authentique, il enchaîne chansons originales, clins d&#039;œil au répertoire francophone et moments de complicité avec le public. Porté par une énergie contagieuse et une présence scénique éprouvée sur plus de 1 000 scènes, King Melrose offre une expérience humaine, vibrante et résolument rassembleuse. Un rendez-vous musical où l&#039;on chante ensemble, le cœur grand ouvert.\n\n\n\n🎵 Écouter l&#039;extrait"
      }
    ]
  },
