      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://spec.qc.ca/genid/e064c243916af80c"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://spec.qc.ca/genid/1d93d306e818e81d"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://spec.qc.ca/uploads/daniel-grenier-horizontal-69edf43e69d3576fa400.jpeg"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/b35c26b2398e88b9"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/daniel-grenier"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/daniel-grenier"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Daniel Grenier"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Garder son CŒUR D'ENFANT, c'est refuser de laisser la vie user notre émerveillement.\n\nC'est continuer à s'étonner devant les petites choses : un coucher de soleil, un rire sincère, une chanson qu'on aime.\nC'est savoir s'émerveiller sans cynisme, rêver sans calcul, aimer sans attendre en retour.\n\nC'est aussi garder une certaine légèreté, la capacité de rire de soi, de jouer, d'être curieux, d'apprendre sans honte.\n\nCe n'est pas être naïf, mais choisir de rester sensible et ouvert, même quand le monde devient dur ou compliqué.\n\nAvoir un CŒUR D'ENFANT, c'est croire qu'il y a encore du beau, même dans le chaos.\n\nC'est se souvenir que la joie n'est pas un luxe, mais un instinct qu'on peut nourrir chaque jour.\n\nProcurez-vous vos billets pour le nouveau spectacle de Daniel Grenier et laisser votre CŒUR D'ENFANT prendre toute la place."
      }
    ]
  },
  {
    "@id": "https://spec.qc.ca/genid/b35c26b2398e88b9",
    "@type": [
      "http://schema.org/Offer"
    ],
