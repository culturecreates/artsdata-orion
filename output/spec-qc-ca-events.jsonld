      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://spec.qc.ca/genid/689a613875211e30"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://spec.qc.ca/uploads/lutin-dun-jour-d%C3%A9core-ton-sapin-de-no%C3%ABl-horizontal-3c58d8ebe40f1cd2283a.png"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/06d146f615606227"
      },
      {
        "@id": "https://spec.qc.ca/genid/062f976b94ce9f2c"
      },
      {
        "@id": "https://spec.qc.ca/genid/e046de28af66b8a5"
      },
      {
        "@id": "https://spec.qc.ca/genid/6c47f99fce8a639d"
      },
      {
        "@id": "https://spec.qc.ca/genid/22d1068a660f06ba"
      },
      {
        "@id": "https://spec.qc.ca/genid/971a0cd9a20869cf"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/lutin-dun-jour-decore-ton-sapin-de-noel"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/lutin-dun-jour-decore-ton-sapin-de-noel"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Lutin D'un Jour : Décore Ton Sapin De Noël !"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\nLe Père Noël arrive bientôt ! Pour bien préparer sa venue, participe à un atelier magique où créativité et traditions se rencontrent.\n\nDécore un ornement de Noël  pour ton beau sapin, puis laisse libre cours à ton imagination en décorant un délicieux biscuit de Noël de Chez Simple and Sweet, que tu pourras lui offrir lors de son passage.\n\nEt si tu n'as pas encore eu le temps d'écrire ta lettre au Père Noël, pas de souci ! Tu pourras la rédiger sur place et la déposer dans la boîte aux lettres spéciale du Musée.\n\nMais ce n'est pas tout ! Enfile ton pyjama préféré ou un accessoire de Noël, et pars à la recherche des lutins cachés dans le Musée lors de notre grande chasse aux lutins !\n\n\nL'activité comprend : \n🍽️ Une pièce de céramique à décorer (ornement pour le sapin)\n🍪 La décoration d'un biscuit de Noël (tu pourras en acheter d'autres sur place !)\n💌 Une lettre au Père Noël \n☕ Un chocolat chaud réconfortant \n🧝‍♂️ Une chasse aux lutins dans le musée \n\n🕐 Horaire :Passez nous voir à l'heure qui vous convient, entre 9 h et 12 h ou entre 13 h et 16 h.\n\nLes enfants doivent être accompagnés d'un parent ou d'un adulte responsable pendant toute la durée de l'activité.\n\nViens semer un peu de magie et repartir les bras et le cœur remplis de l'esprit de Noël !\n"
      }
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/VarietyPerformance"
      }
    ]
  },
