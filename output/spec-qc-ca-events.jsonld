  {
    "@id": "https://spec.qc.ca/genid/ea0e8e4efc1b764e",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-01T14:00:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-01T17:00:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://spec.qc.ca/genid/b7e7e0d584d94a4d"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://spec.qc.ca/genid/7516004f176367b9"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://spec.qc.ca/uploads/la-ville-dun-r%C3%AAve-horizontal-c518de0a77b5fcbd8174.jpeg"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/la-ville-dun-reve"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/la-ville-dun-reve"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "La Ville D'un Rêve"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\nRésumé du film:\nMontréal est née d'un rêve, celui de personnes qui croyaient en la possibilité de créer un monde meilleur en Nouvelle-France. Qui étaient ces gens? Quel idéal poursuivaient-ils et pourquoi? Les réponses se trouvent dans un manuscrit du XVIIe siècle qui, de toute évidence, serait les mémoires cachés de Jeanne Mance. Avec un regard original et personnel, la cinéaste revisite ce récit où le passé entre en résonance avec une volonté toujours d'actualité de créer un monde plus près de valeurs humanistes. Avec la participation de Pascale Bussières et Alexis Martin.\n\nLa projection du film (74 min) est précédée d'une courte présentation et suivie d'une conférence de la cinéaste ainsi que d'une période de questions-réponses.\n\n🎬 Voir la bande-annonce\n\nBiographie et filmographie de la cinéaste"
      }
    ]
  },
