    "@id": "https://spec.qc.ca/genid/96dde5501bfc776c",
    "@type": [
      "http://schema.org/PerformingGroup"
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "50 ans, de la Bottine à aujourd'hui !<br />\nChanson"
      }
    ]
  },
