      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Jey Fournier"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\nUn jour, on se réveille et on réalise qu'on a 30 ans (ou presque). On voit les autres avancer, on essaie de ne pas trop se comparer, mais on a quand même l'impression d'être en retard sur la vie.\nEntre la séparation, les remises en question et la quête du bonheur, j'ai choisi d'en rire. Tant qu'à être en retard, autant en faire un spectacle.\n \n\n  \n\n* Ce spectacle n'est pas admissible à la promotion « Spectacle gratuit à l'achat de 3 spectacles »."
      }
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/ComedyPerformance"
      }
    ]
  },
