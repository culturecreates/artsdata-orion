    "@id": "https://spec.qc.ca/genid/ba9d1a36f82daaaa",
    "@type": [
      "http://schema.org/PerformingGroup"
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Les Nazis<br />\nHumour"
      }
    ]
  },
