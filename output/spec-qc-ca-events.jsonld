  },
  {
    "@id": "https://spec.qc.ca/genid/24a92aafd3a329e1",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-02-27T20:00:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-02-27T23:00:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://spec.qc.ca/genid/b7e7e0d584d94a4d"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://spec.qc.ca/genid/ff058839944b5b3d"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://spec.qc.ca/uploads/st%C3%A9phanie-b%C3%A9n%C3%A9teau-horizontal-77c02fe154f097c81845.jpeg"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/de1d29c67672eb9d"
      },
      {
        "@id": "https://spec.qc.ca/genid/db99ada65a70d40e"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/stephanie-beneteau"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/stephanie-beneteau"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Stéphanie Bénéteau"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "L'art de la parole\nPassion érotique, vengeance meurtrière et amour interdit traversent cette épopée médiévale aux mille rebondissements. Enlèvements, voyages périlleux, combats à l'épée, dragon terrassé et philtre d'amour jalonnent le destin des amants ballottés entre dangers et délices. Autour d'eux gravitent Marc, roi de Cornouaille, et une galerie de personnages singuliers, nains, lépreux et servantes, qui ajoutent humour et relief au récit. Issue des traditions celtiques et chantée depuis le XIIe siècle, cette légende reprend vie sur scène pour votre seul enchantement. \n\nÉclats de parole\nDirectrice du Festival interculturel du conte de Montréal, Stéphanie Bénéteau insuffle sa passion du conte dans chaque projet. Sa voix poétique transforme la tradition orale en moments vivants et intenses. Avec dynamisme et expressivité, elle fait éclater les frontières entre rire et tragédie, amour et devoir, et elle révèle toute l'humanité des histoires. Lyrique, sensuelle et toujours teintée d'humour, sa parole captive et transporte le public dans un univers riche en émotions.\n\nConte. Texte et interprétation : Stéphanie Bénéteau. Mise en scène : Alberto García Sánchez. Spectacle soutenu par le Conseil des arts et des lettres du Québec. Durée : 1 h 25, sans entracte.\n\n\n_\n\n\n\nTarifs\n\nRégulier: 31 $\n\nÉtudiant: 23 $ \n\n\n\nForfait culturel L'Art de la parole\n\n3 spectacles: 18.33 $ ch.\n\n6 spectacles: 11.67 $ ch."
      }
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/SpokenWordPerformance"
      }
    ]
  },
