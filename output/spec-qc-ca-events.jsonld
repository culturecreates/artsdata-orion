    "http://schema.org/image": [
      {
        "@id": "https://spec.qc.ca/uploads/jean-michel-blais-horizontal-c40800a72e572bab499f.jpeg"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/21dd80bf4a1f247a"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/jean-michel-blais"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/jean-michel-blais"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Jean-Michel Blais"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Avec mirador, son quatrième album, Jean-Michel Blais tourne son regard vers un univers vaste et merveilleux, délaissant une certaine retenue minimaliste au profit d'un maximalisme lumineux et généreux. Portée par des choeurs, des cordes et de la musique andine, cette nouvelle création prend la forme d'une vaste fresque onirique inspirée à la fois par les souvenirs d'enfance du pianiste et compositeur montréalais, ses voyages le long de la cordillère des Andes et une résidence marquante en Estonie. Entre éclats du passé et du présent, influences multiples et paysages réels ou rêvés, mirador ouvre un passage vers l'enfance et les contrées intérieures encore inexplorées."
      }
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/Chanson"
      }
    ]
  },
