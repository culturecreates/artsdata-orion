    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/premier-ciel"
      }
    ],
    "http://schema.org/copyrightYear": [
      {
        "@language": "fr",
        "@value": "2026"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Vivez une expérience musicale profondément émouvante où les grands classiques d'Harmonium, incluant des extraits de l'Heptade, reprennent vie sous un regard inédit et chargé de sens. Maude Locat (fille de Serge Locat) et Julie Valois (fille de Louis Valois et Monique Fauteux) évoluent sur scène auprès de leurs complices de Premier Ciel, la seule formation reconnue par Serge Fiori pour faire revivre cette œuvre mythique. Fortes du lien unique qu'elles entretiennent avec cette musique qui les habite depuis toujours, elles proposent une redécouverte sensible et authentique de l'œuvre du groupe culte.   Depuis près de vingt-cinq ans, ces sept musiciens passionnés font vibrer les scènes du Québec avec des interprétations fidèles et puissantes. Ce spectacle, fruit d'une transmission entre générations, célèbre l'héritage d'Harmonium avec authenticité et tendresse. Entre chansons emblématiques, archives, projections, éclairages et mise en scène étudiée, cinquante ans après le dernier concert d'Harmonium, ce concert vous invite à un voyage émouvant, rare et précieux, entre mémoire et musique."
      }
    ],
    "http://schema.org/headline": [
      {
        "@language": "fr",
        "@value": "PREMIER CIEL | SPEC du Haut-Richelieu"
      }
    ],
