  {
    "@id": "https://spec.qc.ca/genid/34fda2d8bd740cfa",
    "@type": [
      "http://schema.org/VideoObject"
    ],
    "http://schema.org/thumbnailUrl": [
      {
        "@id": "https://spec.qc.ca/uploads/cirque-eloize-horizontal-14c5b0f2640e59a8d0b3.jpeg"
      }
    ],
    "http://schema.org/embedUrl": [
      {
        "@id": "https://vimeo.com/1130014515"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/cirque-eloize"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "CIRQUE ÉLOIZE"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": " Originellement créé en 2009 à Incheon, KOR, puis retravaillé pour être présenté dans le cadre du Festival Montréal Complètement Cirque, iD a enchaîné les triomphes : 2 100 représentations dans 33 pays et 140 villes. Le plus grand succès de Cirque Éloize, cette création québécoise emblématique, revient réinventée pour notre époque, avec son décor iconique et une énergie encore plus électrisante. \n\nDans iD - Evolution, la ville devient scène et personnage à part entière. Les acrobates défient la gravité, les danseurs et danseuses explosent en mouvements urbains saisissants, et chaque espace se transforme en terrain de jeu pour l&#039;imaginaire. Trampomur, cerceau aérien, vélo trial, breakdance et plein d&#039;autres disciplines s&#039;entrelacent dans un ballet électrisant où chaque saut, chaque geste et chaque note de musique raconte une histoire. \n\niD-Evolution explore l&#039;identité et la rencontre dans un monde où les corps parlent, s&#039;affrontent et se répondent. C&#039;est une expérience qui secoue les sens, transporte et émerveille, un voyage visuel et sonore où poésie et énergie urbaine se fondent pour créer un spectacle à la fois spectaculaire et profondément humain. \n\n* Veuillez noter que ce spectacle n&#039;est pas admissible au forfait 3 spectacles de la série des P&#039;tites sorties."
      }
    ],
    "http://schema.org/uploadDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-03-24T16:50:00"
      }
    ]
  },
