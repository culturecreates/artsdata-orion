    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/02d6e72aa9e05d0e"
      },
      {
        "@id": "https://spec.qc.ca/genid/43c7f8d180f00f0e"
      },
      {
        "@id": "https://spec.qc.ca/genid/101d81cb6ca78637"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/cercle-philharmonique-de-saint-jean-sur-richelieu-2"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/cercle-philharmonique-de-saint-jean-sur-richelieu-2"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Cercle Philharmonique De Saint-Jean-Sur-Richelieu"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\nLe CPSJ vous invite à un voyage musical autour du monde à la découverte des danses, des rythmes et des traditions qui animent les peuples depuis des générations. D'un continent à l'autre, laissez-vous transporter par des mélodies entraînantes, des élans festifs et des sonorités tantôt éclatantes, tantôt empreintes de nostalgie et de passion.\n\nÀ travers cette mosaïque de cultures, chaque œuvre raconte une histoire et révèle une façon unique de célébrer, de partager et de s'exprimer par la musique et le mouvement.\n\nCe périple musical représente également un défi captivant pour les musiciens de l'orchestre, qui doivent faire preuve d'une grande flexibilité pour adopter les styles, les couleurs et les caractères propres à chaque région. D'une danse à l'autre, ils vous feront voyager avec authenticité et passion à travers une multitude d'univers sonores.\n\nLaissez-vous emporter par l'énergie des rythmes et la richesse des traditions venues des quatre coins du globe. Un concert rassembleur qui vous fera faire le tour du monde... sans quitter votre siège.\n\nABONNEMENT 2 CONCERTS\nAdulte: 55.00$\nÉtudiant: 45.00$\nAjoutez tous vos billets au panier et le prix s'ajustera au moment du paiement"
      }
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/MusicPerformance"
      }
    ]
  },
