    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Beyries"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": " \nAmélie Beyries, professionnellement connue sous le nom de BEYRIES, est une auteure-compositrice-interprète canadienne originaire de Montréal. Elle se lance dans la musique à 28 ans et sort son premier album, Landing, en 2017.\n\nSon deuxième album Encounter sort en 2020, puis son troisième album, Du feu dans les lilas, le premier entièrement en français, paraît en 2024. Il a été unanimement salué et récompensé d'un Félix au Gala de l'ADISQ 2024. \n\nEn 2025, elle dévoile également Reprises, un album où elle revisite des chansons marquantes à sa manière. Beyries est présentement en préparation de son quatrième album original.\n"
      }
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/Chanson"
      }
    ]
