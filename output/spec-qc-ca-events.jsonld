      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://spec.qc.ca/uploads/nouveaux-visgaes-juste-pour-rire-horizontal-73c733d39f12f62afa2e.jpeg"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/4c6100303e5c7395"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/nouveaux-visgaes-juste-pour-rire"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/nouveaux-visgaes-juste-pour-rire"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Nouveaux Visages"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\nÀ la manière d'un gala d'humour, découvrez la tournée « Nouveaux visages Juste pour rire ». Une soirée placée sous le signe du rire, mettant en vedette quatre humoristes émergents soigneusement sélectionnés par les dépisteurs professionnels de Juste pour rire. Sur scène : Claudine Napoléon, Tommy Girard, Pat Savard et Thomas Lapointe.\n\nAdapté des légendaires « New Faces » de « Just For Laughs », reconnus pour avoir révélé plusieurs grandes stars de l'humour anglophones à l'international, dont Jimmy Fallon, Dave Chappelle et Nikki Glaser, ce spectacle est un véritable gage de qualité. Une belle occasion de découvrir quatre talents prometteurs qui incarnent la nouvelle génération de l'humour d'ici, avec des univers et des styles bien à eux. Soyez curieux, venez découvrir la relève et surtout, rire un bon coup!"
      }
    ]
  },
