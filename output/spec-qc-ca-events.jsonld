      {
        "@id": "https://spec.qc.ca/genid/f940963c21df4e35"
      },
      {
        "@id": "https://spec.qc.ca/genid/4a5c5dad5785c785"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/caity-gyorgy"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/caity-gyorgy"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Caity Gyorgy"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Jeudis Shows Hydro-QuébecParmi les jeunes voix à surveiller de la scène jazz canadienne, Caity Gyorgy s'est fait remarquer par son swing naturel, son phrasé enjoué et son talent d'improvisation, qui lui ont notamment valu trois prix JUNO. Inspirée par l'âge d'or du jazz, la chanteuse et compositrice y ajoute une touche moderne, alliant charme et sophistication à chacune de ses performances. En duo avec le pianiste Mark Limacher, elle fait le pont entre tradition et innovation avec un répertoire qui mêle standards intemporels et compositions originales, mettant en valeur sa voix chaleureuse et son timing impeccable. Sa présence dynamique et son sens de la narration captivent le public et promettent une prestation aussi élégante que vivante."
      }
    ]
  },
