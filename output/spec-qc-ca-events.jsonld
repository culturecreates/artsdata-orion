      {
        "@language": "fr",
        "@value": "fr-ca"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "GUY NANTEL | SPEC du Haut-Richelieu"
      }
    ]
  },
