      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/de39a22e1c22fbfa"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/vincent-vallieres"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/vincent-vallieres"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Vincent Vallières"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "La réputation de Vincent Vallières n'est plus à faire. Depuis 1996, l'auteur-compositeur-interprète taille sa place dans les radios avec des chansons marquantes comme On va s'aimer encore, À hauteur d'homme, Lili, Le temps passe mais aussi avec des performances sur scène saisissantes. Récompensé par 3 Félix et fort de 21 nominations au gala de l'ADISQ, Vincent Vallières revient sur scène entouré de ses musiciens avec un tout nouveau spectacle. Son riche répertoire s'y mêle aux pièces de son prochain album, attendu à l'automne 2025. Un spectacle à l'image de cet incontournable de la chanson québécoise: rassembleur, vivant et authentique."
      }
    ]
  },
