      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://spec.qc.ca/uploads/soir%C3%A9e-es-arts-horizontal-99f080308fdbc97b2fe9.png"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/soiree-es-arts"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/soiree-es-arts"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Soirée Ès Arts"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\n\n  \n    Depuis 2006, la Soirée Ès Arts rend hommage\n    à la vitalité culturelle du Haut-Richelieu en reconnaissant\n    le talent, l'engagement et l'impact des artistes, artisans\n    et organismes culturels de la région.\n  \n\n  \n    Plus qu'une cérémonie de remise de prix, cet événement\n    constitue un moment rassembleur où la communauté est\n    invitée à célébrer la créativité sous toutes ses formes.\n  \n\n  Le spectacle\n\n  \n    Conçu par le Théâtre de la boîte à gogosses,\n    le spectacle mettra de l'avant les parcours de chacun\n    des lauréats avec humour et émotion.\n    L'animateur, François Morin, et les artistes\n    invités plongeront les spectateurs dans un univers\n    artistique festif.\n  \n\n  \n    Les prix de la Soirée Ès Arts\n  \n\n  \n\n    \n      Prix Hommage\n      —\n      \n        Reconnaître une carrière d'exception\n      \n    \n\n    \n      Prix Artiste de l'année\n      —\n      \n        Mettre en lumière une carrière en pleine effervescence\n      \n    \n\n    \n      Prix Relève\n      —\n      \n        Promouvoir les talents émergents\n      \n    \n\n    \n      Prix Patrimoine\n      —\n      \n        Valoriser la mémoire et le patrimoine\n      \n    \n\n    \n      Prix Culture et éducation\n      —\n      \n        Favoriser l'accès à la culture\n      \n    \n\n    \n      Prix Projet / événement\n      —\n      \n        Souligner une initiative marquante\n      \n    \n\n    \n      \n        Prix Engagement / contribution au milieu\n      \n      —\n      \n        Reconnaître l'importance de l'écosystème\n      \n    \n\n  \n\n"
      }
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/VarietyPerformance"
      }
    ]
  },
