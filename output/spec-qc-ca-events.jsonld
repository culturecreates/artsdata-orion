    ],
    "http://schema.org/performer": [
      {
        "@id": "https://spec.qc.ca/genid/14a9c80ef8a3d828"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://spec.qc.ca/uploads/jasette-autour-du-bac-horizontal-fbc2f93cb3ed42396640.jpeg"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/jasette-autour-du-bac"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/jasette-autour-du-bac"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Jasette Autour Du Bac"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\nLe recyclage et le compostage vous intriguent? Venez démêler le vrai du faux!\n\nLa Ville de Chambly vous invite à une conférence gratuite animée par Gregory Pratte.\n\nDans une ambiance conviviale et interactive, testez vos connaissances, découvrez les meilleures pratiques en gestion des matières résiduelles et déconstruisez plusieurs mythes entourant le recyclage et le compostage.\n\nUne activité gratuite accessible à tous, instructive et conviviale à ne pas manquer!"
      }
    ]
  },
