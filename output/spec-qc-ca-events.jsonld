        "@value": "630"
      }
    ],
    "http://ogp.me/ns#image:alt": [
      {
        "@language": "fr",
        "@value": "L'humoriste et ancien membre des Chick'N Swell Daniel Grenier sera en spectacle au Cabaret-Théâtre du Vieux-Saint-Jean le 16 janvier 2027"
      }
    ]
  },
  {
    "@id": "https://spec.qc.ca/genid/0771748f89180bde",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-01-16T20:00:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
