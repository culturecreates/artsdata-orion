      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/41fe47c1a8a98d80"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/real-beland"
