      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://spec.qc.ca/genid/c0d64d4c923426cc"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://spec.qc.ca/uploads/richy-jay-horizontal-5a9e5f8cd5f260bf15b6.jpeg"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/richy-jay"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/richy-jay"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Richy Jay"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Originaire d&#039;Haïti et basé à Montréal, Richy Jay révolutionne la scène musicale avec sa fusion captivante de Zouk, Konpa et Afropop. Sacré « Artiste canado-haïtien de l&#039;année 2024 » lors des prestigieux Haitian Music Awards à Miami, il s&#039;impose comme une figure emblématique de la culture caribéenne. Avec des paroles inspirantes et des mélodies entraînantes, Richy Jay raconte des histoires de résilience, d&#039;amour et d&#039;identité, touchant un public toujours plus large. Sa musique va bien au-delà du divertissement : elle célèbre les racines, rassemble les cultures et porte un message fort. Chaque chanson est une célébration, chaque performance un moment inoubliable. Avec Richy Jay, la musique afro-caribéenne ne fait pas que traverser les frontières, elle s&#039;impose au cœur de la scène mondiale.\n\nPremière partie : Cédieu Léveillé et Ellya \n\n\n\n Restez informé\n\nIndiquez votre intérêt pour cet événement en ajoutant ce spectacle à votre panier, ainsi vous serez informé en cas d&#039;annulation \n* Notez qu&#039;aucun billet ne vous sera transmis par courriel et aucun billet ne sera requis pour accéder à l&#039;événement.\n\n\n🎵 Écouter l&#039;extrait"
      }
    ]
  },
