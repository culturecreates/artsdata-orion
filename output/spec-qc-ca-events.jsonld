    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Patrick Groulx"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Patrick Groulx revient avec un cinquième one-man-show, nourri de toute l'expérience et de la tendresse qu'il partage avec son public depuis plus de 25 ans. Toujours aussi spontané et attachant, il transforme ses anecdotes en moments hilarants et rassembleurs. Son humour accessible, son sens de la proximité et son charisme naturel font de chaque spectacle une rencontre chaleureuse. Sa nouvelle création promet autant de surprises que de fous rires, dans un esprit de complicité unique.\n\n\nPROMOTIONS\nCe spectacle est admissible aux promotions\n  Spectacle gratuit à l'achat de 3 spectacles\n  et\n  2 spectacles pour 85 $.\n  Ajoutez vos billets au panier et le tarif s'ajustera automatiquement selon la promotion applicable.\n"
      }
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/ComedyPerformance"
      }
    ]
