    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Eli Rose"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\nEli Rose propose un spectacle pop francophone immersif et rassembleur, porté par des succès que tout le monde connaît. Sa présence scénique naturelle, combinée à des projections visuelles et une mise en lumière enveloppante, crée une expérience à la fois festive et émotive, où le public chante et participe du début à la fin.\n\n🎵 Écouter l'extrait"
      }
    ],
