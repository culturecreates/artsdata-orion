  {
    "@id": "https://spec.qc.ca/genid/c5f7cfc6851733d3",
    "@type": [
      "http://schema.org/VideoObject"
    ],
    "http://schema.org/thumbnailUrl": [
      {
        "@id": "https://spec.qc.ca/uploads/billy-tellier-horizontal-92e5398c3963d4994f77.jpeg"
      }
    ],
    "http://schema.org/embedUrl": [
      {
        "@id": "https://www.youtube.com/watch?v=I6SUl033GNU"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/billy-tellier"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "BILLY TELLIER"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": " Fort de son immense succès avec plus de 50 000 billets vendus et près de 200 représentations, Billy Tellier revient avec son 3e one-man-show Kicker la ruche. Fidèle à son style percutant, il aborde des sujets universels avec humour et justesse. Cette fois-ci, il partage ses réflexions sur la peur de faire les mauvais choix. Toute sa vie, Billy a joué le rôle de l'abeille modèle, prenant des décisions sages pour ne pas déranger son entourage. Mais aujourd'hui, il se demande s'il ne serait pas temps de secouer les choses. Doit-il vraiment \"kicker la ruche\" et bouleverser son quotidien? Une question complexe pour quelqu'un qui stresse à l'idée de choisir entre crémeuse ou traditionnelle!\n\n\nPROMOTIONS\nCe spectacle est admissible aux promotions\n  Spectacle gratuit à l'achat de 3 spectacles\n  et\n  2 spectacles pour 85 $.\n  Ajoutez vos billets au panier et le tarif s'ajustera automatiquement selon la promotion applicable.\n"
      }
    ],
    "http://schema.org/uploadDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-09-02T12:23:00"
      }
    ]
  },
