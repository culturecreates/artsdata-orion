    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Fort de son immense succès avec plus de 50 000 billets vendus et près de 200 représentations, Billy Tellier revient avec son 3e one-man-show Kicker la…"
      }
    ],
    "http://ogp.me/ns#image": [
