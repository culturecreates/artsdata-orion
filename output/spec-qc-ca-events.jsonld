      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://spec.qc.ca/uploads/cabaret-jazz-band-horizontal-750b1ddbed35545c7736.jpeg"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/c93c2a1a7984d565"
      },
      {
        "@id": "https://spec.qc.ca/genid/93d3c42977bf2d0e"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/cabaret-jazz-band-3"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/cabaret-jazz-band-3"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Cabaret Jazz Band"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "La chanteuse Bïa retrouve le Cabaret Jazz Band pour rendre hommage à Georges Moustaki, immense figure de la chanson francophone avec qui elle a partagé de précieux moments sur scène. Sous la direction de Pierre-Armand Tremblay, les musiciens revisitent ses plus belles chansons dans une ambiance chaleureuse où se mêlent poésie, jazz et influences du Brésil, de la France et du Québec.\nCe qu&#039;ils en disent :\n« J&#039;ai adoré cette musique lumineuse et enjouée et Bïa était époustouflante! »\n- Louise B. \n\n« Bia est une chanteuse exceptionnelle que j&#039;ai eu la chance de voir et entendre pour la première fois au Jeudis Shows il y a déjà plusieurs années. Merci au Cabaret Jazz Band de l&#039;avoir invitée. »\n- Françoise D.\n\n« Comme toujours nous sommes ravis de nôtre soirée! Belle présence de Bïa avec la complicité des musiciens et des choristes! Bravo et Merci! »\n- Roger B."
      }
    ]
  },
  {
    "@id": "https://spec.qc.ca/genid/b388b728c9031c2c",
    "@type": [
      "http://schema.org/PerformingGroup"
    ],
    "http://schema.org/name": [
