      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Cathy Gauthier"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "On l'a connue intense, flamboyante, sans filtre.  Aujourd'hui, elle revient avec ce nouveau spectacle dans lequel elle se dévoile comme jamais auparavant. Derrière l'image de la femme forte se cache une femme ultra-sensible, une mère, une amoureuse, une battante mais surtout une humaine.\n\nAvec son sens du punch incomparable et une sincérité désarmante, elle explore le poids des attentes, la quête d'équilibre et le courage d'être soi. \n\nPlus sensible. Plus assumée. Toujours hilarante."
      }
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/ComedyPerformance"
      }
    ]
  },
