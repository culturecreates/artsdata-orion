    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/prairie-comeau"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "PRAIRIE COMEAU"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\nLe duo Prairie Comeau, composé d'Anique Granger et de Benoit Archambault, réarrange et interprète des extraits du livre La bonne chanson. Il y a le répertoire connu qui a bercé notre enfance et nos ancêtres dont Partons la mer. Il y a aussi des pièces plus obscures, mais surtout, il y a la relecture toute fraîche qu'en fait ce couple d'auteurs-compositeurs avec l'album L'emprunt(e). Le duo fait revivre ce patrimoine en misant sur les guitares et les harmonies vocales. Voilà une perspective surprenante, douce et nostalgique sur la chanson traditionnelle.\n\n\n\nCe projet est une présentation de la Ville de Chambly."
      }
    ],
    "http://schema.org/uploadDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-08-31T10:03:00"
      }
    ]
  },
