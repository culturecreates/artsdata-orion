    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/a56b5ff5ade091d5"
      },
      {
        "@id": "https://spec.qc.ca/genid/96a0ed4463da2b09"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/belle-grand-fille"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/belle-grand-fille"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Belle Grand Fille"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Jeudis Shows Hydro-Québec\nAutrice-compositrice-interprète reconnue pour son univers empreint de beauté et d'authenticité, Belle Grand Fille présente Noël nouvelet, un spectacle lumineux qui marie le folk à la musique ancienne. Puisant dans les cantiques de Noël des 15e et 16e siècles, elle revisite ces airs intemporels avec une approche dépouillée et délicate. Pour l'occasion, elle s'entoure des autrices-compositrices-interprètes Jeanne Côté et Sandra Contour, ainsi que de trois musiciens, pour redonner vie à ce répertoire dans un esprit de partage et de plaisir musical. Portées par la voix chaleureuse de Belle Grand Fille, ces mélodies offrent une parenthèse douce et rassembleuse, parfaite pour ralentir et savourer les derniers jours de l'année en musique."
      }
    ]
  },
