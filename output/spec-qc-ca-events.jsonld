        "@language": "fr",
        "@value": "L'humoriste Guillaume Pineault sera au Centre culturel de Venise-en-Québec le 4 juillet 2026 et au Pôle culturel de Chambly le 5 décembre 2026 à 20h00."
      }
    ]
  },
  {
    "@id": "https://spec.qc.ca/genid/f41efcba86976e28",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
