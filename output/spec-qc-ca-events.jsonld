      {
        "@language": "fr",
        "@value": "Drag Show"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\n🎤🎶 Spectacle de drag queens &amp; musique variée ! 🎶🎤\n\nAttendez-vous à une soirée remplie de musique, de glamour, d'humour et de performances flamboyantes avec quatre artistes qui sauront mettre le feu à la scène :\n\nMichel D'orientation\nTracey Trash\nChochoune\nCiatha Night\n\n\n  \n"
      }
    ],
