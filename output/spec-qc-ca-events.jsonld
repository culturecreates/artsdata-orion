    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "MIKE BEAUDOIN | SPEC du Haut-Richelieu"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Après le succès de sa première tournée VRAI et ses passages toujours remarqués à CKOI, Mike Beaudoin revient sur scène avec son très attendu deuxième…"
      }
    ],
