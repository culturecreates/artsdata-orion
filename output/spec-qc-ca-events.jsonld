    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/18c74ac828308022"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/sortileges-et-ceramiques-latelier-magie"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/sortileges-et-ceramiques-latelier-magie"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Sortilèges Et Céramiques : L'atelier Magique"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\nVivez une soirée enchantée lors de notre atelier décor sur céramique à thème sorcier, en l'honneur du retour annuel de la magie d'Harry Potter ! Cet événement vous invite à plonger dans l'univers merveilleux du jeune sorcier, le 14, 21 et 28 novembre, de 18h à 21h au Musée du haut-Richelieu.\n\nLors de cette session créative, vous aurez l'occasion de décorer une céramique à l'effigie de l'univers Harry Potter : une tasse, une assiette ou encore un boitier, que vous pourrez personnaliser avec des motifs de sorciers, de balais, de créatures magiques ou d'objets emblématiques. Tout le matériel nécessaire est fourni, et nos animateurs experts vous guideront pas à pas pour laisser libre cours à votre imagination dans une ambiance chaleureuse, conviviale et pleine de magie.\n\nC'est l'occasion idéale de partager un moment créatif et féérique en famille ou entre amis, tout en célébrant le retour de cette saga légendaire.\n\nEn cadeau, chaque participant recevra une petite surprise sucrée pour goûter aux saveurs surprenantes et amusantes de l'univers Harry Potter.\n\nNe manquez pas cette célébration de magie et de créativité au Musée du Haut-Richelieu ! Réservez dès maintenant votre place pour vivre un moment unique où l'art et la sorcellerie se rencontrent dans un univers fantastique.\n\nPsst ! Pour les plus courageux, nous avons également un mini questionnaire sur les films et livres Harry Potter 😉 \n\n Informations à retenir\n\nQuand : 14, 21 et 28 novembre de 18h à 21h\nCoût : 30.99$ (taxes et frais inclus) \nInclus : Une pièce de céramique et une petite surprise à déguster\nOù : 182, rue Jacques-Cartier Nord, Saint-Jean-sur-Richelieu"
      }
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/VarietyPerformance"
      }
    ]
  },
