    "http://schema.org/image": [
      {
        "@id": "https://spec.qc.ca/uploads/dj-ahmet-le-gar%C3%A7on-qui-faisait-danser-les-collines-horizontal-f16f224dbff8ad1332c9.jpeg"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/dj-ahmet-le-garcon-qui-faisait-danser-les-collines"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/dj-ahmet-le-garcon-qui-faisait-danser-les-collines"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Dj Ahmet, Le Garçon Qui Faisait Danser Les Collines"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\nComédie dramatique. Macédoine du Nord, République tchèque, Serbie, Croatie. 2025. 1 h 39 min. (G)\n\nDans les montagnes de Macédoine, Ahmet, 15 ans, partage son quotidien entre les responsabilités familiales et son rêve de devenir musicien. Alors qu&#039;il garde les moutons de son père et veille sur son petit frère, il cherche à trouver sa propre voie. Entre les attentes de son entourage et son désir de liberté, Ahmet devra apprendre à s&#039;affirmer pour suivre le chemin qui lui ressemble. Présenté en version originale, avec sous-titres français.\n\nLa projection sera suivie d&#039;une rencontre et d&#039;une discussion autour du film, en compagnie d&#039;une personne invitée.\n\n\n\n🎬 Voir la bande-annonce"
      }
    ]
  },
