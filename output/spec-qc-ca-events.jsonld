      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/rock-story"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/rock-story"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Rock Story"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": " Soulignant cette année son 20e anniversaire, la légendaire revue musicale des plus grands classiques du rock, interprétés par Jean Ravel et Andie Duquette, vous fera vivre avec passion un répertoire magique et intemporel qui touche toutes les générations!\n\nRock Story fût le premier spectacle en ce genre et connait toujours un immense succès grâce à la performance de leurs excellents musiciens. Avec plus de 500 représentations, Rock Story est l'ultime voyage dans vos souvenirs.\n\nRock Story, une rafale de hits tels que : U2, Styx, Queen, Journey, Foreigner, The Eagles, Boston, Heart, Pat Benatar, Janis Joplin, Alannah Myles et plus encore. Toutes des chansons que vous connaissez par cœur!\n\nRock Story, un incontournable!"
      }
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/Chanson"
      }
    ]
  },
