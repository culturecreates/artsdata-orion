    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/acd65fa04ddff7f8"
      },
      {
        "@id": "https://spec.qc.ca/genid/a6d1cf941be843c2"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/jean-michel-anctil"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/jean-michel-anctil"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Jean-Michel Anctil"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\nJean-Michel Anctil n'avait pas envie d'un retour, mais de retrouvailles. C'est donc à l'occasion de ses 60 ans qu'il présentera un tout nouveau spectacle, limité à 60 représentations seulement, pour célébrer, rire et se retrouver. Cette tournée sera une grande célébration assumée où chaque soir réservera sa surprise : un artiste mystère viendra le rejoindre sur scène. Au programme : matériel inédit, numéros coup de cœur revisités et retour de personnages marquants comme Râteau et Priscillia. Avec l'expérience et le regard de ses 60 ans, il aborde le temps qui passe et ses surprises, fidèle à sa signature drôle, humaine et touchante."
      }
    ]
  },
  {
    "@id": "https://spec.qc.ca/genid/b5d73e9bf8e15a69",
    "@type": [
      "http://schema.org/PerformingGroup"
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Surprise ... c'est ma fête!<br />\nHumour"
      }
    ]
  },
