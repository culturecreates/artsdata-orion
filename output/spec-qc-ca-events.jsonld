    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/marthe-laverdiere"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Marthe Laverdière"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": " Dans son 2e spectacle, l'inimitable Marthe nous entraîne dans les coulisses de sa nouvelle vie... celle qui a complètement basculé depuis qu'elle est devenue connue.\nEt fidèle à elle-même, Marthe va encore plus loin et encore plus vite ! Après 45 ans de mariage avec son légendaire Minou, le couple a accumulé une foule d'anecdotes savoureuses et jamais racontées... jusqu'à maintenant.\nPour J'ai dit oui !, Marthe retrouve Mario Jean, à la mise en scène et à la script-édition, pour une nouvelle collaboration complice et éclatée."
      }
    ]
  },
  {
    "@id": "https://spec.qc.ca/genid/678583d504b1a59a",
    "@type": [
      "http://schema.org/PerformingGroup"
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "J'ai dit oui!<br />Humour"
      }
    ]
  },
