    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/148d2d2c9bdddc16"
      },
      {
        "@id": "https://spec.qc.ca/genid/e1eacc90158f2c29"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/mariana-mazza"
      }
    ],
    "http://schema.org/url": [
      {
