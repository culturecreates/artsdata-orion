      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://spec.qc.ca/genid/6a6e3d162f12ca99"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://spec.qc.ca/uploads/dom-babin-horizontal-daf64ddb5b6fb580c49d.jpeg"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/fad62f1297b5a88b"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/dom-babin"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/dom-babin"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Dom Babin"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Suivi par plus de 400 000 abonnés sur le Web, l&#039;humoriste Dom Babin s&#039;est imposé avec un style bien à lui. Il se distingue par un humour engagé à la parlure assumée, capable de faire sourire les gens sans dents et grincer ceux qui en ont. Celui que vous avez peut-être découvert dans la série À la poursuite du rêve glacé sur Crave est nommé au Gala Les Olivier 2026 dans les catégories Capsule web de l&#039;année et Numéro d&#039;humour de l&#039;année. Avec son premier one-man-show, Américain du Nord français, mis en scène par Adib Alkhalidey, Dom Babin parcourt la province pour livrer un spectacle franc, mordant et sans filtre. Ni érudit, ni sociologue, ni politicien, ni anthropologue, l&#039;humoriste se décrit comme trop Américain pour être Français, trop Canadien pour être Américain, trop Français pour être Canadien. Ni tout à fait l&#039;un, ni complètement l&#039;autre. Un gars qui a bûché pour se tailler une place et qui monte sur scène pour se brûler un peu, juste assez pour réchauffer son public."
      }
    ]
  },
