    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Spectacle sur scène et projections immersives\n\nVivez l'énergie incomparable de Guylaine Tanguay dans un spectacle country immersif où sa voix, sa présence et ses chansons prennent une ampleur nouvelle. Portée par des projections monumentales, cette soirée vous enveloppe dans une expérience plus grande que nature. Un rendez‑vous vibrant et lumineux avec l'une des artistes les plus aimées du Québec."
      }
    ]
  },
