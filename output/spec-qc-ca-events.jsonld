      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://spec.qc.ca/genid/4b7b7a7436252054"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://spec.qc.ca/uploads/francis-degrandpr%C3%A9-horizontal-836be43571506a072a44.jpeg"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/59a224353e05a3a6"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/francis-degrandpre"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/francis-degrandpre"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Francis Degrandpré"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": " \nEn moins de trois ans, l'auteur-compositeur-interprète Francis Degrandpré est passé de l'ami qui chante au bord du feu à un artiste accompli qui fait lever les foules aux quatre coins de la province. Avec un son new country francophone unique et une voix grave et profonde qui n'a rien à envier aux plus grands artistes country, Francis se démarque sur la scène musicale québécoise avec ses thèmes rassembleurs de chasse, de pêche, de nature et de bon temps entre amis. \n\n\nFrancis fait maintenant chanter les fans de country par milliers avec ses propres chansons et son deuxième album Se laisser aller, paru en septembre 2024, promet de faire voyager sa musique encore plus loin! \n\nIl a remporté en 2023 le Félix de l'Album Country de l'année à l'ADISQ et a été récompensé trois fois lors du Gala Country pour Chanson de l'année, Album country contemporain et Auteur compositeur de l'année."
      }
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/Chanson"
      }
    ]
  },
