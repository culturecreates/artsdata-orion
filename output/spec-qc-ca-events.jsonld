    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/7e61d3ce76a29c0c"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/richardson-zephir"
