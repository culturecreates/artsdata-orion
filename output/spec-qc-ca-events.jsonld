    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/87d2affb0dbe5e24"
      },
      {
        "@id": "https://spec.qc.ca/genid/d80b5c5e65fd2b39"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/les-soirees-dhumour-dalexis-fortin"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/les-soirees-dhumour-dalexis-fortin"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Les Soirées D'humour D'alexis Fortin"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "18 ans et + Animée par Alexis Fortin, venez découvrir les prochaines vedettes de l'humour dans l'intimité et le charme qu'offre Le 164. Chaque soirée rassemble une variété d'humoristes aux styles différents, pour vous offrir toutes sortes de rires.\n\nAlexis Fortin à l'animation \n\nFinissant de l'École nationale de l'humour en 2024, l'humoriste originaire de Saint-Jean-sur-Richelieu se démarque par son aisance sur scène et son sens de la répartie. Fan d'improvisation? Son nom vous dit peut-être quelque chose : il a affûté son sens du punch dans différentes ligues : de la Pantouflerie d'Armand-Racicot, la CLIC et Flip-Flop, puis durant trois ans au Cégep de Saint-Jean. Maintenant habitué des bars, des événements corporatifs et animateur de l'Open-Mic au Bordel Comédie Club, il mène chaque soirée avec énergie et naturel et cette fois, dans sa ville d'origine!"
      }
    ]
  },
