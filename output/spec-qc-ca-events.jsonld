    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/76e8eb03ea8b30fa"
      },
      {
        "@id": "https://spec.qc.ca/genid/bd3afe4ccb07bd04"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/ouellet"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/ouellet"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Ouellet"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "18 ans et +\nOUELLET - Le stand-up mordant du moment!\n\nVous l'avez peut-être vu au ComédiHa! Fest, à Juste pour rire ou en première partie de Jean-Michel Anctil... Mais cette fois, Ouellet débarque avec SON show, 100 % inédit et pleinement assumé.\n\nGaspésien fier et barbu attachant, il incarne cette génération d'humoristes qui allient observations sociales aiguisées et efficacité comique redoutable. Révélation du ComédiHa! Fest 2023, il ne recule devant aucun sujet et n'épargne personne — surtout pas ceux qu'il aime!\n\nOuellet peaufine en ce moment même son prochain one-man-show. Un rodage cru, drôle, mordant et surtout authentique, livré avec toute la fougue d'un gars de chez nous. C'est franc, c'est drôle, et ça frappe juste. Venez voir Ouellet avant que tout le monde en parle.\n  \n\n* Ce spectacle n'est pas admissible à la promotion « Spectacle gratuit à l'achat de 3 spectacles »."
      }
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/ComedyPerformance"
      }
    ]
  },
