      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://spec.qc.ca/genid/4edf55680c14a96b"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://spec.qc.ca/uploads/la-magie-de-no%C3%ABl-horizontal-c0c883aadf30c60b5539.jpeg"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/00d7afc1ddb51687"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/la-magie-de-noel"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/la-magie-de-noel"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "La Magie De Noël"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\nAlerte au pôle Nord ! la magie de Noël a disparu. Sans elle, pas de tournée, pas de cadeaux, pas de nuit enchantée. Le Père Noël et son lutin Bourrasque ont besoin de renfort. Et ce renfort, ce sont les enfants dans la salle. Dans ce spectacle interactif, petits et grands deviennent les héros de l'aventure et participent activement aux péripéties. Tours de magie, chansons entraînantes et moments de comédie se succèdent dans un univers féerique où les rires et l'émerveillement prennent toute la place. Solidarité et imagination deviennent les clés pour sauver Noël et redonner vie à la magie de cette nuit exceptionnelle. \n\nVariété\nDurée : 45 minutes.\nProduction : Alinéa Productions\nPublic cible : 4 à 8 ans\n\nForfait 3 spectacles pour 48 $\nAjoutez tous les spectacles au panier et le tarif s'ajustera automatiquement."
      }
    ]
  },
