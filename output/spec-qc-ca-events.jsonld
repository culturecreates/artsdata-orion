      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://spec.qc.ca/genid/c0d64d4c923426cc"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://spec.qc.ca/uploads/alexandre-belliard-horizontal-8c1eeadd1e6137aedb59.jpeg"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/alexandre-belliard-2"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/alexandre-belliard-2"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Alexandre Belliard"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dans son poème An American Prayer, publié à titre posthume en 1978, Jim Morrison, légendaire leader des Doors, pose cette question : « Est-ce que tu as eu une belle vie avant de mourir? — Assez pour en faire un film? » Traduction libre de : « Did you have a good world when you died? — enough to base a movie on? »\n\nDepuis plus de 15 ans, Alexandre Belliard chante et raconte aux quatre coins de la planète la vie de celles et ceux qui ont contribué à bâtir le monde dans lequel nous vivons aujourd&#039;hui. Avec ce nouveau spectacle, il braque les projecteurs sur les artisans du 7e art et les personnages dont la vie ou l&#039;œuvre ont été projetées sur grand écran.\n\nPierre Falardeau, Robert Lepage, Jeanne Mance, Radisson, Jack Kerouac, Marie Laveau, Louis Cyr, Gilles Villeneuve, « Che » Guevara, Arthur Rimbaud, Denis Vanier, Félix Leclerc, Pauline Julien et Renaud en sont quelques exemples. Alexandre pige dans son étonnante galerie de personnages pour vous partager leurs combats, leurs espoirs, leurs histoires, quoi! \n\n\n\n Restez informé\n\nIndiquez votre intérêt pour cet événement en ajoutant ce spectacle à votre panier, ainsi vous serez informé en cas d&#039;annulation \n* Notez qu&#039;aucun billet ne vous sera transmis par courriel et aucun billet ne sera requis pour accéder à l&#039;événement.\n"
      }
    ]
  },
