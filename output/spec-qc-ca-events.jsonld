    "http://schema.org/embedUrl": [
      {
        "@id": "https://www.youtube.com/watch?v=S53CrJqwIHM"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/mon-amour-cest-pour-le-restant-de-mes-jours"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "MON AMOUR, C'EST POUR LE RESTANT DE MES JOURS"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Ciné-club du Haut-Richelieu\n\n« La vie passe à travers les films. » Dans ce documentaire des plus intimes, André-Line Beauparlant prend la caméra pour mieux comprendre la vie et l'œuvre de son amoureux, le cinéaste Robert Morin. Alors que l'image composée d'extraits de films, de séquences de tournage, de conversations et d'archives personnelles révèle les dessous et l'envers du décor de leur collaboration au cinéma et dans la vie, la narration compose une biographie double qui réfléchit l'amour, l'obsession, le passage du temps et la mort. Guidé par un profond désir d'aller à la rencontre de l'autre, Mon amour, c'est pour le restant de mes jours est une lettre d'amour, un journal du quotidien, une proposition résolument féministe : celle de conjuguer la création au pluriel.\n\nEn collaboration avec Le Festival International du Film sur l'Art (Le FIFA), dans le cadre de sa tournée régionale « LE FIFA PRÈS DE CHEZ VOUS ». \n\n🎬 Voir la bande-annonce\n\n"
      }
    ],
    "http://schema.org/uploadDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-10-05T15:02:00"
      }
    ]
  },
