        "@language": "fr",
        "@value": "GALA COMÉDIE STAR - Humour | SPEC du Haut-Richelieu"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Le Gala Comédie Star est de retour à Saint-Jean pour une soirée où les grands noms de l'humour se donnent carte blanche! À tour de rôle, cinq humoristes…"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://spec.qc.ca/uploads/_1200x630_crop_center-center_82_none/gala-comédie-star-horizontal-05c5a3a914bfc4193ec4.jpeg?mtime=1791468233"
      }
    ],
