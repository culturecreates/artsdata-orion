    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/5ee74fa635dd1e95"
      },
      {
        "@id": "https://spec.qc.ca/genid/a9d50f1ae69bbd87"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/anais-barbeau-lavalette"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/anais-barbeau-lavalette"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Anaïs Barbeau-Lavalette Et Steve Gagnon"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "L'art de la parole\nD'une rencontre aux îles de la Madeleine est née une promesse simple : continuer à s'écrire. Peu à peu, Steve Gagnon et Anaïs Barbeau-Lavalette ont orienté leur correspondance vers un seul thème : la joie. La joie choisie, réfléchie, travaillée. Une attitude devant les injustices, un socle à la colère, à la solitude, à la tristesse. Dans un monde où s'autoriser l'émerveillement devient de plus en plus difficile, c'est avec autant d'humour que de tendresse que leurs voix tracent ensemble le chemin fragile de la joie comme permission, comme désobéissance, comme moteur de résistance.\n\nL'éclat en partage\nCes 41 lettres, d'abord privées, ont trouvé leur forme dans un livre avant de prendre vie sur scène, révélant des zones de vulnérabilité assumées. Steve, plus réservé devant la joie, et Anaïs, naturellement lumineuse, offrent une réflexion sincère : la joie n'est pas une abstraction, mais une manière d'habiter le monde.\n\n\n\nRécit théâtral. Texte et interprétation : Anaïs Barbeau-Lavalette, Steve Gagnon. Musicien : Cédric Dind-Lavoie. Mise en lecture : Sophie Cadieux. Production : La Tribu. Durée : 1 h 15, sans entracte.\n\n\n_\n\n\n\nTarifs\n\nRégulier: 44 $\n\nÉtudiant: 23 $ \n\n\n\nForfait culturel L'Art de la parole\n\n3 spectacles: 18.33 $ ch.\n\n6 spectacles: 11.67 $ ch."
      }
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/SpokenWordPerformance"
      }
    ]
  },
