    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/03b4a2e39ba9ecf9"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/jean-francois-mercier"
