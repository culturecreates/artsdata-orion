      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://spec.qc.ca/uploads/duo-poirier-fortin-horizontal-a63c44751c0b88a5e2e9.jpeg"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/d46a3a75428fa15f"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/duo-poirier-fortin"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/duo-poirier-fortin"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Duo Poirier-Fortin"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\nLe Duo Fortin-Poirier célèbre ses 20 ans de carrière avec Harmonie des opposés. Depuis deux décennies, les deux pianistes se distinguent par leur complicité inspirante et leur approche audacieuse du piano à quatre mains. Amélie Fortin et Marie-Christine Poirier proposent un concert où musique, jeux de lumière et projections en direct se rencontrent afin de faire vivre chaque œuvre dans toute sa richesse émotionnelle. Vous les avez peut-être récemment entendues aux côtés de Pierre Lapointe, qu&#039;elles accompagnent actuellement pour sa tournée Dix chansons démodées pour ceux qui ont le cœur abîmé. Un nouveau spectacle porté par l&#039;un des duos de piano les plus dynamiques de leur génération.\n\n\n\nCe projet est une présentation de la Ville de Chambly."
      }
    ]
  },
