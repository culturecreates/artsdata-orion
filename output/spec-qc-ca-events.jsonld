      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://spec.qc.ca/uploads/simon-delisle-horizontal-10cd03d2550763e4e7b8.jpeg"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/93382f974d85166c"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/simon-delisle"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/simon-delisle"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Simon Delisle"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Fort du succès de TACHE, son deuxième one-man show, Simon Delisle revient en supplémentaire pour une soirée où l'autodérision et les observations mordantes sont à l'honneur. Avec son regard singulier sur la vie, il s'attaque aux multiples sens du mot « tache » : son apparence atypique et son vitiligo, les obstacles rencontrés sur son parcours, les personnes qui l'ont freiné, mais aussi les marques que la vie laisse derrière elle. Entre résilience, doutes et remises en question, Simon transforme les épreuves en matière à rire avec une écriture incisive, des images percutantes et une redoutable aisance sur scène. Une véritable décharge d'humour qui promet son lot de rires... et quelques bonnes courbatures aux joues!\n\n"
      }
    ]
  },
