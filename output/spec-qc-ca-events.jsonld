    "http://schema.org/image": [
      {
        "@id": "https://spec.qc.ca/uploads/r%C3%A9al-b%C3%A9land-horizontal-017cb7a07a409df32000.jpeg"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/41fe47c1a8a98d80"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
