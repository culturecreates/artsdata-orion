  {
    "@id": "https://spec.qc.ca/genid/e3635770daf49833",
    "@type": [
      "http://schema.org/VideoObject"
    ],
    "http://schema.org/thumbnailUrl": [
      {
        "@id": "https://spec.qc.ca/uploads/boogie-wonder-band-horizontal-0c9370d70b88e29f2286.jpeg"
      }
    ],
    "http://schema.org/embedUrl": [
      {
        "@id": "https://www.youtube.com/watch?v=fiec47vyvks&amp;list=RDfiec47vyvks&amp;start_radio=1"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/boogie-wonder-band"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "BOOGIE WONDER BAND"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le Boogie Wonder Band, célèbre pour son énergie contagieuse et ses grooves irrésistibles, présente un tout nouveau spectacle électrisant «Disco Honey»! Plongez dans un tourbillon de paillettes et de boules miroirs, où les rythmes endiablés de la basse et les envolées des cuivres vous transportent instantanément dans l'atmosphère exaltant des années disco.\n  \nDe Donna Summer aux Bee Gees, en passant par Gloria Gaynor et KC &amp; the Sunshine Band, le répertoire du Boogie Wonder Band rassemble les plus grands hits qui ont marqué l'histoire de la musique des années 70.\n  \nAttendez-vous à des costumes étincelants, à des chorégraphies captivantes et à une ambiance électrisante qui vous incitera à vous lever pour rejoindre la piste de danse.\n  \nQue vous soyez un nostalgique des années disco ou simplement en quête d'une soirée inoubliable, le spectacle du Boogie Wonder Band est un incontournable pour tous les amateurs de musique. Préparez-vous à danser, à chanter et à célébrer, car, avec le Boogie Wonder Band, la fête ne fait que commencer!"
      }
    ],
    "http://schema.org/uploadDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-08-13T18:19:00"
      }
    ]
  },
