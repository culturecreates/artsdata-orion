    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Jeudis Shows Hydro-Québec  Artiste versatile, Adam El Mouna navigue entre pop et soul, tout en intégrant des touches inspirées de son héritage marocain…"
      }
    ],
