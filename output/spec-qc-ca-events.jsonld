    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Jay Kutcher"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Jeudis Shows Hydro-Québec\nFigure montante du new country au Québec et au Canada, Jay Kutcher s'est fait remarquer comme finaliste de La Voix en 2013, où il s'est distingué par son authenticité et son lien direct avec le public. En 2023, il franchit une nouvelle étape avec son premier extrait anglophone, Another You, propulsé dans le Top 40 des radios country canadiennes. Avec un album prévu pour 2026, Jay Kutcher est prêt à s'imposer comme l'une des figures incontournables du country canadien. En formule acoustique trio, il présente son nouveau spectacle King of the Bar, un véritable party où il enchaîne les chansons de son premier album, des inédits de son prochain et des reprises de classiques country qui vous feront assurément chanter. Plongez dans l'atmosphère survoltée et conviviale d'une soirée digne de Nashville !"
      }
    ]
  },
