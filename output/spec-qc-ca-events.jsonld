      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://spec.qc.ca/genid/a627fa1526ba077e"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://spec.qc.ca/genid/3cec742752c86b6d"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://spec.qc.ca/uploads/guy-nantel-horizontal-3e381072c307c9130b31.jpeg"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/f76aef5c296b816c"
      },
      {
        "@id": "https://spec.qc.ca/genid/2841fe7aed919680"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/guy-nantel"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/guy-nantel"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Guy Nantel"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Alors que l'actualité regorge de sujets explosifs, d'opinions tranchées et de\ncontradictions bien de chez nous, l'humoriste Guy Nantel revient avec un tout\nnouveau spectacle au titre pour le moins intrigant : Bienveillant.\n\nOui, vous avez bien lu. BIENVEILLANT. Le mot qu'on associe le moins\nspontanément à un humoriste reconnu pour son franc-parler, son regard critique\net son humour sociopolitique sans compromis. Disons que le titre donne le ton!\nDepuis toujours, Nantel est cette voix différente qui ose dire tout haut ce que tout\nle monde pense tout bas. Avec sa lucidité mordante et son ironie bien placée, il\nmet le doigt sur nos travers collectifs, nos incohérences et nos grands débats\nd'époque, tout ça au grand plaisir du public. Avec ce 7e spectacle en carrière, Guy\nNantel continue de faire ce qu'il fait le mieux : nous dérouter, nous désarmer et\nsurtout nous faire rire à gorge déployée!\n\nMais la question demeure : comment s'y prend-il pour le faire avec bienveillance?\nOn ne demande qu'à voir... mais surtout à entendre. Avouez que ça promet!\n\n\nPROMOTIONS\nCe spectacle est admissible aux promotions\n  Spectacle gratuit à l'achat de 3 spectacles\n  et\n  2 spectacles pour 85 $.\n  Ajoutez vos billets au panier et le tarif s'ajustera automatiquement selon la promotion applicable.\n"
      }
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/ComedyPerformance"
      }
    ]
  },
