    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/a49bb350d2c27f17"
      },
      {
        "@id": "https://spec.qc.ca/genid/32c12b915d1b5436"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/adam-el-mouna"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/adam-el-mouna"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Adam El Mouna"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\nJeudis Shows Hydro-Québec\n\nArtiste versatile, Adam El Mouna navigue entre pop et soul, tout en intégrant des touches inspirées de son héritage marocain pour créer une musique actuelle et rassembleuse. Sur scène, sa voix singulière, son énergie théâtrale et son charisme font de chaque chanson une véritable histoire. Sa présence scénique généreuse et son interprétation tout en nuances captivent dès les premières notes et créent une connexion immédiate avec le public. Révélé au grand public lors de son passage à La Voix en 2023, l'auteur-compositeur-interprète québéco-marocain a depuis connu une ascension remarquable. En 2025, il remporte le 57e Festival international de la chanson de Granby et reçoit le prix des diffuseurs européens au RIDEAU, confirmant la reconnaissance de son talent par l'industrie. Adam El Mouna est un artiste à découvrir sur scène, là où sa musique prend toute son ampleur\n* Ce spectacle n'est pas admissible à la promotion « Spectacle gratuit à l'achat de 3 spectacles »."
      }
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/Chanson"
      }
    ]
  },
