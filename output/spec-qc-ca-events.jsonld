    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Après le succès remarqué de 'Fiori-Séguin & Cie', Mathieu Grégoire revient avec 'L'Héritage Britannique - The Jukebox'. Ce spectacle électrisant vous…"
      }
    ],
