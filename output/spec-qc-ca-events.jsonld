      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/geoffroy"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Geoffroy"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": " \nAprès quatre albums, l'auteur-compositeur-interprète montréalais Geoffroy continue de faire évoluer son univers musical, mêlant ses racines d'auteur-compositeur-interprète aux sonorités électros et aux influences de la musique du monde entier. Son plus récent album, Good Boy (2024), marque un chapitre plus lumineux dans une discographie qui comprend également Coastline (2017), 1952 (2019) et Live Slow Die Wise (2022).\n\nSur scène, Geoffroy et son groupe profiteront de l'occasion pour tester plusieurs chansons de son cinquième album, actuellement en écriture et en production entre Montréal et Mexico. Ces concerts offriront ainsi un avant-goût exclusif de ce nouvel album, avec un spectacle composé à parts égales de chansons inédites et de pièces marquantes de ses quatre albums précédents."
      }
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/Chanson"
      }
    ]
  },
