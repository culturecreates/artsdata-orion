      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://spec.qc.ca/genid/1d93d306e818e81d"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://spec.qc.ca/uploads/sinem-kara-horizontal-924e97a4ffae8f1578bc.jpeg"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/262c0fdf8e319d04"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/sinem-kara"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/sinem-kara"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Sinem Kara"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Soirée humour \n\nSinem Kara présente Sultane, son premier one-woman show. \n\nSinem, c'est notre chum de femme : celle qui a grandi dans la pizzeria familiale à St-Jean-Sur Richelieu, avec qui on aime déconner et qui nous fait sentir immédiatement comme à la maison. Mais grandir dans une pizzeria, ça vient avec son lot de responsabilités. À force de travailler dans le resto familial, Sinem devient malgré elle la Sultane de la place, la Sultane de la patate, et du haut de son trône, elle observe les clients, sa famille et tous les personnages qui finiront par nourrir son humour.\n\nAvec la scène comme trône, elle nous déballe ses aventures dans un spectacle d'anecdotes familiales, de chocs culturels et d'observations du quotidien. On marche parfois sur une corde raide, où les sujets sensibles sont abordés avec un humour franc et irrévérencieux, beaucoup d'autodérision, mais toujours avec humanité parce qu'entre amis, tout se dit."
      }
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/ComedyPerformance"
      }
    ]
  },
