      {
        "@id": "https://spec.qc.ca/genid/30ac4c0919811db6"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/la-grande-veillee-du-2-pierrots"
