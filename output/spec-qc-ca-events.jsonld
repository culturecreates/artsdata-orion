    "http://schema.org/image": [
      {
        "@id": "https://spec.qc.ca/uploads/danse-salsa-avec-karim-dhibat-horizontal-da2cd57ca9b2681602d3.jpeg"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/danse-salsa-avec-karim-dhibat"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/danse-salsa-avec-karim-dhibat"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Danse Salsa Avec Karim Dhibat"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Après avoir fait danser des centaines de personnes tous les vendredis d&#039;été, les populaires soirées de danse salsa se poursuivent le vendredi 4 septembre dans le cadre du Festival cinéma et musique du monde.\n\nLe DJ Karim Dhibat fera monter la température avec une sélection de salsa, de bachata, de merengue et de cumbia. Habitué des soirées latines en plein air, il sait créer une ambiance conviviale où passionnés et débutants trouvent naturellement leur place.\n\nQue vous ayez envie de danser ou simplement de profiter de l&#039;ambiance, laissez-vous porter par les sonorités latines le temps d&#039;un arrêt au festival. \n\n\n Restez informé\n\nIndiquez votre intérêt pour cet événement en ajoutant ce spectacle à votre panier, ainsi vous serez informé en cas d&#039;annulation \n* Notez qu&#039;aucun billet ne vous sera transmis par courriel et aucun billet ne sera requis pour accéder à l&#039;événement.\n"
      }
    ]
  },
