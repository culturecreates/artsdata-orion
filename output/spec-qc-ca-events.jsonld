    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Six amis, un chalet au fond des bois, dix ans d'absence. L'été tire sa révérence quand Flip Fabrique retrouve enfin son coin de paradis. Les taquineries…"
      }
