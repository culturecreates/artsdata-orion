      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://spec.qc.ca/uploads/premier-ciel-horizontal-f1330f00d61a4c5df06f.jpeg"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/3b920d837b6e8a51"
      },
      {
        "@id": "https://spec.qc.ca/genid/d4d4aefa2376ec91"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/premier-ciel"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/premier-ciel"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Premier Ciel"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Vivez une expérience musicale profondément émouvante où les grands classiques d&#039;Harmonium, incluant des extraits de l&#039;Heptade, reprennent vie sous un regard inédit et chargé de sens. Maude Locat (fille de Serge Locat) et Julie Valois (fille de Louis Valois et Monique Fauteux) évoluent sur scène auprès de leurs complices de Premier Ciel, la seule formation reconnue par Serge Fiori pour faire revivre cette œuvre mythique. Fortes du lien unique qu&#039;elles entretiennent avec cette musique qui les habite depuis toujours, elles proposent une redécouverte sensible et authentique de l&#039;œuvre du groupe culte. \n  \nDepuis près de vingt-cinq ans, ces sept musiciens passionnés font vibrer les scènes du Québec avec des interprétations fidèles et puissantes. Ce spectacle, fruit d&#039;une transmission entre générations, célèbre l&#039;héritage d&#039;Harmonium avec authenticité et tendresse. Entre chansons emblématiques, archives, projections, éclairages et mise en scène étudiée, cinquante ans après le dernier concert d&#039;Harmonium, ce concert vous invite à un voyage émouvant, rare et précieux, entre mémoire et musique."
      }
    ]
  },
