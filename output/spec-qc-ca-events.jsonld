    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/9fe081f02ab15242"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/les-gars-du-nord"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/les-gars-du-nord"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Les Gars Du Nord"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\nNés en Acadie et nourris de country, Les Gars du Nord réunissent sept artistes complices : Wilfred LeBouthillier, Danny Boudreau, Maxime McGraw, Jean-Frédéric Lizotte, Nicolas Basque, Danny Bourgeois et Mike Bourgeois. Ensemble, ils font entendre une musique où les racines acadiennes rencontrent le country et les sonorités celtiques, portée par sept voix qui se répondent et des harmonies généreuses. Leur plus récent album, Les Années Tranquilles, célèbre cette signature musicale avec des chansons teintées d'humour, de souvenirs et de fierté. Sur scène, les musiciens unissent leurs voix et leurs instruments pour livrer un spectacle authentique, rythmé et chaleureux, où les refrains donnent rapidement envie de chanter avec eux. Une soirée aux couleurs de l'Acadie, entre grandes chansons, histoires de famille et plaisir de se retrouver."
      }
    ]
  },
