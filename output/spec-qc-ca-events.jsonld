      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/petites-histoires-danour-avec-sylvie-d-lire"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/petites-histoires-danour-avec-sylvie-d-lire"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Petites Histoires D'amour Avec Sylvie D Lire"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\nSylvie D Lire adore raconter... et cette fois, elle est accompagnée de son complice musicien Éloi Des Bruits, qui donne vie aux histoires avec son violon.\n\nPerchée sur la tour d'un château, Sylvie découvre une mystérieuse lettre lui lançant un défi : raconter trois histoires d'amour — une drôle, une secrète et une super chouette. Si elle réussit, l'auteur de la lettre se dévoilera.\n\nEntre contes, musique et rires, le spectacle devient une invitation à plonger dans un univers tendre et poétique où petits et grands se laissent emporter.\n\nUn rendez-vous doux et magique à partager en famille."
      }
    ]
  },
