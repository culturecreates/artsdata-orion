    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Soirées Humour  En 1997, ce sont Les Boys qui enflamment les cinémas du Québec. Ce film unique, avec ses personnages attachants et ses histoires de hockey…"
      }
