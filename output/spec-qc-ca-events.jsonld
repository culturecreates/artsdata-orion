      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/gabriel-fredette"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Gabriel Fredette"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Grandes Sorties\nGabriel Fredette présente Qui je suis, un spectacle inspiré de son tout premier album du même nom. Porté par des chansons déjà bien ancrées dans le cœur du public, dont Tant qu'on est toi et moi et Le signal, cet album marque une entrée remarquée et affirmée pour l'artiste révélé à La Voix et membre du collectif Classe Moyenne. Sur scène, Gabriel Fredette impressionne par sa présence naturelle, sa confiance et son aisance remarquable. Avec son énergie rassembleuse et son authenticité désarmante, il crée une connexion instantanée avec le public."
      }
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/Chanson"
      }
    ]
  },
