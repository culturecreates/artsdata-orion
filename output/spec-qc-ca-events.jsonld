    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/da8a847fecc5a156"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/phil-roy"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/phil-roy"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Phil Roy"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\nAprès les spectacles « MONSIEUR » et « PHILOU », Phil Roy nous présente son troisième one-man show en carrière : Danser sous la pluie. Spectacle dans lequel il nous raconte avec humour les difficultés de son parcours de vie, autant académiques que personnelles. Quoi qu'académiques, on s'en doutait... Danser sous la pluie, c'est une histoire d'embûches, de solutions, d'humour et de vérités. Tout ça raconté par un gars qui ne comprend toujours pas le théorème de Pythagore! Et c'est avec une nouvelle dégaine assumée et naturelle qu'il nous livre ce spectacle des plus intimes, toujours avec son humour accessible et énergique."
      }
    ]
  },
