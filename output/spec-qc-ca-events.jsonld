    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/8312803ec7121df8"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/luc-de-larochelliere"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/luc-de-larochelliere"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Luc De Larochellière"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": " Plongez dans l'intimité musicale avec le spectacle unique \"Paroles pour Cordes Sensibles\"!\n \nDes mots portés par deux guitares, voilà en bref ce que Luc De Larochellière vous propose dans cette formule. Formule où il revisite 40 ans de chansons, de Amère America à Un toit dans ma tête en passant par Cash City et bien sûr Si fragile avec son ami et excellent guitariste Sylvain Quesnel, en laissant une part belle aux multiples couleurs possibles avec des cordes pincées. Un récital où l'intimité et la richesse sonore se côtoient. Des chansons complètes, quelques medleys. Ils jouent, ils s'amusent, ils laissent place parfois à l'improvisation.\nUn show de feu de camp... sans feu de camp."
      }
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/Chanson"
      }
    ]
  },
