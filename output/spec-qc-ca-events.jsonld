      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Cercle Philharmonique De Saint-Jean-Sur-Richelieu"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\nLe CPSJ vous invite à un concert magique qui vous fera découvrir, ou redécouvrir, l'univers de votre sorcier préféré. Des envolées sur balai aux créatures fantastiques, en passant par les potions mystérieuses et les sortilèges les plus spectaculaires, cette aventure musicale vous transportera au cœur d'une école de magie aussi fascinante qu'envoûtante.\n\nAu fil des œuvres interprétées par l'orchestre, revivez les moments les plus marquants de cette saga qui a fait rêver des générations de moldus et de sorciers.\n\nUne chose est certaine : en quittant la salle, vous n'aurez qu'une envie... recevoir enfin votre propre lettre d'admission par hibou.\n\nABONNEMENT 2 CONCERTS\nAdulte: 55.00$\nÉtudiant: 45.00$\nAjoutez tous vos billets au panier et le prix s'ajustera au moment du paiement"
      }
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/MusicPerformance"
      }
    ]
  },
