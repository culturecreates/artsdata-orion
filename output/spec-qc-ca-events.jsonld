    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/93382f974d85166c"
      },
      {
        "@id": "https://spec.qc.ca/genid/4d256ece901a56f5"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/simon-delisle"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/simon-delisle"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Simon Delisle"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Fort du succès de TACHE, son deuxième one-man show, Simon Delisle revient en supplémentaire pour une soirée où l&#039;autodérision et les observations mordantes sont à l&#039;honneur. Avec son regard singulier sur la vie, il s&#039;attaque aux multiples sens du mot « tache » : son apparence atypique et son vitiligo, les obstacles rencontrés sur son parcours, les personnes qui l&#039;ont freiné, mais aussi les marques que la vie laisse derrière elle. Entre résilience, doutes et remises en question, Simon transforme les épreuves en matière à rire avec une écriture incisive, des images percutantes et une redoutable aisance sur scène. Une véritable décharge d&#039;humour qui promet son lot de rires... et quelques bonnes courbatures aux joues!\n\n"
      }
    ]
  },
