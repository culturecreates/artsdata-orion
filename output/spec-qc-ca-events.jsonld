      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/9c507e36224a724f"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/clement-jacques"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/clement-jacques"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Clement Jacques"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Après quelques années de recul, Clement Jacques remonte sur scène avec Iris qui fait suite à la sortie de son 5e album en carrière. À l'image de ce qui est véhiculé sur l'album, Clement partage sur scène autant de réflexions, révélant ainsi avec sensibilité sa vision des relations humaines et du monde qui l'entoure. Accompagné d'un univers scénique signé Daniel Fortin , Clement livre ses plus récentes chansons en français, entrecoupées de titres marquants de son parcours. Pop, folk, parfois rock, son style déjoue les étiquettes pour mieux s'ancrer dans l'émotion brute. Iris, c'est un regard sensible sur le monde, des textes réfléchis, des mélodies justes. C'est aussi une rencontre intime avec un artiste à part, qui choisit de dire les choses simplement, mais toujours avec profondeur.\n\nEn première partie du spectacle de Clement Jacques, découvrez Andie Therio.\nUne auteure-compositrice-interprète au folk-country actuel, aux influences rock, portée par une voix douce, rauque et envoûtante.\n"
      }
    ]
  },
