      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://spec.qc.ca/uploads/minime-rencontre-les-grands-compositeurs-horizontal-46e8f1cc427408360406.jpeg"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/2a1d112d45eb51a8"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/minime-rencontre-les-grands-compositeurs"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/minime-rencontre-les-grands-compositeurs"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Minime Rencontre Les Grands Compositeurs"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\nMinime est une petite souris gourmande de fromage et follement éprise de musique. Ce soir, un matou menaçant aux trousses, sa mission la mènera de Venise jusqu'aux quais d'Angleterre, pour croiser deux géants : Vivaldi et le jeune Mozart, ce gamin qu'on surnomme encore Wolfer. Benoît Brière, conteur sensible et espiègle, prête sa voix et son humour à ce conte musical touchant, tandis que l'Ensemble Quatre Saisons fait résonner la grande musique en direct. Les illustrations s'animent en projections enveloppantes, à la croisée du théâtre, de la musique et de la littérature jeunesse. Une rencontre inoubliable avec les grands compositeurs. \n\nConte musical\nDurée : 50 minutes.\nPublic cible : 5 à 8 ans\n\nConte : Ana Gerhard. Narrateur comédien : Benoît Brière. Mise en scène : Benoît Brière. Direction musicale : Christine Harvey. Musiciens et musiciennes : Christine Harvey, (violoncelle), Josiane Breault (violon), Daniel Godin (violon), Catherine Arsenault (alto), Gaspard Tanguay-Labrosse (piano et clavecin). Production : La montagne secrète. \n\nForfait 3 spectacles pour 48 $\nAjoutez tous les spectacles au panier et le tarif s'ajustera automatiquement."
      }
    ]
  },
