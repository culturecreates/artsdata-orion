      {
        "@language": "fr",
        "@value": "L'humoriste et animateur Arnaud Soly sera en spectacle au Théâtre des Deux Rives le 3 octobre 2026 et au Pôle culturel de Chambly le 5 mars 2027"
      }
    ]
  },
  {
    "@id": "https://spec.qc.ca/genid/7b50686bff0d8d05",
    "@type": [
      "http://schema.org/Event"
    ],
