    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/431cd84b5c644ae1"
      },
      {
        "@id": "https://spec.qc.ca/genid/9cc17957987f0e0a"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/mario-tessier"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/mario-tessier"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Mario Tessier"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": " L'humoriste Mario Tessier revient en force avec Champion, son 3ᵉ one-man-show. Fidèle à son style explosif, il livre un concentré d'humour irrésistible mêlant autodérision et situations improbables. Que ce soit en jonglant avec un entrainement de boxe et une séance de botox, en devenant propriétaire d'une jument sans jamais avoir monté à cheval, ou en se prenant pour un génie (avec des résultats discutables !), Mario explore avec folie ses propres contradictions. Dans Champion, il célèbre le « grand champion » qui sommeille en chacun de nous : celui qui rêve grand, même si c'est parfois hilarant de maladresse. Reconnu pour son énergie contagieuse et son efficacité comique, Mario Tessier vous promet une soirée mémorable. Préparez-vous à rire ! \n\n\nPROMOTIONS\nCe spectacle est admissible aux promotions\n  Spectacle gratuit à l'achat de 3 spectacles\n  et\n  2 spectacles pour 85 $.\n  Ajoutez vos billets au panier et le tarif s'ajustera automatiquement selon la promotion applicable.\n"
      }
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/ComedyPerformance"
      }
    ]
  },
