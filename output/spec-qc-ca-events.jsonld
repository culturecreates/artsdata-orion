    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Hallelujah Leonard rend hommage à Leonard Cohen dans une relecture intime et habitée de ses chansons, connues et méconnues. Portée par la voix soul de…"
      }
    ],
