    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Jay Laliberté, Louis Girard-Bock"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "18 ans et +\n\nLouis et Jay sont des improvisateurs d'expérience, des humoristes de profession et des meilleurs amis d'amitié. Ils font tout ensemble, même leur spectacle. « Rodage à deux », c'est une heure et quart de Louis et Jay qui enchaînent chacun leurs blagues, à deux sur scène, dans une partie de ping-pong humoristique où le public fait office de table.\n\n\n \n\n  \n\n* Ce spectacle n'est pas admissible à la promotion « Spectacle gratuit à l'achat de 3 spectacles »."
      }
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/ComedyPerformance"
      }
    ]
  },
