      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "L'ensemble D'en Direct De L'univers"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Porté par les musiciens et choristes de l'émission En direct de l'univers, ce spectacle des Fêtes est devenu un rendez-vous incontournable. Dans une ambiance festive et touchante, l'Ensemble entraine le public dans un grand tourbillon de chansons où se mêlent traditions, retrouvailles et plaisir partagé. Medleys enjoués, harmonies étincelantes et moments d'émotion composent ce voyage musical célébrant l'amitié et la joie d'être ensemble. C'est le bonheur simple et vrai d'un spectacle qui réchauffe le coeur et lance la magie du temps des Fêtes."
      }
    ]
  },
