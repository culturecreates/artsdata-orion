    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Zagata"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\nDécouvert comme finaliste à La Voix, Jesse Proteau, alias Zagata, s&#039;est rapidement imposé sur la scène musicale québécoise grâce à ses succès radiophoniques et ses millions d&#039;écoutes en ligne. Derrière des titres marquants comme « Lies », « FAIRPLAY » et  « Minuit trop tard », il propose un univers rassembleur mêlant pop, hip-hop et influences urbaines. Après le succès de son album Balle Courbe, il revient avec Quitte ou double, un projet personnel et vibrant porté par des collaborations marquantes et une énergie contagieuse sur scène.\n\n\n\n\n🎵 Écouter l&#039;extrait"
      }
    ]
  },
