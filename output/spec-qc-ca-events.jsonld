      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/935dc7bd6f235418"
      },
      {
        "@id": "https://spec.qc.ca/genid/3d6b6723004ea50d"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/illusion-floyd"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/illusion-floyd"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Illusion Floyd"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\nIllusion Floyd est un groupe hommage passionné qui fait revivre l'univers mythique de Pink \nFloyd avec une précision sonore et visuelle saisissante. Après le succès retentissant de leur \npremier spectacle D.S.O.T.W. (Dark Side Of The Wall), le groupe revient en force avec leur \ntournée 2027 intitulée I.T.A.O.T. (Is There Anybody Out There?).\n\nDans ce nouveau spectacle ambitieux, Illusion Floyd propose une interprétation intégrale de \nl'album légendaire The Wall, enrichie de plusieurs incontournables tirés d'autres albums \nemblématiques. Fidèle à l'esprit original tout en y apportant sa propre intensité scénique, le \ngroupe promet une expérience immersive, puissante et chargée d'émotions, à ne pas manquer \npour tous les amateurs de rock progressif."
      }
    ]
  },
