    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/45e71978ba3c2b00"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/concert-de-noel-aux-chandelles"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/concert-de-noel-aux-chandelles"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Concert De Noël Aux Chandelles"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\nLa tradition de Noël se perpétue !\n\nNoël est un symbole de joie, de partage et de nostalgie. Cette année encore, Patrimoine L'Acadie vous invite à son traditionnel concert de Noël aux chandelles, avec la Chorale Arc-en-Ciel.\n\nCette soirée prendra une dimension toute particulière alors que nous célébrons les 225 ans de notre église patrimoniale !\n\nDans la douce lumière des chandelles, venez revivre la magie des Noëls d'hier et d'aujourd'hui, au son des mélodies qui traversent les générations.\n\nLe 12 décembre, venez célébrer avec nous 225 ans d'histoire et de traditions !"
      }
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/Chanson"
      }
    ]
  },
