    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/212464a4bd1cc7d0"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/laurence-jalbert"
