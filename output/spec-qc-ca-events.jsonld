      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://spec.qc.ca/genid/e064c243916af80c"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://spec.qc.ca/genid/0d05f08701e2a2e4"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://spec.qc.ca/uploads/alexandre-cadieux-horizontal-149b8c501c21bea87c34.jpeg"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/6cd876ec563cb608"
      },
      {
        "@id": "https://spec.qc.ca/genid/d88c4a80642f0885"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/alexandre-cadieux"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/alexandre-cadieux"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Le Québec Sur Scène"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Grands rendez-vous artistiques \n\nComment le théâtre québécois a-t-il trouvé sa voix ? Parcourez 70 ans de dramaturgie québécoise, à travers ses thèmes, ses figures et ses formes. À partir d'extraits de textes phares, écoutez ses transformations, saisissez les nuances, là où la langue et la manière de dire le monde se redéfinissent. Guidez par Alexandre Cadieux, suivez les grandes étapes du théâtre de création québécois et plongez au cœur d'œuvres miroirs de nombreux enjeux sociaux, culturels et politiques du Québec. Deux interprètes redonnent chair aux mots et figures de notre imaginaire collectif. Une traversée qui révèle toute la force de notre dramaturgie.\n\nNotre conférencier, Alexandre Cadieux\nAlexandre Cadieux a été chargé de cours à l'UQAM et à l'Université d'Ottawa, critique de théâtre au Devoir et à la revue JEU, bibliothécaire à l'École nationale de théâtre du Canada, animateur, médiateur et concepteur à la LNI. Il est aujourd'hui responsable du centre de documentation au Centre des auteurs dramatiques.\nMise en vente: 12 mai 2026 à 10 h"
      }
    ]
  },
