      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/caity-gyorgy"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/caity-gyorgy"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Caity Gyorgy"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Parmi les jeunes voix à surveiller de la scène jazz canadienne, Caity Gyorgy s&#039;est fait remarquer par son swing naturel, son phrasé enjoué et son talent d&#039;improvisation, qui lui ont notamment valu trois prix JUNO. Inspirée par l&#039;âge d&#039;or du jazz, la chanteuse et compositrice y ajoute une touche moderne, alliant charme et sophistication à chacune de ses performances. En duo avec le pianiste Mark Limacher, elle fait le pont entre tradition et innovation avec un répertoire qui mêle standards intemporels et compositions originales, mettant en valeur sa voix chaleureuse et son timing impeccable. Sa présence dynamique et son sens de la narration captivent le public et promettent une prestation aussi élégante que vivante."
      }
    ]
  },
