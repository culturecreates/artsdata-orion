      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/901a748e832dc7d6"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/real-beland"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/real-beland"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Réal Béland"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Soirées Humour\n Réal Béland nous présentera prochainement un 6e spectacle en 30 ans de carrière. Intitulé Comme chez nous, ce spectacle entre dans l'intimité d'un comique qui comme le dit la rumeur a été conçu dans les coulisses d'une salle de spectacle. Après avoir passé sa vie dans les salles, Réal se sent chez lui lorsqu'il s'arrête en tournée près de chez vous. Avec une simplicité désarmante, des gags délicieusement absurdes, le retour de M. Latreille (personnage adoré du public), l'humoriste se déchaine dans ses monologues comiques et vous promet beaucoup de surprises!"
      }
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/ComedyPerformance"
      }
    ]
  },
