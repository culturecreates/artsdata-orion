    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Mat Lévesque"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "18 ans et +\n\n\nPREMIER ONE-MAN-SHOW\n\nNatif et habitant toujours au Nord du Lac-Saint-Jean, Mat est un ''raconteux''.\nSa parlure et ses anecdotes colorées défilent à la vitesse d'une bonne toune punk.\nIl décrit lui-même son style en disant : ''C'est comme du Michel Barrette mais avec ben de la\nsauce piquante!''\n \n\n  \n\n* Ce spectacle n'est pas admissible à la promotion « Spectacle gratuit à l'achat de 3 spectacles »."
      }
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/ComedyPerformance"
      }
    ]
  },
  {
    "@id": "https://spec.qc.ca/genid/530d47f23c3b8f41",
    "@type": [
      "http://schema.org/PerformingGroup"
    ],
    "http://schema.org/name": [
