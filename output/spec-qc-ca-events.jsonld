      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Jerry Tremblay"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Cirque \n\nCultivateur de malaises aussi involontaires que savoureux, Jerry Tremblay rayonne par son manque d'habiletés sociales et son désir immense d'être aimé. Searching for love est un cocktail explosif de cirque et de malaises croustillants: une plongée hilarante et touchante dans les absurdités de la quête amoureuse des cœurs désespérés. Pour le meilleur et pour le pire, Jerry Tremblay vous promet une soirée inoubliable — et pleine de surprises.\n\nSpectacle 16 ans et plus."
      }
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/CircusPerformance"
      }
    ]
  },
