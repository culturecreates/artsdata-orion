    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/6560b6b3f1632560"
      },
      {
        "@id": "https://spec.qc.ca/genid/ff7d9222f30e8ba3"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/cabaret-jazz-band"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/cabaret-jazz-band"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Cabaret Jazz Band"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le Cabaret Jazz Band donne le coup d&#039;envoi à sa 15e saison avec une soirée où la batterie et les percussions occupent le devant de la scène. Sous la direction artistique du pianiste Pierre-Armand Tremblay, l&#039;orchestre accueille le batteur et percussionniste Mario Roy pour une cinquième édition de ce concept devenu un incontournable. Au programme : des réarrangements de pièces du groupe Snarky Puppy, plusieurs classiques de Santana et des performances où le rythme est roi. La soirée sera également marquée par un hommage au saxophoniste Roberto Murray, fidèle musicien du Cabaret Jazz Band depuis ses débuts.\nCe qu&#039;ils en disent :\n« Spectacle de qualité! Nous apprécions la place qui est donnée aux musiciens pour faire leur part de solo et d&#039;apprécier tout leur talent. »\n- Nicole M.\n\n« Très bon. Belle présentation des pièces jouées. Les musiciens sont excellents, mention au multi-instrumentaliste. Du gros plaisir! »\n- Line G.\n\n« Des musiciens remarquables, une ambiance feutrée et chaleureuse — un pur moment de plaisir que je recommande sans hésitation. »\n- Mario B."
      }
    ]
  },
