  {
    "@id": "https://spec.qc.ca/genid/35c9671e7ba4d2bd",
    "@type": [
      "http://schema.org/VideoObject"
    ],
    "http://schema.org/thumbnailUrl": [
      {
        "@id": "https://spec.qc.ca/uploads/m%C3%A9lissa-b%C3%A9dard-horizontal-4befa28ff9c86c8d253b.jpeg"
      }
    ],
    "http://schema.org/embedUrl": [
      {
        "@id": "https://www.youtube.com/watch?v=RH8S6-T-8UA&amp;list=OLAK5uy_kJAmLfCyR41vMgNerBlBvytl2yb7Bq-Jk"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/melissa-bedard"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "MÉLISSA BÉDARD"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Grandes Sorties \n\nMélissa Bédard revient sur scène avec un spectacle éclatant,qui met en valeur sa grande voix, avec rien d'autre que des grandes chansons !\n\nLe temps d'une soirée, elle ranime l'époque dorée de la musique : celles des discothèques enflammées, de la grande chanson française, des soirées en famille devant Elvis à la télé, des moments où les refrains ont servi de trame sonore à nos vies.\n\nC'est un hommage aux voix qui ont forgé la sienne, mais revu sous un nouvel angle. De Céline Dion à Ginette Reno, d'Edith Piaf à Adèle en passant par Whitney Houston, Mélissa réinvente les grands classiques avec la puissance vocale et l'instinct de bête de scène qu'on lui connait, tout en révélant un côté plus rugueux, groovy et audacieux, à la Tina Turner.\n\nL'ambiance? Une soirée chic, à grand déploiement qui se transforme en party intime où tout le monde finit debout ! Accompagnée d'une garde rapprochée de musiciens complices, Mélissa livre un show où chaque chanson devient SA chanson, qu'elle offre à son public avec toute sa grande âme.\n\nPour cette nouvelle tournée, Pamplemousse Spectacle signe une direction artistique sur mesure, portée par une mise en scène audacieuse de Benoît Landry et un déploiement visuel à la hauteur de l'une de nos plus grandes voix.\n\nUn show dont on ressort le cœur plein, à son image !"
      }
    ],
    "http://schema.org/uploadDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-13T15:03:00"
      }
    ]
  },
