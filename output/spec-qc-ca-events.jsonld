    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "18 ans et + PREMIER ONE-MAN-SHOW Natif et habitant toujours au Nord du Lac-Saint-Jean, Mat est un ''raconteux''.Sa parlure et ses anecdotes colorées défilent à la vitesse d'une bonne toune punk.Il décrit lui-même son style en disant : ''C'est comme du Michel Barrette mais avec ben de lasauce piquante!''"
      }
    ],
    "http://schema.org/headline": [
      {
