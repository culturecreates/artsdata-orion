      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/0870f0f05fc95c7d"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/ensemble-mistral"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/ensemble-mistral"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Ensemble Mistral"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\nDans l&#039;univers d&#039;Astor est un spectacle musical et narratif qui plonge le public dans les récits de vie, la musique et les inspirations de Astor Piazzolla. De New York à Paris, en passant par Buenos Aires, il propose un portrait original où les œuvres du grand compositeur argentin s&#039;entremêlent à la musique classique, au jazz, au tango traditionnel et à la musique klezmer, ponctuées de fascinantes anecdotes biographiques. Le projet est porté par Mistral, un ensemble né de la collaboration de musiciens issus du jazz et de la musique classique, réunis autour d&#039;un même mandat : créer des rencontres entre les genres et proposer des concerts multidisciplinaires à l&#039;instrumentation singulière, réunissant violon, saxophones, flûte, clarinette, guitare et contrebasse.\n\n\nCe projet est une présentation de la Ville de Chambly."
      }
    ]
  },
