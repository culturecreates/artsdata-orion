    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/499ed74cacd79bc3"
      },
      {
        "@id": "https://spec.qc.ca/genid/1c8808a51d6f385b"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/sorai"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/sorai"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Soraï"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Présenté dans le cadre du OFF de Mon Vieux-Saint-Jean la nuit, le nouveau spectacle de Soraï s&#039;inspire de MILLENNIUM STAR DIAMANT, son plus récent album. Beatmakeuse, rappeuse et chanteuse queer, elle s&#039;impose avec un univers audacieux où le rap, la pop et l&#039;électro se rencontrent dans une proposition à la fois percutante et éclatée. Nommé au GAMIQ 2024 pour Synesthésies, son travail se distingue par des rythmes accrocheurs, des refrains entraînants et une énergie contagieuse. Entourée de ses musicien·nes, Soraï revisite ses chansons les plus populaires tout en dévoilant de nouvelles compositions. Véritable bête de scène, elle livre un spectacle brillant et sans filtre, où douceur, humour, amour et rébellion se côtoient avec une bonne dose d&#039;audace. Un show coup de poing, bigger than pop!"
      }
    ]
  },
