      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://spec.qc.ca/uploads/le-vent-du-nord-horizontal-6d681eff757ccdfb1c6f.jpeg"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/6fc2c107f2de9fb8"
      },
      {
        "@id": "https://spec.qc.ca/genid/bc0a81ee382cc103"
