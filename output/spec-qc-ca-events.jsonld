      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://spec.qc.ca/genid/6bdb7e23efbe296c"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://spec.qc.ca/uploads/guillaume-pineault-horizontal-1fcf1a255589e1745040.jpeg"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/e2f81a3cd2eb0440"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/guillaume-pineault-2"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/guillaume-pineault-2"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Guillaume Pineault"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Guillaume Pineault est fier d'entamer la confection du petit 2e avec vous. Il sillonne donc le Québec avec le rodage de son prochain spectacle dans le but de vous faire rire, de vous faire du bien, mais également de vous faire découvrir davantage l'humain derrière l'humoriste. Guillaume est un raconteur né, candide, sympathique et doté d'un charisme indéniable. C'est avec simplicité et adresse qu'il provoquera vos rires avec ses histoires personnelles et improbables. Plus besoin de détour, Guillaume Pineault est là où il doit être : sur scène, à vous faire rire !, Guillaume Pineault sillonne le Québec avec le rodage de son prochain spectacle. Alors qu'il nous parlait d'avoir pris des détours professionnels lors de son premier spectacle solo, notamment en obtenant un diplôme en ergothérapie et en ostéopathie, l'humoriste délaisse finalement sa carrière en santé pour se consacrer à ce qu'il aime le plus : l'humour. Guillaume est un raconteur né, candide, sympathique et doté d'un charisme indéniable. C'est avec simplicité et adresse qu'il provoquera vos rires avec ses histoires personnelles et improbables. Plus besoin de détour, Guillaume Pineault est là où il doit être : sur scène, à vous faire rire ! , Eh bien verrat! Je suis extrêmement fier d'entamer la confection du petit 2e avec vous. \n\nJ'ai envie de vous faire rire, de vous faire du bien, mais également de vous faire découvrir davantage l'humain derrière l'humoriste."
      }
    ]
  },
