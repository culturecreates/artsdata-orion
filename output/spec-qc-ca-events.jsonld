      }
    ],
    "http://ogp.me/ns#image:alt": [
      {
        "@language": "fr",
        "@value": "Le gala Comédie Star mettant en vedette Stéphane Fallu, José Gaudet, Réal Beland, Mélanie couture sera présenté au Théâtre des Deux Rives le 1er avril 2027"
      }
    ]
  },
  {
    "@id": "https://spec.qc.ca/genid/efc5f630e9ad958b",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/startDate": [
