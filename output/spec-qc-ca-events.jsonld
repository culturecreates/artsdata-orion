      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/angelique-francis"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Angelique Francis"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Décorée d&#039;un prix Juno pour le meilleur album blues avec Long River, l&#039;autrice-compositrice-interprète originaire d&#039;Ottawa Angelique Francis est une musicienne polyvalente et exceptionnellement douée. Multi-instrumentiste, elle séduit par ses performances électrisantes, ses capacités instrumentales et sa voix puissante au timbre texturé. Son univers musical puise dans le blues, la soul, le folk, le jazz, le gospel et le rock. Au fil de son parcours, elle a partagé la scène et assuré les premières parties de Gary Clark Jr., Beth Hart, Tom Cochrane, Burton Cummings, Sugar Ray, Jimmy Vivino et plusieurs autres artistes reconnus. Elle s&#039;est également produite dans des événements et festivals d&#039;envergure, dont le Sighisoara Blues Festival en Roumanie, le Massey Hall à Toronto, le Festival International de Jazz de Montréal, l&#039;Ottawa Jazz Festival et l&#039;Ottawa Blues Festival. Une artiste accomplie à découvrir pour la puissance de sa voix, sa virtuosité et l&#039;énergie de ses performances."
      }
    ]
  },
