      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/83ec09f2c2332bf0"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/gala-comedie-stars"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/gala-comedie-stars"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Gala Comédie Star"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\nLe Gala Comédie Star est de retour à Saint-Jean pour une soirée où les grands noms de l'humour se donnent carte blanche! À tour de rôle, cinq humoristes chevronnés montent sur scène pour présenter un numéro de leur choix, laissant toute la place à leur personnalité, leur créativité et leurs envies du moment. Pour l'édition 2026, Stéphane Fallu prendra les commandes et recevra José Gaudet, Réal Béland, Mélanie Couture ainsi qu'un quatrième humoriste qui sera dévoilé prochainement. Des univers complètement différents, des numéros inédits et surtout, une soirée où tout peut arriver!"
      }
    ]
  },
