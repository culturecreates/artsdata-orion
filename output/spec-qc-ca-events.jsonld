    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/arnaud-soly"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/arnaud-soly"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Arnaud Soly"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": " Avec son premier one-man-show, Stand-Up qui a attiré près de 70 000 spectateurs, ses milliers d&#039;abonnés sur les réseaux sociaux et ses deux nominations au Gala Les Olivier 2024 (Olivier de l&#039;année et Émission humoristique télé de l&#039;année pour Club Soly), l&#039;humoriste c&#039;est fait une place de choix dans le milieu de l&#039;humour. Unique en son genre (il a tout de même fait de la flûte avec son nez dans son premier spectacle), il revient enfin sur scène avec son deuxième one-man-show BON JUS, promet d&#039;être encore meilleur (c&#039;est lui qui le dit!). Pourquoi ce titre intrigant? C&#039;est une histoire compliquée, mais vous en découvrirez le sens en venant le voir en salle. Une chose est sûre : on va rigoler, c&#039;est promis."
      }
    ]
  },
