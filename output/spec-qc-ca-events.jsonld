    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/cabaret-jazz-band-3"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/cabaret-jazz-band-3"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Cabaret Jazz Band"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "La chanteuse Bïa retrouve le Cabaret Jazz Band pour rendre hommage à Georges Moustaki, immense figure de la chanson francophone avec qui elle a partagé de précieux moments sur scène. Sous la direction de Pierre-Armand Tremblay, les musiciens revisitent ses plus belles chansons dans une ambiance chaleureuse où se mêlent poésie, jazz et influences du Brésil, de la France et du Québec.\nCe qu'ils en disent :\n« J'ai adoré cette musique lumineuse et enjouée et Bïa était époustouflante! »\n- Louise B. \n\n« Bia est une chanteuse exceptionnelle que j'ai eu la chance de voir et entendre pour la première fois au Jeudis Shows il y a déjà plusieurs années. Merci au Cabaret Jazz Band de l'avoir invitée. »\n- Françoise D.\n\n« Comme toujours nous sommes ravis de nôtre soirée! Belle présence de Bïa avec la complicité des musiciens et des choristes! Bravo et Merci! »\n- Roger B."
      }
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/Chanson"
      }
    ]
  },
