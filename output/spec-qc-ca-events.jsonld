  {
    "@id": "https://spec.qc.ca/genid/37dee784360e8eaf",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-05-14T20:00:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-05-14T23:00:00"
      }
    ],
