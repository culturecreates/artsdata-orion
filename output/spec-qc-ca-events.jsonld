    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/604e22f5fa017d92"
      },
      {
        "@id": "https://spec.qc.ca/genid/804bff35cb1b8fb5"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/soirees-dhumour-par-cedric-bergeron"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/soirees-dhumour-par-cedric-bergeron"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Les Soirées D'humour De Cédric Bergeron"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "18 ans et + Animée par Cédric Bergeron, venez découvrir les prochaines vedettes de l'humour dans l'intimité et le charme qu'offre Le 164. Chaque soirée rassemble une variété d'humoristes aux styles différents, pour vous offrir toutes sortes de rires.\n\nCédric Bergeron à l'animation\nHumoriste depuis 2019, Cédric Bergeron a fait ses débuts sur le tard, à la fin de la trentaine. Depuis, il multiplie les scènes d'humour et les comédie clubs partout au Québec. Ses passages remarqués au Gong show du Bordel Comédie Club lui ont permis de se démarquer par son style polyvalent, qui navigue du pince-sans-rire à l'humour noir, trash et absurde."
      }
    ]
  },
