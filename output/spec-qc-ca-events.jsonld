        "@value": "630"
      }
    ],
    "http://ogp.me/ns#image:alt": [
      {
        "@language": "fr",
        "@value": "Le gala Comédie Star mettant en vedette Stéphane Fallu, José Gaudet, Réal Beland, Mélanie couture sera présenté au Théâtre des Deux Rives le 1er avril 2027"
      }
    ]
  },
  {
    "@id": "https://spec.qc.ca/genid/2249864f6c791197",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-04-01T20:00:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
