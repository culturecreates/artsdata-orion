      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/un-village-didiots"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Un Village D'idiots"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\nUn jeune et naïf instituteur arrive dans un petit village d'Ukraine pour enseigner à Sophia, la fille du docteur. Son enthousiasme se transforme rapidement en inquiétude quand il réalise que tous les habitants du village, victimes d'un mauvais sort, sont complètement stupides. Tombé amoureux de la belle Sophia, il tentera courageusement de conjurer le sort.\n\nDistribution : Danielle Beaulieu, Françoise Duménil, Marcel Fortin, Ursule Garneau, Anick Gendron, Jean-François Houle, Zachary Laforest, Frédéric Nadeau, Emmy Rodrigue, Céline Tremblay"
      }
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/TheatrePerformance"
      }
    ]
  },
