    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Salebarbes"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Grandes Sorties\nSalebarbes revient avec un nouveau spectacle et une envie irrésistible de faire lever le party ! Avec les chansons de son nouvel album, Ça veut rien saouère, le quintette nous entraîne dans son univers chaleureux, où les violons endiablés et les sonorités acadiennes rencontrent le country et le blues.\nLeur complicité contagieuse et leur plaisir de jouer ensemble se transmettent jusque dans la salle : on chante, on tape du pied et on célèbre en français ! Une grande fête rassembleuse pour laisser les soucis à la porte et repartir le cœur plus léger.\n\n* Ce spectacle ne fait partie d'aucune offre promotionnelle."
      }
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/Chanson"
      }
    ]
  },
