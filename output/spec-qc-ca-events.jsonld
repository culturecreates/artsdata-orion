        "@value": "L'humoriste et conteur Charles Beauchesne parlera des Nazis pendant une heure et demie au Cabaret-Théâtre du Vieux-Saint-Jean le 6 novembre 2027."
      }
    ]
  },
  {
    "@id": "https://spec.qc.ca/genid/0d9c20807a2b67ee",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
