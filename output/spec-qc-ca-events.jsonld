      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://spec.qc.ca/genid/e064c243916af80c"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://spec.qc.ca/genid/69746fba0f2ae4f9"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://spec.qc.ca/uploads/classe-moyenne-horizontal-bfe2967a3c17ec08c848.jpeg"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/2cc1bbac6c1cceb2"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/classe-moyenne"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/classe-moyenne"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Classe Moyenne"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Tik Tok les adore, Instagram les suit pas à pas, les plateformes musicales brûlent tant on les écoute : 2 millions de clics en quelques mois. Le collectif de musiciens Classe moyenne est la sensation de l'heure, un phénomène comme il s'en produit peu.  \n\nC'est dans un sous-sol près de La Prairie que le feu prend, là où cinq amis puisent dans leur quotidien pour écrire des chansons qui ressemblent au quotidien des vingtenaires, mais que tout le monde aime.  \n\n\"Nous autres on s'appelle Classe moyenne, les Colocs c't'ait déjà\" pris écrivent-ils, et déjà la séduction opère. Quand ils ajoutent \"On voulait aller à l'uni, on a tous fini chez Benji, parle-moi d'une école de la vie\", on en redemande. \n\nIl s'appelle Classe moyenne, donc, mais aussi Benjamin Nadeau (réalisateur et producteur ayant collaboré avec William Cloutier, Ludovick Bourgeois, Dee Holt, Mc12), Gabriel Fredette, Justin Roy, Phil Rxcket et Zach Chico. Des amis qui se sont retrouvés ensemble dans le sous-sol de Benjamin, qui ont écrit une chanson vite devenue virale, qui en ont écrit treize depuis et qui vont continuer de le faire parce qu'ils s'amusent. Et que le monde aime ça, beaucoup, beaucoup. \n\nNe cherchez pas de règles ni de recettes, il n'y en a pas chez Classe moyenne. Il n'y a que la liberté, le plaisir, le positif, le gros party, et pour vous, un bateau qu'il ne faut manquer, car il ne passe pas souvent  !!!"
      }
    ]
  },
