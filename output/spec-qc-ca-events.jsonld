    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/c44491334eb46728"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/andreanne-a-malette"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/andreanne-a-malette"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Andréanne A. Malette"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Grandes Sorties \n\nAvec ce spectacle inspiré de son album hommage à Françoise Hardy, Andréanne remonte le fil invisible qui relie son histoire à celle de l'icône française. Dans un décor inspiré des années 60, les univers se croisent, les chansons se répondent, et l'artiste se raconte à travers des anecdotes personnelles, tantôt touchantes, souvent rigolotes. Entourée de ses trois fidèles musiciens, elle s'installe dans une douce nostalgie où la musique ravive la mémoire d'une époque pas si lointaine, où l'on prenait le temps de ressentir. Un moment suspendu entre deux ères, où l'interprète nous invite simplement à flotter un instant."
      }
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/Chanson"
      }
    ]
  },
  {
    "@id": "https://spec.qc.ca/genid/9dfaca0a7ac7ade7",
    "@type": [
      "http://schema.org/PerformingGroup"
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Dans la maison où j'ai grandi jouait du Françoise Hardy <br />\nChanson"
      }
    ]
  },
