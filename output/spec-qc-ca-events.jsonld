      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://spec.qc.ca/genid/a627fa1526ba077e"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://spec.qc.ca/genid/515f66f93ffb2722"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://spec.qc.ca/uploads/amadou-et-mariam-sons-du-mali-horizontal-40d6f4c05437c6c80223.jpeg"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/amadou-et-mariam-sons-du-mali"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/amadou-et-mariam-sons-du-mali"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Amadou Et Mariam : Son Du Mali"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\nDocumentaire musical. Canada. 2025. 1h27 min. (G) \n\nDepuis les années 1980, Amadou &amp;amp; Mariam se sont imposés comme des figures majeures de la musique ouest-africaine. Le film nous plonge dans l&#039;univers de ce couple malien alors qu&#039;il prépare un nouvel album et un grand concert de retour dans son pays natal. Entre séances de studio, répétitions et moments de vie en tournée, Amadou et Mariam : Sons du Mali retrace le parcours de deux artistes qui, malgré leur cécité, ont développé une approche unique de la musique, guidée par l&#039;écoute, le geste et l&#039;intuition. Un portrait intime et lumineux, porté par leur complicité et leur conviction que la musique peut rassembler. Présenté en version originale, avec sous-titres français.\n\nLa projection sera suivie d&#039;une rencontre et d&#039;une discussion autour du film, en compagnie d&#039;une personne invitée.\n\n\n🎬 Voir la bande-annonce"
      }
    ]
  },
