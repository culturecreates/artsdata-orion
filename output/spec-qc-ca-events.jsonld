    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/c63534d8b807a5a0"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/beyries"
