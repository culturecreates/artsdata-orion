  {
    "@id": "https://spec.qc.ca/genid/cd47a7458f2a50bb",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-12-20T13:15:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-12-20T16:15:00"
      }
    ],
