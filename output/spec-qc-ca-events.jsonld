    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Hallelujah Leonard"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\nHallelujah Leonard rend hommage à Leonard Cohen dans une relecture intime et habitée de ses chansons, connues et méconnues. Portée par la voix soul de Dominique Quesnel, accompagnée de Claude Fradette et Simon Dolan, cette traversée musicale touche droit au cœur. Un spectacle comme un album de souvenirs, sensible et profondément émouvant."
      }
    ]
  },
