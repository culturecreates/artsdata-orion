    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/0f528cd36a2d28ea"
      },
      {
        "@id": "https://spec.qc.ca/genid/5ea417e402bfdca1"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/julien-dassin-chante-joe-dassin"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/julien-dassin-chante-joe-dassin"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Julien Dassin Chante Joe Dassin"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": " \nAprès avoir conquis le public québécois, Julien Dassin chante Joe Dassin est de retour pour une nouvelle tournée célébrant l'œuvre intemporelle de l'une des plus grandes figures de la chanson francophone. \n\nPorté par l'émotion, la sincérité et le profond attachement qui l'unit à l'héritage de son père, Julien Dassin fait revivre les chansons qui ont marqué plusieurs générations. Accompagné de six musiciens d'exception du Band Paris Tour Eiffel, il revisite les grands succès de Joe Dassin, dont Les Champs-Élysées, Et si tu n'existais pas, L'Été indien, Le Jardin du Luxembourg et bien d'autres. Un moment rare et poignant où la musique devient un pont entre passé et présent, entre mémoire et renaissance.\n"
      }
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/Chanson"
      }
    ]
  },
