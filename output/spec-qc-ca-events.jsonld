    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/f2d6196d4ae03ebf"
      },
      {
        "@id": "https://spec.qc.ca/genid/4a875c98b660bbd7"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/le-grand-vert-tige-de-monsieur-gazon"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/le-grand-vert-tige-de-monsieur-gazon"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Le Grand Vert Tige De Monsieur Gazon"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\nPar sa maîtrise impressionnante de l&#039;acrobatie, de la jonglerie, de l&#039;équilibre et du monocycle, David Fiset déploie une vaste palette de talents nourris par un humour clownesque irrésistible. Son univers, porté par des musiques entraînantes, repousse les limites et réinvente avec fantaisie les lois de la physique.\n\nDoté d&#039;un charisme exceptionnel, il captive l&#039;attention, surprend à chaque instant et entraîne petits et grands dans un voyage rempli de moments mémorables. Entre mimiques savoureuses et cascades inattendues, il jongle avec balles, quilles, monocycles et mille trouvailles nées de l&#039;instant.\n\nUn spectacle où la virtuosité se marie à l&#039;émerveillement !"
      }
    ]
  },
