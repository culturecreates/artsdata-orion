    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/noel-une-tradition-en-chanson"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/noel-une-tradition-en-chanson"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Noël, Une Tradition En Chanson"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "C'est un rendez-vous dès 2026 pour la 9e édition de Noël une tradition en chanson.\n\nPour plusieurs, ce rendez-vous festif donne le coup d'envoi à la période des festivités de fin d'année. Au fil des ans, ils ont été plus de 100 000 spectateurs à venir entendre les plus belles voix du Québec interpréter des classiques incontournables. \n\nNoël une tradition en chanson fait vibrer la corde sensible des souvenirs d'enfance en misant sur la nostalgie et le plaisir de célébrer ensemble. \n\nUne mise en scène de Joël Legendre avec Jacques Roy à la direction musicale.\n\nSteph Carse, Annie Villeneuve, Étienne Drapeau, Kathleen Fortin, Michaël Girard, Marie-Élaine Thibert et Christine Chartrand seront tous de la neuvième édition de Noël une tradition en chanson. C'est un rendez-vous en 2026 !"
      }
    ]
  },
