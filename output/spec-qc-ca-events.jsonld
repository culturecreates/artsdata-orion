      {
        "@id": "https://spec.qc.ca/genid/8d2eb1742939e6bb"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/vu-du-pont"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/vu-du-pont"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Vu Du Pont"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\nDans la zone portuaire de Brooklyn, Alfieri, un avocat ayant toujours vécu dans le quartier, raconte un fait divers tragique dont il est le témoin impuissant : Eddie Carbone, un débardeur d'origine italienne, vit avec son épouse Béatrice et leur jeune nièce Catherine, orpheline recueillie par le couple. Un jour, deux cousins de Béatrice, Marco et Rodolpho, fuyant la misère de leur région de l'Italie, entrent illégalement aux États-Unis et trouvent refuge chez Eddie. Catherine ne tarde pas à s'éprendre de Rodolpho, envers qui Eddie éprouve pourtant une profonde méfiance. L'homme tente donc de dissuader sa nièce de fréquenter Rodolpho, mais ses efforts restent vains et bientôt, les deux amants annoncent qu'ils ont l'intention de se marier. Eddie prend alors une décision qui aura de funestes conséquences.\n\nDistribution : Frédéric Beaudin, Alain Boisvert, Chantal De La Durantaye, Marcel Fortin, Jonathan Gaudreau, Félix Maheux, Patrick Ménard, Eliane Toupin"
      }
    ]
  },
