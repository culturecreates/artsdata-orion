        "@id": "https://spec.qc.ca/genid/b62399a833b3a62d"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://spec.qc.ca/genid/b741a920578e8dd9"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://spec.qc.ca/uploads/sam-vitualano-arsenault-horizontal-1972b0cfa84f1c599f82.jpeg"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/1943cae8bdddfd0b"
      },
      {
        "@id": "https://spec.qc.ca/genid/cd0104fa8038a921"
      },
      {
        "@id": "https://spec.qc.ca/genid/c7fdb0013229bf9a"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/sam-vitualano-arsenault"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/sam-vitualano-arsenault"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Sam Vitulano-Arsenault"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "18 ans et +\n\n&quot;SALEUH&quot;, c&#039;est un peu comme un premier rendez-vous galant. Un premier contact entre vous et moi, où l&#039;on se découvre, l&#039;on rigole et on se rapproche. \n\n\nDans ce show en rodage, j&#039;me livre sans filtre, entre rires, anecdotes et moments de partage authentique. À travers des histoires de famille, d&#039;amour, de célibat, de voyages, je vous plonge dans mon univers absurde et sincère. Le tout avec une (grosse) touche de folie, de l&#039;auto-dérision et beaucoup de cœur.\n\nPourquoi SALEUH ? Parce que c&#039;est la façon dont je dis &quot;bonjour&quot; à chaque nouvelle rencontre. Un &quot;saleuh&quot; décalé, chaleureux, un peu maladroit, mais surtout un &quot;saleuh&quot; qui veut dire : &quot;ce soir, on va apprendre à se connaître pis on va avoir du fun&quot;. "
      }
    ]
  },
  {
    "@id": "https://spec.qc.ca/genid/b741a920578e8dd9",
    "@type": [
      "http://schema.org/PerformingGroup"
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Saleuh - en rodage<br />\nHumour"
      }
    ]
