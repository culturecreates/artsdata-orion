      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://spec.qc.ca/uploads/daniel-lemire-et-denis-bouchard-horizontal-a34f365173edf7a7944d.jpeg"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://spec.qc.ca/genid/06b778be1b5bc298"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://spec.qc.ca/programmation/daniel-lemire-et-denis-bouchard"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://spec.qc.ca/programmation/daniel-lemire-et-denis-bouchard"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Daniel Lemire Et Denis Bouchard"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Grands amis dans la vie, Daniel Lemire et Denis Bouchard unissent enfin leurs talents dans un tout nouveau spectacle d'humour où ils racontent leurs meilleures histoires de voyage. Entre fous rires et confidences, le duo revisite ses périples les plus cocasses, ses imprévus de tournée et ses rencontres inoubliables. Une soirée pleine d'esprit, de complicité et d'autodérision, où les deux comparses nous entraînent dans leur univers aussi drôle qu'humain."
      }
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/ComedyPerformance"
      }
    ]
  },
  {
    "@id": "https://spec.qc.ca/genid/6bdb7e23efbe296c",
    "@type": [
      "http://schema.org/PerformingGroup"
    ],
