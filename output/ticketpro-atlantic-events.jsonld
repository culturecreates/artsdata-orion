    ],
    "http://schema.org/name": [
      {
        "@value": "Dartmouth Players presents: Memories of a Christmas Ornament - By Maureen Rooney\t"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p> A magical Christmas ornament comes to life and transports us back to the day she was bought as an engagement gift. The ornament becomes a treasured part of every family Christmas that follows, witnessing the couple's life unfold - their joys, struggles, milestones, and enduring love - becoming a silent keeper of their family history across the years.<br>\n\n<br><b>Ages: 5+</b><br>\n<br>For accessibility inquiries, please email <a href='mailto: info@dartmouthplayers.ns.ca'>info@dartmouthplayers.ns.ca</a></b></p>\n\n<style>\n.location-page-temp {\n    display: block!important;\n}\n</style>"
      }
    ],
