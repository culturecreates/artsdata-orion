        "@id": "https://tproatlantic.ticketpro.ca/api/v1/resources/1673954105.jpeg?version=1"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/genid/46330e34ccd6c81b"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/en/pages/1673954205/performances/COP13KS26"
