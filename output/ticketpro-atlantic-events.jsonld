    "http://schema.org/name": [
      {
        "@value": "Hubtown Theatre presents Jonas & Barry in the Home"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Get ready for a night of big laughs, quick wit and plenty of heart!</p><br>\n\n<p>When Barry meets the larger-than-life Jonas at Gateway Gardens, an unlikely friendship turns getting older into an unexpected adventure.</p><br>\n\n<p>Norm Foster's Jonas and Barry in the Home is a warm, hilarious comedy about friendship, second chances and discovering that some of life's best moments may still be ahead.</p><br>\n\n<p>A feel-good comedy about friendship, laughter and the joy of starting over!</p><br>\n\n<style>\n@media screen and (max-width: 600px){iframe{width:100%;}}\n</style>"
      }
    ],
