      {
        "@id": "https://tproatlantic.ticketpro.ca/en/pages/1702893857/performances/GST30JA26"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "The New Glasgow Haunted Hike - With Town Crier Jim Stewart"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Back for its third year, the New Glasgow Haunted Hike invites you to discover the darker side of downtown!</p><br>\n\n<p>Join New Glasgow Town Crier Jim Stewart for an evening of creepy tales, local legends and fascinating history. Beginning inside Glasgow Square Theatre, the hike will weave through New Glasgow's downtown core before concluding back at the theatre.</p><br>\n\n<p>Tickets are extremely limited, with only 20 spaces available for each hike.</p><br>\n\n<p><b>Please note: This is an outdoor walking experience, and the route may include uneven terrain or areas that are not fully accessible. Participation is at your own risk, and proper footwear is strongly recommended.</b></p><br>\n\n<style>\n.location-page-temp {display: block!important;}\n@media screen and (max-width: 600px){iframe{width:100%;}}\n</style>\n\n"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
