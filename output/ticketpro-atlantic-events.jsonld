    "http://schema.org/name": [
      {
        "@value": "Donald MacLennan - Antigonish Jazz Fest"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "\n\n\n<p>Donald MacLennan from Dartmouth, Nova Scotia, is an award winning violinist / vocalist / composer / teacher who grew up in Chimney Corner, Cape Breton. A multi-genre arranger and improviser, MacLennan has established himself recording and touring internationally with Ben Caplan, the Modern Grass, Duane Andrews (NL), Mary Beth Carty, Michael C Duguay (ON), the Upstream Music Association, and his own jazz manouche project 'The Hot Club of Dartmouth'.</p>\n\n\n<style>\n.location-page-temp {\n    display: block!important;\n}\n</style>"
      }
    ],
