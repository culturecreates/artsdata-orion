      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/api/v1/resources/1699818269.jpeg?version=1"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/genid/ebade774ab84287b"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/en/pages/1699818369/performances/MCC10KS26"
