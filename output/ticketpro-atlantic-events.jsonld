        "@id": "https://ticketpro.ca/place/10427772"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/api/v1/resources/1705008814.jpeg?version=1"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/genid/47c3798c00f9c8c3"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/en/pages/1705008914/performances/AST14JA26"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/en/pages/1705008914/performances/AST14JA26"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Opening Ceremonies & There's Something in the Water - Liverpool International Theatre Festival"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Help us welcome the world to Liverpool at the LITF 2026 Opening Ceremonies! The evening begins with the colourful Parade of Flags through downtown Liverpool, as participating troupes proudly carry their nations' flags to the Astor Theatre.<br><br>\n\nInside, we'll officially welcome our international guests with national anthems and opening remarks, followed by a special Musical Theatre Showcase - There's Something in the Water. Astor favourites Lauren Amirault, Brent Raddall, Kristopher Snarby and Deborah Raddall, accompanied by Alison Williams on piano, will share a collection of musical theatre favourites and a little local magic.<br><br>\n\nBecause in Liverpool, we've always said there must be something in the water!\n<style>\n\n@media screen and (max-width:728px) {\niframe{width:100%!important;}\n}\n</style>"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
