    "http://schema.org/name": [
      {
        "@value": "Monster Madness"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "  <b>One Mind Blowing Show... Three times the fun!</b><br>\n    Feel the roar of the monster trucks as the Monster Madness Tour stops in Miramichi NB at R&R Speedway with stars from the 'FMX World Tour' and more! This is an action-packed afternoon fans won't want to miss!\n<br><br>\n\n  <b>Monster Madness Tour</b>: featuring 5 Monster Trucks, & more will have you on your feet as you watch the 10,000 pounds of MONSTER TRUCKS soar through the air! The competition will include tricks like wheelies, racing, monster truck freestyle and more!\n<br><br><small><em>(Monster Truck line up subject to change without notice)</em></small>\n<br>\n<br>Note:\n      <li>Children 2 and UNDER ON LAP ARE FREE</li>\n      <li>Children 12 AND OLDER = ADULT</li>\n      <li><strong>TICKET PRICES INCREASE $5.00 June 1 ST.</strong></li>\n\n<br>\n\n  <b>For more details visit <a href='http://www.monstermadnesstour.ca' target='_blank'>www.monstermadnesstour.ca</a></b>\n\n"
      }
    ],
