      {
        "@id": "https://tproatlantic.ticketpro.ca/genid/e6c65434aaf3b87e"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/en/pages/1695797718/performances/HOL25IS26"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/en/pages/1695797718/performances/HOL25IS26"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Return on Goodwill LIVE — The Official Book Launch Tour with Sam Demma - Do Good. Expect Nothing. Watch Life Give Back."
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p><b><i>Return on Goodwill LIVE</i></b> is coming to Charlottetown as part of an exclusive 10-city book launch tour. Bestselling author and international keynote speaker Sam Demma is launching his new book, Return on Goodwill, the only way he knows how: on stage, in person, with you in the room.</p>\n\n \n\n<p>This isn't a lecture. This is a <b>full-throttle storytelling experience</b> that will have you laughing one moment and wiping tears the next, then walking out the doors ready to change how you move through the world.</p>\n\n \n\n<p>Whether you're a leader, a parent, an educator, a family looking for a meaningful night out together, or simply someone who believes the world could use a little more good, this night was made for you. The show is perfect for all ages.</p>\n\n \n\n<p>This is one of only ten shows on the entire launch tour and your chance to be among the first people in the world to own a copy. Meet Sam, get your book signed, and be part of the moment this movement officially begins. Books will be available for purchase with your ticket or at the venue.</p>\n\n \n\n<p><b>Fair warning: you will not leave this theatre the same person who walked in.</b></p>\n\n \n\n<p>Space is limited. There are only ten launch tour dates across the country, and these intimate theatre shows have a history of selling out. Grab your tickets early to secure your spot.</p>\n"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
