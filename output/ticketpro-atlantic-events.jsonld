      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/genid/6e78a8a37282c16c"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/en/pages/1705008920/performances/AST17LS26"
