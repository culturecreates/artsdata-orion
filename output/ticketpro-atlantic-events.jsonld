    "http://schema.org/description": [
      {
        "@value": "<p>Following two sold-out shows during JFL Toronto, Zarna Garg is bringing her new show, Million Dollar Excuses, to Halifax on December 12, 2026</p>\n\n<p><b>VIP</b>: Meet Zarna after the show! This VIP experience includes premium seating and a post-show meet & greet and photo opportunity.</p>\n\n<style>\n.location-page-temp {\n    display: block!important;\n}\n</style>"
