        "@value": "<p style='color: red; font-size: 120%;'>\n  <b>Bring your friends & family — Reserve Group Tickets \n    <a href='https://goredsgo.ticketpro.ca/en/pages/unbvolleyballgroup?promo=GROUP&presale=unbtest25' target='_blank' style='color: red;'>HERE</a>!\n  </b>\n</p>\n\n<style>\n.location-page-temp {display: block!important;}\n.titleTax {display: none !important;}\n</style>"
