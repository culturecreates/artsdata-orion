      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/api/v1/resources/1700388233.jpeg?version=1"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/genid/c3c60fc10f3ada20"
      },
      {
        "@id": "https://tproatlantic.ticketpro.ca/genid/7b2b30fc70a20b1a"
