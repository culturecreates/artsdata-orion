    "http://schema.org/url": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/en/pages/1706352201/performances/HHT02LS26"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "The Harmony House Holiday Kitchen Party!"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Come celebrate the holidays this December at Harmony House with our annual Harmony House Holiday Kitchen Party concert!!  It will be a joyful and fun evening of holiday stories and performances by a brilliant group of Island musicians.Alicia Toner, Brielle Ansems, Luka Hall, Mike Ross, Carlie Howell, and Trevor Grant.</p>\n\n<p><b>If you would like to make a reservation to enjoy dinner before the show, please call the venue at: 902-964-2255 or email them at <a href='mailto:harmonyhousePEIresos@gmail.com'>harmonyhousePEIresos@gmail.com</a>!<br><br>\n\nFor ticket details, visit Harmony House Theatre on-line at <a href='https://harmonyhousepei.com/' target='_blank'><u>harmonyhousepei.com</u></a> or call the box office at 1-888-311-9090.</i></b></p>\n\n<p><b>Harmony House Gift Certificates are not redeemable through Ticketpro. Please contact Harmony House directly to redeem.</b></p>\n\n<p><b><font size='+1'>TICKET PURCHASES ARE FINAL AND NON-REFUNDABLE</b></font></p>\n\n<style>\n.location-page-temp {\n    display: block!important;\n}\n</style>\n\n\n"
      }
    ],
