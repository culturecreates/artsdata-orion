    "http://schema.org/name": [
      {
        "@value": "Dartmouth Players presents: The Haunting of Hill House"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>In this chilling ghost story, a small group of visitors investigate paranormal occurrences at an enigmatic mansion. But Hill House holds darkness within, and whatever walks there, walks alone</p>\n\n<p><b>Adapted by F. Andrew Leslie<br>\nNovel by Shirley Jackson</b></p>\n\n<p><b>Ages: 16+<br>\nContent advisory: Contains adult themes. Not suitable for those under 16.</b><br>\nFor accessibility inquiries, please email <a href='mailto: info@dartmouthplayers.ns.ca'>info@dartmouthplayers.ns.ca</a></p>\n\n<style>\n.location-page-temp {\n    display: block!important;\n}\n</style>"
