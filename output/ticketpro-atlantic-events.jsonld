    "http://schema.org/name": [
      {
        "@value": "Hubtown Theatre presents Cheaters"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Hubtown Theatre presents the comedy Cheaters by Michael Jacobs, October 21 to 24 at the Marigold.  A young couple decides it's time to 'meet the parents' and introduce everyone.  However, they find their lives turned upside down when it turns out some of them already 'know' each other.   Come out to see Cheaters, a clever look at love, loyalty, and betrayal. </p>\n\n\n<style>\n@media screen and (max-width: 600px){iframe{width:100%;}}\n</style>"
      }
    ],
