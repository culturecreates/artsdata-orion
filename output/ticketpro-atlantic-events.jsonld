    ],
    "http://schema.org/name": [
      {
        "@value": "The Pursuit (Film Presentation) - Ushindi Community Theatre (Uganda) - Liverpool International Theatre Festival"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<b>Mature Theme</b><br><br>\n\nSynopsis: A Chief's son is expected to undergo a traditional initiation ceremony involving adult circumcision — and he isn't too keen. He flees his village and hides elsewhere, but a plot involving the village's most beautiful girl leads to his capture and circumcision, saving his father's embarrassment. But how does the young man himself feel? The Pursuit is a feast of colour, music and movement, presented in English.\n\n\n<style>\n\n@media screen and (max-width:728px) {\niframe{width:100%!important;}\n}\n</style>"
      }
    ],
