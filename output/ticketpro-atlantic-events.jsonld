  {
    "@id": "https://ticketpro.ca/event/1695395185",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-01-23T19:30:00-04:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://ticketpro.ca/place/55150121"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/api/v1/resources/1695410331.jpeg?version=1"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/genid/2f042f194b2d2148"
      },
      {
        "@id": "https://tproatlantic.ticketpro.ca/genid/2ecf2b6c70108720"
