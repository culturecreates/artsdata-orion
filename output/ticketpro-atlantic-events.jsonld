      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/api/v1/resources/1658655822.jpeg?version=1"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/genid/5007e280629a54d0"
      },
      {
        "@id": "https://tproatlantic.ticketpro.ca/genid/191a067b242b1602"
