    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/genid/0f75e3fc48516b1b"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/en/pages/HHT_BehindtheVeil26/performances/HHT26IS26"
      }
