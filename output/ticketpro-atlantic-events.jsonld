  {
    "@id": "https://ticketpro.ca/event/1691587879",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-10-16T20:00:00-03:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://ticketpro.ca/place/1368408503"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/api/v1/resources/1691567710.jpeg?version=1"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/genid/4f4ae84e5e3ccf99"
      },
      {
        "@id": "https://tproatlantic.ticketpro.ca/genid/4a44ee50944f1a35"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/en/pages/1691567660"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/en/pages/1691567660"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "80s Dance Party with Maximum Overdrive"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Get ready to groove at the ultimate 80s Dance Party with Maximum Overdrive! Known for their electrifying performances, they'll take you on a nostalgic journey through 80s hits from iconic artists. Join us at Devour! Studios for a night filled with energy, dancing, and fun. Dust off your leg warmers and headbands, and prepare to relive the magic of the 80s. <b>Must be 19+ to attend. </b></p>\n\n<p><b>About Maximum Overdrive</b><br>\nMaximum Overdrive is the east coast's hottest new party band - playing a diverse selection of 80s gems from artists like INXS, Duran Duran, The Pixies, Cindy Lauper, The Cure, Madonna, Billy Idol, New Order, DEVO, Tears for Fears, and many more. You've seen them all on stages across Canada and beyond with a host of awesome bands—but you've never seen them like this. Join the party. Live the 80s. Go to Maximum Overdrive.</p>\n\n<p><b>About Devour! Studios</b><br>\nDevour! Studios is a dynamic cultural and culinary hub housed in a former apple warehouse, featuring a state-of-the-art teaching kitchen, event hall, and performance venue. Open year-round, it fosters creativity through various educational programming, including hosting the 16th Devour! Food Film Fest from October 19-25, 2026, in Wolfville. The Studios are also available for rent; more details are available at devourstudios.com. </p>\n\n<!--<p>Check out the band <a href='https://maximumoverdrive80s.com/' target='_blank'>here</a> or follow them on <a href='https://www.instagram.com/maximumoverdrive80s/' target='_blank'>IG</a>.</p>-->\n\n\n\n<style>\n.location-page-temp {display: block!important;}\n</style>"
      }
    ],
