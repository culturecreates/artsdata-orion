    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/en/pages/1695410447/performances/MCC02JS26"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/en/pages/1695410447/performances/MCC02JS26"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "In Spite Of Ourselves: The Quintessential John Prine Tribute"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>A memorable evening of John Prine's finest songs & stories, performed by eight seasoned veteran songwriter/musicians' and friends', who are lifelong fans of John Prine. A show that includes a multimedia layer of captivating still pics.</p>\n\n<p>John Prine is widely cited as one of the most influential songwriters of his generation and was known for humorous & insightful lyrics about love, life, and current events, as well as his serious songs with social commentary and songs that recollect melancholy tales from his life.</p>\n\n<p>According to Bob Dylan 'Prine's stuff is pure, Proustian, existentialism, Midwestern mind trips to the nth degree, and he writes beautiful songs.' Join us as we celebrate & elaborate on the beautiful songs of one of the finest songwriters of our generation.</p>\n\n<p>Join Blair Packham (The Jitters), Bill Craig (The Irish Rovers), Kirsten Jones and two-time Juno award nominee Johnny Max, as they perform a repertoire of Prine that resonates with audiences far and wide.</p>\n\n\n<style>\n@media screen and (max-width: 600px){iframe{width:100%;}}\n</style>"
      }
    ],
