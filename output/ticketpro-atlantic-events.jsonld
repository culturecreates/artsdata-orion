    "http://schema.org/url": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/en/pages/1702726954/performances/OBS19FS27"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Monster Madness & FMX World Tour "
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "  <b>One Mind Blowing Show... Three times the fun!</b><br>\n    Feel the roar of the monster trucks as the Monster Madness Tour stops in Oyster Bed P.E.I. at Oyster Bed Speedway with stars from the 'FMX World Tour' and more! This is an action-packed afternoon fans won't want to miss!\n<br><br>\n\n  <b>Monster Madness Tour</b>: Featuring 5 Monster Trucks, & more will have you on your feet as you watch the 10,000 pounds of MONSTER TRUCKS soar through the air! The competition will include tricks like wheelies, racing, monster truck freestyle and more!\n<br><br>\n\n  <b>FMX World Tour</b>: The FMX WORLD TOUR act will leave fans and families amazed as death defying stunts only the brave would attempt are performed, inside the arena. FMX World Tour is the perfect blend of athletic ability, extreme stunt competitions and tricks and flips! FMX World Tour stars will perform tricks such as, captain morgan, kiss of death, cliff hangers, in addition to the famous BACKFLIP!\n<br><br><small><em>(Monster Truck line up subject to change without notice)</em></small>\n<br>\n<br>Note:\n      <li>Children 2 and UNDER ON LAP ARE FREE</li>\n      <li>Children 12 AND OLDER = ADULT</li>\n      <li><strong>TICKET PRICES INCREASE $5.00 May 1 ST.</strong></li>\n\n<br>\n\n  <b>For more details visit <a href='http://www.monstermadnesstour.ca' target='_blank'>www.monstermadnesstour.ca</a></b>"
      }
    ],
