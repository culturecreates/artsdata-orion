    ],
    "http://schema.org/name": [
      {
        "@value": "Toller Presents: The Canadian Tuxedo Party"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<b>Denim on Denim on Denim</b><br><br>\nJoin us on <strong>Saturday, October 24th, 2026</strong> at <strong>The Marquee</strong> as Toller Presents the ultimate Canadian Tuxedo Party — featuring a Halifax All-Star Band and special guests singing Canadian classics, hosted by East Coast's own <strong>Christina Martin</strong>.\n<br><br>\n\n<strong>Special Guest Artists:</strong> BASYL, Caleb Vallelly, Christina Martin, Dave Sampson, Jeff Mosher, Natasha Sophia, Rebekah Higgs and Roxy Mercier<br>\n<strong>Halifax All-Star Band:</strong> Clint Newcom, Jordan Murphy, Mike Farrington Jr, Siobhan Martin, Tori Cameron, Zach MacLean\n<br><br>\n\n<b>The Marquee Ballroom</b><br><br>\n<strong>Doors Open at 3:00 PM | Music starts at 4:00 PM</strong><br><br>\n\n      <strong>Wear your best Canadian Tuxedo!</strong> Denim on denim on denim. During the show, we'll have a contest for best dressed and the winner will receive <strong>BEER FOR A YEAR!!!<br><br>\n\n<i>*Youth are not permitted to participate in the 'beer for a year' contest but are encouraged to dress in their best denim tuxedo.</i>\n"
      }
    ],
