  {
    "@id": "https://ticketpro.ca/event/1665520640",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-09-12T19:00:00-03:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://ticketpro.ca/place/1124746250"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/api/v1/resources/1658655821.jpeg?version=2"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/genid/3e383823836bb6b3"
      },
      {
        "@id": "https://tproatlantic.ticketpro.ca/genid/fc5a26ce9651ab9c"
