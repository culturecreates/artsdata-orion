        "@id": "https://tproatlantic.ticketpro.ca/api/v1/resources/1701042954.jpeg?version=1"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/genid/81858ee4c0732ea8"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/en/pages/1701043055"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/en/pages/1701043055"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Woody Point Heritage Theatre Sonic Harvest Sessions - Still Stealing Genius"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Sonic Harvest returns to Woody Point for two weekends of music, stories, and creative risk in the historic Woody Point Heritage Theatre. At the intersection of writing and music, join us for outstanding Newfoundland writers, musicians, and guest performers from Atlantic Canada. Expect unexpected collaborations and a true sense of community in the heart of Gros Morne National Park.<br><br>\n\nSonic Harvest is a rich cultural experience continuing the tradition of Writers at Woody Point — connecting artists and audiences not only through performances but through conversations, friendship, and under the magic of a landscape and community that shows up as a character all its own, now in its coat of fall colours.<br><br>\n\n\nThis year we are partnering with CBC's East Coast Music Hour for a landmark collaboration — pairing Newfoundland writers and musicians on stage together for the first time, in real time, during the first weekend of Sonic Harvest.\n\n<style>\n.location-page-temp {display: block!important;}\n.location-event-temp {display: none!important;}\n</style>"
      }
    ],
