    "http://schema.org/image": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/api/v1/resources/1701364899.jpeg?version=1"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/genid/6ada3c7efbb34c36"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/en/pages/1701364995/performances/MCC03LS26"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/en/pages/1701364995/performances/MCC03LS26"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "A Gunning & Cormier Christmas"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Two of Atlantic Canada's most celebrated performers, Dave Gunning and J.P. Cormier, return to the stage this holiday season with A Gunning & Cormier Christmas - an evening of music, stories, laughter, and festive spirit.</p><br>\n \n<p>Blending masterful musicianship with quick wit and genuine friendship, these longtime friends deliver a Christmas concert that feels as much like a gathering of old friends as it does a world-class performance. From beloved seasonal favourites and timeless classics to original songs and unexpected musical moments, every show is packed with warmth, humour, and heart.</p><br>\n\n<p>Whether you're continuing a holiday tradition or discovering it for the first time, A Gunning & Cormier Christmas offers the perfect way to celebrate the season. Join Dave and J.P. for an unforgettable night filled with East Coast storytelling, exceptional musicianship, and all the joy that makes this time of year so special.</p><br>\n\n<style>\n@media screen and (max-width: 600px){iframe{width:100%;}}\n</style>"
      }
    ],
