        "@id": "https://ticketpro.ca/place/1124746250"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/api/v1/resources/1658655822.jpeg?version=1"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/genid/324ed546a35048c5"
      },
      {
        "@id": "https://tproatlantic.ticketpro.ca/genid/5e254de1ae807596"
