    "http://schema.org/name": [
      {
        "@value": "Comedy at the Square Presents: Oops, All Headliners!"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "\n\n<p><b>16+ Event.</b></p><br>\n\n<p>Comedy at the Square caps off our biggest year yet of free, monthly comedy shows by bringing together some of the best that the Maritime stand-up comedy scene has to offer: Oops, All Headliners!</p><br>\n\n<p>Friday, November 20 will see top comedy talent gracing the main stage at Glasgow Square Theatre, including Dan Hendricken, Clare Belford, Travis Lindsay, Line Woods, Chris Halef, Catherine Robertson and Roz Kennery, hosted by James Keast. If these names seem familiar, you might know them from: Just For Laughs, Halifax Comedy Fest, CBC LOL, This Hour Has 22 Minutes, the Canadian Screen Awards, Sirius XM, The Debaters or Canada's Got Talent.</p><br>\n\n<p>This show is appropriate for ages 16+. Glasgow Square Theatre is a licensed venue. Comedy at the Square is a co-production of Your Ontario Neighbour and Glasgow Square Theatre.</p><br>\n\n\n<style>\n.location-page-temp {display: block!important;}\n@media screen and (max-width: 600px){iframe{width:100%;}}\n</style>\n\n"
      }
