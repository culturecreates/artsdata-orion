    "http://schema.org/name": [
      {
        "@value": "REVIVAL - John Fogerty & CCR Tribute - with Jeff Brewer"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Coming to your Osprey this October, REVIVAL is a high-energy tribute to the music of Creedence Clearwater Revival and John Fogerty — a night of roots-rock classics delivered with grit, groove, and no filler. Fronted by Jeff Brewer, the show brings the raw, driving energy of CCR to the theatre stage with tight musicianship, big crowd moments, and pacing that never lets up. Plus, room for dancing!</p>\n\n<style>\n    .titleTax {\n       display: none !important;\n   }\n</style>\n\n"
      }
