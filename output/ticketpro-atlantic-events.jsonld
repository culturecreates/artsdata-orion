    "http://schema.org/name": [
      {
        "@value": "Bard to the Bone - Contemporancient Theatre (Wales) - Liverpool International Theatre Festival"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Synopsis: A comedy introduction to the life and works of William Shakespeare. Two professional actors and a bloke who 'isn't the sharpest tool in the box' offer a hilarious and educational journey through Shakespeare for everyone - from those put off the Bard by a traumatic school experience to those with a genuine interest and expertise. Designed for families, children and adults alike, Bard to the Bone promises to send audiences away with a new interest in Shakespeare.<br><br>\n\nA special non-competitive presentation by Contemporancient Theatre.\n\n<style>\n\n@media screen and (max-width:728px) {\niframe{width:100%!important;}\n}\n</style>"
      }
    ],
