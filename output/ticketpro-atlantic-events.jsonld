    ],
    "http://schema.org/name": [
      {
        "@value": "A Kind of Vesuvius - Players Theatre (Wales) - Liverpool International Theatre Festival"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Synopsis: Three men face the harsh reality of unemployment, trying to keep their spirits — and each other — afloat. Honest, funny and deeply human, this drama finds hope and humour in difficult times. As loneliness, isolation and feelings of failure separate the characters from family and friends, suspicion and self-delusion grow. Yet comedy and humanity remain as they struggle for connection and meaning.\n\n<style>\n\n@media screen and (max-width:728px) {\niframe{width:100%!important;}\n}\n</style>"
      }
    ],
