    "http://schema.org/url": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/en/pages/1705008918/performances/AST16JA26"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Break the Silence - Theatre Studio Beloe (Switzerland) - Liverpool International Theatre Festival"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Synopsis: Break the Silence explores silence from many dimensions: ancient statues silent for centuries, people surrounded by others yet isolated by loneliness, and a futuristic world where sound has disappeared. Silence becomes a space to hear one another beyond words, revealing dreams, fears and memories. A statement against war and indifference, the performance invites us to speak about what matters, listen deeply and remember our profound human connection.\n\n\n<style>\n\n@media screen and (max-width:728px) {\niframe{width:100%!important;}\n}\n</style>"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
