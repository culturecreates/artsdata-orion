        "@id": "https://tproatlantic.ticketpro.ca/api/v1/resources/1701364898.jpeg?version=2"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/genid/1e2fd4b1f646e0ca"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/en/pages/1701364994/performances/MCC29KS26"
