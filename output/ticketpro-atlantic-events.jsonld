    "http://schema.org/name": [
      {
        "@value": "Next Chapter: Halifax - Presented by The Girl on the Left"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "\n<p>A full day of global women's stories, local makers, and authentic connection in Halifax. Because everyone has a next chapter.</p>\n\n<p><b>Next Chapter VIP Experience</b> includes exclusive access to our intimate Welcome Reception on Saturday evening, where you'll connect with speakers, authors, partners, sponsors, and fellow attendees before the main event begins. On Sunday, enjoy priority check-in, premium reserved theatre seating, a curated VIP gift bag, complimentary signed copies of The Girl on the Left Volumes 1 & 2, breakfast, refreshments throughout the day, lunch, and full access to all event programming, networking, and the curated Makers Market.</p>\n\n"
      }
    ],
