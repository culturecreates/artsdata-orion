    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/en/pages/HHT_BehindtheVeil26/performances/HHT02IS26"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/en/pages/HHT_BehindtheVeil26/performances/HHT02IS26"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Behind the Veil"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Featuring all original compositions, this production returns this summer, after a hugely successful world premiere last year at Harmony House!</p>\n\n<p>Alicia Toner and Mike Ross create a concert experience that examines the life and soul of one Canada's most iconic and enduring authors - Lucy Maud Montgomery. Blending letters, diary entries, and poetry with original songwriting from the ensemble, this unique Harmony House production will pull back the veil to reveal who Maud really was. Featuring compositions by Brielle Ansems, Carlie Howell, Alicia and Mike, with Julain Molnar as the voice of Lucy Maud, this tight knit ensemble will bring to life the spirit of a Canadian icon.</p>\n\n<p><b>If you would like to make a reservation to enjoy dinner before the show, please call the venue at: 902-964-2255 or email them at <a href='mailto:harmonyhousePEIresos@gmail.com'>harmonyhousePEIresos@gmail.com</a>!<br>Please note: On 2pm matinee days, The Lounge is open for dinner reservations 3:30pm onward, after the 2pm performance.<br><br>\nFor ticket details, visit Harmony House Theatre on-line at <a href='https://harmonyhousepei.com/' target='_blank'><u>harmonyhousepei.com</u></a> or call the box office at 1-888-311-9090.</i></b></p>\n\n<p><b>Harmony House Gift Certificates are not redeemable through Ticketpro. Please contact Harmony House directly to redeem.</b></p>\n\n<p><b><font size='+1'>TICKET PURCHASES ARE FINAL AND NON-REFUNDABLE</b></font></p>\n\n\n<style>\n.location-page-temp {\n    display: block!important;\n}\n</style>\n\n"
      }
    ],
