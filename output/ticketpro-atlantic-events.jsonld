  {
    "@id": "https://ticketpro.ca/event/1694540759",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-10-01T19:30:00-03:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://ticketpro.ca/place/10427772"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/api/v1/resources/1694494640.jpeg?version=1"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/genid/2df2b5dff3fdfe74"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/en/pages/1694494740/performances/AST01JS26"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/en/pages/1694494740/performances/AST01JS26"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "In Spite of Ourselves - (The Quintessential John Prine Tribute)"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>A memorable evening of John Prine's finest songs & stories, performed by eight seasoned veteran songwriter/musicians' and friends', who are lifelong fans of John Prine. A show that includes a multimedia layer of captivating still pics.</p>\n\n<p>John Prine is widely cited as one of the most influential songwriters of his generation and was known for humorous & insightful lyrics about love, life, and current events, as well as his serious songs with social commentary and songs that recollect melancholy tales from his life. </p>\n\n<p>According to Bob Dylan 'Prine's stuff is pure, Proustian, existentialism, Midwestern mind trips to the nth degree, and he writes beautiful songs.' Join us as we celebrate & elaborate on the beautiful songs of one of the finest songwriters of our generation. </p>\n\n<p>Join Blair Packham (The Jitters), Bill Craig (The Irish Rovers), Kirsten Jones and two-time Juno award nominee Johnny Max, as they perform a repertoire of Prine that resonates with audiences far and wide.</p>\n\n<iframe width='560' height='315' src='https://www.youtube.com/embed/6-9HxJnGZdk?si=aRZZypLUH4VYc2Gk' title='YouTube video player' frameborder='0' allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share' referrerpolicy='strict-origin-when-cross-origin' allowfullscreen></iframe>\n\n<style>\n\n@media screen and (max-width:728px) {\niframe{width:100%!important;}\n}\n</style>"
      }
    ],
