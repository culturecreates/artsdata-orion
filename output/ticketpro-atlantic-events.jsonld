    ],
    "http://schema.org/name": [
      {
        "@value": "Rimouski Oceanic vs Saint John Sea Dogs - Preseason Game"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>The AYR Motor Centre is thrilled to announce the return of Quebec Maritimes Junior Hockey League (QMJHL) action to Woodstock on Sunday, August 30, 2026, when the Saint John Sea Dogs host the Rimouski Océanic in an exciting preseason matchup.</p>\n\n<p>Doors will open at 2:30 PM, and the puck drops at 4:00 PM at the AYR Motor Centre Arena. After a thrilling debut last year, this is another incredible, family-friendly opportunity for Woodstock and surrounding communities to experience the speed, skill, and intensity of major junior hockey right in our backyard.</p>\n\n<p>In addition to the high-stakes, on-ice action, spectators will have the chance to purchase official Sea Dogs merchandise, take part in 50/50 draws, and enjoy other fun surprises throughout the afternoon.</p>\n\n<p><a href='https://chl.ca/lhjmq-seadogs/' target='_blank'>https://chl.ca/lhjmq-seadogs/</a></p>"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
