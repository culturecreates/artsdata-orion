    "http://schema.org/name": [
      {
        "@value": "Tracy and Martina: Live at Glasgow Square Theatre"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>All the way from Cape Breton Island, the girls head out on their first cross-Canada tour. Come see the viral East Coast duo as they bring their signature storytelling and off the cuff humour to the stage. If you're missing home or just want a good laugh, Tracy and Martina deliver every time. With stories, crowd interaction, and plenty of surprise moments, it's a night you won't forget!</p>\n\n\n<style>\n.location-page-temp {display: block!important;}\n@media screen and (max-width: 600px){iframe{width:100%;}}\n</style>\n\n"
      }
