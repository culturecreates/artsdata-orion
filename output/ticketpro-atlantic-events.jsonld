  {
    "@id": "https://ticketpro.ca/event/1695801860",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-09-25T19:00:00-03:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://ticketpro.ca/place/1124746250"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/api/v1/resources/1695797172.jpeg?version=1"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/genid/ec82fa35160ffb57"
      },
      {
        "@id": "https://tproatlantic.ticketpro.ca/genid/92536dfe503dabc6"
