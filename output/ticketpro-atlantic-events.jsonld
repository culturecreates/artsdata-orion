    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/en/pages/1706779752/performances/HHT14KS26"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/en/pages/1706779752/performances/HHT14KS26"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Roving Picture Shows and Island Jazz present Stella Maris"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Roving Picture Shows and Island Jazz present Stella Maris, a 1918 Marshall Neilan picture starring Canada's biggest silent‑era movie star, Mary Pickford. Musicians, TBA, will perform a live improvised score.\n<br><br>\nStella Maris, written by Frances Marion — one of the most renowned female screenwriters of the early 20th century — tells the story of two young women, both played by Pickford in a dual role that required technical innovation to show her twice in the same shot, who fall in love with a man unhappily married.</p>\n\n<p><b>If you would like to make a reservation to enjoy dinner before the show, please call the venue at: 902-964-2255 or email them at <a href='mailto:harmonyhousePEIresos@gmail.com'>harmonyhousePEIresos@gmail.com</a>!<br><br>\nFor ticket details, visit Harmony House Theatre on-line at <a href='https://harmonyhousepei.com/' target='_blank'><u>harmonyhousepei.com</u></a> or call the box office at 1-888-311-9090.</i></b></p>\n\n<p><b>Harmony House Gift Certificates are not redeemable through Ticketpro. Please contact Harmony House directly to redeem.</b></p>\n\n<p><b><font size='+1'>TICKET PURCHASES ARE FINAL AND NON-REFUNDABLE</b></font></p>\n\n\n<style>\n.location-page-temp {\n    display: block!important;\n}\n</style>\n\n"
      }
    ],
