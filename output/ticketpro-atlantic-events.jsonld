    ],
    "http://schema.org/name": [
      {
        "@value": "The Stanfields Presented by Queens County"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>In celebration of 30 years of Queens County, The Stanfields are coming to the Astor Stage!<br> \nThe Stanfields are a multiple award-winning six-piece Folk'n'Roll band based in Halifax, Canada. Combining Rock music with solid nods to Celtic and Americana, they play what they want, sing what they feel, and leave nothing on the table. </p><br> \n\n<p>Formed in 2008, The Stanfields have since released 5 albums, multiple singles, and toured extensively throughout North America and Europe, sharing the stage with Queens of the Stone Age, Flogging Molly, Frank Turner and Dropkick Murphys among many others. </p><br> \n\n<iframe width='560' height='315' src='https://www.youtube.com/embed/EY00Zi1EdVs?si=-ow5zFXuathyoTiS' title='YouTube video player' frameborder='0' allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share' referrerpolicy='strict-origin-when-cross-origin' allowfullscreen></iframe>\n\n<style>\n\n@media screen and (max-width:728px) {\niframe{width:100%!important;}\n}\n</style>"
      }
    ],
