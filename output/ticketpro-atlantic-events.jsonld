        "@id": "https://ticketpro.ca/place/1124746250"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/api/v1/resources/1658655822.jpeg?version=1"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/genid/4d0bd8f0c43a8215"
      },
      {
        "@id": "https://tproatlantic.ticketpro.ca/genid/870e81408a8429ec"
