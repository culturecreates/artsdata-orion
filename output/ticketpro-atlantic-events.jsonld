        "@id": "https://ticketpro.ca/place/1124746250"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/api/v1/resources/1658655822.jpeg?version=2"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/genid/c40def95705d41bb"
      },
      {
        "@id": "https://tproatlantic.ticketpro.ca/genid/96b7ddfdc7a9eea2"
      },
      {
        "@id": "https://tproatlantic.ticketpro.ca/genid/2092065d49ddd384"
      },
      {
        "@id": "https://tproatlantic.ticketpro.ca/genid/e9aebc199f2eabff"
