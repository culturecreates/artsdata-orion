    "http://schema.org/name": [
      {
        "@value": "Good Grief: A Variety Fundraiser for the Hospice Society"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>The Marigold Cultural Centre is proud to present Good Grief, a variety show fundraiser in support of the Colchester-East Hants Hospice Society. Join us for an evening of music, laughter, poetry, and perhaps even a little magic, and help us raise funds and awareness for Hospice in our community!</p>\n\n<p>Good Grief will feature performances from Corey Matheson, Mr. Curtoons, Greg Purvis, Mike Robinson, and Mister J.</p>\n\n<p>See you at the Marigold on September 17th!</p>\n\n<style>\n@media screen and (max-width: 600px){iframe{width:100%;}}\n</style>"
      }
