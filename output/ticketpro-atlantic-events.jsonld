    ],
    "http://schema.org/url": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/en/pages/1700388304/performances/COP07HS26"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "The Ultimate Hits: Garth Brooks Tribute"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Garth Brooks (The Ultimate Hits)<br>\nMultiple award-winning performer and multi-instrumentalist Elton Lammie is one of the\nmost authentic and respected tribute artists in North America. Since 2005, he has\ncherished the privilege of recreating the Garth hits for audiences across the continent with\nhis all-star band. His dozens of awards include winning multiple national vocal\ncompetitions, in both the country music and opera genres. Garth Brooks is one of the\nworld's best-selling artists of all-time, having sold more than 170 million records. This\nmemorable tribute experience, delivers a truly compelling evening filled with all of the hits.</p> \n\n\n<style>\n.location-page-temp {\n    display: block!important;\n}\n</style>"
      }
    ],
