    "http://schema.org/name": [
      {
        "@value": "The Festival VIP Pass 2026 - 16th Devour! The Food Film Fest"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Join us in 2026 as we celebrate the 16<sup>th</sup> anniversary of Devour!, the world's largest culinary film festival, happening in Wolfville, Nova Scotia, from October 19-25, 2026. Attending the full festival has never been easier with our Devour VIP All-Access Pass, which grants you entry to all events, including film screenings, workshops, tasting and foraging tours, the Opening Gala Evening, the Chefs & Shorts Gala, and exclusive perks. Enjoy a VIP welcome reception, private tastings, chef meet-and-greets, front-of-line access, gift bags, and transportation to select events. Plus, our Devour! Concierge will assist with ticketing and scheduling for an exceptional experience. </p>\n\n<p><b>Important Details:</b><br>\n- Passes are non-transferable, and photo ID may be required.<br>\n- Accommodations are not included.<br>\n- Only 40 passes are available.</p>\n\n<p>For more information about the VIP program, please contact Lia Hennigar at <a href='mailto:concierge@devourfest.com'>concierge@devourfest.com</a>. </p>\n\n<p><b>$1,395.00 + HST & fees</b></p>\n\n<style>\n.location-page-temp {display: none!important;}\n</style>"
