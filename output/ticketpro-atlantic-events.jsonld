    ],
    "http://schema.org/name": [
      {
        "@value": "LITF 2026 Closing Ceremony & Awards - Liverpool International Theatre Festival"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Join us as we bring the 17th Biennial Liverpool International Theatre Festival to a close and celebrate an extraordinary week of theatre, friendship and cultural exchange.\nThe Closing Ceremony & Awards is one of LITF's highlights — a chance for audiences, artists, volunteers and special guests to come together one last time to celebrate the outstanding work presented on the Astor stage.\nThroughout the evening, the LITF Awards will honour achievements in performance, directing, original work and visual presentation, culminating in the Outstanding Production, the Artistic Directors' Award and the People's Choice Award. \n\nCome celebrate the artists who have travelled from around the world to share their work with us - and be there as we discover who will take home the LITF 2026 awards.\n\n<style>\n\n@media screen and (max-width:728px) {\niframe{width:100%!important;}\n}\n</style>"
      }
    ],
