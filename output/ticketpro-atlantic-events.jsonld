  {
    "@id": "https://ticketpro.ca/event/1695801853",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-09-20T19:30:00-03:00"
      }
    ],
