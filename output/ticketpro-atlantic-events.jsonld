        "@id": "https://tproatlantic.ticketpro.ca/genid/abb551872ebbe5df"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/en/pages/1705388453"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/en/pages/1705388453"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "JesterFish Weekend Pass | Liverpool International Theatre Festival"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Make a weekend of the Liverpool International Theatre Festival! The JesterFish Weekend Pass gives you a concentrated international theatre experience from Friday evening, October 16 through Sunday, October 18.<br><br>\n\nYour pass includes five productions and special presentations from Switzerland, the Netherlands, Uganda, Wales and Italy/London: Break the Silence, Nest, The Pursuit, Bard to the Bone and The Extraordinary Life of a Rat Racer.<br><br>\n\nThe pass also includes two fascinating on-stage In Conversation sessions: on Saturday, join playwright and director Libby Broadbent for From 100 Conversations to the Stage; and on Sunday, meet Eslam Awad, a multi-award-winning Egyptian actor and director.<br><br>\n\nYou'll also have access to Saturday and Sunday Coffee Critiques and the Closing Ceremony & Awards - more opportunities to hear from the artists, adjudicator and Artistic Directors, and join the conversation about the work you've seen.<br><br>\n\n\nCome for the performances and stay for the conversations, connections, and international festival experience.\n\n<style>\n\n@media screen and (max-width:728px) {\niframe{width:100%!important;}\n}\n</style>"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
