    ],
    "http://schema.org/image": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/api/v1/resources/1671919919.jpeg?version=3"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/genid/8e4c57f03efb6e5d"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
