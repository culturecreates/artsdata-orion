    "http://schema.org/name": [
      {
        "@value": "Forgalhorn - Antigonish Jazz Fest"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "\n\n\n<p>Forgalhorn features some of the top jazz talent on PEI; Ken Fornetran on saxes, Maxwell Gallant drums, Devin Hornby on bass, and Ian Toms on guitar.</p>\n\n<p>Forgalhorn's creativity is focused on using effects and live loops to emphasize ambience, melody and groove. The quartet plays songs by Elliott Smith, Eddie Harris, Bob Dylan, Pharoah Sanders, John Coltrane, and much more.</p>\n\n\n<style>\n.location-page-temp {\n    display: block!important;\n}\n</style>"
      }
