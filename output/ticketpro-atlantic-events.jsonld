    "http://schema.org/name": [
      {
        "@value": "The Piano Men - Celebrating the music of Billy Joel and Elton"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>TIME WARP PROMOTIONS PRESENTS<br>\n\nGet ready for an ultimate concert experience that is out of this world!<br>\n\nTogether, Billy Joel and Elton John have sold over a billion records worldwide. Join us in a tribute to and celebration of two of the biggest musical superstars on the planet. This full band musical experience with musicians from Rock of Ages will feature vocalist, pianist extraordinaire and tribute artist Jeff Brewer, who has performed internationally to large, sold-out audiences everywhere!\n<br>\nThis will be a very interactive show, inviting YOU, THE AUDIENCE to sing along to hit after hit to musical anthems that have been the soundtrack to many of our lives!</p>\n\n<iframe width='560' height='315' src='https://www.youtube.com/embed/ww1YWdUq99M?si=b38xt3ofipS8r8Gz' title='YouTube video player' frameborder='0' allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share' referrerpolicy='strict-origin-when-cross-origin' allowfullscreen></iframe>\n\n<style>\n\n@media screen and (max-width:728px) {\niframe{width:100%!important;}\n}\n</style>"
      }
