    "http://schema.org/url": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/en/pages/1696980913"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Shanneyganock with Special Guests The Kitchen Criminals"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>For 30 years, <b>Shanneyganock</b> have proudly shared the songs, stories, and traditions of Newfoundland and Labrador with audiences around the world. Known for their authentic blend of traditional folk music and high-energy live performances, they've become one of Atlantic Canada's most beloved acts, earning a reputation for selling out theatres and leaving audiences on their feet.<br><br>They will be joined by very special guests, <b>The Kitchen Criminals.</b> Hailing from Pictou County, Nova Scotia, this Celtic rock band has been entertaining audiences since 2016 with a lively blend of original songs, traditional fiddle tunes, and Celtic favourites. Drawing inspiration from beloved East Coast acts like Great Big Sea, Rawlins Cross, and MacKeel, Kitchen Criminals deliver a performance full of spirit, musicianship, and Maritime charm.\n<br><br>\n<b>Show Information</b><br>\nThursday, October 1, 2026<br>\nDoors: 7:00 PM | Show: 7:30 PM<br>\nAll Ages Welcome</p>\n\n<iframe width='560' height='315' src='https://www.youtube.com/embed/WvvEuDOT98Y?si=a0jZAzOQzF6ZlR0M' title='YouTube video player' frameborder='0' allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share' referrerpolicy='strict-origin-when-cross-origin' allowfullscreen></iframe>\n\n<style>\n.location-page-temp {display: block!important;}\n@media screen and (max-width: 600px){iframe{width:100%;}}\n</style>\n\n"
      }
    ],
