    "http://schema.org/name": [
      {
        "@value": "Ashley MacIsaac"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Cape Breton's Ashley MacIsaac is one of Canada's most celebrated fiddlers, known for pushing traditional Celtic music into the worlds of rock and pop. A three-time JUNO Award winner, his double-platinum album Hi™ How Are You Today? helped launch an international career that has included performances at the Vancouver 2010 Winter Olympics and collaborations with The Chieftains, Philip Glass and The White Stripes. Catch Ashley MacIsaac at the Marigold Cultural Centre on November 21, 2026—doors open at 7 p.m., with showtime at 7:30 p.m. He is currently touring his new album, Traditional Masterpieces, available on vinyl through his website.</p><br>\n\n<style>\n@media screen and (max-width: 600px){iframe{width:100%;}}\n</style>"
      }
    ],
