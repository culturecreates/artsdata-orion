    "http://schema.org/offers": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/genid/ea64067db43bfdc2"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/en/pages/1704353616/performances/AST29IS26"
