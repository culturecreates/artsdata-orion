    "http://schema.org/url": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/en/pages/1700388307/performances/RJC12IS26"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "UNBSU Kick-Off Concert 2026"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Welcome Kardinal Offishall to our UNB campus for the UNBSU Kick-Off Concert! Supported by Migz music and Twin Valley DJ, Kardinal Offishal will help us kick off the new school year with an unforgettable night of live music, school spirit, and campus celebration! Open to the public for the very first time, the UNBSU Kick-Off Concert 2026 brings students and community members together with incredible performances, great energy, and the chance to connect with friends. Whether you're singing along, dancing with your classmates, or making your first memories at UNB, this is the event you won't want to miss. Let's start the year together—loud, proud, and ready for an amazing semester!</p>\n\n<style>\n.location-page-temp {display: block!important;}\n.titleTax {display: none !important;}\n</style>"
      }
    ],
