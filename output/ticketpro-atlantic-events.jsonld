    "http://schema.org/description": [
      {
        "@value": "\n    <style>\n        * {\n            box-sizing: border-box;\n            margin: 0;\n            padding: 0;\n        }\n\n        body {\n            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;\n            background-color: #f8f9fa;\n            color: #212529;\n            line-height: 1.5;\n            padding: 40px 20px;\n        }\n\n        .container {\n            max-width: 850px;\n            margin: 0 auto;\n            background: #ffffff;\n            border-radius: 12px;\n            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);\n            overflow: hidden;\n            padding: 40px;\n        }\n\n        /* Header */\n        header {\n            text-align: center;\n            border-bottom: 3px solid #c8102e;\n            padding-bottom: 24px;\n            margin-bottom: 32px;\n        }\n\n        header h1 {\n            color: #c8102e;\n            font-size: 32px;\n            font-weight: 800;\n            letter-spacing: 1px;\n            margin-bottom: 6px;\n        }\n\n        header h2 {\n            color: #495057;\n            font-size: 18px;\n            font-weight: 600;\n            letter-spacing: 0.5px;\n        }\n\n        /* Pools Section */\n        .pools-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 20px;\n            margin-bottom: 40px;\n        }\n\n        .pool-card {\n            border-radius: 8px;\n            overflow: hidden;\n            border: 1px solid #dee2e6;\n        }\n\n        .pool-header {\n            padding: 10px 16px;\n            font-weight: 700;\n            font-size: 16px;\n            text-align: center;\n            color: #ffffff;\n            letter-spacing: 0.5px;\n        }\n\n        .red-pool .pool-header {\n            background-color: #c8102e;\n        }\n\n        .black-pool .pool-header {\n            background-color: #212529;\n        }\n\n        .pool-list {\n            list-style: none;\n            background-color: #ffffff;\n        }\n\n        .pool-list li {\n            padding: 10px 16px;\n            border-bottom: 1px solid #f1f3f5;\n            font-weight: 600;\n            font-size: 15px;\n            color: #343a40;\n        }\n\n        .pool-list li:last-child {\n            border-bottom: none;\n        }\n\n        .pool-list li:nth-child(even) {\n            background-color: #f8f9fa;\n        }\n\n        /* Schedule Section */\n        .section-title {\n            color: #c8102e;\n            font-size: 18px;\n            font-weight: 700;\n            margin-bottom: 12px;\n            display: flex;\n            align-items: center;\n            gap: 8px;\n        }\n\n        .day-block {\n            margin-bottom: 36px;\n        }\n\n        table {\n            width: 100%;\n            border-collapse: collapse;\n            margin-bottom: 8px;\n            border-radius: 6px;\n            overflow: hidden;\n            border: 1px solid #dee2e6;\n        }\n\n        th, td {\n            padding: 12px 14px;\n            text-align: center;\n        }\n\n        th {\n            background-color: #343a40;\n            color: #ffffff;\n            font-size: 13px;\n            font-weight: 700;\n            text-transform: uppercase;\n            letter-spacing: 0.5px;\n        }\n\n        th:first-child, td:first-child {\n            text-align: left;\n            width: 20%;\n            font-weight: 700;\n        }\n\n        td {\n            font-size: 14.5px;\n            border-bottom: 1px solid #e9ecef;\n        }\n\n        tbody tr:nth-child(even) {\n            background-color: #f8f9fa;\n        }\n\n        .subtext {\n            display: block;\n            font-size: 12px;\n            color: #6c757d;\n            font-style: italic;\n            margin-top: 2px;\n        }\n\n        .day-note {\n            font-size: 13px;\n            color: #6c757d;\n            font-style: italic;\n            margin-top: 6px;\n        }\n\n        /* General Notes */\n        .general-notes {\n            background-color: #f8f9fa;\n            border-left: 4px solid #c8102e;\n            padding: 18px 20px;\n            border-radius: 0 8px 8px 0;\n            margin-top: 20px;\n        }\n\n        .general-notes h3 {\n            font-size: 15px;\n            color: #212529;\n            margin-bottom: 8px;\n        }\n\n        .general-notes ul {\n            padding-left: 20px;\n            color: #495057;\n            font-size: 13.5px;\n        }\n\n        .general-notes li {\n            margin-bottom: 6px;\n        }\n\n        .general-notes li:last-child {\n            margin-bottom: 0;\n        }\n\n        @media (max-width: 600px) {\n            .pools-grid {\n                grid-template-columns: 1fr;\n            }\n\n            body {\n                padding: 12px;\n            }\n\n            .container {\n                padding: 20px 14px;\n            }\n\n            th, td {\n                padding: 8px 6px;\n                font-size: 13px;\n            }\n        }\n    </style>\n</head>\n<body>\n\n<div class='container'>\n    <header>\n        <h1>TOURNAMENT SCHEDULE</h1>\n      \n    </header>\n    <!-- NOTES -->\n    <div class='general-notes'>\n        <h3>General Tournament Notes:</h3>\n        <ul>\n            <li>UNB will play their placement match in Performance Gym.</li>\n            <li>Toronto & Manitoba will play Sunday at 11:00am or 1:00pm (due to travel). Sunday's schedule (order of games) is subject to change.</li>\n        </ul>\n    </div>\n    <!-- POOLS -->\n    <div class='pools-grid'>\n        <div class='pool-card red-pool'>\n            <div class='pool-header'>RED POOL</div>\n            <ul class='pool-list'>\n                <li>1. MONCTON</li>\n                <li>2. TORONTO</li>\n                <li>3. DALHOUSIE</li>\n                <li>4. BROCK</li>\n            </ul>\n        </div>\n        <div class='pool-card black-pool'>\n            <div class='pool-header'>BLACK POOL</div>\n            <ul class='pool-list'>\n                <li>5. ACADIA</li>\n                <li>6. WINDSOR</li>\n                <li>7. UNB</li>\n                <li>8. MANITOBA</li>\n            </ul>\n        </div>\n    </div>\n\n    <!-- FRIDAY -->\n    <div class='day-block'>\n        <div class='section-title'>FRIDAY, SEPTEMBER 25th</div>\n        <table>\n            <thead>\n                <tr>\n                    <th>Time</th>\n                    <th>RJCC Perf. Gym</th>\n                    <th>RJCC Rec Gym</th>\n                </tr>\n            </thead>\n            <tbody>\n                <tr>\n                    <td>11:00 am</td>\n                    <td>3 vs. 4</td>\n                    <td>N/A</td>\n                </tr>\n                <tr>\n                    <td>1:00 pm</td>\n                    <td>1 vs. 2</td>\n                    <td>N/A</td>\n                </tr>\n                <tr>\n                    <td>3:00 pm</td>\n                    <td>5 vs. 7</td>\n                    <td>6 vs. 8</td>\n                </tr>\n                <tr>\n                    <td>5:00 pm</td>\n                    <td>2 vs. 4</td>\n                    <td>1 vs. 3</td>\n                </tr>\n                <tr>\n                    <td>7:00 pm</td>\n                    <td>7 vs. 8</td>\n                    <td>5 vs. 6</td>\n                </tr>\n            </tbody>\n        </table>\n    </div>\n\n    <!-- SATURDAY -->\n    <div class='day-block'>\n        <div class='section-title'>SATURDAY, SEPTEMBER 26th</div>\n        <table>\n            <thead>\n                <tr>\n                    <th>Time</th>\n                    <th>RJCC Perf. Gym</th>\n                    <th>RJCC Rec Gym</th>\n                </tr>\n            </thead>\n            <tbody>\n                <tr>\n                    <td>11:00 am</td>\n                    <td>1 vs. 4</td>\n                    <td>2 vs. 3</td>\n                </tr>\n                <tr>\n                    <td>1:00 pm</td>\n                    <td>6 vs. 7</td>\n                    <td>5 vs. 8</td>\n                </tr>\n                <tr>\n                    <td>5:00 pm</td>\n                    <td>\n                        1st A vs. 2nd B\n                        <span class='subtext'>Championship Semi-Final</span>\n                    </td>\n                    <td>\n                        3rd A vs. 4th B\n                        <span class='subtext'>Consolation Semi-Final</span>\n                    </td>\n                </tr>\n                <tr>\n                    <td>7:00 pm</td>\n                    <td>\n                        1st B vs. 2nd A\n                        <span class='subtext'>Championship Semi-Final</span>\n                    </td>\n                    <td>\n                        3rd B vs. 4th A\n                        <span class='subtext'>Consolation Semi-Final</span>\n                    </td>\n                </tr>\n            </tbody>\n        </table>\n        <div class='day-note'><strong>Note:</strong> UNB will play their semi-final (championship or consolation) in Performance Gym.</div>\n    </div>\n\n    <!-- SUNDAY -->\n    <div class='day-block'>\n        <div class='section-title'>SUNDAY, SEPTEMBER 27th</div>\n        <table>\n            <thead>\n                <tr>\n                    <th>Time</th>\n                    <th>RJCC Perf. Gym</th>\n                    <th>RJCC Rec Gym</th>\n                </tr>\n            </thead>\n            <tbody>\n                <tr>\n                    <td>11:00 am</td>\n                    <td>5th-6th Place Match</td>\n                    <td>7th-8th Place Match</td>\n                </tr>\n                <tr>\n                    <td>1:00 pm</td>\n                    <td>3rd-4th Place Match</td>\n                    <td>N/A</td>\n                </tr>\n                <tr>\n                    <td>3:00 pm</td>\n                    <td>1st-2nd Place Match</td>\n                    <td>N/A</td>\n                </tr>\n            </tbody>\n        </table>\n    </div>\n\n\n</div>\n<style>\n.location-page-temp {display: block!important;}\n.titleTax {display: none !important;}\n\n.container{box-shadow: none!important;}\n</style>"
      },
