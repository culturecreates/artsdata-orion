    "http://schema.org/name": [
      {
        "@value": "Pixel.wav"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Pixel.wav loves video game music! The fresh and fun instrumental ensemble brings gaming music hidden gems and fan favorites to life for audiences of gaming and/or music afi cionados.</p><br>\n \n<p>The New Brunswick-based all-star band has gathered a motley party of performers whose gaming backgrounds overlap more than their musical ones. Driven by musical excellence, fan engagement and a proud strain of nerdiness, Pixel.wav stands out for its expert blend of orchestral sounds, modern energy and tastefully curated repertoire. Audiences can expect immersive musical journeys that highlight the narrative power and cultural impact of this rich and evolving musical tradition.</p><br>\n\n<style>\n@media screen and (max-width: 600px){iframe{width:100%;}}\n</style>"
      }
    ],
