    ],
    "http://schema.org/url": [
      {
        "@id": "https://tproatlantic.ticketpro.ca/en/pages/1702893854/performances/MCC02KS26"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Alan Cross presents UNCHARTED: LIVE!"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Uncharted: Crime & Mayhem In The Music Industry is the award-winning podcast that looks at the intersection of true crime and the world of music. Hosted by renowned music journalist Alan Cross, this podcast chronicles all manners of bad behaviour. From murder and kidnapping, to the mob's manipulation of the music industry, to all those shady backstage dealings happening behind the scenes, Uncharted leaves no stone unturned!</p><br>\n\n<p>Now, Alan Cross is bringing Uncharted to the big stage for an evening of previously untold tales, deep dives and rabbit holes, and live Q&A. Once you experience Uncharted: Crime & Mayhem In The Music Industry, you'll never listen to music the same again. It really is sex, drugs, rock n' roll, and a whole lot of true crime!</p><br>\n\n\n<style>\n@media screen and (max-width: 600px){iframe{width:100%;}}\n</style>"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
  {
    "@id": "https://tproatlantic.ticketpro.ca/genid/08900f3d16757df1",
    "@type": [
      "http://schema.org/Offer"
    ],
