    "http://schema.org/name": [
      {
        "@value": "Nest - Hoosh Theater (Netherlands) - Liverpool International Theatre Festival"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Synopsis: Nest is a punk-like performance about breaking away from an old home and trying to find a new one. A woman is stuck in her nest, holding tightly to the way things are. Six people try different ways to help her move forward - inviting her to dance, seducing her with songs, getting angry, and even breaking down the nest. But ultimately, the decision to leave must be her own.\n\n<style>\n\n@media screen and (max-width:728px) {\niframe{width:100%!important;}\n}\n</style>"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
