  {
    "@id": "https://www.culture3r.com/evenements/animation-givree-atelier-familial-du-temps-des-fetes/#2026-12-05T1000",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Laissez-vous porter par la magie du temps des fêtes grâce à un atelier de cinéma d’animation où lutins, flocons et créatures fantastiques prennent vie image par image!\n\nEn famille, imaginez une courte histoire inspirée de l’hiver et des célébrations de fin d’année, puis réalisez votre propre film d’animation à l’aide d’une tablette électronique.\n\nComme dans un véritable studio de cinéma, petits et grands sont invités à collaborer, inventer et créer ensemble dans une ambiance festive et chaleureuse. Une activité parfaite pour éveiller l’imaginaire et repartir avec un souvenir animé du temps des fêtes!\n\n7 ans et + (les enfants doivent être accompagnés d’un adulte pour cette activité)\n\nPhoto : Étienne Boisvert"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.culture3r.com/app/uploads/2026/10/2026_AV_EPJ_ACT_Silenceontoure_photoprint_crEtienneBoisvert-600x600.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://www.culture3r.com/lieux/#espace-pauline-julien"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "ANIMATION GIVRÉE – ATELIER FAMILIAL DU TEMPS DES FÊTES"
      }
    ],
