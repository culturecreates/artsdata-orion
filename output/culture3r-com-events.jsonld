    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/Chanson"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dans ce spectacle, BEYRIES vous invite à entrer dans son univers intime en revisitant les chansons de ses albums. En français et en anglais, elle interprète ses pièces les plus marquantes. Récompensée du Félix de l’Album de l’année – Adulte contemporain 2024 pour Du feu dans les lilas, BEYRIES poursuit son chemin avec authenticité et émotion. Cultivant l’intimité avec son public, Beyries crée à chaque représentation une atmosphère unique, propice à la rencontre et à l’écoute."
      }
    ],
