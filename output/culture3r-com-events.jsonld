  {
    "@id": "https://www.culture3r.com/evenements/piaf-aznavour-les-grandes-chansons/#2027-11-20T1930",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/Chanson"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Retrouvez l’âme d’un Paris mythique, où les refrains deviennent des légendes et où chaque chanson raconte une histoire.\n\nPorté par les voix de Mia Tinayre et Sam Champagne, et accompagnés sur scène par un groupe de musiciens, Piaf & Aznavour : Les grandes chansons vous convie à un voyage musical au cœur du Paris d’une autre époque, entre l’effervescence des cabarets, les amours passionnées et les nuits empreintes de poésie. De la ferveur bouleversante d’Édith Piaf à l’élégance intemporelle de Charles Aznavour, redécouvrez les chansons qui ont marqué des générations et fait rayonner la chanson française à travers le monde."
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
