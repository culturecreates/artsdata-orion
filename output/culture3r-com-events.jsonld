  {
    "@id": "https://www.culture3r.com/evenements/victoria-charlton-soiree-paranormale/#2027-03-24T2000",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/VarietyPerformance"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Victoria Charlton débarque pour une soirée paranormale unique!\n\nPréparez-vous à plonger dans une ambiance insolite, hors du commun et pleine de rebondissements, où témoignages étranges, phénomènes inexpliqués et frissons seront au rendez-vous.\n\nVictoria sera accompagnée d’un.e invité.e surprise pour explorer des récits troublants, surprenants et impossibles à oublier.\n\nUne soirée immersive entre rires, mystère et paranormal.\n\nOver and out."
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
