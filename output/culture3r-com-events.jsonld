      {
        "@id": "https://www.culture3r.com/lieux/#salle-louis-philippe-poisson"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "THÉÂTRE DES NOUVEAUX COMPAGNONS – LE FAUCON , DE MARIE LABERGE"
      }
    ],
