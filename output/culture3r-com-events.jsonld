        "@id": "https://www.culture3r.com/app/uploads/2026/09/TNC_manueldelaviesauvage-600x600.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://www.culture3r.com/lieux/#anais-allard-rousseau"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "THÉÂTRE DES NOUVEAUX COMPAGNONS – MANUEL DE LA VIE SAUVAGE, DE JEAN-PHILIPPE BARIL GUÉRARD"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://www.culture3r.com/evenements/theatre-des-nouveaux-compagnons-manuel-de-la-vie-sauvage-de-jean_philippe-baril-guerard/#2027-04-22T1930-offer"
