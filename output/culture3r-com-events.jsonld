  {
    "@id": "https://www.culture3r.com/evenements/alphonse-bisaillon-jacker-un-pickup-en-poesie/#2026-12-18T2000",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/Chanson"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Une brèche dans la trajectoire habituelle d’Alphonse Bisaillon. Présenté cinq soirs seulement, ce spectacle spécial s’échappe de la tournée pour ouvrir un espace plus risqué et indiscipliné. Autour de l’album t.o.m. ou la trajectoire des perséides, Alphonse et ses invité·e·s brouillent les pistes : la pop flirte avec l’avant-garde et la poésie quitte la page pour hurler ses droits. Écoutez..! Le bruit des moteurs enfle dans la nuit fertile… Demain le jour se lèvera sur des pickups transformés en cuves à vie, en bacs à fleurs terribles!!!"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
