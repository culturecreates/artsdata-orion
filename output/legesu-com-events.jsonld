  {
    "@id": "https://legesu.com/evenement/francine-ruel-2/#event",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/image": [
      {
        "@id": "https://legesu.com/evenement/francine-ruel-2/#primaryimage"
      }
    ],
