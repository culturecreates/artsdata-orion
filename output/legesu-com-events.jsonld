      {
        "@id": "https://legesu.com/evenement/francine-ruel-2/"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-18T20:00:00-05:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-18T21:30:00-05:00"
      }
    ],
    "http://schema.org/mainEntityOfPage": [
      {
        "@id": "https://legesu.com/evenement/francine-ruel-2/"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://legesu.com/evenement/francine-ruel-2/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "FRANCINE RUEL"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Comme un livre d’images qu’on feuillette, La Colombe, le pigeon et moi raconte, avec tendresse et humour, l’histoire d’une petite fille curieuse et d’une femme en quête de réponses. Franchon, 7 ans, tient la main de Francine, 77 ans. Ensemble, elles partent à la recherche du père envolé et de la mère au grand cœur — cette Colombe, courageuse et un peu folle. Sur un air de tango, entre rires et émotions, s’entrelacent souvenirs, secrets et passion. Un récit lumineux, de 7 à 77 ans, inspiré des récits Ma mère est un flamant rose et Mon père est un pigeon voyageur. Une façon de bercer son enfance encore un peu… et de lui dire adieu tout en souriant. Durée du spectacle : 90 minutes sans entracte"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://legesu.com/genid/"
      }
    ]
  },
