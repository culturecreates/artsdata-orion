    ],
    "http://schema.org/name": [
      {
        "@value": "The 25th Annual Putnam County Spelling Bee"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@value": "en-CA"
      }
    ],
    "http://schema.org/abstract": [
      {
        "@value": "The Tony Award–winning musical The 25th Annual Putnam County Spelling Bee is a hilarious celebration of words, competition, and growing up. In the high-stakes world of a spelling bee, six awkward adolescent champions face off as emotions run from A to Z. With each word spelled, the pressure rises and more than a trophy is on the line. Packed with clever wordplay, infectious songs, and laugh-out-loud humour, this fast-paced musical races to the finish with heart and charm. Six competitors enter but only one can be crowned champion of the bee. "
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "The Tony Award–winning musical The 25th Annual Putnam County Spelling Bee is a hilarious celebration of words, competition, and growing up. In the high-stakes world of a spelling bee, six awkward adolescent champions face off as emotions run from A to Z. With each word spelled, the pressure rises and more than a trophy is on the line. Packed with clever wordplay, infectious songs, and laugh-out-loud humour, this fast-paced musical races to the finish with heart and charm. Six competitors enter but only one can be crowned champion of the bee. "
      }
    ]
  },
