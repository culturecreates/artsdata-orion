    ],
    "http://schema.org/name": [
      {
        "@value": "ANNIE"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Set in 1930s New York City, this beloved musical follows an endlessly optimistic orphan determined to find her family and her place in the world. Escaping a grim orphanage run by the formidable Miss Hannigan, Annie finds unexpected adventure, loyal friends, and a new home with the larger-than-life billionaire Mr. Warbucks, his warm-hearted secretary, and a scrappy dog named Sandy. Brimming with heart, humour, and iconic songs including “Tomorrow” and “It’s The Hard Knock Life,” this timeless story celebrates hope, resilience, and the power of chosen family.\nAnnie is presented through special arrangement with the Music Theatre International (MTI). All authorized performance materials are also supplied by MTI. www.mtishows.com\n"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@value": "EventScheduled"
      }
    ],
    "http://schema.org/typicalAgeRange": [
      {
        "@value": "6+"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@value": "en-CA"
      }
    ],
