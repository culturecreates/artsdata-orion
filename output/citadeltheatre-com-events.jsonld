      {
        "@value": "Chula"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@value": "en-CA"
      }
    ],
    "http://schema.org/abstract": [
      {
        "@value": "A bold music-infused solo performance in both Spanish and English, Chula is a story of migration, identity and belonging, that moves through 1980s Guatemala and 1990s Edmonton, bringing a vibrant cast of characters with humour, heart, and ‘90s karaoke hits! "
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "A bold, music-infused solo performance exploring identity, migration, and belonging. Beginning backstage in 2008 as Aria prepares to premiere Canada’s first mariachi opera, the story journeys through 1980s Guatemala and 1990s Edmonton, tracing a life shaped by survival, family, and the pressures of assimilation. Performed in English and Spanish, Chula brings to life a vibrant cast of characters with humour, heart, and ‘90s karaoke hits! "
      }
    ]
  },
