      }
    ],
    "http://schema.org/mainEntity": [
      {
        "@id": "https://citadeltheatre.com/productions/the-great-gatsby-26/#Production"
      }
    ],
    "http://schema.org/primaryImageOfPage": [
      {
        "@id": "https://citadeltheatre.com/genid/1785b2da3d71e6b3"
      }
    ],
    "http://schema.org/mainContentOfPage": [
      {
        "@id": "https://citadeltheatre.com/genid/ebde5fc091a68580"
      }
    ],
    "http://schema.org/significantLink": [
      {
        "@id": "http://secure.citadeltheatre.com/overview/10295?premove=y&promo=8371"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "The Great Gatsby"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@value": "en-CA"
      }
    ],
    "http://schema.org/abstract": [
      {
        "@value": "Enter the glittering world of the Jazz Age, where Jay Gatsby’s parties are legendary and their host remains mysterious. Driven by his love for Daisy, Gatsby risks everything to reclaim a dream as illusion and reality collide on stage. "
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Step into the glittering excess of the Jazz Age, where champagne flows, flapper dresses shimmer, and music drifts through the night until dawn. At the center of it all stands the opulent mansion of mysterious millionaire Jay Gatsby, whose legendary parties draw eccentric New Yorkers from every corner of the city. Yet for all the spectacle, Gatsby himself remains an enigma. Driven to reunite with his long-lost love Daisy, Gatsby risks everything to reclaim a dream that may no longer exist. Illusion and reality collide in this tragic stage adaptation of F. Scott Fitzgerald’s novel, re-envisioned by Canadian playwright Erin Shields and brought to life with a live jazz band. &nbsp; "
      }
    ]
  },
