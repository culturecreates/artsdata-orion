      {
        "@id": "https://www.crowstheatre.com/uploads/2026.27%20Season/05%20ALL%27S%20WELL/ALW_2400x1350_centre.jpg#ImageObject"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://www.crowstheatre.com/about/our-venues#guloien-theatre"
      }
