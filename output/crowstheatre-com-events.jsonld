  {
    "@id": "https://www.crowstheatre.com/shows-events/dark-day-cabarets#202612072030",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/MusicPerformance"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "After a year on hiatus, Icarus' Dark Day Cabaret Series makes its return at Crow's Cabaret! Each night features a new lineup of five professional Music Theatre performers from around Toronto, complete with a wicked three-piece jazz band. Dark Days are a rowdy celebration of the performers who have to practise day in and out for that one gig, and played to sold out audiences for two years across Toronto before finding their home at Crow's.\n\nEach month has a brand-new lineup of singers, so no two cabarets are the same. Come to laugh, yell, and hear some incredible music!\n\n▶︎ Watch the video trailer: https://www.youtube.com/shorts/6BLxh1y2m2U"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
