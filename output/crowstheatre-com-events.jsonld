  {
    "@id": "https://www.crowstheatre.com/shows-events/design-for-living#202705271900",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/TheatrePerformance"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "We’re not normal—and we don’t want to be.\n\nStylish, sharp, and unapologetically modern, Design for Living follows three artists in a love triangle that defies convention. Ricocheting between Paris, London, and New York, they refuse to choose respectability over desire.\n\nThis glittering comedy is as sharp as it is subversive: love without permission, happiness on your own terms, and the thrill of living outside the margins."
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.crowstheatre.com/uploads/2026.27%20Season/12%20DESIGN%20FOR%20LIVING/DFL_2400x1350_centre.jpg#ImageObject"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://www.crowstheatre.com/about/our-venues#young-centre-for-the-performing-arts"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Design For Living"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://www.crowstheatre.com/#organization"
      }
    ],
