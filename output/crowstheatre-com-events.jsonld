  {
    "@id": "https://www.crowstheatre.com/shows-events/moneka-arabic-jazz#202611282030",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/MusicPerformance"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Reflecting on his personal journey as an artist, actor, and activist who came from Baghdad to Toronto, Moneka, alongside his stellar global ensemble, invites listeners to a jubilant celebration of life. His music\nexplores love in all its forms while evoking a deep sense of longing for one’s homeland, all through\noriginal compositions and timeless Middle Eastern classics.\n\nAhmed’s sophomore, Juno-nominated album Kanzafula is the first Canadian-Iraqi record to be\nnominated for the prestigious Juno Award. In addition to this achievement, he also received the Dora Award\nand the Stingray Rising Star Award. Ahmed is collaborating with Jesse LaVercombe and The Tragically Hip on\nthe 2026 production of It’s a Good Life If You Don’t Weaken, a musical based on the band’s iconic\nCanadian catalogue, alongside Michael Rubinoff, the producer of Come From Away."
      }
    ],
    "http://schema.org/eventAttendanceMode": [
