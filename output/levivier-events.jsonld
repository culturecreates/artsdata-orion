      }
    ],
    "https://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Geneviève Ackerman - Le poète assassiné | Le Vivier"
      }
    ],
    "https://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Le poète assassiné est une pièce de théâtre musical librement adaptée du livre éponyme de Guillaume Apollinaire, dans laquelle deux comédiennes sont traversées d’une multitude de personnages, tout à la fois grotesques, tragiques, rêveurs et ambigus. Pantomime, théâtre d’objet, cabaret à chansons, marionnettes, la scène est prise d’assaut par une folie poétique racontant la naissance, la vie et la mort du poète, en différents tableaux vivants."
      }
    ],
    "https://ogp.me/ns#image": [
      {
