    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Productions SuperMusique - Jeudi sonore #5"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Cette série de concerts valorise l’approche collective de la création. Une écriture de l’ensemble des instrumentistes qui prend forme dans un cadre d’improvisation en temps réel et où s’élaborent des textures, des formes et des matières sonores en mouvement."
      }
    ],
