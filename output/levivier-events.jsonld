        "@id": "https://levivier.ca/genid/a29b2380fa4b592b"
      },
      {
        "@id": "https://levivier.ca/genid/e17b809501767f52"
      }
    ],
    "http://schema.org/mainEntityOfPage": [
      {
        "@id": "https://levivier.ca/genid/ab6c16c80b995392"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Journées de la culture: Moulin à musique - L'Usine à sons "
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "L’Usine à sons transporte les tout-petits dans une usine colorée et un brin loufoque, où chaque objet, chaque geste et même le corps se transforme en instrument de musique.&nbsp;Dans son atelier, un personnage clownesque s’affaire à remplir des « commandes sonores », tout en vivant son quotidien plein de bruits et de surprises! Au fil de ses expériences, les rythmes s’assemblent, se superposent et se transforment grâce à la magie de la loop. Instruments, objets du quotidien et gestes inattendus donnent naissance à des mélodies, des ambiances et des paysages sonores uniques. Le spectacle invite petits et grands à tendre l’oreille, à explorer et à s’émerveiller devant tout ce qui peut résonner autour d’eux."
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-09-26T18:00:00-04:00"
      }
    ]
  },
