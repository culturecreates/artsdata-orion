    ],
    "http://schema.org/familyName": [
      {
        "@language": "fr",
        "@value": "Vivier"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Diplômé du Conservatoire de Montréal en 1971, où il fut un élève de Gilles Tremblay, Claude Vivier obtiendra des bourses du Conseil des arts du Canada pour se perfectionner en Europe où il travaillera, entre autres, avec Karlheinz Stockhausen et Paul Méfano. Son oeuvre reste profondément marquée par ses nombreux voyages à l’étranger. L’aura de mystère enveloppant la personnalité même du compositeur ainsi que la qualité extrême de sa production musicale assure à Vivier à la fois une fascination populaire toujours croissante et une place de premier plan dans..."
      }
    ]
  },
