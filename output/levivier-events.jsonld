        "@value": "Mathilde Côté: Suzanne Guité - Théâtre Musical Contemporain"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Entre théâtre et musique, le projet Suzanne Guité porté par la compositrice gaspésienne Mathilde Côté, met en lumière la vie, l’œuvre et la fougue de cette créatrice visionnaire.&nbsp;"
      }
    ]
