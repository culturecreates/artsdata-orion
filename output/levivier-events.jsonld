    ],
    "http://schema.org/familyName": [
      {
        "@language": "fr",
        "@value": "Tremblay-Noël"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Percussionniste, multi-instrumentiste et adepte de musique nouvelle sous toutes ses formes, Olivier Tremblay-Noël est un musicien actif sur la scène québécoise. Sa personnalité et son jeu sont teintés par les multiples courants auxquels il a pu se dédier au cours de sa carrière et de sa formation, allant de la musique orchestrale, contemporaine, Hindustani, au jazz et au rock.\r\n\r\nOlivier détient un Baccalauréat du Conservatoire de Musique de Rimouski ainsi que d'une Maîtrise de l'École de musique Schulich de l’Université McGill. En dehors de ses activités avec SIXTRUM, il..."
      }
    ]
  },
