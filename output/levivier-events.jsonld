    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Ji Eun Moon"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "fr",
        "@value": "Ji Eun"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "fr",
        "@value": "Moon"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Ji Eun Moon est compositrice, pianiste et professeure de musique professionnelle. Ses œuvres musicales s'inspirent des problèmes, des luttes et des conflits de la réalité et du monde. Elle cherche à exprimer les conflits intérieurs et les phénomènes sociaux à travers ses compositions et ses projets musicaux. Ses œuvres ont été jouées dans le monde entier : Corée du Sud (Séoul Arts Center), Australie (ABC Hall), Italie (Milan), Slovénie, États-Unis et Mongolie.&nbsp;"
      }
    ]
  },
