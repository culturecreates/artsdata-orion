  {
    "@id": "https://levivier.ca/fr/artistes/membres/organismes/bradyworks-instruments-happiness",
    "https://ogp.me/ns#site_name": [
      {
        "@language": "fr",
        "@value": "Le Vivier"
      }
    ],
    "https://ogp.me/ns#type": [
