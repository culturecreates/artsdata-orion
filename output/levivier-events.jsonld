    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "John Oliver"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "fr",
        "@value": "John"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "fr",
        "@value": "Oliver"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "John Oliver a étudié la composition avec John Adams au San Francisco Conservatory of Music (Californie, ÉU), avec Stephen Chatman à UBC (baccalauréat, 1982), avec John Rea et Bruce Mather à l’université McGill (Doctorat, 1993), et, en privé, avec Phillipe Boesmans (Bruxelles, Belgique). Sa musique a été interprétée en Amérique du Nord, en Europe et au Mexique. John Oliver a composé deux opéras qui utilisent les instruments traditionels et électroniques. Il s’est méritée plusieurs prix dont le Grand Prix au 8e Concours national des jeunes compositeurs de Radio-Canada..."
      }
    ]
  },
  {
    "@id": "https://levivier.ca/genid/a699604525e8ff4e",
    "@type": [
      "http://schema.org/PerformingGroup"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://squidinchains.ca/"
      }
    ],
    "http://schema.org/sameAs": [
      {
        "@id": "https://squidinchains.ca/"
      },
      {
        "@id": "https://www.facebook.com/squidinchains"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://squidinchains.ca/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Squid in Chains"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Squid in Chains est un groupe de Vancouver composé de François Houle (clarinette bassette et électronique), Douglas Schmidt (bandonéon) et John Oliver (synthétiseurs, échantillonneurs et traitement sonore). Squid in Chains puise dans des décennies de pratique en composition et en musique improvisée pour entraîner le public dans un voyage au cœur de la psyché contemporaine et de l’esprit de notre époque. Sa signature sonore singulière naît de l’alliance entre une écoute attentive et une imagination inventive, enrichie par différentes couches sonores et des instruments transformateurs et génératifs."
      }
    ]
  },
  {
    "@id": "https://levivier.ca/genid/d3edc961bc832d2f",
    "@type": [
      "http://schema.org/Person"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/fr/artistes/membres/individus/raphael-foisy-couture"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/artistes/membres/individus/raphael-foisy-couture"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Raphaël Foisy-Couture"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "fr",
        "@value": "Raphaël"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "fr",
        "@value": "Foisy-Couture"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Originaire de Tiohtià:ke/Moonyang/Montréal, Raphaël Foisy-Couture est musicien improvisateur et organisateur communautaire actif dans le milieu des musiques expérimentales, improvisées et créatives depuis plus d’une décennie. En tant qu’ancien membre du collectif La Passe et coorganisateur des séries Mardis Spaghetti (Depuis 2021) et Mardis Tous Croches (2014-2016), il a participé à l’organisation de centaines de concerts et à la coordinations de multiples tournées pour des musicien.ne.s de partout à travers monde. À travers son exploration de différents instruments, notamment la (contre)basse, la guitare, la batterie, le piano et différents dispositifs électroniques plus ou moins fonctionnels, il a publié des albums sur les labels Notice, HAVN, Rara Avis, Cuchabata et Arachnidiscs. Il est également le fondateur de l’étiquette Small Scale Music. Il est directeur général du Réseau Canadien pour les Musiques Nouvelles (RCMN) depuis février 2024."
      }
    ]
  },
  {
    "@id": "https://levivier.ca/genid/a17c23e9c0641a49",
    "@type": [
      "http://schema.org/Person"
    ],
    "http://schema.org/url": [
