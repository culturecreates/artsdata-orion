    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/artistes/adrianne-munden-dixon"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Adrianne Munden-Dixon"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "fr",
        "@value": "Adrianne"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "fr",
        "@value": "Munden-Dixon"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Adrianne Munden-Dixon est une violoniste, improvisatrice et compositrice connue pour sa \"facilité technique changeante\" (I Care If You Listen). Sa musique explore souvent l’interaction entre le timbre, la texture et l'énergie. Elle s'est produite en solo à travers l'Amérique du Nord et en Europe et a présenté ses compositions au cours d'été de Darmstadt et à l'université de Géorgie. Elle est membre fondateur de Desdemona et a récemment travaillé avec le JACK Quartet, l'Ensemble SuperMusique, Cassie Wieland, Leo Chang, Raphaël Foisy et le cinéaste-pianiste XUAN. Originaire de Savannah, en Géorgie, elle réside actuellement à Montréal et à New York, où elle est active sur les scènes expérimentales."
      }
    ],
    "@type": [
      "http://schema.org/Person"
    ]
  },
