      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Judith Fliedl is a violinist based in Vienna and is regarded as one of the most versatile Austrian violinists of her generation. Her artistic focus lies in the close interrelation of solo performance and chamber music, an exceptional breadth of repertoire—from classical literature to contemporary music—and artistic research.A multiple prizewinner of national and international competitions, she has established herself in recent years particularly in the field of contemporary music, both as a soloist and in a wide range of ensemble constellations."
      }
    ]
  },
