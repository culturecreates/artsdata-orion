    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Le Moulin à Musique"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le Moulin à Musique favorise la rencontre des enfants avec la musique depuis 1980. Sous la direction artistique de Barah Héon-Morissette, les créations de l'organisme allient la musique avec d’autres formes d’art, dans une approche collaborative et interdisciplinaire.\r\n\r\nDans la poursuite de sa mission, Le Moulin à Musique s’implique socialement et rejoint les jeunes partout où ils se trouvent. À travers ses spectacles, ateliers et médiations culturelles, il ouvre les horizons des enfants et offre aux jeunes oreilles une nouvelle manière de percevoir la musique.\r\n"
      }
    ]
  },
  {
    "@id": "https://levivier.ca/genid/72f5b4f08cefd107",
    "@type": [
      "http://schema.org/Person"
    ],
