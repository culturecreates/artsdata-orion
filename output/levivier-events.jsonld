  {
    "@id": "https://levivier.ca/genid/c53168ec0cf6757a",
    "@type": [
      "http://schema.org/Person"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/fr/artistes/olivier-st-pierre"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/artistes/olivier-st-pierre"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Olivier St-Pierre"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "fr",
        "@value": "Olivier"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "fr",
        "@value": "St-Pierre"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Olivier St-Pierre est un compositeur, pianiste et organiste montréalais spécialisé en musique contemporaine. Actif comme pianiste depuis l’enfance, Olivier entreprend d’abord des études de philosophie, avant de retourner à la musique et de compléter des concours en composition instrumentale et en analyse au Conservatoire de musique de Montréal, sous la direction de Nicolas Gilbert et Jimmie LeBlanc. Depuis 2019, il est organiste titulaire du Sanctuaire-du-Saint-Sacrement, à Montréal, où il présente régulièrement des programmes dédiés au répertoire organistique des XXe et..."
      }
    ]
  },
  {
    "@id": "https://levivier.ca/genid/f7b53a2b670aba95",
    "@type": [
      "http://schema.org/Person"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/fr/artistes/louis-michel-tougas"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/artistes/louis-michel-tougas"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Louis-Michel Tougas"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "fr",
        "@value": "Louis-Michel "
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "fr",
        "@value": "Tougas "
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Louis-Michel Tougas est un compositeur et batteur basé à Montréal. Il a obtenu un diplôme de premier cycle en composition au Conservatoire de musique de Montréal, puis une bourse de la Fondation du Baden-Württemberg lui a permis de poursuivre des études de maîtrise en composition et en informatique musicale à la Hochschule für Musik de Stuttgart, en Allemagne. Il étudie ensuite l’enregistrement du son à l’Université McGill, puis obtient un diplôme en analyse musicale au Conservatoire de musique de Montréal. Il poursuit présentement des études doctorales en composition..."
      }
    ]
  },
