      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Quatuor Mémoire"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le Quatuor Mémoire est un quatuor à cordes montréalais dédié à la musique contemporaine, formé des musiciennes Bailey Wantuch, Meggie Lacombe, Audréanne Filion et Marilou Lepage."
      }
    ]
  },
  {
    "@id": "https://levivier.ca/genid/98170f0708748554",
    "@type": [
      "http://schema.org/Person"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://alexispaul.com/"
      }
    ],
    "http://schema.org/sameAs": [
      {
        "@id": "https://alexispaul.com/"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/artistes/alexis-paul"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Alexis Paul"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "fr",
        "@value": "Alexis"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "fr",
        "@value": "Paul"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Alexis Paul mène une aventure nomade et poétique autour d’un orgue de barbarie revisité. Ici, l’orgue des rues passe au chevet du monde, à l’épreuve de la création, se fait tribune et passeur de culture plongeant dans l’infini des formes et des possibles. En mêlant facture d’origine, détournements et nouveaux modes de jeu, ses projets transversaux prennent des formes variées et convoquent aussi bien le grand récit de l’oralité que celui des musiques écrites ou des traditions textiles."
      }
    ]
  },
  {
    "@id": "https://levivier.ca/genid/1f2e387fd5f06ead",
    "@type": [
      "http://schema.org/Person"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://project-sama.com/"
      }
    ],
    "http://schema.org/sameAs": [
      {
        "@id": "https://project-sama.com/"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/artistes/hugo-siclier"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Hugo Siclier"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "fr",
        "@value": "Hugo"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "fr",
        "@value": "Siclier"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Hugo Siclier alias Project Sama est un clarinettiste et producteur à la frontière entre la musique électronique, classique et improvisée. Il aime à connecter ces styles par l’ambiance, la dimension narrative qu'ils ont en commun. Cherchant à créer une musique profonde aux textures organiques et aux atmosphères chromatique, Project Sama hybride la clarinette à l’électronique et l’électronique à la clarinette."
      }
    ]
  },
