  {
    "@id": "https://levivier.ca/fr/evenement/saison-2026-27/tim-brady-alexis-diamond-mars-signs-life",
    "https://ogp.me/ns#site_name": [
      {
        "@language": "fr",
        "@value": "Le Vivier"
      }
    ],
    "https://ogp.me/ns#type": [
