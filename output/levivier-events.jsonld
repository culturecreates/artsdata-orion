      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/artistes/membres/organismes/tim-brady"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Tim Brady"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "fr",
        "@value": "Tim"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "fr",
        "@value": "Brady"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Guitariste-compositeur, Tim Brady ne peut être rattaché à une seule catégorie d’artiste. Que ce soit dans les opéras qu’il a écrits ou les concertos dans lesquels il a joué, il est avant reconnu comme virtuose de la guitare électrique mais il se sent aussi bien l’aise avec des improvisations électros qu’avec un quatuor à cordes. La « guitare orchestre » est une synthèse très personnelle de musique classique contemporaine, jazz, rock et électronique."
      }
    ]
  },
