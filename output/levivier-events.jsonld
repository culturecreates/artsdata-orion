    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Corinne René"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "fr",
        "@value": "Corinne"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "fr",
        "@value": "René"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Corinne René est une percussionniste se démarquant dans divers milieux musicaux. Musicienne classique de formation, elle joue régulièrement au sein d’orchestres du Québec, dont l’Orchestre Métropolitain. Elle est membre du quatuor 2 pianos et percussions Quatrix. Sa démarche artistique la rapproche des univers du théâtre, du mouvement et de l’improvisation. Elle travaille en collaboration avec Toiture, Tuyo, Riikka Kosola et Zoey Sauvage. Elle a pris part à des stages de perfectionnement au Conservatoire supérieur de musique de Lyon, The Banff Centre for the Arts, au Centre..."
      }
    ]
  },
