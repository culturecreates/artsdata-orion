      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://sixtrum.com/fr"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Sixtrum percussion"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Sixtrum propose une exploration débridée de la percussion contemporaine tout en maintenant un lien solide avec les œuvres majeures du XXe siècle.Formé de virtuoses aux multiples talents, Sixtrum renouvelle sans cesse son univers en se confrontant à d’autres disciplines et genres artistiques. Chacune des collaborations du groupe vise à trouver des formes d’expression inédites et des manières originales de toucher le public. L'objectif: transformer notre rapport avec la musique."
      }
    ]
  },
