  {
    "@id": "https://levivier.ca/genid/b35a1cf6eb10211a",
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/fr/artistes/albane-tamagna"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
