    ],
    "http://schema.org/familyName": [
      {
        "@language": "fr",
        "@value": "Chabanole"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Originaire de Regina, Chloé Chabanole jouit d’une carrière musicale très variée. Elle joue régulièrement avec l’Orchestre Métropolitain, I Musici de Montréal et l’Orchestre symphonique de Montréal et est membre des groupes de musique de chambre collectif9 et Warhol Dervish. Elle occupe également le poste de violon solo à l’Orchestre de l’Agora sous la direction du chef Nicolas Ellis.&nbsp;\r\n\r\nChloé a fait ses études au Conservatoire d’Amsterdam dans la classe de Johannes Leertouwer, à l’Université de Montréal auprès de Laurence Kayaleh, et au Conservatoire de..."
      }
    ]
  },
  {
    "@id": "https://levivier.ca/genid/9ba5488e177cda7c",
