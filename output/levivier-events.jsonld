  {
    "@id": "https://levivier.ca/genid/fb7d781b6ac7f2af",
    "@type": [
      "http://schema.org/Person"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://levivier.ca/fr/artistes/albane-tamagna"
      }
    ],
    "http://schema.org/identifier": [
      {
        "@language": "fr",
        "@value": "https://levivier.ca/fr/artistes/albane-tamagna"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Albane Tamagna"
      }
    ],
    "http://schema.org/givenName": [
      {
        "@language": "fr",
        "@value": "Albane"
      }
    ],
    "http://schema.org/familyName": [
      {
        "@language": "fr",
        "@value": "Tamagna"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "C’est en Corse, plongée au cœur des chants polyphoniques, qu’Albane Tamagna découvre la musique. A sept ans, elle choisit la flûte traversière comme vecteur pour vivre cette passion.\r\n\r\nPédagogue curieuse et passionnée, elle oriente son mémoire sur la notion d’engagement chez l’interprète : Entre essence de soi et essence de l’œuvre – comment guider l’élève vers ce lien indissociable? Afin d’expérimenter encore d’autres facettes de sa pédagogie, elle crée avec Lucile Gasciarino, professeure de flûte traversière au Conservatoire à Rayonnement..."
      }
    ]
  },
  {
    "@id": "https://levivier.ca/genid/a4d808235366927c",
    "@type": [
      "http://schema.org/Person"
    ],
    "http://schema.org/url": [
