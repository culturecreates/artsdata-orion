  {
    "@id": "https://culturegaspesie.org/evenement/evenements-culture-gaspesie/cafe-causerie-mrc-avignon-coffee-talk-mrc-avignon/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
        "@value": "fr_CA"
      }
