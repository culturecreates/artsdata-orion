    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Dîner-causerie | Démystifier vos droits et obligations fiscales"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Vous êtes un(e) artiste travailleur(-euse) autonome? Vous vous interrogez sur la pertinence, les modalités du démarrage d’une entreprise?\r\n\r\nCe dîner-causerie, présenté par un(e) représentant(e) de Revenu Québec, vous permettra de vous familiariser avec tous ces aspects. Vous aurez également l’opportunité d’en apprendre davantage au sujet des différentes formes juridiques, des obligations liées à l'immatriculation (NEQ) et aux taxes (TPS/TVQ). De plus, vous terminerez cette rencontre en sachant tout, ou presque, sur le programme d'accompagnement de Revenu Québec. Avouez qu’il y aura de la matière à réflexion. Joignez-vous à nous!"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
