  {
    "@id": "https://culturegaspesie.org/evenement/evenements-culture-gaspesie/comment-faire-des-recherches-a-partir-du-portail-de-la-banq/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
        "@value": "fr_CA"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Comment faire des recherches à partir du portail BAnQ - Culture Gaspésie"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le mercredi le 31 janvier prochain, sur l'heure du lunch, joignez-vous à l'équipe de Culture Gaspésie sur Zoom pour apprendre à faire des recherches sur le portail de la Bibliothèque et Archives nationales du Québec (BAnQ). Ce dîner-causerie sera animé par Guillaume Marsan, archiviste et coordonnateur à la BAnQ."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
