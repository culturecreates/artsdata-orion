    "http://schema.org/url": [
      {
        "@id": "https://culturegaspesie.org/evenement/formations-culture-gaspesie/les-medias-sociaux-une-richesse-a-exploiter/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Les médias sociaux, une richesse à exploiter!"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Présentée en formule asynchrone (en différé), cette formation vous habilitera à gérer vos pages Facebook et Instagram à votre propre rythme, selon l’horaire qui vous convient. Parce que vos comptes et vos publics sont uniques, la formation vous guidera pas à pas dans l’analyse de VOS réseaux sociaux."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OnlineEventAttendanceMode"
      }
    ]
  },
