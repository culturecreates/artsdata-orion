  {
    "@id": "https://culturegaspesie.org/evenement/evenements-culture-gaspesie/seance-dinformation-pour-tout-savoir-sur-les-fiches-membres/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
        "@value": "fr_CA"
      }
