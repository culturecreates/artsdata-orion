        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Écriture collective sur l'image - Culture Gaspésie"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Dans une ambiance conviviale propice à l'échange et à la participation, cette formation propose un atelier pratique pour les artistes et les travailleurs culturels. L'objectif ? Développer vos compétences en écriture et explorer des méthodes de création innovantes qui fusionnent texte et image."
      }
    ],
