    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Une activité de réseautage se tiendra le mercredi 27 mars 2024 à l'Auberge l'Amarré, située à Saint-Maxime-de-Mont-Louis. En plus de rencontrer des personnes passionnées, vous aurez la chance de participer à un activité créative animée par l'illustratrice Fannie Desmarais."
      }
    ],
