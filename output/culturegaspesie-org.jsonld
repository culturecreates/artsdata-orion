    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Par où commencer pour devenir un(e) artiste en affaires?"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "À travers l’atelier Par où commencer pour devenir un artiste en affaires?, Accès Microcrédit Gaspésie-Îles-de-la-Madeleine aborde les différentes étapes de la création d’une entreprise. De l’idéation, jusqu’à l’expansion, nous vous présenterons le chemin qu’a à parcourir le promoteur de projet d’affaires. "
      }
    ],
