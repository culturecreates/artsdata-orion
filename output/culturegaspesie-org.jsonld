  {
    "@id": "https://culturegaspesie.org/evenement/evenements-culture-gaspesie/how-do-i-start-a-business-as-an-artist/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
        "@value": "fr_CA"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "How do I start a business as an artist? - Culture Gaspésie"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Through the workshop How do I start a business as an artist?, Accès Microcrédit Gaspésie-Îles-de-la-Madeleine discusses the different stages related to the creation of an enterprise. From ideation to expansion, we will cover the various steps that promoters need to address when developing a business project."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://culturegaspesie.org/evenement/evenements-culture-gaspesie/how-do-i-start-a-business-as-an-artist/"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
