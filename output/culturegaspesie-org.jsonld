  {
    "@id": "https://culturegaspesie.org/evenement/evenements-culture-gaspesie/diner-causerie-le-cadre-juridique-des-contrats-dexploitation-des-oeuvres-des-artistes/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
