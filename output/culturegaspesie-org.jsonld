  {
    "@id": "https://culturegaspesie.org/evenement/formations-culture-gaspesie/rediger-et-presenter-son-dossier-de-projet-artistique-cohorte-2/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
        "@value": "fr_CA"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "(COMPLET) Rédiger et présenter son dossier de projet artistique (2e cohorte) - Culture Gaspésie"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Une demande de bourse doit représenter votre projet artistique le plus avantageusement possible. Mais quelles sont les règles de base pour rédiger et présenter un dossier convaincant? Comment préparer un budget prévisionnel réaliste? Cette formation vise à vous outiller afin de maximiser les probabilités de voir votre dossier sélectionné lors d’appels à candidatures, et ainsi, augmenter vos chances de succès."
      }
    ],
    "http://ogp.me/ns#url": [
