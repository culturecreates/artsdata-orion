  {
    "@id": "https://culturegaspesie.org/evenement/formations-culture-gaspesie/lancer-une-chanson-avec-succes/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
        "@value": "fr_CA"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Lancer une chanson avec succès - Culture Gaspésie"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Dans cet atelier, l’autrice-compositrice-interprète MLou présentera aux participant(e)s les étapes à suivre avant de faire paraître des chansons publiquement, afin de s’assurer qu’ils reçoivent les redevances qui leur sont dues."
      }
    ],
    "http://ogp.me/ns#url": [
