  {
    "@id": "https://culturegaspesie.org/evenement/evenements-culture-gaspesie/nouvelle-loi-sur-le-statut-professionnel-des-artistes-2/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
        "@value": "fr_CA"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Nouvelle Loi sur le statut professionnel des artistes - Culture Gaspésie"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Désormais, une seule loi s'applique à tous les artistes professionnels des domaines des arts visuels, du cinéma, du disque, de la littérature, des métiers d'arts et de la scène, leur permettant d'avoir accès aux mêmes outils de négociation de conditions de travail et d'être sur un même pied d'égalité. Pour connaître les principaux changements apportés par cette nouvelle Loi, rencontrez en virtuel Me Angelica Carrero."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://culturegaspesie.org/evenement/evenements-culture-gaspesie/nouvelle-loi-sur-le-statut-professionnel-des-artistes-2/"
