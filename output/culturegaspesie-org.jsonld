  {
    "@id": "https://culturegaspesie.org/evenement/formations-culture-gaspesie/faire-circuler-une-exposition/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
        "@value": "fr_CA"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Faire circuler une exposition - Culture Gaspésie"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Vous souhaitez faire circuler vos œuvres de manière à rayonner davantage et à avoir de nouvelles possibilités de diffusion? Bien. Mais vous avez de la difficulté à comprendre tous les rouages de la circulation d’une exposition? Cette formation, qui portera sur l’organisation d’une exposition individuelle, arrive donc à point dans votre carrière."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://culturegaspesie.org/evenement/formations-culture-gaspesie/faire-circuler-une-exposition/"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "fr-ca",
        "@value": "Culture Gaspésie"
      }
