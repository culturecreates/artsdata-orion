      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Séance d’information | Pour tout savoir sur les fiches membres! - Culture Gaspésie"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le lundi 14 novembre, à 10 h, joignez-vous à Jessie et Myriam pour une courte séance d'information. Elles vous parleront de l'importance du répertoire des membres, vous guideront sur les étapes de création/modification de votre fiche membre et pourront répondre à toutes vos questions."
      }
    ],
