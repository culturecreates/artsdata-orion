    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Le cadre juridique des contrats d'exploitation des oeuvres des artistes - Culture Gaspésie"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Au cours de ce dîner-causerie, voici les sujets qui seront explorés : l’impact des lois sur le droit d’auteur et le statut de l’artiste; la négociation et la rédaction des licences et cessions sur tout ou partie des différents droits sur les œuvres; les prestations d’artistes."
      }
    ],
