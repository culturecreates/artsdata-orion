    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Vous faites partie de la belle et grande communauté artistique gaspésienne? Que vous soyez membre ou non de Culture Gaspésie, venez échanger, discuter de vos projets et partager vos expériences avec des travailleur(-euse)s culturel(le)s et des artistes de toutes les disciplines."
      }
