        "@id": "https://culturegaspesie.org/evenement/evenements-culture-gaspesie/seance-dinformation-pour-tout-savoir-sur-les-fiches-membres-avril2024/"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://culturegaspesie.org/evenement/evenements-culture-gaspesie/seance-dinformation-pour-tout-savoir-sur-les-fiches-membres-avril2024/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Pour tout savoir sur les fiches membres"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le mercredi 10 avril 2024, à 12 h, joignez-vous à Jessie Blaquière pour une séance d'information. Elle vous parlera de l'importance du répertoire des membres accessible sur le site Web de Culture Gaspésie, vous guidera sur les étapes de création/bonification de votre fiche membre et pourra répondre à toutes vos questions."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OnlineEventAttendanceMode"
      }
    ]
  },
