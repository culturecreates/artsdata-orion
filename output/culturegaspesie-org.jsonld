    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Myriam Perron et Jessie Blaquière, toutes deux agentes de développement, invitent les personnes intéressées, membres ou non de Culture Gaspésie, à une séance d’information virtuelle au cours de laquelle elles feront un survol de la boîte à outils, allant de son contenu à la façon d’y naviguer."
      }
    ],
