    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dans cet atelier, l’autrice-compositrice-interprète Mlou présentera aux participant(e)s les étapes à suivre avant de faire paraître des chansons publiquement, afin de s’assurer qu’ils reçoivent les redevances qui leur sont dues."
      }
    ],
