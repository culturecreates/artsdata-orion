  {
    "@id": "https://culturegaspesie.org/evenement/formations-culture-gaspesie/le-processus-de-creation-recit-cycles-et-transformations-silencieuses/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
        "@value": "fr_CA"
      }
