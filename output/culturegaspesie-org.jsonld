  {
    "@id": "https://culturegaspesie.org/evenement/formations-culture-gaspesie/ecriture-collective-sur-limage/",
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
        "@value": "fr_CA"
