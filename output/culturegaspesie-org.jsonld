    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Nouvelle Loi sur le statut professionnel des artistes - Culture Gaspésie"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Désormais, une seule loi s'applique à tous les artistes professionnels des domaines des arts visuels, du cinéma, du disque, de la littérature, des métiers d'arts et de la scène, leur permettant d'avoir accès aux mêmes outils de négociation de conditions de travail et d'être sur un même pied d'égalité. Rencontrez en virtuel Me Christine Fortin, directrice adjointe aux relations de travail à l’Union des artistes, pour en apprendre un peu plus sur ce changement à la législation qui encadre les conditions de travail des artistes."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ]
