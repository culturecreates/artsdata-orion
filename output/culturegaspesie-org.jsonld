    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Séance d’information | Pour tout savoir sur les fiches membres!"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le mercredi 15 mars 2023, à 10 h, joignez-vous à Jessie et Myriam pour une courte séance d'information. Elles vous parleront de l'importance du répertoire des membres accessible sur le site Web de Culture Gaspésie, vous guideront sur les étapes de création/bonification de votre fiche membre et pourront répondre à toutes vos questions."
      }
    ],
