  {
    "@id": "https://www.mbam.qc.ca/fr/activites/sur-le-chemin-du-reve/",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Sur le chemin du rêve"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://billets.mbam.qc.ca/uploads/37815e3b-94b4-4802-8ec6-fce874233d8a.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Hélène Guilmette trace les chemins de l'amour français de Saint-Saëns à Poulenc avec sa voix se fondant aux couleurs chatoyantes de la harpe d'Antoine Malette-Chénier et aux cordes dirigées par Johann Stuckenbruck. Fauré, Debussy et Massenet dessinent un paysage intime où se rencontrent passion, nostalgie et sensualité.Avec le soutien du Palazzetto Bru Zane – Centre de musique romantique française"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.mbam.qc.ca/fr/activites/sur-le-chemin-du-reve/"
      }
    ]
  },
