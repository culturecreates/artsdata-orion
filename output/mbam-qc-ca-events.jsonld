  {
    "@id": "https://www.mbam.qc.ca/fr/activites/les-chemins-qui-montent/",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Les chemins qui montent"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://billets.mbam.qc.ca/uploads/e5d2ed02-850f-4eef-838e-6f58534e9c89.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Ces Chemins qui montent, c’est à la fois l’hommage d’Amel Brahim-Djelloul, chanteuse lyrique franco-algérienne à sa culture de cœur, la musique kabyle, et la rencontre entre sa voix, riche de mille influences, et la musique d’Idir, de Taos Amrouche, de Djamel Allam."
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.mbam.qc.ca/fr/activites/les-chemins-qui-montent/"
      }
    ]
  },
