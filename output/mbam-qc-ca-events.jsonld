      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://billets.mbam.qc.ca/uploads/bf1b24e1-542f-4945-9606-27efc9b52bdf.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Beethoven et Mozart nous entraînent dans des quintettes uniques, avec piano et vents qui dialoguent de façon surprenante. Beethoven joue sur les contrastes, Mozart sur la conversation entre les instruments. Et vous découvrirez Clémence de Grandval, compositrice passionnante, la plus jouée à Paris de son temps, mais presque oubliée aujourd’hui.En coproduction avec l’Orchestre symphonique de MontréalAvec le soutien du Palazzetto Bru Zane – Centre de musique romantique française (Italie)"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.mbam.qc.ca/fr/activites/musique-pour-vents-et-piano/"
      }
    ]
