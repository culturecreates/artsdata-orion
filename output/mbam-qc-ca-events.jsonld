      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Lauréate au Concours international de piano Frédéric-Chopin en 2021, la pianiste Aimi Kobayashi s'illustre depuis sur la scène internationale. Pour ses débuts à Montréal, elle nous propose de grandes pages de Beethoven, Chopin et Schubert.\n\tCe concert est présenté avec le soutien de la succession de Marie-Paule Laurans."
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
