        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://billets.mbam.qc.ca/uploads/c81e5b64-5678-4f8a-b67b-4fde20f7b8a9.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Depuis plus de 50 ans, le Quatuor Takács sillonne le monde en tant que grand ambassadeur du quatuor à cordes. Pour ce passage à la Salle Bourgie, le réputé ensemble nous offre deux grandes pages de la littérature pour quatuor ainsi qu’une œuvre de Carlos Simon inspirée de l’histoire afro-américaine."
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.mbam.qc.ca/fr/activites/quatuor-takacs/"
