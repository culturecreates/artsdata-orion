      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Le Nouvel Ensemble Moderne convie le pianiste jazz montréalais François Bourassa à une soirée entièrement consacrée à son univers. Au programme : créations écrites pour le NEM et relectures de pièces phares, réinventées dans des orchestrations inédites de Bourassa. En invité spécial, Philippe Côté se joindra au NEM au saxophone.\n\tBILLETS : NEM"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
