      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Porte-étendard de la musique traditionnelle afghane, le virtuose du tabla Salar Nader retrace le riche héritage des compositions classiques et folkloriques de cette nation. Au cœur de cette odyssée, les sons enchanteurs et envoûtants du rubab, le vénéré luth à 21 cordes d'Afghanistan."
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
