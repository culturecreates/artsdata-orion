  {
    "@id": "https://www.mbam.qc.ca/fr/activites/trio-fibonacci---voyage-en-europe-de-lest-1/",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Trio Fibonacci - Voyage en Europe de l’Est"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://billets.mbam.qc.ca/uploads/2efd1aa6-df43-46a9-aaed-cd06bf6980d8.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Entre terre et ciel, tradition et contemplation, traversez les paysages sonores de l’Est européen! Au programme : le romantisme russe et les accents populaires de Borodin côtoient l’héritage slave teinté de modernité parisienne de Martinů. Tandis que le langage de silences et de lumière intérieure de Pärt résonne avec celui fragile et incandescent de Vasks dans une même dimension spirituelle. Du souffle romantique à la contemplation mystique, ce voyage révèle une Europe de l’Est plurielle, contrastée et profondément inspirée."
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.mbam.qc.ca/fr/activites/trio-fibonacci---voyage-en-europe-de-lest-1/"
      }
    ]
  },
  {
    "@id": "https://www.mbam.qc.ca/genid/44965da9b4386f52",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/startDate": [
