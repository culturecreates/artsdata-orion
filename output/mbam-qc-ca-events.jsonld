  {
    "@id": "https://www.mbam.qc.ca/fr/activites/tradition-viennoise/",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Tradition viennoise"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://billets.mbam.qc.ca/uploads/84b73cd8-02d3-44c3-a407-f9237cd0e6a0.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Jimmy López, compositeur en résidence à l’OSM, joue avec des phrases musicales équilibrées et pleines de nuances. Brahms nous invite à une musique chaleureuse et contemplative, où la clarinette tient une place centrale. Dans Weihnachtsmusik, Schoenberg mêle plusieurs lignes musicales autour d’un choral et du célèbre chant de Noël Sainte nuit. Enfin, son arrangement de la Valse de l’empereur surprend par son imagination et sa richesse sonore.En coproduction avec l’Orchestre symphonique de Montréal"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.mbam.qc.ca/fr/activites/tradition-viennoise/"
      }
    ]
  },
