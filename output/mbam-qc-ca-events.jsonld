  {
    "@id": "https://www.mbam.qc.ca/fr/activites/escapade-musicale-de-varsovie-a-bucarest-1/",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Escapade musicale de Varsovie à Bucarest"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://billets.mbam.qc.ca/uploads/37959b98-921b-4955-933e-b347dff5a0da.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Ce programme met à l’honneur l’élan juvénile de deux compositeurs : à 19 ans, Chostakovitch rend hommage à Bach et laisse poindre l’ironie de ses futures symphonies ; Enesco, au même âge, déploie dans son Octuor une étonnante invention thématique. Quant à Bacewicz, elle destine son Quatuor aux élèves du Conservatoire de Łódź.En coproduction avec l’Orchestre symphonique de Montréal"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.mbam.qc.ca/fr/activites/escapade-musicale-de-varsovie-a-bucarest-1/"
      }
    ]
  },
