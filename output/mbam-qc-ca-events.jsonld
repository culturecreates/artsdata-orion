  {
    "@id": "https://www.mbam.qc.ca/fr/activites/philip-glass-et-les-violons-du-roy/",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Philip Glass et Les Violons du Roy"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://billets.mbam.qc.ca/uploads/08b2e5f1-9b72-455c-abcf-442c59e723f4.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Deux univers convergent lorsque Mozart dialogue avec Philip Glass et Arvo Pärt dans un programme qui transcende les époques. Thomas Le Duc-Moreau explore les résonances entre classicisme viennois et minimalisme contemporain en compagnie d’Élisabeth Pion qui interprétera le Concerto pour piano no 3 de Glass. Une rencontre captivante entre tradition et modernité."
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.mbam.qc.ca/fr/activites/philip-glass-et-les-violons-du-roy/"
      }
    ]
  },
