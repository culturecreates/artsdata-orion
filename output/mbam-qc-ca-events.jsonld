        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://billets.mbam.qc.ca/uploads/14638a7b-c448-4f6b-9df4-879d3ae6cac1.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "De Salieri à Mozart, le chef d'orchestre Paul Agnew propose un fascinant parcours musical autour de la diabolique Casa del diavolo de Boccherini et de la noble sonorité du corniste Louis-Philippe Marsolais dans Mozart et Haydn. Ce programme révèle l'effervescence créatrice du classicisme viennois dans toute sa diversité."
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.mbam.qc.ca/fr/activites/la-maison-du-diable/"
