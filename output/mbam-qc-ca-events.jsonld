    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "La Salle Bourgie est fière d’accueillir pour la première fois cet exceptionnel trio formé de solistes établis sur les plus grandes scènes internationales. Ils joueront des œuvres marquantes du répertoire romantique et moderne. Une exclusivité de la Salle Bourgie à ne pas manquer!"
      }
