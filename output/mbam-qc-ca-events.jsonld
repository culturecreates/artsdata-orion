      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Ensemble reconnu pour son dynamisme et son style captivant, Carn Davidson 9 nous propose une soirée inspirée des rythmes du choro brésilien, du tango argentin, du hip-hop et du swing, explorant les liens entre musique et mouvement.Veuillez noter que le bar de la Salle Bourgie sera ouvert une heure avant le début du concert."
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
