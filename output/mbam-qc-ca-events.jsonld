      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Avi Avital, l’un des plus grands virtuoses de la mandoline au monde s’associe aux Violons du Roy pour présenter ses propres arrangements de grands concertos baroques. Un concert où la brillance rencontre l'audace."
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
