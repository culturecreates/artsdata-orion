        "@value": "Hommage au Buena Vista Social Club"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://billets.mbam.qc.ca/uploads/0502ae4e-25b4-4d82-aff8-f0643623cf66.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Le pianiste cubain Rafael Zaldivar et son ensemble rendent un vibrant hommage au Buena Vista Social Club en revisitant les plus grandes chansons du légendaire collectif. Une occasion de revivre l'atmosphère chaleureuse et festive des années 1950 et 1960 à La Havane.Veuillez noter que le bar de la Salle Bourgie sera ouvert une heure avant le début du concert."
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.mbam.qc.ca/fr/activites/hommage-au-buena-vista-social-club/"
