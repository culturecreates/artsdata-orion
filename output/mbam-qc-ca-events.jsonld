  {
    "@id": "https://www.mbam.qc.ca/fr/activites/schubert-et-farrenc-edgar-moreau-et-les-musicien-ne-s-de-l-om/",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Schubert et Farrenc : Edgar Moreau et les musicien.ne.s de l'OM"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://billets.mbam.qc.ca/uploads/cebf387b-e81b-4177-b292-fbc1f3937669.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Le Quintette « La Truite », inspiré du lied du même nom, compte parmi les œuvres les plus populaires et séduisantes de Schubert. À ses côtés, les musicien.ne.s de l'OM nous font découvrir celui de la compositrice Louise Farrenc, écrit dans un style tout aussi lyrique et raffiné.En coproduction avec l’Orchestre MétropolitainAvec le soutien du Palazzetto Bru Zane – Centre de musique romantique française (Italie)"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
