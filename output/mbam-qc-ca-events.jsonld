    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Grand spécialiste du lied, le baryton-basse Christian Immler nous offre, en compagnie du pianiste Francis Perron, des pages sublimes de Mozart et Schubert.\n\tCe concert est présenté avec le soutien de la succession de Marie-Paule Laurans."
      }
    ],
