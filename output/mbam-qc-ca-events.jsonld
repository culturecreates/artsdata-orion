  {
    "@id": "https://www.mbam.qc.ca/fr/activites/cantates-de-bach-26/",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Cantates de Bach"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://billets.mbam.qc.ca/uploads/812b2d88-07e8-47e9-bfda-ea4fbc204fb1.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Sous la direction inspirée de Sébastien Daucé, l’Ensemble Correspondances déploie toute la richesse de son art dans trois cantates de jeunesse de J. S. Bach. Porté par des voix d’exception, l’ensemble révèle avec profondeur et sensibilité la force spirituelle et l’inventivité du jeune Bach.﻿ En coproduction avec le Festival International Bach Montréal"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.mbam.qc.ca/fr/activites/cantates-de-bach-26/"
      }
    ]
  },
