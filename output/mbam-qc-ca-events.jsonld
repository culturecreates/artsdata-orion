    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Le Quatuor de saxophones Ellipsos et le pianiste Frank Braley vous invitent à un voyage dans le temps, au son des musiques baroque, classique, romantique et jazz, de même qu’à une envolée vers la lune, avec A Dream for Artemis du compositeur Fabien Waksman."
      }
    ],
