    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Pour leur première présence à la Salle Bourgie, Les Ondes, ensemble dirigé par Mélisande McNabney, présentent un programme entièrement consacré à Handel. Autour de sa cantate Il delirio amoroso se greffent des pièces instrumentales virtuoses et touchantes de ce géant de la musique baroque."
      }
    ],
