  {
    "@id": "https://www.mbam.qc.ca/fr/activites/les-indes-galantes/",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Les Indes galantes"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://billets.mbam.qc.ca/uploads/0611d64b-5537-4a0c-a3e2-09c37b9d3122.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Jean-Philippe Rameau déploie ses fastes exotiques dans une fresque orchestrale extraite des Indes galantes. Bernard Labadie et Les Violons du Roy ressuscitent les couleurs vives, les danses envoûtantes et la sensualité de cet opéra-ballet. Une pure magie baroque où chaque symphonie devient un voyage vers des terres de rêve et de passion."
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.mbam.qc.ca/fr/activites/les-indes-galantes/"
      }
    ]
  },
