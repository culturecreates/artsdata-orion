  {
    "@id": "https://www.mbam.qc.ca/fr/activites/benny-goodman-du-jazz-au-classique/",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Benny Goodman : du jazz au classique"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://billets.mbam.qc.ca/uploads/6a33aec8-da54-4cfe-b42a-2fc831984706.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Artiste polyvalent à la sonorité envoûtante, le clarinettiste Pierre Génisson nous propose de redécouvrir l’héritage de Benny Goodman, génial musicien de jazz, dont le jeu inspira également plusieurs compositeurs classiques.Un cours de maître de clarinette sera donné par Pierre Génisson le vendredi 30 octobre à 11h."
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.mbam.qc.ca/fr/activites/benny-goodman-du-jazz-au-classique/"
      }
    ]
  },
