  {
    "@id": "https://www.mbam.qc.ca/fr/activites/fantaisies-baroques/",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Fantaisies baroques"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://billets.mbam.qc.ca/uploads/0636e58d-c5e1-4d3e-b998-9d0e63c61d8c.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Maurice Steger nous convie à une célébration de l'esprit galant. Telemann côtoie C. P. E. Bach et Haydn dans un programme d'une sublime élégance. Pascale Giguère au violon et Suren Barry à l'orgue positif unissent leurs talents dans un double concerto d'un charme irrésistible, à l'image de ces plaisirs orchestraux du 18e siècle où le raffinement et la joie se marient à merveille."
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.mbam.qc.ca/fr/activites/fantaisies-baroques/"
      }
    ]
  },
