  {
    "@id": "https://www.mbam.qc.ca/fr/activites/poemes-symphoniques/",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Poèmes symphoniques"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://billets.mbam.qc.ca/uploads/85961dce-4e16-4ab1-8db2-2d015c64031c.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "La pianiste et compositrice suisse Beatrice Berrut captive le public à travers le monde grâce à son sens de la narration et ses talents de coloriste. Elle nous offre un programme flamboyant constitué de ses propres œuvres et de transcriptions de grandes pages du répertoire orchestral.\n\tCe concert est présenté avec le soutien de la succession de Marie-Paule Laurans."
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.mbam.qc.ca/fr/activites/poemes-symphoniques/"
      }
    ]
  },
