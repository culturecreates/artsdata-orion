  {
    "@id": "https://www.mbam.qc.ca/fr/activites/because-un-concert-de-spirituals/",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Because : un concert de spirituals"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://billets.mbam.qc.ca/uploads/2ffdaf29-baab-41b7-8ff2-750795dae058.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Reconnu mondialement pour la pureté de son timbre et la justesse de ses interprétations dans les répertoires baroque, classique et moderne, le contre-ténor américain Reginald Mobley nous convie à une soirée consacrée aux spirituals, genre musical étroitement lié à l’histoire afro-américaine.﻿ En collaboration avec le Centre Culturel Afro-Canadien de Montréal (CCAM)  et la Table Ronde du mois de l'histoire des Noir.e.s\n\tCe concert est présenté avec le soutien de la succession de Marie-Paule Laurans."
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.mbam.qc.ca/fr/activites/because-un-concert-de-spirituals/"
      }
    ]
  },
