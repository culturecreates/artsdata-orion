      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "La pianiste new-yorkaise Angelica Sanchez se joint au guitariste montréalais Michael Bruzzese pour un concert intime en duo lors duquel ils présenteront en première les Poèmes pour cordes de Bruzzese ainsi que deux pièces de Sanchez. Une soirée sous le signe de l'improvisation et de l'exploration sonore."
      }
    ],
