  {
    "@id": "https://www.mbam.qc.ca/fr/activites/mercure-remix/",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Mercure remix"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://billets.mbam.qc.ca/uploads/e062c88a-886f-4f77-9641-7084f9e12d1c.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Ce concert présente une occasion unique d’écouter Incandescence (1961) et Manipulations (1963), deux œuvres électroacoustiques diffusées lors de spectacles de danse à l'époque réalisés par des artistes tels que Françoise Riopelle, Jean-Paul Mousseau, Rita Letendre, Armand Vaillancourt et Pierre Moretti. Par la suite, Theresa Transistor – un quatuor d’improvisation électroacoustique – clôturera les festivités en proposant un Remix inspiré des œuvres et de la démarche de création de Pierre Mercure.En collaboration avec Akousma"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.mbam.qc.ca/fr/activites/mercure-remix/"
      }
    ]
  },
