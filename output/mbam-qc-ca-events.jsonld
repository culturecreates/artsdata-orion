      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://billets.mbam.qc.ca/uploads/8c2e2fb8-16bb-43d8-b085-7a6654f56806.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Constellation de cordes nous convie à la rencontre entre la musique baroque et les traditions folkloriques. Au son de l’inanga rwandaise, du théorbe et de la vièle perse, une fresque musicale prend vie, à la croisée des cultures et des époques.\n\tEn collaboration avec le Centre des musiciens du monde"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.mbam.qc.ca/fr/activites/constellation-de-cordes/"
