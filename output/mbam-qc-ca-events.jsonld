  {
    "@id": "https://www.mbam.qc.ca/fr/activites/matinee-bach-kurtag-le-lien-invisible/",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Matinée Bach / Kurtág : le lien invisible"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://billets.mbam.qc.ca/uploads/d04c768f-bfe6-4602-b473-34148eb90ae4.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Bach et Kurtág : le violoncelliste Daniel Claret nous invite à une rencontre entre ces deux grands créateurs, éloignés dans le temps, mais unis par un lien spirituel et une essence musicale commune. Une occasion de redécouvrir Kurtág, dont on célèbre le centenaire cette année.Faites une pause musicale à la Salle Bourgie ! Profitez d’un café ou d’un thé offert avant le concert et laissez-vous emporter par la grande musique."
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.mbam.qc.ca/fr/activites/matinee-bach-kurtag-le-lien-invisible/"
      }
    ]
