  {
    "@id": "https://www.mbam.qc.ca/fr/activites/lunasa-un-noel-irlandais/",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Lúnasa : un Noël irlandais"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://billets.mbam.qc.ca/uploads/9e0756a2-30f5-4742-975e-bb91a95e619a.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Célèbre dans le monde entier pour ses arrangements modernes des mélodies traditionnelles, Lúnasa nous convie à une soirée de Noël aux rythmes endiablés et aux envolées celtiques, dans la meilleure tradition irlandaise.Une causerie préconcert, en anglais, consacrée à la musique irlandaise se tiendra à 18 h 30, en compagnie de Trevor Hoy, éditeur des programmes de la Salle Bourgie, et des membres du groupe Lúnasa"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.mbam.qc.ca/fr/activites/lunasa-un-noel-irlandais/"
      }
    ]
  },
