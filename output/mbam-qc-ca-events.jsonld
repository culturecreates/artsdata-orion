      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Talent prometteur de la relève, le pianiste Antoine Rivard-Landry nous convie à découvrir les multiples facettes de l’univers de Sergei Rachmaninov. Passion, intimité et poésie seront au rendez-vous de cette matinée musicale. Profitez d’un café ou d’un thé offert avant le concert et laissez-vous emporter par la grande musique."
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.mbam.qc.ca/fr/activites/matinee-rachmaninov/"
