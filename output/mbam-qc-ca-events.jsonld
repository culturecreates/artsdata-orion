  {
    "@id": "https://www.mbam.qc.ca/fr/activites/marianne-lambert-et-jeff-cohen/",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Marianne Lambert et Jeff Cohen"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://billets.mbam.qc.ca/uploads/dd853236-3176-4097-8a55-063825a364e6.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Reconnue pour sa présence lumineuse, la soprano Marianne Lambert se joint au renommé pianiste Jeff Cohen pour nous offrir des lieder de Schubert inspirés par les héroïnes et l’univers féminin.\n\tCe concert est présenté avec le soutien de la succession de Marie-Paule Laurans.\n\tActivité avant le concertPour débuter le concert en toute convivialité, une dégustation de vins de viticultrices, animée par Trevor Hoy, vous sera proposée à 18 h, dans le foyer de la Salle Bourgie. Réservation obligatoire. Capacité limitée à 30 personnes."
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.mbam.qc.ca/fr/activites/marianne-lambert-et-jeff-cohen/"
      }
    ]
  },
