  {
    "@id": "https://www.mbam.qc.ca/fr/activites/les-derniers-quatuors-a-cordes-de-beethoven/",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Les derniers quatuors à cordes de Beethoven"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://billets.mbam.qc.ca/uploads/e99ec6e3-c0f9-4b72-a2ce-9eb91f6b7a33.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Pour ce deuxième concert consacré au quatuor à cordes chez Beethoven, la Salle Bourgie accueille avec bonheur le réputé Juilliard String Quartet, qui consacre son programme à trois chefs-d’œuvre du répertoire : les deux derniers quatuors du compositeur ainsi que la monumentale Grande fugue.Un cours de maître de musique de chambre pour cordes sera donné par le Juilliard String Quartet le mercredi 24 mars à 11 h."
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.mbam.qc.ca/fr/activites/les-derniers-quatuors-a-cordes-de-beethoven/"
      }
    ]
  },
