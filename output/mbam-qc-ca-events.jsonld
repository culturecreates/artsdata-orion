  {
    "@id": "https://www.mbam.qc.ca/fr/activites/trio-fibonacci---les-fibonacci-retournent-au-cinema-1/",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Trio Fibonacci - Les Fibonacci retournent au cinéma"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://billets.mbam.qc.ca/uploads/de77b028-e323-43b2-a75f-b712658b2604.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Une soirée sous le signe du 7ᵉ art! Des musiques emblématiques du grand écran renaissent en versions inédites pour trio, déployant lyrisme, tension et thèmes inoubliables. Les musiciens rendent également hommage au pionnier du genre, Camille Saint-Saëns. Une création canadienne viendra compléter la soirée, dans un dialogue vivant entre la magie de la scène et celle du cinéma."
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.mbam.qc.ca/fr/activites/trio-fibonacci---les-fibonacci-retournent-au-cinema-1/"
      }
    ]
  },
