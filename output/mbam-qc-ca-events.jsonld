  {
    "@id": "https://www.mbam.qc.ca/fr/activites/jonathan-fournel-chefs-doeuvre-du-clavier/",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Jonathan Fournel : Chefs-d’œuvre du clavier"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://billets.mbam.qc.ca/uploads/6bc55bbf-6758-4c07-8c0d-7701e31ef295.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Lauréat du grand prix au Concours international Reine Élisabeth, le pianiste Jonathan Fournel nous propose un périple à travers trois siècles de musique, de la grandeur architecturale de Bach aux élans mystiques et virtuoses de Liszt, en passant par le lyrisme et la poésie de Schubert et de Chopin."
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.mbam.qc.ca/fr/activites/jonathan-fournel-chefs-doeuvre-du-clavier/"
