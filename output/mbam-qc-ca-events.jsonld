    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Réputé pour sa présence scénique radieuse et ses interprétations dynamiques, l'altiste Jordan Bak se joint à l'énergique Quatuor Catalyst afin de nous présenter un programme inspiré par le Nouveau Monde. En collaboration avec le Centre Culturel Afro-Canadien de Montréal (CCAM), l’Association Jamaïcaine de Montréal (JAM) et la Table Ronde du mois de l'histoire des Noir.e.s"
      }
    ],
