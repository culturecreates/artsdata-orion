        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://billets.mbam.qc.ca/uploads/6879e1f9-4130-402f-b7a5-52e16225be58.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Salué parmi les « 30 musiciens classiques canadiens de moins de 30 ans les plus talentueux » par CBC Music, le dynamique Cheng² Duo se démarque par une musicalité accomplie et une alchimie indéniable. Il nous propose un programme d’intéressantes transcriptions et de passionnantes découvertes."
      }
    ],
