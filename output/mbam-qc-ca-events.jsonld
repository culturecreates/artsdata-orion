    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Le violoniste Théotime Langlois de Swarte et le luthiste Thomas Dunford nous transportent dans l’Angleterre du 17e siècle à travers une exploration de la mélancolie, telle qu’illustrée dans la musique exubérante des violonistes virtuoses de l’époque de Charles II."
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
