    "http://schema.org/url": [
      {
        "@id": "https://www.mbam.qc.ca/fr/activites/pierre-genisson-clarinette/"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Cours de maître - Pierre Génisson clarinette"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le célèbre clarinetiste Pierre Génisson partage son expertise et conseille des étudiant.e.s avancé.e.s dans un cours de maître pour clarinette.\n\tUne belle occasion d'observer comment se déroule un enseignement musical de haut niveau et d'appréhender le répertoire de musique de chambre d'une manière différente.\n\tLe billet permet seulement d'assister au cours de maître. Les participants seront quant à eux sélectionnés par la Salle Bourgie.\n\tEn lien avec le concert Benny Goodman : du jazz au classique présenté le 29 octobre 2026 à 19 h 30."
      }
    ]
  },
  {
    "@id": "https://www.mbam.qc.ca/fr/activites/john-dowland-et-la-renaissance/",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "John Dowland et la Renaissance"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://billets.mbam.qc.ca/uploads/1f684dc9-2837-4179-bc5d-e879c8cd799c.png"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Afin de souligner le 400e anniversaire du décès de John Dowland, la soprano Myriam Leblanc et le luthiste Hopkinson Smith nous convient à un grand voyage à travers les pavanes et les gaillardes du génial compositeur anglais qui a si bien traduit en musique la mélancolie.\n\tCe concert est présenté avec le soutien de la succession de Marie-Paule Laurans."
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.mbam.qc.ca/fr/activites/john-dowland-et-la-renaissance/"
