  {
    "@id": "https://www.mbam.qc.ca/fr/activites/festival-pierre-mercure-100e-anniversaire-conference-et-concert/",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Festival Pierre-Mercure : 100e anniversaire, conférence et concert"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://billets.mbam.qc.ca/uploads/eb3b010e-d6bd-405e-9e74-e6d7f80d7cf2.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Pierre Mercure a mené une carrière passionnante, au cœur de la création artistique québécoise et internationale. Cette conférence permettra de suivre le fil de ses créations à partir des années 1940 jusqu'à son projet de sculpture sonore prévue pour l'Expo 67 en passant par son travail de composition en studio, ses œuvres pour grand orchestre, la Semaine internationale de musique actuelle et ses réalisations incomparables à la télévision de Radio-Canada.En coproduction avec le Nouvel Ensemble Moderne (NEM)En collaboration avec le Centre de musique canadienne au Québec."
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.mbam.qc.ca/fr/activites/festival-pierre-mercure-100e-anniversaire-conference-et-concert/"
      }
    ]
  },
