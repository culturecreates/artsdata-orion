      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Gagnant en 2022 du prestigieux Concours international Honens, le jeune et brillant pianiste ukrainien Illia Ovcharenko a conçu un programme centré sur le thème de la fantaisie dans la littérature du piano, un terreau fertile à l'expression de l’âme romantique.\n\tCe concert est présenté avec le soutien de la succession de Marie-Paule Laurans."
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
