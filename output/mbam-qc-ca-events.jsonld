      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Pour sa première présence au Canada, l'ensemble Opera Prima, qui se spécialise dans le répertoire italien du 17e siècle, se joint à la brillante soprano Amanda Forsythe pour nous faire découvrir les passions et les tourments du Seicento.\n\tCe concert est présenté avec le soutien de la succession de Marie-Paule Laurans."
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.mbam.qc.ca/fr/activites/tormento-seicento-litalie-baroque/"
