    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Schubert et Beethoven"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Durant le premier quart du 19e siècle Schubert et Beethoven ont vécu à Vienne sans toutefois se rencontrer. Entre leurs musiques il y a pourtant beaucoup de filiations saisissantes mais aussi de profondes ruptures. Si Schubert a subi l’ombre de Beethoven il a toutefois su trouver sa propre lumière.\n\tEn lien avec le concert de Thomas Dolié et Olivier Godin le même jour à 19 h 30. Pour en savoir plus cliquez ici.\n\tEn lien avec les concerts de l’An 3 de l’intégrale des lieder de Schubert Jean Portugais présentera deux conférences afin de permettre au public de la Salle Bourgie de mieux appréhender cet immense corpus. Pour en savoir plus sur la première conférence cliquez ici."
      }
    ]
  },
  {
    "@id": "https://www.mbam.qc.ca/fr/activites/beethoven-et-schubert-confidences/",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Beethoven et Schubert : confidences"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://billets.mbam.qc.ca/uploads/ce3718bc-6e6f-4632-9acd-93093f6c9885.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Beethoven : l'idole du jeune Schubert. Thomas Dolié et Olivier Godin nous proposent un programme qui met en lumière les thèmes et les textes communs qu'ont employés les deux compositeurs dans leur production vocale : le mythe de Faust, la solitude, l'amour lointain.Une conférence de Jean Portugais, intitulée « Schubert et Beethoven», sera présentée le même jour à 17 h, en lien avec le concert. Pour plus de détails, cliquez ici.\n\tCe concert est présenté avec le soutien de la succession de Marie-Paule Laurans."
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.mbam.qc.ca/fr/activites/beethoven-et-schubert-confidences/"
      }
    ]
  },
