        "@language": "fr",
        "@value": "Concert de clôture : Bach en fête"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://billets.mbam.qc.ca/uploads/926af3c4-ff8e-4136-b5e2-34360a75dbfc.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Une célébration musicale où Bernard Labadie réunit des solistes d'exception et Les Violons du Roy dans un programme d’une joyeuse virtuosité. Du Triple concerto aux Brandebourgeois, Bach dévoile son génie dans toute sa splendeur instrumentale. Un concert où chaque note scintille d'invention et d’allégresse."
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.mbam.qc.ca/fr/activites/concert-de-cloture-bach-en-fete/"
      }
    ]
  },
