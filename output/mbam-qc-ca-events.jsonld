    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Célèbre dans le monde entier pour ses arrangements modernes des mélodies traditionnelles Lúnasa nous convie à une soirée de Noël aux rythmes endiablés et aux envolées celtiques dans la meilleure tradition irlandaise.Une causerie préconcert en anglais consacrée à la musique irlandaise se tiendra à 18 h 30 en compagnie de Trevor Hoy éditeur des programmes de la Salle Bourgie et des membres du groupe Lúnasa"
      }
    ]
  },
  {
    "@id": "https://www.mbam.qc.ca/fr/activites/les-noels-du-roi-soleil/",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Les Noëls du Roi-Soleil"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://billets.mbam.qc.ca/uploads/f3494747-7db5-4453-863e-8f42a043a20a.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Les musicien.ne.s du SMAM vous convient à célébrer la Nativité comme on le faisait à Paris au 17e siècle. Les noëls de Charpentier et de Lalande y retentissent, mêlant danses, rythmes vifs, harmonies lumineuses et éclat orchestral, pour le plus grand plaisir du Roi-Soleil et le nôtre!\n\tEn coproduction avec le Studio de musique ancienne de Montréal (SMAM)"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.mbam.qc.ca/fr/activites/les-noels-du-roi-soleil/"
      }
    ]
  },
