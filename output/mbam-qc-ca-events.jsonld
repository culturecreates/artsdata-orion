    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://billets.mbam.qc.ca/uploads/d55b7c73-3473-4235-915e-21897c86ffd3.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Après un concert exceptionnel en 2024, le guitariste français Raphaël Feuillâtre revient à la Salle Bourgie avec un programme aux couleurs latines, naviguant avec brio et expressivité de l’Espagne à l’Argentine, de l’Italie au Brésil. En collaboration avec la Société de guitare de Montréal, le Centre Culturel Afro-Canadien de Montréal (CCAM) et et la Table Ronde du mois de l'histoire des Noir.e.s"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.mbam.qc.ca/fr/activites/passions-latines/"
      }
    ]
  },
