  {
    "@id": "https://www.mbam.qc.ca/fr/activites/kronos-joue-glass/",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Kronos joue Glass"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://billets.mbam.qc.ca/uploads/0802770d-8466-48c5-b445-b97951a61803.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Pour ouvrir le Festival, le Kronos Quartet propose un programme entièrement consacré à Philip Glass, mêlant quatuors emblématiques, arrangements inédits et pièces écrites spécialement pour l’ensemble, avec projections sur écran. Du langage minimaliste hypnotique au lyrisme contemporain, cette soirée explore l’univers singulier du compositeur, avec un clin d’œil à Bob Dylan."
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.mbam.qc.ca/fr/activites/kronos-joue-glass/"
      }
    ]
  },
