      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Musiciens britanniques parmi les plus en vue, le violoncelliste Sheku Kanneh-Mason et le pianiste Benjamin Grosvenor mènent tous deux une brillante carrière internationale. Ils unissent leurs forces pour nous présenter certaines des plus belles pages de musique de chambre pour leur première prestation à la Salle Bourgie."
      }
    ],
