      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Le guitariste et compositeur montréalais Carlos Jiménez présente son nouvel ensemble avec comme invité spécial le saxophoniste virtuose américain Walter Smith III. Entourés de piliers de la scène locale et internationale, ils nous présentent des nouvelles compositions énergiques, rythmées et audacieuses."
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
