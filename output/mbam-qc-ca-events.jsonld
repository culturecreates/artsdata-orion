  {
    "@id": "https://www.mbam.qc.ca/fr/activites/tresors-de-la-belle-epoque/",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Trésors de la Belle Époque"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://billets.mbam.qc.ca/uploads/65280708-b34c-4302-9bdc-5abdb40ef54b.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Reconnu pour son jeu brillant, sa grande polyvalence et son engagement humanitaire, le violoniste Daniel Hope s’illustre sur la scène internationale depuis 30 ans. Aux côtés du réputé pianiste Simon Crawford-Phillips, il nous propose des œuvres emblématiques de la Belle Époque ainsi que quelques raretés."
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.mbam.qc.ca/fr/activites/tresors-de-la-belle-epoque/"
