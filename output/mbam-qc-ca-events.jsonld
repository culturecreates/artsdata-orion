  {
    "@id": "https://www.mbam.qc.ca/fr/activites/l-ode-a-la-joie-beethoven-a-deux-pianos/",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "L'ode à la joie : Beethoven à deux pianos"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://billets.mbam.qc.ca/uploads/c2a2a2b1-7219-4ea8-8c11-2c242f160e5d.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Pour clôturer le Festival Beethoven, les pianistes virtuoses Philippe Cassard et Cédric Pescia nous présentent l'ultime chef-d’œuvre symphonique de Beethoven dans la passionnante transcription pour deux pianos qu’en fit un autre génie du romantisme et grand admirateur du maître, Franz Liszt.\n\tCe concert est présenté avec le soutien de la succession de Marie-Paule Laurans."
      }
    ],
