  {
    "@id": "https://www.mbam.qc.ca/fr/activites/u-un-canto/",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "U. (un canto)"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://billets.mbam.qc.ca/uploads/131f1bf2-cfb8-4173-a8dc-23b592f9941f.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "U. (un canto) est un concert-performance imaginé par Alessandro Sciarroni. Sept chanteurs a cappella interprètent un répertoire italien composé entre 1968 et 2019, mêlant voix, silences et déplacement vers le public. Ces chants évoquent nature, temps, sacré et fragilité de l’existence, tout en transmettant une mémoire vivante.  La dramaturgie musicale de U. s’articule autour des figures des compositeurs Renzo Bertoldo, Piercarlo Gatti, Bepi de Marzi, Angelo Mazza et Giorgio Susana.\n\tFormé aux arts plastiques, Alessandro Sciarroni crée depuis 2007 des œuvres à la croisée des disciplines. Lauréat du Lion d’Or à Venise en 2019, il est reconnu internationalement.En coproduction avec le Festival TransAmériques (FTA)"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.mbam.qc.ca/fr/activites/u-un-canto/"
      }
    ]
  },
