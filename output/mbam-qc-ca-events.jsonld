        "@value": "Les jeunes lions"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://billets.mbam.qc.ca/uploads/2d602b54-d4d7-4771-9e7b-690d6ad60066.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Reconnu pour ses interprétations vibrantes de classiques et ses compositions originales inventives, le Trio Caelan Cardello nous convie à une soirée placée sous le signe du mouvement Young Lions (Jeunes Lions), qui a revitalisé le jazz dans les années 1980-1990.Veuillez noter que le bar de la Salle Bourgie sera ouvert une heure avant le début du concert."
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.mbam.qc.ca/fr/activites/les-jeunes-lions/"
      }
    ]
