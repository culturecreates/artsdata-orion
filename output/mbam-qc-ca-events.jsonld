        "@language": "fr",
        "@value": "Hommage à Paul Motian"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://billets.mbam.qc.ca/uploads/92fa522d-5eb2-4b88-9eec-3a327e0608f1.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Formé à l'instigation de Bernard Riche, BR3 rend hommage aux compositions du célèbre et atypique batteur new-yorkais Paul Motian. L’univers riche et singulier de ce dernier transporte l’auditoire et offre une expérience unique, où créativité et originalité sont les maîtres mots.Veuillez noter que le bar de la Salle Bourgie sera ouvert une heure avant le début du concert."
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
