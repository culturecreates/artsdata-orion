      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Pour la 12e année consécutive, la Salle Bourgie est heureuse de vous présenter ce classique des Fêtes ! La célèbre trame sonore de Vince Guaraldi sera interprétée par des musiciens exceptionnels, accompagnés pour la première fois de la chanteuse Halie Loren.Veuillez noter que le bar de la Salle Bourgie sera ouvert une heure avant le début du concert."
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
