  {
    "@id": "https://www.mbam.qc.ca/fr/activites/cours-de-maitre-juilliard-string-quartet/",
    "http://ogp.me/ns#title": [
      {
        "@language": "fr",
        "@value": "Cours de maître - Juilliard String Quartet"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "fr",
        "@value": "website"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr",
        "@value": "https://billets.mbam.qc.ca/uploads/cb207276-f396-47e5-bc14-3b0b478562f2.jpg"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Le célèbre quatuor Juilliard String Quartet partage son expertise et conseille des étudiant.e.s avancé.e.s dans un cours de maître pour musique de chambre.\n\tUne belle occasion d'observer comment se déroule un enseignement musical de haut niveau et d'appréhender le répertoire de musique de chambre d'une manière différente.\n\tLe billet permet seulement d'assister au cours de maître. Les participants seront quant à eux sélectionnés par la Salle Bourgie.\n\tEn lien avec le concert Les derniers quatuors à cordes de Beethoven présenté le 23 mars 2027, à 19 h 30."
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://www.mbam.qc.ca/fr/activites/cours-de-maitre-juilliard-string-quartet/"
      }
    ]
  },
