    "http://ogp.me/ns#description": [
      {
        "@language": "fr",
        "@value": "Andrew Wan et Charles Richard-Hamelin font un retour très attendu à la Salle Bourgie lors d’une soirée entièrement consacrée aux œuvres pour piano et violon de Schubert. Un magnifique complément à notre intégrale des lieder qui en est à sa troisième année."
      }
    ],
