    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Camrose Sport Development Society The Wine and Spirits Fest is a vibrant social event where guests can indulge in a diverse selection of both wines, spirits and craft beer while supporting the Camrose Kodiak&rsquo;s hockey team. This event combines the best of fine wines, premium spirits, local craft beer and gourmet food. Attendees will enjoy &hellip;"
      }
