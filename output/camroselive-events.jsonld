  {
    "@id": "https://camroselive.ca/events/national-indigenous-peoples-day-with-lance-cardinal/",
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "NIPD with Lance Cardinal"
      },
      {
        "@language": "en-ca",
        "@value": "NIPD with Lance Cardinal - Jeanne & Peter Lougheed Performing Arts Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "National Indigenous Peoples Day is a day for all Canadians to recognize and celebrate the unique heritage, diverse cultures, and outstanding contributions of First Nations, Inuit and, Métis peoples. This year the Faculty of Education and Augustana Campus of the University of Alberta is thrilled to welcome children and educators onto our campus to celebrate with Lance Cardinal. Please join us as we engage in Reconciliation in a welcoming and affirming space."
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-ca",
        "@value": "article"
