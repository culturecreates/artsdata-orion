    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A unique performing arts venue located on the beautiful, historic University of Alberta’s’ Augustana Campus in the heart of the province."
      },
      {
        "@language": "en-ca",
        "@value": "Presented by Paquette Productions Direct from Las Vegas! It’s Saturday Night Fever every night with “The Australian Bee Gees Show – A Tribute to the Bee Gees”. One of the most successful and adored acts in musical history is recreated live in concert. You’ll hear hits like, “Staying Alive”, “You Should Be Dancing”, “How Deep …"
      }
