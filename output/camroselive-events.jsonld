    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A unique performing arts venue located on the beautiful, historic University of Alberta’s’ Augustana Campus in the heart of the province."
      },
      {
        "@language": "en-ca",
        "@value": "Celebrate the season with a country music legend! Canadian Country Music Hall of Fame inductee Michelle Wright brings her holiday magic to the stage with her special show, “Christmas Is Here.” With forty major awards, millions of albums sold, and twenty-five Top Ten radio hits, Michelle is one of Canada’s most successful and widely recognized …"
      }
