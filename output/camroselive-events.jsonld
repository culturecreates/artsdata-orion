    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Be Part of the Laughter! Experience &#8220;The Joy&#8221; with Brendan McLeod!Catch The Joy on four different dates &#8211; October 8 through the 11 at 7:00PM! This performance is part of the Special Presentations.The Joy will be livestreamed on October 10 &#8211; Get your digital ticket to see the show LIVE from home!Make sure to stay &hellip;"
      }
