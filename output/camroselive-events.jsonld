  {
    "@id": "https://camroselive.ca/events/glob/",
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Glob"
      },
      {
        "@language": "en-ca",
        "@value": "Glob - Jeanne & Peter Lougheed Performing Arts Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A unique performing arts venue located on the beautiful, historic University of Alberta’s’ Augustana Campus in the heart of the province."
      },
      {
        "@language": "en-ca",
        "@value": "“The show is particularly beautiful, unique and enchanting.” Catherine Doucet, Ici Radio-Canada Two strange characters appear on stage. They are fluffy, soft, and ageless. Will they find out where they are – and where they are going? They’re waiting…who? What? They wait while life goes by, looking for something to do…They take time to look …"
      }
    ],
