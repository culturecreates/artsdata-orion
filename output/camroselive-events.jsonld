  {
    "@id": "https://camroselive.ca/events/camrose-beatlemania/",
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Camrose Beatlemania!"
      },
      {
        "@language": "en-ca",
        "@value": "Camrose Beatlemania! - Jeanne & Peter Lougheed Performing Arts Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A unique performing arts venue located on the beautiful, historic University of Alberta’s’ Augustana Campus in the heart of the province."
      },
      {
        "@language": "en-ca",
        "@value": "Beatlemania is coming to The Cargill Theatre at the Jeanne and Peter Lougheed Performing arts Centre in Camrose on June 14, 2027.  Travel through time with The Beatles! From the electrifying Ed Sullivan debut to the soul-stirring Let It Be, The Liverpool 4 takes you on a magical journey through ever iconic era of The …"
