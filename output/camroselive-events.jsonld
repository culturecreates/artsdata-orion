    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A unique performing arts venue located on the beautiful, historic University of Alberta’s’ Augustana Campus in the heart of the province."
      },
      {
        "@language": "en-ca",
        "@value": "VaughnCo Entertainment is proud to present “Creedence Clearwater Arrival,” a powerhouse tribute celebrating the legendary music of Creedence Clearwater Revival – on of America’s most influential rock bands. The show authentically recreates the unmistakable sound, driving rhythm, and raw energy that defined CCR during their late-1960s and early-1970s prime. Built on commanding vocals, tight musicianship, …"
      }
