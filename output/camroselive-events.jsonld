    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A unique performing arts venue located on the beautiful, historic University of Alberta’s’ Augustana Campus in the heart of the province."
      },
      {
        "@language": "en-ca",
        "@value": "Presented By Affirmation Dance Affirmation Dance’s junior dancers performing in a Christmas recital to raise money for the Camrose Women’s Shelter. There is a talent show portion for all ages, where dancers compete for a cash prize of $150; all in good fun for a good cause in support of our community."
      }
    ],
