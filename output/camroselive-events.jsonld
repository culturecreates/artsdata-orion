  {
    "@id": "https://camroselive.ca/events/rumours-the-ultimate-fleetwood-mac-tribute-show/",
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Rumours: The Ultimate Fleetwood Mac Tribute Show"
      },
      {
        "@language": "en-ca",
        "@value": "Rumours: The Ultimate Fleetwood Mac Tribute Show - Jeanne & Peter Lougheed Performing Arts Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A unique performing arts venue located on the beautiful, historic University of Alberta’s’ Augustana Campus in the heart of the province."
      },
      {
        "@language": "en-ca",
        "@value": "VaughnCo Entertainment VaughnCo Entertainment is proud to present “Rumours” The Ultimate Fleetwood Mac tribute show based in Los Angeles, California. The group recreates the legendary band in its youthful heyday from 1975-1979.After finding huge success in Los Angeles, selling out their regular Roxy Theatre performances month after month, the band moved from the world famous …"
      }
    ],
    "http://ogp.me/ns#type": [
      {
        "@language": "en-ca",
        "@value": "article"
      }
