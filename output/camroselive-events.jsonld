    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Ashley Borody as the Ultimate Tribute to Adele Ashley not only looks like Adele but sounds like Adele, she flawlessly captures the essence of Adele&rsquo;s signature sound which will leave you breathless. Ashley&rsquo;s powerful voice is one of the most authentic Adele tribute shows touring today. Sold out shows in Canada and USA always ending &hellip;"
      }
