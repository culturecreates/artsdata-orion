    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "World Premiere Tour This performance is part of the BrokerLink Presentation Series. A Fun, Appealing StoryWilliam Shakespeare&rsquo;s A Midsummer Night&rsquo;s Dream is one of his most beloved comedies. Four Athenians find themselves in a forest inhabited by fairies who manipulate the humans and are engaged in their own domestic intrigue. It is a lighthearted, humourous &hellip;"
      }
