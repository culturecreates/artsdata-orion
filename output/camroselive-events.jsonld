    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A unique performing arts venue located on the beautiful, historic University of Alberta’s’ Augustana Campus in the heart of the province."
      },
      {
        "@language": "en-ca",
        "@value": "Experience the “magical” chemistry of The Black Feathers, an award-winning duo featuring married singer-songwriters Ray Hughes and Sian Chandler. Whether they are performing original “gloriously sad ear-worms” or inventive covers like their “sassy” take on Portishead’s “Glory Box,” their profound stage chemistry and “telepathic understanding” provide an intimate and “riveting” live experience. Currently residing in …"
      }
