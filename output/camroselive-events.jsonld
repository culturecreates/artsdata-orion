    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A unique performing arts venue located on the beautiful, historic University of Alberta’s’ Augustana Campus in the heart of the province."
      },
      {
        "@language": "en-ca",
        "@value": "This performance is part of the BrokerLink Presentation Series and is show sponsored by Boston Pizza. Steven Page’s distinctive and powerful voice is among the most instantly recognizable in popular music.  He is a member of the Canadian Music Hall of Fame with former bandmates, Barenaked Ladies, the award-winning band he co-founded.  As one of …"
      }
