    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A unique performing arts venue located on the beautiful, historic University of Alberta’s’ Augustana Campus in the heart of the province."
      },
      {
        "@language": "en-ca",
        "@value": "Step into the world of velvet voices and swinging rhythms with Crooner Kings: A Night of Timeless Melodies, a captivating theatre experience celebrating the songs made famous by the great crooners. This show pays tribute to iconic artists like Frank Sinatra, Dean Martin, Nat King Cole, Tony Bennett, and Michael Bublé, and many others—bringing their …"
      }
