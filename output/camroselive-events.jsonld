    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Step right up, step right up! Prepare to be razzled and dazzled. This delightful cabaret harkens back to the olden days of traveling carnivals featuring some of Edmonton's best burlesque performers of national and international acclaim, including Violette Coquette, the current reigning Monarch of Imperial Burlesque of Canada."
      }
    ],
