  {
    "@id": "https://camroselive.ca/events/louisiana-hayride-show/",
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Louisiana Hayride Show"
      },
      {
        "@language": "en-ca",
        "@value": "Louisiana Hayride Show - Jeanne & Peter Lougheed Performing Arts Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Always something new!Take a trip down memory lane with this unique and incredibly entertaining musical celebration.The Louisiana Hayride Show, with amazing world class tribute artists and live band will bring you back in time to when songs were meaningful, the words were understood and the sound was pleasant."
      },
      {
