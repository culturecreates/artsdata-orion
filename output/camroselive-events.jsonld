      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "You can catch “Tomatoes Tried To Kill Me But Banjos Saved My Life” on 3 different dates: October 22 at 7:30PMOctober 24 at 7:30PM October 25 at 3:00PM When faced with a deadly cancer battle, his musical pursuit took him on a journey that became the key to saving his life. Told through authentic storytelling, &hellip;"
      }
    ],
