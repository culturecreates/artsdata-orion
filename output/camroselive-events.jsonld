    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A unique performing arts venue located on the beautiful, historic University of Alberta’s’ Augustana Campus in the heart of the province."
      },
      {
        "@language": "en-ca",
        "@value": "Presented by: Ballet Camrose  An adapted Ballet Musical of favourite Grimm’s fairytale characters such as Cinderella , Jack and the Beanstalk , Rapunzel , Little Red Riding Hood. The story revolves around the Baker and his wife who desperately want a child!  Hoping for Happy ever after ending …the characters go on a quest for …"
      }
