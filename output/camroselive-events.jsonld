    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Dear gentle reader,Step into the opulent world of the Ton with By Moonlight: The Music of Bridgerton! This enchanting concert experience merges pop royalty with classical grace, featuring The Valkyrie String Quartet, that reimagines the most iconic melodies from the hit series. From sweeping romantic themes to modern pop favorites transformed into lush, classical arrangements, &hellip;"
      }
