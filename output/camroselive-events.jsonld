    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A unique performing arts venue located on the beautiful, historic University of Alberta’s’ Augustana Campus in the heart of the province."
      },
      {
        "@language": "en-ca",
        "@value": "Get ready for an adrenaline-fueled adventure as the Banff Centre Mountain Film Festival World Tour brings the world’s best outdoor films to the big screen! Experience breathtaking landscapes, heart-pounding action, and inspiring stories of courage and resilience from filmmakers and explorers around the globe. From high-altitude climbs to deep-sea dives, this unforgettable cinematic journey will …"
      }
