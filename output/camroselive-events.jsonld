    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Camrose, our Season Launch 2026 is set for June 11th, 2026! Prepare for the Jeanne and Peter Lougheed Performing Arts Centre&rsquo;s season launch showcasing one of our Strada Coffee Co. &amp; Artisan Bakery Summer Series artists, Brasstactics, presenting giveaways, and giving you a first-chance look at what shows we&rsquo;re bringing to Camrose! Plus, you&rsquo;ll save &hellip;"
      }
    ],
