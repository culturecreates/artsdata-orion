    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "This performance is part of the BrokerLink Presentation Series and is show sponsored by Boston Pizza. Steven Page&rsquo;s distinctive and powerful voice is among the most instantly recognizable in popular music. &nbsp;He is a member of the Canadian Music Hall of Fame with former bandmates, Barenaked Ladies, the award-winning band he co-founded.&nbsp; As one of &hellip;"
      }
