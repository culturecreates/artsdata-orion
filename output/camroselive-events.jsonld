      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A unique performing arts venue located on the beautiful, historic University of Alberta’s’ Augustana Campus in the heart of the province."
      },
      {
        "@language": "en-ca",
        "@value": "Camrose Sport Development Society The Wine and Spirits Fest is a vibrant social event where guests can indulge in a diverse selection of both wines, spirits and craft beer while supporting the Camrose Kodiak’s hockey team. This event combines the best of fine wines, premium spirits, local craft beer and gourmet food. Attendees will enjoy …"
      }
    ],
