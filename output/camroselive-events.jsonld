      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The rebroadcast will begin with a short film by Gord Downie&rsquo;s brother, Mike, called A Beautiful Thing, which includes behind-the-scenes tour footage and notable Canadians sharing what The Hip means to them. Ten years ago, The Tragically Hip took the stage for the final time in their hometown of Kingston, Ontario. That extraordinary night has &hellip;"
      }
