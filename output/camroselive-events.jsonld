    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "VaughnCo Entertainment VaughnCo Entertainment is proud to present &#8220;Rumours&#8221; The Ultimate Fleetwood Mac tribute show based in Los Angeles, California. The group recreates the legendary band in its youthful heyday from 1975-1979.After finding huge success in Los Angeles, selling out their regular Roxy Theatre performances month after month, the band moved from the world famous &hellip;"
      }
