  {
    "@id": "https://camroselive.ca/events/edmonton-youth-orchestra-presents-music-from-the-ballet/",
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Edmonton Youth Orchestra Presents: Music from the Ballet"
      },
      {
        "@language": "en-ca",
        "@value": "Edmonton Youth Orchestra Presents: Music from the Ballet - Jeanne & Peter Lougheed Performing Arts Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A unique performing arts venue located on the beautiful, historic University of Alberta’s’ Augustana Campus in the heart of the province."
      },
      {
        "@language": "en-ca",
        "@value": "Join the Edmonton Youth Orchestra for an enchanting evening of symphonic storytelling in “Music from the Ballet” – a celebration of timeless works that have graced the ballet stage and concert hall alike. Led by Michael Massey, this captivating performance features Tchaikovsky’s beloved Swan Lake Suite, bringing the magic and drama of the classic ballet …"
      }
    ],
