    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A unique performing arts venue located on the beautiful, historic University of Alberta’s’ Augustana Campus in the heart of the province."
      },
      {
        "@language": "en-ca",
        "@value": "Experience the JUNO-nominated powerhouse of Burnstick, a Canadian folk duo whose two voices blend into one musical force of soul-stirring, cinematic landscapes. Anchored by the resonant Weissenborn lap slide guitars of Plains-Cree guitarist Jason Burnstick and the harmonies of francophone-Metis vocalist Nadia Burnstick, their sound is at once resonate and “profound”. They are partners in …"
      }
