    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A unique performing arts venue located on the beautiful, historic University of Alberta’s’ Augustana Campus in the heart of the province."
      },
      {
        "@language": "en-ca",
        "@value": "By Our Lady of Mount Pleasant School “Tom Sawyer” is a full-length comedic play adapted for stage by Paul Kester, inspired by Mark Twain’s beloved novel. The well-known characters and scenes from Twain’s classic are skillfully condensed to emphasize the dramatic aspects of the entire performance. This lively portrayal of American boyhood is sure to …"
      }
