    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "from Green Thumb Theatre This performance is part of the Fountain Tire Family Series. Due to the strike, this essential, award-winning show is now a FREE public show on Oct 29th at 7:00pm. RSVP now to reserve your seats! What does it mean to be part of the in-crowd? In an imaginary letter to her &hellip;"
      }
    ],
