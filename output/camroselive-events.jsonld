    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Experience the JUNO-nominated powerhouse of Burnstick, a Canadian folk duo whose two voices blend into one musical force of soul-stirring, cinematic landscapes. Anchored by the resonant Weissenborn lap slide guitars of Plains-Cree guitarist Jason Burnstick and the harmonies of francophone-Metis vocalist Nadia Burnstick, their sound is at once resonate and &ldquo;profound&rdquo;. They are partners in &hellip;"
      }
    ],
