    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A unique performing arts venue located on the beautiful, historic University of Alberta’s’ Augustana Campus in the heart of the province."
      },
      {
        "@language": "en-ca",
        "@value": "Featuring Zachary Stevenson with the Rockin’ Royals BandPresented by Paquette Productions From the internationally acclaimed “Buddy Holly Story”, Zachary Stevenson performs an exciting tribute to Buddy Holly LIVE in concert. One of the first Rock ‘n’ Roll Hall of Fame Inductees, Buddy Holly wrote and performed countless hit songs during the mid-1950s such as “That’ll …"
      }
