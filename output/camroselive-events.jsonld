    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A unique performing arts venue located on the beautiful, historic University of Alberta’s’ Augustana Campus in the heart of the province."
      },
      {
        "@language": "en-ca",
        "@value": "Get ready for a world of musical madness as lifelong friends Nico Rhodes and Patrick Courtin set off on a divine quest to prove that the piano is the coolest instrument of all time! Armed with 21st-century technology and the greatest music of the last 300 years, this dynamic duo delivers a high-energy “mishmash” featuring …"
      }
