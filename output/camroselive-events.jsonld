    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Acclaimed roots songwriters John Wort Hannam and T. Buckley make up The Woodshed, a modern folk duo based in Alberta, whose name refers to the beginning of Buckley and Hannam&#x2019;s collaboration - woodshedding songs together during a residency at the Banff Centre for Arts and Creativity in 2017."
      }
