    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Celebrate the holidays with Alberta’s own Jann Arden as she puts her unique spin on the classics you know and love, featured on her 2015 release ‘A Jann Arden Christmas’. Arden is a multi-platinum, award-winning singer, songwriter, actor and best-selling author."
      }
