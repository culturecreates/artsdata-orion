      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A unique performing arts venue located on the beautiful, historic University of Alberta’s’ Augustana Campus in the heart of the province."
      },
      {
        "@language": "en-ca",
        "@value": " The extraordinary dance show showcases the festival and competition dances of Ballet Camrose Dance Company in many genres such as Cecchetti ballet, tap, jazz ,contemporary, pointe, acro, and lyrical; aspiring solos and duets are also performed!!"
      }
    ],
