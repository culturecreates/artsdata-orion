    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A unique performing arts venue located on the beautiful, historic University of Alberta’s’ Augustana Campus in the heart of the province."
      },
      {
        "@language": "en-ca",
        "@value": "This performance is part of the BrokerLink Presentation Series and is show sponsored by AdMax Billboards. Hawksley Workman is a JUNO Award-winning and Gold Record certified singer-songwriter and multi-instrumentalist. Since his ground-breaking self-produced indie debut For Him and The Girls (1999) through to chart-topping singles of 2020, Hawksley has careened between major label international smash …"
      }
