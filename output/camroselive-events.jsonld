    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Important Update: Postponement of The Woodshed"
      },
      {
        "@language": "en-ca",
        "@value": "Important Update: Postponement of The Woodshed - Jeanne & Peter Lougheed Performing Arts Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Acclaimed roots songwriters John Wort Hannam and T. Buckley make up The Woodshed, a modern folk duo based in Alberta, whose name refers to the beginning of Buckley and Hannam’s collaboration - woodshedding songs together during a residency at the Banff Centre for Arts and Creativity in 2017."
      }
    ],
