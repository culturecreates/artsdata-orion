  {
    "@id": "https://camroselive.ca/events/travis-dolter/",
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Travis Dolter"
      },
      {
        "@language": "en-ca",
        "@value": "Travis Dolter - Jeanne & Peter Lougheed Performing Arts Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Infuse together an abundance of energy, a witty sense of humour, an engaging stage presence with solid vocals, and you have Travis Dolter. Combine this with stories, acoustic interludes, outstanding harmonies, memorable solos, and comical stage banter, and you have revealed a hint of the performance that you will experience."
      }
    ],
