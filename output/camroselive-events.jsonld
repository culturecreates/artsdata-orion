      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "The Yellow Brick Road Experience Featuring Andrew Johns live in concert.\nExperience first hand how Andrew commands the stage with his spot on piano and vocal skills that take you back to Elton John in his prime!&#xA0;\nAndrew Johns featuring his band, The Jets, with full horn section , playing all the hits in the original keys as performed by Sir Elton John."
      }
    ],
