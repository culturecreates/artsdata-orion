    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A unique performing arts venue located on the beautiful, historic University of Alberta’s’ Augustana Campus in the heart of the province."
      },
      {
        "@language": "en-ca",
        "@value": "Make sure to stop out in the lobby and say hi to the Leduc Brewing Company and grab a bevvy! In her deeply personal show, My Roots Are Showing, Tracy Millar breathes life into timeless classics from the golden era while weaving in her own soul-searching original tales of love and heartbreak. Whether she is …"
      }
    ],
