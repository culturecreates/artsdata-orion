    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Camrose Veselka Ukrainian Dancers Camrose Veselka Ukrainian Dancers Annual Spring Concert It is a family-friendly afternoon to celebrate Ukrainian culture through dance. There will be lively music, an array of colourful costumes, and performances by dancers of all ages. This is the final concert for the 2024-2025 dance year showcasing the growth, skill, and accomplishments &hellip;"
      }
