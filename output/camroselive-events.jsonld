    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "The Stampeders…One More Time"
      },
      {
        "@language": "en-ca",
        "@value": "The Stampeders...One More Time - Jeanne & Peter Lougheed Performing Arts Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A unique performing arts venue located on the beautiful, historic University of Alberta’s’ Augustana Campus in the heart of the province."
      },
      {
        "@language": "en-ca",
        "@value": "Presented By Shantero Productions Inc. ‘They’re on their way, to the city lights’ … and, THE predominant Canadian Rock ‘n’ Roll band of the 1970s – The Stampeders – are bringing along all their classic hits: Wild Eyes, Carry Me, Oh My Lady, Devil You, Ramona, Minstrel Gypsy, Hit the Road Jack and, of course, …"
      }
    ],
