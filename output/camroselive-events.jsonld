    "http://schema.org/name": [
      {
        "@language": "en",
        "@value": "Bangs, Bobs, &amp; Banter: Confessions of a Hairstylist (18+ ONLY)"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Multi-award-winning writer and performer Joanna Rannelli of Gravity Theatre is bringing her hit one-woman comedy, Bangs, Bobs &amp; Banter: Confessions of a Hairstylist, to Camrose! Following sold-out runs in Stratford, Vancouver, Edmonton, and Orlando, Joanna embodies Nikki, a charismatic hairstylist with a knack for storytelling. Drawing inspiration from real-life encounters, Nikki invites audiences into her &hellip;"
      }
    ],
