  {
    "@id": "https://camroselive.ca/events/yellow-brick-road-experience/",
    "http://ogp.me/ns#title": [
      {
        "@language": "en-ca",
        "@value": "Yellow Brick Road Experience"
      },
      {
        "@language": "en-ca",
        "@value": "Yellow Brick Road Experience - Jeanne & Peter Lougheed Performing Arts Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "The Yellow Brick Road Experience Featuring Andrew Johns live in concert.Experience first hand how Andrew commands the stage with his spot on piano and vocal skills that take you back to Elton John in his prime! Andrew Johns featuring his band, The Jets, with full horn section , playing all the hits in the original keys as performed by Sir Elton John."
      },
      {
        "@language": "en-ca",
        "@value": "The Yellow Brick Road Experience Featuring Andrew Johns live in concert. Experience first hand how Andrew commands the stage with his spot on piano and vocal skills that take you back to Elton John in his prime!  Andrew Johns featuring his band, The Jets, with full horn section , playing all the hits in the original keys as performed by Sir Elton John."
      }
