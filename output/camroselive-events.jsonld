    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "A unique performing arts venue located on the beautiful, historic University of Alberta’s’ Augustana Campus in the heart of the province."
      },
      {
        "@language": "en-ca",
        "@value": "Sponsored by the Camrose Pregnancy Care Centre Get ready for an evening filled with side-splitting laughter! The Jeanne & Peter Lougheed Performing Arts Centre is thrilled to present a special Comedy Night, sponsored by the Camrose Pregnancy Care Centre, featuring the incredibly talented Matt Falk! The CBC calls him “Effortlessly Funny,” and for good reason! …"
      }
