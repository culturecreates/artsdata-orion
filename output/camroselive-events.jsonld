        "@value": "I’m a Soulman"
      },
      {
        "@language": "en-ca",
        "@value": "I'm a Soulman - Jeanne & Peter Lougheed Performing Arts Centre"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "en-ca",
        "@value": "Chris and Geoff Dahl, real brothers from London, Ontario, Canada mastered their craft as bluesmen in the early 90’s while performing and recording with several R&B/Blues/Pop recording acts including BLACK AVALON (A&M Records) CASSANDRA VASIK (Epic Records) THE BUSHDOCTORS (A&M Records), MELODY DURRANT (Motown/Universal) and the world famous OLD CHICAGO’S BLUES BAND (Speakeasy Records)!"
      }
    ],
