    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "This is a co-presentation with the University of Alberta and the Jeanne and Peter Lougheed Performing Arts Centre. This co-presentation is open to the public at both 1:00PM and 7:30PM. For livestream registration for this event, click here.The 1:00PM matinee show will have a &#8220;talk back&#8221; with Reneltta Arluk. Paw&acirc;kan Macbeth is Reneltta Arluk&rsquo;s groundbreaking &hellip;"
      }
