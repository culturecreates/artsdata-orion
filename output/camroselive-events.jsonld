    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": "Experience the &ldquo;magical&rdquo; chemistry of The Black Feathers, an award-winning duo featuring married singer-songwriters Ray Hughes and Sian Chandler. Whether they are performing original &ldquo;gloriously sad ear-worms&rdquo; or inventive covers like their &ldquo;sassy&rdquo; take on Portishead&rsquo;s &ldquo;Glory Box,&rdquo; their profound stage chemistry and &ldquo;telepathic understanding&rdquo; provide an intimate and &ldquo;riveting&rdquo; live experience. Currently residing in &hellip;"
      }
    ],
