  {
    "@id": "https://voir.lactualite.com/genid/8d42bab28121dc48",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-06-10T00:00:00-04:00"
      }
