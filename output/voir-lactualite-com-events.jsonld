    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Celebrate Halloween at Hampstead's Halloween Movie Event"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Goosebumps, Giggles & Halloween Fun Await! Get ready for a spook-tacular morning at Hampstead's annual Halloween Movie Event! Join us on Sunday, October 25 at 11 a.m. at 30 Lyncroft for a family-friendly screening of Goosebumps and a variety of Halloween-themed activities. Young moviegoers will enjoy fun workshops, including Candy Sushi and Halloween Slime, while families can visit the concession stand for popcorn, pizza, hot dogs, candy and more. Costumes are encouraged, laughter is guaranteed, and a few surprises may be lurking around the corner! Admission: Residents: $5 Non-residents: $10 *Suitable for children 8 years and older."
      }
    ],
