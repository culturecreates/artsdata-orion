  {
    "@id": "https://voir.lactualite.com/genid/5f4ef329a3f55058",
    "@type": [
      "http://schema.org/ComedyEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-04-24T19:30:00-04:00"
      }
