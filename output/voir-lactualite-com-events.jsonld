    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Babouche"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Babouche est un spectacle musical de l'Ensemble Strada, présenté dans la série Sons et Brioches de l'Aramusique. Quatre clowns musiciens arrivent sur scène avec une charrette remplie d'instruments mystérieux et jouent avec les mots, mêlant voix, instruments, paroles et art clownesque. Ils jonglent, notamment dans le noir, et se livrent à des acrobaties verbales. La mise en scène est de Christine Rossignol-Dallaire et la direction musicale de Pierre Langevin."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
