    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/alphe-gagne-on-repart-052147"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Alphé Gagné – On repart"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "ON REPART, c'est le nouveau spectacle qu'Alphé Gagné rode. Dans ce nouvel opus (ouais… ça sonne le White Album des Beatles), il tente de répondre à la fameuse question : « T'as pas fait d'humour pendant 20 ans… qu'est-ce que tu faisais? ». RIEN PENTOUTE…ben non, il en a fait des affaires… Paternité. Maladie. Mort. (Pas lui, parce que tsé…) Rêves. Peurs. Échecs. Réussites. ON REPART, c'est du nouveau matériel, des nouvelles blagues; mais toujours un beau t-shirt noir. Alphé est rendu au zénith de sa quarantaine. L'âge où t'as encore l'énergie de tes rêves… mais les genoux de tes cauchemars. Il veut se mettre en danger. Quitte à se lever dans chaloupe. Il va parler de lui en parlant de vous. Un spectacle sur lui. Un miroir sur vous. Ensemble, ON REPART."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
