    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/antoine-larocque-le-fantome-de-robert-filliou-lp11-139"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Antoine Larocque / Le fantôme de Robert Filliou"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le fantôme de Robert Filliou est une installation réalisée durant une résidence d'un mois au Lieu – centre en art actuel. Le projet s'appuie sur les archives du magazine Inter et sur d'autres artéfacts conservés dans le sous-sol du centre. Cette matière sera échantillonnée et remixée : textes, images, couvertures, publicités, objets, etc. Elle sera mise en tension avec des déchets et des fragments recueillis pendant la résidence et autour du Lieu. Je chercherai à voir ce qui peut émerger de la rencontre entre les images et les discours qui ont traversé les pages du magazine et le quotidien d'une résidence de création dans le quartier Saint-Roch, en octobre 2026. Robert Filliou, figure mythique de l'histoire de l'art intimement liée au Lieu, sera invoqué lors de séances de spiritisme performatives qui ponctueront la résidence et orienteront, peut-être, le processus de création."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
