    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Enfin en rodage"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Léa Stréliski est une humoriste et auteure québécoise. Son premier spectacle, Plus de peur que de mal, a été acclamé par le public et la critique, récoltant plusieurs prix Olivier, dont celui de Spectacle de l'année. Elle y aborde l'anxiété, les relations humaines et la quête de sens avec une écriture fine et une autodérision touchante. Son spectacle suivant, Moins une, poursuit cette invitation à rire de soi et du monde."
      }
    ],
