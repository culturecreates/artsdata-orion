    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Atelier – HAÏKUVERTURES"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "L’atelier débute par une brève initiation au haïku, poème japonisant en 3 vers comportant une césure et une référence à une saison. Les participants et participantes créent ensuite un haïku en empilant 3 titres de livres. Les meilleures créations pourront paraître dans la revue Entrevous. Suivre les Bibliothèques de Laval sur les médias sociaux : Facebook YouTube Renseignements [phone] Site Internet des Bibliothèques de Laval Bibliothèque Gabrielle-Roy [phone] 3505, boulevard Dagenais Ouest Laval H7P 4V9 Besoin d'aide? Clavardez avec la ville! Clavarder avec la Ville Recaptcha requires verification. protected by reCAPTCHA"
      }
    ],
