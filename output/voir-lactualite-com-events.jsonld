    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 14 novembre 2026 à 20 h, à Lieu à préciser – Magog (Magog). Charles Brunet est un humoriste qui a présenté auparavant le spectacle « Très très bon show ». Dans ce spectacle, il se décrit à 24 ans comme quelqu'un qui ne comprend pas grand-chose à la vie, mais qui commence à comprendre son…"
      }
