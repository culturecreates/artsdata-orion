      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Barenaked Ladies"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le groupe canadien Barenaked Ladies, composé de quatre membres, compte une carrière de 38 ans et plus de 15 millions d'albums vendus dans le monde. Ses succès comprennent « If I Had $1,000,000 », « One Week », « Pinch Me » et le thème de la série The Big Bang Theory. Le groupe a remporté huit prix JUNO, a reçu deux nominations aux GRAMMY Awards et a été intronisé au Canadian Music Hall of Fame. Son 18e album studio, In Flight, est paru en 2023 et compte 14 nouvelles chansons ; au printemps 2025, il a lancé In Flight – Carry On, un mini-album numérique de versions acoustiques. Après une absence de 12 ans à Montréal, Barenaked Ladies revient en ville pour une seule prestation à L'Olympia."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
