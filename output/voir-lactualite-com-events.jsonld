      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Du romantisme à l’impressionnisme"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Violoniste au timbre incandescent et à la présence magnétique, Julia Mirzoev fait vibrer toutes les scènes. Ses interprétations, à la fois fougueuses et d’une grande délicatesse, ont enchanté l’Amérique du Nord, l’Europe et la Nouvelle‑Zélande. Lauréate de nombreux concours internationaux, elle a notamment joué à Carnegie Hall, à la Maison symphonique et avec le Toronto Symphony."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
