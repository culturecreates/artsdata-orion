      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 13 février 2027 à 0 h, à L'Olympia (Montréal). Les rodages vont bon train pour Christine Morency, qui présentera son deuxième « one-woman show » « Bien faite » en grande première l’hiver prochain. De nombreuses dates affichent déjà complet et des supplémentaires s’ajoutent présentement à la…"
      }
    ],
