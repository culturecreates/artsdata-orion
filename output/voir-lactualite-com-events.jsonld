    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 22 septembre 2026 à 0 h, à Musée des Beaux Arts de Montréal (Montréal). Visite guidée de la collection d'art international du MBAM du Moyen Âge à l'époque contemporaine."
      }
    ],
    "http://ogp.me/ns#url": [
