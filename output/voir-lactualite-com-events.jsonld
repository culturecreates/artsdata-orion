    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "BELLADONNA - Hommage aux Chanteuses Rock"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "BELLADONNA - L’ultime hommage aux chanteuse Rock! Une voix lead puissante et juste, une énergie brute et un spectacle électrisant célébrant les icônes telles que Janis Joplin, Melissa Etheridge, Heart, Tina Turner, Alanis Morissette, Evanescence et plusieurs autres! Une soirée explosive où les plus grands hymnes féminins du ROCK reprennent vie - une expérience à ne pas manquer! Belladonna offre une performance dynamique et mémorable qui enflamme toutes les scènes! À ne pas manquer — soyez des nôtres! BELLADONNA - L’ultime hommage aux chanteuse Rock! Une voix lead puissante et juste, une énergie brute et un spectacle électrisant célébrant les icônes telles que Janis Joplin, Melissa Etheridge, Heart, Tina Turner, Alanis Morissette, Evanescence et plusieurs autres! Une soirée explosive où les plus grands hymnes féminins du ROCK reprennent vie - une expérience à ne pas manquer! Belladonna offre une performance dynamique et mémorable qui enflamme toutes les scènes! À ne pas manquer — soyez des nôtres!"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
