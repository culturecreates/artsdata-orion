    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Belle Grand Fille"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Jeudis Shows Hydro-Québec Autrice-compositrice-interprète reconnue pour son univers empreint de beauté et d'authenticité, Belle Grand Fille présente Noël nouvelet, un spectacle lumineux qui marie le folk à la musique ancienne. Puisant dans les cantiques de Noël des 15e et 16e siècles, elle revisite ces airs intemporels avec une approche dépouillée et délicate. Pour l'occasion, elle s'entoure des autrices-compositrices-interprètes Jeanne Côté et Sandra Contour, ainsi que de trois musiciens, pour redonner vie à ce répertoire dans un esprit de partage et de plaisir musical. Portées par la voix chaleureuse de Belle Grand Fille, ces mélodies offrent une parenthèse douce et rassembleuse, parfaite pour ralentir et savourer les derniers jours de l'année en musique. * Ce spectacle n'est pas admissible à la promotion « Spectacle gratuit à l'achat de 3 spectacles »."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
