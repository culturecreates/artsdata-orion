    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Broue"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Ses personnages hauts en couleurs font partis de notre imaginaire collectif, dans un portrait d'un Québec pré-référendaire, à la veille d'une invasion qui menacent leur aire protégée : l'arrivée des femmes dans ce lieu sacro-saint qu'est... la Taverne ! Bob, Pointu, Verrue, Travolta et tous les autres continueront de vivre et de vous faire rire."
      }
    ],
