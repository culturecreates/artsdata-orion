    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Cozic by Etienne Desrosiers and Céline B. La Terreur"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Portrait of the Canadian artist duo Cozic, composed of Monique Brassard ( 1944 ) and Yvon Cozic ( 1942 ). United in life and creation, the couple works with industrial materials in vibrant colors to create ecological and playful artworks. From the carefree hippie years of the 1960 s to major public art commissions, their work reflects the evolution of our relationship with nature and the industrial world. Today, from their remarkable estate in Sainte-Anne-de-la-Rochelle in the Eastern Townships, the duo is preparing for their major retrospective at the Musée national des beaux-arts de Québec. A deep dive into the fantastical world of these unconventional artists. | Free admission."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
