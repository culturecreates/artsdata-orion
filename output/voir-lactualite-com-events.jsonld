    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 16 janvier 2027 à 0 h, à Museum of Civilization (Québec). Step into Vivaldi's world and discover the passion, drama and elegance of Baroque music. Featuring some of his most celebrated compositions, this Candlelight concert invites you to experience centuries of musical brilliance. This concert…"
      }
