        "@id": "https://voir.lactualite.com/genid/0dda5f7ebb313b05"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://cdn.placedesarts.com/tranforms/_3000x1293_crop_center-center_92_none_ns/2095035/ChoeurClassique27_2400x1035.jpeg"
      }
    ],
    "http://schema.org/url": [
      {
