    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Éveil à la musique traditionnelle"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Trois ateliers sont prévus afin de s’éveiller à la musique traditionnelle avec l’accompagnement d’une porteuse de traditions, Claudine St-Arnauld. Cette série d’ateliers où les enfants seront actifs et en mouvement, s’adresse à des familles qui souhaitent vivre une introduction au patrimoine vivant musical! Inscription obligatoire (formulaire à remplir)"
      }
    ],
