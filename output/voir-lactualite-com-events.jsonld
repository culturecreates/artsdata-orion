    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Agnes Obel"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Pour son premier passage dans la province en près de 10 ans, l’autrice-compositrice-interprète danoise viendra présenter à ses amateurs québécois les titres de son nouvel album, The Meaning of Flowers, sorti la semaine dernière. Elle se produira au Théâtre Capitole de Québec le 24 mai, puis au Théâtre St-Denis le lendemain."
      }
    ],
