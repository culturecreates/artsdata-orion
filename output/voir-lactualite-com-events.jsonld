    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Blue Riders"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "SCÈNE LOCALE À la demande générale, les Blue Riders (ex Blues Riders) vous reviennent avec un répertoire renouvelé. Venez vibrer au son des chansons rock qui vous ont marquées. Plaisir assuré avec des musiciens hors pair : Éric Lafrenière, Louis Désilets, Pat Blonk, Steve Archambault, Annie Martin et JP Lévesque. À ne pas manquer !"
      }
    ],
