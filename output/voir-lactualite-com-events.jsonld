  {
    "@id": "https://voir.lactualite.com/genid/e072c8751f6d9565",
    "@type": [
      "http://schema.org/ComedyEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-02-09T20:00:00-05:00"
      }
