    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Apéro-theater evening"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Surprise Surprise is coming to the Grand Lodge Mont-Tremblant on November 14 and 15! Following the huge success of Michel Tremblay's comedy this summer, Théâtre Les Éperdus invites you to two evenings of aperitif theater! Immerse yourself in the world of the 1960s with this comedy full of twists, turns, and misunderstandings! Starting at 5 p.m., aperitif theater package. Limited seating, $30 per person. Reserve here."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
