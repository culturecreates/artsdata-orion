    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Créer ensemble"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Au long de la session, les participants développeront des projets personnels dans une ambiance chaleureuse et collaborative favorisant l’entraide entre tous. Le but est de cultiver sa créativité, d’échanger son savoir-faire et de tisser des liens authentiques autour d’une passion commune pour les arts visuels. Cet atelier s’adresse aux débutants comme aux plus avancés."
      }
    ],
