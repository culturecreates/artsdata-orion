      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Blanc Dehors"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Ce spectacle fait partie de la série Les Sessions du Vieux Couvent, présentée dans le studio de Gab Bouchard (rdv au Vieux Couvent, une navette vous amènera jusqu'au studio). Une formule unique, en toute proximité, où un nombre limité de spectateurs est invité à vivre la musique autrement, dans un lieu de création vivant, intime et inspirant. Faites vite, il n'y a que 30 places disponibles. Blanc Dehors, c’est une vague électrique qui oscille entre fureur et douceur, entre rythmes dansants et atmosphères planantes qui happent dès les premières notes. Porté par des textes sensibles et une énergie scénique contagieuse, le groupe nous entraîne dans un univers new wave, postpunk et synth pop qu’on vit autant qu’on l’écoute. Des refrains accrocheurs, une section rythmique solide et cette impression grisante d’être exactement là où il faut être. Merci au Gouvernement du Québec de soutenir cette série."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
