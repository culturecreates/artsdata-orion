  {
    "@id": "https://voir.lactualite.com/genid/dbbaedb32596211d",
    "@type": [
      "http://schema.org/ComedyEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-01-29T20:00:00-05:00"
      }
