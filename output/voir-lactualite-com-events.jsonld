    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Bon Jus"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Arnaud Soly revient sur scène avec son deuxième one-man-show : BON JUS. Il s’agit de son meilleur à ce jour (selon lui!) Pourquoi ça s’appelle BON JUS? C’est bizarre, non? Ça serait trop compliqué à expliquer. Venez le découvrir en salle. Vous allez rigoler, c’est promis. Auteurs : Arnaud Soly et Julien Corriveau Éclairage et décor : Robin Kittel-Ouimet Musique : France Basilic et Julien Corriveau Conseiller à la mise en scène : Charles Dauphinais"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
