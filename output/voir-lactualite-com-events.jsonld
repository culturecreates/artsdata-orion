    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Athur l'Aventurier Africanimaux"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dès l'ouverture du rideau, Arthur fera voyager les jeunes familles sur scène dans un décor illustrant la savane africaine du Parc national du Serengeti situé en Tanzanie. Dans un spectacle où s'entremêlent histoires d'aventures et chansons, Arthur parlera de ses rencontres avec les éléphants, les lions, les hippopotames, les guépards, les babouins, les zèbres, les autruches, les buffles, les hyènes et plus encore."
      }
    ],
    "http://schema.org/inLanguage": [
