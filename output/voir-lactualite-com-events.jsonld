    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Au Secours"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Rien ne va plus à l’hôpital Notre-Dame-de-la-Souffrance. Avec les coupures, médecins, infirmières et patients tous sont sur un pied de guerre. La privatisation serait-elle la solution? Bob Sirois et sa femme Nicole, ex-propriétaire d’un McDonald’s, sauveront-ils le système hospitalier avec leurs techniques de gestion et de marketing? Une comédie dans la pure tradition du style de son autrice."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
