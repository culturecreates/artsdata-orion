      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Grâce à la nouvelle création du Théâtre à Tempo, vous serez transporté sur un plateau télé des années 1960 dans une comédie rythmée et éclatée. Entre superhéros, chroniques culinaires et acrobaties techniques, acteurs et musiciens multiplient les surprises dans une mise en scène où humour, musique et nostalgie s’entremêlent."
      }
    ],
