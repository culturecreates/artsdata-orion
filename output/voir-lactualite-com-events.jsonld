    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "André Thériault : auteur, compositeur et interprète"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "André Thériault est un amoureux de la chanson et accorde une très grande importance aux textes. Pour son spectacle Jusqu'à ta porte, il propose des chansons dépouillées et intimistes dans la plus pure tradition des chansonniers du Québec avec sa guitare, son harmonica et François Lefèbvre à la contrebasse."
      }
    ],
