  {
    "@id": "https://voir.lactualite.com/genid/d90e061012b7988b",
    "@type": [
      "http://schema.org/ChildrensEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-03-11T18:00:00-05:00"
      }
    ],
