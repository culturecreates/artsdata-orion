    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le samedi 6 février 2027 à 20 h, portes à 19 h, la chanteuse française Alizée est au Théâtre Capitole, 972, rue Saint-Jean. Après deux concerts complets à l’Olympia de Paris les 7 et 8 septembre 2026, elle reprend sur scène les titres qui ont marqué plusieurs générations."
      }
    ],
