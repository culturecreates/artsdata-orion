    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Caity Gyorgy"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Caity Gyorgy est une chanteuse et compositrice de jazz de la scène canadienne. Triple lauréate d'un prix JUNO, elle se distingue par son swing, son phrasé et son talent d'improvisation. Son répertoire associe des standards du jazz à des compositions originales, dans une démarche qui relie tradition et touche moderne."
      }
    ],
