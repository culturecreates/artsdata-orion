    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Au-delà de soi"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "En 2021, les Québécois Nicolas Roulx et Guillaume Moreau ont réalisé un exploit inédit : traverser le Canada dans l’axe Nord-Sud, strictement à force humaine. Lors de cette conférence, Nicolas raconte cette aventure exceptionnelle à travers récits, anecdotes et images spectaculaires. Une occasion unique d’en apprendre davantage sur le Nord canadien, les communautés autochtones qui l’habitent et les impacts des changements climatiques sur ce territoire fragile ."
      }
    ],
    "http://schema.org/eventStatus": [
