    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Technique mixte"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Les règles de composition d'un tableau étant les mêmes pour tous les styles et tous les médiums, à l'atelier Contraste, tout le monde y trouve son compte. Notre atelier se veut un endroit sans préjugé où chaque artiste, quelle que soit son expérience, peut agir comme conseiller auprès des autres. Il ne manque que votre présence accompagnée de votre créativité, votre ouverture d'esprit et votre bonne humeur."
      }
    ],
