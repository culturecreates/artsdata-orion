    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/daniel-lemire-humour-873069"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Daniel Lemire – Humour"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Daniel Lemire est originaire de Drummondville. Il a commencé sa carrière en 1980 avec son premier spectacle, Parlez-moi d'amour, puis s'est fait connaître du grand public en 1982 aux Lundis des Ah! Ah! et en 1983 au premier Festival Juste pour Rire. Il a créé plusieurs personnages récurrents, dont l'oncle Georges, Yvon Travaillé, Ronnie Dubé et Edmond Ratté, et a notamment animé la série Casse-Tête à Télé-Métropole ainsi que signé la série Smash à Radio-Canada. Pour marquer ses 40 ans de carrière, il présente un nouveau spectacle de stand up où il fait le tour de l'actualité, avec son personnage Edmond."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
