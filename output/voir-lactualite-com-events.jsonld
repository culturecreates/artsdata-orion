    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Broue"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Broue est une pièce de théâtre québécoise dont la première représentation remonte à 1979, et dont les représentations se sont poursuivies presque 39 ans sans interruption. Le texte, signé Claude Meunier, Jean-Pierre Plante, Louis Saia, Francine Ruel, Michel Côté, Marc Messier et Marcel Gauthier, dresse le portrait d'un Québec pré-référendaire où les habitués d'une taverne voient leur univers menacé par l'arrivée des femmes. Benoît Brière, Luc Guérin et Martin Drainville incarnent les personnages, dont Bob, Pointu, Verrue et Travolta. La pièce se déroule en deux parties de 50 minutes, avec entracte."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
