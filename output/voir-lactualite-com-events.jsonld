      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le dimanche 6 décembre 2026 à 14 h, moulin Michel (Bécancour). Alexandre Belliard présente ses spectacles comme du « stand-up-historique avec une guitare ».…"
      }
    ],
    "http://ogp.me/ns#url": [
