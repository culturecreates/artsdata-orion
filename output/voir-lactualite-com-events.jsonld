    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/alvin-ailey-american-dance-theater-lp31-121"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Alvin Ailey American Dance Theater"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le message d’Alvin Ailey n’a jamais été aussi important. Cette compagnie de renommée mondiale incarne le meilleur de notre humanité commune, en célébrant la diversité, l’inclusion et le pouvoir de l’art à faire tomber les barrières et à unir les gens. Depuis sa création en 1958, lorsque Alvin Ailey a ressenti le besoin de mettre en valeur l’héritage culturel afro-américain sur scène, la compagnie a perpétué la mission de M. Ailey à travers des spectacles qui suscitent l’émerveillement au-delà des frontières de la race, de la foi et de la nationalité. Découvrez un mélange de nouvelles œuvres et de classiques qui inspirent les amateurs depuis des décennies, notamment le chef-d’œuvre de M. Ailey, Revelations, véritable hymne à la résilience et à la joie."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
