    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Bien faite"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Les rodages vont bon train pour Christine Morency, qui présentera son deuxième « one-woman show » « Bien faite » en grande première l’hiver prochain. De nombreuses dates affichent déjà complet et des supplémentaires s’ajoutent présentement à la tournée, notamment le 11 juin 2027 à la Salle Albert-Rousseau à Québec et le 13 février 2027 à L’Olympia à Montréal."
      }
    ],
