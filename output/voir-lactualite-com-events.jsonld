    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "BANANA CLUB"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le BANANA CLUB, groupe de cover chouchou (autoproclamé) de la trame sonore de votre adolescence. Venez revivre la nostalgie avec le rock/punk-rock des années 1990-2000+ C'est officiellement la dernière date de notre WORLD TOUR 2026! Venez voir le pavillon extérieur chauffé! Ça va être toute un party! On veut SOLD OUT la place - Hébertville tu n'as qu'à bien te tenir! Des succès de: GREEN DAY, BLINK 182, THE OFFSPRING, VULGAIRES MACHINS, RANCID, SUM41, GOOD CHARLOTTE, RISE AGAINST, BILLY TALENT, SYSTEM OF A DOWN, LINKIN PARK et +++"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
