    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "All Star est un groupe hommage aux années 90. L'Eurodance, le country, les boys bands, l'alternatif, le hip hop et l'émergence de la musique québécoise, il y en a pour tous les goûts dans cette décennie. Venez vivre une expérience remplie de nostalgie!"
      }
