  {
    "@id": "https://voir.lactualite.com/evenements/carte-personnalisee-avec-cricut-decouverte-des-cartes-a-inse-0f8596",
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "fr-ca",
        "@value": "VOIR — L’actualité"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "CARTE PERSONNALISÉE AVEC CRICUT : DÉCOUVERTE DES CARTES À… | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 15 décembre 2026 à 17 h 30, à Lieu à préciser – Vaudreuil-Dorion (Vaudreuil-Dorion). Création des cartes de souhaits uniques grâce au système de cartes à insert Cricut. Les participants découvriront les fonctions de base de Cricut Design Space et apprendront à personnaliser leurs créations avec…"
