      {
        "@language": "fr",
        "@value": "Christmas Market of Baie-Saint-Paul"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "When the first snowflakes fall and Baie-Saint-Paul begins to fill with the gentle scents of fir trees, mulled wine, and gingerbread, the Christmas Market transforms the heart of the district into a magical village for two weekends. Amidst illuminated vendor stalls, local discoveries, performances, family activities, and a warm atmosphere that makes you forget the cold, the Market becomes a place to gather, marvel, and celebrate the holiday spirit together."
      }
