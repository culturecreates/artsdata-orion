    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "2026 FUCK OFF FEST"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Préparez-vous à chanter, à danser et à mettre 2026 derrière vous. Plongez dans l'univers du groupe rock WEEZER et son énergie festive. En 2e partie, déchainez-vous au son des rythmes punk d’OFFSPRING. Que vous soyez un fan de longue date ou que vous découvriez leur musique pour la première fois, cet hommage sera l'occasion parfaite pour revivre l'esprit rebelle et l'enthousiasme de cette époque."
      }
    ],
