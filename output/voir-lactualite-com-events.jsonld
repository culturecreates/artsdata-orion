      {
        "@id": "https://voir.lactualite.com/artistes/choeur-classique-de-montreal-3573fd#artist"
      },
      {
        "@id": "https://voir.lactualite.com/artistes/les-choeurs-du-plateau-c26770#artist"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/08dd4bad880965d9"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/brahms-mendelssohn-lp1-415"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Brahms - Mendelssohn"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Que reste-t-il quand le deuil s’installe? Brahms et Mendelssohn répondent : la consolation. Dans son Requiem allemand, Brahms délaisse le latin et la crainte du jugement : il choisit des textes bibliques qui s'adressent aux vivants, à ceux qui pleurent et propose à l’auditeur une longue étreinte sonore, d'une humanité bouleversante. Le Psaume 42 de Mendelssohn, où l'âme assoiffée cherche l'espérance, dévoile la face lumineuse de celle-ci, avec un clin d'œil à Bach. Les choristes du Chœur classique de Montréal seront rejoints en deuxième partie de concert par ceux des Chœurs du Plateau pour interpréter le Requiem allemand jusqu’à former une masse chorale de plus de 110 chanteurs expérimentés qui, avec deux excellents solistes et l'orchestre Sinfonia de Montréal, seront rassemblés à la Maison symphonique pour une soirée de ferveur et de beauté."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
