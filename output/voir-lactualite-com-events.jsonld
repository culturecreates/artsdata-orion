    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 1er juin 2026 à 0 h, à Club Mont Royal (Montréal). Du 22 septembre 2026 au 26 octobre 2026. Promenade sonore guidée de 2h30 au cœur du mont Royal avec Sophie Mankowski, consacrée aux arbres, à l'histoire et à la nature fragile du mont Royal."
      }
    ],
