  {
    "@id": "https://voir.lactualite.com/genid/8785151af9a08d73",
    "@type": [
      "http://schema.org/MusicEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-13T20:00:00-05:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-13T23:00:00-05:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://voir.lactualite.com/genid/0aef1f43821329f8"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.kingseyfalls.ca/fichiersUploadOpt/790-500-0-83-2000-1333-8d422b4e9caeafe5d22dbfbdec74e942d56662fb8b7459e4f/20260201101642-bruno2.jpg"
