      }
    ]
  },
  {
    "@id": "https://voir.lactualite.com/genid/534e32de8667d86b",
    "@type": [
      "http://schema.org/TheaterEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-15T00:00:00-05:00"
      }
