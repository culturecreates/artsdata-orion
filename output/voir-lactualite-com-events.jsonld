      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://voir.lactualite.com/artistes/doug-st-louis-940ef7#artist"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/5b9e3b796fe0327e"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/doug-st-louis-2c9614"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Doug St-Louis"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Auteur-compositeur-interprète, ingénieur de son et réalisateur, Doug St-Louis est avant tout une bête de scène. Il acquiert son expérience en faisant le tour de la province à plusieurs reprises lors d’une multitude de concerts autant dans les festivals que dans les plus grandes salles du Québec en mode solo ou en tant qu'artiste invité et choriste. Accompagné de son acolyte Chuck aux table tournantes, il vous offre un spectacle un spectacle rythmé qui brasse la cabane avec une touche d’humour et qui ne laisse absolument personne indifférent. Une chose est sure c’est que l’ambiance sera au party et que la bière va bien descendre! Vous l’avez certainement déjà entendu aux radios commerciales avec un de ses nombreux singles qui ont grimpés dans le top 100 BDS. Il a d’ailleurs eu la chance de travailler avec plusieurs artistes tel que: Snoop Dogg, Flo Rida, Wyclef Jean, Audio Playgroud, Roxane Bruneau, Adamo (Gros Big), Francis Degrandpré, Laurence St-Martin et Dan D-noy (pour n’en nommer que quelques-uns). Il cumule à ce jour des millions de streams ainsi que deux disques d’or. Il sortira d’ailleurs sous peu son premier album solo en carrière à saveur Country Urbaine. Un style un peu éclectique bien à sa couleur mais toujours à saveur pop. Restez à l’affût!"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
