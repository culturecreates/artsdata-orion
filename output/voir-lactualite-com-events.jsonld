        "@id": "https://www.cegepvicto.ca/wp-content/uploads/2026/05/elle-van-berg-472x592.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://voir.lactualite.com/evenements/chez-moi-c-est-l-art-f43d9b"
