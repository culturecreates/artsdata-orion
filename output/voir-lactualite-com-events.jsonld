    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le jeudi 4 février 2027 à 19 h 30, Espace citoyen des Confluents (Laval). Durée : 75 minutes, sans entracte Jeune pianiste et compositrice montréalaise, Ariane…"
      }
    ],
    "http://ogp.me/ns#url": [
