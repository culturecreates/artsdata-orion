    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Artistes variés"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Regroupant les artistes Lou-Adriane Cassidy, Patrice Michaud, Ariane Moffatt, Ariane Roy et plusieurs autres, sous la direction de Louis-Jean Cormier, ce grand spectacle est une célébration de la richesse et de l'influence de l'œuvre de Gilles Vigneault auprès de ses contemporains. Une occasion unique de faire découvrir ou redécouvrir à toutes les générations certaines de ses plus belles chansons dans des habits neufs. Un projet né d'une évidence : celle que les mots de Vigneault continuent de résonner, de traverser les styles et les époques, et de trouver en chaque interprète une voix nouvelle pour les porter."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
