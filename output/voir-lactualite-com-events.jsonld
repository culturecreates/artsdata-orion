    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le mardi 24 novembre 2026 à 19 h, Bibliothèque Marius-Barbeau (Laval). Le mythique passage du Nord-Ouest devient le point de départ d’une aventure fascinante…"
      }
    ],
