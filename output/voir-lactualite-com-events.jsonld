    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "As Good As It Gets"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "🎶🎤 UNE SOIRÉE MUSICALE À NE PAS MANQUER AVEC SEAN & EVA ! 🎸✨ Venez passer un moment exceptionnel en compagnie de Sean & Eva, qui vous feront voyager à travers les décennies avec leurs superbes reprises des plus grands succès des années 50 à aujourd’hui ! 🎵 Des classiques intemporels, des chansons que vous adorez et une ambiance chaleureuse et entraînante qui vous donnera envie de chanter, de taper du pied et de profiter de chaque instant ! 🎶💃🕺 🍻 De la bonne musique, une belle ambiance et beaucoup de plaisir au rendez-vous ! Invitez vos amis et venez partager une soirée mémorable ! 🌟 Un spectacle à ne surtout pas manquer !"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
