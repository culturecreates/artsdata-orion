    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Dance at Zibi"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Envie d’essayer quelque chose de nouveau? Venez découvrir l’art du tango argentin et apprenez les bases de la connexion, du mouvement et de l’improvisation avec d’autres passionnés de danse. Vous en apprendrez également davantage sur la culture du tango et les traditions qui rendent cette danse si unique."
      }
    ],
