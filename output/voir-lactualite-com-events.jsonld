    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Caravane - Tournée d'adieu — Sherbrooke | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 13 novembre 2026 à 21 h, à La Petite Boîte Noire (Sherbrooke). Caravane, c'est 13 ans de rock, de sueur, de décibels pis de gorges cassées entre ici pis l'autre bout du monde. Quatre albums, plus de 500 shows sur trois continents, des scènes de festival comme des sous-sols de bar un lundi soir.…"
      }
    ],
    "http://ogp.me/ns#url": [
