  {
    "@id": "https://voir.lactualite.com/genid/c6b664f6feecd069",
    "@type": [
      "http://schema.org/MusicEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-15T14:00:00-05:00"
      }
