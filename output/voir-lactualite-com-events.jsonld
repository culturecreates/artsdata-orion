    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le dimanche 29 novembre 2026 à 14 h, Lezard Creatif Montreal (Montréal). Bienvenue dans votre bulle créative du dimanche ! Durant cet atelier aquarelle de 3…"
      }
    ],
