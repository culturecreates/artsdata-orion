    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Concert La Messe pour la paix de Karl Jenkins"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le Choeur polyphonique de Lévis et l'Ensemble philharmonique de la Capitale unissent leurs voix et leurs instruments pour interpérter une oeuvre majeure du répertoire contemporain de la musique sacrée. La Messe pour la paix de Karl Jenkins, est une oeuvre chorale qui dénonce les horreurs de la guerre. Cette ode à la paix puise dans des textes variés, des psaumes bibliques aux témoignages de victimes de la guerre. Des projections d'extraits d'archives complètent cette oeuvre remplie d'émotions. Un premier concert sera d'abord présenté à Beauport le 11 avril à 20 h, à l'église de la Nativité. Le second concert aura lieu à Lévis le 12 avril à 14 h, à l'Espace symphonique."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
