    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 19 octobre 2026 à 18 h 30, à Centre résidentiel et communautaire Jacques-Cartier (Québec). Les ateliers du programme Cirque du monde te donnent l’occasion de découvrir les arts du Cirque. Initie-toi à la jonglerie, à l’acrobatie, aux jeux aériens, au jeu clownesque ou toute autre disciplin"
      }
    ],
