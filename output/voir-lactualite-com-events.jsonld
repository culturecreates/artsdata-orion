      }
    ]
  },
  {
    "@id": "https://voir.lactualite.com/genid/604b9de0167542cf",
    "@type": [
      "http://schema.org/ScreeningEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-06T21:15:00-05:00"
      }
    ],
