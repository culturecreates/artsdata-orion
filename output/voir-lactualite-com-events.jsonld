    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Avec plaisir !"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dans Avec plaisir !, JF Otis, humoriste originaire de Rimouski, raconte de bien mauvaises décisions qui ont marqué son parcours. Bachelier en administration des affaires, il est devenu humoriste et star du web après avoir commencé à faire des vidéos sur internet. L'improvisation tient une place importante dans son stand-up, si bien que chaque représentation se veut unique. L'ambiance est festive, à la manière d'une veillée autour d'un feu de camp avec un vieil ami qui raconte des anecdotes."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
