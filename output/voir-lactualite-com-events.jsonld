        "@language": "fr-ca",
        "@value": "Atelier Bûche de Noël – Automne 2026 — Laval | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 12 décembre 2026 à 0 h, à Laval (Laval). 🥖✨Cette année, offrez-vous une expérience unique avant les Fêtes ! 🎄 Venez mettre la main à la pâte et découvrir les secrets de la boulangerie artisanale avec notre ateliers de bûche de Noël, offert par L’Atelier Sucré Salé 🍰 Vous apprendrez pas à pas…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://voir.lactualite.com/evenements/complet-atelier-buche-de-noel-automne-2026-446535"
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
        "@value": "fr_CA"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://www.fadoq.ca/wp-content/uploads/2025/08/img_6642-2-adapted-480x300.jpeg"
      }
    ]
  },
  {
    "@id": "https://voir.lactualite.com/genid/fc53d20d86b5161f",
    "@type": [
      "http://schema.org/EducationEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-12-12T00:00:00-05:00"
      }
    ],
