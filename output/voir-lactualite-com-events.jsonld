  {
    "@id": "https://voir.lactualite.com/genid/6230d4730257330c",
    "@type": [
      "http://schema.org/TheaterEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-21T20:00:00-05:00"
      }
