      }
    ]
  },
  {
    "@id": "https://voir.lactualite.com/genid/bc207026a8adc16f",
    "@type": [
      "http://schema.org/ExhibitionEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-22"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-01-10"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://voir.lactualite.com/genid/bbbe2d990871ab7f"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.maculturebrompton.com/wp-content/uploads/2026/09/Devoir-de-memoire-no-2.png"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://voir.lactualite.com/evenements/devoir-de-memoire-bc524f"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://voir.lactualite.com/genid/9f111785c065940f"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/e77b1821729b7657"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/devoir-de-memoire-bc524f"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Devoir de Mémoire"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Pour l’exposition collective des membres 2026, la Maison des arts et de la culture de Brompton invite les artistes à proposer une œuvre sur le thème Devoir de mémoire. D’une part, devoir invite à la responsabilité individuelle, au travail et à l’obligation morale de faire quelque chose. De l’autre, mémoire invite plutôt à s’intéresser à notre inventaire de souvenirs, malléables et fugaces, à la nostalgie, mais aussi à la transmission des récits et à leur effacement. Ensemble, Devoir de mémoire nous parle également de l’histoire qui se répète, celle-même que l’on s’efforce de changer; de la nécessité de commémorer les temps perdus, les personnes disparues, emportées par les grands mouvements qui bousculent les époques. Des petits mouvements aussi, ceux qui bouleversent l’intimité, comme un amalgame de réalisations, d’anecdotes et de deuils personnels que l’on porte au quotidien et qui s’imprime, bien souvent, dans une trame collective. Pour une nation dont la devise est Je me souviens, il est impératif de se poser la question: de qui, de quand et de quoi?"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
