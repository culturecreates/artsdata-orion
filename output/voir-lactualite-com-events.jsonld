        "@id": "https://voir.lactualite.com/genid/6ad09e02ffa0d51b"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://saintbruno-site.s3.ca-central-1.amazonaws.com/wp-content/uploads/2023/08/bebe-contes.jpg"
      }
    ],
