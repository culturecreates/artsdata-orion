    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le mercredi 16 décembre 2026 à 21 h, Le Saint-Jean Comédie Club (Québec). Je suis fier de vous présenter le rodage de mon nouveau spectacle. Encore une fois…"
