      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 7 novembre 2026 à 13 h, à Bibliothèque Robert-Lussier (Repentigny). Par Sarah Lemieux Viens apprendre à dessiner autour de la thématique de l’anatomie avec une dessinatrice d’expérience. Activité pour les adolescents (13 à 17 ans), au Créalab Inscriptions dès le 7 octobre Inscription requise"
      }
    ],
    "http://ogp.me/ns#url": [
