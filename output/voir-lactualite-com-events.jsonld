    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 14 novembre 2026 à 0 h, à Grand Lodge Mont-Tremblant (Mont-Tremblant). Surprise Surprise is coming to the Grand Lodge Mont-Tremblant on November 14 and 15! Following the huge success of Michel Tremblay's comedy this summer, Théâtre Les Éperdus invites you to two evenings of aperitif theater!…"
      }
