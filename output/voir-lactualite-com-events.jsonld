    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Célébrer Gilles Vigneault : Au cœur du pays à Montréal — 12 juin 2027 | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le samedi 12 juin 2027 à 20 h, Salle Wilfrid-Pelletier (Montréal). Gilles Vigneault dit qu’une chanson, c’est un bateau sur lequel on s’embarque pour faire…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
