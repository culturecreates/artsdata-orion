  },
  {
    "@id": "https://voir.lactualite.com/genid/c7770a5ad92d580a",
    "@type": [
      "http://schema.org/LiteraryEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-12-11T10:00:00-05:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-12-11T13:00:00-05:00"
      }
    ],
