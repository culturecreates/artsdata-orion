    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Caity Gyorgy Duo Jazz"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Rejoignez-nous pour une fantastique soirée de jazz vocal avec Caity Gyorgy, l’une des jeunes voix les plus passionnantes du genre au Canada. La chanteuse et compositrice, trois fois lauréate d’un prix Juno, est célèbre pour son swing naturel, son phrasé enjoué et sa maîtrise de l’improvisation vocale. S’inspirant de l’âge d’or du jazz tout en y ajoutant sa touche moderne, Caity Gyorgy apporte charme, esprit et sophistication à chacune de ses performances. En compagnie de son incroyable pianiste Mark Limacher, sa musique fait le pont entre tradition et innovation, mêlant des standards intemporels à des compositions originales qui mettent en valeur sa voix chaleureuse et son timing impeccable. Avec sa présence scénique dynamique et son amour profond pour la narration à travers la chanson, Caity Gyorgy captive le public et vous amène dans un univers de bonheur et de pur ravissement."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
