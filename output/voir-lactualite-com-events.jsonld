    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Concert de Noël"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Certaines mélodies ont ce pouvoir rare de nous rejoindre tous, dès les premières notes. C’est exactement l’esprit de ce concert de Noël, où les voix du Quatuor vocal Feu Secret et les cuivres du Quintette Élénya se retrouvent pour partager les plus belles pages du répertoire des Fêtes. Des airs que vous connaissez, d’autres que vous découvrirez, portés par des musiciens qui prennent visiblement plaisir à jouer ensemble. Luc Beauséjour, à l’orgue et au clavecin, assure avec bonheur le lien entre les voix et les instruments. Concert en coproduction avec l’Oratoire Saint-Joseph et Clavecin en concert MUSICIENS Quatuor vocal Feu Secret Janelle Lucyk, soprano Rosalie Lane Lépine, mezzo-soprano Kerry Bursey, ténor Basse (à confirmer) Quintette de cuivres Élénya Nicolas Gagnon, trompette Loîc Lapatrie, trompette Mathilde Lepage, cor Arnaud Milette, trombone Maxime Lepage, tuba Luc Beauséjour, clavecin et orgue Crypte, 19 h 30 Billets en vente ici"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
