    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "CHICOUTIMI SOIS TA MEILLEURE AMIE JOSEE BOUDREAULT"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Josee Boudreault présente « Sois ta meilleure amie! », un événement de retour à Chicoutimi, à l'Hôtel Le Montagnais. Louis-Philippe l'accompagne pour cette soirée qui aborde le bonheur, l'amour de soi, l'auto-compassion, l'auto-dérision et la gratitude, avec pour objectif de faire rire le public tout en encourageant un regard plus positif sur la vie. La soirée s'adresse autant aux hommes qu'aux femmes, seul, en couple ou en groupe."
      }
    ],
