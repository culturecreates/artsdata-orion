    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "BUZZ CUIVRES - Le Noël de Buzz"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Un concert incarnant, avec sensibilité et humour, toute la magie des fêtes. Au programme: la Suite Casse‑Noisette de Tchaïkovski, Sainte Nuit, Promenade en traîneau (Sleigh Ride) et Les douze jours de Noël. Musiciens accomplis, le quintette offre un spectacle pour toute la famille, une soirée chaleureuse et réjouissante, alliant virtuosité, finesse d’interprétation et émotion."
      }
    ],
