    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "En attendant la cloche"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "En attendant la cloche est un spectacle destiné aux enfants de 8 à 12 ans. Une équipe de théâtre y prépare les enfants à leur arrivée au secondaire, mais la réalité déjoue ses conseils et ses situations deviennent vite encombrantes. En s'alliant avec le public, les interprètes abordent des questions sur le besoin d'appartenir et d'être aimé, dans un récit décrit comme parfois absurde et souvent déroutant. Un outil en ligne, Sortir = Grandir, accompagne les enseignants et les élèves du primaire avec des activités avant et après le spectacle."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
