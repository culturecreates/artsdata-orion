    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Comité organisateur - Secondaire en spectacle à Laval | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Jusqu’au 5 juin 2027, Collège Laval (Laval). Tu aimes la musique, la danse, le théâtre, l’humour ou tout ce qui se passe derrière la scène? Joins-toi au comité…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://voir.lactualite.com/evenements/comite-organisateur-secondaire-en-spectacle-cfb729"
      }
    ],
