    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "À petits pas dans les contes — Saint-Bruno-de-Montarville | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 19 octobre 2026 à 10 h 30, à bibliothèque de Saint-Bruno-de-Montarville (Saint-Bruno-de-Montarville). Vous souhaitez initier vos tout-petits au merveilleux monde des livres ? Joignez la Maison de la famille du Mont-Bruno qui vous propose une activité parent-enfant chaque lundi à la bibliothèque…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://voir.lactualite.com/evenements/a-petits-pas-dans-les-contes-3b976f"
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
        "@value": "fr_CA"
      }
    ],
    "http://ogp.me/ns#image": [
