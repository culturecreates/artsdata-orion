    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Brigitte Boisjoli"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Brigitte Boisjoli nous revient avec un tout nouveau spectacle 100 % acoustique! Accompagnée de son talentueux guitariste, Jean-François Beaudet, elle nous transporte dans l’univers des caravanes country-rock des années 1950. De Patsy Cline à Brenda Lee, en passant par Dolly Parton, laissez-vous charmer par sa voix unique. Préparez-vous également à danser sur les classiques de Jerry Lee Lewis, Johnny Cash, Wanda Jackson, Ray Charles et, bien sûr, Elvis!"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
