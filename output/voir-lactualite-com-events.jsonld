      }
    ]
  },
  {
    "@id": "https://voir.lactualite.com/genid/8ffb02cf547584e1",
    "@type": [
      "http://schema.org/ExhibitionEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-10-03"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
