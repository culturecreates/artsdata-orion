    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Bugs Bunny at the Symphony"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Looking ahead, Warner Bros. Discovery presents the ciné-concert Bugs Bunny at the Symphony at Salle Wilfrid-Pelletier at Place des Arts on February 12 and 13, 2027, in time to celebrate Bugs Bunny’s 85th birthday, and the concert’s 35th anniversary. Sixteen classic Looney Tunes will be projected on the big screen as the FILMharmonique Orchestra conducted by George Daugherty performs the original iconic scores live."
      }
    ],
