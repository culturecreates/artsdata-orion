    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Bleu Jeans Bleu"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Avec leur tournée Record NoV, Bleu Jeans Bleu revient avec un nouveau spectacle aussi rassembleur qu’irrésistible. Musique accrocheuse, humour décalé et complicité avec le public sont encore une fois au rendez-vous. Dans une ambiance feutrée au décor italo-romantique, BJB mélange énergie, élégance et plaisir assumé. Une véritable dose de bonheur sur scène."
      }
    ],
