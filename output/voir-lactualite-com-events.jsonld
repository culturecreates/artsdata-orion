      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://grandsballets.ficelle.app/v1/?src=https%3A%2F%2Fgrandsballets.com%2Fworkspace%2Fuploads%2Fspectacles%2Fles-grands-ballets-alice-photo-sasha-onyshchenko-danseuse-anna-ishii-horizontale-1920x1080px-web-f-1773345499_1.jpg"
      }
    ],
