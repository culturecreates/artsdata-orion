    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "AURA"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Depuis le 5 décembre 2025, AURA, l'expérience immersive créée par Moment Factory, est présentée à l'église Saint-Roch, à Québec. Un pré-spectacle de 15 minutes permet d'abord de découvrir l'histoire et l'architecture de l'église avec une application Web ; l'église se transforme ensuite sous les projections, les jeux de lumière et une musique orchestrale. Séances en soirée dès 17 h 30, d'une durée totale d'environ 45 minutes. Billets en vente sur Fever jusqu'au 27 février 2027."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
