    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/annuel-de-design-lp1-172"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Annuel de Design"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "L’Annuel de design est l’exposition phare des étudiantes et étudiants finissants de l’École de design de l’UQAM, coorganisée chaque année avec la communauté étudiante, réunissant les travaux des designers émergents dans toutes les disciplines de l’École. Pour la deuxième année consécutive, l’Annuel adopte son format élargi sur deux semaines — une formule qui a attiré plus de 5 000 personnes en 2026, dont 2 500 au vernissage — intégrant une dizaine d’événements parallèles, dont le défilé de l’École de mode de l’UQAM et la journée de conférences de l’événement Design International de l’UQAM. C’est le rendez-vous le plus festif de la saison et l’un des moments de rassemblement les plus vivants de la communauté du design à Montréal."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
