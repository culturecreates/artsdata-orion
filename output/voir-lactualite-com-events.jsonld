    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Adrénaline"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Guitar Story Adrénaline est une explosion musicale qui propulse la guitare au cœur de l’action ! Ce show intense et captivant rend hommage aux riffs les plus emblématiques de l’histoire du rock, du rock’n’roll, du funk, du métal et des genres les plus électriques. Avec une énergie débordante, une scénographie immersive et des solos époustouflants, ce spectacle de 90 minutes sans entracte regroupe cinq musiciens/chanteurs qui repoussent les limites de leur art. Retrouvez des morceaux légendaires et des performances inoubliables qui feront vibrer les fans de tous âges. Des classiques de Led Zeppelin aux hymnes de Metallica, en passant par les tubes épiques de Guns N’ Roses, Guitar Story Adrénaline vous promet une montée d’adrénaline pure. Préparez-vous à une soirée où chaque note déchaîne les passions et où l’énergie du live est à son apogée. Ne manquez pas cette expérience unique qui redéfinit les standards du spectacle rock !"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
