        "@id": "https://vasteetvague.ca/wp-content/uploads/2026/03/3_Forest_VasteV-scaled.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://voir.lactualite.com/evenements/ces-derniers-souffles-lp9-225"
