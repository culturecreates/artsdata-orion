    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 8 juillet 2027 à 19 h 30, à Lieu à préciser – Rosemère (Rosemère). Le duo montréalais Alfa Rococo propose une pop lumineuse et entraînante portée par des mélodies accrocheuses et une énergie contagieuse!"
      }
