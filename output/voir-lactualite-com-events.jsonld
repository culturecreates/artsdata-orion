    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Club du Rat Biboche"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Du 10 septembre au 15 novembre, le Club du rat Biboche permet aux enfants de 3 à 6 ans de découvrir l’univers passionnant de la lecture. Les participants réaliseront des lectures captivantes afin de cumuler des coupons pour des tirages et prendront part à une animation spéciale (places limitées). Animations spéciales réservées aux membres du Club Groupe 1 : mercredi 30 septembre, à 18 h 30 Groupe 2 : jeudi 15 octobre, à 18 h 30 Groupe 3 : vendredi 6 novembre, à 18 h 30 Inscription requise"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
