      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Fall Choir Cabaret"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "All are invited to the A&P Choir’s Fall Cabaret on October 29, held at 7:30 p.m. in beautiful Kildonan Hall at The Church of St. Andrew and St. Paul. Enjoy a delightful evening of solo arias, duets, musical theatre selections, and choir pieces in a relaxed setting. Meet our new choristers and mingle with members of the A&P Music Department. During the recital, sip on a glass of wine and sample exquisite cheeses from Fromagerie Hamel, specially curated by the choir’s own cheese expert, Alexandre Porras. You’re welcome to enjoy the refreshments from your seat as the music is performed. Tickets are available in the Narthex after upcoming Sunday services, and at the door on October 29: 🎟️ $50 general admission 🎟️ $20 for students Donations by cash or card are welcome and will support the A&P Music Department, helping sustain beloved events like Carols by Candlelight, Vigil, and the Good Friday service with Ensemble Caprice. Bring a friend who loves wine, cheese, and exceptional music!"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "en"
      }
    ],
