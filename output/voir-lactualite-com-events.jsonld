    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Au bout du conte – Spectacle familial"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Chaque spectateur doit détenir un billet pour assister au spectacle. La présence d'un adulte est obligatoire. Spectacle famille 4 à 10 ans Durée du spectacle : 50 minutes sans entracte Au bout du conte revisite avec humour, créativité et ingéniosité des contes et légendes qui ont marqué notre imaginaire collectif. À travers six histoires captivantes, quatre comédiens transforment de simples objets du quotidien en univers fabuleux pour le plaisir des petits et des grands. Arrivez dès 14 h pour participer gratuitement aux activités de médiation culturelle organisées en parallèle du spectacle et visiter l’exposition à la galerie Renée-Blain. Brossard.ca/billetterie Remboursements Aucun remboursement Échanges Aucun échange Accès pour personnes à mobilité réduite Oui Gratuité pour l'accompagnateur Oui"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
