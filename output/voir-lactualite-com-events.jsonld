    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le pianiste Philippe Le Bon présente un concert de piano sous les chandelles durant le temps des Fêtes à la Chapelle Saint-Bernard. Cette expérience musicale envoutante allie la magie des Fêtes à l’élégance d’une ambiance lumineuse douce et chaleureuse. tremblant.ca"
      }
