      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 31 octobre 2026 à 14 h, à Salle Jean-Cossette (Amqui). La comédie musicale d’Amandine et de Gédéon « La grande surprise! » vous enchantera! Vous retrouverez les chansons adorées tirées de l’album L’étrange Halloween d’Amandine et de Gédéon ainsi que des nouvelles composées spécialement pour le…"
      }
    ],
    "http://ogp.me/ns#url": [
