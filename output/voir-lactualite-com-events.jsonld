    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Intermediate Sewing: Making a Reversible Reusable Bag"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "LAB Activities This intermediate workshop is designed for people who have already mastered the basics of using a sewing machine and want to complete a full project. It aims to help them create a lined, reversible reusable bag while developing their sewing skills. Participants will learn the steps involved in a project, including how to assemble fabric pieces with precision, create neat topstitching, attach handles, and sew French seams. 14 years and over Register online or by phone at [phone] for library members—whether residents or non-residents—starting Monday, September 21, at 10 a.m. Registration by phone for non-residents who do not have a library card, starting October 5 at 10 a.m."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
