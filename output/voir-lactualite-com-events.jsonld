    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Champion"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Mario Tessier, humoriste, animateur et entertainer, membre du célèbre duo Les Grandes Gueules, a marqué l'histoire radiophonique avec 20 ans de micro à Énergie 94,3. Il a aussi animé plusieurs galas télévisuels et émissions à succès. Après son premier solo Seul comme un grand en 2015, puis Transparent en 2019, il présente Champion, son troisième one-man-show, un spectacle d'humour mêlant autodérision et situations improbables, où il affronte ses propres contradictions, du entraînement de boxe à la possession d'une jument."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
