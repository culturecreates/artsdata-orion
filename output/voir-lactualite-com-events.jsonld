    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Carte blanche à Stanley Péan"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Entouré de Sophie Lemaire à la flûte et au chant et d’Anthony Rozankovic au piano et à la direction musicale, Stanley Péan propose une suite d’extraits de ses œuvres littéraires, ponctuée de chansons et de musique: des standards de jazz, mais aussi des chansons originales écrites par Péan et composées par Rozankovic. À propos de Stanley Péan Né en Haïti et élevé à Jonquière, Stanley Péan est l’auteur de vingt-cinq livres appartenant à différents genres (romans, recueils de nouvelles, récits, essais ou fictions destinées à la jeunesse). Il a également travaillé comme journaliste culturel, traducteur littéraire, scénariste pour la télévision et il anime depuis plus de dix ans Quand le jazz est là, une émission radiophonique quotidienne diffusée à l’antenne d’ICI Musique, la radio musicale de Radio-Canada."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
