    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Cool Cat Cabaret"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "🎹✨ Step into an evening of music, glamour, and giving back at Cool Cat Cabaret in support of Interval House Ottawa! 🗓️ Wednesday, October 29 🎶 Show starts: 7:00 PM 📍 Location: La Ruelle, 15 Rue Jos-Montferrand, Gatineau 💃 Theme: 1920s cabaret glamour — think velvet, feathers, pearls & sparkle 🎟️ Ticket proceeds support survivors of gender-based violence and the opening of a new 10-unit transitional housing complex in 2026 Join us for duelling pianos, dancing, and a night that truly makes a difference. 🌟 Purchase your tickets at the 🔗 in bio - 🎹✨ Venez passer une soirée de musique, de prestige et de générosité au Cool Cat Cabaret afin de soutenir Interval House Ottawa !"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "en"
      }
    ],
