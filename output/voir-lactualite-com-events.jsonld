    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Charles Pellerin"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Charles Pellerin présente Gentilhomme, son deuxième spectacle solo. Il s'agit d'un récit intime sur la masculinité, l'estime de soi et l'art de se laisser aimer. Selon le texte de présentation, l'artiste a longtemps cru qu'il fallait choisir entre être gentil et être un homme, avant de comprendre qu'il n'avait peut-être pas à choisir. Le spectacle dure 90 minutes, sans entracte."
      }
    ],
