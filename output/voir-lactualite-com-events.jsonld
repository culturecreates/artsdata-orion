    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "BANATOR – 10e anniversaire de l’album « Plume Noire » à Valleyfield (Tout âges)"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le 27 février, Salaberry-de-Valleyfield vibrera au rythme d'une soirée exceptionnelle ! Dix ans après la sortie de Plume Noire, BANATOR revient sur scène pour célébrer une décennie de musique, de passion et d'authenticité. Plus qu'un simple spectacle, cette soirée sera l'occasion de revisiter un album marquant, de célébrer le chemin parcouru et de partager un moment unique avec le public. Pour cette occasion spéciale, BANATOR sera accompagné de Mikael Rosby, N.S.T.G, Batailleur et Félix Antoine Boucher, avec JOK3RMAN comme artiste invité. Une soirée de rap authentique, d'énergie et de souvenirs à ne pas manquer ! 27 février 17, rue du Marché, Salaberry-de-Valleyfield (Québec) Ouverture des portes : 19 h Début du spectacle : 20 h Billets : 20 $ en prévente | 30 $ à la porte 10 ans d'histoire. Une scène. Une soirée à vivre ensemble. Réservez vos billets dès maintenant !"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
