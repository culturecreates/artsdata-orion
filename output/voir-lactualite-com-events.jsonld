    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Benny Jones à Gatineau — 1er déc. 2026, Salle Odyssée | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le mardi 1er décembre 2026 à 20 h, Salle Odyssée (Gatineau). «J'ai grandi avec le bois dans le dos, la mer dans la face... Mais surtout, j'ai eu la chance…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
