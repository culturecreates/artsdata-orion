      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/35d1f795cbec35ed"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/danemark-et-iles-feroe-6cdec2"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Danemark et îles Féroé"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Après avoir conquis le public avec ses précédents films de voyage, le cinéaste primé Tommy Ferlatte revient avec une nouvelle odyssée nordique : Danemark et les Îles Féroé — Royaume du bonheur. Connu pour son humour contagieux, sa curiosité infatigable et sa capacité à transformer chaque instant en découverte sensorielle, Tommy nous entraîne dans un voyage aussi inspirant qu’inattendu. Dans ce documentaire à la fois touristique, intime et teinté de réflexions sur la qualité de vie, Tommy et sa complice de voyage Janie Lapointe explorent ce royaume façonné par l’eau, le vent et une philosophie de vie profondément humaine. Ici, l’urbanisme rencontre la nature, le design rencontre les traditions, et le bonheur se cultive jour après jour. De Copenhague, ville verte et créative, à Aarhus, joyau culturel du Jutland, le périple dévoile des quartiers réinventés, des espaces publics intelligemment pensés et des habitudes de vie étonnantes, toujours avec le regard curieux et espiègle du duo. Puis, cap sur les Îles Féroé, un archipel presque mythique au cœur de l’Atlantique Nord, où falaises vertigineuses, maisons coiffées de gazon et nature brute dictent le rythme de la vie. Entre paysages spectaculaires, rencontres touchantes et situations aussi cocasses qu’émouvantes, le film pose une question simple et universelle : qu’est-ce qui nous rend vraiment heureux ? Danemark et les Îles Féroé — Royaume du bonheur est une invitation à rire, à réfléchir… et peut-être à réinventer notre façon de voir le monde. Un film de Tommy Ferlatte et Janie Lapointe (Bonaventure)"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
