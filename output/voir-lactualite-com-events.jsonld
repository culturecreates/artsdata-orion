    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Samedis du mois – Création de bijoux"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "À l’approche de Noël, venez créer des bijoux uniques et faits à la main avec l’artiste Dominique Boucher ! Dans une ambiance chaleureuse et créative, laissez libre cours à votre imagination pour concevoir des pièces parfaites à offrir en cadeau ou à porter durant les Fêtes."
      }
    ],
