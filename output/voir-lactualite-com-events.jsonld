  {
    "@id": "https://voir.lactualite.com/genid/9e9ed6bed962db05",
    "@type": [
      "http://schema.org/ScreeningEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-10-24T14:00:00-04:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-10-24T17:00:00-04:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://voir.lactualite.com/genid/451d09dcbf52785a"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://voir.lactualite.com/evenements/cine-musee-774134"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://voir.lactualite.com/genid/40b0b7ba22b05562"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/aa074b499f237698"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/cine-musee-774134"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Ciné-Musée"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Quand le cinéma dialogue avec les arts visuels Cet automne, le Musée vous invite à découvrir une programmation culturelle GRATUITE mêlant cinéma et art. En partenariat avec le Festival International du Film sur l’Art (FIFA), Ciné-Musée met en valeur des thèmes explorés par les artistes issus de la collection permanente présentée dans l’exposition Actions collectives. Regards féministes sur la collection, ou en résonance avec les expositions en cours. Chaque séance propose une expérience à la fois artistique, réflexive et accessible, invitant à porter un regard différent sur les œuvres présentées en salle. Samedi 26 septembre à 14 h Tina : art, amour et révolution de Daniela Mujica Documentaire mêlant animation et images d’archives qui retrace la vie tumultueuse de Tina Modotti, artiste d’origine italienne et figure marquante du XXe siècle. À travers sa pratique photographique, elle a contribué à rendre visibles les réalités sociales et les luttes de son époque. Pour l’occasion, nous prendrons le temps d’observer et de discuter de l’œuvre vidéo Secret Strike (Lleida, 2005) d’Alicia Framis, dans laquelle la caméra circule autour d’une centaine de femmes immobiles, gantées de rouge, évoquant une mobilisation contre la violence fondée sur le genre. Plus d’informations sur le film : Cette projection est offerte dans le cadre des Journées de la culture."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
