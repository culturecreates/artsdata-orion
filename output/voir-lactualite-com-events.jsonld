    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Bon chien"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "En 35 ans de carrière, Maxim Martin s'est démarqué dans le paysage humoristique par ses spectacles, ses présences à la radio, ses animations et ses numéros aux Galas Juste pour rire. Après cinq one-man show, un livre et une série sur son quotidien avec sa fille, il présente Bon chien, son sixième one-man show. Toujours authentique, il s'y dévoile dans une nouvelle période de sa vie où il tente de la simplifier dans une époque qui lui semble de plus en plus complexe. Le spectacle se veut une fenêtre ouverte sur son chemin parsemé de petites et grandes frustrations vers la zénitude."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
