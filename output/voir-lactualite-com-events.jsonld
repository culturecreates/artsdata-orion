      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Aswell | Berger"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Avec Berger, Aswell monte sur scène avec son projet le plus ambitieux et personnel, tout en revisitant les morceaux qui ont façonné son parcours depuis ses débuts. Entre rap, pop et influences trap, drill et folk, il raconte les hauts et les vides de la vingtaine : les amours qui marquent, les blessures qu’on traîne et le succès qui ne vaut rien sans les bonnes personnes autour. Pensé comme une célébration du rassemblement, Berger transforme la scène en véritable refuge où nouvelles chansons et classiques du répertoire se rencontrent dans une même énergie. Porté par les arrangements riches et organiques de son band, le spectacle promet une expérience à la fois intime et explosive."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
