      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 21 novembre 2026 à 20 h, à Théâtre des Deux Rives (Saint-Jean-sur-Richelieu). Originellement créé en 2009 à Incheon, KOR, puis retravaillé pour être présenté dans le cadre du Festival Montréal Complètement Cirque, iD a enchaîné les triomphes : 2 100 représentations dans 33 pays et 140 villes.…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
