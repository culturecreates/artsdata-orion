    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "BASTRINGUE - CIRCUS FESTIVAL"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Downtown Joliette will come alive with the arrival of Cirque Alphonse under its massive big top. This circus festival promises to wow audiences of all ages. Bastingue transports us to a world where raw daring, festive music, sometimes irreverent humor, and a good-natured approach come together to charm young and old alike."
      }
    ],
