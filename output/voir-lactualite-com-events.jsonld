    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Décembre"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "La grande fresque musicale du temps des Fêtes, est de retour à Québec du 3 au 5 décembre au Grand Théâtre et à Montréal du 11 au 29 décembre à la salle Pierre-Mercure. Notez que Marc-André Fortin terminera le 23, Brian Audet prendra la relève. ́ En 12 tableaux riches en émotions, « Décembre » ravive votre cœur d’enfant et vous convie à une soirée magique en compagnie des personnages qui peuplent le petit village sous votre sapin de Noël. Ce tourbillon de chants, de musique et de danse vous emportera de l’émerveillement des premiers flocons jusqu’à l’euphorie du jour de l’An. Une distribution de 22 artistes passionnés donnera vie à ces personnages iconiques du temps des Fêtes grâce à des performances scéniques époustouflantes."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
