    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Destin fatal mystère total"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Virginie Fortin est humoriste, comédienne et animatrice, cumulant plus d'une dizaine de nominations. Elle se fait d'abord connaître grâce à l'improvisation, notamment à la LNI. Ses deux premiers spectacles solo avaient pour matière le temps et l'espace. Son troisième opus flirte avec les réalités alternatives et les mauvaises décisions qui donnent envie de retourner dans le passé. Destin fatal mystère total est présenté comme le nouveau spectacle de l'humoriste."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
