    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/26-lettres-a-danser-lp5-14"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "26 lettres à danser"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Danse / pour les 4 ans et plus Abécédaire dansé, interactif et multidisciplinaire, 26 lettres à danser propose un voyage au cœur des lettres et des mots. Sollicité à la fois physiquement et intellectuellement, le jeune public prend part à ce kaléidoscope riche en couleurs et en textures dansées. Dans cette création ludique et audacieuse, la chorégraphe Hélène Langevin invite les enfants à vivre une expérience unique : non seulement assister à une œuvre vivante, mais aussi y participer au fil des tableaux. Du A, qui ouvre le bal, au Z, qui tire sa révérence, les lettres de cet abécédaire donnent vie à une pluralité de mots, de sens, d'émotions et de tons. 26 lettres à danser est une œuvre poétique et résolument contemporaine qui décloisonne le spectacle jeunesse et bouscule les conventions théâtrales! Durée approximative: 60 minutes"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
