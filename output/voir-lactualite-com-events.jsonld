    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 19 décembre 2026 à 0 h, à Chapelle Saint-Bernard (Saint-Bernard). Le pianiste Philippe Le Bon présente un concert de piano sous les chandelles durant le temps des Fêtes à la Chapelle Saint-Bernard. Cette expérience musicale envoutante allie la magie des Fêtes à l’élégance d’une ambiance…"
      }
    ],
