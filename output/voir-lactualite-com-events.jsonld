    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/atelier-polyglotte-anime-par-zelie-nayral-daa248"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Atelier polyglotte, animé par Zelie Nayral"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Que vous parliez hindi, swahili, arabe, grec, italien ou créole, venez faire entendre votre langue et votre voix lors de cet atelier d’écriture collective polyglotte. Nous commencerons par un temps d’écriture, puis nous prendrons un moment pour partager nos textes et nos réflexions. Une occasion de faire vibrer nos racines à travers nos langues, de rendre hommage à nos pays d’origine et à nos couleurs. Ensemble, faisons respirer la diversité linguistique du monde! Zelie Nayral est installée au Québec depuis trois ans. Elle a choisi le Bas-Saint-Laurent pour réaliser une maîtrise en études des pratiques psychosociales portant sur l’écriture comme chemin de reconstruction. En parallèle, elle présente des spectacles, pratique le slam, donne des formations en arts du clown et écrit pour les enfants. Pendant le temps qu’il lui reste l’hiver, elle se consacre également à la chocolaterie artisanale. Grande voyageuse et curieuse au quotidien, elle anime depuis dix ans des ateliers d’écriture ainsi que des ateliers d’arts visuels et vivants auprès d’enfants et de personnes aînées."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
