    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Balado et atelier créatif | La carrière industrielle du… | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 25 novembre 2026 à 17 h, à Centre communautaire Régent-Martimbeau (Laval). Comment le travail industriel a-t-il sculpté le quartier Vimont ? Au début du 20e siècle, son développement s’est fait autour des carrières de pierre. Signé Laval et le centre d’archives souhaitent aller à la rencontre…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://voir.lactualite.com/evenements/balado-et-atelier-creatif-la-carriere-industrielle-du-quarti-e7ea09"
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
        "@value": "fr_CA"
      }
    ]
  },
