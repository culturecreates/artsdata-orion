    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "AMÉLIE COURTOIS Expostion Notcimik (la forêt), se connaître pour savoir d’où l’on vient"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le centre Bang et la ville de Saguenay présentent le travail d'Amélie Courtois à l'Espace Partagé à l'automne 2026. L'artiste d'origine ilnu et atikamekw s'est lancée dans des recherches créatives en territoire et à l'intérieur d’elle-même, s'inspirant du notcimik et de ses bienfaits pour l’exposition évolutive Notcimik (la forêt), se connaître pour savoir d'où l'on vient."
      }
    ],
