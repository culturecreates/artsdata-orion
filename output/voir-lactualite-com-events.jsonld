    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Comic Jam: activité ludique et sociale"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Autrices, auteurs et artistes, toute personne qui aime dessiner, vous êtes invité.e.s à participer à cet atelier de Comic Jam. Participez à la création de planches de bandes dessinées en groupe. À tour de rôle, chacun.e invente et dessine une nouvelle case de l'histoire, qui sera poursuivie par un.e autre comparse. N'oubliez pas d’apporter vos outils créatifs préférés! Les ateliers Comic Jam de Québec sont animés par Rémi Paradis de Confiture Bd Québec et existent depuis 2012. Réservez votre place et rejoignez l'événement sur Facebook!"
      }
    ],
    "http://schema.org/inLanguage": [
