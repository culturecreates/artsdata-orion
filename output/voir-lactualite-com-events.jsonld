    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Chiendent"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Chiendent est le premier one-woman-show de Mégan Brouillard. Le spectacle part de la notion de mauvaise herbe : ce qui est du chiendent pour l'un ne l'est pas forcément pour l'autre, et ce qui pousse à un endroit peut être accepté ailleurs. Mégan Brouillard y explore les perceptions de chacun et chacune, dont les siennes, et y présente sa famille sans filtre, dans un ton mordant et authentique, en s'inspirant notamment de l'expression de sa grand-mère sur le chiendent qui pousse partout."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
