    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Alexandre Forest"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Alexandre Forest est un humoriste qui entame le rodage de son premier one man show. Son humour repose sur un alliage d'autodérision et de finesse d'esprit. Il s'y attarde aux petites et grandes incongruences de la vie quotidienne, dans un spectacle qui invite le public à découvrir son univers à ses débuts sur scène en solo."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
