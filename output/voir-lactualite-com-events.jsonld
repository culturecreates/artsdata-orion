    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Alexandre Forest"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Alexandre Forest est un humoriste. Lors d'un spectacle précédent, il entamait le rodage de son premier one-man-show, présenté comme l'occasion de le découvrir et de se laisser emporter dans son univers. La présentation de ce spectacle évoquait un alliage d'autodérision et de finesse d'esprit, qui capture l'essence des petites et grandes incongruences de la vie quotidienne. Le rendez-vous actuel se tient à Alma, à La boîte à bleuets."
      }
    ],
