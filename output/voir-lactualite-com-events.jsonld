    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Chantal Lamarre - Steppettes et cornemuse"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Steppettes et cornemuses est un spectacle de variété de style cabaret, qui renoue avec les soirées des cabarets d'antan où l'on chante et l'on ose la steppette. Après quarante ans dans le métier, Chantal Lamarre y chante, danse et joue la comédie, et commente la société et la culture avec un regard critique et drôle. Les codes vintage du spectacle servent à aborder des enjeux bien actuels, entre rires et émotion."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
