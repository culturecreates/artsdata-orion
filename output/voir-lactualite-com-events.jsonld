    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Chances"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Forte de son nouvel album, And Now You Become a Seeker, où folk et électro s’unissent avec audace et délicatesse, la formation CHANCES propose un spectacle unique et immersif. Porté par des harmonies vocales captivantes, des percussions vibrantes et des arrangements à la fois raffinés et intenses, l’ensemble trace une musique lumineuse, profondément tournée vers l’humain. Fondé en 2016 par Chloé Lacasse (clavier, guitare, voix), Geneviève Toupin (guitare, clavier, accordéon, voix) et Vincent Carré (batterie, percussions), Chances puise dans ses racines francophones, anglophones et métissées pour façonner une identité musicale unique en son genre. Entre textures organiques et sonorités électroniques, le trio célèbre la diversité culturelle et la force du collectif à travers une musique sensible et innovante."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
