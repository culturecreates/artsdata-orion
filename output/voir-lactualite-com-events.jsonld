  {
    "@id": "https://voir.lactualite.com/evenements/breen-leboeuf-7565a4",
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "fr-ca",
        "@value": "VOIR — L’actualité"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Breen LeBœuf — Sherbrooke | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 5 novembre 2026 à 20 h, à Théâtre Granada (Sherbrooke). En plus d’être l’interprète d’un des plus grands succès de notre histoire musicale, Breen LeBoeuf est pour plusieurs considéré comme l’une des plus belles voix du Québec. Cette légende du Rock provoque l’enthousiasme d’un public charmé…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://voir.lactualite.com/evenements/breen-leboeuf-7565a4"
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
        "@value": "fr_CA"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://theatregranada.com/wp-content/uploads/2026/02/1080x1080-BREEN_LEBOEUF.jpg"
      }
    ]
  },
  {
    "@id": "https://voir.lactualite.com/genid/74a09b04e83f2d32",
    "@type": [
      "http://schema.org/MusicEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-05T20:00:00-05:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-05T23:00:00-05:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://voir.lactualite.com/genid/341b3374bc812182"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://theatregranada.com/wp-content/uploads/2026/02/1080x1080-BREEN_LEBOEUF.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://voir.lactualite.com/evenements/breen-leboeuf-7565a4"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://voir.lactualite.com/genid/f14a84dacb8df28b"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://voir.lactualite.com/artistes/breen-leboeuf-8a3bd6#artist"
      },
      {
        "@id": "https://voir.lactualite.com/artistes/rejean-lachance-28af61#artist"
      },
      {
        "@id": "https://voir.lactualite.com/artistes/pierre-beauregard-a8820e#artist"
      },
      {
        "@id": "https://voir.lactualite.com/artistes/marc-brodeur-ef4da2#artist"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/045290732962ea36"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/breen-leboeuf-7565a4"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Breen LeBœuf"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "En plus d’être l’interprète d’un des plus grands succès de notre histoire musicale, Breen LeBoeuf est pour plusieurs considéré comme l’une des plus belles voix du Québec. Cette légende du Rock provoque l’enthousiasme d’un public charmé, voir impressionné, par sa performance vocale, l’unique signature de chacune de ses interprétations, ses anecdotes inédites et cette solide énergie qui continue de l’habiter après plus de 55 ans de carrière. MES BLUES PASSENT PU DANS’ PORTE nous replonge dans cette époque marquée par le groupe culte Offenbach dont Breen a été l’un des principaux artisans. Pour l’occasion, il a le plaisir et l’honneur de s’entourer de quelques-uns de nos meilleurs musiciens/chanteurs: Réjean Lachance à la guitare, Pierre Beauregard au clavier et sax et Marc Brodeur aux drums. C’est donc en leur compagnie que Breen revisite pour vous les plus grands classiques d’Offenbach et célèbre avec vous ce groupe qui nous a laissé un des plus riches répertoires musicaux d’ici."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
