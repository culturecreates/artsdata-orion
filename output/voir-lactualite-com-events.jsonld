    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Charles Beauchesne"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "L'humoriste Charles Beauchesne présente des conférences loufoques sur des épisodes marquants de l'Histoire, avec diapositives. Dans l'un de ses volets, il s'intéresse au cercle rapproché d'Hitler : qui étaient les nazis, à quoi ils croyaient et pourquoi ils se détestaient entre eux. Le ton se veut ludique et, peut-être, éducatif."
      }
    ],
