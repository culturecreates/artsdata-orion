    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Mélanie Couture"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Mélanie Couture présente Ça change toute, son deuxième spectacle solo en humour. Le spectacle invite à voir les choses sous un autre angle, à travers des blagues mordantes sur des sujets comme l'éducation sexuelle, le sommeil, le point G ou les dessous de la pornographie. L'humoriste aborde avec intelligence les sujets les plus intimes, avec un rire contagieux, des propos crus et un talent pour dénouer les tabous. Le spectacle rappelle que, parfois, il faut du temps avant que tout change."
      }
    ],
