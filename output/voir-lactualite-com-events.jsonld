  {
    "@id": "https://voir.lactualite.com/genid/8c401a332e578f80",
    "@type": [
      "http://schema.org/DanceEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-14T20:00:00-05:00"
      }
    ],
    "http://schema.org/endDate": [
