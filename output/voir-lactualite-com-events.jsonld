    "http://schema.org/performer": [
      {
        "@id": "https://voir.lactualite.com/artistes/canif-379f50#artist"
      },
      {
        "@id": "https://voir.lactualite.com/artistes/mange-la-machine-f63ea7#artist"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/bc742605da929cc5"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/canif-lancement-mange-la-machine-lp11-1744"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Canif (Lancement) + Mange la machine"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Quelque part entre les Queens Of The Stone Age, The White Stripes et The Black Keys, le duo Canif propose un rock francophone incisif et nuancé accompagné de textes aussi puissants que sensibles. À travers les harmonies vocales et le côté bluesy de l'harmonica, la formation de Québec signe une musique viscérale et rassembleuse. Participez à ce nouveau chapitre d'un groupe rock francophone qui laissera une trace indélébile de son passage dans le paysage sonore québécois. Parmi les six chansons du EP, Vincent Peake (Groovy Aardvark, Grimskunk) prête sa voix sur la chanson «Ton silence». Mange La Machine : Autoproclamé grunge postapocalyptique, Mange La Machine est un quatuor de Saint-Jean-Sur-Richelieu réunissant des membres de Capitaine Révolte, Slater et Fils, Les Sania et Les Hommes Cellophanes. Avec un son qui puise autant dans le rock alternatif des années 90 que chez leurs contemporains de la scène québécoise, Mange La Machine présente en 2025 un album de 9 morceaux de pur rock franco-canadien avec un son percutant et des paroles significatives. «Passif-agressif» est audacieux mais simple, satisfaisant et intelligent."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
