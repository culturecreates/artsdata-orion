    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Bénévolat"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le Théâtre À tour de rôle présente Bénévolat, une production de Tableau Noir. Amaryllis étudie en sciences à l'université tandis qu'Anthony est incarcéré dans un pénitencier. Leurs chemins se croisent dans un petit local où, deux heures par semaine, Amaryllis devient professeure de français et Anthony, élève du secondaire. Au fil de ces rencontres hebdomadaires, ils devront, malgré eux, apprendre à se connaître. Le texte est signé Maud de Palma-Duquet, la mise en scène par Rose-Anne Déry, avec Stéphanie Arav et Mathieu Richard à l'interprétation. La pièce est lauréate du prix Gratien-Gélinas 2022. Une discussion suit la représentation."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
