    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Château Miroir"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Méliane, ado discrète, voit sa vie chavirer le jour où son reflet l’entraîne de l’autre côté d’une flaque d’eau remplie de ses larmes. Elle est transportée dans un royaume fantastique où son double règne sur un monde menacé par le doute et l’angoisse. Commence alors une aventure initiatique où elle devra apprivoiser ses peurs pour révéler sa propre lumière."
      }
    ],
