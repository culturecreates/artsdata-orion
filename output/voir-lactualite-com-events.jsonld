    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Concert de Noël de la Chorale Hallelujah"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Plongez dans la magie du temps des Fêtes avec la Chorale Hallelujah de Bromont, sous la direction de la pétillante cheffe de chorale Inger Woest, l’excellente artiste musicienne et chanteuse bien connue dans le monde culturel de Bromont et de l’Estrie. Au programme : les plus beaux chants traditionnels et classiques de Noël, interprétés avec passion et émotion par nos choristes et nos invités. Un moment de joie, de partage et de lumière, à vivre en famille et entre amis, pour célébrer l’esprit de Noël au cœur de notre communauté. Venez chanter, sourire et vous émerveiller avec nous! Plongez dans la magie du temps des Fêtes avec la Chorale Hallelujah de Bromont, sous la direction de la pétillante cheffe de chorale Inger Woest, l’excellente artiste musicienne et chanteuse bien connue dans le monde culturel de Bromont et de l’Estrie. Au programme : les plus beaux chants traditionnels et classiques de Noël, interprétés avec passion et émotion par nos choristes et nos invités. Un moment de joie, de partage et de lumière, à vivre en famille et entre amis, pour célébrer l’esprit de Noël au cœur de notre communauté. Venez chanter, sourire et vous émerveiller avec nous!"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
