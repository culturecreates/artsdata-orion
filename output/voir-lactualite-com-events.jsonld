    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Daniel Mille - Après la pluie"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "L'accordéoniste Daniel Mille navigue dans plusieurs styles musicaux, avec sensibilité et créativité. Le spectacle s'articule autour de son album Après la pluie, dont les œuvres évoquent un imaginaire musical à caractère jazz, ponctué de reflets cinématographiques. Quelques pièces du pianiste Yves Léveillé et Oblivion de Piazzolla complètent le programme. Sur scène, Daniel Mille est accompagné d'Yves Léveillé (piano), Guy Boisvert (contrebasse), Pierre Tanguay (batterie) et Frank Lozano (saxophone). Le concert est présenté par l'Aramusique dans sa série Apéro-Jazz."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
