    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Ballet Jörgen Danse"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "À l'occasion du 25e anniversaire de la compagnie en 2012, le directeur artistique et chef de la direction Bengt Jörgen a revisité le classique et dramatique Lac des Cygnes, en y ajoutant une touche d'héritage canadien, souvent caractéristique de son travail. Si cette production du Lac des Cygnes met en valeur l'extraordinaire beauté du ballet traditionnel dans sa forme la plus pure, Jörgen l'a réimaginée dans le pittoresque paysage marin de la forteresse de Louisbourg, en Nouvelle-Écosse."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
