    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Constantinople : Aux racines du monde"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le concert Aux racines du monde s'inspire des expressions musicales les plus anciennes et souligne le 25e anniversaire de Constantinople. Il réunit des artistes invités de Corée, des Premières Nations du Canada et d'autres horizons. Sur scène, Kiya Tabassian (sétar et chant), Didem Basar (kanun), Kianoush Khalialian (ney), Patrick Graham (percussion) et Hamin Honari (tombak et daf) accueillent des musiciens invités. Des pratiques chamaniques aux traditions musicales d'Asie, du Moyen-Orient et des Amériques, le programme explore chants et rythmes transmis de génération en génération. Constantinople et le Grand Théâtre de Québec coprésentent le concert."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
