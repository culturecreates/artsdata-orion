    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/atelier-de-danses-de-la-renaissance-8623f2"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Atelier de danses de la Renaissance"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "La Renaissance est une période importante pour l’essor de la danse en Occident, car on y voit apparaître les tout premiers traités de danse. Cette série d’ateliers s’intéressera aux danses des cours italiennes des Quattrocento et Cinquecento (bassa danza, balletto,…). Nous y danserons aussi le répertoire de bal en usage en France à la fin du XVIe siècle selon l’incontournable Orchésographie de Thoinot Arbeau (branle, pavane, gaillarde,…). Ces ateliers de 2h chacun, sont ouverts à toutes et à tous, bienvenue également aux musicien.nes qui jouent ce répertoire (Praetorius, Attaingnant, Gervaise, Phalèse, etc.) et qui veulent en connaître les danses. Chacun des ateliers abordera différentes danses, ils peuvent donc être suivis de manière indépendante."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
