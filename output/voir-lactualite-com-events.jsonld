      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 27 novembre 2026 à 19 h 30, à Maison de la Culture de Sainte-Anne-des-Monts (Sainte-Anne-des-Monts). Yves Lambert, musicien dont le parcours remonte à ses débuts avec La Bottine Souriante, présente un spectacle retraçant 50 ans de carrière. Le spectacle explore son grand répertoire bâti depuis…"
      }
    ],
