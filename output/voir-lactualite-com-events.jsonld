    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "5 mots, 1 histoire : atelier d'écriture créative avec… | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 24 octobre 2026 à 10 h 30, à Lieu à préciser – La Sarre (La Sarre). Recevez cinq mots mystérieux et transformez-les en histoire, en poème, en slam ou en texte humoristique. Un atelier ludique pour explorer l'écriture, stimuler son imagination et découvrir que quelques contraintes suffisent…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
