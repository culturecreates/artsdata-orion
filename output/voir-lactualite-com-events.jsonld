      {
        "@language": "fr-ca",
        "@value": "Cabanes culturelles — Saint-Basile-le-Grand | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 1er novembre 2026 à 12 h, à Espace culturel U-Art (Saint-Basile-le-Grand). Laissez libre cours à votre créativité en explorant une nouvelle technique artistique chaque mois. Du matériel et des projets variés vous permettront de créer une œuvre à votre image, à votre rythme. Pratique libre et…"
      }
