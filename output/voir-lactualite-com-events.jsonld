    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Baby Boomers Band"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "SOUPER SPECTACLE Baby Boomers Band DATE: 31 DÉCEMBRE 2026 HEURE DU SOUPER : DÈS 17H30 JUSQU'À 19H HEURE DU SPECTACLE: DÉBUTE À ENVIRON 20H00 À 3H00 SOUPER À LA CARTE OBLIGATOIRE (POURBOIRE EN SUS) 5 CHOIX D'ENTRÉES (entre 14 $ et 25 $) 4 CHOIX DE PLATS PRINCIPAUX (à partir de 28 $) (parmi des options de pâtes, de poulet, de porc et de bœuf) Nous pouvons accommoder vos allergies le soir même, sans problème. INFO: [phone] * Vestiaire 2 $ * Plus tôt réservé, plus près de la scène vous serez! Notez que les places sont assignées par ordre de réservation SOUPER SPECTACLE Baby Boomers Band DATE: 31 DÉCEMBRE 2026 HEURE DU SOUPER : DÈS 17H30 JUSQU'À 19H HEURE DU SPECTACLE: DÉBUTE À ENVIRON 20H00 À 3H00 SOUPER À LA CARTE OBLIGATOIRE (POURBOIRE EN SUS) 5 CHOIX D'ENTRÉES (entre 14 $ et 25 $) 4 CHOIX DE PLATS PRINCIPAUX (à partir de 28 $) (parmi des options de pâtes, de poulet, de porc et de bœuf) Nous pouvons accommoder vos allergies le soir même, sans problème. INFO: [phone] * Vestiaire 2 $ * Plus tôt réservé, plus près de la scène vous serez! Notez que les places sont assignées par ordre de réservation [email] Baby Boomers Band Depuis les 27 dernières années, les membres de cette formation ont partagé la scène avec de nombreux artistes. Près de 450,000 personnes ont pu les applaudir et danser sur ces succès populaires des palmarès anglophone et francophone ’50, ’60 et ’70. Déjà cinq albums à leur actif, un plaisir fou sur scène, une multitude de projets et une réputation enviable dans les domaines du Rock & Roll et du Doo-Wop. Jeunes et moins jeunes, fermez les yeux et laissez-vous envahir par des harmonies vocales étonnantes, préparez-vous à danser et à revivre vos plus agréables souvenirs. Laissez-vous emporter … par le Baby Boomer’s Band !"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
