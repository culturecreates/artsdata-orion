    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Bidule Man"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Bidule Man Âge : 4 ans et plus Durée : 50 minutes Cirque et musique SYNOPSIS : Chercheur de sons et collectionneur de textures sonores, Bidule Man est spécialiste de la musicalité cachée en chaque objet : planches à repasser consonantes, basse-cour caoutchoutée, enjoliveurs et plusieurs autres « instruments » tirés de son quotidien ludique composent ses symphonies. Un parcours d’objets orchestrés dans une contorsion musicale clownesque ! ABONNEMENT JEUNE PUBLIC Abonnement jeune public (familial) : Acheter 3 spectacles ou + en même temps pour obtenir 2$ de rabais par billet sur le prix régulier Abonnement jeune public pour les résidents de Blainville : Acheter 3 spectacles ou + en même temps en personne à la billetterie pour obtenir un 2$ de rabais supplémentaire par billet (Achat en personne seulement, car nous devons voir la carte de citoyen de Blainville)"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
