    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Billy Tellier"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Billy Tellier a présenté son troisième one-man-show, après une dernière tournée ayant réuni plus de 50 000 billets vendus et près de 200 représentations. Il y aborde des sujets rassembleurs et livre ses états d'âme sur sa peur de faire les mauvais choix, dans un spectacle rythmé."
      }
    ],
