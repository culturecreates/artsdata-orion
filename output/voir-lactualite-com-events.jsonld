    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le mercredi 26 mai 2027 à 20 h, Grand Théâtre de Québec (Québec). Imitateur aux mille voix et aux mille talents, David Corriveau cumule plus de 35 millions…"
      }
    ],
