    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 21 septembre 2026 à 0 h, à Amuzart (Gatineau). Du 21 septembre 2026 au 16 novembre 2026. Cours de bricolage créatif pour enfants de 7 à 12 ans. Lundis 18h15-19h45. Techniques variées : découpage, collage, papier mâché, peinture, modelage. Thèmes saisonniers (Halloween, automne, Noël)."
      }
    ],
