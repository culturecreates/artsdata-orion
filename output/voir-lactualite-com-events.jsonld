      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 22 octobre 2026 à 0 h, à Plusieurs lieux – Otterburn Park (Otterburn Park). Amélie Beyries, professionnellement connue sous le nom de BEYRIES, est une auteure-compositrice-interprète canadienne originaire de Montréal. Elle se lance dans la musique à 28 ans et sort son premier album, Landing, en…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
