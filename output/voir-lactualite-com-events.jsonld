    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Alexis Fortin"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le Minotaure est fier de présenter: ALEXIS FORTIN. SOURCILS est le magnum opus d’Alexis Fortin. Sa plus grande œuvre en carrière. La plus transcendante, la plus vulnérable, la plus aboutie, la plus travaillée. À seulement 26 ans, il atteint l’apogée de son art. Un spectacle qui fait se demander : « Où était-il avant? ». « Qui même était-il avant? ». « Comment n’ai-je jamais eu accès à un spectacle de stand-up aussi grandiose de sa part? ». Jetez tout ce que vous connaissez d’Alexis Fortin par la fenêtre. SOURCILS est sa meilleure œuvre. C’est aussi sa première œuvre."
      }
    ],
