    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "5 À 7 la Route du Rire"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Qui a dit que les spectacles d’humour ne devaient être vus qu’à partir de 20 h? Culture Trois-Rivières croit plutôt aux bienfaits de l’humour directement après le travail avec les 5 à 7 La route du rire! Ces 5 à 7 festifs mettront en scène de 2 à 4 humoristes de la relève par soir. Membres Accès Plus: Veuillez prendre note qu’exceptionnellement seul le rabais de 10 % et 15 % est disponible pour ce spectacle."
      }
    ],
