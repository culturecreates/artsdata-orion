    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Carnaval de Québec, en collaboration avec Loto-Québec"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le Carnaval de Québec a visiblement décidé de rehausser sa programmation musicale cette année! Pour sa 73e édition, présentée du 5 au 14 février 2027, l’événement annonce 27 spectacles répartis sur neuf soirées et trois sites. Il s’agit, selon les organisateurs, de la plus imposante programmation musicale extérieure de son histoire, signe d’un virage qui accorde une place grandissante aux spectacles dans l’expérience carnavalesque."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
