    ],
    "http://schema.org/performer": [
      {
        "@id": "https://voir.lactualite.com/artistes/frederic-antoun-771999#artist"
      },
      {
        "@id": "https://voir.lactualite.com/artistes/myriam-leblanc-482031#artist"
      },
      {
