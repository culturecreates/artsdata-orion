      {
        "@language": "fr-ca",
        "@value": "fr_CA"
      }
    ]
  },
  {
    "@id": "https://voir.lactualite.com/genid/291dcee7afc3b659",
    "@type": [
      "http://schema.org/TheaterEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-10-28T20:00:00-04:00"
      }
    ],
    "http://schema.org/endDate": [
