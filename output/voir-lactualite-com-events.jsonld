  {
    "@id": "https://voir.lactualite.com/evenements/a-corps-vins-5799c3",
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#site_name": [
