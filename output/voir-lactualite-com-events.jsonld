    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "C’est trop beau, je vais le prendre en photo de Jasmine Bilodeau"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Cette exposition de photographie de Jasmin Bilodeau porte sur les commerces de proximité disparus, dont les locaux vacants, les vitrines vidées et les enseignes usées. L'artiste photographie ces lieux depuis longtemps et intègre ces images à des interventions numériques et à des bricolages, en trompe-l'œil. Les graffitis de la vitrine d'Électrobec 2000 forment une dissonance de discours militants et comiques, tandis que des feuilles d'automne fabriquées de toutes pièces ornent une façade. L'exposition invite à prendre la mesure de ce que signifient ces devantures."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
