    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Au sommet"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Au sommet est un spectacle solo de Philippe Laprise, son cinquième one-man-show en 25 ans de carrière, présenté alors qu'il souligne ses 50 ans. L'artiste s'interroge sur ce que signifie réellement être au sommet à une époque où tout évolue rapidement. À un âge qu'il qualifie de presque vénérable, il s'assume et n'a plus rien à perdre. Le spectacle se veut sans filtre, avec une bonne dose d'autodérision."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
