    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Cathy Gauthier"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Humoriste québécoise, Cathy Gauthier présente un nouveau spectacle, actuellement en rodage, qui constitue son cinquième spectacle. Dans cette création, elle aborde le poids des attentes, la quête d'équilibre et le courage d'être soi, et se dévoile davantage que dans ses précédents spectacles. Originaire de Rouyn-Noranda et diplômée de l'École nationale de l'humour, elle a été nommée Révélation de l'année au Festival Juste pour rire en 2003 et a reçu un Olivier de l'auteur de l'année ainsi qu'un Félix du spectacle d'humour de l'année. Ses quatre one-woman-shows précédents incluent 100% vache folle, Décoiffe, Pas trop catholique et Classique."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
