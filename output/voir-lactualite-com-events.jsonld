      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "AURA à l’église Saint-Roch : spectacle immersif de Moment… | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 5 décembre 2025 à 17 h 30, à Église Saint-Roch (Québec). Depuis le 5 décembre 2025, AURA, l’expérience immersive créée par Moment Factory, se joue dans l’église Saint-Roch, 555, rue Saint-François Est, dans le quartier Saint-Roch, avec entrée par le parvis. La soirée se déroule en deux temps …"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://voir.lactualite.com/evenements/aura-a-l-eglise-saint-roch-spectacle-immersif-de-moment-fact-972416"
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
        "@value": "fr_CA"
      }
    ]
  },
  {
    "@id": "https://voir.lactualite.com/genid/cf0b1e2004d899b5",
    "@type": [
      "http://schema.org/ExhibitionEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2025-12-05T17:30:00-05:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-28T19:00:00-05:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://voir.lactualite.com/genid/89ffce438658d1bf"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://voir.lactualite.com/evenements/aura-a-l-eglise-saint-roch-spectacle-immersif-de-moment-fact-972416"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://voir.lactualite.com/genid/eaf0e5eb21e4e35a"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://voir.lactualite.com/artistes/moment-factory-48e5e3#artist"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/2f0fbeebca6225b1"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/aura-a-l-eglise-saint-roch-spectacle-immersif-de-moment-fact-972416"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "AURA à l’église Saint-Roch : spectacle immersif de Moment Factory, séances en soirée jusqu’au 28 novembre 2026"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Depuis le 5 décembre 2025, AURA, l’expérience immersive créée par Moment Factory, se joue dans l’église Saint-Roch, 555, rue Saint-François Est, dans le quartier Saint-Roch, avec entrée par le parvis. La soirée se déroule en deux temps : un pré-spectacle de 15 minutes pour explorer l’église et son histoire avec une application Web, puis un spectacle de 30 minutes de projections, de jeux de lumière et de musique orchestrale sur la nef et les voûtes. Les séances commencent dès 17 h 30 et sont en vente jusqu’au 28 novembre 2026 sur la billetterie Fever ; l’organisateur annonce plus de 50 000 billets vendus et ajoute des dates par blocs (sources : auraeglisesaintroch.com et billetterie Fever, consultés le 2 octobre 2026). Tarifs plus taxes : 35 $ pour les 16 ans et plus, 22 $ pour les 5 à 15 ans, 30 $ pour les 65 ans et plus et 30 $ par billet pour les groupes de dix et plus ; gratuit pour les 4 ans et moins. Les billets ne sont ni remboursables ni échangeables, mais la date ou l’heure peut être modifiée jusqu’à 72 heures avant la représentation, selon les places. L’église a une entrée accessible aux personnes à mobilité réduite, aucun stationnement sur place et ne vend ni nourriture ni boisson."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
  {
    "@id": "https://voir.lactualite.com/genid/eaf0e5eb21e4e35a",
