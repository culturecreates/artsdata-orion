    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Alphé Gagné – On repart — Amqui | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 13 novembre 2026 à 20 h, à MICROBRASSERIE LA CAPTIVE (Amqui). ON REPART, c'est le nouveau spectacle qu'Alphé Gagné rode. Dans ce nouvel opus (ouais… ça sonne le White Album des Beatles), il tente de répondre à la fameuse question : « T'as pas fait d'humour pendant 20 ans… qu'est-ce que tu…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://voir.lactualite.com/evenements/alphe-gagne-on-repart-052147"
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
        "@value": "fr_CA"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://tpos.s3.amazonaws.com/events/ATP/26/11/13/001/atp261113001-1152x648-fr-69dc4451.png"
      }
    ]
  },
  {
    "@id": "https://voir.lactualite.com/genid/752a8db494827bf8",
    "@type": [
      "http://schema.org/ComedyEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-13T20:00:00-05:00"
      }
    ],
    "http://schema.org/endDate": [
