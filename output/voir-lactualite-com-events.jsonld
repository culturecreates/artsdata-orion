    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "40 temps d’évolution – Institut des arts figuratifs"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Cette exposition rassemble les œuvres des membres de l’Institut des arts figuratifs. Reconnus pour l’excellence de leur pratique artistique, les membres signataires se distinguent par la qualité de leur travail, tant dans la création que dans l’exécution de leurs œuvres et par leur parcours professionnel. Présentée en partenariat avec l’Atelier d’Art d’Alma, l’entrée pour cette exposition est gratuite, grâce au soutien de la Ville d’Alma et du gouvernement du Québec."
      }
    ],
