    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 23 août 2027 à 11 h, à Place des Anciens-Combattants (Rimouski). Découvrez les traditions de la République Démocratique du Congo avec Naxx Bittota, artiste née d’une longue lignées de guérisseurs. Une activité pour toutes la famille!"
      }
    ],
