    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Laissez-vous emporter par un programme où la fougue et l’imaginaire se rencontrent. en compagnie de la pianiste Meagan Milatz, découvrez le Carnaval romain de Berlioz, dans l’arrangement de David Walter, ainsi que Five Luminous Studies de Kelly-Marie Murphy."
      }
