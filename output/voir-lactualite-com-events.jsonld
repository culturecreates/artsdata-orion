    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Anne-Sarah Charbonneau"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dans un monde où on haït un peu les trans, les lesbiennes, mais surtout les cyclistes (sauf Jay du Temple, y’est parfait <3). Ce spectacle est une première ébauche, mais c’est toujours touchant de voir un enfant tenter de rouler sur deux roues pour la première fois, non? Bon, ce ne sera pas pareil parce que je suis adulte, mais vu que je porte le même linge qu’à 6 ans, je risque d’être aussi touchant."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
