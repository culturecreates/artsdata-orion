      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le duo 2Frères réunit deux artistes qui revisitent leurs plus grands succès avec sincérité et complicité. Son univers musical est décrit comme intimiste et chaleureux, avec des chansons reprises sous un angle nouveau. Son spectacle En Duo, présenté dans une formule acoustique, s'inscrit dans cette démarche."
      }
    ],
