    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le mercredi 14 avril 2027 à 19 h 30, Salle André-Mathieu (Laval). Depuis maintenant dix ans, Manon Brassard vit terrée chez elle, incapable de s’extraire…"
      }
    ],
