    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 7 novembre 2026 à 21 h, à New City Gas (Montréal). [DSTRKT] est un format de production immersive présenté par Produkt, qui rapproche les DJs underground de leur public : des fans entourent le DJ sur trois côtés, et l'énergie circule dans les deux sens. Selon la page de l'événement, ce concept…"
      }
    ],
