      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Après la perte de son père, Jacob, 12 ans, déménage dans la maison d'enfance de ce dernier. Il y découvre une vieille cassette VHS du film Air Bud. Puis, il fait la rencontre d'un Golden Retriever errant qui aide Jacob à retrouver espoir..."
      }
