    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Au nom du père"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Au nom du père est un spectacle de Fred Pellerin. Le récit commence à la mort du curé d'un village : deux fosses sont creusées de part et d'autre de la clôture du cimetière, et pendant trois jours de veillée, les habitants débattent du côté où le coucher. Le récit de la veuve pendant les veillées funèbres dévoile des secrets du défunt et mène au grand jugement du légendaire tribunal populaire de Saint-Élie-de-Caxton. Le spectacle mêle poésie, humour et vérités enfouies."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
