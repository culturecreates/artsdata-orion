    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Anthony Courcy présente : Je sais pas pourquoi je suis là"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Anthony Courcy présente son premier solo!? Un spectacle à l’emballage clair laissant entrevoir son contenu flou. Vous arriverez à « Je sais pas pourquoi je suis là » la tête remplie de questions. Vous en sortirez sans réponses MAIS avec une intégrité mentale fragilisée. Un show ludique où l’espace d’une heure vous ne penserez pas à la brassée oubliée dans votre laveuse. Un siège vous sera assigné sur place ! Vous réservez pour un groupe de 20 personnes et plus ? Écrivez-nous au [email]"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
