  {
    "@id": "https://voir.lactualite.com/evenements/clement-jacques-saint-jacques-b37c46",
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "fr-ca",
        "@value": "VOIR — L’actualité"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Clément Jacques Saint-Jacques — Saint-Jacques | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 7 novembre 2026 à 20 h, à Le Pub 205 (Saint-Jacques). Clement Jacques est un auteur-compositeur-interprète évoluant dans un style folk pop rock. Lors d'un précédent spectacle intitulé Iris, présenté à la suite de son cinquième album, il partageait sur scène des réflexions sur les relations…"
      }
    ],
    "http://ogp.me/ns#url": [
