    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 28 septembre 2026 à 0 h, à Lieu à préciser – Sorel-Tracy (Sorel-Tracy). Participez au concours d’écriture d'Halloween pour courir la chance de gagner l’un des prix de participation. Pour ce faire, il suffit d’écrire une histoire, une anecdote ou une mésaventure qui donne la frousse, et de faire…"
      }
    ],
