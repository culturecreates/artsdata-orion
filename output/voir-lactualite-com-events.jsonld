    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Antoine Rivard-Landry – Portraits de génies"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le pianiste Antoine Rivard‑Landry, lauréat du concours Auguste‑Descarries, du Wien Klassik et du concours de l’Orchestre de Trois‑Rivières, séduit par un jeu lumineux, raffiné et expressif. Son intelligence musicale et sa présence scénique magnétique en font un interprète capable d’émouvoir et d’éblouir. Antoine nous propose un concert dédié à Beethoven et Chopin."
      }
    ],
