    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 28 octobre 2026 à 19 h, à AUBERGE DES BALCONS (Baie-Saint-Paul). L'open mic des Balcons fait son grand retour avec un nouveau nom : BALCONS OUVERTS! Textes, poèmes, slam, humour, musique ou tout simplement quelque chose que tu as envie de partager : viens prendre la parole, écouter, découvrir…"
      }
    ],
