    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Ateliers de Chants Traditionnels"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "À la fréquence d'un jeudi sur trois, nous chantons de la musique traditionnelle ! 18 h : la soirée débute avec un atelier de chant traditionnel animé par Louve. 19 h 30 : la soirée se poursuit sous forme de veillée. Les personnes de toutes les cultures sont invitées à nous partager un petit morceau de leur folklore chanté, musical, conté, etc. jusqu'à 21 h. Un moment à la bonne franquette pour donner l'espace à la transmission de répertoire, au partage culturel et à l'appréciation du patrimoine vivant ! C'est un événement sans inscription et ouvert à tous. Les contributions volontaires sont bienvenues. Organisatrices : [nom], [phone]."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
