    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Charles Brunet"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Charles Brunet est un humoriste qui se présente comme ayant 24 ans et qui dit commencer à comprendre son métier. Son spectacle précédent, intitulé « Très très bon show », aborde un peu de tout, de TikTok à MSN, et s'adresse autant aux jeunes qu'aux plus âgés. Il le décrit comme l'œuvre dont il est le plus fier de sa jeune carrière."
      }
    ],
