    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Au travers de la route"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Au travers de la route est la tournée de Vincent Vallières, auteur-compositeur-interprète qui souligne ainsi ses 25 ans de carrière. Entouré de ses musiciens, il présente un tout nouveau spectacle où son imposant répertoire se joint aux pièces de son nouvel album. La tournée se poursuit à travers le Québec. Le spectacle a remporté le Félix du Script de l'année, prix partagé avec Christine Beaulieu lors du Gala de l'Industrie de l'Adisq."
      }
    ],
