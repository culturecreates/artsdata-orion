      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://voir.lactualite.com/genid/5a50ac84232f1977"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/1d9f0fde4a8c006d"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/chostakovitch-7f61b1"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Chostakovitch"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "À l'occasion du 120ème anniversaire de naissance du compositeur russe, nous découvrirons les aspects d'une personnalité grandiose, déchirante et sarcastique. Consacré comme le plus grand symphoniste soviétique en Russie comme dans le monde entier, Chostakovitch se démarque par ses trouvailles fortes et originales à travers une production abondante. Que ce soit dans ses concertos, dans sa musique de chambre, dans ses opéras ou dans ses symphonies, il nous démontre tous les aspects de sa science musicale. Par l'écoute de ses œuvres, nous démystifierons à la fois cette figure complexe qui nous semble peu familière, et pourtant si attachante. Certificats-cadeaux disponibles: À l'occasion du 120ème anniversaire de naissance du compositeur russe, nous découvrirons les aspects d'une personnalité grandiose, déchirante et sarcastique. Consacré comme le plus grand symphoniste soviétique en Russie comme dans le monde entier, Chostakovitch se démarque par ses trouvailles fortes et originales à travers une production abondante. Que ce soit dans ses concertos, dans sa musique de chambre, dans ses opéras ou dans ses symphonies, il nous démontre tous les aspects de sa science musicale. Par l'écoute de ses œuvres, nous démystifierons à la fois cette figure complexe qui nous semble peu familière, et pourtant si attachante. Certificats-cadeaux disponibles"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
