      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "⭐ Candlelight t'offre des expériences musicales magiques dans de magnifiques lieux éclairés à la bougie. Achète tes billets dès maintenant pour ce concert Candlelight: hommage à Hans Zimmer à Saguenay! Experience the Candlelight : hommage à Hans Zimmer concert in Saguenay at Cathédrale Saint-François-Xavier on Friday, February 5, 2027, at 6:30 PM. Grab your tickets before they're gone!"
      }
    ],
