    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Caracol"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Caracol présente un nouvel album multilingue à saveur tropicale et internationale: SOUND SYSTEM. Sur scène, elle séduit le public avec son savant mélange aux saveurs pop, reggae et globales. Alliant audacieusement rhythmes modernes, instruments organiques, éléments électroniques, percussions, live looping et effets dub, ses mélodies accrocheuses sauront réchauffer les plus frileux! Que ce soit en solo ou en duo avec par son batteur/percussioniste, Caracol effectue adroitement une véritable réalisation musicale (beatmaking) en direct. Le concert, riche en dynamiques, inclut également des moments acoustiques et touchants. À ne pas manquer en 2025 - 2026!"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
