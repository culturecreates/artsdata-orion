      }
    ]
  },
  {
    "@id": "https://voir.lactualite.com/genid/67ccfab457934382",
    "@type": [
      "http://schema.org/TheaterEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-10-20T00:00:00-04:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-01T00:00:00-04:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://voir.lactualite.com/genid/1924b027bd9b8dfd"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.maisontheatre.com/wp-content/uploads/2026/04/1600x900-16-9-15.jpeg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://voir.lactualite.com/evenements/ames-soeurs-c3e039"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://voir.lactualite.com/genid/84bf2869998decd5"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://voir.lactualite.com/artistes/magali-chouinard-999d05#artist"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/792fb5244fb9476a"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/ames-soeurs-c3e039"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "âmes sœurs"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "À mi-chemin entre art visuel et art vivant, âmes sœurs explore le lien d’émerveillement qui existe entre les enfants et la nature. On y suit une enfant sauvage qui multiplie les rencontres avec les créatures qui peuplent l’espace grouillant de vie autour d’un ruisseau. Dans cet écosystème, la végétation, l’eau, le vent, les rochers et les animaux se voient et s’entendent, la trame sonore les accompagnant avec précision lorsqu’ils apparaissent. Ce merveilleux univers onirique est traité en noir et blanc, et les personnages sont évoqués de manière fantastique. On ne distingue que la tête des bêtes qui surgissent, tandis que l’enfant sauvage prend la physionomie d’une toute-petite avec une étonnante tête surdimensionnée. En plus de cette facture visuelle très forte, la poésie du spectacle invite à regarder différemment, à imaginer les secrets cachés sous la surface de la réalité. Ce plongeon au cœur de la nature éveille les cinq sens, comme un appel à explorer, entendre, toucher, sentir, goûter."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
