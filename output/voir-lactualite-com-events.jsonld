    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le samedi 12 décembre 2026 à 10 h, Laval (Laval). 🥖✨Cette année, offrez-vous une expérience unique avant les Fêtes ! 🎄 Venez mettre la main à la pâte…"
      }
    ],
