    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/activites-pour-jeunes-avec-besoins-particuliers-3b5906"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Activités pour jeunes avec besoins particuliers"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Activités de loisirs libres et adaptées pour t'amuser dans la salle Marthe-Lemaire-Duguay de la bibliothèque. Du personnel sera sur place pour t'aider au besoin. Pour qui ? Jeune âgé de 5 ans et plus ayant des besoins particuliers Accompagné d’une personne âgée de 16 ans et plus qui connaît bien l’enfant Activités adaptées Jeux de construction (LEGO, MEGA BLOKS et tuiles magnétiques) Bacs sensoriels Jeux de société Lecture (incluant des livres audio) Bricolage et dessin Coin calme avec outils sensoriels"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
