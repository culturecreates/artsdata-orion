  {
    "@id": "https://voir.lactualite.com/genid/c49261223b0459dd",
    "@type": [
      "http://schema.org/DanceEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-18T19:30:00-05:00"
      }
    ],
