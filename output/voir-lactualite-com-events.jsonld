    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Cathy Gauthier"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Cathy Gauthier s'impose depuis ses débuts comme une figure marquante de l'humour québécois, par son audace et son franc-parler. Originaire de Rouyn-Noranda et diplômée de l'École nationale de l'humour, elle est nommée Révélation de l'année au Festival Juste pour rire en 2003. Forte de quatre one-woman-shows, dont 100% vache folle, Décoiffe, Pas trop catholique et Classique, elle poursuit une carrière riche entre scène, télévision, radio et nouveaux projets. Elle a été récompensée à plusieurs reprises, notamment d'un Olivier de l'auteur de l'année et d'un Félix du spectacle d'humour de l'année."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
