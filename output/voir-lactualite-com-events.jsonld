      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/andrea-lindsay-d-or-et-d-argent-fa61c6"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Andréa Lindsay/D'or et d'argent"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "La dernière décennie d’Andrea Lindsay fut riche en création et performances sur scène. Lancé en 2016, son dernier opus, ENTRE LE JAZZ ET LA JAVA, composé de reprises de classiques du jazz et récipiendaire du Félix Album jazz de l’année, lui a permis de donner plus de 60 représentations. Deux albums de Lindsay /De Larochellière lancés durant la même période, ont permis au couple de donner des dizaines de représentations encore à ce jour. L’auteure-compositrice nous revient maintenant avec un nouvel album D’OR ET D’ARGENT, réalisé par Philippe Breault et premier album de compositions originales depuis 2009 (La belle étoile). Les nouvelles chansons de facture pop éthérée, fidèles à la signature de l’artiste, et qui oscillent entre la nostalgie, le deuil et l’espoir, occuperont le centre du nouveau spectacle qu’Andrea Lindsay offrira à son public, en plus des chansons préférées de son public. Pour l’occasion, Andrea Lindsay sera accompagnée de 3 musiciens, dans une mise en scène de Brigitte St-Aubin."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
