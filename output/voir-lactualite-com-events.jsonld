        "@type": "http://schema.org/Date",
        "@value": "2026-11-10T20:00:00-05:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://voir.lactualite.com/genid/1595a3cdace6cdb5"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://images.squarespace-cdn.com/content/v1/614e015f2f260c49a8dcb4e6/1791570493161-SAT0PKTX3MTZ1QLU3ME2/Visuel-INSTA-CauserieCorpsCombat.png"
