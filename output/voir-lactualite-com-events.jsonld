    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Atelier d'écriture : Écrire le mystère"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "En pleine saison du mystère, laissons notre plume s'aventurer dans la brume. Pas besoin d'y mettre du sang pour garder le lecteur sur le bout de sa chaise. À travers différents exercices, découvre comment : créer une ambiance mystérieuse;créer du suspense;et surtout, avoir du plaisir en écrivant. Durant cet avant-midi, laisse-toi guider par Sandrine, qui t'accompagnera avec bienveillance dans cette exploration de l'écriture sombre à saveur d'Halloween. Le tout dans l'ambiance ensorcelante du Théo Café ! En pleine saison du mystère, laissons notre plume s'aventurer dans la brume. Pas besoin d'y mettre du sang pour garder le lecteur sur le bout de sa chaise. À travers différents exercices, découvre comment : créer une ambiance mystérieuse;créer du suspense;et surtout, avoir du plaisir en écrivant. Durant cet avant-midi, laisse-toi guider par Sandrine, qui t'accompagnera avec bienveillance dans cette exploration de l'écriture sombre à saveur d'Halloween. Le tout dans l'ambiance ensorcelante du Théo Café !"
      }
    ],
