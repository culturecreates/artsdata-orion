      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Balade guidée au coucher du jour avec contes et récits de Jacques Newashish, Mafane et Marien Guillé, inspirés des territoires qu'ils habitent. Environ 1h30 de marche, se terminant autour d'un feu."
      }
