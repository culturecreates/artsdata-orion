    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Atelier pour les 9-12 ans | Flash info jeunesse au journal télévisé"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Découvrez toutes les étapes de la création d’un journal télévisé, de la préparation des sujets à la présentation devant la caméra. En équipe, écrivez un bulletin clair, explorez divers rôles et enregistrez votre propre émission. Une belle plongée dans les coulisses de l’info pour développer votre créativité, votre confiance en vous et vos talents en communication."
      }
    ],
