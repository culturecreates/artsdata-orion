      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://voir.lactualite.com/artistes/cc-duo-1d6773#artist"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/71fa534c6e07d537"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/cc-duo-1c031f"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "CC Duo"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Sous le nom de CC Duo, les guitaristes nommés aux prix JUNO Adam Cicchillitti et Steve Cowan se distinguent par une virtuosité saluée par la critique et une approche innovante de la programmation. Le magazine Classical Guitar les décrit comme des « virtuoses au sommet de leur art ». Ils ont remporté des prix importants au Concours international d’ensemble de la Guitar Foundation of America, obtenant le deuxième prix en 2023 et le troisième prix en 2021. Leur discographie a reçu un accueil élogieux de la part de la critique et de l’industrie. Leur premier album, Focus, consacré à la musique canadienne, a remporté le prix de l’enregistrement classique de l’année aux East Coast Music Awards en 2021 et a été salué par American Record Guide pour ses « interprétations sensibles et maîtrisées ». Leurs albums suivants, Intimate Impressions (2022) et Lyrique (2026), ont tous deux été nommés dans la même catégorie. Leur album collaboratif Re/String, réalisé avec le nonette montréalais collectif9, a reçu deux nominations aux prix JUNO, tandis qu’Amy Brandon y a remporté le prix de la compositrice de l’année pour Cloud Path. «La précision du duo est impressionnante, mais ce qui reste en mémoire, ce sont les scènes aquarellées empreintes de nostalgie qu’évoque leur jeu.» – CBC Music «Avec son phrasé raffiné, sa grande virtuosité et sa superbe qualité sonore, Intimate Impressions est l’un des meilleurs albums de 2021.» – This is Classical Guitar"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
