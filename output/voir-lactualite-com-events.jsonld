    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Antoni Remillard en Rodage"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Antoni Remillard est humoriste, diplômé de l'École nationale de l'humour en 2015. Il présente Antoni Remillard en Rodage au Monument-National, un spectacle dont la présentation indique que les tabous y sont exclus : l'humoriste peut aborder le racisme comme la lumière DEL de son nouvel aspirateur, avant d'atteindre le bout de ses réflexions après de nombreux détours. Les sources le décrivent aussi comme animateur de nombreuses soirées d'humour, juge du Gong Show et invité de plusieurs émissions et séries. Il a participé aux soirées Zéro rodées avec Dave Morgan, où des humoristes testent du matériel en cours d'écriture. Son spectacle solo IMPUISSANT est mentionné comme un spectacle antérieur."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
