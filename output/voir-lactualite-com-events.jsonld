    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/adam-cohen-7a2089"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Adam Cohen"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Everybody Knows est un hommage à Leonard Cohen, créé et mis en scène par Adam Cohen, qui partage la scène avec son propre fils et des invités spéciaux. La production réunit les chansons les plus durables de Leonard Cohen et une sélection soigneusement choisie d'archives photographiques et filmiques rares. Le spectacle fait partie de la première tournée hommage officielle annoncée par la famille de Leonard Cohen, dix ans après sa mort. Il est présenté au Théâtre Saint-Denis."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "en"
      }
