    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 11 mars 2027 à 18 h, à the Montreal (Montréal). Be Like Blippi Tour ! est un spectacle interactif présenté au Théâtre St-Denis, qui met en scène Blippi, personnage destiné aux enfants. Le spectacle incite les jeunes spectateurs à bouger, jouer et explorer, en mêlant jeu, apprentissage et…"
      }
    ],
