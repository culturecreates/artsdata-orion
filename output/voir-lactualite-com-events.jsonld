    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/blippi-533ddc"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Blippi"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Be Like Blippi Tour ! est un spectacle interactif présenté au Théâtre St-Denis, qui met en scène Blippi, personnage destiné aux enfants. Le spectacle incite les jeunes spectateurs à bouger, jouer et explorer, en mêlant jeu, apprentissage et découverte. Il met en vedette des chansons appréciées des fans, dont « The Excavator Song », « Monster Truck », « Dino Dance » et « Curious Like Me », accompagnées de musique et de surprises. Les familles peuvent chanter, rire et danser ensemble. Des artistes de scène ont été sélectionnés pour incarner Blippi et Meekah pendant la tournée. Le spectacle, présenté en anglais, s'adresse aux enfants de 2 à 6 ans et dure 80 minutes, entracte de 20 minutes inclus."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
