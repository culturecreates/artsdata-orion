      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 12 mai 2027 à 20 h, à Lieu à préciser – Gatineau (Gatineau). Arnaud Soly revient sur scène avec Bon jus, son deuxième one-man-show. Le titre peut sembler bizarre, mais selon la présentation du spectacle, il serait trop compliqué à expliquer : l'explication est réservée au public qui viendra le…"
      }
    ],
