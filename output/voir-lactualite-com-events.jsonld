    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Delta Matanie"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Du lundi au dimanche, Delta Matanie vous plonge dans une expérience immersive unique! Suivez les pas d’une jeune fille et de son grand-père dans cette épopée de la Matanie qui vous transportera des glaciers millénaires jusqu’à aujourd’hui. Des premiers peuples aux grands développements modernes, revivez des moments marquants qui ont façonné notre territoire. Une aventure captivante pour toute la famille! Pour plus d’information et les heures de projections: Delta Matanie Retour aux événements"
      }
    ],
