    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/andreanne-a-malette-lp11-116"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Andréanne A. Malette"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "L’autrice-compositrice-interprète Andréanne A. Malette sera en spectacle le samedi 20 mars 2027 à 20 h au Magasin général Le Brun à Maskinongé. Avec ce spectacle inspiré de son album hommage à Françoise Hardy, Andréanne remonte le fil invisible qui relie son histoire à celle de l’icône française. Dans un décor inspiré des années 60, les univers se croisent, les chansons se répondent, et l’artiste se raconte à travers des anecdotes personnelles, tantôt touchantes, souvent rigolotes. Entourée de ses trois fidèles musiciens, elle s’installe dans une douce nostalgie où la musique ravive la mémoire d’une époque pas si lointaine, où l’on prenait le temps de ressentir. Un moment suspendu entre deux ères, où l’interprète nous invite simplement à flotter un instant."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
