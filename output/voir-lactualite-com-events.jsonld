    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 25 octobre 2026 à 10 h 45, à Centre communautaire Champfleury (Laval). Avec Claudia, notre professeure d’art, petits et grands sont invités à laisser libre cours à leur imagination lors de cet atelier parent-enfant! Comme de vrais Frankenstein, vous créerez ensemble des décorations monstrueuses…"
      }
    ],
