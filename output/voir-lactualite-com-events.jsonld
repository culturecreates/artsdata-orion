    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 20 octobre 2026 à 0 h, à Lieu à préciser – Blainville (Blainville). Les ateliers du pays des gnomes favorisent la compréhension du langage et l’expression des premiers mots. Venez découvrir des activités gagnantes pour accompagner votre enfant dans son développement : LIRE, CHANTER, JOUER !"
      }
    ],
