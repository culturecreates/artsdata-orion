    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Ça goûte Noël avec QW4RTZ"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "L’excellent groupe QW4RTZ a osé se lancer dans une tournée du temps des Fêtes pour une première fois cette année, avec un spectacle entremêlant chansons, recettes, humour et anecdotes savoureuses. Ces quatre hommes talentueux unissent leur voix et créent eux-mêmes leurs harmonies vocales et leurs arrangements, pour une soirée unique chaque fois. Ils présenteront leur spectacle le 5 décembre prochain au Centre culturel Desjardins."
      }
    ],
