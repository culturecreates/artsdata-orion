    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Conte d'hiver — Ballet Opéra Pantomime (BOP)"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Quelques jours avant Noël, un Mononcle hirsute et malcommode voit sa tranquillité bousculée par l’arrivée de ses petits cousins, Léo, Raffi et Billie, laissés à eux-mêmes dans le salon. Châteaux forts en coussins, chansons oniriques et somnambules passe-murailles : peu à peu, la magie des Fêtes finit par s’inviter. Une création pour toute la famille de Ballet Opéra Pantomime (BOP), sur un texte de Marianne Dansereau et une musique de Michael Oesterle, dans une mise en scène de Clara Prévost, conçue avec une quarantaine d’élèves de l’école primaire Le Plateau. À La Caserne – scène jeune public, salle Desjardins. De 6 à 12 ans, durée de 45 minutes. 26 $ à la carte, 21,50 $ en abonnement, 22 $ pour les familles nombreuses et les groupes de 5 personnes et plus (taxes et frais inclus)."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
