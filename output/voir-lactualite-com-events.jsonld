    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 18 juin 2027 à 10 h, à Lieu à préciser – Boucherville (Boucherville). La bibliothèque sortira de ses murs pour aller à la rencontre des familles dans les parcs. Des lectures et du bouquinage seront au rendez-vous !"
      }
    ],
