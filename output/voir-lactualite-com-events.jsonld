  {
    "@id": "https://voir.lactualite.com/evenements/champion-8b3511",
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "fr-ca",
        "@value": "VOIR — L’actualité"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Champion — Magog | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 13 novembre 2026 à 20 h, à Vieux Clocher de Magog (Magog). Mario Tessier, humoriste, animateur et entertainer, membre du célèbre duo Les Grandes Gueules, a marqué l'histoire radiophonique avec 20 ans de micro à Énergie 94,3. Il a aussi animé plusieurs galas télévisuels et émissions à succès.…"
      }
