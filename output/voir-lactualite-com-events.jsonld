    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Autour du piano et de l’accordéon, avec Rachel Aucoin et Sabin Jacques"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Laissez-vous transporter par ce duo, partenaires sur scène comme dans la vie depuis plus de 25 ans. Entre musique traditionnelle québécoise et finesse du répertoire classique, leur complicité et leur énergie donnent naissance à un concert chaleureux et entraînant, quelque part entre la soirée de danse et le grand concert classique."
      }
    ],
