    "http://schema.org/performer": [
      {
        "@id": "https://voir.lactualite.com/artistes/antoine-corriveau-trio-1e0042#artist"
      },
      {
        "@id": "https://voir.lactualite.com/artistes/antoine-corriveau-17445b#artist"
