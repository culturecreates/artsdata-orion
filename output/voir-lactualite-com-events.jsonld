    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Amandine et Gédéon La grande surprise"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "La comédie musicale d’Amandine et de Gédéon « La grande surprise! » vous enchantera! Vous retrouverez les chansons adorées tirées de l’album L’étrange Halloween d’Amandine et de Gédéon ainsi que des nouvelles composées spécialement pour le spectacle. De plus, vous entendrez la fameuse chanson Le bouillon des sorcières. Il s’agit d’un nouveau scénario confectionné sur mesure dans une histoire intemporelle qui se joue et s’apprécie toute l’année. Venez chanter avec Amandine, Gédéon, Boo le fantôme et Fiona la sorcière, et embarquez dans leur nouvelle aventure parsemée de… surprises!"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
