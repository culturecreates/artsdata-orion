    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Begotten de E. Elias Merhige — Québec | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 9 octobre 2026 à 0 h, à Cinéma Beaumont (Québec). BEGOTTEN ne possède aucun personnage au sens conventionnel du terme. Trois figures seulement à son générique : Dieu se tuant lui-même, Mère Nature et Fils de la Terre. Le film tout entier se résume à ce que ces noms se font subir les uns aux…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
