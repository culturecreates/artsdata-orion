    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le jeudi 25 février 2027, Centre culturel du Mont-Jacob (Saguenay). À l’âge de deux ans, Stéphanie Morin-Robert doit se faire retirer l’œil gauche; depuis…"
      }
    ],
