    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Alice Bro"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Alice Bro est une autrice-compositrice qui propose un univers solo mêlant folk festif, funk et humour grivois, où la vulgarité de la \"reine des botchs\" côtoie des réflexions existentielles. Son style décalé et flamboyant, prend tout son sens dans l’énergie du spectacle et le partage avec le public. Après un premier EP avec Alice Bro Trio en 2024 et des singles en solo en 2025, elle lance en février 2026 son premier album, 100 filtres, qui affirme pleinement son identité musicale."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
