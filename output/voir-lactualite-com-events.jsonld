      },
      {
        "@id": "https://voir.lactualite.com/artistes/nicolas-basque-ee12fe#artist"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/d6a665ca3c6d3afc"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/bibi-club-158251"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Bibi Club"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Bibi Club est le projet musical d'Adèle Trottier-Rivard, voix et claviers, et de Nicolas Basque, guitares. Iels explorent le spectre sensible entre l’ici et le là-bas, en nous pointant l’amour, la nature et la communauté comme seule réelle finalité. Le duo se révèle aujourd'hui dans l'avant-pop et l’electronic body music avec des éléments de dark wave et néofolk, empruntant simultanément à des sonorités baroques avec clavecins, trompettes et chants rituels à apprendre par coeur. Iels se sont baptisé « Bibi Club » en référence à la discothèque installée dans leur salon, où leurs « bibis » - les personnes qui leur sont chères - viennent danser. 18 ans et plus. Ce spectacle est inclus dans le Club V.I.P. des Pataugeurs - Automne 2026"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
