      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 19 septembre 2027 à 16 h, à chapelle Saint-Bernard (Mont-Tremblant). Now is the time to enjoy the warm, cozy atmosphere of fall in Tremblant. After a hike or a day spent in the village, take a seat on the patio of one of the restaurants on Place Saint-Bernard and let the music sweep you away.…"
      }
    ],
