    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 17 octobre 2026 à 20 h, à Les diffusions Pointe-Valaine (Otterburn Park). Spectacle présenté en formule debout. Blood Brothers and the Beast est un spectacle hommage entièrement dédié à l’univers d’Iron Maiden, couvrant l’ensemble de la carrière du groupe, des premiers albums jusqu’aux plus…"
      }
    ],
