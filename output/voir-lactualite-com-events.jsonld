    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le jeudi 26 novembre 2026 à 20 h, L'Olympia (Montréal). Le groupe canadien Barenaked Ladies, composé de quatre membres, compte une carrière de 38 ans et plus…"
      }
    ],
