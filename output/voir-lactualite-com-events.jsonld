    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/de-toutes-les-facons-83c275"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "De toutes les façons"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "De toutes les façons est un projet d’ateliers de création artistique destiné à tout public avec une ouverture particulière aux personnes dans une situation économique précaire. Il propose des espaces de création accessibles et sécuritaires, où les arts visuels deviennent des moyens d’expression, de rencontre et de reprise de pouvoir sur son quotidien. Le projet est principalement déployé dans le secteur de la Basse-Ville de Québec, ainsi que ponctuellement dans les régions de Portneuf et de Charlevoix afin de rejoindre des personnes éloignées des ressources culturelles. Pour cette première année, le projet est également en phase d’exploration : des ateliers sont offerts dans différents milieux (ressources communautaires et espace public) afin de mieux comprendre les contextes les plus pertinents pour rejoindre les participant.e.s. Les ateliers sont animés par des artistes professionnel.le.s en collaboration avec des intervenant.e.s. Chaque rencontre devient un moment de création, d’expérimentation et de lien. Le projet De toutes les façons est réalisé en collaboration avec les organismes Équinoxe Côte-de-Beaupré, L’Éveil Charlevoisien, Mères et Monde, L’Arc-en-Ciel (organisme communautaire en santé mentale de Portneuf) et par les Alliances pour la solidarité, en collaboration avec le ministère de l’Emploi et de la Solidarité sociale."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
