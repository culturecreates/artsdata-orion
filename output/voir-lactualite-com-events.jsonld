    ],
    "http://schema.org/url": [
      {
        "@id": "https://voir.lactualite.com/evenements/atelier-de-peinture-sur-sac-ou-gobelet-automne-2026-c171e7"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://voir.lactualite.com/genid/c9f7571141d03655"
      }
    ],
    "http://schema.org/organizer": [
