      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 13 novembre 2026 à 0 h, à Salle Kingsey (Kingsey Falls). Bruno Pelletier, l’un des chanteurs les plus appréciés de la francophonie, revient sur scène avec une nouvelle tournée intitulée « Trois et moi ». Ce spectacle, conçu comme un moment de partage privilégié, plonge le public dans un univers…"
      }
    ],
