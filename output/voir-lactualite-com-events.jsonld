    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Beethoven et Schubert : confidences"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Beethoven : l'idole du jeune Schubert. Thomas Dolié et Olivier Godin nous proposent un programme qui met en lumière les thèmes et les textes communs qu'ont employés les deux compositeurs dans leur production vocale : le mythe de Faust, la solitude, l'amour lointain. Une conférence de Jean Portugais, intitulée « Schubert et Beethoven», sera présentée le même jour à 17 h, en lien avec le concert. Pour plus de détails, cliquez ici. Ce concert est présenté avec le soutien de la succession de Marie-Paule Laurans."
      }
    ],
