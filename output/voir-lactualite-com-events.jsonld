      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://voir.lactualite.com/artistes/ghassan-yammine-89d896#artist"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/71fa534c6e07d537"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/aznavour-et-les-legendes-a62b62"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Aznavour et les Légendes - Ghassan Yammine"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Un concert à couper le souffle rendant hommage à l’extraordinaire héritage musical de Charles Aznavour et aux chefs-d’œuvre intemporels de la chanson française. Vivez une soirée inoubliable au rythme des chansons immortelles de Charles Aznavour, ainsi que des grands classiques d’Édith Piaf, de Jacques Brel, d’Yves Montand et d’autres artistes légendaires dont la musique a marqué des générations à travers le monde. Après sa tournée canadienne de 2024, le chanteur et pianiste de renommée internationale Ghassan Yammine revient en Amérique du Nord charmer le public avec sa présence scénique puissante, sa musicalité exceptionnelle et ses interprétations profondément émouvantes des grands classiques français. Accompagné d’une formation de musiciens exceptionnels, Ghassan Yammine donne vie à des chansons emblématiques telles que La Bohème, Hier Encore, Emmenez-moi, La Vie en rose, Ne me quitte pas et bien d’autres encore. Plus qu’un simple concert, Aznavour et les Légendes est un voyage vers l’âge d’or de la musique française : une soirée pleine d’élégance, de romantisme, de nostalgie et de performances inoubliables."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
