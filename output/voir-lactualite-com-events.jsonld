    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Certaines collisions sont silencieuses"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "L'exposition Certaines collisions sont silencieuses de Jeffrey Poirier est un nouvelle proposition architecturale et in situ qui se déploie dans les deux salles de l'Espace Séquence. Cette installation rassemble différents éléments phares du langage visuel de l'artiste, notamment un volume sculptural monumental ainsi que la présence d’une trame bricolée de carton recyclé et de ruban adhésif coloré."
      }
    ],
