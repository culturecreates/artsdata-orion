    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "3 & MOI"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "À l’occasion de 3 & Moi, Bruno Pelletier s’entoure de trois musiciens talentueux : deux amis de longue date, Martin Bachand (guitare) et Claude Pineault (guitare, piano et basse), et son amoureuse, la chanteuse Brigitte Marchand (voix). Ensemble, ils misent sur la force des harmonies vocales et des arrangements recherchés pour revisiter les titres qui ont marqué les 40 années de carrière de Bruno Pelletier."
      }
    ],
    "http://schema.org/inLanguage": [
