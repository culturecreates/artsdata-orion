    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Arnaud Soly - Bon jus"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Arnaud Soly revient sur scène avec son deuxième one-man-show : BON JUS. Il s’agit de son meilleur à ce jour (selon lui!) Pourquoi ça s’appelle BON JUS? C’est bizarre, hein? Ça serait trop compliqué à expliquer. Venez le découvrir en salle. On va rigoler, c’est promis."
      }
    ],
