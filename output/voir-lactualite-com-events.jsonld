    ],
    "http://schema.org/performer": [
      {
        "@id": "https://voir.lactualite.com/artistes/la-famille-leblanc-2b36f3#artist"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/9c751e62cbf948cd"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/amourette-lp1-139"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Amourette"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Originaire du Nouveau-Brunswick, au cœur de l’Acadie, La famille LeBlanc est un groupe familial qui porte avec sensibilité et authenticité l’héritage musical acadien. Composé des parents et de leurs trois filles, l’ensemble revisite des airs du 19e siècle, enracinés dans les traditions acadiennes et celtiques, tout en y insufflant une approche actuelle. Les filles interprètent et composent à partir de ces répertoires, jouant du concertina, du whistle et du violon, tandis que la mère prête sa voix aux ballades anciennes dans des harmonies riches et touchantes. Le père, multi-instrumentiste, accompagne au piano et au violon avec des arrangements qui marient tradition, jazz et influences baroques. Héritée sur plusieurs générations, cette musique devient un espace vivant de transmission, transformant la mémoire en création. La famille LeBlanc offre ainsi une expérience musicale à la fois enracinée, lumineuse et profondément rassembleuse."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
