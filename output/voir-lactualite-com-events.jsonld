    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Boogát"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Boogát est l'une des valeurs sûres de la scène musicale mondiale canadienne, avec une proposition innovante qui déclenche toujours une fête. Que ce soit en espagnol, en français ou en anglais, il rappe et chante l'universalité des minorités culturelles en explorant des thèmes liés à l'identité, à la migration, à l'appartenance et à l'amour à travers des textes qui font réfléchir et qui oscillent entre le sérieux et l'humour."
      }
    ],
