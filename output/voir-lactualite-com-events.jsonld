    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 24 octobre 2026 à 20 h, à Pôle culturel de Chambly (Chambly). Fort de son immense succès avec plus de 50 000 billets vendus et près de 200 représentations, Billy Tellier revient avec son 3e one-man-show Kicker la ruche. Fidèle à son style percutant, il aborde des sujets universels avec humour…"
      }
    ],
