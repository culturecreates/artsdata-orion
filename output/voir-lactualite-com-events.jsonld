    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Carrie Allison : askōhtēskanohwē"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "L'exposition Carrie Allison : askōhtēskanohwē réunit quatre nouvelles œuvres de broderie perlée, huit biens culturels issus de la collection Cultures autochtones du Musée, une installation interactive et une projection. Inspirées des traditions de broderie perlée florale liées aux territoires maternels nêhiyaw et métis de l'artiste, les œuvres explorent les liens entre territoire, mémoire et culture matérielle. Conjuguant archives coloniales et pratiques artisanales ancestrales, Carrie Allison fait dialoguer le passé et le présent. Artiste visuelle multidisciplinaire d'origine nêhiyaw et métisse, établie à Halifax, elle a conçu l'exposition dans le cadre du programme Artiste en résidence du Musée."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
