    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "AV Guadeloupe avec Gino"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "En quête de liberté après des années de matinales, Gino Chouinard vous invite à découvrir l’archipel des Îles de Guadeloupe, où nature luxuriante, culture créole et chaleur humaine se rencontrent. Marchés, chutes, mer et rencontres rythment ce voyage authentique. Une destination idéale pour les voyageurs québécois en quête de soleil et de dépaysement accessible. Un film animé par Gino Chouinard et réalisé par Yannick Gervais Présenté par Les Aventuriers Voyageurs"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
