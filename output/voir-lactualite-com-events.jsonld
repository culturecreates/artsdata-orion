    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/acharne-0a6c5d"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Acharné"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Mike Beaudoin présente Acharné, son deuxième one-man show. L'humoriste de stand-up continue de puiser dans sa vie pour se livrer sans compromis, avec des détails croustillants et hilarants. Après le succès de sa première tournée VRAI, il est suivi par des dizaines de milliers d'abonnés sur les réseaux sociaux et a fait des passages remarqués à la radio commerciale. Le spectacle mélange humour et vérité, tout en gardant son mordant et son franc parlé. On y retrouve notamment des péripéties liées à la vie avec son ado, sa peur des psys et son impatience."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
    "http://schema.org/eventStatus": [
