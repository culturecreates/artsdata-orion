    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Samedis du mois – Création de bijoux —… | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 14 novembre 2026 à 10 h 30, à Centre Harpell (Sainte-Anne-de-Bellevue). À l’approche de Noël, venez créer des bijoux uniques et faits à la main avec l’artiste Dominique Boucher ! Dans une ambiance chaleureuse et créative, laissez libre cours à votre imagination pour concevoir des pièces…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
