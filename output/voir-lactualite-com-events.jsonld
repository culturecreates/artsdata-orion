      {
        "@id": "https://voir.lactualite.com/genid/7f75127942b3498d"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/canadian-chinese-new-year-gala-a172e8"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Canadian Chinese New Year Gala"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le Canadian Chinese New Year Gala est présenté par la Troupe artistique Phoenix de Montréal. Sous le thème Into the Painting, le spectacle propose un parcours à travers plusieurs millénaires de civilisation chinoise, où l'histoire et l'art se rejoignent, sur fond de musique et de jeux de lumière. Le programme réunit la danse classique chinoise, les danses traditionnelles et folkloriques, l'opéra de Pékin, les arts martiaux chinois, la musique instrumentale traditionnelle et des chansons chinoises. Il comprend aussi la production dansée originale Chinatown – The Sequel, qui évoque le parcours historique de Sun Yat-sen et la contribution des communautés chinoises établies à l'étranger. Les chorégraphies sont signées Cynthia Deng, Hislat Kahriman, Julio Hong et Angelo P.C Chen."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
