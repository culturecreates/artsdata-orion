      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Benny Jones — Gatineau | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 1er décembre 2026 à 20 h, à Salle Odyssée (Gatineau). «J'ai grandi avec le bois dans le dos, la mer dans la face... Mais surtout, j'ai eu la chance de grandir entouré de monde... du vrai monde! Du monde qui m'ont raconté leurs histoires. Beau temps, mauvais temps... Et toutes ces histoires-là…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://voir.lactualite.com/evenements/benny-jones-51961d"
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
        "@value": "fr_CA"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://www.maisondelaculture.ca/Salle-Odyssee/images/spectacles/soirees-cabaret/benny-jones.jpg"
      }
    ]
  },
  {
    "@id": "https://voir.lactualite.com/genid/e62d019a225e1021",
    "@type": [
      "http://schema.org/MusicEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-12-01T20:00:00-05:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-12-01T23:00:00-05:00"
      }
    ],
    "http://schema.org/location": [
