  {
    "@id": "https://voir.lactualite.com/genid/db88414f63ab8513",
    "@type": [
      "http://schema.org/MusicEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-04-23T20:00:00-04:00"
      }
    ],
