        "@id": "https://voir.lactualite.com/genid/059f024b2497b9bc"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/causerie-le-corps-au-combat-07aa64"
