    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Arrivée du Train des Fêtes"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le Rendez-vous des Fêtes lance la saison des Fêtes au centre-ville de Trois-Rivières ! Pendant deux jours, le parc portuaire se transforme en un lieu festif où petits et grands pourront profiter d’une foule d’activités gratuites, de spectacles et d’animations. Les incontournables Arrivée du Train des Fêtes : samedi 28 novembre à 16 h 30, avec le père Noël et la mère Noël à bord. Le train restera sur place jusqu’à 21 h le samedi et sera également accessible le dimanche de 11 h à 17 h."
      }
