    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Bellini – Norma — SAVM"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Il ventait sur la scène du Théâtre d’Orange en ce soir du 20 juillet 1974 et n’eut été de la conviction et des capacités vocales des interprètes, Montserrat Caballé et Jon Vickers, cette représentation n’aurait jamais eu lieu. Les forces de la musique ont eu raison du mistral et le résultat demeure légendaire. Le Café d’art vocal ouvre ses portes une heure avant l’événement et vous accueille avec son menu bistro, bière et vins."
      }
    ],
