        "@id": "https://voir.lactualite.com/genid/34a4d2315b0b206b"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.maisondelaculture.ca/Salle-Odyssee/images/spectacles/chanson/classe-moyenne-2026.jpg"
      }
    ],
    "http://schema.org/url": [
