        "@language": "fr-ca",
        "@value": "VOIR — L’actualité"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Chorale : Harmonies créatives — Gatineau | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 3 novembre 2026 à 17 h 30, à Salle Jean-Despréz (Gatineau). En collaboration avec Espace Transition et Maison Réalité, cette chorale propose une expérience artistique collective ouverte à tous. Dans un esprit inclusif et bienveillant, les participants sont invités à prendre part à une création…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://voir.lactualite.com/evenements/chorale-harmonies-creatives-f2f2ca"
      }
    ],
