      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 30 octobre 2026 à 18 h 30, à Église Notre-Dame-des-Sept-Douleurs (Montréal). Un peu romantique, un peu effrayant mais avec beaucoup d’ambiance. Pour les grands classiques de la musique d’Halloween, on va voir un des deux concerts Candlelight à la bougie de la saison dédiés à la fête des esprits…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
