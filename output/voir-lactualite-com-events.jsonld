    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Charles Richard-Hamelin — Une soirée complètement piano!"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Lauréat du Concours international Frédéric-Chopin 2015, le pianiste québécois Charles Richard-Hamelin se démarque aujourd’hui comme l’un des plus importants de sa génération. Récompensé par six Félix, un JUNO et le prix Denise-Pelletier, il enchante les scènes d’ici et d’ailleurs avec son jeu à la fois virtuose et sensible. Invité des plus grands festivals en Europe, au Canada, aux États-Unis et en Asie, il a toujours autant de plaisir à retrouver son public d’ici qui l’apprécie tout particulièrement pour sa générosité et son approche personnelle. De passage à Drummondville, Charles nous offre une soirée autour Schubert, Schumann et Chopin, son compositeur de prédilection. Un moment à savourer pleinement en toute intimité! Durée approximative: 80 minutes plus entracte L’OSD et la Maison des arts s’unissent pour rassembler les publics autour de cette offre cultuelle vibrante."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
