    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Atelier de création en duo (parents/enfants) | Peinture sur sac réutilisable"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Cet atelier propose à un parent et un enfant de peindre ensemble un sac réutilisable. Animé par Amélie Marcotte, le rendez-vous se présente comme un moment de créativité partagé, marqué par le fou rire et l'engouement. Les ateliers se déroulent en dyades adulte-enfant, où tout devient possible lorsqu'on crée à quatre mains dans le plaisir. L'activité s'adresse aux enfants de 3 ans et plus."
      }
    ],
