    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/bori-30-ans-ca-suffit-lp1-395"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Bori 30 ans - ça suffit!"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Annoncé comme son dernier tour de chant en carrière, Bori 30 ans - ça suffit! sera l’ultime chance d’entendre et de voir Edgar Bori sur scène comme chanteur. Il y reprendra ses titres les plus connus, accompagné de Jean-François Groulx et de 5 musiciens de la Fanfare Pourpour. La première de ce concert sera donnée dans le cadre de Coup de cœur francophone à l’automne 2026 et marquera le début d’une aventure qui se terminera à la fin de la saison 2028. Certains titres du répertoire sont déjà connus : Les choses, L’étoile du Nord, Cyrano, Y frais, C’est fête au cimetière, Mon frère, On repart, pour ne dévoiler que ceux-là."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
    "http://schema.org/eventStatus": [
      {
