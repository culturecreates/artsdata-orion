    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Après Ski Party"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "This Saturday, November 22, from 5 p.m. to 11 p.m., Sommet Saint-Sauveur kicks off the winter season with the APRÈS SKI PARTY presented by Coors Light! Starting at 5 p.m., enjoy a festive happy hour at the foot of the slopes, with entertainment and a lively atmosphere. Then, starting at 7 p.m., the party moves to the half-pipe with the band Sugar Cake and MC Mario on the turntables. Food trucks, outdoor bars, and winter décor, all free of charge! Bring your family or friends."
      }
    ],
    "http://schema.org/eventStatus": [
