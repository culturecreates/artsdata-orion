    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 22 octobre 2026 à 20 h, à Upstairs (Montréal). Andy Rubal est un pianiste et chanteur cubain qui a fait ses premiers pas dans la musique dès son plus jeune âge au sein de la formation Baby Salsa, alors qu’il n’avait que 6 ans. Musiciens Andy Ruba"
      }
