    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Ateliers de tricot libre | Les tricots d'Adèle"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Apportez votre laine, vos aiguilles ou votre crochet, et installez-vous pour échanger et créer en bonne compagnie. Une occasion parfaite de partager vos projets, découvrir de nouvelles techniques ou simplement jaser autour d’un bon café, d’un thé ou d’une tisane (offerts sur place). Que l’on soit débutant ou tricoteur confirmé, chacun y trouve sa place. Places limitées | Premiers arrivés, premiers à tricoter!"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
