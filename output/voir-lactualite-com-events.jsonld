    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Alexandre présente Bisaillon"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Alexandre Bisaillon est un humoriste, acteur et auteur franco-ontarien. Il s'est fait connaître dans plusieurs projets, dont les Galas Juste pour rire, les Galas ComediHa!, la série Top Dogs, à titre de chroniqueur à Sucré Salé, et comme gagnant du Prochain Stand-up (saison 2). Son humour, teinté d'autodérision, se présente comme un univers où rire et réflexion se côtoient. Un précédent spectacle en rodage a notamment été présenté au Saint-Jean Comédie Club."
      }
    ],
