        "@value": "fr_CA"
      }
    ]
  },
  {
    "@id": "https://voir.lactualite.com/genid/404c0160ba3fe4d6",
    "@type": [
      "http://schema.org/TheaterEvent"
    ],
    "http://schema.org/startDate": [
