  {
    "@id": "https://voir.lactualite.com/evenements/comite-organisateur-secondaire-en-spectacle-cfb729",
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "fr-ca",
        "@value": "VOIR — L’actualité"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Comité organisateur - Secondaire en spectacle à Laval | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Jusqu’au 5 juin 2027, Collège Laval (Laval). Tu aimes la musique, la danse, le théâtre, l’humour ou tout ce qui se passe derrière la scène? Joins-toi au comité…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://voir.lactualite.com/evenements/comite-organisateur-secondaire-en-spectacle-cfb729"
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
        "@value": "fr_CA"
      }
    ]
  },
  {
    "@id": "https://voir.lactualite.com/genid/a57fe9aabfbd848d",
    "@type": [
      "http://schema.org/TheaterEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
