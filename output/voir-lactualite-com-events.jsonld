    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Annie Blanchard et Maxime Landry Noël dans nos vieilles maisons"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Annie Blanchard et Maxime Landry ont déjà présenté un spectacle intitulé Noël dans nos vieilles maisons, accompagnés de six musiciens, mêlant chansons de Noël, traditions québécoises et acadiennes, humour et émotion. Maxime Landry a également proposé Le Party Beauceron, un spectacle country entouré de cinq musiciens, puisant dans les chansons marquantes de son enfance et les classiques du genre, ancrés dans sa Beauce natale."
      }
    ],
