    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "BEYRIES\nBEYRIES"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Beyries est une auteure-compositrice-interprète montréalaise. Elle a lancé son premier album, Landing, en 2017, suivi d'Encounter en 2020, puis de Du feu dans les lilas en 2024, son premier album entièrement en français, salué et récompensé d'un Félix au Gala de l'ADISQ 2024. En 2025, elle a dévoilé Reprises, un album où elle revisite des chansons marquantes à sa manière. Elle prépare actuellement son quatrième album original."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
