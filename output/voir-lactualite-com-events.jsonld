    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Bon jus"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Arnaud Soly revient sur scène avec Bon jus, son deuxième one-man-show. Le titre peut sembler bizarre, mais selon la présentation du spectacle, il serait trop compliqué à expliquer : l'explication est réservée au public qui viendra le découvrir en salle. Selon l'artiste lui-même, il s'agit de son meilleur spectacle à ce jour. La présentation promet des rires."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
