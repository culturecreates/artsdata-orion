    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Contes de boulangerie"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Jacques Falquet vous entraîne dans l’univers merveilleux de la boulangerie, où le don et la solidarité se confrontent à l’individualisme. Des histoires savoureuses qui abordent la justice, la responsabilité envers les autres et le vivre-ensemble."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
