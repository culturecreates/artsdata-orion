      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 14 novembre 2026 à 20 h, à Scène Desjardins d'Argenteuil (Lachute). Le Boogie Wonder Band, célèbre pour son énergie contagieuse et ses grooves irrésistibles, présente un tout nouveau spectacle électrisant «Disco Honey»! Plongez dans un tourbillon de paillettes et de boules miroirs, où les…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
