    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 8 novembre 2026 à 13 h, à Pôle culturel de Chambly (Chambly). Les personnes participantes seront amenées, dans cette série d’ateliers, à développer leur talent et leur vocabulaire sous les bons conseils d’une animatrice. Les ateliers sont animés par Véronique Millet."
      }
    ],
    "http://ogp.me/ns#url": [
