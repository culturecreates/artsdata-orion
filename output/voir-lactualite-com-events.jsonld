    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Concert Zelda: Légendes d'Hyrule"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Présenté par l'Orchestre de Jeux Vidéo, le concert Zelda : Légendes d'Hyrule plonge dans l'univers de The Legend of Zelda. À travers une sélection d'œuvres marquantes de la série, l'orchestre propose un voyage musical au cœur d'Hyrule, entre aventure, mystère et souvenirs. Le programme invite à redécouvrir ces musiques emblématiques en version orchestrale."
      }
    ],
