    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le Comité Arts et Culture Jacques-Cartier est mandaté par le Service de développement économique de la Ville de Sherbrooke pour animer le centre-ville durant la saison estivale. Des visites guidées, des ateliers créatifs et quatre journées thématiques sont offertes gratuitement entre le 28 juin et le 23 août."
      }
    ],
