    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/81f8761f1899beb2"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/bruno-delorme-lp5-333"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Bruno Delorme"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Depuis sa toute première prestation officielle, alors qu’il n’avait que 16 ans, Bruno Delorme a tout de suite su que la musique et la scène l’accompagneraient tout au long de sa vie. Aujourd’hui, quelques décennies plus tard, cet amour pour la musique et le feu sacré de la scène sont toujours présents et bien ancrés au fond de son âme. Son très large répertoire, qui passe du folk américain à la musique québécoise, du country américain au rock, du crooner à la chanson française, combiné à sa grande aisance sur scène et à sa proximité avec le public, vous fera passer une belle soirée remplie d’émotions de toutes sortes. Plaisir assuré !"
      }
    ],
    "http://schema.org/eventStatus": [
