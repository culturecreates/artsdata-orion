    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Classe de maître en violon avec Olivier Demers"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Cette classe de maître en violon traditionnel québécois est animée par Olivier Demers. L'atelier aborde certaines techniques d'archet et d'articulation de la main gauche, la stylistique et le répertoire québécois, ainsi que les bases de la podorythmie. Il s'adresse aux personnes qui connaissent déjà le violon ou leur instrument et souhaitent apprendre à l'oreille. Un jam de musique ouvert à tous suit la classe."
      }
    ],
    "http://schema.org/inLanguage": [
