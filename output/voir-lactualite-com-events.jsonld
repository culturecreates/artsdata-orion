      {
        "@id": "https://voir.lactualite.com/evenements/au-rythme-de-nos-souvenirs-7bb0a8"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Au rythme de nos souvenirs"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "avec Normand Verret et ses musiciens Pour son 10e anniversaire, la Fondation Pauline-Grenier lance une campagne de financement afin de soutenir et bonifier les activités musicales à la Maison Myosotis. La population est invitée à faire un don ou à assister au spectacle « Au rythme de nos souvenirs », avec Normand Verret, le 18 octobre 2026 à l’espace culturel Le Vitrail. Les fonds recueillis serviront à offrir aux résidents des moments de bien-être, de stimulation et de connexion, la musique étant reconnue pour ses effets positifs auprès des personnes vivant avec des troubles neurocognitifs. L’objectif est d’amasser 10 000 $, entièrement dédiés au mieux-être des résidents et de leurs proches."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
