      }
    ]
  },
  {
    "@id": "https://voir.lactualite.com/genid/a6980d604be18801",
    "@type": [
      "http://schema.org/MusicEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-10-30T20:00:00-04:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-10-30T23:00:00-04:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://voir.lactualite.com/genid/7d15414a1063e3f5"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://tpos.s3.amazonaws.com/events/PAF/26/10/30/001/paf261030001-1152x648-fr-6a75f807.png"
      }
    ],
    "http://schema.org/url": [
      {
