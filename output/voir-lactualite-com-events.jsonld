      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/35-ans-et-je-cherche-encore-b52d35"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Laurence Jalbert – 35 ans… Et je cherche encore"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "35 ans… Et je cherche encore célèbre l’album qui, en 1990, a révélé Laurence Jalbert et imposé sa voix parmi les plus marquantes de la chanson québécoise. Porté par des chansons devenues emblématiques, dont Tomber, Rage, Les yeux noirs, À toi, En courant et Au nom de la raison, ce premier opus a connu un succès retentissant avec 180 000 albums vendus, une tournée de 150 représentations et deux Félix au Gala de l’ADISQ. Aujourd’hui, entourée de ses musiciens, Laurence Jalbert revisite ce répertoire fondateur avec la profondeur, l’intensité et la maîtrise d’une grande interprète. Plus qu’un retour sur un album phare, 35 ans… Et je cherche encore est un rendez-vous vibrant avec une artiste entière, une voix habitée et des chansons qui continuent de traverser le temps."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
