    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Carnet créatif"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dans cet atelier, tu pourras laisser aller ton imagination en explorant différentes techniques comme le collage, l'aquarelle et l'écriture libre. Tu apprendras à personnaliser ton carnet créatif à ton image, sans règles ni pression, juste pour le plaisir de créer et de t'exprimer autrement. Avec Geneviève Turcotte. Les jeudis 5 novembre au 26 novembre, 18 h 30 à 20 h Bibliothèque Raymond-Lévesque Enfant et adolescent, 10 à 14 ans Gratuit Les participants doivent avoir en leur possession un carnet à dessin personnel (feuilles blanches). Le matériel artistique sera fourni sur place. Inscription requise Information : [email] ou [phone] Suivez-nous sur Facebook !"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
