    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 27 janvier 2027 à 0 h, à La Chapelle (Montréal). Akuteu est un spectacle de théâtre de Soleil Launière d'une durée de 1 h 15. Il propose un voyage intime à travers des fragments d'un récit personnel : une jeune femme innue y partage sa perspective sur son intégration dans une société à…"
      }
    ],
