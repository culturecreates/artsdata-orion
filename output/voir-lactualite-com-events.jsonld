      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://voir.lactualite.com/genid/5fc469304194dc50"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.culture3r.com/app/uploads/2026/08/18practices_AndrewTurner_Visuel_Siteweb_TD.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://voir.lactualite.com/evenements/18-p-r-a-c-t-i-c-e-s-lp11-10"
      }
    ],
    "http://schema.org/offers": [
