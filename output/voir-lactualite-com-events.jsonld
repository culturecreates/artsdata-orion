      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 26 août 2027 à 0 h, à Lieu à préciser – Cowansville (Cowansville). Jusqu’au 26 août, participez à notre activité-concours qui célèbre la lecture en tandem entre un jeune et un adulte de son entourage! Comment participer? Procurez-vous le carnet La paire fait l’affaire à votre bibliothèque…"
      }
    ],
    "http://ogp.me/ns#url": [
