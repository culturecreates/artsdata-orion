    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "À la messe de minuit"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "La nuit de Noël s'illumine sous les voûtes de Marc-Antoine Charpentier et de Michel Corrette. Bernard Labadie dirige Les Violons du Roy et La Chapelle de Québec dans une messe de minuit d'une grande beauté, où les noëls français tissent leur magie ancestrale. Un concert des fêtes qui réchauffe les cœurs et célèbre la richesse du répertoire sacré français. M.-A. CHARPENTIER, In nativitatem Domini canticum, H. 416 Messe de minuit pour Noël, H. 9 M. CORRETTE, Sinfonia III sur des noëls François et Etrangers"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
