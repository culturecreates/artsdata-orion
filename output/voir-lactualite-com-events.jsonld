      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 23 avril 2027 à 0 h, à Salle Odyssée (Gatineau). Un spectacle festif, vivant et plein de surprises! Dans ce nouveau rendez-vous musical, Bruno Pelletier revisite avec authenticité et générosité les grandes chansons qui ont marqué sa carrière — Coriace, Ailleurs c’est comme ici, Le temps des…"
      }
    ],
