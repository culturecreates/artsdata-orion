    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "This two-act ballet based on Hoffmann’s classic tale is set to the music of Tchaikovsky and brings together more than 60 dancers and 100 extras, plus Les Grands Ballets Orchestra under the direction of conductor Jean-Claude Picard. If you have never seen it, this famed production is a must."
      }
