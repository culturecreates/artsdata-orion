      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Danemark et les Îles Féroé"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le cinéaste primé Tommy Ferlatte et sa complice Janie Lapointe signent une nouvelle odyssée nordique en Scandinavie, du Danemark aux Îles Féroé. De Copenhague à Aarhus, ils explorent des villes où nature, design et qualité de vie s’harmonisent. Cap ensuite sur les Îles Féroé, un archipel mythique sauvage où les falaises vertigineuses et la nature brute dictent le rythme de la vie. Entre paysages spectaculaires et rencontres humaines, mêlant humour et émotion, ce film explore une question universelle : qu’est-ce qui nous rend vraiment heureux ?"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
