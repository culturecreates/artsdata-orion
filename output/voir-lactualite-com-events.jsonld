    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Dumas"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "PIANO VOIX DIAPOS c’est Dumas sans guitare, accompagné d’un pianiste et de diapositives. Dans une mise en scène minimaliste, il se raconte en chansons, revisitant 25 ans de répertoire, avec sensibilité et toujours cette volonté d’offrir une expérience inoubliable et lumineuse au public. Prix étudiant: limite de 25 billets 1$ par billet vendu sera remis à la Fondation Cowboys Fringants. Spectacle présenté sans entracte"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
