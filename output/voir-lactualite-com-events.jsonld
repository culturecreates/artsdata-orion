    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Angelique Francis — Sainte-Marie | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 13 novembre 2026 à 20 h, à Lieu à préciser – Sainte-Marie (Sainte-Marie). Angelique Francis est une auteure-compositrice-interprète et multi-instrumentaliste originaire d'Ottawa. Son groupe a notamment reçu un prix JUNO dans la catégorie Blues Album of the Year pour l'album « Long River »…"
      }
    ],
