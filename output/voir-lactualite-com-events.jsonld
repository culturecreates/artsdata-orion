      {
        "@language": "fr-ca",
        "@value": "Causerie avec Anthony Roth Costanzo à Montréal — 25 janv. 2027 | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le lundi 25 janvier 2027 à 19 h, Salle Bourgie (Montréal). Il est rare de mener de front une carrière d'artiste et de haute direction d'une organisation…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
