    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Concours – Bingo littéraire"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Envie d’élargir vos horizons littéraires de façon ludique? Relevez des défis de lecture en remplissant une carte de bingo à l’aide des défis proposés dans chaque case. Pour chaque ligne complétée, obtenez un coupon de participation et courez la chance de gagner un des nombreux certificats-cadeaux d’entreprises locales. 18 ans et plus | Pour les abonnés de la bibliothèque seulement."
      }
    ],
