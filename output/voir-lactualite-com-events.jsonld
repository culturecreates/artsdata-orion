    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Du 30 juin au 21 août 2027, Bibliotheque Alice-Quintal (Rawdon). Le défi Tous champions de lecture se transforme en un véritable club de lecture estival!…"
      }
    ],
