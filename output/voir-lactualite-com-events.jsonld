      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://voir.lactualite.com/genid/3367349366626325"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://funnation.ca/wp-content/uploads/2025/09/MTES_Champ_1080x1080-texte.jpg"
      }
    ],
    "http://schema.org/url": [
