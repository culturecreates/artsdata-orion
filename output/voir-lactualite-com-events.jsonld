    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/clement-jacques-a1e11d"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Clément Jacques"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Clément Jacques est un auteur-compositeur-interprète évoluant dans un registre folk pop rock. Son spectacle précédent, Iris, faisait suite à la sortie de son cinquième album et proposait un regard sensible sur les relations humaines, porté par des textes réfléchis. Accompagné d'un univers scénique signé Daniel Fortin, il y livrait ses chansons les plus récentes entrecoupées de titres marquants de son parcours, dans un style oscillant entre pop, folk et parfois rock."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
