      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 25 juin 2027 à 0 h, à Bibliothèque Jean-Charles-Des Roches (Prévost). Dès le 25 juin, le Biblio Club débutera sous le thème \"Mystères et enquêtes\". Il y aura des activités, des concours, des tirages ainsi qu'une sélection de livres en lien avec le thème de l'été. Les 100 premières personnes…"
      }
    ],
