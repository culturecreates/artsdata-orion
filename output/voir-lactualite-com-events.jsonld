    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le mardi 2 mars 2027 à 18 h 30, Maison Hamilton (Rosemère). Processus artistique acrylique J’aime que ce ne soit pas trop moi qui informe mais plutôt les gens…"
      }
    ],
