    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Beatle Nation - Hommage aux Beatles"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Plongez dans la magie des Beatles avec Beatle Nation, un groupe hommage reconnu pour ses harmonies impeccables, ses costumes fidèles aux différentes époques et ses performances professionnelles qui capturent l’esprit des Fab Four. De leurs débuts au Cavern Club de Liverpool au concert mythique du Shea Stadium à New York, en passant par les années Apple Records et leur dernier concert sur le toit à Londres, Beatle Nation offre un spectacle énergique et parfaitement maîtrisé, idéal pour une soirée inoubliable!"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "en"
      }
