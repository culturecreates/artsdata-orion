    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Alexandre Bisaillon en rodage"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Venez assister au nouveau spectacle d'humour (en rodage) d'Alexandre Bisaillon au sublime Saint-Jean Comédie Club! Alexandre Bisaillon est un humoriste, acteur et auteur Franco-Ontarien. Jeune vétéran du milieu, nous l'avons vu dans une variété de projets tels que les Gala Juste pour rire, Les Galas ComediHa!, la série Top Dogs, comme chroniqueur à Sucré Salé et comme gagnant du Prochain Stand-up (saison 2). L’humour d’Alexandre Bisaillon, jeune “ado-boomer” dans l'âme, nous invite dans son univers où l'autodérision nous fait rire et réfléchir!"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
