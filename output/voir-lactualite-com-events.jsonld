    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Ain’t That Bad"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Matt Lang présente sa nouvelle tournée Ain’t That Bad, un spectacle honky-tonk déjanté et spectaculaire où son 4e album prend vie dans une mise en scène immersive et inédite. Figure incontournable de la musique country au Canada, il y fusionne country et rock, interprétant les pièces de son nouvel album ainsi que ses meilleurs succès. Le spectacle s’appuie sur effets visuels et pyrotechnie, inspiré de l’énergie du film The Hangover."
      }
    ],
