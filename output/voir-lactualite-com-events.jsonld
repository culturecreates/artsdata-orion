    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Chris Kläfford - A sinner's tour — Mont-Laurier | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 23 octobre 2026 à 20 h, à Espace Théâtre (Mont-Laurier). Chris Kläfford s'est révélé au grand public en remportant Swedish Idol en 2017 et en se faisant acclamer sur la scène d'America's Got Talent. Le public québécois l'a peut-être découvert en première partie de Dave Fenley, artiste aux…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://voir.lactualite.com/evenements/chris-klafford-a-sinner-s-tour-eb689a"
      }
    ],
    "http://ogp.me/ns#locale": [
