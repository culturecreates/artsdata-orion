    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Prochaine date le samedi 21 novembre 2026 à 10 h, Maison Saint-Gabriel (Montréal), et 1 autre date jusqu’au 21 novembre 2026. La tire Sainte-Catherine est…"
      }
    ],
