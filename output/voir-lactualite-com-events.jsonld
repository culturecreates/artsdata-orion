  {
    "@id": "https://voir.lactualite.com/evenements/35-ans-et-je-cherche-encore-b52d35",
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "fr-ca",
        "@value": "VOIR — L’actualité"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Laurence Jalbert • 35 ans… Et je cherche encore — Laval | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 1er décembre 2026 à 20 h, à Salle André-Mathieu (Laval). 35 ans… Et je cherche encore célèbre l’album qui, en 1990, a révélé Laurence Jalbert et imposé sa voix parmi les plus marquantes de la chanson québécoise. Porté par des chansons devenues emblématiques, dont Tomber, Rage, Les yeux noirs, À…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
