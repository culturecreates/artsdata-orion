    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 23 octobre 2026 à 0 h, à Bibliothèque de Verchères (Verchères). Du 23 au 31 octobre, les usagers de la bibliothèque seront invités à admirer les créations et à voter pour leur citrouille préférée. Un prix sera remis dans chacune des deux catégories : 2 à 7 ans 8 ans et plus"
      }
    ],
