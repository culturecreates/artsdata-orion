  {
    "@id": "https://voir.lactualite.com/genid/bc76513600244d81",
    "@type": [
      "http://schema.org/DanceEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-12-03T20:00:00-05:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
