      }
    ]
  },
  {
    "@id": "https://voir.lactualite.com/genid/224f08236b28ac79",
    "@type": [
      "http://schema.org/EducationEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-20T09:00:00-05:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
