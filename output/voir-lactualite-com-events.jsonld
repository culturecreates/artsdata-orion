      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/about-cruising-lignes-de-desir-7cc86a"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "About cruising : Lignes de désir"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "C'est une pièce de théâtre sans parole qui aborde la place de l’imaginaire dans le désir. La pièce met en scène un protagoniste novice qui découvre un lieu de cruising, ce qui le confronte aux paradoxes de ses désirs ; ce qu’il envie, ce qui le dégoute, la projection de ses propres fantasmes sur les autres, l’excitation face au danger, etc. À travers une dramaturgie du mouvement faite de lenteur et de micro-gestes, on découvre un univers régi par l’anonymat, par les tensions intérieures et extérieures des personnages, par les codes implicites du cruising et par les impacts de cette pratique de la sexualité sur les corps. En explorant la relation entre visibilité, invisibilité et désir, l’œuvre propose une réflexion sensible sur les mœurs sexuelles contemporaines et les dynamiques propres aux espaces queers, tout en développant une forme théâtrale singulière centrée sur le corps et la suggestion."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
