    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Caravane - Tournée d'adieu à Thetford Mines"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "La première fois pour Caravane à Thetford : 15 novembre 2014. La dernière fois pour Caravane à Thetford : 14 novembre 2026. Venez vivre un moment inoubliable comme dans le temps du Cactus et du Sergent Peppers Pub. En première partie, comme dans le temps : Charles Antoine La fête est finie. Mais la fête continue. Une dernière fois. *Spectacle ouvert à tous* La première fois pour Caravane à Thetford : 15 novembre 2014. La dernière fois pour Caravane à Thetford : 14 novembre 2026. Venez vivre un moment inoubliable comme dans le temps du Cactus et du Sergent Peppers Pub. En première partie, comme dans le temps : Charles Antoine La fête est finie. Mais la fête continue. Une dernière fois. *Spectacle ouvert à tous*"
      }
    ],
