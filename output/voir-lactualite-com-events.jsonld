    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Drôle depuis 1957"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Michel Barrette présente Drôle depuis 1957, son nouveau spectacle. Il y propose un regard humoristique et tendre sur sa génération et y évoque « la revanche des baby-boomers », ces anciens jeunes devenus les grands sages d'aujourd'hui, toujours irrévérencieux. À travers anecdotes, souvenirs et observations, l'humoriste raconte son époque. Le spectacle se présente comme une lettre d'amour au passé et un clin d'œil au présent."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
