    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "En Forêt"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "En Forêt est un laboratoire public présenté au Centre de création de Boisbriand par Tenon Mortaise, théâtre multidisciplinaire. Un jeune enfant, contraint de passer la nuit en camping malgré ses craintes, découvre la magie de la nature qui l'entoure. Le spectacle, d'une durée de 35 minutes, mêle marionnettes, théâtre d'ombres et arts visuels, avec musique et projections."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
