    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Pièce de théâtre – Chanterelle et les héros de la Forêt – Parcours à pied pour toute la famille"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Chanterelle, jeune fille curieuse et vibrante de 10 ans, se rend chez sa mère-grand, qui fête ses 65 ans. Sur le chemin, elle fait la rencontre de Poe le petit polatouche, de Picool le grand pic, d’Armande l’amanite tue-mouches, et de Paprika le pékan. Par des jeux divertissants et imagés, chacun lui fait découvrir son mode de vie et ses talents cachés. Toutefois, le parcours de Chanterelle est entrecoupé par les hurlements d’un animal que l’on croit être un loup… Et s’il s’agissait plutôt d’un tout autre personnage, amateur de promenade en forêt?"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
