    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Atelier d'exploration créative thématique"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "En s'inspirant de la thématique de la Semaine des bibliothèques publiques (Ma biblio : de tout, partout, pour tout le monde), libérez votre créativité ! Entre collage, jeu de création, dessin intuitif et échanges, venez transformer chaque page en une aventure colorée et audacieuse. Avec Geneviève Turcotte. Les participants doivent avoir en leur possession des feuilles blanches cartonnées ou un carnet à dessin personnel. Le matériel artistique à partager sera fourni sur place. Il est aussi possible d’apporter son propre matériel à l’atelier si désiré."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
