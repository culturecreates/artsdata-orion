    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Alexandre Forest est un humoriste. Une présentation antérieure de son travail indiquait qu'il entamait le rodage de son premier one man show, en mêlant autodérision et finesse d'esprit autour des petites et grandes incongruences de la vie quotidienne. Il se produit au Vieux Clocher de Magog."
      }
