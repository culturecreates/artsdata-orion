    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "À corps & vins"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "À corps & vins est une expérience où dégustation et spectacle se mêlent dans une formule immersive de 90 minutes. Prix régulier : 125 $ (inclus le spectacle ainsi que cinq verres de vins et quelques bouchées froides.) Prix donateur : 175 $ (inclus le spectacle, cinq verres de vins, quelques bouchées froides ainsi qu'un don de 50 $ à Diffusion Hector-Charland éligible à un reçu officiel aux fins d'impôt.) Prix entreprise : 500 $ (inclus quatre places pour le spectacle, cinq verres de vin par personne et quelques bouchées froides.) Prix entreprise donatrice : 700 $ (inclus quatre places pour le spectacle, cinq verres de vin par personne et quelques bouchées froides, ainsi qu’un don de 200 $ à Diffusion Hector-Charland éligible à un reçu officiel aux fins d’impôt. Le logo de l’entreprise sera affiché sur sa table afin de souligner son soutien à l’événement.)"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
