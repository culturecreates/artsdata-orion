      {
        "@id": "https://voir.lactualite.com/genid/62562e54c03971e0"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/danser-avec-le-feu-6906e7"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Danser avec le feu"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Durée : 75 minutes, sans entracte Jeune pianiste et compositrice montréalaise, Ariane Racicot se distingue par un langage musical audacieux où le jazz moderne se mêle à des influences fusion, latines, métal, classiques et rock progressif. Nommée Révélation jazz Radio-Canada 2022–2023, Ariane captive le public par sa virtuosité musicale, son jeu expressif et sa joie de jouer sur scène. Elle a fondé son trio en 2019. Ensemble, ils explorent des thèmes comme l’écoanxiété et la résilience à travers des harmonies inattendues, des textures riches et une énergie scénique électrisante. Avec son second album, Dancing With Fire (2025), elle affirme avec force la voix originale et intrépide d’une figure montante du jazz canadien. Photo : Jherry Duperval Diffusart Suivre l'artiste Site Web"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
