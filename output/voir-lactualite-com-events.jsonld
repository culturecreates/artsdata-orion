    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Charles Brunet - Très très bon show"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Charles Brunet est un humoriste. Dans Très très bon show, son nouveau spectacle, il dit avoir 24 ans et commencer à comprendre son métier, sans rien comprendre à la vie. Le spectacle, qui se veut surtout drôle, parle un peu de tout et s'adresse à tout le monde, des jeunes comme des plus vieux. L'humoriste le décrit comme l'œuvre dont il est le plus fier de sa jeune carrière. Son premier spectacle s'intitulait Show Intéressant."
      }
    ],
