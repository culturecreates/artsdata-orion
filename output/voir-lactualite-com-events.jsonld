    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Club de lecture - Adultes"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Partagez vos coups de cœur littéraires! Joignez-vous au club de lecture de la bibliothèque municipale pour échanger sur vos découvertes du mois dans une ambiance chaleureuse et conviviale. Que vous soyez grand lecteur ou curieux d'idées neuves, venez nourrir votre passion et discuter en toute simplicité autour d'une bonne causerie! Inscriptions: [phone], poste 3030 [email]"
      }
    ],
