    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Atelier de tricot"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Venez profiter de cet atelier convivial pour découvrir les bases du tricot ou pour rencontrer d’autres passionné(es)! Que vous soyez débutant(e) ou que vous ayez déjà de l’expérience, cet atelier est pensé pour vous. Si vous n'avez jamais osé vous lancer, c'est l'occasion de vous initier par l'entremise d’une personne passionnée qui saura respecter votre rythme et vous guider, étape par étape."
      }
    ],
