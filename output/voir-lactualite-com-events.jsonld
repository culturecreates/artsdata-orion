    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Blues Gitan"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Des rives de l’Orient jusqu’aux paysages de la Matawinie, la route de la soie continue d’inspirer les imaginaires et les musiques. Porté par cet héritage nomade — façonné entre autres par les Romanichels — Blues Gitan fait résonner une tradition vivante où se rencontrent swing manouche, rumba flamenca et accents balkaniques et méditerranéens. Parmi les formations marquantes du genre au Québec, Blues Gitan se distingue par une énergie rassembleuse et une interprétation habitée. Après quelques années de jachère, le groupe reprend la route en quatuor, réunissant Denis Violletti (voix, guitare), Stéphane Tellier (voix, guitare solo), Patrick Lavoie (guitare, violoncelle) et François Marion (contrebasse)."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
