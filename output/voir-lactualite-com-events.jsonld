    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Ciné-rencontre, Des hommes, la nuit"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Voyez Des hommes, la nuit en présence du réalisateur Anh Minh Truong, puis découvrez les coulisses du film : images inédites du plateau, secrets de tournage et échanges avec le public. Mettant notamment en vedette Pierre Verville, Édith Cochrane, Jean-Moïse Martin, Jade Charbonneau et Jacob Whiteduck-Lavoie, le film offre aussi un regard singulier sur Sherbrooke, qui devient elle-même partie prenante de l’histoire."
      }
    ],
