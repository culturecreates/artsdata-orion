    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Alain Choquette - Entre histoires et illusions"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Entre histoires et illusions est une nouvelle proposition d'Alain Choquette, qui plonge le public dans son grand livre de la magie. Le spectacle mêle récits et illusions, de l'histoire de la magie, de Robert-Houdin à Houdini, Copperfield et Magic Tom, aux expériences vécues au cours de ses 35 années de carrière. L'illusionniste, connu comme juge de La magie des stars, propose une expérience intime, unique et interactive, où la magie prend tout son sens. Il a vendu plus de deux millions de billets, il est le premier Québécois à présenter un spectacle en résidence à Las Vegas et il a mené plusieurs tournées en Europe."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
