      {
        "@language": "fr-ca",
        "@value": "Ballet of Lights: Sleeping Beauty — Montréal | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 8 novembre 2026 à 0 h, à Théatre Rialto (Montréal). Six dancers light up the stage in glowing costumes that transform their every move into visual fireworks. This adaptation of The Sleeping Beauty, created by María Farelo and Christian Pérez, blends classical ballet with modern technology. For…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
