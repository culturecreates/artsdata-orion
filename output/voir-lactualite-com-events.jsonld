    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Appetite for Democracy"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Appetite For Democracy passe au peigne fin le vaste répertoire truffé de classiques essentiels du groupe rock américain Guns 'n Roses. Ils vous offrent. Les incontournables tels que Sweet Child O' Mine, November Rain et Paradise City sont au rendez-vous. Il en est ainsi pour les titres bien-aimés des amateurs fidèles comme Mr Brownstone et Nightrain. Le répertoire a été peaufiné à son meilleur.La justesse de l'incarnation de chacun des membres vous coupera le souffle, vous vous croirez en face d'Axl, Slash et cie."
      }
    ],
    "http://schema.org/inLanguage": [
