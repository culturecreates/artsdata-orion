    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Anthony Montreuil"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "I'M BACK BABY Maintenant que le rodage de la tournée de rodage est enfin terminé, Anthony Montreuil est finalement prêt à commencer la tournée de rodage officiel avec son spectacle en rodage : « \"I’m Back Baby\", un titre de travail provisoire. ». Il a passé l’année dernière à roder son rodage, maintenant que le rodage est rodé, il est prêt à présenter son rodage officiel! Accompagné de son producteur, Gabriel Archambault, il présente enfin le rodage d’un nouveau spectacle à venir et ça, très bientôt."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
