    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Antimatière"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Entre magie, humour et participation, Marc Trudel entraîne les élèves dans un spectacle qui revisite les matières scolaires de façon surprenante et ludique. À travers des démonstrations étonnantes, ANTIMATIÈRE invite les jeunes à développer leur curiosité, leur persévérance et leur réflexion sur leur avenir."
      }
    ],
