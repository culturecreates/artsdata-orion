    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Club de lecture"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Venez partager votre passion pour la lecture dans une ambiance chaleureuse et conviviale. Chaque rencontre est l’occasion d’échanger autour d’un auteur, de découvrir de nouvelles œuvres et de discuter de nos impressions de lecture. 📍 Lieu : Le chalet, 900 rue des Oblats 🕒 Heure : À déterminer Date · Auteur · Lieu · Heure · 10 septembre · Laurent Gaudé · Le chalet, 900 rue des Oblats · À déterminer · 8 octobre · Carlos Ruiz Zafón · Le chalet, 900 rue des Oblats · À déterminer · 12 novembre · Victor-Lévy Beaulieu · Le chalet, 900 rue des Oblats · À déterminer · 10 décembre · Piergiorgio Pulixi · Le chalet, 900 rue des Oblats · À déterminer · Bienvenue à tous, que vous ayez lu une œuvre de l’auteur ou que vous souhaitiez simplement découvrir son univers littéraire."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
