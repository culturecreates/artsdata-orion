  {
    "@id": "https://voir.lactualite.com/genid/822056a27a35e48a",
    "@type": [
      "http://schema.org/MusicEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-11T20:00:00-05:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-11T23:00:00-05:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://voir.lactualite.com/genid/ce63e6000a9c20b5"
      }
    ],
    "http://schema.org/url": [
      {
