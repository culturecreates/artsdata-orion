      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://voir.lactualite.com/artistes/alexis-fortin-17ec13#artist"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/e77e4ea419ffd1ed"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/alexis-fortin-lp6-730"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Alexis Fortin"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Découvert 164 SOURCILS est le magnum opus d'Alexis Fortin. Sa plus grande œuvre en carrière. La plus transcendante, la plus vulnérable, la plus aboutie, la plus travaillée. À seulement 26 ans, il atteint l'apogée de son art. Un spectacle qui fait se demander : « Où était-il avant? ». « Qui même était-il avant? ». « Comment n'ai-je jamais eu accès à un spectacle de stand-up aussi grandiose de sa part? ». Jetez tout ce que vous connaissez d'Alexis Fortin par la fenêtre. SOURCILS est sa meilleure œuvre. C'est aussi sa première œuvre. * Ce spectacle n'est pas admissible à la promotion « Spectacle gratuit à l'achat de 3 spectacles »."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
