  {
    "@id": "https://voir.lactualite.com/genid/0521cfa923c5672d",
    "@type": [
      "http://schema.org/ComedyEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-06-03T20:00:00-04:00"
      }
