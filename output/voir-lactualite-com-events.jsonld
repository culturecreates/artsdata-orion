    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "40 ans de bon voisinage"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Cette année marque un moment important pour notre communauté : la Coopérative du Quartier Petit Champlain célèbre ses 40 ans. 40 ans de partage, de coopération et de fierté Depuis 1985, une coopérative unique, animée par ses commerçants, travailleurs, résidents et clients, contribue à la vitalité, à la renommée et au développement de ce quartier emblématique. Véritable joyau culturel, architectural et patrimonial, le Petit Champlain est aujourd’hui un pôle commercial dynamique qui accueille plus de 2,5 millions de visiteurs chaque année. Des festivités toute l’année Du 12 novembre 2025 au 11 novembre 2026, la Coopérative proposera une année complète de célébrations : des projets portés par ses membres des activités collaboratives des événements festifs et des initiatives culturelles"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
