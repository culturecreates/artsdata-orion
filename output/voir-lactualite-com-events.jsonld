    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Casse-Noisette"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Ballet du Haut-Richelieu Spectacle de ballet 22E ÉDITION CASSE-NOISETTE De partout en Montérégie depuis 1998, plus de 90 danseurs jeunes et adultes auditionnent pour l'obtention d'un rôle dans la distribution de Casse-Noisette. Ils se joignent aux 40 danseurs professionnels de Ballet Ouest de Montréal pour 4 représentations en décembre au Théâtre des Deux Rives à Saint-Jean-surRichelieu. Une nouvelle version, signée par le chorégraphe Claude Caron, est présentée depuis 2013 et sera de nouveau présentée en décembre 2026. Un vent de nouveautés souffle ainsi sur les chorégraphies, les décors et les costumes, sans oublier l'intégration du multimédia. C'est donc un rendez-vous à ne pas manquer. Véritable tradition depuis 1998-1999, le spectacle Casse-Noisette, présenté par BCHR en collaboration avec Ballet Ouest de Montréal, réjouit chaque année le cœur de centaines de spectateurs. Cet événement est un incontournable pour bien des familles du Haut-Richelieu, à l'approche de Noël. Il rassemble de talentueux danseurs qui émerveillent petits et grands dans de somptueux décors et vêtus de magnifiques costumes. Un spectacle féérique, à ne pas manquer. Nous vous attendons en grand nombre! Durée : 1h40 + entracte"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
