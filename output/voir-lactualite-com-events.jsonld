    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "3 & Moi — Gatineau | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 23 avril 2027 à 20 h, à Salle Odyssée (Gatineau). Un spectacle festif, vivant et plein de surprises! Dans ce nouveau rendez-vous musical, Bruno Pelletier revisite avec authenticité et générosité les grandes chansons qui ont marqué sa carrière — Coriace, Ailleurs c’est comme ici, Le temps des…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://voir.lactualite.com/evenements/3-moi-f6f8d7"
      }
    ],
    "http://ogp.me/ns#locale": [
