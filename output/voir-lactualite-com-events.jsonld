    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 29 avril 2027 à 19 h, à Théâtre Desjardins (Montréal). Après trois spectacles à succès et un livre qui revisite ses premiers textes, André Sauvé fait un retour sur scène avec une création audacieuse où son regard unique sur le monde puise son inspiration dans la nature et ses mystères. Il nous…"
      }
