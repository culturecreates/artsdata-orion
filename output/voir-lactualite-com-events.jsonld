    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Bess Atwell se produit à L'Escogriffe dans le cadre d'une soirée présentée par evenko et Greenland. Selon le site officiel de l'artiste, son album The Act est actuellement disponible en écoute. La page de l'artiste annonce aussi une tournée qui compte des arrêts au Royaume-Uni, au Canada et aux États-Unis."
      }
    ],
