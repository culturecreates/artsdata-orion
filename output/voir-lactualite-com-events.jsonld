      }
    ]
  },
  {
    "@id": "https://voir.lactualite.com/genid/10aec3c6e12f516e",
    "@type": [
      "http://schema.org/ScreeningEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-24T19:00:00-05:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
