    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Isabelle Grondin propose un atelier de broderie sur papier, une technique artistique alliant dessin et travail du fil. L'activité permet aux participants de découvrir cette approche créative."
      }
