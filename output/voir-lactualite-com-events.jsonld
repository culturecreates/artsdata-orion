    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "COURS DE DANSE SWING - NIVEAU 1 (INITIATION) AVEC GENEVIÈVE BOILY DE SWING CHARLEVOIX"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Venez apprendre les pas de base du swing dans le plaisir! Aucun partenaire requis, mais suggéré. La danse swing est une danse sociale de couple qui prend racine dans les rythmes de la musique jazz qui est omniprésente dans les cours. Pour le cours d'initiation, on apprend les pas de base et les premiers mouvements de danse, pour vous permettre de danser sur une chanson complète dès le premier cours. Mardi soir, 18 h 30 à 20 h, 6 octobre au 10 novembre (6 semaines). Tarif : 110 $. Carrefour culturel Paul-Médéric."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
