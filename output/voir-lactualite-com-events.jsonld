    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Christophe Dupéré"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Christophe Dupéré présente un spectacle à la Salle Odyssée. L'humoriste a notamment rodé son premier one-man-show dans de plus petites salles, un spectacle où il abordait des anecdotes familiales et sportives à travers son regard d'anxieux. Il a également pris part à une soirée d'humour à plusieurs artistes au Balthazar Boisbriand."
      }
    ],
