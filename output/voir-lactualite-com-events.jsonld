    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Concours de dessin"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Participez en grand nombre au concours de dessin sur le thème du parcours hanté: la fête foraine! Laisse aller ton imagination et crée ton plus beau dessin sur le thème de la fête foraine, avec une touche épeurante! Dépose ton dessin dans la chute à livres de la bibliothèque avant le jeudi 29 octobre 2026. Note bien ton nom et ton numéro de téléphone au verso de ton dessin. Les dessins seront exposés lors du parcours hanté du 31 octobre et tu pourrais courir la chance de gagner une carte-cadeau! Tirage le 10 novembre 2026. Bonne chance à tous et toutes."
      }
    ],
