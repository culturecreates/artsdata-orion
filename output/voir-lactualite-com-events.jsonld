    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "AUX PETITS OIGNONS, la cuisine au 19e siècle"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Au 19e siècle, la cuisine est au cœur de la vie quotidienne ; on y prépare les repas, transforme les aliments et constitue les réserves pour traverser les saisons. L’exposition Au petits oignons, la cuisine au 19e siècle vous invite à découvrir les habitudes alimentaires, les savoir-faire et les traditions culinaires du Bas-Canada à travers les objets, les gestes et les réalités des famille de l’époque. Plongez dans un univers où cuisiner demande du temps, de l’ingéniosité et beaucoup de soin pour nourrir les siens."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
