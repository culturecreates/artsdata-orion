      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 15 octobre 2026 à 17 h, à Lieu à préciser – Daveluyville (Daveluyville). Dans le cadre des célébrations du 125e anniversaire de Daveluyville, nous vous invitons à prendre part à quatre journées d’activités qui nous feront voyager à travers notre histoire, nos traditions et notre patrimoine.…"
      }
    ],
    "http://ogp.me/ns#url": [
