    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "C'EST PAS MOI, C'EST TOI, c'est du stand-up pur et dur, un véritable feu roulant de gags où chaque punch frappe en plein coeur. Un regard sans filtre, mordant, mais surtout hilarant, sur une société où la rupture était inévitable."
      }
    ],
