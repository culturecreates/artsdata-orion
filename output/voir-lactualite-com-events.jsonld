    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Billy Tellier Kicker la Ruche"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Billy Tellier présente Kicker la ruche, son troisième one-man-show. Son parcours compte plus de 50 000 billets vendus et près de 200 représentations. Fidèle à son style percutant, il aborde des sujets universels avec humour et justesse. Il y partage ses réflexions sur la peur de faire les mauvais choix. Toute sa vie, il a joué l'abeille modèle, prenant des décisions sages pour ne pas déranger son entourage, et se demande aujourd'hui s'il ne serait pas temps de secouer les choses."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
