        "@value": "Contes animés"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Contes animés est une activité jeunesse présentée à la Bibliothèque Georges-Henri-Lévesque, à Roberval. Sophie y raconte des histoires et anime des activités comme des dessins, des collages, des murales et des décorations. Des parents habitués de l'activité la décrivent comme un moyen de rencontrer d'autres parents, de s'intégrer à Roberval et de se faire lire des histoires."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
