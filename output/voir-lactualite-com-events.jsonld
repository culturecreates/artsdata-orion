    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "CLUB LAINE"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Ces rencontres conviviales sont ouvertes à toutes les personnes passionnées de tricot et de crochet. La bibliothèque vous offre un espace de création et de discussion où un thé réconfortant sera servi. Apportez vos projets et votre matériel, et venez échanger entre adeptes pour apprendre ou partager vos connaissances !"
      }
