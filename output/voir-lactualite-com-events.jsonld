    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "125, rue des Malaises"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Laurent Perrier a pris une décision irrévocable. Pas par désespoir — par conviction profonde. Avant de partir, il veut régler ses affaires et s’assurer que rien ne restera en suspens. Il convoque donc sa fille dans sa maison de campagne. Mais alors que la situation est déjà bien tendue, un inconnu frappe à la porte — et avec lui, c’est toute la paix familiale qui vole en éclats."
      }
    ],
