      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://voir.lactualite.com/artistes/alex-roy-128257#artist"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/f72cfe3825d263c5"
