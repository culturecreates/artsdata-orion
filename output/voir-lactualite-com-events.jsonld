      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le samedi 23 janvier 2027 à 20 h, Salle Desjardins-Telus (Rimouski). Maître de l’insaisissable et raconteur hors pair, Alain Choquette revient sur scène…"
      }
    ],
    "http://ogp.me/ns#url": [
