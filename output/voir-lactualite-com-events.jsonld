      {
        "@id": "https://voir.lactualite.com/artistes/luc-guerin-85fc0b#artist"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/54227a711bc0e3b2"
