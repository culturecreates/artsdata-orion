    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Alphonse Bisaillon"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Alphonse est une bête de scène et un poète. Avec t.o.m. ou la trajectoire des perséides, il plonge dans son passé de garçon rural. Une épopée qui questionne les modèles masculins offerts aux jeunes hommes. Sur scène, six musicien.ne.s portent son énergie, du jazz au dubstep, guidée par la force des mots. Un spectacle théâtral où t.o.m., ami ou amour, incarne ce que chaque homme peut devenir. Selon le nombre de billets vendus, le spectacle pourrait être proposé en formule debout, avec seulement quarante places assises sur les balcons."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
