      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/chansons-d-exception-lp11-483"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Chansons d'Exception"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le groupe vocal La-Mi-Sol présente son nouveau spectacle :« Chansons d’exception ». Comme l’indique le titre, toutes les chansons sont exceptionnelles, soit par leur histoire, leur longévité, leur popularité, leur rayonnement international, leur marque sur l’évolution de la musique, ainsi que sur l’innovation qu’elles ont apporté pour les auditeurs. Toutes les chansons sont connues mais parfois revisitées avec originalité. Que ce soit la musique ou les statistiques qui vous font vibrer, vous raffolerez des grandes chansons de notre histoire récente ou plus ancienne. Aznavour? Mozart? Piaf? Ferland? Harmonium? LesColocs? Offenbach? Eagles? Pink Floyd? Avez-vous un titre en tête? Fort probable qu’il soit au programme."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
