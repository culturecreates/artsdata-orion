      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/coup-de-souffle-no-06-some-became-hollow-tubes-cloud-circuit-6136cf"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Coup de Souffle No. 06"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "SOME BECAME HOLLOW TUBES 21h Des vagues de rock drone improvisé par Eric Quach (thisquietarmy, Tempête Solaire) et Aidan Girt (Godspeed You! Black Emperor). Les accords tournent en boucle, les pédales sont poussées à fond, des parties de batterie percutantes s'ajoutent et s'effacent; ça commence doucement et monte en puissance. Eric n'a plus à se soucier du rythme, Aidan n'a plus à se soucier de la structure des morceaux. Le dernier LP de Some Became Hollow Tubes est paru en août 2026 chez We, Here and Now! Recordings. Page Facebook : Page Instagram : Bandcamp : somebecamehollowtubes.bandcamp.com CLOUD CIRCUIT 20h Projet poésie-son, Cloud Circuit s’inspire des bogues de communication et des connexions perdues. La poète Deanna Radford canalise ses flux de textes itératifs en « bouche-à-oreille » déconstruits, tandis que l’artiste sonore Jeremy Young utilise des ondes sinusoïdales en perpétuelle mutation, des bandes magnétiques 1/4\", et des captations d’ondes radio. En performance, l’approche de Cloud Circuit est collaborative et improvisée : leur son est composé, disséqué et réfracté en temps réel. Le duo a partagé la scène avec des artistes tels que Phew, Sam Prekop, Lea Bertucci, David Grubbs, Vito Ricci, Jessica Pavone, Alex Zhang Hungtai, Paul Dutton, Ron Whitehead, Sarah Pagé, Greg Davis, Khaleefa 'Apollo the Child' Hamdan, Alessandra Eramo, Jessica Ackerley, et d’autres. Deanna Radford (she/her) - voice, voice on tape, some sound making objects, paper. Jeremy Young (he/him) - magnetic tape loops, oscillators, radio, electronics. Le premier LP de Cloud Circuit est paru en juin 2026 chez Watch That Ends The Night Records. YouTube : Page Instagram : Bandcamp : cloudcircuit.bandcamp.com"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
