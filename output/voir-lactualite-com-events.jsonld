    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Éric Lapointe - Entracte, le show acoustique"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Éric Lapointe, auteur-compositeur-interprète, présente Entracte, le show acoustique, un spectacle de chanson dans une formule acoustique. L'artiste a célébré ses 30 ans de carrière avec un réenregistrement des dix chansons de son album Obsession, dont Terre promise, N'importe quoi et L'exquise, paru en édition vinyle, ainsi qu'avec un spectacle-anniversaire intitulé Obsession 30 ans."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
