    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Concert de Noël"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Pour entendre vos cantiques favoris, l’oratoire Saint-Joseph vous convie à son Concert de Noël. Les chants traditionnels d’ici rencontrent les musiques d’ailleurs, interprétés par le quatuor Cobalt, dans une atmosphère chaleureuse et entraînante. Un événement à ne pas manquer le 12 décembre prochain."
      }
    ],
