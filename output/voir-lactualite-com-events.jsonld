    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Charles Brunet – Très Très bon show"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Très très bon show est un spectacle de Charles Brunet dont le propos, décrit par l'artiste comme profond et mature, aborde des sujets variés. Le ton est surtout très drôle, et le spectacle s'adresse à tout le monde, qu'on soit jeune ou plus âgé, peu importe ses allégeances. Il fait aussi référence à des repères de la culture numérique, comme TikTok ou MSN. Charles Brunet considère cette œuvre comme celle dont il est le plus fier au cours de sa jeune carrière."
      }
    ],
    "http://schema.org/inLanguage": [
