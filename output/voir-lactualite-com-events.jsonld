    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Atelier – Développe ta plume comique les 11-14 ans"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Vous pensez que l’humour est un don? Bonne nouvelle : ça s’apprend! En compagnie de professionnels et professionnelles de l’École nationale de l’humour, découvrez les bases de l’écriture humoristique à travers des exercices pratiques et des défis créatifs. Apprenez à construire une blague, à maîtriser différents procédés comiques et à développer votre propre voix humoristique."
      }
    ],
