    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Atys"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le compositeur américain Jonathan Dawe, reconnu pour son travail hybride entre baroque et langage actuel, et la metteuse en scène Stéphanie Jasmin, œuvrant à la croisée des langages littéraires, scéniques et visuels, s’emparent de l’opéra de Lully et Quinault pour imaginer une nouvelle tragédie."
      }
    ],
