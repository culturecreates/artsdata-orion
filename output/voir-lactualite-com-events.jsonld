    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "BOO! CINÉ-FRISSON"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le jeudi 29 octobre prochain, plongez au coeur de l’Halloween avec le CINÉ-FRISSON présenté au Centre municipal. Au menu attendez-vous à : Bar à bonbon gratuit Pop corn gratuit Prix de présence pour les enfants costumés Service de cantine et bar ($) 2 films seront présentés FILM JEUNESSE – 18 h 30 – Des minions et des monstres FILM ADO – 20 h 30 – Sifflet maudit L’ouverture des portes se fait à 17 h 30. 3 tirages de prix de présence pour les enfants costumés se font à 18 h25. 3 tirages de prix de présence pour les enfants costumés se font à 20 h 25. La fermeture de l’activité se fait à 23 h. Les enfants de 8 ans et moins doivent être accompagnés d’un adulte. Le film pour ado est classé 13 ans et +."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
