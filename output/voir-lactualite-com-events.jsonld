        "@id": "https://voir.lactualite.com/genid/42dad7114382ac0c"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.sallealbertrousseau.com/cdn/shop/files/JF_Otis_Avec_Plaisir_1920x1400_dfba6009-e4b6-4b4d-a6b9-29f8390f0e96.jpg?width=3840"
      }
    ],
    "http://schema.org/url": [
      {
