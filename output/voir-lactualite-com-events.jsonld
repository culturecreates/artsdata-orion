      }
    ]
  },
  {
    "@id": "https://voir.lactualite.com/genid/0dc4d121b4729a98",
    "@type": [
      "http://schema.org/MusicEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-25T19:00:00-05:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-25T21:00:00-05:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://voir.lactualite.com/genid/fb5cf6def26d5d5d"
      }
    ],
    "http://schema.org/url": [
      {
