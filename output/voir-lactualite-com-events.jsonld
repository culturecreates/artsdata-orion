    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Christmas Market"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Contests, gifts and surprises! The weekend before Christmas, take the time to relax at the market and get some unique gifts for you and your loved ones! Look through the beautifully decorated stands of our merhants while listening to live music with Julius & Friends a cup of hot apple cider to warm you up offered by Quinn Farms and a special elf spécial popping up with goodies… or little pranks! Special activities for all ages are planned to bring you joy, smiles and laughter."
      }
    ],
