      }
    ]
  },
  {
    "@id": "https://voir.lactualite.com/genid/2f33bcf89135a956",
    "@type": [
      "http://schema.org/MusicEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-01T19:00:00-05:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-01T22:00:00-05:00"
      }
    ],
