    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 1er novembre 2026 à 0 h, à Cine Starz Longueuil (Longueuil). Since 2008, Les Aventuriers Voyageurs has been presenting authentic travel stories that will help you discover the world with spectacular images presented on a big screen, in high definition. Real adventures, with travelers like you!…"
      }
