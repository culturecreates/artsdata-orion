    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Bye Parula"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Originaire de Montréal, Bye Parula propose un univers musical singulier qui mélange folk, indie-rock, art-pop et funk dans une approche raffinée et cinématographique. Révélé avec son premier album I (2023) et le succès « Still Got the Spirit », le trio poursuit son exploration sonore avec Something Out of Nothing (2026). Inspiré par des artistes comme Serge Gainsbourg, Elliott Smith et Talking Heads, Bye Parula séduit par ses mélodies envoûtantes, ses sonorités éclectiques et son énergie sur scène."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
