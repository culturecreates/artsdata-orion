    ]
  },
  {
    "@id": "https://voir.lactualite.com/genid/b74bc7c378d331c7",
    "@type": [
      "http://schema.org/DanceEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-14T20:00:00-05:00"
      }
    ],
