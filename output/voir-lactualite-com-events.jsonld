    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/annie-blanchard-et-maxime-landry-l-assomption-ec831c"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Annie Blanchard et Maxime Landry"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Après plus de 35 000 billets vendus de leur spectacle Jolene and the Gambler, le duo revient sur scène avec une nouvelle version acoustique de leur en hommage aux légendes de la musique country. Fort du succès retentissant de leur tournée, Maxime Landry et Annie Blanchard remontent sur scène pour offrir une expérience musicale encore plus riche, émotive et festive. Ce nouveau spectacle hommage revisite les plus grands succès de Kenny Rogers et Dolly Parton, deux icônes intemporelles de la musique country."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
