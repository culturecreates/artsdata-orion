    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Airs Givrés"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Sonia Johnson, chanteuse jazz Accompagnée au piano Airs givrés, mini album paru en novembre 2021 est un recueil de chansons uniques comme chaque flocon de neige qui tombe, porté par la voix sensible et profonde de Sonia Johnson. Des textes hivernaux de toutes les époques, soutenus par les arrangements fougueux et sensibles de Luc Beaugrand, pianiste et complice co-réalisateur avec lequel ils ont remporté le JUNO du meilleur album jazz en 2012. Ce musicien possède un sens du « beau, du vrai » mettant la voix de Sonia à l’ plan. Réunis autour d’ piano, des arrangements simples se dessinent, parfois l’ d’ clavier, d’ kalimba, d’ improvisation vocale. Savourez la splendeur de l’ tout simplement."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
