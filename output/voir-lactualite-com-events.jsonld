    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Back To The 80s Band"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Back To The 80s Band réunit quatre musiciens et deux chanteurs d'expérience spécialisés dans le rock des années 80. Le groupe revisite des tubes de cette époque, de Queen à Bon Jovi, en passant par Pat Benatar et Heart. Son répertoire est présenté comme varié et adapté aussi bien à un événement corporatif qu'à une scène de festival ou à une soirée plus intimiste. Les sources soulignent également son duo vocal."
      }
    ],
