      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/c2553c32861b6797"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/apres-on-va-ou-a2c49e"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Après on va où ?"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Après on va où ? est un théâtre musical en solitaire de Michel Rivard. Durant les deux semaines que dure la floraison d'un magnolia qui illumine la fenêtre de sa chambre, «l'homme qui me ressemble» (74 ans) se questionne sur sa vie, avant et après la mort, confrontant ses doutes et ses certitudes. Entre un rendez-vous médical et le choix d'une urne dans un catalogue, entre un premier amour et une marche en forêt avec son petit-fils de sept ans, il monologue, poétise et chante sa recherche du «plus-grand-que-soi». Le projet intègre monologues et chansons."
      }
    ],
