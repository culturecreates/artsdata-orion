    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Espaces oscillants"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "qui prend pour point de départ le glacier du Rhône, en pleine transformation sous l’effet du réchauffement climatique. À travers cartes, archives, films et œuvres contemporaines, elle explore comment l’architecture et l’art réagissent à un paysage en mutation et aux conséquences du recul des glaciers sur le vivant."
      }
    ],
