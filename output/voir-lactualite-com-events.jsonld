    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Cercle de lecture"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "JOUR Un jeudi par mois à 14 h 20 août 2026 3 septembre 2026 1er octobre 2026 5 novembre 2026 3 décembre 2026 SOIR Un mercredi par mois à 18 h 30 19 août 2026 16 septembre 2026 21 octobre 2026 18 novembre 2026 16 décembre 2026 À la Bibliothèque Jean-Marc-Belzile Animé par Julie Morin 16 ans ou plus Animées par Julie Morin, ces rencontres conviviales permettent aux participants de partager leurs lectures favorites selon l'auteur choisi. Des discussions passionnantes et plusieurs découvertes littéraires seront au menu! Inscription en ligne sur la plateforme Sport-plus • Gratuit Dates d'inscription et détails : Cliquez ici Informations 311 ou [phone] En personne au comptoir du prêt"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
