    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 1er juin 2026 à 0 h, à Lieu à préciser – McMasterville (McMasterville). Le sentier Roger-Dubuc à McMasterville accueille « Artefact », une exposition photographique extérieure de Sarah Poirier. Sarah Poirier habite Sainte-Madeleine et travaille auprès d’une clientèle vivant avec une déficience…"
      }
    ],
