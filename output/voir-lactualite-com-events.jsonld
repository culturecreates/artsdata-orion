  {
    "@id": "https://voir.lactualite.com/evenements/a-new-role-for-westmount-s-1810-cannon-465ef1",
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "fr-ca",
        "@value": "VOIR — L’actualité"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "A New Role for Westmount’s 1810 Cannon — Westmount | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 15 octobre 2026 à 19 h, à Westmount Public Library (Westmount). For almost a century, a pair of British military cannon from the Napoleonic era was a familiar feature of Westmount Park’s landscape. Some 20 years ago, they were removed to storage for safety reasons and faced an uncertain future.…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://voir.lactualite.com/evenements/a-new-role-for-westmount-s-1810-cannon-465ef1"
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
        "@value": "fr_CA"
