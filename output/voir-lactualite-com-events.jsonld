    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "A London Way Back To Me"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Après un succès le 20 septembre dernier, Melina revient au Québec pour offrir son spectacle à nouveau, avec quelques petites modifications (c'est un rendez-vous pour les curieux!). Suivant la sortie de son tout récent album « A London Way Back To Me », Melina profite de sa visite au Québec pour monter sur scène lors d'une unique soirée et vous partager un spectacle sous formule acoustique. Rendez-vous à la salle Carpe Diem (Longueuil) en formule cozy-réconfort où Mélina et ses musiciens vous offrirons un mélange de ses plus récentes chansons, quelques unes tirées de son précédent album Revival ainsi que quelques surprises. Entre nouveau départ, remises en questions et résilience, de Londres à Montréal, une soirée de musique et de touchantes confidences vous attend. C'est avec beaucoup d'émotion que Melina rentre à la maison le temps d'un instant pour partager ce grand cheminement avec vous; c'est un rendez-vous. Gratuité pour les enfants : Gratuit pour les 8 ans et moins"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
