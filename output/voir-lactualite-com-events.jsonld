      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://voir.lactualite.com/genid/2e760c891c196104"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://voir.lactualite.com/artistes/2120-7513f9#artist"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/33c1c540655665b2"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/2120-0d9814"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "2120"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "En pleine ascension internationale, 2120 propose un show intense, raffiné et résolument rétro, où la puissance vocale de Billy St-Onge rencontre les grooves planants d’un mod-rock maîtrisé et audacieux. Après un premier album acclamé, 2120 In Spectacular Physical Health. Le 9 octobre 2026 paraît leur deuxième album, “Powdery Notes” : un disque plus incisif, plus soul, et surtout plus « produit » que son prédécesseur. Là où le premier avait été rodé sur scène avant d'être capté presque tel quel, celui-ci a été composé à l'été 2025 puis enregistré avant même d'être joué, dans l'excitation de le découvrir au fil de sa construction, entouré d'une collection de synthés et d'orgues vintage. En pleine ascension internationale, 2120 propose un show intense, raffiné et résolument rétro, où la puissance vocale de Billy St-Onge rencontre les grooves planants d’un mod-rock maîtrisé et audacieux. Après un premier album acclamé, 2120 In Spectacular Physical Health. Le 9 octobre 2026 paraît leur deuxième album, “Powdery Notes” : un disque plus incisif, plus soul, et surtout plus « produit » que son prédécesseur. Là où le premier avait été rodé sur scène avant d'être capté presque tel quel, celui-ci a été composé à l'été 2025 puis enregistré avant même d'être joué, dans l'excitation de le découvrir au fil de sa construction, entouré d'une collection de synthés et d'orgues vintage. Le stationnement est gratuit dès 18h au centre-ville. [email] 2120 Né dans les cafés et salles de concert du Mile-End à Montréal, le trio mod-rock 2120 s'est forgé une solide réputation grâce à sa fusion de psych-pop nostalgique et de grooves R&B empreints de soul. Fondé à Sherbrooke en 2015 par les frères Maxime et Gabriel Blackburn, rejoints par le chanteur Billy St-Onge, le groupe séduit par son esthétique seventies assumée, son charisme scénique et son musicalité sophistiquée. Leur premier album, 2120 In Spectacular Physical Health (2022), produit par Jace Lasek (Arcade Fire, SUUNS), reçoit des critiques élogieuses, saluant notamment la voix de St-Onge, comparée à celle de James Brown et David Bowie. Le groupe passe rapidement des petites salles aux grandes scènes, notamment au Festival d'été de Québec, tout en assurant une résidence hivernale au Quartier des Spectacles. En 2024, 2120 s’attaque à l’Europe avec une première tournée en France, couronnée de succès malgré une visibilité initiale limitée. Invité par le Sub Pigalle, puis de retour à l’automne pour des concerts complets à Paris, Lille, Bruxelles et Strasbourg, 2120 s’impose à l’international."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
