    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Boogie Wonder Band X St-Eustache QC"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le Boogie Wonder Band est un groupe dont le répertoire s'inspire de la musique disco des années 1970. Son répertoire rassemble les plus grands succès de cette décennie, notamment ceux de Donna Summer, des Bee Gees, de Gloria Gaynor et de KC & the Sunshine Band. Le groupe est reconnu pour ses grooves et son énergie scénique, qui font de ses concerts des soirées où l'on est invité à danser."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
