    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Alan Cavé is a Haitian-American kompa (compas) artist whose music blends Caribbean rhythms with vocals in French, Haitian Creole, and English . His November 8, 2026 Place Bell date is listed under the World music category on the Weekend Owl event listing , though the official Place Bell and evenko calendars list the event without a genre categorization. He draws a dedicated francophone audience in the Montreal and Laval area."
      }
    ],
