    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 25 novembre 2026 à 0 h, à Théâtre du Rideau Vert (Montréal). Script-édition Luc Michaud Mise en scène Léane Labrèche-Dor Maître de cérémonie Élise Guilbault Interprétation Fabiola Nyrva Aladin, Éric Bernier, Pierre Brassard, Véronique Claveau, Hugolin Jodoin-Michaud Musicien Jean-Sébastien Houle"
      }
