      }
    ]
  },
  {
    "@id": "https://voir.lactualite.com/genid/5c227607efaadb04",
    "@type": [
      "http://schema.org/ExhibitionEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-10-03T00:00:00-04:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-01-10T00:00:00-05:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://voir.lactualite.com/genid/451d09dcbf52785a"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://storage.googleapis.com/maj-strapi-uploads-prod/lg_IMAGE_PROMO_Anahita_Norouzi_3x2_7610d0e9e4/lg_IMAGE_PROMO_Anahita_Norouzi_3x2_7610d0e9e4.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://voir.lactualite.com/evenements/anahita-norouzi-rift-ebefa7"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://voir.lactualite.com/genid/3da1b903ea33a340"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://voir.lactualite.com/artistes/anahita-norouzi-259e12#artist"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/aa074b499f237698"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/anahita-norouzi-rift-ebefa7"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Anahita Norouzi Rift"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Anahita Norouzi. Rift interroge la notion de « progrès » comme instrument de domination coloniale à travers l’histoire de l’exploitation pétrolière en Iran. Si le projet de l’artiste émane de l’examen d’un cadre historique et géopolitique particulier, il contribue à ouvrir plus largement la réflexion sur le contexte actuel, alors que les problématiques croisées de la montée des impérialismes et de l’extraction abusive des ressources de la planète entraînent un déséquilibre planétaire qui menace des populations et fragilise l’avenir de l’humanité. Dans ses nouvelles œuvres filmiques et installatives, l’artiste adopte une démarche de contre-prospection pour examiner comment les infrastructures pétrolières et culturelles ont été déployées conjointement pour contrôler corps et esprits. Tissées à partir de captations inédites sur le terrain et d’archives cinématographiques, les œuvres entrelacent bouleversements historiques, tragédies culturelles, et tensions entre visées expansionnistes et basculements révolutionnaires. Plus encore, les pièces explorent comment la modernisation coloniale a transformé la région en un espace spectral marqué par des ruines écologiques et la dépossession, révélant ainsi ce qui persiste aujourd’hui des dynamiques du passé. L’exposition Rift interroge en outre les notions de circulation et de déversement à travers les « débris impériaux », envisagés comme des dispositifs actifs qui perpétuent des modes de contrôle plutôt que d’ouvrir sur une configuration post-impériale."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
