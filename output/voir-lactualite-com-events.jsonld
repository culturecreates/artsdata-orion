    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/complet-on-s-enverra-des-fleurs-1878d2"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "[COMPLET] On s'enverra des fleurs"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Fredz présente le spectacle On s'enverra des fleurs, où la scène devient un journal intime vivant. L'artiste y dépose ses doutes, ses rêves et ses blessures dans des chansons portées par une mise en scène à la fois brute et poétique, entre fragilité et puissance. Rappeur québécois dans la jeune vingtaine, il cumule plus de 200 millions de streams et trois singles d'or, avec un style qu'il décrit comme un rap suave et sensible. Ce projet scénique marque une étape dans son parcours, ouvrant un nouveau chapitre dans son évolution artistique."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
