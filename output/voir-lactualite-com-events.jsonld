    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Charles Brunet - Très très bon show"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Charles Brunet présente Très très bon show, un spectacle qui aborde un large éventail de sujets, de la vie quotidienne aux générations en passant par les réseaux sociaux. Il s'adresse à tous les publics, jeunes comme plus âgés, et se veut avant tout très drôle. C'est l'œuvre dont l'artiste est le plus fier depuis le début de sa carrière."
      }
    ],
