    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Candlelight: Vivaldi's 4 Seasons by candlelight"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Step into Vivaldi's world and discover the passion, drama and elegance of Baroque music. Featuring some of his most celebrated compositions, this Candlelight concert invites you to experience centuries of musical brilliance. This concert experience is a tribute. It is not associated with, endorsed by or sponsored by the artist, their heirs or their official representatives. Programme: The Four Seasons by A. Vivaldi (Spring, Summer, Autumn, Winter) and La Folia. Performers: String Quartet; 2 violinists; 1 violist; 1 cellist."
      }
    ],
