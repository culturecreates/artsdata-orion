    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Breen Leboeuf - Mes blues passent pu dans porte"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Breen LeBoeuf, interprète d'un des plus grands succès de l'histoire musicale québécoise, est considéré par plusieurs comme l'une des plus belles voix du Québec. Dans Mes blues passent pu dans' porte, il revisite les grands classiques d'Offenbach, groupe culte dont il a été l'un des principaux artisans, entouré de musiciens dont Réjean Lachance à la guitare, Pierre Beauregard au clavier et au sax, et Marc Brodeur à la batterie. Le spectacle est présenté au Lionel-Groulx Theater."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
