    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Dan Bigras"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Cette Voix se veut un témoignage d’affection de Dan Bigras envers son ami Gerry Boulet. Bouleversé dès la première écoute de La voix que j’ai, Dan voit sa carrière prendre forme grâce au soutien de celui qui deviendra un grand ami : Gerry. Ce parcours unique se raconte à travers anecdotes et chansons inspirées de l’univers de ce rockeur plus grand que nature, jusqu’à ce legs marquant qu’est Jézabel, réalisé par Dan Bigras. Dans ce spectacle, Dan Bigras relève le défi de faire revivre Gerry sur scène, avec lui et ses musiciens, en entremêlant leurs voix et leurs instruments."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
