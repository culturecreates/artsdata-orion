    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "CAMELPHAT VOLKODER"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "[DSTRKT] est un format de production immersive présenté par Produkt, qui rapproche les DJs underground de leur public : des fans entourent le DJ sur trois côtés, et l'énergie circule dans les deux sens. Selon la page de l'événement, ce concept a d'abord été conçu pour des résidences avec Black Coffee et Mark Knight. Cette soirée au New City Gas réunit CAMELPHAT et VOLKODER dans ce format."
      }
    ],
