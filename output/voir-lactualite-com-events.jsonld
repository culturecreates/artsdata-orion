  {
    "@id": "https://voir.lactualite.com/evenements/begotten-de-e-elias-merhige-c59bdb",
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "fr-ca",
        "@value": "VOIR — L’actualité"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "BEGOTTEN Un film de E. Elias Merhige — Québec | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 9 octobre 2026 à 0 h, à Cinéma Beaumont (Québec). Nouvelle restauration 4K ! BEGOTTEN ne possède aucun personnage au sens conventionnel du terme. Trois figures seulement à son générique : Dieu se tuant lui-même, Mère Nature et Fils de [...]"
      }
    ],
