    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Atelier pour les 11 ans et plus – Création d’un carnet artistique avec Gabrielle Morrisseau – Collage et recherche visuelle"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Créez votre propre tableau d’inspiration à partir de collages variés, puis explorez des motifs, des formes et des textures en dessin. Laissez libre cours à votre imagination et transformez vos idées en images. Un atelier créatif pour enrichir votre carnet de croquis et stimuler votre inspiration."
      }
    ],
