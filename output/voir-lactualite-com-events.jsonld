    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Cyrano de Bergerac - La Comédie Musicale — Québec | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 19 mars 2027 à 20 h, à Grand Théâtre de Québec (Québec). « Il l’aimait en silence, il souffrait en secret... » Il écrivait dans l’ombre des chansons qu’un autre chantait dans la lumière... La plus bouleversante histoire d’amour du théâtre français racontée en 23 chansons! Redécouvrez le chef…"
      }
    ],
