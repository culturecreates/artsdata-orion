    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "BySomethingELSE"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Une soirée de prog incontournable avec bySomethingELSE! En première partie, le groupe vous présente son album Hope paru en 2025 en plus de quelques nouvelles pièces en exclusivité qui apparaîtront sur notre prochain album... En deuxième partie, nous vous présentons un moment de nostalgie avec Childhood Friends, notre projet d'hommage au groupe Marillion époque Fish. Nous jouerons des pièces tous les albums du groupe parus dans les années 80 avec une passion et une précision inégalées. Ne manquez pas ce concert inoubliable!"
      }
    ],
