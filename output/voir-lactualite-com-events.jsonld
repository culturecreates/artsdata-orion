    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Conférence: L’agriculture en mémoire de l’homme et de ses instruments"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Offerte en collaboration avec la Société d’histoire de Lanoraie, cette conférence émouvante rend hommage aux hommes qui ont façonné notre terre. En compagnie du conférencier Robert Payant, plongez dans le quotidien captivant de Roméo (1913-2005) et découvrez le récit d'un agriculteur d'exception aux 56 métiers et 56 misères. Une véritable traversée de notre mémoire collective."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
    "http://schema.org/eventStatus": [
