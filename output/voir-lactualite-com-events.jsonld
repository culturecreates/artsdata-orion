    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "BUZZ CUIVRES - Le Noël de Buzz — Prévost | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 5 décembre 2026 à 19 h 30, à Salle Saint-François-Xavier (Prévost). Un concert incarnant, avec sensibilité et humour, toute la magie des fêtes. Au programme: la Suite Casse‑Noisette de Tchaïkovski, Sainte Nuit, Promenade en traîneau (Sleigh Ride) et Les douze jours de Noël. Musiciens accomplis…"
      }
    ],
    "http://ogp.me/ns#url": [
