      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.fadoq.ca/wp-content/uploads/2025/08/img_6642-2-adapted-480x300.jpeg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://voir.lactualite.com/evenements/complet-atelier-buche-de-noel-automne-2026-446535"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://voir.lactualite.com/genid/dd915c2ef47a5bef"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/58f26099628a972f"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/complet-atelier-buche-de-noel-automne-2026-446535"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Atelier Bûche de Noël – Automne 2026"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "🥖✨Cette année, offrez-vous une expérience unique avant les Fêtes ! 🎄 Venez mettre la main à la pâte et découvrir les secrets de la boulangerie artisanale avec notre ateliers de bûche de Noël, offert par L’Atelier Sucré Salé 🍰 Vous apprendrez pas à pas les techniques pour réaliser une bûche digne des plus belles tables des Fêtes 👩‍🍳👨‍🍳 Que vous soyez débutant ou passionné de pâtisserie, cet atelier est fait pour vous ! 🎁 Le meilleur ? Vous repartez avec votre propre création à déguster en famille et entre amis, pour un Noël encore plus gourmand et mémorable ❤️👨‍👩‍👧‍👦 ✅ L’atelier comprend : 🧂 Tous les ingrédients 👨‍🍳 Un tablier 🧢 Un filet à cheveux ☕🍵 Café et thé sur place 🍰 Un plateau de dégustation 🍫 Au menu, deux gourmandises à réaliser : 🍫 Bûche au chocolat praliné — croquante, riche et irrésistible 🍓 Bûche à la vanille et aux fruits rouges — fraîche, légère et élégante 📅 Date : 12 décembre 🕘Heure: 13h00 à 16h00 📍 Lieu : 528, 10e Avenue, Laval, H7N 4E3 (à domicile) 💰 Prix : 95 $ par personne ⏳ Les places sont limitées ! Réservez vite votre place pour vivre une expérience culinaire chaleureuse et festive 🎅✨ 👉 On vous attend avec plaisir pour pétrir, rire et savourer ensemble ! 🥂"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
