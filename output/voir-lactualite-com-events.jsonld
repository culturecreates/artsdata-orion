    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Cabaret de la traverse"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le Cabaret de la traverse est une série de soirées consacrées à la poésie, à la littérature et à l'art performatif, lancée par Regart à l'occasion de son 40e anniversaire. Chaque soirée met en lumière des artistes invités et, selon la programmation, ouvre la scène à de nouvelles voix grâce à un micro ouvert. La série fait dialoguer les mots, les arts visuels et la performance, avec des artistes de la Rive-Sud et de la Rive-Nord. La soirée inaugurale accueille le spectacle « Cartes blanches transatlantiques », une collaboration entre Rhizome et la Maison de la poésie de Bordeaux, sous le signe du dialogue entre les disciplines artistiques."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
