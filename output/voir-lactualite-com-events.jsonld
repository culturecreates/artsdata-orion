    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "ART Lab 341"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le Théâtre de Lac-Brome est heureux d’accueillir ART Lab 341 qui présente, dans ses espaces, une exposition mettant en valeur les plus récentes œuvres de ses artistes. Véritable lieu collectif de création établi à Knowlton, ART Lab 341 rassemble des artistes de la région, dont le fondateur Michel Gamache, qui y développent leur pratique et contribuent au dynamisme culturel de Lac-Brome. Cette exposition offre au public l’occasion de découvrir une sélection d’œuvres récentes, témoignant de la richesse et de la diversité de leur démarche artistique."
      }
    ],
    "http://schema.org/eventStatus": [
