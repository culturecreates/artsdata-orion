    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Angélique Francis - Not Defeated"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Angelique Francis est une auteure-compositrice-interprète et multi-instrumentiste originaire d'Ottawa, connue pour son mélange de blues, soul, folk, jazz, gospel et rock. Son album Long River lui a valu le prix Juno du meilleur album blues, tandis que son plus récent opus, Not Defeated, met en vedette Christone « Kingfish » Ingram et Eric Gales. Elle a partagé la scène avec des artistes comme Gary Clark Jr, Beth Hart et Tom Cochrane, et s'est produite dans des festivals tels que le Festival International de Jazz de Montréal et l'Ottawa Jazz Festival. Le spectacle présenté ici reprend le matériel de l'album Not Defeated."
      }
    ],
    "http://schema.org/eventStatus": [
