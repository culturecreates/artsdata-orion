    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/cafe-avec-la-conservatrice-decouvrir-l-histoire-invisible-de-c52fb8"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Café avec la conservatrice : Découvrir l’histoire invisible des amulettes palestiniennes de la collection du Musée"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Découvrez le domaine de pointe de la recherche historique au Musée! Nos conservateurs sont à l’avant-garde de ces travaux révolutionnaires, que ce soit pour acquérir de nouveaux artéfacts, organiser des expositions ou participer à des projets de recherche mondiale. Là, on vous invite en coulisses! Venez nous rencontrer pour une causerie de 45 minutes à chacune de ces dates, où l’on vous donnera un aperçu exclusif de recherches parmi les plus captivantes auxquelles participe le Musée. Servez-vous du café ou du thé et profitez de conversations inspirantes avec nos experts. C’est une chance unique de plonger dans l’histoire comme jamais! Saeedeh Niktab Etaati, conservatrice, Diasporas et Communautés multinationales, et Lavina Li, Restauratrice d'objets Découvrir l’histoire invisible des amulettes palestiniennes de la collection du Musée Comment découvrir les récits que recèlent ces objets et artéfacts du XIXe siècle conservés dans les collections du Musée? Quels secrets les talismans palestiniens dissimulent-ils? Quelles formes de protection ou de pouvoirs spirituels leur attribuait-on? Joignez-vous à Saeedeh Niktab Etaati, conservatrice, Diasporas et Communautés multinationales, et et Lavina Li, Restauratrice d’objets, pour découvrir la collection d’amulettes palestiniennes du Musée canadien de l’histoire. Ce projet interdisciplinaire, qui combine la recherche anthropologique, l’analyse scientifique fondée entre autres sur l’imagerie par rayons X et la collaboration avec d’autres musées, révèle comment ces objets ont été fabriqués, utilisés et transmis d’une génération à l’autre, et comment leur signification évolue encore au sein des communautés diasporiques d’aujourd’hui. Présenté en anglais avec traduction simultanée par Wordly."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
