    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Au coeur de la bête — Mont-Laurier | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 18 octobre 2026 à 13 h, à Cinéma Laurier (Mont-Laurier). À la suite d’un écrasement d’avion catastrophique, l’officier des Forces Spéciales James Belmont (Brad Pitt) et son chien de combat, Odin, se retrouvent isolés en pleine nature, aux confins de l’Alaska. Du réalisateur réputé David Ayer…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://voir.lactualite.com/evenements/au-coeur-de-la-bete-72579d"
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
        "@value": "fr_CA"
      }
    ]
  },
