    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 22 novembre 2026 à 17 h, à Sommet Saint-Sauveur (Sainte-Marthe-sur-le-Lac). This Saturday, November 22, from 5 p.m. to 11 p.m., Sommet Saint-Sauveur kicks off the winter season with the APRÈS SKI PARTY presented by Coors Light! Starting at 5 p.m., enjoy a festive happy hour at the foot of the…"
      }
