    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Alphonse Bisaillon"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Alphonse Bisaillon est présenté comme une bête de scène et un poète. Dans un spectacle précédent intitulé t.o.m. ou la trajectoire des perséides, il plongeait dans son passé de garçon rural, interrogeant les modèles masculins offerts aux jeunes hommes. Six musicien.ne.s l'accompagnaient alors sur scène, mêlant jazz et dubstep au service des mots, dans un spectacle théâtral où le personnage de t.o.m., ami ou amour, incarnait ce que chaque homme peut devenir."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
