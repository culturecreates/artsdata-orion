    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Anniversaire Beethoven"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Pour souligner le 200e anniversaire de la disparition de Beethoven, Manuel Arango Pérez, Han-Jou Ku, Jessica Tovey, Sarah-Eve Vigneault, Léon Cyr et Ricardo Marzoratti Madriz s’unissent pour un projet spécial en hommage à ce grand compositeur. Au programme : Fantaisie op. 77, Quatuor à cordes en si bémol majeur et le Concerto pour piano no 2. Concert en soirée à 20 h"
      }
    ],
