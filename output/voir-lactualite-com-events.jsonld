    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Animé par Annie B artiste zen. Une invitation de fishNship.Atelier (22, rue Pierre-Côte) Allez à la rencontre des femmes et des archétypes qui vous habitent. Création d’un oracle. Inscription obligatoire. 107 $ + taxes. Matériel et support de création inclus. Informations : [email] ou [email]"
      }
