    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "50 ans de la Bottine à aujourd’hui!"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Escorté par 7 musiciennes et musiciens, Yves Lambert présente un spectacle généreux et festif. Une orchestration qui explore de nouvelles avenues harmonique et rythmique. À partir de son équipe de base, Robin Boulianne au violon, mandoline, podorythmie, Paul Audy à la guitare et Mathieu Royer à la contrebasse, s’ajoute Geneviève St-Pierre au clavier et une section de vent remplie de chaleur avec Mélanie Bourrassa à la clarinette basse et clarinette, Mary Chalk au basson, Gabriel Schwartz au saxophone, flûte traversière, piccolo et percussion. Monsieur Lambert propose avec le Grand Orchestre, un spectacle empreint de textures sonores affirmant toujours sa « québécitude » passionnée, ouverte, et créative."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
