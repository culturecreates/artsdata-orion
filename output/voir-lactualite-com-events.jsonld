    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Chloé Dumoulin (Nouveau!)"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "La pianiste Chloé Dumoulin, nommée par la CBC parmi les 30 meilleurs musiciens classiques canadiens de moins de 30 ans, poursuit une carrière internationale qui l'a menée au Canada, aux États-Unis, en Europe et en Asie. Elle s'est produite en récital, comme soliste et en musique de chambre, et a remporté le 3e Grand Prix du concours Prix d'Europe en 2024. En 2025, elle a obtenu un Artist Diploma avec distinction au Guildhall School of Music and Drama de Londres, où elle est Junior Fellow depuis septembre 2025. Ce concert est annoncé sous le titre « Chloé Dumoulin (Nouveau!) »."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
