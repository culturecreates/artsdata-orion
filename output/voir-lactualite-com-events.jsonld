  {
    "@id": "https://voir.lactualite.com/genid/3bfa44ac00cc2dbd",
    "@type": [
      "http://schema.org/EducationEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-04-25"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-04-25"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://voir.lactualite.com/genid/556b9a941fc34937"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://voir.lactualite.com/evenements/atelier-therapie-par-l-art-le-dessin-neurographique-9f6678"
      }
    ],
    "http://schema.org/offers": [
