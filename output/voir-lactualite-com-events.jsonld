    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Boucar Diouf"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Boucar Diouf est humoriste et conteur. Parmi ses spectacles figure Trois prédateurs et un bungalow, qui observe la cohabitation de l'humain, du chien et du chat autour d'un frigidaire. Le spectacle mêle biologie, histoire et culture pour raconter, avec humour et sensibilité, la place du chien et du chat auprès de l'humain."
      }
    ],
