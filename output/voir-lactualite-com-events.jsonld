      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/dans-l-temps-qu-on-riait-ba2bed"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Dans l'temps qu'on riait!"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Révélation du ComediHa! Fest 2023, Ouellet vous a déjà charmés en première partie de Jean-Michel Anctil… mais cette fois, il débarque avec SON spectacle: 100 % inédit, assumé et terriblement efficace. Sous la direction artistique de Jean-Michel Anctil et la mise en scène de Guy Lévesque, Ouellet présente Dans le temps qu’on riait, un show qui fait du bien. Une soirée où l’on décroche, où l’on franchit les barrières, où l’on oublie les jugements — et où on rit, pour vrai, comme dans l’temps."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
