    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Dessin et peinture"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Ce cours s’adresse aux personnes possédant déjà des bases en dessin et peinture (aquarelle ou acrylique) et désirant approfondir leurs connaissances artistiques. Il offre l’occasion de perfectionner sa technique, de développer son sens de l’observation et d’explorer de nouvelles facettes de l’art. Chaque séance proposera des sujets inspirants et des exercices adaptés à différents niveaux. Que vous préfériez l’aquarelle, l’acrylique ou le dessin, vous pourrez progresser à votre rythme dans une ambiance chaleureuse, détendue et stimulante. Matériel prêté lors des deux premières séances."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
