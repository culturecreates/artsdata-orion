    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Elliot Maginot"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Elliot Maginot est un auteur-compositeur-interprète dont la voix vibrante porte des compositions sensibles, teintées d'accents pop, folk, trad et country, entre ombre et lumière. Lors d'un spectacle précédent, accompagné de ses musiciens, il avait interprété les chansons de son album I Need To Stay Here et des pièces de ses trois opus antérieurs. Il a aussi partagé la scène avec Les soeurs Boulay, amies de longue date, dans un spectacle en version dépouillée, à trois voix."
      }
    ],
    "http://schema.org/eventStatus": [
