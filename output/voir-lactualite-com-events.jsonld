        "@id": "https://voir.lactualite.com/artistes/laura-schembri-6270bd#artist"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/ea2e8362cb862a5a"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/ariane-roy-af9f57"
