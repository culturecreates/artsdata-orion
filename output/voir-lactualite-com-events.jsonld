      {
        "@language": "fr-ca",
        "@value": "Carignan en couleurs — Carignan | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 17 octobre 2026 à 18 h, à Maison des générations Ginette-Grenier (Carignan). Pour sa 3e édition, l’événement se déroulera sous la couleur thématique « vert ». Carignan en couleurs c’est l’événement culturel de l’année célébrant le domaine culturel sous toutes ses formes ! Plusieurs activités…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://voir.lactualite.com/evenements/carignan-en-couleurs-a461a8"
      }
    ],
