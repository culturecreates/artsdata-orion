      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/atelier-de-danse-bouyei-avec-jie-0bd9ff"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Atelier de danse Bouyei avec Jie"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le 21 mai correspond à la Petite rondeur des graines, 8e terme solaire des 24 segments climatiques en Chine. Les grains des récoltes d’été commencent à être ronds. Cette date signifie métaphoriquement la récolte de recherche-création. Pour l’occasion, Jie Yu invite petits et grands à un atelier de danse Bouyei tel qu’il en a documenté l’essence dans l’exposition 12 tons d’indigo, afin de célébrer ensemble la fin de l’exposition."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
