    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Atelier pour les 11 ans et plus – Connais-tu ton manga?"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Découvrez l’univers des mangas avec Jean‑François Laliberté, cocréateur de la série Les Élus Eljun. Participez à une aventure remplie de défis et testez vos connaissances des séries populaires. Et le meilleur : vous pourrez laisser libre cours à votre imagination en créant votre propre planche de manga, comme un ou une véritable mangaka! Suivre les Bibliothèques de Laval sur les médias sociaux : Facebook YouTube Cette activité fait partie de la programmation du temps des fêtes des bibliothèques . Découvrez d’autres activités à faire dans les centres communautaires et quartiers. Voir la programmation complète du temps des fêtes ."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
