    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Émile Bilodeau - Bill aux Îles"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Émile Bilodeau, auteur-compositeur-interprète de 29 ans, revient avec de nouvelles chansons enregistrées devant le public des Îles-de-la-Madeleine à l'été 2024. Le résultat, « Bill aux Îles », est un album live en formule homme-orchestre, où des mélodies simples côtoient la complexité technique de maîtriser à la fois la percussion, l'enchaînement d'accords et les solos de musique à bouche. Les textes sont assumés, colorés et divertissants. Ce spectacle solo propose de découvrir l'univers de ce sixième album et de redécouvrir ses succès précédents, avec une ambiance visuelle à la hauteur de la création sonore."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
