    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 8 décembre 2026 à 18 h, à MA musée d'art (Rouyn-Noranda). Le MA vous invite à participer à une cérémonie du thé guidée par Jie Yu à l'occasion de l'équinoxe d'automne. Lors de cette cérémonie, vous allez rattraper la bonté de la journée Équinoxe d’automne. Lorsque le jour et la nuit retrouvent…"
      }
    ],
