    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Ce spectacle a eu lieu le lundi 2 novembre 2026 à 20 h, Espace St-Denis (Montréal). Adrian Belew, Steve Vai, Tony Levin et Terry Bozzio interprètent la musique…"
      }
    ],
