      {
        "@id": "https://static.billets.ca/artist/plp/h2/philippe-laprise-1200x750.avif"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://voir.lactualite.com/evenements/au-sommet-lp1-245"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://voir.lactualite.com/genid/a6a94710a5bdcf00"
      }
    ],
    "http://schema.org/performer": [
      {
