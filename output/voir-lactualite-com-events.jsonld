    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "AURA"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Depuis le 5 décembre 2025, AURA, l’expérience immersive créée par Moment Factory, se joue dans l’église Saint-Roch , 555, rue Saint-François Est, dans le quartier Saint-Roch, avec entrée par le parvis. La soirée se déroule en deux temps : un pré-spectacle de 15 minutes pour explorer l’église et son histoire avec une application Web, puis un spectacle de 30 minutes de projections, de jeux de lumière et de musique orchestrale sur la nef et les voûtes. Les séances commencent dès 17 h 30 et sont en vente jusqu’au 28 novembre 2026 sur la billetterie Fever ; l’organisateur annonce plus de 50 000 billets vendus et ajoute des dates par blocs (sources : auraeglisesaintroch.com et billetterie Fever, consultés le 2 octobre 2026). Tarifs plus taxes : 35 $ pour les 16 ans et plus, 22 $ pour les 5 à 15 ans, 30 $ pour les 65 ans et plus et 30 $ par billet pour les groupes de dix et plus ; gratuit pour les 4 ans et moins. Les billets ne sont ni remboursables ni échangeables, mais la date ou l’heure peut être modifiée jusqu’à 72 heures avant la représentation, selon les places. L’église a une entrée accessible aux personnes à mobilité réduite, aucun stationnement sur place et ne vend ni nourriture ni boisson."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
