    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "ATELIER DE LAINE FEUTRÉE"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Sur une période de quatre semaines, venez apprendre tous les secrets du feutrage de la laine à l’aiguille, en compagnie de l’artiste Félix Lapierre. En plus de vous apprendre les bases du feutrage, il vous accompagnera tout au long de la création de votre projet personnel. Matériel fourni. Aucun prérequis."
      }
    ],
