      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 30 octobre 2026 à 0 h, à Lieu à préciser – Mont-Laurier (Mont-Laurier). Plusieurs activités sur le thème de l’Halloween auront lieu les 30 et 31 octobre 2026 pour célébrer cette fête effrayante et amusante! Les détails de la programmation seront dévoilés prochainement. Restez à l’affût!"
      }
    ],
    "http://ogp.me/ns#url": [
