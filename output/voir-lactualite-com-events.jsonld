    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Atelier « À la rencontre de soi par l'écriture »"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dans la douceur, la tranquillité et le respect, cet atelier d’écriture axé sur la rencontre de soi, amène à la réflexion sur différents sujets permettant une expression libre et paisible. Les thèmes abordés sont l’occasion de poser un regard sur nos émotions, nos croyances et la beauté de notre être. Expression de soi par l’écriture permet de se découvrir et de partager. Un laisser-aller créatif à condition d’oser !"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
