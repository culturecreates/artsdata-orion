    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Atelier pour les 9 ans et plus – Faire un manga au Québec, ça s’peut"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Avec Jean‑François Laliberté, auteur de la série de livres Les Élus Eljun, découvrez les coulisses de la création d’un manga québécois, du concept au dessin, et comment le travail d’équipe donne vie à l’histoire. Grâce aux capsules vidéo de Sacha Lefebvre, mettez des astuces en pratique et créez vos propres illustrations de manga."
      }
    ],
