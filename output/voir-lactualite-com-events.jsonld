    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Choeurs en fête"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Les Chanteurs de la Place Bourget présente Choeurs en fête Événement en personne 6 décembre 2026 15h00 – 17h00 / Entrée: 14h15 Desjardins - Caisse de Joliette et du Centre de Lanaudière et Les Chanteurs de la Place Bourget présentent le concert des Fêtes, avec la participation de \"Les Petits Chanteurs de l'école Les Mélèzes\". Ils seront accompagnés par trois musiciens et leur pianiste, Jacques Giroux, sous la direction de Bruno Dufresne. Gratuit pour les 12 ans et moins"
      }
    ],
