    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Atelier de création | Projet mieux vivre"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "À l’occasion de la Journée mondiale contre la douleur, laissez place à la créativité pour exprimer ce qui ne se dit pas toujours avec des mots. Cet atelier de création en techniques mixtes (mixed media) vous invite à explorer couleurs, images et textures afin de donner forme à vos émotions. Dans une atmosphère chaleureuse et bienveillante, transformez votre vécu en une œuvre unique, porteuse de sens et d’expression. Une expérience artistique inspirante qui favorise le mieux-être, la réflexion et la créativité."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
