    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Arts en folie"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Les mardis, 13 h 30 à 16 h À la Bibliothèque Jean-Marc-Belzile Avec Kendy Murillo 16 ans ou plus Atelier en libre accès pour libérer sa créativité en bonne compagnie et s'initier à différentes formes d'art. Chacun apporte son matériel et son tablier. Certains matériaux seront disponibles pour expérimenter. Cette activité s’adresse autant aux débutants qu’aux artistes plus expérimentés. Aucune inscription requise • Gratuit Matériel non fourni Informations 311 ou [phone] En personne au comptoir du prêt"
      }
    ],
