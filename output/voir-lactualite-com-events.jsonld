        "@id": "https://voir.lactualite.com/evenements/charles-brunet-e7a4fc"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Charles Brunet"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Charles Brunet est un humoriste qui a présenté auparavant le spectacle « Très très bon show ». Dans ce spectacle, il se décrit à 24 ans comme quelqu'un qui ne comprend pas grand-chose à la vie, mais qui commence à comprendre son métier. Il y aborde un peu de tout, de TikTok à MSN, dans un propos qu'il veut rejoindre jeunes et vieux. Il le présente comme l'œuvre dont il est le plus fier de sa jeune carrière."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
