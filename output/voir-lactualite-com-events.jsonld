        "@id": "https://voir.lactualite.com/genid/b0290d6358b0e499"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://images.squarespace-cdn.com/content/v1/69151e0c45f5f1447986a9dc/eef5a1b0-e603-4f1f-93ed-758762423bfa/Photo+de+presse+Cathy+Gauthier"
