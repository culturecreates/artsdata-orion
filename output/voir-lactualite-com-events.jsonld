    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/283e92fd863e3cc9"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/andre-sauve-2f349a"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "André Sauvé"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Après trois spectacles à succès et un livre qui revisite ses premiers textes, André Sauvé fait un retour sur scène avec une création audacieuse où son regard unique sur le monde puise son inspiration dans la nature et ses mystères. Il nous livre ses observations dont chaque détail prend une dimension surprenante, ne voyant dans cette nature qui l'entoure qu’une métaphore de l’esprit humain. À travers ce voyage, il tisse un lien entre humour et poésie, explorant l’âme humaine à travers le prisme de son environnement. Humour et réflexion s’unissent dans cette expérience fidèle à la touche et au talent inimitable d’André Sauvé."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
