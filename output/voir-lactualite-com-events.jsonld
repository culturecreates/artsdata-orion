      {
        "@language": "fr-ca",
        "@value": "Charlie et le Moyen-Âge — Sainte-Adèle | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 23 juillet 2027 à 0 h, à Place des Citoyens Sainte-Adèle (Sainte-Adèle). Parachuté à l’époque des chevaliers de la Table ronde, Charlie rencontre la reine Guenièvre, prisonnière de son propre château, qui lui confie un message destiné au roi Arthur. Pour l’acheminer, Charlie devra se faire…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://voir.lactualite.com/evenements/charlie-et-le-moyen-age-a0e32e"
      }
    ],
