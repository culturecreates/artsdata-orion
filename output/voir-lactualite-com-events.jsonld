  {
    "@id": "https://voir.lactualite.com/genid/d2be06b5a6a42fc4",
    "@type": [
      "http://schema.org/MusicEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-03-20T20:00:00-04:00"
      }
    ],
