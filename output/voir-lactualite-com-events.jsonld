    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Candlelight : Les Classiques de Noël"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Célébrez la période la plus merveilleuse de l'année avec une collection de chants de Noël appréciés. Des chants intemporels aux favoris festifs, vivez les classiques de Noël avec ceux que vous aimez lors d'un concert chaleureux à la lueur des bougies. Cette expérience de concert est un hommage. Elle n'est ni associée, ni approuvée, ni sponsorisée par l'artiste, ses héritiers ou ses représentants officiels. Programme : Danse de la fée Dragée de Casse-Noisette - Tchaikovsky, Greensleeves, Carol of the Bells, O Holy Night, Mon beau sapin, We Wish You a Merry Christmas, Let It Snow! Let It Snow! Let It Snow!, Feliz Navidad - José Feliciano, Jingle Bells, Rockin' Around the Christmas Tree - Brenda Lee, Love is All Around - Wet Wet Wet, Libérée, délivrée de La Reine des neiges, Un beau jour de décembre de Anastasia - Stephen Flaherty, Maestro de Les Vacances - Hans Zimmer, It's Beginning to Look a Lot Like Christmas - Michael Bublé, Last Christmas - Wham!, All I Want for Christmas Is You - Mariah Carey. Artistes: Quatuor à cordes; 2 violonistes; 1 altiste; 1 violoncelliste."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
