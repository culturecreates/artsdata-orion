    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Beatles Story Band"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "De Love Me Do à (Just Like) Starting Over — un nouveau spectacle, un nouveau répertoire! Préparez-vous à replonger dans l’univers légendaire des Fab Four avec Orchestra 2, un spectacle unique qui vous fera revivre les plus grands moments des Beatles à travers un feu roulant de succès qui ont marqué l’histoire de la musique et pulvérisé tous les palmarès. Mais cette fois, l’aventure va encore plus loin! Pour la toute première fois sur scène, le Beatles Story Band vous propose de découvrir plusieurs grands titres issus des carrières solo de John Lennon, Paul McCartney, George Harrison et Ringo Starr. Une occasion exceptionnelle de redécouvrir ces artistes sous un nouveau jour, à l’époque où les Beatles ont cessé d’être les Beatles… et où quatre carrières légendaires ont pris leur envol. Des débuts électrisants de la Beatlemania aux incontournables de l’après-Beatles, Orchestra 2 vous entraîne dans un voyage musical riche en émotions, en souvenirs et en grandes chansons qui ont traversé les générations."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "en"
      }
