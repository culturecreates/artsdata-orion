      {
        "@id": "https://spectart.com/wp-content/uploads/2026/10/Daniel20Grenier_-P402fhvKTmVMrsTbZ25_.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://voir.lactualite.com/evenements/daniel-grenier-5273d1"
