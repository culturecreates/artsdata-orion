    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Billets à partir de 75$ Le Doc Show est un groupe musical composé de médecins et de professionnels de la santé talentueux qui se réunissent pour présenter un grand spectacle au profit de Parkinson Montréal-Laval. Pour son 10e anniversaire, le groupe a concocté un tout nouveau spectacle! Impossible de rester assis!"
      }
