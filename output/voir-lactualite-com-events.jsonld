      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Figure de proue de la guitare classique, Anabel Montesinos est de passage à la Salle Bourgie afin de partager sa fougue et sa sensibilité avec le public. Une occasion d'apprécier le talent de cette musicienne unique qui a partagé la scène avec le légendaire Paco de Lucía. En coproduction avec la Société de guitare de Montréal"
      }
    ],
