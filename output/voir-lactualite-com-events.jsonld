        "@id": "https://voir.lactualite.com/evenements/barka-7f734c"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "BARKA"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Gypsy Kumbia Orchestra Durée : 1 h 30, sans entracte Débutez l’année avec du cirque pour toute la famille! Tout public à partir de 7 ans. Barka est un spectacle où se rencontrent les arts du cirque, la danse et la musique par les créateurs du groupe Gypsy Kumbia. Dans un extraordinaire chaos festif, BARKA est une célébration de la vie et un appel à l'espoir et à la liberté responsable. Percussions afro-colombiennes, mélodies des Balkans, danse et cirque s'entremêlent joyeusement dans un spectacle rempli d'une énergie et d'une richesse sonore, visuelle et sensorielle délirantes. Nous nous trouvons tous et toutes dans un bateau. Explorateurs, migrants ou survivants, peu importe, nous sommes partis. Le voyage a commencé, chacun et chacune d'entre nous étant à la recherche de son rêve. Mais nous flottons ensemble en mouvement, alors qu'une grosse tempête est prévue à l'horizon. Faisons en sorte que notre bateau ne coule pas!"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
