      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Ouvert est le nouveau spectacle d'humour d'Alexandre Barrette. Il y aborde sa vie privée, un sujet qu'il dit habituellement garder pour lui, et s'y dévoile davantage que d'ordinaire. L'artiste annonce aussi que le public devrait beaucoup rire pendant la représentation."
      }
    ],
