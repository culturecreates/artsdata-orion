    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Chicane de Famille, le Pere"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "La comédie de boulevard à voir en famille ! Le quotidien vu avec beaucoup d’humour des enfants et des parents sur plusieurs générations ! Au travers des scénettes de la vie quotidienne d’une famille, le trio vous dresse un portait des plus réaliste. Car oui, il se passe la même chose dans toutes les maisons ! Alors comment survivre à sa famille ? Tout le monde se reconnaît et le sujet est traité avec tellement d’humour que les rires fusent ! De 7 à 77 ans, vous allez voyager dans le passé, le présent et le futur…"
      }
    ],
