    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 18 décembre 2026 à 14 h, à Lieu à préciser – Laval (Laval). Le FestivalOpéra de Saint-Eustache est heureux de présenter à nouveau des Concerts de Noël dans les Résidences des aînés. Nous aurons la joie de présenter cette année les talentueux artistes : LEILA CHALFOUN Soprano, ROBERT FALBY…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
