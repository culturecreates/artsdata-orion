      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://voir.lactualite.com/evenements/ballets-jazz-montreal-la-revue-finale-1e7d23"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://voir.lactualite.com/genid/f40a6b22a58171f8"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://voir.lactualite.com/artistes/ballets-jazz-montreal-344480#artist"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/56f964c3edf695e2"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/ballets-jazz-montreal-la-revue-finale-1e7d23"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "La revue finale"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Quand la vie vacille, il reste la beauté rugissante du mouvement. Ballets Jazz Montréal revient avec une création signée Jo Strømgren, maître des contrastes et des déchirures tendres. Dans cette fresque éclatée, 13 interprètes traversent l’ombre de la fin de vie pour célébrer la lumière des rencontres qui nous façonnent. Sur scène, une communauté se tisse, se défait, se retrouve. Sous le regard d’un fantôme sensible, les gestes deviennent des souvenirs en suspens, des élans qui racontent l’amour, l’amitié, la perte, et ces silences qui disent tout. Dans la voix comme dans les corps, tout vacille, tout vibre : la fête embrasse la mélancolie, la nostalgie flirte avec l’urgence de vivre, les au revoir sont tonitruants de renouveau. Les tableaux s’enchaînent dans des musiques imbibées de symboles, comme autant de battements de cœur : intimes, fougueux, vertigineux. La revue finale est une mer de lumière, un hommage cathartique à ce qui survit à l’oubli. Une traversée troublante et viscérale, où la danse devient un refuge, un rituel, une résistance, une joie finale sans compromis. Spectacle présenté avec la collaboration de La danse sur les routes du Québec, et en codiffusion avec Co-Motion. Pour vous! Une rencontre en bord de scène avec les artistes suivra la représentation."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
