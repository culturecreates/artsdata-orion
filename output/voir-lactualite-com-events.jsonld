  {
    "@id": "https://voir.lactualite.com/genid/0134438152335d08",
    "@type": [
      "http://schema.org/ComedyEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-02-03T20:00:00-05:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-02-03T23:00:00-05:00"
