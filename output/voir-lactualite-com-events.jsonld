    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le dimanche 28 février 2027, Théâtre Des Grands Chênes (Kingsey Falls). Mis en scène grâce à l’expérience country de musiciens chevronnés, le prestigieux…"
      }
    ],
