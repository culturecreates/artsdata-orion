    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "CED AUGER"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "CED AUGER AU BAR DE L’ENCAN! Le samedi 17 octobre, Ced Auger débarque au Bar de l’Encan pour un spectacle à ne pas manquer! Avec son univers entre folk-rock, pop et rap, ses textes vrais et son énergie sur scène, Ced Auger s’est bâti un public fidèle et sera avec nous pour une soirée complète en formule spectacle. ???? Un artiste invité surprise assurera la première partie Samedi 17 octobre Début du spectacle : 21 h Bar de l’Encan Billets : 30 $ Disponibles en ligne ou directement au bar Viens souper, prendre un verre et profiter d’une grosse soirée de musique live avec Ced Auger au Bar de l’Encan! Les places sont limitées — procure-toi tes billets à l’avance!"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
