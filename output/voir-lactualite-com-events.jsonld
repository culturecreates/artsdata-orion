      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Arbre"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Installez-vous confortablement dans votre nid douillet avec la maman oiseau qui couve ses œufs lumineux. Le monde magique de l’arbre s’ouvrira à vous avec ses insectes et ses animaux accompagnés de musiques douces ou rythmées. La lune se lèvera pour vous bercer avec ses étoiles et sa voie lactée pour vous donner la force de prendre votre envol comme un oisillon de lumière. ARBRE permet d’entrer dans un univers multisensoriel, pleinement interactif, enveloppé de lumière douce, de musique et aussi de silence, où cinq personnages interagissent avec les tout-petits.​ Ce projet est possible grâce au soutien financier du gouvernement du Québec et de la Ville de Laval dans le cadre de l’Entente de développement culturel."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
