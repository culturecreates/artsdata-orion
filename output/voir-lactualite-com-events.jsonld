    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 28 octobre 2027 à 20 h, à Théâtre Gilles-Vigneault (Saint-Jérôme). Dotée d’une audace et d’un franc-parler qui ne laisse personne indifférent, Cathy Gauthier s’impose depuis ses débuts comme une figure marquante de l’humour québécois. Forte de quatre one-woman-shows, elle maîtrise son art avec…"
      }
    ],
