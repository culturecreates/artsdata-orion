  {
    "@id": "https://voir.lactualite.com/genid/9bbc52d24db37408",
    "@type": [
      "http://schema.org/MusicEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-21T20:00:00-05:00"
