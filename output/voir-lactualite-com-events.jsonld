    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "2026 marque les 20 ans d’anniversaire de l’album culte « Voix de fait »"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Comité Musique Maisonneuve en partenariat avec le Lady Davidson ont l'honneur d'accueillir Manu Militari 2026 marque les 20 ans d’anniversaire de l’album culte « Voix de fait ». Sorti en 2006, cet album a consacré Manu Militari comme l’une des plumes les plus puissantes du rap québécois. Lauréat du Félix de l’album hip-hop de l’année à l’ADISQ, ce premier…"
      }
    ],
