    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 25 novembre 2026 à 20 h, à Maison de la culture de Gatineau (Gatineau). Après le succès phénoménal de la série de concerts Piano Man, qui a rassemblé plus de 150 000 spectateurs à travers le Québec au cours des dernières années, Christian Marc Gendron revient sur scène avec un tout nouveau…"
      }
    ],
