      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://voir.lactualite.com/genid/4eb6f377b56ca35b"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://tpos.s3.amazonaws.com/events/PBN/26/12/11/001/pbn261211001-1152x648-fr-6a6b967d.png"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://voir.lactualite.com/evenements/bye-parula-901933"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://voir.lactualite.com/genid/926b77188e733e13"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://voir.lactualite.com/artistes/bye-parula-17386b#artist"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/33c1c540655665b2"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/bye-parula-901933"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Bye Parula"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Formé alors que le monde était plongé dans les ténèbres de la pandémie, Bye Parula émerge de la quiétude imposée par la COVID avec un son authentiquement folk, mais subtilement funky, perpétuant les traditions montréalaises d'expérimentation indie-rock et de collaboration communautaire dans les années 2020. Sur leur premier album, I, sorti en 2023, le chanteur et bassiste Loïc Calatayud-Sola, le guitariste Sebastián Riquelme et le batteur Sergio D'Isanto ont cultivé une esthétique art-pop raffinée qui s'inscrit dans la lignée de personnalités excentriques de Montréal, telles que Patrick Watson (dont le percussionniste Robbie Kuster a produit l'album) et Plants and Animals (dont Warren Spicer a assuré l'ingénierie). Après que le single symphonique et sensuel « Still Got the Spirit » ait trouvé un public national en devenant la chanson thème de l'émission phare sur les arts et la culture de CBC Radio One, Q With Tom Power, le trio a continué à innover et à élargir son univers sonore, et à exploiter le dynamisme scénique qu'il a cultivé grâce à ses apparitions lors d'événements majeurs tels que le Festival International de Jazz de Montréal, Pop Montreal, M for Montreal, Suoni per il popolo, Festival du Canal Lachine, MOSAÏQ de Moncton et Reeperbahn Festival en Allemagne, ainsi que lors d'une tournée européenne à l'automne 2024. Avec la sortie de leur deuxième album en 2026, Something Out of Nothing, Bye Parula présente un mélange mercuriel qui s'inspire du funk orchestral de Serge Gainsbourg, des mélodies blessées d'Elliott Smith, des rythmes cosmopolites des Talking Heads et du R&B artisanal de Dijon, le tout imprégné d'une sensibilité cinématographique des années 70 qui brouille la frontière entre la fantaisie ensoleillée et floue ainsi que la sophistication urbaine. BYE PARULA Formé alors que le monde était plongé dans les ténèbres de la pandémie, Bye Parula émerge de la quiétude imposée par la COVID avec un son authentiquement folk, mais subtilement funky, perpétuant les traditions montréalaises d'expérimentation indie-rock et de collaboration communautaire dans les années 2020. Sur leur premier album, I, sorti en 2023, le chanteur et bassiste Loïc Calatayud-Sola, le guitariste Sebastián Riquelme et le batteur Sergio D'Isanto ont cultivé une esthétique art-pop raffinée qui s'inscrit dans la lignée de personnalités excentriques de Montréal, telles que Patrick Watson (dont le percussionniste Robbie Kuster a produit l'album) et Plants and Animals (dont Warren Spicer a assuré l'ingénierie). Après que le single symphonique et sensuel « Still Got the Spirit » ait trouvé un public national en devenant la chanson thème de l'émission phare sur les arts et la culture de CBC Radio One, Q With Tom Power, le trio a continué à innover et à élargir son univers sonore, et à exploiter le dynamisme scénique qu'il a cultivé grâce à ses apparitions lors d'événements majeurs tels que le Festival International de Jazz de Montréal, Pop Montreal, M for Montreal, Suoni per il popolo, Festival du Canal Lachine, MOSAÏQ de Moncton et Reeperbahn Festival en Allemagne, ainsi que lors d'une tournée européenne à l'automne 2024. Avec la sortie de leur deuxième album en 2026, Something Out of Nothing, Bye Parula présente un mélange mercuriel qui s'inspire du funk orchestral de Serge Gainsbourg, des mélodies blessées d'Elliott Smith, des rythmes cosmopolites des Talking Heads et du R&B artisanal de Dijon, le tout imprégné d'une sensibilité cinématographique des années 70 qui brouille la frontière entre la fantaisie ensoleillée et floue ainsi que la sophistication urbaine. Le stationnement est gratuit dès 18h au centre-ville."
      }
    ],
