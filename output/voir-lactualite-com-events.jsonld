    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Boucar Diouf - Trois prédateurs et un bungalow"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dans Trois prédateurs et un bungalow, Boucar Diouf raconte la cohabitation de l'humain, du chien et du chat autour d'un même frigidaire. Le spectacle mêle biologie, histoire et culture pour évoquer, avec humour et sensibilité, la place du chien et du chat auprès de l'humain. Boucar Diouf se présente comme humoriste et conteur, et le spectacle s'inscrit dans ce registre."
      }
    ],
