    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/a-petits-pas-dans-les-contes-3b976f"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "À petits pas dans les contes"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Vous souhaitez initier vos tout-petits au merveilleux monde des livres ? Joignez la Maison de la famille du Mont-Bruno qui vous propose une activité parent-enfant chaque lundi à la bibliothèque ! Vos enfants découvriront le plaisir de la lecture en votre compagnie et pourront rencontrer de nouveaux amis. Cette heure du conte est animée par une éducatrice et une bénévole de la Maison de la famille du Mont-Bruno. Elles lisent de courtes histoires, proposent des bricolages et préparent différentes activités amusantes adaptées à l’âge des enfants. Aucune inscription requise"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
