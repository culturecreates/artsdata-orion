    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le mercredi 25 novembre 2026 à 17 h, Centre communautaire Régent-Martimbeau (Laval). Comment le travail industriel a-t-il sculpté le quartier Vimont ? Au début…"
      }
