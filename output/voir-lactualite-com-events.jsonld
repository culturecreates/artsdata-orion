    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "CÉLÉBRATION D'ANIMATION - (1920 à 2026, 120 min, 16mm/35mm) - Artistes divers·es"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Des courts-métrages d'animation internationaux époustouflants, de l'époque muette du crayon à l'ère moderne des pixels. La crème de la crème des archives du CFS. Précédé d'une sélection d'œuvres récentes exceptionnelles réalisées par des animatrices locales. Billets non-remboursables. Astounding animated international shorts from the silent era of pencils to the modern era of pixels. The best of the best from the CFS archives. Preceded by a showcase of brilliant recent works by local female animators. Tickets non-refundable. Des courts-métrages d'animation internationaux époustouflants, de l'époque muette du crayon à l'ère moderne des pixels. La crème de la crème des archives du CFS. Précédé d'une sélection d'œuvres récentes exceptionnelles réalisées par des animatrices locales. Billets non-remboursables. Astounding animated international shorts from the silent era of pencils to the modern era of pixels. The best of the best from the CFS archives. Preceded by a showcase of brilliant recent works by local female animators. Tickets non-refundable."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
