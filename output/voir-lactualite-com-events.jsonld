      }
    ]
  },
  {
    "@id": "https://voir.lactualite.com/genid/58954155d40cb6bc",
    "@type": [
      "http://schema.org/ExhibitionEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-10-22T00:00:00-04:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-10-22T23:59:00-04:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://voir.lactualite.com/genid/da3acf2c358b60df"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://s3.ca-central-1.amazonaws.com/mnbaq-assets/production/Programmation/Expositions/Art-et-emotions/p1_1968.112_1995.285_2025.73_2025.67.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://voir.lactualite.com/evenements/art-et-emotions-cf7fe8"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://voir.lactualite.com/artistes/riopelle-47fc7e#artist"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/ab6038bc121a9e7d"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/art-et-emotions-cf7fe8"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Art et émotions"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Conçue selon une approche favorisant une rencontre intime avec Jean Paul Riopelle, la nouvelle salle d’exposition temporaire privilégiera l’émotion comme fil conducteur. Art et émotions proposera une expérience hautement humaine et sensible, à l’image du rapport que l’artiste entretenait avec ses proches. L’aventure s’ouvrira sur des témoignages vidéo de Michael Audain – le principal mécène de l’Espace Riopelle – et de différentes personnes qui ont croisé la route de l’artiste à divers moments de sa vie et de sa carrière. Intimes, amis et autres connaissances nous racontent Riopelle, en faisant part de souvenirs et d’anecdotes, offrant ainsi aux visiteuses et aux visiteurs une perspective différente, ponctuée de confidences tant sur l’artiste que sur l’homme. Quand l'émotion se met au service de l'art Cette exposition mettra aussi en vedette un projet de recherche inédit sur les émotions ressenties au Musée, réalisé en collaboration avec le laboratoire Co-DOT, affilié à l’École de psychologie de l’Université Laval. Cette initiative vise à mieux comprendre les réponses émotionnelles suscitées par les œuvres d’art et à concevoir de nouveaux outils pour personnaliser les parcours d’exposition grâce à l’intelligence artificielle. Un espace d'expérimentation Dans ce contexte, la salle deviendra un véritable espace d’expérimentation conçu à partir d’une dizaine d’œuvres de Riopelle. Cette activité ludique et participative permettra aux visiteuses et aux visiteurs de contribuer activement à la recherche en temps réel. À l’aide de dispositifs interactifs intégrés au fil de l’exposition, les participantes et les participants seront invités à exprimer ce qu’ils ressentent devant les œuvres. Cette enquête permettra de mesurer leur réponse face au travail d’un artiste qui accordait une place prépondérante à l’intuition et au sentiment dans son processus créatif. En offrant une approche plus holistique, sollicitant le public de manière active, le projet de recherche Art et émotions s’inscrira dans une démarche muséale des plus novatrices. Le projet de recherche Art et émotions et son déploiement dans la salle Initiatives ont été rendus possibles grâce au soutien du Secrétariat à la Capitale-Nationale, dans le cadre de l’Incubateur d’innovations muséales."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
