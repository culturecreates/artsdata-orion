    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Ces gestes qui explorent et témoignent"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Une série de carnets d’artiste mêlant création, mémoire et émotion. Chaque œuvre est accompagnée d’un code QR donnant accès à une vidéo du processus créatif. Vernissage le 25 février, de 17 h à 19 h. Les vernissages se dérouleront en présence des artistes. Des bouchées et des boissons seront servies."
      }
    ],
    "http://schema.org/eventStatus": [
