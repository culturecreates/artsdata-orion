    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 22 octobre 2026 à 20 h, à Davidson Taverne (Montréal). Comité Musique Maisonneuve en partenariat avec le Lady Davidson ont l\\'honneur d\\'accueillir Manu Militari 2026 marque les 20 ans d’anniversaire de l’album culte « Voix de fait ». Sorti en 20"
      }
