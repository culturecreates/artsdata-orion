      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 22 octobre 2026 à 18 h 30, à Centre communautaire Villa-Mont-Joie (Lachute). Ce film d'Annie Deniel retrace l’histoire méconnue de la Jeunesse Ouvrière Catholique (JOC), un mouvement ouvrier ancré dans les quartiers populaires du Québec depuis les années 1930. La projection sera suivie d’une…"
      }
    ],
