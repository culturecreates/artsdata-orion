        "@value": "fr_CA"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://legesu.com/wp-content/uploads/2026/09/Charles-Pellerin_Credit-Camille-Gladu-Drouin_695×380.jpg"
      }
    ]
  },
  {
    "@id": "https://voir.lactualite.com/genid/92c3afd5c5af06ca",
    "@type": [
      "http://schema.org/ComedyEvent"
    ],
