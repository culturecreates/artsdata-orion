    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Atelier pour les 11 ans et plus – Création d’un carnet artistique avec Gabrielle Morrisseau – Aquarelle, techniques et explorations"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Découvrez les techniques de base de l’aquarelle à travers des exercices ludiques : lavis, dégradés, sel, textures et motifs. Explorez, expérimentez et amusez-vous avec la couleur pour créer une série d’essais visuels uniques. Vous repartirez avec des créations à conserver précieusement dans votre carnet."
      }
    ],
