    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Après on va où ?"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Après on va où ? est un spectacle où Michel Rivard assure le texte, les chansons et l'interprétation. Pendant deux semaines, le temps de la floraison d'un magnolia, « l'homme qui me ressemble », âgé de 74 ans, s'interroge sur sa vie, avant et après la mort, en confrontant ses doutes et ses certitudes. Entre un rendez-vous médical et le choix d'une urne, entre un premier amour et une marche en forêt avec son petit-fils, il monologue, poétise et chante sa recherche du « plus-grand-que-soi ». Les musiciens François Richard, Blanche Baillargeon et Guillaume Bourque participent à la création, mise en scène par Marie-Thérèse Fortin. La production est celle de La maison fauve, créée en collaboration avec le CTD'A."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
