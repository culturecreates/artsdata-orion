    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Astral Coyote"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le duo mexicain-québécois Astral Coyote est né d’une volonté de mêler les sonorités de la cumbia à l’éclectisme de la musique électronique. Ils cherchent à intégrer un psychédélisme envoûtant aux rythmes caractéristiques de la cumbia. Des synthétiseurs éthérés s’entremêlent à des voix oniriques, oscillant entre l’ombre et la lumière, entre le monde tangible et le mystique."
      }
    ],
