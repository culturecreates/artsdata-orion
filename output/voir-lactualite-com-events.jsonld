      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/conference-preconcert-decouvertes-astronomiques-et-musique-d-397bcc"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Découvertes astronomiques et musique du concert"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Les découvertes astronomiques abondent notamment grâce aux télescopes de plus en plus performants. Afin de mieux comprendre les récentes découvertes sur les exoplanètes, les galaxies lointaines, la face cachée de la lune et la vie (im)probable sur Mars, le musicologue Louis Brouillette interviewera Farid Gharibeh, vulgarisateur scientifique de l’ASTROLab du Parc national du Mont-Mégantic. Ensemble, ils donneront également des clés de compréhension de l’expérience visuelle et musicale que vivront les spectateurs lors du concert Les Planètes de Holst : Un voyage cosmique immersif."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
    "http://schema.org/eventStatus": [
      {
