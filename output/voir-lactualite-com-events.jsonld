    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "PHENOMENA - Cabaret féministe pas gentil du tout V —… | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 19 octobre 2026 à 20 h, à Sala Resto (Montréal). J’hérite cette année d’un des rendez-vous les plus réjouissants de Phénomena: le Cabaret féministe pas gentil du tout. Depuis quatre éditions, Kimm y a réuni des femmes et des personnes aux voix fortes, libres et impertinentes pour parler sans…"
      }
    ],
