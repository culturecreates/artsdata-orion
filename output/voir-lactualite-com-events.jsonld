      }
    ]
  },
  {
    "@id": "https://voir.lactualite.com/genid/54031de2fddee794",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-10-29T19:00:00-04:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-10-29T22:00:00-04:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://voir.lactualite.com/genid/f683045d4fb328c8"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.laval.ca/wp-content/uploads/2026/09/enseignes-lumineuses-1216x516-1-420x235.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://voir.lactualite.com/evenements/causerie-les-enseignes-lumineuses-dans-le-paysage-moderne-de-9974d9"
      }
