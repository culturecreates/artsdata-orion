    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 13 avril 2027 à 19 h 30, à Théâtre du Vieux Terrebonne (Terrebonne). Club sandwich mayonnaise est une pièce de Manuelle Légaré, qui en est l'autrice et l'interprète aux côtés de Sylvie De Morais-Nogueira, Alice Pascual et Martin-David Peters. La mise en scène est signée François Bernier. Le…"
      }
