    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Du Grand Écran à la Symphonie"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le 25 février, dès 9 h, café et viennoiseries vous sont offerts par Chartwell, résidences pour retraités. À 9 h 30, rencontrez une musicienne ou un musicien de l’Orchestre lors d’une causerie conviviale animée par Isabelle Lépine, coordonnatrice de l’administration artistique et adjointe au directeur musical. Une occasion de découvrir les moments marquants de leurs parcours et les secrets de leur instrument."
      }
    ],
