    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Bienvenue bébé"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Une comédie de Sara Karel Chiasson et Mathieu Lepage. Dans une mise en scène de OLIVIER MORIN. Bienvenue bébé, c’est LA comédie douce-amère qui manquait au théâtre d’été québécois. Dans un décor aussi banal que symbolique — un salon transformé en terrain de \"shower de bébé\"— six personnages se retrouvent coincés entre les couches écologiques, les opinions non sollicitées et les vérités qu’on préfère taire en famille. Ça parle de ce que vivent les parents aujourd’hui, sans filtre, mais avec une bonne dose de tendresse et de second degré. Bienvenue bébé, c'est un bain de famille! C’est drôle. C’est cru. C’est touchant, mais il ne faut pas jeter le bébé avec l’eau du bain!"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
