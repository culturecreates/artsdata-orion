    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Au sommet"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "L’humoriste, Philippe Laprise, présentera son spectacle « Au sommet », le jeudi 22 avril 2027, à 20 h, au Centre culturel Berger. Dans ce spectacle solo, il se questionne sur ce que c’est réellement être au sommet à notre époque où tout évolue rapidement. Maintenant rendu à un âge « presque » vénérable, il s’assume et n’a plus rien à perdre. Il présente donc « Au sommet », un spectacle sans filtre mais toujours avec une bonne dose d’autodérision. La route vers le sommet est longue, surtout quand l’intérieur des cuisses frotte ensemble, alors partons tous maintenant et suivons Philippe au sommet!"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
