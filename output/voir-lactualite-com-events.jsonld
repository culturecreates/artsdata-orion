    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Charles Pellerin en rodage"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Toujours dans une approche autobiographique intimiste, découvrez comment il explore la question de l’identité et de l’estime à travers une grande histoire, celle de son passage vers la vie adulte. Selon ses dires, il y a des maudites bonnes blagues là-dedans, peut-être même ses meilleures."
      }
    ],
