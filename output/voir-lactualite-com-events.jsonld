      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/4267c38aad721e75"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/3-et-moi-9ca7aa"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "3 et moi"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Bruno Pelletier présente « 3 et moi », un spectacle musical dans lequel il revisite des chansons marquantes de sa carrière, comme Coriace, Ailleurs c'est comme ici ou Le temps des cathédrales, ainsi que des classiques qui l'ont personnellement inspiré, de Supertramp à Elvis Presley, en passant par The Beatles et Grease. Il est accompagné de Martin Bachand à la guitare, de Claude Pineault, multi-instrumentiste, et de Brigitte Marchand au chant."
      }
    ],
