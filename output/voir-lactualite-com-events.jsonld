    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/buzz-cuivres-lp9-192"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Buzz Cuivres"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Plongez dans un univers où la musique et le conte se fusionnent pour vous offrir une expérience inoubliable! Buzz Cuivres, quintette de grande réputation, vous invite à découvrir un spectacle unique en son genre. Cette toute nouvelle création vous entraîne dans une multitude d’univers littéraires et cinématographiques, soutenue par une trame musicale qui parcourt plus de 400 ans d’histoire. Du classique au jazz, en passant par la musique de films et de jeux vidéo, suivez la quête de la petite Alexandra depuis les légendes du roi Arthur à Camelot jusqu'aux enquêtes de Sherlock Holmes; du navire des Pirates des Caraïbes au vaisseau de La Guerre des étoiles; du monde des superhéros à celui des agents secrets; des romans de J.K. Rowling à ceux de J.R.R. Tolkien — les périlleuses péripéties de notre Plume vous plongeront dans l'imaginaire du fantastique ! Depuis sa fondation en 2002, Buzz Cuivres a offert près de 2 000 représentations, rejoignant plus de 500 000 mélomanes en Amérique du Nord, en Europe et en Chine. Grâce à ses programmes innovateurs, ses enregistrements méritoires, son répertoire unique et sa vision des concerts classiques qui touche un large public, notamment les jeunes, l'ensemble figure aujourd’hui parmi les quintettes de cuivres les plus réputés du Canada."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
