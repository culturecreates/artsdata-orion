      }
    ]
  },
  {
    "@id": "https://voir.lactualite.com/genid/ae0ce2f8e4093123",
    "@type": [
      "http://schema.org/ScreeningEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-10-30T00:00:00-04:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-10-30T23:59:00-04:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://voir.lactualite.com/genid/136d2f830cf481b3"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://static.wixstatic.com/media/87a8ed_00c0faaa993d45ef9a3ae2b92d9885a2~mv2.jpg"
      }
    ],
    "http://schema.org/url": [
      {
