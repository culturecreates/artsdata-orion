      {
        "@id": "https://voir.lactualite.com/evenements/a-corps-vins-5799c3"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "À corps & vins"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "À corps et vins transforme la salle de spectacle en un terroir éphémère, où vin et danse se rencontrent dans une expérience immersive. Guidés par un sommelier chevronné, les spectateurs découvrent une sélection de crus soigneusement choisis, chacun associé à une création chorégraphique. Sur scène, quatre interprètes traduisent les arômes et les textures du vin en gestes et en mouvements, tandis que le public, confortablement installé, déguste et observe. De la fraîcheur minérale d’un blanc au bouquet ample et capiteux d’un rouge, la soirée parcourt un éventail d’émotions sensorielles. Le croquant d’un pas vif, la rondeur d’un port de bras, la profondeur d’un regard : chaque moment est une alliance entre la saveur en bouche et l’énergie des corps. Ici, l’art du vin dialogue avec celui de la danse pour créer un voyage unique, à savourer autant avec les papilles qu’avec les yeux."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
