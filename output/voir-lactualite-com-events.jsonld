    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "BEGOTTEN Un film de E. Elias Merhige"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Nouvelle restauration 4K ! BEGOTTEN ne possède aucun personnage au sens conventionnel du terme. Trois figures seulement à son générique : Dieu se tuant lui-même, Mère Nature et Fils de la Terre. Le film tout entier se résume à ce que ces noms se font subir les uns aux autres ainsi qu’à la terre. Dieu se tuant lui-même s’éventre et meurt. Mère Nature surgit de ce qu’il reste et recueille sa semence en elle. Elle donne naissance au Fils de la Terre. Ce dernier est jeté dans un monde stérile, capturé par les Nomades, torturé, tué, puis brièvement ramené à la vie par sa mère. Les Nomades la détruisent elle aussi. Les Silhouettes en robe rassemblent les restes de la mère et du fils, broient leurs corps et les restituent au sol. La terre fleurit. États-Unis, 1989, 1h12, version originale sans dialogues"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
