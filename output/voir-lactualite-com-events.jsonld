      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/125-rue-des-malaises-lp9-3"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "125, Rue des Malaises"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Suivie d’une discussion par visioconférence avec le cinéaste Tourné en blocs étalés sur plusieurs mois, campé dans un seul lieu et laissant libre cours à l’improvisation des comédiens, ce film a été produit sans l’apport financier des institutions publiques. Les « mises en situation » (le scénario n’est pas crédité) évoquent les efforts d’un septuagénaire ayant choisi l’aide médicale à mourir, résolu à partir en ayant trouvé le pardon auprès de sa fille à qui il a toujours menti et de son fils illégitime qu’il n’a jamais soutenu. Alternant entre saynètes comiques et longs monologues mélancoliques, 125, rue des Malaises traite de sujets sérieux, tels que la dignité dans la mort et la finitude volontaire. Le film accorde également une place prépondérante aux relations humaines et aux liens familiaux, souvent marqués par des non-dits."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
