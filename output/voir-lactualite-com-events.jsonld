      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "BMX Spectacle"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Trois athlètes de BMX ayant grandi à Montréal. Leur passion pour ce sport les a conduits à créer un numéro qu’ils ont présenté au cours des cinq dernières années en tournant avec le spectacle Volta du Cirque du Soleil. Avec l’introduction du BMX aux Jeux Olympiques, ils ont tous les trois rejoint leurs équipes nationales respectives et participent désormais à des compétitions à travers le monde."
      }
    ],
    "http://schema.org/eventStatus": [
