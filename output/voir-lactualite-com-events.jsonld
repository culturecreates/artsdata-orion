  {
    "@id": "https://voir.lactualite.com/genid/a102566c6e3dc895",
    "@type": [
      "http://schema.org/EducationEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-12-12T10:00:00-05:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-12-12T13:00:00-05:00"
      }
    ],
