    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Trois prédateurs et un bungalow — Laval | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 31 octobre 2026 à 0 h, à Salle André-Mathieu (Laval). Nos bungalows sont le théâtre d'une cohabitation singulière entre trois prédateurs, réunis autour d'un frigidaire. Si l'humain et le chien cherchent naturellement la compagnie des autres, le chat tend à être plus solitaire. Comme l'a si bien…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://voir.lactualite.com/evenements/boucar-diouf-trois-predateurs-et-un-bungalow-8dc0cd"
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
        "@value": "fr_CA"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://co-motion.ca/uploads/Spectacles/_500x9999_fit_center-center_99_none/Boucar-Diouf.jpg"
      }
    ]
  },
  {
    "@id": "https://voir.lactualite.com/genid/f04bd4c08473c3d2",
