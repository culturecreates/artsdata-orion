    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "André Larue quartet"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Avec cet ensemble, le saxophoniste André Larue vous propose un spectacle dont le fil conducteur est la spontanéité. Grâce à une grande écoute réciproque développée au fil de nombreuses années de collaborations, chaque musicien déploie des solos inventifs dans un style chaleureux ou prédomine le swing. Au programme une sélection de musiques raffinées et accessibles : standards revisités, compositions des grands maîtres du jazz, emprunts au répertoire populaire et quelques créations originales."
      }
    ],
    "http://schema.org/eventStatus": [
