        "@id": "https://voir.lactualite.com/genid/62be59ea58b558aa"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://voir.lactualite.com/artistes/martin-drainville-451d56#artist"
      },
      {
        "@id": "https://voir.lactualite.com/artistes/benoit-briere-84e6c9#artist"
      },
      {
        "@id": "https://voir.lactualite.com/artistes/luc-guerin-85fc0b#artist"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/54227a711bc0e3b2"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/broue-9dba53"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Broue"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Depuis la toute première représentation qui a eu lieu le mercredi 21 mars 1979, l’histoire d’amour entre le public québécois et Broue aura duré presque 39 ans sans interruption. Cette pièce de théâtre a dépassé depuis longtemps le simple statut de divertissement et de comédie pour devenir un véritable objet de fierté nationale. Car Broue a fracassé de nombreux records. Ses personnages hauts en couleur font partie de notre imaginaire collectif, dans un portrait d’un Québec pré-référendaire, à la veille d’une invasion qui menace leur aire protégée : l’arrivée des femmes dans ce lieu sacro-saint qu’est… la Taverne ! Bob, Pointu, Verrue, Travolta et tous les autres continueront de vivre et de vous faire rire. Nous vous invitons donc cher public à poursuivre l’aventure avec nous. Vous êtes tous cordialement invités à venir ou revenir lever votre verre à la Taverne chez Willy ! Et… Bienvenue aux dames !!! La Nouvelle administration : Benoît Brière, Luc Guérin et Martin Drainville Texte : Claude Meunier, Jean-Pierre Plante, Louis Saia, Francine Ruel, Michel Côté, Marc Messier et Marcel Gauthier Interprétation : Martin Drainville, Benoît Brière et Luc Guérin · Production déléguée: Guy Côté · Assistance à la mise en scène: Pascale D’Hease · Décor : Jean Bard · Costumes : Judy Jonker · Musique: Christian Thomas · Éclairages : Nicolas Ricard · Accessoires : Julie Measroch · Perruques et coiffures: Carol Gagné · Crédit Photo : Michel Pilon"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
