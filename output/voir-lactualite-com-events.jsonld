    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "ABBA CELEBRATION"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Spectacle célébration du 110e anniversaire du Théâtre St-Denis En cette année de célébration, en octobre 2026, ce spectacle met en lumière tout le potentiel de l’Espace St-Denis grâce à une formule hybride alliant souper-spectacle, musique et divertissement, conçue pour rassembler toutes les générations. Vous voyagez l’âme euphorique avec le coeur léger. Au coeur d’un village ludique blanc et bleu, les statues grecques trônent sur leur quartier. LE SOUPER EST AU COEUR DE L’EXPÉRIENCE DU SPECTACLE!"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
