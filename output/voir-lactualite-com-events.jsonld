      }
    ]
  },
  {
    "@id": "https://voir.lactualite.com/genid/f876b1542cc821f7",
    "@type": [
      "http://schema.org/DanceEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-14T20:00:00-05:00"
      }
    ],
