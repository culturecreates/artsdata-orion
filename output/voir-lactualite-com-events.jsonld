    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 25 octobre 2026 à 0 h, à The Wiggle Room (Montréal). Are you ready for a night of vicious revenge? Lust filled, hot blooded, and absolutely gleaming with evil desires, join us for one night only and see Attack of the Evil Femmes live and in your face."
      }
    ],
