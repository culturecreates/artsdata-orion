  {
    "@id": "https://voir.lactualite.com/genid/6ab53349ed4e1154",
    "@type": [
      "http://schema.org/ScreeningEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-21T14:00:00-05:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-21T17:00:00-05:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://voir.lactualite.com/genid/9efe761efe4500eb"
      }
    ],
    "http://schema.org/url": [
