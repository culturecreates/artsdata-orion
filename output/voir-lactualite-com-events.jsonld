    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Conte d'Halloween avec Cynthia Godbout"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "À l'occasion de l'Halloween, Cynthia Godbout invite les familles à plonger dans un univers d'histoires inédites où le conte et le théâtre se rencontrent. Grâce à son énergie et à sa galerie de personnages hauts en couleur, chaque séance devient une aventure interactive remplie de surprises. En participant à cette activité, vous courrez la chance de gagner une paire de billets pour le spectacle familial Les trois petits vieux qui ne voulaient pas mourir."
      }
    ],
