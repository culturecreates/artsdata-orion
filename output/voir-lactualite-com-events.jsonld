      }
    ]
  },
  {
    "@id": "https://voir.lactualite.com/genid/0526c99b88598843",
    "@type": [
      "http://schema.org/MusicEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-13T20:00:00-05:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-13T23:00:00-05:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://voir.lactualite.com/genid/fbe439aaa5241591"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://tpos.s3.amazonaws.com/events/CBX/26/11/13/001/cbx261113001-1152x648-fr-6a8c8674.png"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://voir.lactualite.com/evenements/andie-therio-nomade-lancement-spectacle-bab634"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://voir.lactualite.com/genid/b50fab0c4af8d75a"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://voir.lactualite.com/artistes/andie-therio-691fb9#artist"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/4c3af47fe8da4353"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/andie-therio-nomade-lancement-spectacle-bab634"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "ANDIE THERIO // NOMADE Lancement-spectacle"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "En pleine montée sur la scène émergente québécoise, Andie Therio présente Nomade, un spectacle à la croisée du country, du pop et du folk. Accompagnée de son groupe, elle propose un mélange de chansons originales inspirées de son vécu et de reprises de ses influences musicales. Avec sa fougue à la Ella Langley et son style unique qui rappelle Tenille Townes, Andie se démarque par une présence scénique authentique et spontanée. À travers ses compositions et quelques classiques nostalgiques revisités à sa façon, elle invite le public dans son univers, quelque part entre énergie, émotion et plaisir de partager la musique. Nomade ouvre ainsi la voie à un nouveau chapitre pour Andie Therio, alors qu'elle s'apprête à lancer son tout premier album en français. Originaire de Beauharnois, Andie Therio a grandi avec une guitare jamais bien loin. Influencée par le country, le pop-rock et le folk. Auteure-compositrice-interprète autodidacte, elle fait ses débuts officiels à l'été 2022 avec She's Good. Ce projet lui permet de se faire connaître rapidement et de jouer sur de grandes scènes comme Festival Country Lotbinière, le Festival Lasso Montréal et le Festival Western de St-Tite. À l'automne 2023, elle présente Back To You, son premier album complet composé de sept chansons originales. Andie fait le tour du Québec avec sa tournée Back To You en 2024 et 2025 puis obtient le troisième prix du programme RBC pour les musiciens émergents de Canada's Walk of Fame 2025. Jusqu'en 2027, Andie assurera les premières parties de Clement Jacques dans le cadre de sa tournée IRIS. Elle prépare maintenant son tout premier album en français, une nouvelle ère artistique aux couleurs bohèmes et lumineuses. Les chansons « Nomade », « Dernier mot », « Danser ici » et « Beau temps » marquent le début de ce projet porté par l'amour de soi, la spontanéité et la légèreté, qui met de l'avant une Andie plus assumée que jamais. Remboursements Aucun remboursement Accès pour personnes à mobilité réduite Oui Gratuité pour l'accompagnateur Oui En pleine montée sur la scène émergente québécoise, Andie Therio présente Nomade, un spectacle à la croisée du country, du pop et du folk. Accompagnée de son groupe, elle propose un mélange de chansons originales inspirées de son vécu et de reprises de ses influences musicales. Avec sa fougue à la Ella Langley et son style unique qui rappelle Tenille Townes, Andie se démarque par une présence scénique authentique et spontanée. À travers ses compositions et quelques classiques nostalgiques revisités à sa façon, elle invite le public dans son univers, quelque part entre énergie, émotion et plaisir de partager la musique. Nomade ouvre ainsi la voie à un nouveau chapitre pour Andie Therio, alors qu'elle s'apprête à lancer son tout premier album en français. Originaire de Beauharnois, Andie Therio a grandi avec une guitare jamais bien loin. Influencée par le country, le pop-rock et le folk. Auteure-compositrice-interprète autodidacte, elle fait ses débuts officiels à l'été 2022 avec She's Good. Ce projet lui permet de se faire connaître rapidement et de jouer sur de grandes scènes comme Festival Country Lotbinière, le Festival Lasso Montréal et le Festival Western de St-Tite. À l'automne 2023, elle présente Back To You, son premier album complet composé de sept chansons originales. Andie fait le tour du Québec avec sa tournée Back To You en 2024 et 2025 puis obtient le troisième prix du programme RBC pour les musiciens émergents de Canada's Walk of Fame 2025. Jusqu'en 2027, Andie assurera les premières parties de Clement Jacques dans le cadre de sa tournée IRIS. Elle prépare maintenant son tout premier album en français, une nouvelle ère artistique aux couleurs bohèmes et lumineuses. Les chansons « Nomade », « Dernier mot », « Danser ici » et « Beau temps » marquent le début de ce projet porté par l'amour de soi, la spontanéité et la légèreté, qui met de l'avant une Andie plus assumée que jamais. Remboursements Aucun remboursement Accès pour personnes à mobilité réduite Oui Gratuité pour l'accompagnateur Oui"
      }
