    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Anti-Queens et Taxi Girls"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Anti-Queens et Taxi Girls se partagent cette soirée. Le quatuor The Anti-Queens, formé uniquement de femmes, évolue depuis bientôt dix ans sur la scène torontoise avec un rock mélodique à l'énergie vive, qui rappelle The Blackhearts, Runaways, L7 et les Distillers. Le groupe a tourné sur la côte Est américaine et dans tout le Canada, et son premier album complet, paru en 2019 sur Stomp Records, réunit onze chansons en une trentaine de minutes. Anti-Queens présente son spectacle Disenchanted. Taxi Girls est un trio de punk rock montréalais formé en 2022, qui mêle le son classique des Ramones à l'esprit des Muffs ; son premier EP, Coming Up Roses, est sorti en juillet 2023."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
