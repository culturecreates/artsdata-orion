    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "🎄 A special activity for the kids! 🎄"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "This workshop will help futur little elves create this magnificent Christmas tree, a decoration that can be hanged on THE tree, posted on a wall or a door or even wrapped up to offer to a special someone. While your are shopping or resting at one of the tables reserved for our customers, leave your kids have fun and create a special memory at the crafting table!"
      }
    ],
