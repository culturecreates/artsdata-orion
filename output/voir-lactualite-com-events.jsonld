    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "50 ans, de la Bottine à aujourd'hui!"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Yves Lambert, musicien dont le parcours remonte à ses débuts avec La Bottine Souriante, présente un spectacle retraçant 50 ans de carrière. Le spectacle explore son grand répertoire bâti depuis ses débuts jusqu'à aujourd'hui, avec des titres connus comme La ziguezon, La cuisinière et Dans nos vieilles maisons, ainsi que plusieurs chansons qui ont façonné son parcours."
      }
    ],
