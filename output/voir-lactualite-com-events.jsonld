    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Because : un concert de spirituals"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Reconnu mondialement pour la pureté de son timbre et la justesse de ses interprétations dans les répertoires baroque, classique et moderne, le contre-ténor américain Reginald Mobley nous convie à une soirée consacrée aux spirituals, genre musical étroitement lié à l’histoire afro-américaine. En collaboration avec le Centre Culturel Afro-Canadien de Montréal (CCAM) et la Table Ronde du mois de l'histoire des Noir.e.s Ce concert est présenté avec le soutien de la succession de Marie-Paule Laurans."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
