        "@language": "fr-ca",
        "@value": "Attention : Fragile (tournée) — Montréal | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 15 novembre 2026 à 0 h, à Théâtre Desjardins (Montréal). Attention : Fragile est une pièce de théâtre sans parole d'une durée de 50 minutes, coproduite par L'Arrière Scène et Samsara Théâtre. Dans un espace vide, des livraisons s'empilent : deux personnages dans leur papier bulle, du mobilier…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://voir.lactualite.com/evenements/attention-fragile-tournee-32f516"
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
        "@value": "fr_CA"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
