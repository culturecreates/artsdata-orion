    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Chorale : Harmonies créatives"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "En collaboration avec Espace Transition et Maison Réalité, cette chorale propose une expérience artistique collective ouverte à tous. Dans un esprit inclusif et bienveillant, les participants sont invités à prendre part à une création musicale favorisant l’expression, la rencontre et le vivre-ensemble."
      }
