      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 19 février 2027 à 20 h, à Lieu à préciser – Alma (Alma). Native du Saguenay–Lac-Saint-Jean, Alexe est découverte lors de l’émission La Voix. Elle se fait connaître auprès du public grâce à sa chanson Placebo, qui marque le début de sa carrière d’artiste indépendante. Depuis, elle évolue sur la…"
      }
    ],
    "http://ogp.me/ns#url": [
