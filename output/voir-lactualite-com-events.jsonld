    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Alain Lefèvre"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le pianiste Alain Lefèvre revient avec un spectacle introspectif mettant en lumière onze œuvres originales et profondément humaines. Nées à la suite des bouleversements de la pandémie, les pièces tirées de l’album Consolation se veulent un baume, un havre de paix, une parcelle de lumière sur notre humanité qu’Alain Lefèvre désirait partager avec son public."
      }
    ],
