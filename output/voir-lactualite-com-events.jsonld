    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Cycle Martin Mcdonagh"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Pour la saison la plus sombre, la Cinémathèque Québécoise propose 4 films du cinéaste à l’humour le plus noir de notre ère: le britanno-irlandais Martin McDonagh. C’est méchant, c’est violent, c’est doux et les personnages expriment aussi mal leurs émotions que nous en dépression saisonnière. Au programme: IN BRUGES (2008), le 2 Novembre 2026. THE BANSHEES OF INISHERIN (2022), le 4 Novembre 2026. SEVEN PSYCHOPATHS (2012), le 19 Novembre 2026. THREE BILLBOARDS OUTSIDE EBBING, MISSOURI (2017), le 1er Décembre 2026."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
