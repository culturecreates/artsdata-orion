    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Akuteu"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Akuteu est un spectacle de théâtre de Soleil Launière d'une durée de 1 h 15. Il propose un voyage intime à travers des fragments d'un récit personnel : une jeune femme innue y partage sa perspective sur son intégration dans une société à prédominance blanche, sur les contradictions qui forgent son identité et sur sa légitimité à s'exprimer au nom de son peuple. Soleil Launière est une artiste transdisciplinaire innue originaire de Mashteuiatsh, établie à Tiohtià:ke (Montréal). Son premier album, Taueu, paru à l'automne 2023, explore l'identité, la langue, la féminité et le matriarcat. Elle a remporté les Francouvertes en 2024."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
