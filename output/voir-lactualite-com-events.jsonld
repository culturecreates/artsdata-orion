    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "CONCERTS EN RÉSIDENCES"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Ayant comme mission de rendre accessible l'opéra et la musique classique et l'amener à tous les publics, FOSE est fier de vous présenter cette année encore les récitals dans les résidences pour aînés. Concerts sous la Présidence d'Honneur de Madame Marie-Christine Tremblay et Monsieur Jacques Marchand que nous remercions chaleureusement! Les organisateurs du Festival FOSE sont heureux de recevoir à nouveau le pianiste virtuose Jean-Philippe Sylvestre, dans un programme exclusivement conçu pour le FOSE dans les Résidences des aînés. PROGRAMME : Poésie et Virtuosité Avec les oeuvres des compositeurs: Rachmaninov, Chopin et Gershwin"
      }
    ],
