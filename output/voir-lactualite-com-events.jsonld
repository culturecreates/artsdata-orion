    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "CONCERT DE NOËL"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Certaines mélodies ont ce pouvoir rare de nous rejoindre tous, dès les premières notes. C'est exactement l'esprit de ce concert de Noël, où les voix du Quatuor vocal Lane-Lépine et les cuivres du Quintette Élénya se retrouvent pour partager les plus belles pages du répertoire des Fêtes. Des airs que vous connaissez, d'autres que vous découvrirez, portés par des musiciens qui prennent visiblement plaisir à jouer ensemble. Luc Beauséjour, à l'orgue et au clavecin, assure avec bonheur le lien entre les voix et les instruments."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
