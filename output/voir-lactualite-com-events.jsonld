  {
    "@id": "https://voir.lactualite.com/genid/b7a4f70ad8d69362",
    "@type": [
      "http://schema.org/ScreeningEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-08T15:00:00-05:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-08T18:00:00-05:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://voir.lactualite.com/genid/1dba327bbc16eb7c"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://voir.lactualite.com/evenements/cozic-ba917e"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/228045c972a36745"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/cozic-ba917e"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Cozic"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Portrait du duo d’artistes canadien Cozic, formé de Monic Brassard (1944) et Yvon Cozic (1942). Unit dans la vie et comme la création, le couple travaille avec des matériaux industriels aux couleurs éclatantes pour créer des œuvres écologiques et ludiques. Depuis les années soixante hippies et débridées jusqu’aux grandes commandes d’art public, elles offrent un miroir de l’évolution de nos rapports à la nature et l’univers industriel. Aujourd’hui, depuis leur étonnant domaine de Sainte-Anne-de-la-Rochelle dans les Cantons-de‑l’Est, le duo prépare sa grande rétrospective au Musée national des beaux-arts du Québec. Une plongée dans l’univers fantastique de ces artistes inclassables. suivi du court métrage La muse La Muse est une histoire interculturelle et intergénérationnelle, qui explore la relation improbable entre Ting Ting Chen, jeune photographe chinoise d’art contemporain, et son amie et muse, Robert Tilley, âgé de 74 ans. Ce court métrage célèbre l’art tout en interrogeant nos préjugés sur les relations entre hommes plus âgés et femmes plus jeunes, sur la contribution des immigrés à notre culture, ainsi que sur la nature de la mémoire."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
