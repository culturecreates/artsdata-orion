    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Allemagne 2 festive et épicurienne"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "En partenariat avec les Aventuriers voyageurs Un film de Jennifer Doré Dallas Après l’Allemagne riveraine, Jennifer repart de plus belle pour mettre en lumière les trésors du reste du pays à la découverte des festivités incontournables et de la gastronomie. Ce périple vous conduira dans plusieurs villes historiques avant de mettre le cap sur la populaire Bavière, où elle vous fera découvrir Munich et son célèbre Oktoberfest. Depuis les châteaux royaux de la région de Füssen, elle poursuit son voyage dans le sud de l’Allemagne vers l’étincelant lac de Constance avant de rejoindre les coucous de l’emblématique Forêt-Noire. Pour conclure son tour du pays, elle vous emmène au cœur des marchés de Noël, traditionnels et gourmands. Bande-annonce"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
