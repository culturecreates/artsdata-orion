      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://voir.lactualite.com/artistes/michel-beaudoin-6e73a3#artist"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/5de6d7de836afcf2"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/demo-avec-michel-beaudoin-fe302a"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Démo avec Michel Beaudoin"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Processus artistique acrylique J’aime que ce ne soit pas trop moi qui informe mais plutôt les gens qui me posent des questions. Je commence par me présenter, explique un peu ma démarche artistique et ébauche un tableau par une gestuelle, pas de repère pas d’idée préconçue, ce qui va sortir du tableau est une surprise dont je ne peux prévoir la fin. Et sûrement qu’il ne sera pas terminé dans la soirée (lorsqu’il est achevé en atelier, j’envoie une photo au groupe). L’important est de peindre en direct pour susciter les questions et non le tableau terminé. Du même coup je m’accompagne de mes tableaux pour montrer aux gens ma direction artistique"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
