      {
        "@id": "https://voir.lactualite.com/artistes/elle-van-berg-8ce0d3#artist"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/85b5752edb0e5a52"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/chez-moi-c-est-l-art-f43d9b"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Chez moi, c’est L’art"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "J’apprécie l’art sous toutes ses formes. L’art abstrait me passionne tout particulièrement. Je suis une peintre intuitive, qui travaille avec des couches et de la texture. Je me laisse guider par mes sentiments. Ce processus fait naître en moi de nombreuses émotions, allant de la frustration à l’euphorie. Je crée à l’aide de pinceaux, de couteaux à palette, de cartes, de gomme à crayon, pâte à modeler, d’outils de poterie, de la peinture acrylique épaisse et parfois du fusain. Lorsque je ne suis pas plongée dans ma bulle de peinture, j’aime animer des ateliers et partager mes techniques et mon amour de l’art."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
