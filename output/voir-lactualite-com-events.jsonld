    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Bénévolat est un huis clos à la fois sensible et haletant, où les mots agissent comme moteur de l’intrigue, mais également comme catalyseur provoquant la rencontre improbable et attachante de deux êtres fragilisés par des parcours aux antipodes."
      }
