        "@id": "https://voir.lactualite.com/genid/186ecb968d90b9c2"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.sainte-julienne.com/storage/app/resources/resize/1200_0_0_0_auto/img_e2fe573bf2bcae4fa508a4aea6572040.png"
      }
    ],
    "http://schema.org/url": [
