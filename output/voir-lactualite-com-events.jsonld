    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Concert – Rob Lutes, with special guests The Wineberries"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "\"Rob is one of the unique voices of North American music; a captivating performer, stellar songwriter, and a gifted storyteller. Rob\\'s original material is a masterclass in songwriting; spare, essential lyrics that get at the meat of his topics with no filler. Lines like \"I want to start a fight just to let you win\" […] \\n"
      }
    ],
