    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Célébrer Gilles Vigneault : Au cœur du pays"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Gilles Vigneault dit qu’une chanson, c’est un bateau sur lequel on s’embarque pour faire un voyage; on pourrait dire qu’il en a construit de beaux, grands et solides, faits pour voguer loin et longtemps. C’est en offrant à plusieurs capitaines d’en tenir la barre qu’est né le projet Au cœur du pays. Regroupant les artistes Lou-Adriane Cassidy, Louis-Jean Cormier, Patrice Michaud, Ariane Moffatt, Ariane Roy et plusieurs autres, ce grand spectacle est une célébration de la richesse et l’influence de l’œuvre de Gilles Vigneault auprès de ses contemporains autant qu’une occasion unique de faire découvrir ou redécouvrir à toutes les générations certaines de ses plus belles chansons dans des habits neufs."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
