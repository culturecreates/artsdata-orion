    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Bon Débarras"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Depuis près de vingt ans, le trio Bon Débarras veille à garder vivante la musique folk-traditionnelle québécoise. Avec son nouveau spectacle, Veillance, le groupe continue de s’en inspirer pour créer un univers unique teinté de poésie et porté par la force irrésistible du mouvement créé par l’intégration de la gigue et de la percussion corporelle.…"
      }
    ],
