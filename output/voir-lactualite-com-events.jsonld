    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 8 mai 2027 à 20 h, à Centre des Arts (Shawinigan). Matt Lang débarque en ville avec sa nouvelle tournée Ain't That Bad ! Figure incontournable de la musique country au Canada, Matt et ses musiciens nous entraînent dans un spectacle honky-tonk déjanté et spectaculaire, où son 4e album prend vie…"
      }
    ],
