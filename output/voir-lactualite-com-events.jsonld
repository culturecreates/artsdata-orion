    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le mardi 13 avril 2027 à 19 h 30, Théâtre du Vieux Terrebonne (Terrebonne). Club sandwich mayonnaise est une pièce de Manuelle Légaré, qui en est l'autrice…"
