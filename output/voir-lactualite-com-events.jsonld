    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "A New Day – Hommage à Céline Dion"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Une nouvelle aventure. Quatre voix. Un répertoire qui traverse les générations. Près de 20 ans après une première aventure musicale consacrée à l’univers de Céline Dion, A New Day prend vie dans une toute nouvelle production ! Réunissant Alexandra Chayer, Cynthia Tremblay, Vanessa Roberge et Dominic Baker, accompagnés de musiciens sur scène, ce spectacle propose un voyage à travers les plus grands succès de Céline Dion. Des ballades bouleversantes aux chansons les plus entraînantes, les quatre interprètes unissent leurs voix à travers des solos, des duos et de puissantes harmonies pour célébrer, à leur façon, l’immense héritage musical de cette artiste incontournable. Les 21 et 22 mai, au Vieux Théâtre de La Baie, redécouvrez les chansons qui ont marqué des générations !"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
