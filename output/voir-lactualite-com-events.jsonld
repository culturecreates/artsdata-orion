    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/candlelight-classiques-d-halloween-0ffb9c"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Candlelight : Les classiques d'Halloween"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "⭐ Candlelight t'offre des expériences musicales magiques dans de magnifiques lieux éclairés à la bougie. Achète tes billets dès maintenant pour ce concert Candlelight : Les classiques d'Halloween à Montréal ! Ce concert est un hommage indépendant. Il n'est ni affilié, ni approuvé, ni soutenu par l'artiste original, ses ayants droit ou ses représentants officiels. Infos 📍 Lieu : Église Saint Jean-Baptiste 📅 Dates et heures : sélectionne tes dates / heures directement dans le sélecteur de billets ⏳ Durée : 60 minutes environ. Les portes ouvrent 60 minutes avant le début du concert. Les retards ne seront pas permis 👤 Âge recommandé: L’accès à l’expérience est réservé aux personnes de 8 ans et plus. Afin de garantir le bon déroulement de l’événement, tout comportement perturbateur peut entraîner une demande de quitter la salle. Les participants de moins de 16 ans doivent être accompagnés d’un adulte ♿ Accessibilité : cet endroit est accessible en chaise roulante ❓ Consulte la FAQ de cet événement ici 🪑 Les places sont assignées par ordre d’arrivée, selon la catégorie réservée 🕯 Si vous souhaitez réserver un concert privé ou acheter des billets standards pour un grand groupe (+30 personnes), cliquez ici 🎻 Découvre tous les concerts Candlelight à Montréal 🎁 Offre une carte-cadeau à tes amis et à ta famille en cliquant ici Programme Thriller - Michael Jackson Marche funèbre d'une marionnette - Charles Gounod Quatuor à cordes n° 8 en do mineur (Dresden Quartet), Op. 110 : II. Allegro Molto - Dmitri Shostakovich L’exorciste - Tubular Bells - Mike Oldfield Stranger Things - S U R V I V E Beetlejuice (Thème principal) - Danny Elfman La Famille Addams (Thème principal) - Vic Mizzy Halloween (Thème) - John Carpenter Prélude de Psychose - Bernard Herrmann S.O.S. Fantômes (Thème principal) - Ray Parker Jr. Danse Macabre - Camille Saint-Saëns Une Nuit sur le Mont Chauve - Modest Mussorgsky The Rocky Horror Picture Show - Time Wrap - Richard O'Brien et Richard Hartley Medley de \"L’Étrange Noël de Monsieur Jack \" - Danny Elfman Artistes Quatuor à cordes 2 violonistes 1 altiste 1 violoncelliste Plan de la salle"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
