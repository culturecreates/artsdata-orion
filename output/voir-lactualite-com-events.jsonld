    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "À corps & vins — Baie-Comeau | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 19 novembre 2026 à 20 h, à Centre des arts de Baie-Comeau (Baie-Comeau). À corps et vins transforme la salle de spectacle en un terroir éphémère, où vin et danse se rencontrent dans une expérience immersive. Guidés par un sommelier chevronné, les spectateurs découvrent une sélection de crus…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://voir.lactualite.com/evenements/a-corps-vins-5799c3"
      }
    ],
    "http://ogp.me/ns#locale": [
