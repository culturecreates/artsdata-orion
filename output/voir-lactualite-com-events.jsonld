    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Du passé au présent avec le Quartet Zanella – Théâtre Alphonse-Desjardins — Aramusique – diffuseur spécialisé"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Ce concert Du passé au présent du saxophoniste, compositeur et arrangeur de renom, Jean-Pierre Zanella, vous invite à un voyage sonore inédit, où il revisite avec son quartet, les œuvres majeures de Chopin à Villa-Lobos, en passant par Fauré et Beethoven. Ce spectacle est incontournable pour les jazz aficionados exigeants, tout autant que pour le grand public en quête d'une expérience musicale riche et accessible. Ne manquez pas cette rencontre au sommet de l'art et l'énergie du jazz enrobée dans l'éternelle beauté des grands classiques dont le poignant Prélude Opus 28 no 4 de Frédéric Chopin et la célèbre Lettre à Élise (Für Elise) de Beethoven."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
