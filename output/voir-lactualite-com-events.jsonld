    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Candides et candidats"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dans le cadre de ses ateliers culturels de théâtre jeunesse, la Ville de Rimouski vous invite à la présentation de cette courte pièce. Des jeunes de 9 à 12 ans du primaire sont à l’œuvre au montage de cette pièce depuis le mois de septembre, afin de vous présenter le résultat de leur travail. La pièce « Candides et candidats » est écrite par Martin Gougeon et mise en scène par la professeure de l’atelier de théâtre Sophie Desjardins-Gagnon. Deux partis politiques farfelus s’affrontent dans un débat sans merci. Le public devra voter et choisir qui gouvernera le pays. Des allocutions et des échanges qui décoiffent! Activité familiale gratuite! Places limitées."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
