      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/cercle-vicieux-une-experience-360-f9d6f5"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Cercle Vicieux, une expérience 360°"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "« Cercle vicieux » est une œuvre interdisciplinaire, adaptée d’un spectacle de 50 minutes créé en 1985 qui était le tout premier one-woman-show de Dulcinée Langfelder. Cette création scénique était un véritable journal intime en danse, mime, théâtre, musique, chanson et projection vidéo. Le spectacle a été applaudi par les publics et salué par la critique pendant 10 ans de tournée au Canada, aux É.-U. et en Europe. Aujourd’hui, entourée d’artistes audacieux, Dulcinée Langfelder a souhaité revisiter sa toute première œuvre et lui donner un nouveau souffle. Dans cette adaptation, d’une part, la technologie du dôme à 360° a offert des possibilités inimaginables lors de la création originale. D’autre part, le simple cerceau en plastique d’antan a laissé place à la majestueuse roue Cyr, habilement manipulée par une circassienne virtuose, et ainsi permis une performance d’une intensité inédite. À la fois sa première et sa dernière œuvre, « Cercle vicieux » boucle la boucle d’une carrière artistique fructueuse pour Dulcinée Langfelder (1955-2025), dont les créations ont touché droit au cœur un large public à l’échelle internationale. Avec le cercle, objet puissant et hautement symbolique, prémisse des cycles omniprésents dans nos vies, son personnage explore ses peurs et tente de comprendre l’incompréhensible, ses chagrins, son insécurité, sa vulnérabilité, sa curiosité et sa détermination à trouver sa place dans le monde. « Cercle vicieux » est le voyage d’une vie entière, de la naissance à la mort."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
