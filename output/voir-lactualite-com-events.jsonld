    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "C'est parti! - Lydia Képinski"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Lydia Képinski s’impose comme une voix singulière et puissante de la chanson québécoise. Fragile et invincible à la fois, elle trace un parcours où l’audace et la justesse se conjuguent avec éclat. *À noter : ce spectacle est présenté debout. Un nombre limité de places assises sera disponible pour les personnes qui en ont besoin.*"
      }
    ],
