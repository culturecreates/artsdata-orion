    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Ariane DesLions et ses rêves à colorier"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Chanson / pour les 5 à 10 ans À travers des rythmes manouche, trad et folk, Ariane DesLions présente sa famille « toute chiffonnée » dans son spectacle Ariane DesLions et ses rêves à colorier. Une aventure musicale haute en couleur qui allie chanson, théâtre d’objets et jeu clownesque. Plongez dans l’univers sensible et farfelu de cette fabricoleuse qui invente des instruments à partir d’objets insolites. Multi-instrumentiste et travailleuse sociale de formation, elle bricole des histoires en chansons pour réparer les écorchures du cœur. Accompagnée de Tiyou, sa fabuleuse machine à sons, Ariane DesLions tisse la résilience et se rafistole en musique pour traverser les tempêtes du quotidien."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
