      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://voir.lactualite.com/evenements/club-de-lecture-jeunesse-3f7061"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/4ae9732ca1bb668f"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/club-de-lecture-jeunesse-3f7061"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Club de lecture jeunesse"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le défi Tous champions de lecture se transforme en un véritable club de lecture estival! Permettre aux jeunes du primaire et du secondaire de cultiver leur amour de la lecture durant l’été, dans un contexte ludique, là est l’objectif de ce club. Au menu : découverte de nouveaux styles littéraires amusants et inspirants et grande remise de prix avant le retour en classe. Comment participer au Club de lecture jeunesse? ÉTAPE 1 Être abonné.e à la bibliothèque Alice-Quintal ÉTAPE 2 Avoir terminé sa 1re année du primaire ÉTAPE 3 S’inscrire au comptoir de la bibliothèque pour recevoir la trousse du lecteur Le défi Plus tu explores de styles, plus tu augmentes tes chances de gagner au grand tirage! Exclusions Les livres cartonnés (cote CART) Les livres sans mots (ex. Cherche et trouve, Game Over) Les albums sont acceptés pour les 1er et 2e cycles seulement. Dans le doute, un membre du personnel au comptoir pourra t'accompagner dans tes démarches avant d’emprunter le livre."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
