    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "20 ans d'humanitaire"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dans un style très dynamique et authentique, Guillaume nous partage des histoires de voyages humanitaires, passant par les camps de réfugiés syriens jusqu'aux orphelinats en Russie. C'est parfois drôle, parfois bouleversant, mais toujours très humain."
      }
    ],
