    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Arquemuse présente Passionnément clarinette !"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Ce concert de musique de chambre met la clarinette à l'avant-scène. Stéphane Fontaine, clarinettiste solo de l'Orchestre symphonique de Québec, y est invité aux côtés du Trio Arquemuse, formé de Julie Tanguay au violon, Mehdi Ghazi au piano et Diliana Momtchilova au violoncelle. Le programme réunit le Trio de Khachaturian, écrit en 1932 et nourri de traditions arméniennes, géorgiennes et persanes, Círculo de Turina, triptyque évoquant Aube, Midi et Crépuscule, et le Trio op. 114 de Brahms, composé en 1891 pendant sa « période clarinette »."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
