    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/atelier-creatif-libre-collage-6d3201"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Atelier créatif libre : collage"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Prolongez l’expérience de l’exposition en cours en laissant libre cours à votre imagination lors de cet atelier de collage en accès libre. À partir d’une sélection d’images, de papiers et de textures, composez une œuvre personnelle en explorant les formes, les couleurs, les superpositions et les associations inattendues. Accessible à tous, cet atelier offre un espace de création spontané où chacun peut expérimenter à son rythme et donner vie à une composition unique. Seul, en famille ou entre amis, prenez le temps de créer, d’assembler et de découvrir les possibilités infinies du collage. Une invitation à jouer avec les matières et les images, à exprimer sa créativité et à porter un regard nouveau sur ce qui nous entoure. Activité gratuite pour tous les âges. Aucune inscription requise -présentez-vous sur place à l’heure de votre choix."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
