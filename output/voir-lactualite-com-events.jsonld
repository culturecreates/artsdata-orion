    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "BOUGER-BOUGER! Rythmes et sons traditionnels de l'Afrique de l'Ouest"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Bouger-Bouger est un spectacle participatif inspiré de l’Afrique de l’Ouest où le chant, la danse, la musique et les costumes traditionnels permettent aux spectateurs de voyager et de vivre une expérience unique. Dans un environnement festif traditionnel, un danseur et trois musiciens amènent le public à la découverte de masques africains et d’instruments traditionnels. Bouger-Bouger, le spectacle dont vous êtes le héros! «Le spectacle, c’est vous!» Avec la collation offerte gracieusement par McCafé à partir de 10h."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
