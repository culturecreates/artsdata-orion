        "@id": "https://voir.lactualite.com/genid/c51e9f7e03f58cd1"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://voir.lactualite.com/artistes/duo-cordelia-ec349d#artist"
      },
      {
        "@id": "https://voir.lactualite.com/artistes/vanessa-marcoux-649bc7#artist"
      },
      {
        "@id": "https://voir.lactualite.com/artistes/marie-christine-poirier-fb35e9#artist"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/0838d55da6851e09"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/de-l-autre-cote-du-miroir-bb5204"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "De l’autre côté du miroir avec le Duo Cordelia – Théâtre Alphonse-Desjardins — Aramusique – diffuseur spécialisé"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Formule sur la scène L'expérience musicale, De l'autre côté du miroir, telle qu'imaginée et présentée par le Duo Cordelia, vient chambouler les repères conventionnels du concert de musique de chambre. Contemplation, humour, et ravissement sont au rendez-vous alors que les deux musiciennes chevronnées de cet ensemble violon-piano entraînent leur auditoire dans une aventure musicale innovatrice. Elles mettront de l'avant un répertoire diversifié issu de l'œuvre de compositeurs révolutionnaires ou politiquement engagés à leur époque, ainsi que des compositions originales de la violoniste Vanessa Marcoux. S'inspirant de la résilience de ces artistes, pour qui l'évasion vers des paysages musicaux fabuleux comportait la seule issue possible aux réalités de leur époque, le Duo Cordelia témoigne de la profondeur de notre rapport essentiel à la musique. Et par moments, le répertoire faisant place à l'improvisation, le public s'unit l'espace d'un instant dans un élan de création partagée."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
