    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 31 octobre 2026 à 19 h, à Lieu à préciser (Montréal) (Montréal). A mysterious Halloween night unfolds across the entire Montreal Art Center and Museum, where art, live music, tarot, astrology, costumes, curious finds, and eerie surprises await around every corner."
      }
    ],
