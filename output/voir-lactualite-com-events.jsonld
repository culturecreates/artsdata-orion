    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "5 mots, 1 histoire : atelier d'écriture créative avec Christiane Desrivières"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Recevez cinq mots mystérieux et transformez-les en histoire, en poème, en slam ou en texte humoristique. Un atelier ludique pour explorer l'écriture, stimuler son imagination et découvrir que quelques contraintes suffisent parfois à faire naître les meilleures idées"
      }
    ],
