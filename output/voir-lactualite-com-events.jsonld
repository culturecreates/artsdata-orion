    ],
    "http://schema.org/performer": [
      {
        "@id": "https://voir.lactualite.com/artistes/marie-aube-laniel-d2ae58#artist"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/cf38b2a7a5c6cdd0"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/ecologies-de-la-trace-ad22c1"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Écologies de la trace"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Démarche artistique Écologies de la trace est un projet d'exposition qui prend appui sur le paradigme des trois écologies formulé par Félix Guattari - environnementale, sociale et mentale - afin de repenser la place de l'humain dans les dynamiques du vivant. À travers un corpus d'oeuvres réalisées à partir de matériaux biodégradables, le projet questionne les formes de traces que nous laissons derrière nous. Biographie Historienne et artiste multidisciplinaire, Marie‑Aube Laniel développe une pratique ancrée dans le temps et la profondeur, en réaction à la vitesse, au consumérisme et à la superficialité du monde moderne. À travers l’usage de végétaux indigènes biodégradables, elle explore les cycles naturels, la transformation des matières et invite à une reconsidération des rapports que nous entretenons à la matière et aux traces que nous laisserons derrière nous. Son travail s’inscrit dans une volonté de transmission et de mémoire : descendante d’une lignée féministe, son travail vise à valoriser les savoirs traditionnellement féminins à travers une réinterprétation contemporaine, afin de redonner voix à celles qui, par leur ingéniosité et leur dévouement, ont soutenu les conditions de vie de leurs familles à travers les âges."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
