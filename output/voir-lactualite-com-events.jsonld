  {
    "@id": "https://voir.lactualite.com/genid/463af3b0d5f3a9b8",
    "@type": [
      "http://schema.org/MusicEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-27T20:00:00-05:00"
      }
