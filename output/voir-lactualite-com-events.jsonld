    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Alex Roof - Frileux"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Alex Roof débarque chez nous avec « FRILEUX », son nouveau spectacle en rodage! Avec son humour sans tabous et son regard bien à lui sur notre époque, il a le tour de créer une complicité avec la salle. Vous l’avez peut-être découvert grâce à ses caméras cachées; venez maintenant le voir sur scène, où ses nouvelles idées prennent vie!"
      }
    ],
