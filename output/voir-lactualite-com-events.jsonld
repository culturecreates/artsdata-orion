  {
    "@id": "https://voir.lactualite.com/genid/cde2530c9da4a2a1",
    "@type": [
      "http://schema.org/MusicEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-02-18T19:30:00-05:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-02-18T22:30:00-05:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://voir.lactualite.com/genid/30345736c5482bee"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://poudingchomeur.com/media/2026/10/01cbdff5f169e7c5d6be930a-t.jpg"
