    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Der Rosenkavalier I Richard Strauss"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Opéra majeur de Richard Strauss, Der Rosenkavalier revient à Montréal dans une version de concert, après plus de trente ans d'absence des scènes montréalaises. Le spectacle est coproduit par l'Opéra de Montréal et l'Orchestre Métropolitain, sous la direction musicale de Yannick Nézet-Séguin. Strauss y déploie une musique d'élégance et de richesse émotive, nostalgique des valses viennoises comme de la comédie mozartienne. La distribution internationale réunit notamment Diana Damrau, Emily D'Angelo, Erin Morley, Peter Rose et Thomas Ebenstein. L'œuvre est chantée en allemand, avec sous-titres en français et en anglais."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
