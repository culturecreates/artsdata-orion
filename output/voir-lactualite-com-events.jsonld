      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 22 novembre 2026 à 15 h, à Salle Jean-Cossette (Amqui). Après 40 ans dans le métier, Chantal Lamarre propose Steppettes et cornemuse, un cabaret bio-comique présenté en solo, une première pour elle. Observatrice du monde et fille de scène, elle y chante, danse et joue la comédie, mêlant…"
      }
    ],
