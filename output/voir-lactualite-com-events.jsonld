    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 28 novembre 2026 à 20 h, à Centre culturel (Sherbrooke). Alexandre Forest est un humoriste dont l'univers, tel que décrit dans les présentations de ses spectacles, repose sur un alliage d'autodérision et de finesse d'esprit. Il y observe les petites et grandes incongruités de la vie…"
      }
    ],
