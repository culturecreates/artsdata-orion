    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Bruno Pelletier - 3 and Me"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Bruno Pelletier, l'un des chanteurs les plus appréciés de la francophonie, revient sur scène avec une nouvelle tournée intitulée « Trois et moi ». Conçu comme un moment de partage privilégié, ce spectacle plonge le public dans un univers musical intime où l'artiste se dévoile avec authenticité. Entouré de trois musiciens, Bruno Pelletier propose une interprétation dépouillée de ses plus grands succès et de chansons coups de cœur, dans un format épuré misant sur les harmonies vocales, les mélodies recherchées et des arrangements délicats."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
