    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "ATELIERS DE CHANTS TRADITIONNELS — Baie-Saint-Paul | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 29 octobre 2026 à 18 h, à Carrefour culturel Paul-Médéric (Baie-Saint-Paul). À la fréquence d'un jeudi sur trois, nous chantons de la musique traditionnelle ! 18 h : la soirée débute avec un atelier de chant traditionnel animé par Louve. 19 h 30 : la soirée se poursuit sous forme de veillée.…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://voir.lactualite.com/evenements/ateliers-de-chants-traditionnels-7940d3"
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
        "@value": "fr_CA"
      }
    ]
  },
  {
    "@id": "https://voir.lactualite.com/genid/a4a4937aab5b97ca",
    "@type": [
      "http://schema.org/MusicEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-10-29T18:00:00-04:00"
      }
