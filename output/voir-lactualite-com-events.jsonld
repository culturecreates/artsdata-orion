    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Audiopollination : Rod Campbell + Nour Symon"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Nour Symon est l'auteur de l'album jeunesse Doux rêves, belles personnes et du livre خول Khawal ou le privilège de la beauté, ainsi que de l'album je suis calme et enragé·e. Nour Symon a aussi animé, à la bibliothèque Philippe-Panneton, un atelier pour les 6 à 10 ans intitulé Constellations d'amour, inspiré du livre Doux rêves, belles personnes, où les participants exploraient leur propre constellation d'amour. Audiopollination réunit Rod Campbell et Nour Symon au Dièse Onze."
      }
    ],
