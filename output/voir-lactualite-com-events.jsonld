    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Cabaret spoken word flamenco"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le jeudi 26 novembre 2026 à 20 h, la Maison de la littérature, 40, rue Saint-Stanislas, réunit des poètes qui rendent hommage à la parole avec des textes parlés, slamés, rappés et chantés, accompagnés de musique improvisée. Cette édition met à l’honneur la musique d’Andalousie, avec la guitare et la mandoline du collectif Archipel."
      }
    ],
