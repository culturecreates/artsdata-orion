    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Café-spectacle au piano"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Pascal Cameron présente Un spectacle, son premier one-man-show, un spectacle d'humour de type stand-up. Humoriste, il y interrompt le récit de sa propre vie pour laisser place à l'introspection et à l'éveil émotionnel. En explorant sa vulnérabilité, il aborde nos travers communs, qu'il s'agisse de la représentation quotidienne que nous livrons aux autres ou des mensonges que nous nous racontons pour nous donner bonne conscience. Le spectacle mêle autodérision et ton grinçant, avec un sens du timing comique qui lui est propre."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
