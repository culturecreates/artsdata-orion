    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Conférence de Grégory Pratte : Jasette autour du bac"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le recyclage et le compostage vous intriguent? Venez démêler le vrai du faux! La Ville de Chambly vous invite à une conférence gratuite animée par Gregory Pratte. Dans une ambiance conviviale et interactive, testez vos connaissances, découvrez les meilleures pratiques en gestion des matières résiduelles et déconstruisez plusieurs mythes entourant le recyclage et le compostage. Une activité gratuite accessible à tous, instructive et conviviale à ne pas manquer!"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
