      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://tpos.s3.amazonaws.com/events/PBN/26/12/11/001/pbn261211001-1152x648-fr-6a6b967d.png"
      }
    ],
    "http://schema.org/url": [
