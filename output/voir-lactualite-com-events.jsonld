    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Couple ouvert"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Thomas Levac et Stéphanie Vandelac animent le podcast Couple ouvert, dont l'enregistrement se fait devant public à la Salle Jean-Grimaldi du Théâtre Desjardins. Selon la page de l'événement, les deux animateurs abordent des sujets chauds avec autodérision et explorent les relations modernes à travers chaque épisode. Le spectacle est classé dans la catégorie humour."
      }
    ],
