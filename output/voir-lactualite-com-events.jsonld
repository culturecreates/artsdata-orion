    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "CAFÉ D'ÉPOQUE CAFÉ, MUFFINS ET VOYAGE DANS NOTRE PASSÉ"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Pour terminer les festivités tout en douceur, joignez-vous à nous pour un Café d’époque en compagnie de l’historien Gaétan St-Arnaud. Autour d’un café et de muffins, venez découvrir les histoires qui ont façonné Daveluyville et replonger dans certains moments de notre passé. Une matinée conviviale pour mieux connaître notre histoire locale et ceux et celles qui l’ont écrite."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
