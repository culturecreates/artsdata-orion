    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Empreintes – Sur nos traces créatives"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Du 26 septembre 2026 au 28 mars 2027, découvrez EMPREINTES, une exposition d’arts visuels présentée au Pavillon d’exploration du Parc de la Rivière-des-Mille-Îles. Réunissant 11 artistes ainsi que 3 œuvres collective citoyennes, l’exposition invite le public à réfléchir à notre avenir collectif à travers les trois principes éthiques de la permaculture : Prendre soin de la Terre Prendre soin de l’humain Partager équitablement"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
