    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Autour de Ferland"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "En duo avec France Bernard au piano et Clément Courtois à la guitare. Leurs deux voix vous feront revivre les plus grandes chansons de Jean-Pierre Ferland ainsi que de tous ses contemporains qui ont croisé sa route: Claude Léveillée, Gilles Vigneault, Claude Gauthier, Robert Charlebois, Félix Leclerc, Raymond Lévesque, Clémence Desrochers... Une balade parmi les incontournables de la chanson québécoise. L'offre comprend le spectacle et la table d'hôte pour le souper."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
