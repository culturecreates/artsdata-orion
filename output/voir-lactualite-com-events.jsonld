      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "ATELIER SUR LA MÉMOIRE GÉOLOGIQUE ET LA CÉRAMIQUE AVEC… | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 22 octobre 2026 à 17 h 30, à Quartier Ephémère (Montréal). Tenir un objet en argile, c’est toucher l’une des plus anciennes traces de la culture humaine ; travailler l’argile, c’est interagir avec un matériau qui transmet la mémoire géologique à l’avenir de notre planète. La langue et la terre…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://voir.lactualite.com/evenements/atelier-sur-la-memoire-geologique-et-la-ceramique-avec-nina-ba33cf"
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
        "@value": "fr_CA"
      }
    ],
