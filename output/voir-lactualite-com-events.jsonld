    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Atelier pour les 10-16 ans | Crée une couverture de livre"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Inscription en ligne requise. 12 places disponibles pour chaque tranche d'heure. Voir les liens d'inscription plus bas. Viens te familiariser avec l’application de création graphique Canva en réimaginant la couverture d’un livre de ton choix. Tu recevras la version digitale de ta couverture de livre par courriel dans la semaine suivant l’activité. Liens pour s’inscrire Atelier du 28 novembre à 13 h Atelier du 28 novembre à 15 h"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
