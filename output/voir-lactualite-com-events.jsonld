    "http://schema.org/performer": [
      {
        "@id": "https://voir.lactualite.com/artistes/les-chanteurs-de-la-place-de-bourget-39efaa#artist"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/1d6fc36a1402620a"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/choeur-en-fete-concert-de-noel-lp1-588"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Choeur en fête - concert de Noël"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "La programmation de ce concert se veut un véritable hymne à la joie et à l'esprit festif qui anime cette période de l'année. Si les chants traditionnels de Noël y occupent une place de choix, vous aurez également le plaisir de découvrir des œuvres du répertoire classique, des chants folkloriques, ainsi que des chansons populaires chères à nos choristes. Comme le bonheur de chanter est encore plus grand lorsqu'il est partagé, vous serez invités à unir vos voix à celles des Chanteurs de la Place Bourget pour créer, tous ensemble, un véritable moment de Chœurs en fête! PRENEZ NOTE QUE LA REPRÉSENTATION DU 19 DÉCEMBRE 2026 EST À L'ÉGLISE ST-JACQUES."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
