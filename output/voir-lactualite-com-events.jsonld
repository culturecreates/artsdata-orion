      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "12 hommes en colère — Sainte-Agathe-des-Monts | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 14 août 2027 à 0 h, à Théâtre Le Patriote - Salle Percival-Broomfield (Sainte-Agathe-des-Monts). Un jury de 12 hommes doit décider du sort d’un jeune homme accusé d’homicide. La preuve et les f aits réunis contre lui sont accablants. Le verdict semble évident. Pourtant, un membre du jury n’est…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://voir.lactualite.com/evenements/12-hommes-en-colere-5781ba"
      }
    ],
