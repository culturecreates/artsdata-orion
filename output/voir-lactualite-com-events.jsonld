    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/dilate-en-rodage-685389"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Dilaté (en rodage)"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "La plus grande dilatation de l’univers depuis le Big Bang : un peu plus haut, un peu plus loin, un peu plus fort! L’humour de Faf, comme son tour de taille, est en perpétuelle expansion. Dans ce nouveau spectacle, où l’humour noir et les one-liners sont toujours à l’honneur, on en apprend maintenant un peu plus sur l’homme à la vie improbable qu’est Faf à travers des anecdotes qui ne peuvent susciter qu’une seule réaction : « Ben voyons donc! ». Un spectacle pour les amoureux d’humour noir et de situations absurdes."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
