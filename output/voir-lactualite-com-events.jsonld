      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Atelier de danses de la Renaissance — Montréal | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 7 novembre 2026 à 14 h, à Centre des musiciens du monde (Montréal). La Renaissance est une période importante pour l’essor de la danse en Occident, car on y voit apparaître les tout premiers traités de danse. Cette série d’ateliers s’intéressera aux danses des cours italiennes des Quattrocento…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://voir.lactualite.com/evenements/atelier-de-danses-de-la-renaissance-8623f2"
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
        "@value": "fr_CA"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://centredesmusiciensdumonde.com/wp-content/uploads/2026/09/atelier-danse-renaissance-1.png"
      }
    ]
  },
  {
    "@id": "https://voir.lactualite.com/genid/7e3f5e52ded99f3d",
    "@type": [
      "http://schema.org/DanceEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-07T14:00:00-05:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-07T16:00:00-05:00"
      }
    ],
    "http://schema.org/location": [
