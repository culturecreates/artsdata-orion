    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Alex Roy"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Alex Roy est un humoriste qui a présenté plus de 100 représentations de son premier one man show «Des choses qui arrivent», ayant vendu près de 25 000 billets. Il a aussi fait rire le public durant les premières parties de Lise Dion, Les Grandes Crues et José Gaudet. Il revient avec un nouveau spectacle, «Debout», sous la direction artistique de José Gaudet, dans lequel il aborde rêves, galères, absurdités du quotidien et grandes questions existentielles, en pratiquant notamment l'art du stand up et le beat box."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
