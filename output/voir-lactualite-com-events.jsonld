    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Atelier 2 — Les appellations grecques, comprendre les régions, les styles et les traditions"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Cette série de trois ateliers invite les participants à découvrir les vins de la Grèce et de ses îles à travers des dégustations commentées. Chaque rencontre propose une sélection de six vins, accompagnés de bouchées apéritives, pour une expérience sensorielle et conviviale qui prolonge la visite de l’exposition. L’atelier est animé par Patrick Blondin, sommelier passionné qui partage ses coups de cœur et cultive les expériences culinaires depuis plus de 15 ans."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
