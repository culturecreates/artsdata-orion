    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Concours d’écriture d’Halloween"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Participez au concours d’écriture d'Halloween pour courir la chance de gagner l’un des prix de participation. Pour ce faire, il suffit d’écrire une histoire, une anecdote ou une mésaventure qui donne la frousse, et de faire parvenir votre texte ainsi que vos coordonnées à [email] Vous courez la chance de gagner un prix de participation! De plus, un extrait de votre texte pourrait être sélectionné et partagé sur nos réseaux sociaux !"
      }
    ],
