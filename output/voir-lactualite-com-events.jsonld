    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Atelier de Haka"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Cet atelier de danse traditionnelle maorie est offert par des animateurs et animatrices arrivées directement de Nouvelle-Zélande. Le haka est une danse chantée pratiquée lors de manifestations, de cérémonies et de compétitions amicales. Le public sera invité à participer et à échanger sur la culture maorie. L’artiste Rei sera aussi en spectacle le 22 août à 20h30 à la Place des Anciens-Combattants."
      }
    ],
