    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 10 novembre 2026 à 9 h 30, à Bibliothèque municipale Claude-Henri-Grignon (Longueuil). Apportez votre laine, vos aiguilles ou votre crochet, et installez-vous pour échanger et créer en bonne compagnie. Une occasion parfaite de partager vos projets, découvrir de nouvelles techniques ou…"
      }
    ],
