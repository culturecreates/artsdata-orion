    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Drôle depuis 1957"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Michel Barrette présente Drôle depuis 1957, un nouveau spectacle dans lequel il porte un regard drôle et tendre sur sa génération. Le spectacle s'articule autour de la « revanche des baby-boomers », ces jeunes d'hier devenus les grands sages d'aujourd'hui, toujours irrévérencieux. Anecdotes, souvenirs et observations y sont présentés avec une énergie contagieuse, entre rires et réflexions sur le passé et sur le fait de vieillir sans cesser d'être drôle."
      }
    ],
    "http://schema.org/inLanguage": [
      {
