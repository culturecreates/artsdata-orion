    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "À fleur de soi"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Cet automne, les 50 ans et plus auront la possibilité de s'inscrire aux m'art'dis créatifs. Ces ateliers, qui auront lieu les mardis de 13h30 à 15h30 au Cabaret des arts, sont une belle occasion de découvrir différentes disciplines artistiques à un prix très abordable. Seulement 12 places disponibles."
      }
    ],
