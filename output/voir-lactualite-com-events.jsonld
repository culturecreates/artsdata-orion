      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/concert-famille-momo-symphonique-49447c"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Orchestre symphonique de Laval – Concert famille : Momo symphonique"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Cette année, l’Orchestre, en collaboration avec le théâtre Fêlé, vous offre un concert destiné aux 5-12 ans (et à toute la famille !). Momo symphonique est une création mettant en scène 3 acteurs et 60 musicien·nes pour donner vie à Momo le chameau, peluche égarée par son humaine lors d’une tempête dans le Nord. Alors complétement bouleversé et perdu dans ses souvenirs, Momo rencontre deux compagnons vivants chacun leurs propres remises en question. Ce groupe varié s’engage dans une aventure pour retrouver les souvenirs et l’humaine de Momo vers le Sud. Cette épopée musicale explorent comment les relations ont le pouvoir de transformer chaque individu et approfondir leurs racines. Drôle, touchante et captivante, soyez avec nous pour découvrir une toute nouvelle œuvre qui égayera votre samedi !"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
