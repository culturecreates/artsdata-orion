    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Catch Impro 3"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "QUAND LA LUTTE RENCONTRE L'IMPROVISATION Un spectacle d’impro 2 contre 2, d’environ 1h30 à 2h, qui reprend les codes de la lutte plutôt que ceux du hockey. Et surtout… les improvisateurs joue dans un vrai ring de lutte ! Chaque improvisateur se crée un personnage, un nom de lutteur et/ou une équipe, avec idéalement un costume, et l’incarne tout au long du show. Les impros mélangent des catégories classiques avec des stipulations inspirées de la lutte. Pas d’arbitre, mais un annonceur et c’est la foule qui vote par acclamation à la fin de chaque impro. Le but ultime : mettre la main sur les championnats du Catch Impro du Sanctuaire !"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
