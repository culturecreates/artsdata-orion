      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://voir.lactualite.com/genid/817f60daee56647a"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://voir.lactualite.com/evenements/comite-organisateur-secondaire-en-spectacle-cfb729"
      }
