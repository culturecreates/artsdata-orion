      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://voir.lactualite.com/artistes/id-evolution-br-cirque-7e4540#artist"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/8445bb9e449d0fbd"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/cirque-eloize-be0171"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Cirque Éloize"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Originellement créé en 2009 à Incheon, KOR, puis retravaillé pour être présenté dans le cadre du Festival Montréal Complètement Cirque, iD a enchaîné les triomphes : 2 100 représentations dans 33 pays et 140 villes. Le plus grand succès de Cirque Éloize, cette création québécoise emblématique, revient réinventée pour notre époque, avec son décor iconique et une énergie encore plus électrisante. Dans iD - Evolution, la ville devient scène et personnage à part entière. Les acrobates défient la gravité, les danseurs et danseuses explosent en mouvements urbains saisissants, et chaque espace se transforme en terrain de jeu pour l'imaginaire. Trampomur, cerceau aérien, vélo trial, breakdance et plein d'autres disciplines s'entrelacent dans un ballet électrisant où chaque saut, chaque geste et chaque note de musique raconte une histoire. iD-Evolution explore l'identité et la rencontre dans un monde où les corps parlent, s'affrontent et se répondent. C'est une expérience qui secoue les sens, transporte et émerveille, un voyage visuel et sonore où poésie et énergie urbaine se fondent pour créer un spectacle à la fois spectaculaire et profondément humain. * Veuillez noter que ce spectacle n'est pas admissible au forfait 3 spectacles de la série des P'tites sorties."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
