      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le dimanche 20 décembre 2026 à 14 h, La Belle Église de Chertsey (Chertsey). Le 20 décembre prochain, venez vous mettre dans l'ambiance du temps des fêtes…"
      }
    ],
