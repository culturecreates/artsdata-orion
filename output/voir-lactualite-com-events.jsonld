    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/cine-conference-la-richesse-des-ordures-8a4091"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Ciné-conférence : La richesse des ordures"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Et si nos déchets avaient plus de valeur qu'on le croit? À travers son documentaire La richesse des ordures, le réalisateur Dominic Simard nous invite à revoir notre façon de consommer et à découvrir tout ce qui peut être réparé, transformé ou réutilisé avant de prendre le chemin de l'enfouissement. Porté par les témoignages d'artisans du réemploi, de bénévoles, de spécialistes et de citoyens engagés, le film nous fait découvrir les coulisses des écocentres, des ateliers communautaires et d'initiatives qui réinventent notre rapport aux objets et à la consommation. La projection sera suivie d'une discussion d'une heure avec le réalisateur, une occasion d'échanger sur les enjeux liés aux matières résiduelles et de réfléchir à des gestes concrets pour réduire notre empreinte au quotidien."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
