    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 28 septembre 2026 à 0 h, à Pavillon St-Arnaud (Trois-Rivières). Du 28 septembre 2026 au 7 décembre 2026. Cours d'aquarelle pour niveaux intermédiaire et avancé. 6 cours, un lundi sur 2, 13h à 16h. Exploration de compositions abstraites et techniques de couleur."
      }
