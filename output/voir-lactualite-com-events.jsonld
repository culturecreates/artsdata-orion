    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 25 octobre 2026 à 20 h, à Théâtre Hector-Charland de L'Assomption (L'Assomption). Après plus de 35 000 billets vendus de leur spectacle Jolene and the Gambler, le duo revient sur scène avec une nouvelle version acoustique de leur en hommage aux légendes de la musique country. Fort du succès…"
      }
    ],
