    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Dan Bigras en spectacle à Terrebonne - SUPPLÉMENTAIRE"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dan Bigras présente le spectacle Cette voix : Dan et Gerry, notre histoire, un témoignage d'affection envers son ami Gerry Boulet. Bouleversé par la chanson La voix que j'ai, l'artiste a pu amorcer sa carrière musicale grâce à l'aide de Gerry. Anecdotes et chansons gravitant autour de l'univers de ce rockeur plus grand que nature racontent ce parcours, jusqu'à Jézabel, réalisé par Dan Bigras. Avec ses musiciens, il relève le défi de ramener Gerry sur scène en entremêlant leurs voix et leurs instruments."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
