    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Nouvelle restauration 4K ! BEGOTTEN ne possède aucun personnage au sens conventionnel du terme. Trois figures seulement à son générique : Dieu se tuant lui-même, Mère Nature et Fils de [...]"
      }
