      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Anas Hassouna : J'arrive — Sherbrooke | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 4 novembre 2026 à 20 h, à La Petite Boîte Noire (Sherbrooke). Je présente mon nouveau show: J’ARRIVE. Si tu me connais c’est sûrement que tu m’as déjà attendu plus que 5 minutes dans ta vie. Je t’ai dit ‘‘J’arrive’’ mais la vérité c’est que j’étais couché dans mon lit et j’avais pas encore pris…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://voir.lactualite.com/evenements/anas-hassouna-j-arrive-e16b88"
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
        "@value": "fr_CA"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://tpos.s3.amazonaws.com/events/PBN/26/11/04/001/pbn261104001-1152x648-fr-6a1ef532.png"
      }
    ]
  },
  {
    "@id": "https://voir.lactualite.com/genid/3471330040fb6f1b",
    "@type": [
      "http://schema.org/ComedyEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-04T20:00:00-05:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-04T23:00:00-05:00"
      }
    ],
    "http://schema.org/location": [
