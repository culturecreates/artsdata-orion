    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 21 octobre 2026 à 0 h, à USINE C (Montréal). Ce festival international des musiques numériques immersives explore toutes les formes de musique électroacoustique qui font place autant aux jeunes compositeurs de la relève locale qu’aux artistes internationaux très reconnus."
      }
    ],
    "http://ogp.me/ns#url": [
