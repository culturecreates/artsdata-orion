    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Concert-film | Les Légendes de l’Abitibi-Témiscamingue"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Les Légendes de l’Abitibi-Témiscamingue est un concert-film immersif où l’art du conte et le cinéma se rencontrent sur scène. Activité présentée dans le cadre du Festival de contes et légendes de l’Abitibi-Témiscamingue. Portée par les voix des conteurs Marta Saenz de la Calzada, Pierre Labrèche, André Bernard et Tina Mapachee, l’expérience prend vie grâce aux images créées par les cinéastes Émilie Sigouin, Charles-Antoine Chouinard et Hélène Théberge, sur une trame musicale originale signée Dominiq Hamel. Le résultat est une oeuvre collective ancrée dans l’imaginaire de l’Abitibi-Témiscamingue, une soirée où les légendes d’ici se racontent autrement, entre parole vivante, grand écran et musique. Date mise en vente : 3 juin 2026"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
