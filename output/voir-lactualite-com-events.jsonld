    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "concert à ne pas manquer"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le 20 décembre prochain, venez vous mettre dans l'ambiance du temps des fêtes avec nous! Les choristes chanteront en chœur plusieurs chants de Noël, des plus classiques aux plus populaires. Le nombre de billets en vente à la porte sera limité, alors faites vite et procurez-vous vos billets à l'avance auprès de tous les choristes ou en contactant M. Marc Raymond au [phone]. C'est un concert à ne pas manquer! Prix des billets : 20 $ Date : Dimanche 20 décembre Horaire : 14 h 00 Endroit : La Belle Église Information : [phone]"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
