      {
        "@id": "https://voir.lactualite.com/genid/c55a952678f94a54"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/1d9f0fde4a8c006d"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/duo-bachand-touchette-c91149"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Duo Bachand-Touchette"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Quand le trombone d’Édouard Touchette rencontre la contrebasse de Sébastien Bachand, c’est une conversation musicale riche en émotions et en surprises. Leur complicité se révèle dans chaque note, chaque silence, chaque regard. À travers leurs interprétations de standards de jazz, leurs compositions originales et leurs réarrangements de chansons folkloriques, Édouard et Sébastien dialoguent avec une spontanéité et une créativité qui captivent leur public. Avec eux, le jazz devient un langage universel, une manière de raconter des histoires et de partager des moments authentiques. Le duo lance en 2025 son premier album, intitulé « Herbarium »!"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
