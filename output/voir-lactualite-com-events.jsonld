      {
        "@id": "https://spec.qc.ca/uploads/_1200x630_crop_center-center_82_none/alexandre-belliard-horizontal-b1393de9acd81329f232.jpeg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://voir.lactualite.com/evenements/alexandre-belliard-lp5-72"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://voir.lactualite.com/genid/fac4110af083fea5"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://voir.lactualite.com/artistes/alexandre-belliard-8da491#artist"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/ea2e4edaefe68758"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/alexandre-belliard-lp5-72"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Alexandre Belliard"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "L'art de la parole Après quatre saisons à la barre de la série Légendaires et immortels, présentée par la SPEC, Alexandre Belliard poursuit sa démarche artistique avec ce tout nouveau spectacle où il prête vie aux grandes figures de notre culture. À travers des récits sensibles et des chansons inspirées de son projet monumental, Légendes d'un peuple, il nous fait redécouvrir Yvon Deschamps, Clémence DesRochers, Serge Bouchard et bien d'autres personnes qui ont marqué notre paysage culturel. Chaque récit s'enrichit de sa voix et de sa guitare, offrant une expérience vivante où ces figures marquantes ravivent les souvenirs et résonnent avec notre présent. Culture éclatante Avec son charisme de conteur, son humour et son regard d'auteur-compositeur, Alexandre Belliard revisite notre mémoire collective avec finesse. Depuis 2012, il propose une approche originale qui rapproche le public de celles et ceux qui ont façonné notre culture, en donnant vie à leurs parcours et à leur héritage. Une rencontre sensible avec des figures marquantes, racontées avec humanité et passion. Conte. Texte et interprétation : Alexandre Belliard. Production : Agence BAM. Durée : 1 h 15, sans entracte. Tarifs Régulier: 35 $ Étudiant: 23 $ Forfait culturel L'Art de la parole 3 spectacles: 18.33 $ ch. 6 spectacles: 11.67 $ ch."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
