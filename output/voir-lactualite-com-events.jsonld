    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Christian Marc Gendron Trilogie"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Christian Marc Gendron propose Trilogie, un spectacle qui réunit les meilleurs numéros de ses trois dernières tournées et y ajoute de nouvelles créations inspirées du répertoire de grands pianistes comme Jerry Lee Lewis, Ray Charles, Stevie Wonder, Elton John et Billy Joel. Un hommage à Gino Vannelli et plusieurs moments d'humour figurent aussi au programme. Il succède à la série de concerts PianoMan, qui a rassemblé plus de 150 000 spectateurs au Québec. L'artiste est accompagné de neuf musiciens, sous la direction musicale de Simon Godin, avec la participation de Manon Séguin."
      }
    ],
    "http://schema.org/eventStatus": [
