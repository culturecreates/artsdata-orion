    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 29 octobre 2026 à 20 h, à Théâtre Le Patriote - Salle Percival-Broomfield (Sainte-Agathe-des-Monts). Christian Marc Gendron revient sur scène avec un tout nouveau spectacle : Trilogie."
      }
    ],
