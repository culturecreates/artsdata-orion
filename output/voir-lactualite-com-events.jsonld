    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le vendredi 7 mai 2027 à 20 h, Centre des Arts (Shawinigan). Disons que le titre donne le ton! Depuis toujours, Nantel est cette voix différente qui ose dire…"
      }
    ],
    "http://ogp.me/ns#url": [
