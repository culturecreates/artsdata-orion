    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "ARCHITECTURES OUTSIDER - Exposition — Montréal | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 21 octobre 2026 à 0 h, à Centre Pierre-Péladeau (Montréal). Exposition présentant une vingtaine de maquettes-sculptures de grand format et les relevés minutieux de constructions singulières d'architectures sans architecte étudiées par Katherine Lapierre."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://voir.lactualite.com/evenements/architectures-outsider-exposition-b527d4"
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
        "@value": "fr_CA"
      }
    ],
    "http://ogp.me/ns#image": [
