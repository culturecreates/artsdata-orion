      {
        "@language": "fr-ca",
        "@value": "Cours de peinture- adultes à Rouyn-Noranda — jusqu’au 3 déc. 2026 | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Jusqu’au 3 décembre 2026, MA musée d'art (Rouyn-Noranda). Cet atelier de peinture s’adresse à toute personne souhaitant expérimenter différentes techniques…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://voir.lactualite.com/evenements/cours-de-peinture-adultes-3aa82d"
      }
