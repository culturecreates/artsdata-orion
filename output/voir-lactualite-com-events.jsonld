    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Dimanche aquarelle"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Bienvenue dans votre bulle créative du dimanche ! Durant cet atelier aquarelle de 3 heures, vous aurez l’occasion de vous exercer sur les bases de cette technique, de tester les outils incontournables, de pratiquer avec des exercices adaptés, de créer votre projet personnel, en suivant le thème proposé (ou non). De nombreux modèles d’inspiration sont à votre disposition Vous pouvez participer à un seul ou plusieurs de ces dimanches aquarelle. L’animatrice s’adaptera à vos envies, votre niveau et pratique. Pour tous niveaux. Tout le matériel est inclus. Café ou thé/tisane offert."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
