        "@value": "Aymen Mbarki"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "La pratique d’Aymen Mbarki explore les relations entre langage, mythologie, poésie et geste. Ses compositions, d’une grande sobriété graphique, oscillent entre figuration, abstraction et formes théâtrales. La ligne noire, élément récurrent de son travail, devient un outil pour faire émerger des scènes et des créatures à la frontière du réel et de la fiction."
      }
    ],
