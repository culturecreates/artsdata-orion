    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "À deux roues, la vie! — Montréal | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 30 janvier 2027 à 16 h, à Théâtre Desjardins (Montréal). À deux roues, la vie! est une production de Dynamo Théâtre, destinée au public familial à partir de 6 ans. Un homme revient après une longue absence et se trouve face à un héritage familial dans lequel il ne se reconnaît pas. Ne sachant…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://voir.lactualite.com/evenements/a-deux-roues-la-vie-10beba"
      }
    ],
