        "@id": "https://voir.lactualite.com/genid/d8ea46b2d4e5fcd8"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://tuxedov1.blob.core.windows.net/tuxedo-valmorin/show/La%20famille%20Leblanc_-OrEMLRzcFT7G3xoftf6_.png"
      }
    ],
    "http://schema.org/url": [
      {
