    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Bleu Jeans Bleu — Rimouski | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 22 avril 2027 à 20 h, à Salle Desjardins-Telus (Rimouski). Les gars de Bleu Jeans Bleu font du bien. Ils l’ont toujours fait, et ils poursuivent sur leur lancée avec un tout nouveau spectacle, la tournée Record NoV. L’élégance d’un parfum haut de gamme, le réconfort d’un macaroni à la viande.…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://voir.lactualite.com/evenements/bleu-jeans-bleu-acbee2"
      }
    ],
