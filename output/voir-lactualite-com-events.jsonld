    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "QW4RTZ Ça Goûte Noël"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Cet hiver pour le temps des Fêtes, QW4RTZ vous a mijoté un spectacle entremêlant chansons, recettes, humour et anecdotes savoureuses. Arômes de cannelle, effluves de girofle et muscade, chacun de vos quatre chefs/cuistots de l'a cappella y présente, en chanson, la recette de son plat signature du temps des Fêtes. Vos oreilles se délecteront des meilleurs succès de Noël, de l'électro-trad à Marie-Noël en passant par Last Christmas et Le sentier de neige, clairement... Ça Goûte Noël !"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
