    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Songwriters Spotlight – Song Swaps"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Our Songwriters Spotlight concert series, hosted by Briana Doyle and Seiji Gutierrez, celebrates the depth, diversity, and heart of our local songwriting community. Inspired by the classic Nashville-style song circle, this intimate concert brings diverse groups of local songwriters together on stage, taking turns performing their original songs. Some will play solo, others may support one another — […]"
      }
