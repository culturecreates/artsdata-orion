  {
    "@id": "https://voir.lactualite.com/evenements/aswell-berger-1a47bb",
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#site_name": [
