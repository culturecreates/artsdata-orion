    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Chasse au godard"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "En décembre 1968, en Abitibi, alors que le réalisateur Jean-Luc Godard visite la ville de Noranda, deux jeunes, Michel et Marie, exaltés par la visite, se lancent dans une quête identitaire et sociale. Comme les jeunes de sa région, Marie est divisée entre l'attachement à sa famille et sa région et le désir de l'exode vers la grande ville. Avec Sophie Desmarais, Alexandre Castonguay et Martin Dubreuil. 2013. Le film sera précédé du court métrage OPASATICA. Prolongez l'expérience 100 ans de cinéma à Rouyn-Noranda dans le foyer du Théâtre du cuivre! La projection sera suivie d'un échange avec le réalisateur Éric Morin. Le bar sera ouvert pour l'occasion."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
