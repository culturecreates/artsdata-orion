    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Dernier verre du condamné"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le tavernier Jos Vaillancourt vous ouvre la porte de son établissement le temps d'une soirée. Apprenez-en sur la vie nocturne au 19e siècle à travers les loisirs, les excès... et les conséquences! Animation historique et dégustation de bières Le tavernier Jos Vaillancourt vous ouvre la porte de son établissement le temps d'une soirée pour vous faire découvrir la vie nocturne au 19e siècle avec des histoires liées à la justice militaire, aux loisirs et aux punitions des soldats à cette époque. La soirée comprend une dégustation de bières avec ou sans alcool."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
