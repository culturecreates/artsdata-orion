    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Club sandwich mayonnaise"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Club sandwich mayonnaise est une pièce de Manuelle Légaré, qui en est l'autrice et l'interprète aux côtés de Sylvie De Morais-Nogueira, Alice Pascual et Martin-David Peters. La mise en scène est signée François Bernier. Le spectacle part de l'accompagnement de son père, l'humoriste Pierre Légaré, qui avait choisi l'aide médicale à mourir. Entre récit intime et enquête sociale, entre humour et vertige existentiel, la pièce explore les enjeux humains et éthiques de cette nouvelle façon de mourir au Québec, où l'aide médicale à mourir représente déjà plus de 7 % des décès annuels. Il s'agit de la première fois que Manuelle Légaré monte sur scène. La durée est de 100 minutes."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
