    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Douglas Show"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le Douglas Show est un gala d'humour présenté par Agropur, qui réunit plusieurs humoristes autour d'une cause : le spectacle vise à financer le Centre de recherche Douglas, qui étudie les maladies mentales afin de mieux les comprendre et de mieux les traiter. Il s'agit d'un rendez-vous annuel animé par Jo Cormier. Pour l'édition 2027, les artistes annoncés sont Laurent Paquin, Adib Alkhalidey, Korine Côté, Simon Gouache et Charles-Antoine Des Granges. Le gala se tient au Théâtre St-Denis."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
