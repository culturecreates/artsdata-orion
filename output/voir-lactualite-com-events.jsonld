    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Deux amies explorent ce pays fabuleux à travers sa richesse culturelle et ses traditions encore bien vivantes. Des montagnes spectaculaires, des lacs turquoise, des vallées verdoyantes et la côte de la mer Adriatique… Un voyage captivant où les paysages sublimes et les histoires humaines se conjuguent pour offrir une aventure… qui vous charmera à coup sûr!"
      }
