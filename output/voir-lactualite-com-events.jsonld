    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Casse-Noisette"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "La compagnie BO Montréal (Ballet Ouest de Montréal) est à la recherche de près de 80 danseurs et danseuses pour combler divers rôles du spectacle à grand déploiement Casse-Noisette présenté du 17 au 19 décembre 2026 à L'Assomption! Critères de participation aux auditions : Être âgé de 7 ans et plus (en date du 30 septembre 2026) Demeurer dans la région de Lanaudière Être inscrit dans une école de danse de la région de Lanaudière C'est la chance de vivre une expérience inoubliable!"
      }
    ],
    "http://schema.org/eventStatus": [
      {
