    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Cabaret Jazz Band"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le Cabaret Jazz Band célèbre le répertoire intemporel de Joe Dassin dans un spectacle porté par la voix de Jean-François Poulin. Accompagné de l'orchestre dirigé par Pierre-Armand Tremblay, l'artiste revisite les plus grands succès du chanteur français à travers des arrangements jazz élégants et raffinés. Une soirée remplie de souvenirs, de mélodies inoubliables et de chansons qui ont traversé les générations. Ce qu'ils en disent : « Très beau spectacle! Nous rappelle de beaux souvenirs. Une scène pleine de talents avec beaucoup d'ambiance. » - André G. « Quel bon spectacle! Des chansons de mon enfance et adolescence... j'en veux encore! » - Francine B. « Très bien. Bon choix de pièces musicales. Excellents musiciens, solistes et chanteur invité. Merci! » - Richard L."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
