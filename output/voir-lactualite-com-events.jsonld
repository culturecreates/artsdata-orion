    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Cinéma à la piscine"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "dans le cadre de la Semaine nationale de la prévention de la noyade Vivez une expérience unique en regardant un film dans l’eau ou sur le bord de la piscine ! Piscine Saint-Jean-Baptiste 25 juillet, 18 h 30 Projection : Bob l’éponge, le film : À la recherche de Bob Prêt de bouées de piscine gonflables (quantité limitée) Présence d’un parent obligatoire pour les enfants de 13 ans et moins"
      }
