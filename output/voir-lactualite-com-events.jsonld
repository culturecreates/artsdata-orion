    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Annie Villeneuve"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "La chanteuse Annie Villeneuve sera en spectacle le samedi 15 mai 2027 à 20 h au Magasin général Le Brun de Maskinongé. Ne manquez pas l’occasion de vivre un moment magique avec Annie Villeneuve! Dans ce tout nouveau spectacle, laissez-vous transporter par sa voix saisissante et plongez dans l’univers de son dernier album, ÊTRE MOI. Avec des sonorités new country qui confère une énergie vibrante à chaque chanson, Annie vous réserve une soirée riche en émotions, pleine de chaleur et d’authenticité, vous offrant aussi un retour sur ses plus grands succès des deux dernières décennies. Une soirée à ne pas manquer – réservez vite votre place pour partager ce moment inoubliable!"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
