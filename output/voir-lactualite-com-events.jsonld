      }
    ]
  },
  {
    "@id": "https://voir.lactualite.com/genid/10bc1ac5405f98f5",
    "@type": [
      "http://schema.org/LiteraryEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-10T18:00:00-05:00"
      }
    ],
