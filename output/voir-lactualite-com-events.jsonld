    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Comment Debord"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Comment debord reprend la route! Fidèle à son énergie festive contagieuse, le groupe montréalais débarque avec un nouveau spectacle aux influences disco-funk et indie pour défendre son nouvel album. Célébré par la critique pour ses grooves entraînants (9 nominations aux galas de l’ADISQ depuis son premier album), le jam band a décidé cette fois de pousser sa démarche plus loin encore en composant un opus résolument dansant, fait sur mesure pour être transposé sur scène. Ayant tourné aux quatre coins du Québec, comment debord sait fédérer, avec ses textes québécois rassembleurs, tendres et intelligents."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
