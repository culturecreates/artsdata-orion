    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Carignan en couleurs"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Pour sa 3e édition, l’événement se déroulera sous la couleur thématique « vert ». Carignan en couleurs c’est l’événement culturel de l’année célébrant le domaine culturel sous toutes ses formes ! Plusieurs activités vous attendent : création artistique en direct, projection vidéo de conte, DJ et bien plus encore ! Le 17 octobre, c’est un rendez-vous à la place publique de la MG3 pour une soirée complètement éclatée et créative !"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
