    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Bruno Pelletier"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Plongez dans la magie des Fêtes avec un concert intime porté par la voix exceptionnelle de Bruno Pelletier et son quatuor à cordes. Un moment chaleureux où résonnent Minuit chrétien, Ave Maria, I’ll Be Home for Christmas et les plus beaux classiques du temps des Fêtes, revisités avec toute la sensibilité qu’on lui connait. (PAS de vente de billets à l’entrée)"
      }
    ],
