    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Conférence | La communauté anglophone de Saint-Eustache, une histoire méconnue – avec Vicki Onufriu"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dans le cadre du 175e anniversaire de décès de William Henry Scott, l’Espace muséal du manoir Globensky vous invite à découvrir une histoire méconnue, celle de la communauté anglophone de Saint-Eustache, avec l\\'historienne Vicki Onufriu. Aujourd\\'hui une salle de spectacle réputée, La Petite église Cabaret spectacle était autrefois le lieu de culte de la communauté […] \\n"
      }
    ],
