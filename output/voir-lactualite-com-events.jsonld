      {
        "@language": "fr",
        "@value": "Blind date avec un livre"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Laissez-vous surprendre par votre prochaine lecture! Choisissez parmi une sélection d’une vingtaine de livres soigneusement emballés. Quelques indices sur la couverture vous aideront à faire votre choix… sans dévoiler le titre! Disponible du 17 au 24 octobre. - Activité dans le cadre de la Semaines des bibliothèques publiques"
      }
