      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 10 juin 2026 à 0 h, à Musée minéralogique de l'Abitibi-Témiscamingue (Malartic). Dès le 10 juin 2026, avec la collaboration d’Agnico Eagle, le Musée minéralogique de l’Abitibi-Témiscamingue présentera l’exposition Creuser les pixels : les minéraux dans les jeux vidéo, une expérience interactive…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
