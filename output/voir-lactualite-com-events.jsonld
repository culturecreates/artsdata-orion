    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Dan Bigras en spectacle"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Cette Voix : Dan et Gerry, notre histoire est un spectacle de Dan Bigras qui rend hommage à son ami Gerry Boulet. Bouleversé dès la première écoute de la chanson La voix, Dan Bigras raconte comment sa carrière musicale a été rendue possible grâce à l'aide de celui qui est devenu un grand ami musical. Le parcours est raconté à travers anecdotes et chansons gravitant autour de l'univers de ce rockeur, jusqu'à l'album Jézabel, réalisé par Dan Bigras. Sur scène, l'artiste s'est donné le défi de ramener Gerry avec lui et ses musiciens, entremêlant leurs voix et leurs instruments."
      }
    ],
