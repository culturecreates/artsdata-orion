    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Boîtier coloré"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Les immenses tableaux hyperréalistes de David Elliott suggèrent un assemblage de découpages variés et colorés. Inspirez-vous de sa méthode de travail et réalisez votre propre agencement d’images! Les ateliers de création pour tous, un rendez-vous incontournable pour les familles! Un atelier inspiré d’une œuvre de notre collection ou d’une exposition en cours est offert chaque semaine. Une façon amusante et conviviale de s’initier aux arts plastiques. Nouveauté : certains vendredis s'ajoutent à notre calendrier d'ateliers, lorsque les centres de services scolaires des environs du Musée prévoient une journée pédagogique. Surveillez notre site web pour planifier vos activités de la journée!"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
