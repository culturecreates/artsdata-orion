      }
    ]
  },
  {
    "@id": "https://voir.lactualite.com/genid/348b250d0c9db43f",
    "@type": [
      "http://schema.org/ComedyEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-06T00:00:00-05:00"
      }
    ],
