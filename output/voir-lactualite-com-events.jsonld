  {
    "@id": "https://voir.lactualite.com/genid/16420ee869204303",
    "@type": [
      "http://schema.org/MusicEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-04-11T20:00:00-04:00"
      }
    ],
