    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Club Mordus des livres"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "APPEL à tous les passionnés de lecture qui souhaitent partager leur passion des livres avec d’autres passionnés comme eux… Animées par une employée de la Bibliothèque, ces rencontres se déroulent dans un cadre informel et convivial et offrent aux participants une occasion unique de partager avec d’autres membres du Club leur expérience de lecture d’un livre qui leur a particulièrement « plu » ou carrément « déplu »."
      }
    ],
