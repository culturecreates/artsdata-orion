    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le samedi 20 février 2027 à 20 h, Pavillon des Arts de la scène (Varennes). En ces temps d’incertitude, une chose reste inébranlable dans le cœur de Simon : il…"
      }
