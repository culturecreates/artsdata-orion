    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Alexandre Barrette - Ouvert"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Mon nouveau show s’appelle OUVERT. Bien que je sois habituellement pudique sur ma vie privée, je m’ouvre comme jamais dans ce spectacle! Et aussi, quand même important, je crois que vous allez rire beaucoup! Remboursements Aucun remboursement Échanges Aucun échange Gratuité pour les enfants Aucune gratuité Accès pour personnes à mobilité réduite Oui Mon nouveau show s’appelle OUVERT. Bien que je sois habituellement pudique sur ma vie privée, je m’ouvre comme jamais dans ce spectacle! Et aussi, quand même important, je crois que vous allez rire beaucoup! Remboursements Aucun remboursement Échanges Aucun échange Gratuité pour les enfants Aucune gratuité Accès pour personnes à mobilité réduite Oui"
      }
    ],
