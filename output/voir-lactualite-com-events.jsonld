    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Ciné-Musée : Mains d’œuvre – Une vie en poésie"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dernière séance de l’automne de Ciné-Musée, la série gratuite du Musée d’art de Joliette présentée en partenariat avec le Festival International du Film sur l’Art (FIFA). Au programme : Mains d’œuvre – Une vie en poésie, documentaire de Jean-Philippe Dupuis et Vincent Lambert qui trace le portrait d’une vie vouée à la poésie, entre travail manuel, création et transmission. Après la projection, la discussion se poursuit en salle autour de l’œuvre de Renée Lavaillante À tes dépens si tu te perds, où les souvenirs se dessinent peu à peu sur le papier. Gratuit. Réservation facultative, mais recommandée."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
