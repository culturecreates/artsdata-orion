      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 8 octobre 2027 à 0 h, à Lieu à préciser (Montréal) (Montréal). Christian Marc Gendron propose Trilogie, un spectacle qui réunit les meilleurs numéros de ses trois dernières tournées et y ajoute de nouvelles créations inspirées du répertoire de grands pianistes comme Jerry Lee Lewis, Ray…"
      }
    ],
    "http://ogp.me/ns#url": [
