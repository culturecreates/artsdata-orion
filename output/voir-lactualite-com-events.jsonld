      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 29 août 2027 à 13 h, à bibliothèque St-Hippolyte (Saint-Hippolyte). Sur une période de quatre semaines, venez apprendre tous les secrets du feutrage de la laine à l’aiguille, en compagnie de l’artiste Félix Lapierre. En plus de vous apprendre les bases du feutrage, il vous accompagnera tout au…"
      }
    ],
