    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Causerie avec André Marois"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dans le cadre de la Semaine des bibliothèques publiques. Depuis 1999, André Marois publie des romans noirs pour les adultes, des romans policiers et de science-fiction pour les enfants et les adolescents, ainsi que des nouvelles et des albums pour les plus jeunes. Il aime raconter des histoires sombres, souvent teintées d’humour noir. Côté adultes, […]"
      }
    ],
