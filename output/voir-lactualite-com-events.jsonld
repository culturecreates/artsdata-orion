    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Alexe – 11:11 à Alma — 19 févr. 2027, Boite A Bleuets | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le vendredi 19 février 2027 à 20 h, Boite A Bleuets (Alma). Native du Saguenay–Lac-Saint-Jean, Alexe est découverte lors de l’émission La Voix. Elle se fait…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://voir.lactualite.com/evenements/alexe-11-11-209c3f"
