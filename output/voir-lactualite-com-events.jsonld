    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/1faac1682bae3ed8"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/comite-organisateur-secondaire-en-spectacle-cfb729"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Comité organisateur - Secondaire en spectacle"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Tu aimes la musique, la danse, le théâtre, l’humour ou tout ce qui se passe derrière la scène? Joins-toi au comité organisateur de Secondaire en spectacle! Tu participeras à la création de notre finale locale, de la sélection des numéros jusqu’à l’organisation et à l’animation de l’événement. Décors, logistique, communication, ambiance, technique : il y a une place pour toutes les idées et tous les talents! Et surtout, ton implication pourrait te mener beaucoup plus loin! En participant au comité, tu contribueras à la réalisation d’un événement permettant à nos artistes de poursuivre leur parcours jusqu’à la finale régionale, puis au Rendez-vous panquébécois de Secondaire en spectacle! En t’inscrivant, ton parent (ou toi, si tu as plus de 14 ans) autorise la prise de photos et de vidéos dans le cadre de l’activité et la diffusion de celles-ci sur les différentes plateformes du Collège. Si vous ne souhaitez pas donner cette autorisation, veuillez nous contacter."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
