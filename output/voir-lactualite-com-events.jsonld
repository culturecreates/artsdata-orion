    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Daniel Grenier - Coeur d'enfant"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Daniel Grenier présente Coeur d'enfant, un spectacle d'humour où il invite à refuser de laisser la vie user l'émerveillement et à garder une certaine légèreté face au monde. Il y propose une soirée drôle, sensible et surprenante, rappelant que la joie peut être nourrie chaque jour plutôt que vue comme un luxe. L'artiste est aussi l'auteur d'Histoires de balle, son premier livre jeunesse."
      }
    ],
