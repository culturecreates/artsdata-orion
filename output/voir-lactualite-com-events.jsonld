        "@id": "https://voir.lactualite.com/evenements/betty-bonifassi-25728a"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Betty Bonifassi"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Betty Bonifassi propose un spectacle simple et sans artifice, qu'elle présente avec ses amis Martin Lizotte et Alexis Dumais. Après 35 ans de chant et d'écriture, une censure, une pandémie, un cancer et un passage sur trois continents, elle raconte son parcours musical, de sa ville natale de Nice jusqu'au Québec et à l'Afrique, à travers des reprises et des compositions. Le spectacle a été construit de façon organique, dans le but d'être libre musicalement. Il est présenté en formule assise."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
