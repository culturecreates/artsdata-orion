    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/7ef858861e9b75c5"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/club-de-lecture-les-rendez-vous-du-1er-roman-f901da"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Club de lecture: Les rendez-vous du 1er roman"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Découvrez et encouragez les écrivaines et écrivains de la relève québécoise, partagez vos impressions avec d’autres lecteurs passionnés et votez pour vos favoris, dans le cadre du club de lecture Les rendez-vous du 1er roman. Les rencontres se tiendront les vendredis 9 octobre, 6 novembre et 4 décembre, ainsi que 29 janvier et 26 février de 14 h à 15 h 30 à la bibliothèque « Le Survenant » (145, rue George) et seront consacrées aux romans suivants: Inondables, de Marilyne Busque-Dubois Dans l’ordre des choses, de Danièle Belley Épinette, d’Isabelle Lapointe Implosion, de Laurence Florisca Rivard C’était ça ou mourir, de Thélyson Orélien Le junk, d’Arthur Friso Le bézoard, de Pascale Montpetit Une certaine tristesse, de Mattis Savard-Verhoeven Animation: bibliothèques de Sorel-Tracy Inscriptions Pour participer, vous devez réserver gratuitement votre place à compter du 2 septembre en vous inscrivant en ligne Il sera possible de vous inscrire jusqu'à la date de la première rencontre, si des places sont disponibles. Pour plus de renseignements, vous pouvez contacter l'équipe des bibliothèques au [phone], poste 4753, ou en écrivant à [email] Le local où se déroulera l'activité est accessible aux personnes à mobilité réduite grâce à la porte d'entrée située à l'arrière de la bibliothèque."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
