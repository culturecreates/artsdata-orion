    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 22 août 2027 à 16 h, à Place des Anciens-Combattants (Rimouski). Cet atelier de danse traditionnelle maorie est offert par des animateurs et animatrices arrivées directement de Nouvelle-Zélande. Le haka est une danse chantée pratiquée lors de manifestations, de cérémonies et de compétitions…"
      }
    ],
    "http://ogp.me/ns#url": [
