  {
    "@id": "https://voir.lactualite.com/genid/dc09a05ec21929de",
    "@type": [
      "http://schema.org/MusicEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-04-16T20:00:00-04:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-04-16T23:00:00-04:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://voir.lactualite.com/genid/d8ea46b2d4e5fcd8"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://tuxedov1.blob.core.windows.net/tuxedo-valmorin/show/Carl%20Mayotte_-Op9R5qNYuD_0B7kPfZM_.png"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://voir.lactualite.com/evenements/carl-mayotte-claude-lp1-658"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://voir.lactualite.com/genid/d260b940df73c287"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://voir.lactualite.com/artistes/carl-mayotte-3205a1#artist"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/9c751e62cbf948cd"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/carl-mayotte-claude-lp1-658"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Carl Mayotte Claude"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le nouveau concert de Carl Mayotte présentera la musique de son prochain album Claude. Fidèle à l’énergie et à la virtuosité qui distinguent son groupe, le spectacle ajoutera une dimension plus émotive et introspective. Inspirée par deux épreuves marquantes, dont le décès de son père, cette musique allie nostalgie et délivrance. Une expérience qui vous donnera à la fois un sourire et des frissons. Avec Claude, Carl Mayotte propose une œuvre à la fois intime et lumineuse, inspirée par deux événements marquants de sa vie : l’incendie de son appartement en 2023 et le décès de son père en 2024. De ces épreuves est née une musique où la nostalgie se mêle à la joie du souvenir, portée par un langage sonore renouvelé qui puise autant dans le jazz contemporain que dans l’indie-pop et la scène fusion anglaise actuelle. Par ce projet, le musicien rend hommage à son père, Claude Mayotte."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
