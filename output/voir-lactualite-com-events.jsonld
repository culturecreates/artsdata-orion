    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/anasa-d-evridiki-spiliadis-lp1-141"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Anása - Ανάσα, d'Evridiki Spiliadis"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Occurrence a le plaisir de présenter l’exposition Anása - Ανάσα, d’Evridiki Spiliadis dans la salle 1 de la galerie, du 6 novembre au 12 décembre 2026. Anása (souffle) est à la fois origine et retour. C’est le premier geste de la vie, le rythme qui soutient le corps, et la dernière trace d'une présence physique. Ancré dans le mythe de Déméter et Perséphone, Anása réinterprète l'ancien cycle de descente et de renouveau comme une méditation sur la résilience féminine. Il réunit mythe ancestral, mémoire incarnée et les paysages contemporains qui portent les traces de nos histoires vécues. Le travail se déploie à travers deux paysages éloignés, mais intimement liés. Éleusis, ancien site des Mystères d’Éleusis, ouvre un passage vers les origines du mythe, révélant comment les récits ancestraux persistent à travers le temps. L’Île Verte, une île étroite du fleuve Saint-Laurent, devient un territoire de recherche et de renouveau. Située à la rencontre des eaux douces et salées, l’île incarne une tension silencieuse, un environnement propice à l’intuition et aux rythmes du monde naturel. Libéré des responsabilités domestiques et des rôles relationnels, le corps féminin réapparaît dans sa fragilité, son endurance et son besoin d’espace. Ensemble, ces voyages forment un dialogue entre mythe hérité et expérience vécue. Anása émerge de cet entrelacement entre héritage mythologique, trace autobiographique et pratique créative comme recherche incarnée. Le projet parle de continuité, des mères, des filles et du fil invisible qui les relie à travers les générations. Il nous invite à écouter ce qui demeure inexprimé, à ressentir la lente expiration de la mémoire à travers le mythe et à reconnaître le souffle lui-même comme un acte de résistance et de renouveau. Il marque non pas une fin, mais un début: une manière renouvelée de voir, d’écouter et de respirer à travers les récits qui nous façonnent."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
