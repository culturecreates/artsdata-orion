      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 26 septembre 2027 à 13 h 30, à Bibliotheque De Sainte-Julie (Sainte-Julie). Isabelle Grondin propose un atelier de broderie sur papier, une technique artistique alliant dessin et travail du fil. L'activité permet aux participants de découvrir cette approche créative."
      }
    ],
    "http://ogp.me/ns#url": [
