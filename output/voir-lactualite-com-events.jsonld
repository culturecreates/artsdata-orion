      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://ccbnwebprod.blob.core.windows.net/website/Activités-et-événements/Abracadabra/_1200x630_crop_center-center_none/2023-DA-3.jpg"
      }
    ],
    "http://schema.org/url": [
