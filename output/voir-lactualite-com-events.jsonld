    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Bruno Pelletier 3 & moi"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "3 & Moi est un spectacle de Bruno Pelletier qui revisite les titres ayant marqué ses 40 années de carrière. Il s'entoure de trois musiciens : Martin Bachand à la guitare, Claude Pineault à la guitare, au piano et à la basse, et la chanteuse Brigitte Marchand. Ensemble, ils misent sur la force des harmonies vocales et des arrangements recherchés. Le spectacle se veut festif, vivant et plein de surprises."
      }
    ],
