    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Prochaine date le mardi 15 juin 2027 à 7 h, Hôtel de Ville de Cowansville (Cowansville), et 4 autres dates jusqu’au 19 juin 2027. Du 15 au 19 juin, entre 7 h…"
      }
