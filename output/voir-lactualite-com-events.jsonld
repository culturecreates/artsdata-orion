    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Drôle depuis 1957"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Michel Barrette présente Drôle depuis 1957, son tout nouveau spectacle, dans lequel il porte un regard drôle et tendre sur sa génération. Il y célèbre « la revanche des baby-boomers », ces jeunes d'hier devenus les grands sages d'aujourd'hui, toujours irrévérencieux. À travers anecdotes, souvenirs et observations, il raconte son époque. Le spectacle se présente comme une lettre d'amour au passé et un clin d'œil au présent."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
