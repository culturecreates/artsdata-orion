    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Dominic Paquet – J’comprends la game"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dominic Paquet, populaire humoriste, présente J'comprends la game, son 5e spectacle solo et un nouveau one-man-show. Le spectacle est décrit comme un laboratoire humoristique où Dominic explore, examine et met en évidence des théories farfelues pour répondre à des questionnements que personne n'a jamais eus. Il y incarne des personnages uniques et crée des expressions. Son spectacle précédent avait permis de vendre plus de 250 000 billets."
      }
    ],
