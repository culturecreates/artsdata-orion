      }
    ]
  },
  {
    "@id": "https://voir.lactualite.com/genid/82cb2c3979512bf2",
    "@type": [
      "http://schema.org/ExhibitionEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
