    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Bon jus"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Arnaud Soly revient sur scène avec Bon jus, son deuxième one-man-show. Selon l'humoriste lui-même, il s'agit de son meilleur spectacle à ce jour. Le titre, qu'il qualifie de bizarre, ne sera expliqué qu'en salle."
      }
    ],
    "http://schema.org/inLanguage": [
