      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 29 octobre 2026 à 19 h 30, à The Church of St. Andrew and St. Paul (Montréal). All are invited to the A&P Choir’s Fall Cabaret on October 29, held at 7:30 p.m. in beautiful Kildonan Hall at The Church of St. Andrew and St. Paul. Enjoy a delightful evening of solo arias, duets, musical theatre…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://voir.lactualite.com/evenements/a-p-choir-s-fall-cabaret-967269"
      }
    ],
