    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Cabaret Drag avec Eva Moist"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Voyez Les Cabaret Drag avec Eva Moist et ses invitées. Présenté une fois tous les deux mois, les cabarets drag vous réservent 3 invités surprises à chaque édition. Piloté par nulle autre qu'Eva Moist, c'est la soirée drag à ne pas manquer à Drummondville. Jeudi 15 octobre 2026 à 20h00. Ouverture des portes à 19h00. Spectacle présenté en cabaret avec places assignés. Ouvert aux publics de tous âges. Facile d'accès pour les personnes à mobilité réduite. Service de bar complet sur place. Vente aux abonnés dès le 28 avril à 9h00AM Vente régulière dès le 1er mai 2025 à midi Régulier: 30,00$ Membre: 26,00$ Remboursements Aucun remboursement Échanges Aucun échange Gratuité pour les enfants Gratuit pour les 6 ans et moins Accès pour personnes à mobilité réduite Oui Gratuité pour l'accompagnateur Non Voyez Les Cabaret Drag avec Eva Moist et ses invitées. Présenté une fois tous les deux mois, les cabarets drag vous réservent 3 invités surprises à chaque édition. Piloté par nulle autre qu'Eva Moist, c'est la soirée drag à ne pas manquer à Drummondville. Jeudi 15 octobre 2026 à 20h00. Ouverture des portes à 19h00. Spectacle présenté en cabaret avec places assignés. Ouvert aux publics de tous âges. Facile d'accès pour les personnes à mobilité réduite. Service de bar complet sur place. Vente aux abonnés dès le 28 avril à 9h00AM Vente régulière dès le 1er mai 2025 à midi Régulier: 30,00$ Membre: 26,00$ Remboursements Aucun remboursement Échanges Aucun échange Gratuité pour les enfants Gratuit pour les 6 ans et moins Accès pour personnes à mobilité réduite Oui Gratuité pour l'accompagnateur Non"
      }
    ],
