    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Au cœur du pays"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Les chansons de Gilles Vigneault s’apprêtent à reprendre vie sur scène sous de nouveaux habits. Le spectacle Au cœur du pays, inspiré de l’album multi-artistes du même nom paru chez Bravo musique, sera présenté le 12 juin 2027 à la Salle Wilfrid-Pelletier, dans le cadre des Francos de Montréal."
      }
