    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Biblio-maison"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Biblio-maison est un service de livraison de documents à domicile pour les résidents et résidentes de Notre-Dame-de-l'Île-Perrot qui ont de la difficulté à accéder à la bibliothèque en raison d'une limitation permanente ou temporaire. Le service est proposé par la Ville de Notre-Dame-de-l'Île-Perrot. Les livraisons sont effectuées les vendredis, aux trois semaines."
      }
    ],
