  {
    "@id": "https://voir.lactualite.com/genid/87d9321875bafa84",
    "@type": [
      "http://schema.org/TheaterEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-02-25T19:30:00-05:00"
      }
    ],
