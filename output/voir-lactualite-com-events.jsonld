  {
    "@id": "https://voir.lactualite.com/genid/9880c3225e7dc00f",
    "@type": [
      "http://schema.org/LiteraryEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
