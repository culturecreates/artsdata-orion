    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "CRÉATION D’UNE POCHETTE PERSONNALISÉE EN SUBLIMATION CRICUT INFUSIBLE INK™"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Découverte de la sublimation textile et personnalisation d’une pochette durable à l’aide de la Cricut AutoPress™. Possibilité de créer son propre design avec Cricut Design Space, d’utiliser les feuilles Infusible Ink™ ou de transférer une image imprimée avec une imprimante à sublimation. Cet atelier initiera les participants aux bases de la conception numérique, à la préparation des fichiers et à l’utilisation sécuritaire d’une presse thermique."
      }
    ],
    "http://schema.org/inLanguage": [
