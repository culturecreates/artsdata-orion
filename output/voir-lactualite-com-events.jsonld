      }
    ]
  },
  {
    "@id": "https://voir.lactualite.com/genid/93f645bf287cfaf8",
    "@type": [
      "http://schema.org/TheaterEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-12-19T17:00:00-05:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-12-19T18:30:00-05:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://voir.lactualite.com/genid/d72b4b80c8665719"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://www.laval.ca/wp-content/uploads/2026/04/hommes-pioche-1216x516-1.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://voir.lactualite.com/evenements/5-a-7-conte-renee-robitaille-hommes-de-pioche-9ec3c2"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://voir.lactualite.com/genid/a6d323aae89e9f7b"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://voir.lactualite.com/artistes/renee-robitaille-823dad#artist"
      },
      {
        "@id": "https://voir.lactualite.com/artistes/etienne-loranger-b9328b#artist"
      },
      {
        "@id": "https://voir.lactualite.com/artistes/yvan-bienvenue-554575#artist"
      },
      {
        "@id": "https://voir.lactualite.com/artistes/louis-champagne-846bc2#artist"
      },
      {
        "@id": "https://voir.lactualite.com/artistes/martine-gagnon-nuckle-fd4047#artist"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/60a155834f21c0e7"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/5-a-7-conte-renee-robitaille-hommes-de-pioche-9ec3c2"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Hommes de pioche"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "« Tous les mineurs que j’ai rencontrés portaient cette petite fiole au cou. Une fiole en or. Sur laquelle la mine avait inscrit “20 mai 1952”. Autour de mon cou, c’est la fiole du Grand Zaphat qui pendait. On m’avait chargé de lui remettre. J’ai arpenté les terres de l’Abitibi, ma région natale. J’ai cherché le Grand Zaphat, dans les tavernes, dans les mines. Et je l’ai trouvé à travers les histoires de tous les Hommes de pioche qu’il a sauvés ce jour-là, le jour où le marécage est entré dans la mine. » Né des confidences d’hommes et de femmes de l’Abitibi, terre natale de Renée, ce spectacle rend hommage aux mineurs qui ont creusé le «ventre en or» de cette région. Leurs mots, leurs histoires et leurs silences ont profondément marqué Renée. Vingt ans plus tard, elle les réincarne sur scène – avec tendresse et gratitude. Depuis sa création, le spectacle a été présenté à plus de 100 reprises devant des publics du Québec et à l’international. Partout, il a trouvé écho par la force universelle de ses thèmes : immigration, solidarité ouvrière, place des femmes dans des milieux d’hommes, débuts de la syndicalisation, liens filiaux et mémoire du territoire, des sujets toujours brûlants d’actualité qui sauront rejoindre un nouveau public. Pour vous! Une rencontre en bord de scène avec les artistes suivra la représentation."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
