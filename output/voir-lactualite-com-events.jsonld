    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Cor céleste"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le corniste Christian Beaucher et l’organiste Chantal Boulanger s’unissent le temps d’un concert mémorable. Les deux artistes d’expérience interpréteront des œuvres qui vous mèneront jusqu’au septième ciel. Vous entendrez notamment des transcriptions pour cor solo des Suites pour violoncelle seul de Bach, des œuvres pour cor et orgue de Marc O’Reilly, d’intrigantes courtes pièces pour orgue de Rachel Laurin et le fameux Ave Maria de Gounod. Christian Boucher est le cor solo de l’Orchestre symphonique de Drummondville. Il a entre autres joué avec les orchestres de la BBC, de Windsor, de Laval et de Sherbrooke ainsi que l’Orchestre Métropolitain. Chantal Boulanger est l’organiste titulaire de la basilique-cathédrale de Sherbrooke et a été la coordonnatrice du département de musique du Cégep de Sherbrooke."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
