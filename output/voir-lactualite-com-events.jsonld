    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "2Frères — Origine"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "On ne présente plus 2Frères. Leurs chansons font partie de nos vies et c’est exactement là que commence Origine. Leur nouvel album, c’est un retour à ce qui les a construits: leurs racines, leur histoire et la musique qui les ont façonnés. C’est une signature qui leur ressemble, faite de textes humains, de mélodies qui rassemblent et de chansons qui restent. Sur scène, deux voix et cinq musiciens donnent vie à ce voyage chaleureux, vivant et fait pour être vécu ensemble. Ce soir-là, vous ne serez pas spectateurs. Vous serez les chansons."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
