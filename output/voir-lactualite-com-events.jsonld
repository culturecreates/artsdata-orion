    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Champion"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Champion est le troisième one-man-show de l'humoriste Mario Tessier, animateur et membre du duo Les Grandes Gueules, qui a aussi passé 20 ans au micro d'Énergie 94,3. Le spectacle mêle autodérision et situations improbables : Mario y affronte ses propres contradictions, entre un entraînement de boxe juste après une séance de botox, l'achat d'une jument alors qu'il n'a jamais monté à cheval, et l'idée de se prendre pour un génie. Le titre évoque ce grand champion qui sommeille en chacun, celui qui pousse à viser plus haut, quitte à se ridiculiser."
      }
    ],
    "http://schema.org/inLanguage": [
