  {
    "@id": "https://voir.lactualite.com/genid/35f4e9d9b703996a",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-03-10T17:00:00-05:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-03-10T20:00:00-05:00"
      }
    ],
