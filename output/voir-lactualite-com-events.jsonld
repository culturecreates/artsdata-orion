    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Anna Lapwood"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Anna Lapwood est une organiste dont le jeu allie virtuosité et présence scénique. À 21 ans, elle devient la plus jeune directrice musicale d'un collège à Cambridge. Quelques années plus tard, elle fait vibrer des millions d'abonnés sur les réseaux sociaux en renouvelant l'orgue pour une nouvelle génération. Ses concerts mêlent des registres majestueux, intimes et électrisants, et ses programmes vont de grands classiques pour orgue à des œuvres contemporaines."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
