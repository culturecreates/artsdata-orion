    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "André Thériault : auteur, compositeur et interprète — 6 déc. 2026 | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le dimanche 6 décembre 2026, Tribune culturelle (Stoneham-et-Tewkesbury). André Thériault est un amoureux de la chanson et accorde une très grande importance…"
      }
    ],
    "http://ogp.me/ns#url": [
