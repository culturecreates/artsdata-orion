    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "CARL MAYOTTE PRÉSENTE CLAUDE"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Avec Claude, en nomination pour l’album jazz de l’année au prochain gala de l’ADISQ, Carl Mayotte propose une œuvre à la fois intime et lumineuse, inspirée par deux événements marquants de sa vie. De ces épreuves est née une musique où la nostalgie se mêle à la joie du souvenir, portée par un langage sonore renouvelé qui puise autant dans le jazz contemporain que dans l’Indie-pop et la scène fusion anglaise actuelle. Par ce projet, Mayotte rend hommage à son père, Claude Mayotte. Carol Mayotte, basse, composition; Gabriel Cyr, guitare; Damien-Jade Cyr, saxophone; Francis Grégoire, claviers; Stéphane Chamberland, batterie Remboursements Aucun remboursement Échanges Aucun échange Accès pour personnes à mobilité réduite Oui Gratuité pour l'accompagnateur Oui"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
