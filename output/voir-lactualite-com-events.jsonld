    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "audrey quirion"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Guitariste depuis l’âge de 14 ans, Audrey a toujours fait de la musique une priorité. En 2017, elle a commencé à se produire sur scène en duo avec la talentueuse Louise Selby, tout en découvrant son talent inné pour le cajon. Elle a également joué en solo dans des restaurants, bars, fêtes privées, mariages et festivals."
      }
    ],
