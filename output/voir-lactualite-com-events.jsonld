    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Debout la mort!"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "À travers le jeu masqué, ce projet explore un après-la-mort paradoxalement libre, poétique et rassembleur. Dans un monde épuisé par la performance et l’anxiété, Debout, la mort! choisit l’apocalypse comme point de départ et transforme la figure du zombie en symbole de libération."
      }
    ],
