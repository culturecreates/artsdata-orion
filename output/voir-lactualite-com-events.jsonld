    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Equipage recherché"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Cirque Collini Durée : 50 minutes Ce spectacle d’arts du cirque est une production du Cirque Collini. Le capitaine Madjack Rackham est en quête d’un ultime membre d’équipage afin de partir à la recherche d’un trésor. On vous convie à assister à cette grandiose assemblée lors de laquelle un aspirant marin devra surmonter diverses épreuves pour mériter sa place au sein de l’équipage. Sur une trame musicale originale, cette épopée circassienne marquera votre mémoire par ses acrobaties aériennes, équilibres, main à main et combat de scène. Spectacle présenté en collaboration avec En Piste - Regroupement national des arts du cirque. Profitez de votre venue pour visiter les expositions de l’espace muséal Alfred-Pellan. Diffusart Suivre la production Site web Instagram"
      }
    ],
