      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 14 novembre 2026 à 20 h, à Maison de la culture de Thetford Mines (Thetford Mines). La première fois pour Caravane à Thetford : 15 novembre 2014. La dernière fois pour Caravane à Thetford : 14 novembre 2026. Venez vivre un moment inoubliable comme dans le temps du Cactus et du Sergent Peppers…"
      }
    ],
