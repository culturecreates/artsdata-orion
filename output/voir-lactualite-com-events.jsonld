    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "CINÉMA\nD’HALLOWEEN :\nLA FAMILLE\nADDAMS (2019)"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Préparez-vous à rencon - trer la famille la plus étrange et la plus amusante qui soit. Les Addams ne passent jamais inaperçus ! Lorsque leur mode de vie unique attire l’attention de tout le voisinage, une série de situations aussi drôles qu’imprévisibles s’ensuit. Une aventure animée remplie d’humour, de mystère et de personnages inoubliables. Costumes bienvenus !"
      }
    ],
