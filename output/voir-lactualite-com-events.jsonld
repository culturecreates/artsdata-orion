    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Ciné-club: Arthur Rimbaud, six mois en enfer En… | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 10 février 2027 à 19 h, à Plusieurs lieux – Châteauguay (Châteauguay). French with English Subtitles. A vivid portrait of Rimbaud's rebellious youth, artistic awakening, and turbulent relationship with Verlaine."
      }
    ],
    "http://ogp.me/ns#url": [
