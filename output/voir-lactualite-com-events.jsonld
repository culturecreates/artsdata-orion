    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Concert unique - Jubilate!"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Pour célébrer ses 20 ans, le Festival International Bach Montréal fait escale à Québec et réunit deux géants du XVIIIe siècle : Jean-Sébastien Bach et Georg Friedrich Haendel autour d’un programme festif qui marie l’exubérance haendelienne à la rigueur bachienne. La direction de l’Orchestre du Festival a été confiée à John Butt, chef du Dunedin Consort, pour un triptyque d’œuvres phares du répertoire baroque. Le Magnificat de J.S. Bach déploie toute la splendeur de l’écriture chorale sacrée, tandis que la Water Music de Haendel évoque les fastes de la cour royale anglaise. Le Concerto Brandebourgeois n° 3 vient couronner la soirée de son énergie contagieuse et de son dialogue virtuose entre les cordes."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
