    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 21 janvier 2027 à 0 h, à Lieu à préciser – Baie-Comeau (Baie-Comeau). This non-profit organization was created to brighten the Baie-Comeau winter by screening a variety of films from around the world."
