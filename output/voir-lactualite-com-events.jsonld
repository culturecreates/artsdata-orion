      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 27 novembre 2026 à 20 h, à La Petite Boîte Noire (Sherbrooke). En pleine ascension internationale, 2120 propose un show intense, raffiné et résolument rétro, où la puissance vocale de Billy St-Onge rencontre les grooves planants d’un mod-rock maîtrisé et audacieux. Après un premier album…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
