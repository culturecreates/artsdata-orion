    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Des Hommes Rapaillés (Présentation Du Vieux Treuil)"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "À travers la poésie intemporelle de Gaston Miron, mise en musique par Gilles Bélanger, ce spectacle rend hommage à l’un de nos plus grands poètes québécois. Ses mots, porteurs d’amour, de révolte et d’espérance, embrasent la scène. Avec Michel Faubert, Yann Perreau, Martin Léon, Gilles Bélanger et Clément Cormier sous la direction musicale de Mountain Daisies, cette soirée unique promet un voyage au coeur de notre mémoire collective. Venez chanter Miron et vibrer au rythme d’une rencontre entre poésie et musique"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
