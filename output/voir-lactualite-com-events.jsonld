    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Angelique Francis"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Originaire d'Ottawa, Angelique Francis est une auteure-compositrice-interprète multi-instrumentiste qui mêle blues, soul, folk, jazz, gospel et rock. Son album Long River a remporté le prix Juno du meilleur album blues. Son plus récent album, Not Defeated, compte la participation de Christone « Kingfish » Ingram et d'Eric Gales. Elle a partagé la scène avec Gary Clark Jr, Beth Hart et Tom Cochrane, et s'est produite dans plusieurs festivals, dont le Festival international de jazz de Montréal et l'Ottawa Blues Festival."
      }
    ],
    "http://schema.org/eventStatus": [
