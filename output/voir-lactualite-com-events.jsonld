    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 22 juillet 2027 à 14 h, à Lieu à préciser – Blainville (Blainville). Installez-vous devant un chevalet tout en sirotant un verre et laissez-vous inspirer par le paysage lors de cette activité de peinture en plein air. Un verre de vin ou un mocktail vous est offert."
      }
    ],
