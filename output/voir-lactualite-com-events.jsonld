    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 18 octobre 2026 à 0 h, à Centre aquatique Jacques-Dupuis (Repentigny). Les 18 et 19 octobre, venez décorer votre citrouille et participer au grand concours annuel. Les chefs-d’œuvre seront exposés dans le hall d’entrée et l’heureux gagnant1 sera dévoilé lors du bain animé du 26 octobre."
      }
    ],
