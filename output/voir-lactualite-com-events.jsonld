    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Le cercle de chansons SuperFolk"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le cercle de chansons SuperFolk réunit Ian Kelly et ses invité·e·s. Dans l'esprit d'un Songwriters' Circle popularisé à Nashville, Ian Kelly invite deux ou trois auteur·trice·s-compositeur·trice·s à partager la scène le temps d'une soirée. Tour à tour, les artistes interprètent leurs chansons, discutent de leurs inspirations et de leur processus de création, dans une ambiance conviviale et chaleureuse. Ces soirées intimes s'adressent au grand public comme à celles et ceux qui s'intéressent de plus près à la création des chansons."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
