        "@id": "https://voir.lactualite.com/genid/f6e55f75da318032"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://voir.lactualite.com/artistes/kiya-tabassian-f46278#artist"
      },
      {
        "@id": "https://voir.lactualite.com/artistes/maliheh-moradi-4dd54d#artist"
      },
      {
        "@id": "https://voir.lactualite.com/artistes/hamin-honari-a78fe7#artist"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/f4638ca803a250cc"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/constantinople-la-voix-de-l-aube-b22677"
