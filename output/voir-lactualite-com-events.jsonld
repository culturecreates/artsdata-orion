    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Après on va où ? - Michel Rivard"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Après on va où ? est un théâtre musical en solitaire dont Michel Rivard signe le texte et les chansons et qu'il interprète, accompagné sur scène de trois musiciens. La mise en scène est de Marie-Thérèse Fortin. Un homme d'âge mûr regarde fleurir un magnolia par la fenêtre de sa chambre et s'interroge, entre un rendez-vous médical, le choix d'une urne et une marche en forêt avec son petit-fils. Michel Rivard poursuit ainsi son exploration du théâtre-récit, mêlant poésie et chanson."
      }
    ],
    "http://schema.org/eventStatus": [
