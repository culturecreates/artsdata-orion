    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Émilie Perreault – La suspension consentie de l'incrédulité"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Animatrice, autrice et journaliste, Émilie Perreault monte sur scène pour la première fois avec La suspension consentie de l'incrédulité, un solo qu'elle qualifie de « métaphysique-feel-good ». Spectatrice assidue, elle y explore ce qui se passe quand on éteint son cellulaire et qu'on s'assoit dans une salle : pourquoi va-t-on au théâtre, et que vient-on y chercher ?"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
