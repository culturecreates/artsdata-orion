      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/2f4f8ba8403f8d9b"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/chantal-lamarre-stepettes-et-cornemuse-8c9447"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Chantal Lamarre stepettes et cornemuse"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Après 40 ans dans le métier, Chantal Lamarre propose Steppettes et cornemuse, un cabaret bio-comique présenté en solo, une première pour elle. Observatrice du monde et fille de scène, elle y chante, danse et joue la comédie, mêlant chansonnette et steppette dans une formule aux codes vintages qui aborde des enjeux actuels. Le spectacle a été écrit par Chantal Lamarre avec la collaboration de Catherine Éthier, Guillaume Corbeil et Richard Gohier, sous la mise en scène de François Chénier, avec la musique de Denis Larochelle et Sylvie Dumontier et la chorégraphie de Chantal Dauphinais."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
