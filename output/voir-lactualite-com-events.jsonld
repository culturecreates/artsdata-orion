    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le vendredi 19 février 2027, Parc Portuaire de Trois-Rivières (Trois-Rivières). Véritable pionnier de l’électro house, le DJ et producteur italien Benny…"
      }
    ],
