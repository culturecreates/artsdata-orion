  {
    "@id": "https://voir.lactualite.com/genid/10aa408b934cd6e1",
    "@type": [
      "http://schema.org/MusicEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-01-23T20:00:00-05:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-01-23T22:30:00-05:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://voir.lactualite.com/genid/92990eee3023c42e"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://tpos.s3.amazonaws.com/events/W36/25/04/19/001/btt8020250419-1152x648-fr-673d2920.png"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://voir.lactualite.com/evenements/back-to-the-80s-band-b1d7f4"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://voir.lactualite.com/genid/9a1ccaaae5a81064"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://voir.lactualite.com/artistes/back-to-the-80s-band-af09e6#artist"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/3c7eab8bc43b4366"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/back-to-the-80s-band-b1d7f4"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Back To The 80s Band"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Avec Back To The 80s Band préparez-vous à être éblouis par la diversité de leur répertoire musical. 4 musiciens et 2 chanteurs d’expérience, qui se spécialisent ici au Rock des années 80’s. De Queen à Bon Jovi, en passant par Pat Benatar, Heart et sans tous les nommer Back To The 80s Band revisite les tubes les plus emblématiques du rock de cette époque culte! La liste des chansons interprétées est très variée et saura vous satisfaire, que ce soit pour un événement corporatif, sur une scène de festival ou encore pour une soirée plus intimiste. L’élément ultime qui peut sûrement les distinguer est leur duo vocal qui est exceptionnel. Puissante et chargée d’émotion, leur prestation nous ramène instantanément à une époque où chaque mélodie nous fige dans le temps. Soyez prêts à écouter les «cassettes » comme dans le temps et à frissonner au son de leurs voix qui fusionnent harmonieusement avec l’ensemble musical. En somme, Back To The 80s Band c’est une expérience immersive de haut niveau. Que vous ayez vécu votre jeunesse lors de ces années et/ou que vous souhaitez revivre cette époque légendaire, ils sont là pour vous offrir une soirée des plus mémorables et électrisantes. Accrochez-vous, car le Rock 80’s est de retour et plus que vivant."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
