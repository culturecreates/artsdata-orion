    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "À Go, on Lit !"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "À go, on lit ! (AGOL) est une campagne qui s’adresse aux 12-17 ans trippeux de lecture ou à ceux qui n’ont pas encore trouvé le livre qui leur fera aimer la lecture. Grâce au questionnaire interactif qui se trouve à agol.ca, découvrez VOTRE profil de lecture et accédez à des suggestions personnalisées en fonction de VOS champs d’intérêt."
      }
    ],
