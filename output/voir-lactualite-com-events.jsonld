    "http://schema.org/performer": [
      {
        "@id": "https://voir.lactualite.com/artistes/boogie-wonder-band-165554#artist"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/d107d8ab7c99a4cd"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/boogie-wonder-band-disco-honey-5a3e7d"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Boogie Wonder Band - Disco Honey"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le Boogie Wonder Band, célèbre pour son énergie contagieuse et ses grooves irrésistibles, présente un tout nouveau spectacle électrisant «Disco Honey»! Plongez dans un tourbillon de paillettes et de boules miroirs, où les rythmes endiablés de la basse et les envolées des cuivres vous transportent instantanément dans l’atmosphère exaltant des années disco. De Donna Summer aux Bee Gees, en passant par Gloria Gaynor et KC & the Sunshine Band, le répertoire du Boogie Wonder Band rassemble les plus grands hits qui ont marqué l'histoire de la musique des années 70. Attendez-vous à des costumes étincelants, à des chorégraphies captivantes et à une ambiance électrisante qui vous incitera à vous lever pour rejoindre la piste de danse. Que vous soyez un nostalgique des années disco ou simplement en quête d'une soirée inoubliable, le spectacle du Boogie Wonder Band est un incontournable pour tous les amateurs de musique. Préparez-vous à danser, à chanter et à célébrer, car, avec le Boogie Wonder Band, la fête ne fait que commencer!"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
