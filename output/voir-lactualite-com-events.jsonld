    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "A major agricultural festival, Expo Rive-Nord has been welcoming exhibitors, small farms, and other horticultural activities right in the heart of downtown L'Assomption for several years now. Musical performances by renowned artists are also on the program. Festival-goers can enjoy a variety of family-friendly activities, agricultural and local exhibitors, a traditional barbecue, and much more."
      }
    ],
