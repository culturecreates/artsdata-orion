    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 25 octobre 2026 à 15 h, à Centre socioculturel Alphonse Lepage (Brossard). Chaque spectateur doit détenir un billet pour assister au spectacle. La présence d'un adulte est obligatoire. Spectacle famille 4 à 10 ans Durée du spectacle : 50 minutes sans entracte Au bout du conte revisite avec…"
      }
    ],
