    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Atelier-découverte"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Découvrez des instruments rares, au son envoûtant ! Lors de cet atelier interactif, Pierre‑Olivier Bolduc, multi‑instrumentiste, fabriquant d’instruments et enseignant, nous explique les origines, l’histoire, le maniement et même certaines techniques de fabrication d’instruments du monde entier : handpan, didgeridoo, guimbarde, flûtes diverses et autres."
      }
    ],
