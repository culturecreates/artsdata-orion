    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Énigmes révélées : de Sherlock Holmes au Montréal du 19e siècle"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Voyagez dans le temps et dans l’espace en vous laissant transporter à Londres, au 19e siècle, jusqu’au bureau de l’auteur Sir Arhtur Conan Doyle et découvrez ses sources d’inspiration. L’aventure vous mènera également sur les traces de Silas Carpenter, réel Sherlock Holmes québécois qui vécut à Montréal au début du 20e siècle."
      }
    ],
