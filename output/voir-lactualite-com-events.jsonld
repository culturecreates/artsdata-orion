      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 12 mars 2027 à 20 h, à Theatre Capitole (Québec). Arpin Lépine est un artiste dont l'univers musical navigue, selon les sources consultées, entre la chanson folk, la pop acoustique et le rock léger. Ses textes sont décrits comme authentiques, sensibles et sincères. Parmi ses spectacles…"
      }
    ],
