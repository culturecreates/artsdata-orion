    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Atelier de tire Sainte-Catherine"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "La tire Sainte-Catherine est une tradition culinaire québécoise que les membres de la Congrégation de Notre-Dame perpétuent depuis l'époque de Marguerite Bourgeoys. La Maison Saint-Gabriel fait partie des rares endroits où cette tradition se poursuit encore aujourd'hui. Lors de cet atelier pratique, les participants découvrent comment préparer, étirer et façonner la tire Sainte-Catherine. Accompagnés par l'équipe du musée, petits et grands mettent la main à la pâte et repartent avec leurs propres bonbons à la mélasse. L'activité comprend une visite guidée du musée et un atelier."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
