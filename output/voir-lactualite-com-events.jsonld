    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "ANYMA ORA'"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "ANYMA ORA’ propose une expérience scénique où musique électro-pop, danse et rythmes traditionnels se rencontrent dans un univers à la fois contemporain et inspiré de ses racines autochtones. À travers des tableaux immersifs et une présence scénique marquante, le spectacle invite les élèves à découvrir le dialogue entre héritage culturel, création artistique et expression musicale."
      }
    ],
