      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://voir.lactualite.com/genid/3d7c3f9ed21ffd3b"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://voir.lactualite.com/artistes/eman-21342c#artist"
      },
      {
        "@id": "https://voir.lactualite.com/artistes/knlo-769b47#artist"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/60f51299822e1b40"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/eman-knlo-2542ff"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Eman & Knlo"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "EMAN En mars 2026, Eman frappe fort avec son nouveau projet : La justice et la paix dans le monde. Une mixtape écrite et composée par le rappeur qui exprime sa vision avec authenticité, sans compromis. Les textes explorent les thèmes de l’égocentrisme et les luttes de pouvoir qui façonnent notre époque. La signature sonore est puissante et l’ensemble du projet est ficelé par les interventions de l’artiste Jamaïcain Papa T. Un opus audacieux, brut et actuel, qui rafraîchit le paysage hip-hop québécois. KNLO KNLO (alias KenLo Craqnuques) est un rappeur et compositeur né à Sainte-Foy. Porteur du récit afrobascanadien et fort des albums Long jeu (2016), Sainte-Foy (2019), CLUB Mixtape 2020 (2020), SAC À SURPRISE (2021), 438 (2023) et du EP LE CASH VAUT RIEN (2026) , on le connaît aussi comme membre du groupe Alaclair Ensemble et des collectifs Movèzerbe et K6A. Il est l’une des figures les plus influentes de la scène hip-hop québécoise. Les soirées SpecTARD X Bains Publics : Les Bains Publics et Spect’Art Rimouski sont heureux de s’associer pour vous présenter Les soirées SpecTARD X Bains Publics : une série de spectacles à la Salle Desjardins et leurs «Afters» festifs aux Bains Publics durant l’automne 2026. Le public est donc attendu aux Bains Publics après le spectacle."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
