    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Arpin Lépine"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Arpin Lépine se démarque par son authenticité, sa sensibilité et la sincérité de ses textes. Son univers musical navigue entre la chanson folk, la pop acoustique et le rock léger, avec des influences issues de la scène québécoise contemporaine. Sur scène, il livre une performance chaleureuse, intime et rassembleuse, où chaque chanson raconte une histoire ancrée dans le quotidien, les relations humaines et les émotions vraies. Sa voix expressive, soutenue par une guitare acoustique et des arrangements épurés, crée une atmosphère à la fois émotive et accessible qui touche le public de tous âges."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
