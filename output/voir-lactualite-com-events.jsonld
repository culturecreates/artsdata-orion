    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "ATELIER DE FORGE INTENSIF"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Après avoir été initiés aux mesures de sécurité, aux règles de fonctionnement de l’atelier et à l’utilisation du feu de forge et des outils, les participants pourront se familiariser avec différentes techniques, telles que le travail sur l’ enclume, l’utilisation de gabarits et l’assemblage avec des rivets."
      }
    ],
