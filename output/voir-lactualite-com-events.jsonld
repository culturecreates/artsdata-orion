    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "CRÉATION D’UNE TASSE PERSONNALISÉE AVEC LA CRICUT MUG PRESS™"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Pour transformer une tasse ordinaire en création unique grâce à la sublimation. À l’aide de Cricut Design Space ou des crayons Infusible Ink™, conception d’un visuel personnalisé qui sera transféré sur une tasse compatible avec la Cricut Mug Press™. Cet atelier permettra aux participants de découvrir les bases du design numérique, de comprendre le processus de sublimation et d’utiliser une presse à tasse de façon sécuritaire."
      }
    ],
