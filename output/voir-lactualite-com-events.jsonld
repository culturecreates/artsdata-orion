      {
        "@language": "fr",
        "@value": "CONCERTS DE NOËL EN RÉSIDENCES"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le FestivalOpéra de Saint-Eustache est heureux de présenter à nouveau des Concerts de Noël dans les Résidences des aînés. Nous aurons la joie de présenter cette année les talentueux artistes : LEILA CHALFOUN Soprano, ROBERT FALBY baryton et sa fille ROSE, LÉON PAN violoniste, NOÉMIE CHADID pianiste et le Chœur du FOSE accompagnés au piano de Maestro MARIO ROCHON"
      }
    ],
