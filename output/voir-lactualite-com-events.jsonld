    ],
    "http://schema.org/location": [
      {
        "@id": "https://voir.lactualite.com/genid/4eb6f377b56ca35b"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://tpos.s3.amazonaws.com/events/PBN/26/11/20/001/pbn261120001-1152x648-fr-6a763f96.png"
      }
    ],
