    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "COYOTE VS. ACME"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le Coyote (Wile E. Coyote) a acheté d’innombrables articles auprès de la compagnie Acme dans sa quête incessante pour capturer le fameux oiseau Bip Bip (Road Runner). Systématiquement, ces produits présentent des défaillances catastrophiques et sont à l’origine de ses fréquentes blessures. Après avoir vu une publicité d’un avocat spécialisé en dommages corporels, le Coyote décide de poursuivre le fabricant de ces marchandises défectueuses. Me Kevin Avery, habitué aux petites causes réglées hors cour, est réticent à prendre en charge une affaire de cette envergure."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
