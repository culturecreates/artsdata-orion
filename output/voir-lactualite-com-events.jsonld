    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Jusqu’au 10 janvier 2027, Musée d'art de Joliette (Joliette). Anahita Norouzi. Rift interroge la notion de « progrès » comme instrument de domination coloniale…"
      }
    ],
    "http://ogp.me/ns#url": [
