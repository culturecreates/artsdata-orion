      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://voir.lactualite.com/evenements/cours-de-peinture-adultes-3aa82d"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/2e8fbb64656c9f11"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/cours-de-peinture-adultes-3aa82d"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Cours de peinture- adultes"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Cet atelier de peinture s’adresse à toute personne souhaitant expérimenter différentes techniques de peinture. À travers l’acrylique, la gouache et l’aquarelle, les participants découvriront les particularités de chaque médium, leurs possibilités expressives ainsi que les approches qui leur sont propres. Guidés par Marthe Julien, les participants expérimenteront une variété de procédés tout en apprenant les notions fondamentales de la peinture : le mélange des couleurs, le travail des transparences et des textures, la composition et l’utilisation des outils. Aucune expérience préalable n’est requise. Quand : Le jeudi du 8 octobre au 3 décembre de 18 h 30 à 21 h. Congé de la relâche le 19 novembre. Nombre de participants : 12 participants au maximum, 6 participants minimum Tarif pour la session complète : Membre : 285 $ Régulier : 320 $ Matériel requis : Le matériel est fourni pour cet atelier. Politique d’annulation Des frais d’administration de 10$ s’appliqueront en cas de modification apportée à l’inscription. Vous pouvez annuler une inscription sans frais jusqu’à 14 jours avant le début de l'atelier. Des frais de 25 % seront retenus pour une annulation entre 14 et 7 jours avant le début de l'atelier. Si l’annulation est réalisée 7 jours avant le début de l'atelier, des frais de 50 % seront retenus sur la réservation. Si l’annulation est faite pour des raisons de santé, et ce, sur présentation d’un certificat médical, nous procéderons à une annulation et à un remboursement sans frais."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
