  {
    "@id": "https://voir.lactualite.com/evenements/bea-bestiole-2c70bc",
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#site_name": [
