    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 16 avril 2027 à 20 h, à Centre Bell - Habs Zone (Montréal). Le producteur écossais de 42 ans assurera la première tournée nord-américaine de sa carrière, donnant alors un spectacle inédit au Centre Bell le 16 avril 2027."
      }
    ],
