    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Beethoven chez l'archiduc"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "En 2027, le monde célébrera le bicentenaire de Beethoven, dont la musique continue d’émouvoir par son intensité. Ce concert hommage présente trois œuvres de la pleine maturité du compositeur, avant que sa surdité ne progresse. En point d’orgue : le sublime Trio à l’Archiduc, incontournable pour tout mélomane."
      }
    ],
