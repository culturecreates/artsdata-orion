      }
    ]
  },
  {
    "@id": "https://voir.lactualite.com/genid/52e168db3c1448fd",
    "@type": [
      "http://schema.org/EducationEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-12T18:00:00-05:00"
      }
    ],
    "http://schema.org/endDate": [
