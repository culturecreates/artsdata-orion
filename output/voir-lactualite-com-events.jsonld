    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "BIBLIOCLUB SOUS LES ÉTOILES — Boucherville | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 10 juillet 2027 à 19 h, à Lieu à préciser – Boucherville (Boucherville). La bibliothèque est fermée... sauf pour les enfants ! Un mystérieux visiteur a volé une clé et laissé des indices. À eux de résoudre les énigmes ! Lampe de poche et couverture recommandées pour lire dans le noir et remplir…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://voir.lactualite.com/evenements/biblioclub-sous-les-etoiles-c13167"
      }
    ],
