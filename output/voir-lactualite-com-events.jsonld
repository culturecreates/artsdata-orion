    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Béa Bestiole — Gatineau | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 13 février 2027 à 14 h, à Carrefour culturel Estacade (Gatineau). Dans ce spectacle participatif et rigolo, Béa Bestiole cherche à savoir qui habite le ciel et depuis quand. Est-ce que seuls les oiseaux et les insectes savent voler ? Le font-ils tous de la même façon ? Avec des chansons…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://voir.lactualite.com/evenements/bea-bestiole-2c70bc"
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
        "@value": "fr_CA"
      }
    ],
