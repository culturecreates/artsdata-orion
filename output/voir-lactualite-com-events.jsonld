    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "5 @ 9 Relève-tôt Drummond musique avec Rosalie Ayotte et Noé Talbot"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "1 jeudi par mois, l'Espace Mandeville devient un bistro-bar-spectacle! Des artistes musicaux en tous genres se succéderont sur les planches de l'Espace Mandeville! L'occasion parfaite pour des 5 @ 7 qui s'étirent, mais pas trop et faire le plein de nouveautés musicales, émergentes bien d'ici. Musique, bouffe, boissonnades pis dodo à 10h. Réservez vos places dès maintenant. Réguliers: 15$."
      }
    ],
