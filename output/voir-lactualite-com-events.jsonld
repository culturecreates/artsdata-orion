    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Christ Habib, Félix Dallaire"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "duo de guitares Tous deux diplômés à la maîtrise du Conservatoire de musique de Gatineau, Christ Habib et Félix Dallaire ont été élèves de Patrick Roux. Félix Dallaire a remporté le premier prix au Concours international de guitare de Montréal en 2019 et Christ Habib a figuré parmi les trente jeunes musiciens émergents de la liste « 30 under 30 » de la CBC en 2020. Au programme : Beethoven, Brahms et Chopin Brunch léger à 10 h, concert à 11 h Centre culturel du Vieux-Aylmer, salle La Basoche 120 rue Principale, Gatineau (secteur Aylmer)"
      }
    ],
    "http://schema.org/eventStatus": [
