    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Anas Hassouna : J'arrive — Sherbrooke | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 4 novembre 2026 à 20 h, à La Petite Boîte Noire (Sherbrooke). Je présente mon nouveau show: J’ARRIVE. Si tu me connais c’est sûrement que tu m’as déjà attendu plus que 5 minutes dans ta vie. Je t’ai dit ‘‘J’arrive’’ mais la vérité c’est que j’étais couché dans mon lit et j’avais pas encore pris…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://voir.lactualite.com/evenements/anas-hassouna-j-arrive-e16b88"
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
        "@value": "fr_CA"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://tpos.s3.amazonaws.com/events/PBN/26/11/04/001/pbn261104001-1152x648-fr-6a1ef532.png"
      }
    ]
  },
  {
    "@id": "https://voir.lactualite.com/genid/b8c3bb3baa7e0caf",
    "@type": [
      "http://schema.org/ComedyEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-04T20:00:00-05:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-04T23:00:00-05:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://voir.lactualite.com/genid/4eb6f377b56ca35b"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://tpos.s3.amazonaws.com/events/PBN/26/11/04/001/pbn261104001-1152x648-fr-6a1ef532.png"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://voir.lactualite.com/evenements/anas-hassouna-j-arrive-e16b88"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://voir.lactualite.com/genid/50794118c17111c6"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://voir.lactualite.com/artistes/anas-hassouna-37a540#artist"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/33c1c540655665b2"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/anas-hassouna-j-arrive-e16b88"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Anas Hassouna : J'arrive"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Je présente mon nouveau show: J’ARRIVE. Si tu me connais c’est sûrement que tu m’as déjà attendu plus que 5 minutes dans ta vie. Je t’ai dit ‘‘J’arrive’’ mais la vérité c’est que j’étais couché dans mon lit et j’avais pas encore pris ma douche. Oui je sais, c’est révoltant. Mais ça m’a inspiré une lettre d’excuse publique que je tiens à vous parta… Lol j’niaise. C’est mon nouveau show achète des billets promis je serai à l’heure. Pour l’instant c’est que à Montréal, mais les autres promiiiiiiiiis j’arrive. J’ai hâte de vous voir! Anas ❤️ Je présente mon nouveau show: J’ARRIVE. Si tu me connais c’est sûrement que tu m’as déjà attendu plus que 5 minutes dans ta vie. Je t’ai dit ‘‘J’arrive’’ mais la vérité c’est que j’étais couché dans mon lit et j’avais pas encore pris ma douche. Oui je sais, c’est révoltant. Mais ça m’a inspiré une lettre d’excuse publique que je tiens à vous parta… Lol j’niaise. C’est mon nouveau show achète des billets promis je serai à l’heure. Pour l’instant c’est que à Montréal, mais les autres promiiiiiiiiis j’arrive. J’ai hâte de vous voir! Anas ❤️ Le stationnement est gratuit dès 18h au centre-ville."
      }
    ],
