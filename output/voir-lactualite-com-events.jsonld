      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Prochaine date le jeudi 11 février 2027 à 17 h 30, Salle Louis-Philippe-Poisson (Trois-Rivières), et 2 autres dates jusqu’au 22 avril 2027. Qui a dit que…"
      }
    ],
