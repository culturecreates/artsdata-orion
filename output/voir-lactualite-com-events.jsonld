    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Alexandre Poulin"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "L'auteur-compositeur-interprète Alexandre Poulin est à la fois poète, philosophe et conteur, et il exerce aussi le métier de professeur. Il est connu pour ses histoires racontées en quelques minutes et pour ses textes souvent construits sans refrain. Son sixième album, La Somme des êtres aimés, propose un univers musical plus organique et nostalgique, inspiré des sons des années 70, avec guitares douze cordes, pianos, flûtes et harmonies vocales. Son parcours compte aussi de nombreux prix obtenus au Québec comme en Europe."
      }
    ],
