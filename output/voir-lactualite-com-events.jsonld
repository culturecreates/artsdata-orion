      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://voir.lactualite.com/genid/8431b094be1c35d1"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://voir.lactualite.com/artistes/roseline-blain-26f56f#artist"
      },
      {
        "@id": "https://voir.lactualite.com/artistes/andreanne-brisson-paquin-c4b33c#artist"
      },
      {
        "@id": "https://voir.lactualite.com/artistes/dominique-cote-4e0c3b#artist"
      },
      {
        "@id": "https://voir.lactualite.com/artistes/sinfonia-de-montreal-084e54#artist"
