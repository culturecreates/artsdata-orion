      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://voir.lactualite.com/genid/d099366aa455624d"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/0ed464f818e3c526"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/concours-de-decoration-de-citrouilles-6fc42a"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Concours de décoration de citrouilles"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Sortez vos pinceaux, vos marqueurs et vos plus belles idées! On vous invite à participer à notre concours de décorations de citrouilles pour célébrer l’automne et l’Halloween. Informations pratiques Dates : Du 1er au 30 octobre 2026 Horaire : Selon les heures d’ouverture de la Bibliothèque Gisèle-Paré Lieu : Bibliothèque Gisèle-Paré Public cible : 2 à 17 ans Règlements : Les citrouilles décorées devront être déposées à la bibliothèque entre le 1er et le 30 octobre. Chaque citrouille devra être clairement identifiée avec le nom du participant et sa catégorie d’âge (une étiquette sera fournie lors du dépôt); Une citrouille par enfant; Les citrouilles sculptées ou évidées sont interdites pour des raisons de sécurité (risque de moisissure, d’attirer des insectes et de détérioration rapide). Seule la décoration extérieure est permise. Voici des exemples de matériel autorisé : peinture, marqueurs, colle, tissu, accessoires (chapeaux miniatures, lunettes, perles, etc.), paillettes, papier, rubans, argile à modeler. Tout matériel non périssable et non dangereux est permis. Les citrouilles artificielles ne sont pas autorisées. Catégories d’âge : 2-7 ans, 8-12 ans et 13-17 ans Un coupon de participation sera sélectionné aléatoirement, et ce, par catégorie d’âge. Prix de participation parmi les personnes gagnantes."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
