    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Belmar Cardinal en spectacle"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "C’est dans un esprit de sublimité pour l’amour de notre langue adorée que notre duo, fort de décennies d’expériences musicales et rompu à l’exercice de leurs exécutions, a vu le jour et propose, pour le ravissement d’un public appréciateur et raffiné, une collection cinq étoiles des plus belles chansons françaises et québécoises : d’Adamo à Sardou, de Félix Leclerc à Dubois. Une prestation d’une heure trente où l’interaction avec les aficionados du genre promet une soirée mémorable. Contribution volontaire."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
