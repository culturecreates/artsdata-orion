    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Bébé-Mélodies"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Bébé-Mélodies – Pour les tout-petits de 0 à 5 ans et leurs proches Éveillez les sens de votre bébé ou de votre tout-petit ! Ne manquez pas ces sessions de musique douce spécialement conçues pour les tout-petits ! Rejoignez-nous pour une expérience unique où la violoncelliste professionnelle Audrey Nadeau interprétera des pièces apaisantes dans une atmosphère relaxante. C’est l’occasion parfaite pour vos enfants d’explorer le monde de la musique, tout en étant entourés de leurs proches."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
