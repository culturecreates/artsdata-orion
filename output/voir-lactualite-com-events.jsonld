    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "FESTIVAL DE LANAUDIÈRE"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Canada’s largest classical music festival has been held in Lanaudière for nearly 50 years. The Festival de Lanaudière takes place at the Fernand-Lindsay Amphitheater and hosts international orchestras and classical artists. The festival also travels throughout the Lanaudière region, inviting audiences to attend concerts in unique venues, such as agritourism sites, through its “Hors les murs” (Outside the Walls) series. The festival also visits churches and small venues in the region. There are also wonderful activities for families. To learn more about the program, click HERE"
      }
    ],
