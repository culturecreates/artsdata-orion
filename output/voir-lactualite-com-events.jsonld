      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Angelique Francis"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Angelique Francis est une auteure-compositrice-interprète et multi-instrumentaliste originaire d'Ottawa. Son groupe a notamment reçu un prix JUNO dans la catégorie Blues Album of the Year pour l'album « Long River », ainsi qu'un Ontario Folk Music Award. Parmi ses spectacles précédents figurent une présentation de l'album « Not Defeated » et un concert mêlant jazz, blues et musique du monde."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
