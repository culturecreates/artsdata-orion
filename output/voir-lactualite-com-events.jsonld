    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Christian Marc Gendron"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Christian Marc Gendron est l'artiste derrière la série de concerts PianoMan, qui a rassemblé plus de 150 000 spectateurs à travers le Québec. Il a ensuite présenté le spectacle Trilogie, qui reprenait des numéros de ses trois dernières tournées et proposait de nouvelles créations inspirées de pianistes comme Ray Charles, Stevie Wonder, Elton John et Billy Joel, avec neuf musiciens et des moments d'humour."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
