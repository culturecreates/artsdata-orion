    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "BIANCA DEL RIO"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Bianca Del Rio, gagnante de RuPaul's Drag Race, présente It Gets Bitter, sa septième tournée solo de stand-up. Le spectacle, présenté en anglais, aborde la culture pop, l'actualité mondiale et les activités du quotidien sur un ton sarcastique. La tournée souligne 30 ans de carrière dans l'univers du drag. L'événement est annoncé comme étant tous âges."
      }
    ],
