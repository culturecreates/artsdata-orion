    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Au Coeur de la Bête"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Au cœur de la bête met en scène Brad Pitt dans le rôle de James Belmont, un officier des Forces Spéciales. À la suite d'un écrasement d'avion catastrophique, le personnage se retrouve isolé en pleine nature, aux confins de l'Alaska, avec son chien de combat Odin. Réalisé par David Ayer, ce thriller d'aventure explore le lien indéfectible qui unit un homme et son meilleur ami, alors qu'ils font face au plus grand défi de leur vie."
      }
    ],
    "http://schema.org/inLanguage": [
      {
