      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://voir.lactualite.com/artistes/julien-proulx-f25f75#artist"
      },
      {
        "@id": "https://voir.lactualite.com/artistes/denis-plante-952681#artist"
      },
      {
        "@id": "https://voir.lactualite.com/artistes/tommy-dupuis-88bcee#artist"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/96d639ecb09c144a"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/bronzage-symphonique-lp5-327"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Bronzage symphonique"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "À défaut d’aller dans le Sud, on vous propose un bronzage… musical! En plein mois de février, l’orchestre vous transporte là où les rythmes sont plus chauds, les nuits plus longues et la musique plus enveloppante. Entre les couleurs du Portugal et les élans du tango argentin, laissez-vous porter par les sons des cordes, de la guitare et du bandonéon! Avec le bandonéoniste Denis Plante et le guitariste Tommy Dupuis, un talent bien de chez nous, cette soirée vous fera voyager sans même quitter votre siège. Passeport inutile, mais amenez de la crème solaire... au cas où. Julien Proulx, chef d’orchestre. Denis Plante, bandonéon. Tommy Dupuis, guitare. PROGRAMME : Astor Piazzolla (1921-1992) Milonga del Angel ; Astor Piazzolla (1921-1992) Double concerto « Hommage à Liège » ; Joly Braga Santos (1924-1988) Concerto en ré pour orchestre à cordes ; Musique de tango. Arrivez tôt ! Dès 18 h 30, nos Jeunes musicien·ne·s à l’avant-scène donnent le ton. Laissez-vous porter par l’ambiance… avec une touche de danse aux accents latins. Poursuivez l’expérience après le concert : Venez échanger en bord de scène avec les artistes invités et en apprendre davantage sur le bandonéon, un instrument rare que vous aurez découvert sur scène, ainsi que sur le parcours de nos solistes. Puis, prolongez la soirée autour d’un cocktail en compagnie du chef et des musicien·ne·s de l’orchestre."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
