    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Marcel Fournier, auteur et généalogiste émérite, nous présentera Charles Lemoyne, ce personnage historique qui a marqué l’histoire de la Nouvelle- France. Il aura donné le ton à sa lignée à titre d’interprète, de négociant prospère et de seigneur de Longueuil. Par Marcel Fournier"
      }
    ],
