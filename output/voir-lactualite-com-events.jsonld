      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://voir.lactualite.com/artistes/chantal-lamarre-453f89#artist"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/f4638ca803a250cc"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/chantal-lamarre-79ac35"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Chantal Lamarre"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "100e représentation du spectacle Steppettes et cornemuse : un joyeux cabaret bio-comique Et si, pour un soir, on faisait comme si? Avec 40 ans de métier; sans avoir pensé qu’elle retrouverait la scène un jour - et encore moins en solo - Chantal Lamarre osera le monologue, la steppette et la chansonnette. La fille à lunettes qui aime par-dessus tout raconter des histoires a bricolé un spectacle unique dans l’offre culturelle. Le temps d’une soirée, et si on retournait au cabaret? Une soirée pour se souvenir du bon et moins bon vieux temps, pour rire de nos travers et pour chercher la joie dans l’adversité de l’époque. Allez, mesdames, mesdemoiselles, messieurs et tout ce qui se situe entre les deux, jeunes et nouveaux vieux, Steppettes et cornemuse est définitivement à inscrire à votre carnet de sorties!"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
