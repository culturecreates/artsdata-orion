    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Akuteu"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Akuteu est un théâtre interprété par Soleil Launière, une production d'Imago Theatre et de Production AUEN. Le spectacle, d'une durée de 1 h 15, prend la forme de fragments d'un récit personnel. Une jeune femme innue y partage sa perspective sur son intégration dans une société à prédominance blanche, et s'interroge sur les contradictions qui forgent son identité ainsi que sur sa légitimité à s'exprimer au nom de son peuple. Le spectacle évoque le vide et le vertige d'être constamment suspendu entre deux mondes. Il est recommandé à partir de 16 ans."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
