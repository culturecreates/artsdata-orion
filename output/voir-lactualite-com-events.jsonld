    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "ATELIERS BIEN-ÊTRE"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Une série de trois rencontres pour prendre soin de soi à travers le mouvement, la nature et la créativité. Une invitation à la découverte, à l’expérimentation et à l’expression, pour s’outiller et s’offrir un baume pour l’âme. Ces ateliers offrent des bienfaits à plusieurs niveaux : Bien-être physique et mental, Expression et créativité, Connexion à soi et à la nature, Renforcement du lien social. Ces ateliers sont comme des petites doses de soleil intérieur. Restez à l’affût ou contactez-nous pour connaître la programmation. Inscription obligatoire."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
