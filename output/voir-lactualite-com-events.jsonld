    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 20 janvier 2027 à 0 h, à Grand Théâtre de Québec (Québec). Texte de Stefano Massini Traduction de Marie-José ThériaultMise en scène de Rosalie CournoyerUne production du Trident en coproduction avec Vénus à véloAvecMarie-Ginette Guay, Mélissa Merlo, Gaïa Cherrat Naghshi, Sarya Bazin, Béatrice…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
