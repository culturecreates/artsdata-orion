    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Atelier d'écriture créatif Raconter autrement avec Christiane Desrivières"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Cet atelier s'adresse aux personnes de tous âges qui souhaitent explorer l'écriture de façon créative et ludique. Aucune expérience ni préparation n'est requise. L'atelier débutera par une courte présentation sur un élément clé de l'écriture, suivie d'exercices stimulants, accessibles et amusants. Une belle occasion de jouer avec les mots, de laisser libre cours à son imagination et de partager un moment enrichissant."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
