      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/bruno-pelletier-3-et-moi-lp9-186"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Bruno Pelletier : 3 et moi"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Bruno Pelletier présente Bruno Pelletier : 3 et moi, un rendez-vous musical festif et vivant où il revisite les grandes chansons qui ont marqué sa carrière, comme Coriace, Ailleurs c’est comme ici et Le temps des cathédrales, ainsi que des classiques de Supertramp, Elvis Presley, The Beatles et Grease. Entouré de Martin Bachand à la guitare, Claude Pineault et Brigitte Marchand, il chante, joue de la basse et de la guitare, et se livre sur son parcours et les histoires derrière ses succès. Dans un format épuré, il met de l’avant les harmonies vocales, les arrangements délicats et des chansons plus intimes, dans une atmosphère conviviale où rock, pop, opéra et country se côtoient."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
