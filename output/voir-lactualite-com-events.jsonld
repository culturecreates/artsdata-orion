    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "125e anniversaire de la présence des Missionnaires d’Afrique"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dimanche 18 octobre 2026 Les Missionnaires d’Afrique, en collaboration avec l’Unité pastorale missionnaire de Limoilou, Basse-Ville, Vanier (LBV), la Congrégation des Religieuses de Jésus-Marie, le Centre Dina-Bélanger et le diocèse de Québec, vous invitent à une célébration soulignant les 125 ans de présence des Pères Blancs à Québec. Cette célébration s’inscrit également dans le cadre du 100e anniversaire de la Journée mondiale des Missions, sous le thème : « Un dans le Christ, unis dans la mission ». La liturgie sera animée par la Chorale des Nations et l’Ensemble vocal Universalis. Un récital sera également présenté par Brigitte Lambert, pianiste, accompagnée d’Alexanne Trudelle-Caron, violoniste. Le récital mettra en valeur le piano restauré sur lequel la bienheureuse Dina Bélanger a joué durant ses études musicales à New York, de 1916 à 1918. Le programme comprend notamment des œuvres de Johann Sebastian Bach, Gabriel Fauré, André Gagnon, Francis Poulenc et Dina Bélanger. Pour information : Courriel : [email] Téléphone : [phone] Site Internet : Lieu : Église Saint-Roch, Québec 555, rue Saint-François Est, Québec (Québec) G1K 2Z6 Date : Dimanche 18 octobre 2026 Bienvenue à toutes et à tous!"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
