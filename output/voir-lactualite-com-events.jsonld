      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 31 octobre 2026 à 15 h 30, à Lieu à préciser – Rawdon (Rawdon). Un rendez-vous monstrueusement amusant! Enfilez votre costume d'Halloween le plus effrayant et joignez-vous à cette célébration de l'Halloween au cœur de Rawdon! Cueillette de bonbons et animations sur la rue Distribution de…"
      }
    ],
    "http://ogp.me/ns#url": [
