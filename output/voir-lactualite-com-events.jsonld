      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://voir.lactualite.com/artistes/les-incompletes-062f1f#artist"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/86c7e096a3758bbc"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/betes-de-fete-a5f704"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "BÊTES DE FÊTE"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "BÊTES DE FÊTE c’est LE bal costumé de l’année ! Une invitation, spécialement dédiée aux enfants, petits et grands, à venir tout donner sur la piste de danse, vêtu.es des atours les plus loufoques ! Arborant des motifs animaliers, des ponchos fluos et moult paillettes, dénichés dans notre costumier, les fêtards sont invité.es à laisser surgir leur animal intérieur et à se trémousser au son endiablé des platines d’un électrisant DJ. Afro-beat, électro-cumbia, musique moyen-orientale électrisée, hip-hop déjanté… Des rythmes joyeux qui entraîneront les corps dans une danse euphorique ! Avec cet objet très joyeux, Les Incomplètes permettent aux enfants et à leurs adultes de se laisser aller complètement, ensemble, dans une danse libre, en leur permettant de se costumer à volonté, elles convoquent un espace de pure joie et de communauté, ce qui en soi est un acte de résistance face à notre monde individualisé. Jouant avec les différents codes de la discothèque, elles proposent une «pause plaisir et liberté» au cœur du quotidien parfois chargé des enfants."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
