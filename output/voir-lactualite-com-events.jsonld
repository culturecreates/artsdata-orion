    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "ATELIER CRÉATIF : Décoration de calebasses africaines"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Venez découvrir l’art des calebasses africaines. Les enfants découvriront ce fruit ancestral en créant leurs propres objets décoratifs par le dessin, la peinture et le collage, dans un espace créatif sans contrainte. Une expérience artistique conviviale où chaque petit artiste repartira avec sa création unique."
      }
    ],
    "http://schema.org/inLanguage": [
