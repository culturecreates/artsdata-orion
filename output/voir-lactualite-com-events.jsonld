    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 30 septembre 2026 à 0 h, à Musée McCord Stewart (Montréal). Dans le cadre du programme Artiste en résidence et de la 8 édition de la Biennale d’art contemporain autochtone (BACA), l’artiste multidisciplinaire Carrie Allison développe un nouveau corpus d’œuvres"
      }
    ],
