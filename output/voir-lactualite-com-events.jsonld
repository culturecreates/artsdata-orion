    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Avis d’ébullition"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Sur la route depuis janvier 2025 avec son quatrième spectacle, Jean-François Mercier continue d’ajouter des supplémentaires pour « Avis d’ébullition ». Il sera notamment de retour à Montréal pour une troisième fois le 18 janvier 2027 à l’Espace St-Denis, ainsi qu’à Québec pour une cinquième représentation à la Salle Albert-Rousseau le 8 janvier 2027. Les billets sont en vente maintenant."
      }
    ],
