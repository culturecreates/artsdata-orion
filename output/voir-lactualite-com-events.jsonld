    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "60 minutes avec Mibenson Sylvain"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Élu révélation de l’année Juste pour rire en 2021 et gagnant du prix d’humoriste de l’année au Gala Dynastie 2023, Mibenson continue d'éblouir, que ce soit sur scène, à la télévision ou sur le web. Mibenson est actuellement en rodage avec son spectacle solo : Juste Miben. Humour, bouffe et bière ! *PLACES LIMITÉES *"
      }
    ],
