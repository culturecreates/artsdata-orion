    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Acharné"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Mike Beaudoin présente Acharné, son deuxième one-man show. L'humoriste, reconnu pour son franc-parler, continue d'y puiser dans sa vie pour se livrer sans compromis, avec des détails croustillants et hilarants. Ce spectacle fait suite à sa première tournée, VRAI, qui a connu du succès, et s'inscrit dans la continuité de sa présence assidue sur les réseaux sociaux et à la radio commerciale. On y retrouve des péripéties tirées de son quotidien, dont sa vie avec son adolescent, sa peur des psys et son impatience."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
