    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "15% de rabais pour l'expérience AURA grâce à votre titre de transport"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Célébrez les 60 ans du métro de Montréal avec AURA ! Sur présentation d’un titre de transport de la STM, profitez de 15 % de rabais sur l’entrée à l’expérience AURA à la basilique Notre-Dame de Montréal. Valide du 1er au 31 octobre 2026. Offre valable pour toutes les catégories d’âge, uniquement à l’achat de billets sur place, à la billetterie. Sous réserve de la disponibilité des billets. Places limitées."
      }
    ],
