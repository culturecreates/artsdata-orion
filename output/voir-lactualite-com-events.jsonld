        "@id": "https://voir.lactualite.com/genid/ce63e6000a9c20b5"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://grandtheatre.qc.ca/uploads/original_images/1500-85-trident-web-GTQ-428x599-3.png"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://voir.lactualite.com/evenements/7-minutes-comite-d-usine-6a7921"
