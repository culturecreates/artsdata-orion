    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "CBS Late Show's Django Gold"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Django Gold est un humoriste dont le travail d'auteur lui a valu sept nominations aux Emmy et un prix Peabody. Son spectacle est un stand-up qui aborde un large éventail de sujets, et la page le présente comme ayant été vu dans l'émission The Late Show with Stephen Colbert. Les premières parties proviennent de Just For Laughs et de CTV Comedy Channel. Le spectacle dure 90 minutes, se déroule en anglais et est réservé aux 18 ans et plus."
      }
    ],
