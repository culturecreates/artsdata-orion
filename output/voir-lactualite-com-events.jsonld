    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 23 octobre 2026 à 20 h, à Le Patriote Theater in Sainte-Agathe-des-Monts (Mont-Tremblant). Bruno Pelletier, l'un des chanteurs les plus appréciés de la francophonie, revient sur scène avec une nouvelle tournée intitulée « Trois et moi ». Conçu comme un moment de partage privilégié, ce spectacle…"
      }
    ],
