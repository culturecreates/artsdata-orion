    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 11 novembre 2026 à 19 h, à Bibliothèque «Le Survenant» (Sorel-Tracy). Venez découvrir des romans québécois qui ont été acclamés par différents prix littéraires au cours des dernières années, dans le cadre du club de lecture Québécois moderne, qui se tiendra les mercredis 14 octobre, 11 novembre…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
