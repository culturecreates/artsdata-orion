        "@id": "https://voir.lactualite.com/artistes/cathy-gauthier-875173#artist"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/5f9186c22e9383fa"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/cathy-gauthier-403e80"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Cathy Gauthier"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dotée d’une audace et d’un franc-parler qui ne laisse personne indifférent, Cathy Gauthier s’impose depuis ses débuts comme une figure marquante de l’humour québécois. Forte de quatre one-woman-shows, elle maîtrise son art avec une verve unique et assumée. Originaire de Rouyn-Noranda et diplômée de l’École nationale de l’humour, elle se fait rapidement remarquer, notamment en étant nommée Révélation de l’année au Festival Juste pour rire en 2003. Elle enchaîne ensuite les projets à la télévision et sur scène, tout en lançant des spectacles à succès comme 100% vache folle, Décoiffe, Pas trop catholique et Classique. Récompensée à plusieurs reprises, dont un Olivier de l’auteur de l’année et un Félix du spectacle d’humour de l’année, Cathy Gauthier poursuit une carrière riche et diversifiée, entre scène, télévision, radio et nouveaux projets."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
