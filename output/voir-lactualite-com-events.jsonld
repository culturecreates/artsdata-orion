    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "CONTES ET LÉGENDES"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Venez assister à un concert qui vous fera sortir des sentiers battus, où les histoires devotre enfance se mêleront aux musiques qui nous sont chères, et où nos musiciensdeviendront conteurs d'un jour, ou pourquoi pas de mille et une nuits! Dans un parcoursà travers l'imaginaire, nos cinq musiciens vous feront passer des nuits d'Arabiejusqu'aux sommets enneigés de la Scandinavie, en passant par les mers en bateau depirate. Vous entendrez la musique grandiose d'illustres opéras, les trames de filmsmarquants, des musiques traditionnelles pleines de nostalgie, des compositionsoriginales, sans oublier un détour dans la musique populaire québécoise! C'est unrendez-vous à ne pas manquer!"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
