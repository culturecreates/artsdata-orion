      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le samedi 30 janvier 2027 à 20 h, Théâtre du Marais / Scènes en nature (Val-Morin). Originaire du Nouveau-Brunswick, au cœur de l’Acadie, La famille LeBlanc…"
      }
    ],
