    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "COLIN BOUDRIAS - Spectacle en construction"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dans ce nouveau spectacle en rodage, Colinaborde des sujets aussi légers que distrayants comme : les réseaux sociaux, les animaux de compagnie et le technofascisme. Venez oublier vos problèmes en vous faisant rappeler que les milliardaires se construisent des bunkers en préparation de la fin du monde. Une heure de pur divertissement!"
      }
    ],
