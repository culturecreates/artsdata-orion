        "@id": "https://voir.lactualite.com/genid/ce057f728c097631"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://voir.lactualite.com/evenements/complet-flore-laurentienne-au-centre-manivelle-d2b233"
      }
    ],
