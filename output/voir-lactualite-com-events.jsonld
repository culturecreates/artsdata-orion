      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/bruno-rodeo-lp5-340"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Bruno Rodéo"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Après une pause d’un an sur scène, Bruno Rodéo revient avec un spectacle complètement éclaté, pensé pour être vécu de l’intérieur. Ici, pas de scène traditionnelle : tout se passe au cœur du public, rassemblé autour d’un feu central spectaculaire qui transforme la salle en lieu de rencontre vivant. En formule acoustique, accompagné du multi-instrumentiste Pascal Beaulieu et d’Adam Gilbert à la contrebasse, Bruno réinvente ses chansons dans une proximité saisissante. Chaque moment se vit à quelques pas, parfois à quelques regards. Du murmure le plus intime aux élans festifs qui font lever la salle, Le Feu dans place fait voyager à travers toutes les émotions, dans une ambiance brute, chaleureuse et profondément humaine. Une expérience immersive, surprenante et impossible à reproduire autrement."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
