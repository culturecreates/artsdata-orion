      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Du 6 au 19 mai 2027, Centre de design de l'UQAM (Montréal). L’Annuel de design est l’exposition phare des étudiantes et étudiants finissants de l’École…"
      }
    ],
