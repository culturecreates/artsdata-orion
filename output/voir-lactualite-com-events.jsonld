    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Sunday, November 8 Doors: 7:00 PM | Show: 8:00 PM Step into an evening of rich harmonies, heartfelt songwriting, and timeless folk traditions. Jessica Rhaye joins forces with Bill Preeper and Sandy MacKay—for a concert that blends Maritime roots with Appalachian soul. With a sound inspired by the folk revival of the 1960s, this trio […] \\n"
      }
