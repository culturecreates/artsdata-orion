    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "BIBLIOCLUB"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Nous vous invitons à participer en famille à des activités pour les enfants de 3 à 12 ans, sur le thème de la forêt, grâce au BiblioCLUB, un nouveau programme de l’Association des bibliothèques publiques du Québec qui valorise de manière ludique et originale la lecture estivale. Il permet aux jeunes de découvrir toutes les merveilles des créateurs et des créatrices d’ici en développant leur goût de la lecture."
      }
    ],
