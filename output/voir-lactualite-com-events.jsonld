      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Festival Les jours sont contés"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Du 15 au 25 octobre 2026, le festival de conte Les jours sont contés est de retour pour une 34e édition! Une édition sous le signe des nouveaux visages, puisque nous aurons le bonheur d’accueillir quatre conteurs d’outre-Atlantique qui en seront à leur tout premier séjour en Estrie : Djennie Laguerre, Najoua Darwiche, Toumani Kayoutéet Marien Guillé! C’est le moment de partir à l’aventure sur les chemins de l’imaginaire et de faire des découvertes qui s’annoncent déjà mémorables. Avis aux irréductibles, le passeport du festival donne accès à la grande majorité des activités à prix avantageux!"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
