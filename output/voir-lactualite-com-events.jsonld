    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/brock-oddish-et-le-reste-4b0f89"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Brock, Oddish et le reste!"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "C'est le 29 janvier 19h au légendaire Saint-Jean-Comédie-Club que se tiendra le spectacle d'humour thématique Brock, Oddish et le reste! Pour un soir seulement cinq humoristes vous présenteront du matériel unique à thème Pokémon. Le tout animé par le très nostalgique Vincent Descôteaux! Vous y verrez: ♕ Des blagues Ash, Bourgpalette, Mew qui n'est pas sous le camion dans Yellow, les faibles qui utilise les rare candy, à quel point Jynx a mal vieilli, fugue(scusez, essayer de devenir maitre pokemon), pokédex, ligue orange, ligue indigo, sur le fait que rien n'est plus cool qu'un Hitmonlee et bien plus encore! Il y aura aussi: ♕ De la musique tirée des films! ♕ Des extraits projetés ♕ Des surprises ♕ Des drinks thématique du genre, le Nurse Joy qui est un drink rose disponible dans 100% des hopitaux! Ne rate pas ça! ♕ Et bien plus encore!!!!"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
