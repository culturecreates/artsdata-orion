    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Bleu Jeans Bleu – Record NoV"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le groupe Bleu Jeans Bleu présente Record NoV, un nouveau spectacle qui allie leur musique efficace à leur humour décalé, dans une complicité directe avec le public. Le spectacle propose une ambiance feutrée et un décor italo-romantique. Le groupe est décrit comme l'un des favoris de la scène québécoise."
      }
    ],
