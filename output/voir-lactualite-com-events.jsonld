      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Conférence sur Harmonium, l'histoire derrière le mythe — Oka | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 29 octobre 2026 à 9 h 30, à Place citoyenne Oka (Oka). Dans le cadre d’une programmation annuelle, le déjeuner des aînés accueille des personnes âgées de 65 ans et plus à la Place citoyenne, de 9 h 30 à 11 h 30, dans une ambiance conviviale et dynamique. En plus de bénéficier d’un espace…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://voir.lactualite.com/evenements/conference-sur-harmonium-l-histoire-derriere-le-mythe-3178ec"
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
        "@value": "fr_CA"
      }
    ]
  },
  {
    "@id": "https://voir.lactualite.com/genid/52237f0f07ecbe63",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-10-29T09:30:00-04:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-10-29T11:30:00-04:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://voir.lactualite.com/genid/1dba327bbc16eb7c"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://voir.lactualite.com/evenements/conference-sur-harmonium-l-histoire-derriere-le-mythe-3178ec"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/228045c972a36745"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/conference-sur-harmonium-l-histoire-derriere-le-mythe-3178ec"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Conférence sur Harmonium, l'histoire derrière le mythe"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dans le cadre d’une programmation annuelle, le déjeuner des aînés accueille des personnes âgées de 65 ans et plus à la Place citoyenne, de 9 h 30 à 11 h 30, dans une ambiance conviviale et dynamique. En plus de bénéficier d’un espace gourmand et de breuvages, les participants assistent à une conférence et rencontrent des organismes de la région. 29 octobre: Conférence sur Harmonium, l’histoire derrière le mythe L’année 2026 marque le 50e anniversaire de la sortie de L’Heptade d’Harmonium, considéré par plusieurs comme étant l’album le plus important et ambitieux réalisé au Québec. À l’instar de Beau Dommage, Harmonium a grandement marqué non seulement l’histoire musicale, mais aussi l’histoire culturel du Québec. Au milieu des années ’70, le groupe, d’abord formé par Serge Fiori, Michel Normandeau et Louis Valois, a su incarner les valeurs d’une génération en plein bouleversement. Harmonium s’est rapidement hissé parmi les grands de notre mémoire collective. Leur répertoire d’à peine 21 chansons a traversé les époques et la plupart de celles-ci, par leur originalité et leur profondeur, sont depuis longtemps des classiques. Or, un certain mystère a toujours plané sur ses membres et sa musique, souvent qualifiée de folk-rock progressive. Cette conférence, notamment appuyée par la collection personnelle inédite et exclusive du conférencier, vise justement à lever le voile sur l’histoire derrière le mythe qu’entoure ce groupe culte chéri des Québécois. Pour l’inscription, veuillez contacter le service des loisirs et de la culture au [email] ou au [phone] poste 235. Consultez l’horaire dans votre Infolokal"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
