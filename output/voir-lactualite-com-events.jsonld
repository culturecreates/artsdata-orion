    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Clément Jacques Saint-Jacques"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Clement Jacques est un auteur-compositeur-interprète évoluant dans un style folk pop rock. Lors d'un précédent spectacle intitulé Iris, présenté à la suite de son cinquième album, il partageait sur scène des réflexions sur les relations humaines et le monde qui l'entoure, dans un univers scénique signé Daniel Fortin. Ce spectacle mêlait pop, folk et parfois rock, entrecoupant chansons récentes et titres marquants de son parcours."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
