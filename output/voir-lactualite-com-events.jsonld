    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Au travers de la route"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Au travers de la route est la tournée qui souligne les 25 ans de carrière de Vincent Vallières, auteur-compositeur-interprète québécois. Le chanteur y revient sur scène entouré de ses musiciens, avec son imposant répertoire réuni aux pièces de son nouvel album. Le spectacle a remporté le Félix du Script de l'année, prix partagé avec Christine Beaulieu lors du Gala de l'Industrie de l'Adisq."
      }
    ],
    "http://schema.org/inLanguage": [
