    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Boucar Diouf"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dans son spectacle précédent, Trois prédateurs et un bungalow, Boucar Diouf explorait la cohabitation entre l'humain, le chien et le chat autour d'un même frigidaire. Mêlant biologie, histoire et culture, il y retraçait la présence de ces deux animaux domestiques aux côtés de l'humain, une histoire qu'il présentait comme intimement liée à notre humanité."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
