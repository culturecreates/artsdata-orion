    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Alexandre Belliard"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Alexandre Belliard présente ses spectacles comme du « stand-up-historique avec une guitare ». Auteur-compositeur et conteur, il y aborde des pans de l'histoire à travers des personnages. Il a notamment présenté des spectacles consacrés aux patriotes et résistants, aux légendes hivernales et aux enfants terribles."
      }
    ],
