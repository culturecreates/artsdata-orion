    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Swing ton Noël est un événement présenté par le Centre de musique et de danse de Val-d'Or. Des professeur-es et des élèves de l'établissement y proposent une ambiance swing, dans un esprit festif. L'événement s'adresse à tous et vise à faire le plein d'énergie avant le temps des Fêtes."
      }
    ],
