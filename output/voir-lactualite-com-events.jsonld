    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Candlelight : Les Classiques de Noël — Sherbrooke | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 20 décembre 2026 à 0 h, à Église Saint-Jean Baptiste Sherbrooke (Sherbrooke). Célébrez la période la plus merveilleuse de l'année avec une collection de chants de Noël appréciés. Des chants intemporels aux favoris festifs, vivez les classiques de Noël avec ceux que vous aimez lors d'un concert…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
