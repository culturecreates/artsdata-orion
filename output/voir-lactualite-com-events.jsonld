    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/788f81e07a33a13c"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/banator-lancement-d-album-la-voix-du-silence-a-saint-jerome-lp2-81"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "BANATOR – Lancement d'album : La voix du silence à Saint-Jérôme (Tout âges)"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Rendez-vous hip-hop & musique urbaine à Saint-Jérôme ! Préparez-vous pour une soirée explosive le samedi 30 janvier 2027 ! Les projecteurs s'allument pour accueillir Banator en tête d'affiche, prêt à enflammer la scène et faire vibrer la salle. Pour réchauffer l'ambiance dès le départ, une sélection d'artistes survoltés assurera des premières parties mémorables : Hurst & Zazz, Mikael Rosby, Xavier Euphory, Number Juan et artistes invités. Un line-up chargé à bloc, de l'énergie brute et du gros son en direct à Saint-Jérôme. Ne manquez pas l'un des shows les plus chauds de cet hiver ! Réservez vos places dès maintenant et venez faire du bruit !"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
