      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/38229cd5e0760eca"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/art-atypique-l-empreinte-du-singulier-lp11-174"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Art atypique : l'empreinte du singulier"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Qu’ont en commun la peintre mexicaine Frida Kahlo, la sculptrice trisomique américaine Judith Scott et le slammeur français Grand Corps Malade ? Tous trois, comme bien d’autres artistes handicapés, ont harnaché leur différence pour générer des œuvres singulières aujourd’hui reconnues dans le monde entier. Mais d’où vient ce courant artistique qu’est « l’art atypique » ? Quelle est son histoire et quelles sont ses manifestations contemporaines ? Qu’est-ce qui le caractérise ? En compagnie de panélistes spécialistes du sujet, les convives de cette table rond tenteront d’apporter des éléments de réponses à ces intrigantes questions."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
