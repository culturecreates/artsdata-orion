    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Autour de IL DRAGO, LE PLUS GRAND CONTREBASSISTE DE… | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 4 avril 2027 à 0 h, à La Belle Chapel (Sherbrooke). Le contrebassiste réputé Joël Quarrington et sa complice Carole Sirois au violoncelle interprètent les grands duos de Domenico Dragonetti, ainsi que des œuvres inspirées par le talent et l'innovation d' « Il Drago » à la contrebasse."
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
