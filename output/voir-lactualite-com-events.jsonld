      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 31 octobre 2026 à 21 h 30, à Ausgang Plaza (Mont-Tremblant). Backstreet’s Back, alright! On Saturday, October 31st, SUPER TASTE takes over Ausgang Plaza for the 3rd Halloween edition of our legendary 90’S DANCE PARTY. Starting at 9:30PM, we’re summoning the spirits of the decade that gave us…"
      }
    ],
