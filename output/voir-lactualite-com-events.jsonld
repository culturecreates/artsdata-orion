      }
    ]
  },
  {
    "@id": "https://voir.lactualite.com/genid/452a65eb69e0bae3",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-01-25T19:00:00-05:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-01-25T22:00:00-05:00"
      }
    ],
