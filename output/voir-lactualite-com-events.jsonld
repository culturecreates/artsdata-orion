    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Bienveillant"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Bienveillant est un spectacle d'humour de Guy Nantel. Humoriste reconnu pour son franc-parler, son regard critique et son humour sociopolitique, il est connu pour une voix qui ose dire tout haut ce que beaucoup pensent tout bas. Avec une lucidité mordante et une ironie bien placée, il met le doigt sur les travers collectifs et les grands débats de notre époque."
      }
    ],
    "http://schema.org/inLanguage": [
