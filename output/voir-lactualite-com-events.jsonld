      }
    ]
  },
  {
    "@id": "https://voir.lactualite.com/genid/4b41f4b9470b58f6",
    "@type": [
      "http://schema.org/LiteraryEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-24T20:00:00-05:00"
      }
    ],
