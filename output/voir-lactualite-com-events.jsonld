    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Canzona Furioso"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Canzona Furioso met en scène Orlando, chevalier du Nord, et Abderam, chevalier du Sud, tous deux amoureux de la princesse chinoise Yuhuan. Séquestrée par le camp du Nord, la princesse parvient à s'enfuir, et les deux chevaliers abandonnent la guerre qui oppose leurs armées pour partir à sa recherche. Le roi du Sud envoie Malek ramener Abderam, tandis que la chevalière Bradamante, éprise d'Abderam, son ennemi du Sud, se lance aussi sur leurs traces. Les péripéties se multiplient, avec un hippogriffe, une orque marine et une magicienne qui déteste les princesses."
      }
    ],
    "http://schema.org/eventStatus": [
