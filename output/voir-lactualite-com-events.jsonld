    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Billie à la Croisée des Mondes"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Sortie familiale offerte par votre Sous-Groupe NR de la ville de Québec. \"Billie, une adolescente impulsive et anticonformiste, découvre qu'elle possède des pouvoirs magiques. Propulsée dans le mystérieux royaume de Hexe, elle vivra une aventure extraordinaire et lèvera le voile sur des secrets familiaux capables de bouleverser le monde des sorcières.\""
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
