    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Maxim Martin Bon Chien"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Maxim Martin compte 35 ans de carrière en humour, marqués par ses spectacles, ses présences à la radio, ses animations et ses numéros aux Galas Juste pour rire. Il a aussi publié un livre et animé une série sur son quotidien avec sa fille. Bon chien est son sixième one-man show. Il y propose une incursion dans sa quête de simplicité, dans une époque qui lui semble de plus en plus complexe, sur un chemin de petites et grandes frustrations vers la zénitude."
      }
    ],
