    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/451fb276681fc9fe"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/causerie-les-enseignes-lumineuses-dans-le-paysage-moderne-de-9974d9"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Causerie : les enseignes lumineuses dans le paysage moderne de banlieue, quelle histoire, quel avenir, quel réemploi?"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Colorées, vintage, rigolotes… Les enseignes lumineuses, qui connaissent un essor à partir des années 1960, sont des repères familiers dans le paysage urbain. Ayant pour but premier d’attirer notre attention dans un effort commercial, elles ont parfois un intérêt patrimonial ou artistique. Nous y sommes attachés, mais nous les connaissons peu et elles disparaissent rapidement. Comment les inventorier et les mettre en valeur ? Quels sont les exemples innovants dont Laval pourrait s’inspirer ? Venez en discuter avec la Société d’histoire et de généalogie de l’Île Jésus et trois spécialistes qui présenteront des études de cas inspirants : Christophe-Hubert Joncas de L’Enclume, qui a réalisé l’étude historique la période moderne à Laval et l’inventaire des enseignes d’intérêt patrimonial et identitaire pour la Ville de Montréal, Frédérique Gagné-Thibault de Passerelles COOP et le Centre des mémoires montréalaises (MEM). Cette activité est rendue possible grâce à l’Entente de développement culturel entre le gouvernement du Québec et la Ville de Laval."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
