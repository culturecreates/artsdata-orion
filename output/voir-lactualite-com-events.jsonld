    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Tim Burton's The Nightmare Before Christmas in Concert Live-to-Film"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Ciné-concert présenté à la Maison symphonique, dans le cadre de la production intitulée Disney Tim Burton's The Nightmare Before Christmas in Concert Live-to-Film. La musique de Danny Elfman, tirée du film, est interprétée en direct par l'Orchestre symphonique de Montréal, sous la direction de Ben Palmer, pendant la projection. Le film d'animation en stop-motion, devenu un film culte et ayant remporté deux prix Saturn, suit Jack Skellington, le Roi Citrouille, qui rêve de s'approprier la magie de Noël et de la ramener à Halloween Town. Le spectacle dure 1 h 20 sans entracte et se donne en anglais, avec sous-titres en français."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
