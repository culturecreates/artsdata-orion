      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/283e92fd863e3cc9"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/attention-fragile-tournee-32f516"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Attention : Fragile (tournée)"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Attention : Fragile est une pièce de théâtre sans parole d'une durée de 50 minutes, coproduite par L'Arrière Scène et Samsara Théâtre. Dans un espace vide, des livraisons s'empilent : deux personnages dans leur papier bulle, du mobilier de bureau et un catalogue. Les deux êtres improvisent leur existence au milieu de ces objets et doivent finalement choisir entre le vivant et l'encombrement. La mise en scène est signée Liliane Boucher, et l'interprétation est assurée par Jean-François Guilbault, Guillaume St-Amand, ainsi que Philomène Lévesque-Rainville en alternance avec Anne Trudel. La pièce aborde avec humour les effets néfastes de la surconsommation poussée à l'extrême. Depuis ses débuts en 1976, L'Arrière Scène privilégie la métaphore et la poésie dans ses créations."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
