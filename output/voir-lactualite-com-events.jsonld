    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "ACCUEIL ET ENREGISTREMENT* + PETIT-DÉJEUNER (optionnel)"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Pour ceux qui arrivent seulement le samedi matin: Patricia et Nady vous accueillent dans la Salle Sumac de l’hôtel Mont Gabriel pour enregistrer vos activités et vous remettre votre bracelet ainsi que votre passe de ski, coupon de cours de ski et coupon de chocolat chaud ! Ceux arrivés la veille pourront rejoindre le petit-déjeuner de l'hôtel. RÉSERVEZ UNE CHAMBRE *Hébergement non compris dans notre forfait, réservations optionnelles en direct avec l’hôtel ."
      }
    ],
