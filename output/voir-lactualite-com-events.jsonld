    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Bibi Club"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Bibi Club est le projet musical du duo formé d'Adèle Trottier-Rivard, voix et claviers, et de Nicolas Basque, guitares. Le duo explore l'avant-pop et l'electronic body music, avec des éléments de dark wave et de néofolk, et y ajoute des sonorités baroques, avec clavecins, trompettes et chants rituels. Son nom fait référence à la discothèque installée dans leur salon, où leurs « bibis », les personnes qui leur sont chères, viennent danser. Le nouvel album Amaro est désormais disponible, et un DJ set est prévu après la prestation. Le spectacle s'inscrit dans le cadre de la Journée internationale des droits des femmes."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
