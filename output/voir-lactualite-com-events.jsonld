    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/concert-en-compagnie-de-cyndia-quinn-d65c6b"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Concert en compagnie de Cyndia Quinn"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Cyndia Quinn sera en concert, le 18 avril, à 19 h, à l’église Sainte-Thérèse à Joliette. Elle sera accompagnée de deux musiciens et elle interprétera des chants classiques de ses albums, composés par des artistes de renom tels que Mozart, Bach, Franck ou Schubert. D’autres pièces, comme les Ave Maria, seront au programme. Cyndia Quinn est reconnue pour ses interprétations classiques et son engagement philanthropique. La première partie du spectacle sera assurée par son époux Sébastien Simard avec quelques pièces du projet psalmiste. En espérant apporter réconfort à ceux qui n’ont pas les moyens de se payer un billet, Cyndia Quinn offre 500 entrées gratuites. Il faut se les procurer à la paroisse Christ-Roi au [phone]. Un chapeau sera passé au cours de la soirée."
      }
    ],
    "http://schema.org/eventStatus": [
