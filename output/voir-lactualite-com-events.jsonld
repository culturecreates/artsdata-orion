    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Beethoven symphonique"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "L'année 2027 coïncide avec le 40e anniversaire de l'OSR et les 200 ans du décès de Beethoven. Le chef fondateur, Jacques Marchand, nous propose donc un programme entièrement beethovénien, soulignant les principales périodes du maitre à travers ses oeuvres symphoniques. Tout au long du concert, notre chef vous racontera ses liens familiaux avec Beethoven..."
      }
    ],
