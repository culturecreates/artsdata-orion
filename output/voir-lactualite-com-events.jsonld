    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Big O String"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le Big O String Band est un groupe de bluegrass Montréalais composé de musiciens chevronnés unissant leurs talents pour célébrer cette musique authentique et vibrante. Avec David Laflèche à la guitare, Joe Grass à la mandoline, Tommy Gauthier au violon, Alain Lafrance à la contrebasse et Thuya Boivin au banjo, ils proposent un son riche, mêlant tradition et modernité. Portés par une passion commune, ils insufflent une énergie unique à la scène bluegrass canadienne. Selon le nombre de billets vendus, le spectacle pourrait être proposé en formule debout, avec seulement quarante places assises sur les balcons."
      }
    ],
    "http://schema.org/eventStatus": [
