    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Matt Lang débarque en ville avec sa nouvelle tournée Ain't That Bad ! Figure incontournable de la musique country au Canada, Matt et ses musiciens nous entraînent dans un spectacle honky-tonk déjanté et spectaculaire, où son 4e album prend vie dans une mise en scène immersive et inédite."
      }
    ],
