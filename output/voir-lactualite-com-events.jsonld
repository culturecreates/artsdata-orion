    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "20 ans ! « 1l ne peut en rester qu’1 » (slam de poésie) —… | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 16 octobre 2026 à 20 h, à O Patro Výš (Montréal). Le 16 octobre 2006 se tenait le 1er « banc d’essai » de slam de Slamontréal. 20 ans plus tard, un slam de poésie (poetry slam) réunissant les championnes et champions qui se sont illustrés pendant ces deux décennies prendra place à O Patro Vys…"
      }
    ],
    "http://ogp.me/ns#url": [
