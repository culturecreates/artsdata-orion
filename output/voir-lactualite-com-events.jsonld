    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/a-deux-roues-la-vie-10beba"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "À deux roues, la vie!"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "À deux roues, la vie! est une production de Dynamo Théâtre, destinée au public familial à partir de 6 ans. Un homme revient après une longue absence et se trouve face à un héritage familial dans lequel il ne se reconnaît pas. Ne sachant ni qui il est ni d'où il vient, il doit renouer avec son identité. Une vieille bicyclette le conduit sur le chemin de ses origines. Dans un univers de réalisme magique et de magie patentée, la bicyclette devient plus qu'un objet, un élément fondamental de la vie. Le spectacle dure 55 minutes."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
