  {
    "@id": "https://voir.lactualite.com/evenements/abracadabra-chasse-aux-tresors-bb9ceb",
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "fr-ca",
        "@value": "VOIR — L’actualité"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Abracadabra - Chasse aux trésors — Québec | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 1er octobre 2026 à 0 h, à Musée des plaines d'Abraham (Québec). Partez à l’aventure sur les Plaines avec cette chasse aux trésors familiale. Vous aurez tous les outils dans votre baluchon pour découvrir les trésors cachés. Cet automne, les histoires refont surface et la magie s’installe!…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://voir.lactualite.com/evenements/abracadabra-chasse-aux-tresors-bb9ceb"
      }
    ],
    "http://ogp.me/ns#locale": [
      {
        "@language": "fr-ca",
        "@value": "fr_CA"
      }
    ],
    "http://ogp.me/ns#image": [
      {
        "@language": "fr-ca",
        "@value": "https://ccbnwebprod.blob.core.windows.net/website/Activités-et-événements/Abracadabra/_1200x630_crop_center-center_none/2023-DA-3.jpg"
      }
    ]
  },
  {
    "@id": "https://voir.lactualite.com/genid/c9c4349cb048e949",
    "@type": [
      "http://schema.org/ChildrensEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-10-01T00:00:00-04:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-08T00:00:00-05:00"
      }
    ],
