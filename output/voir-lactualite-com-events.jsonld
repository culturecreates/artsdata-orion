    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Quatuor Esca"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Depuis plus de vingt ans, le Quatuor ESCA marque la scène musicale d'ici par sa présence inspirante et son audace artistique. Ces musiciennes d'exception ont accompagné sur scène et à la télévision des artistes aussi marquants que Jean Leloup, Les Soeurs Boulay, Harry Manx, Diane Dufresne, Bruno Pelletier, Half Moon Run, pour ne nommer que ceux-là. Au fil des collaborations, ESCA a façonné une signature sonore unique, un quatuor vibrant où le classique rencontre la pop."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
