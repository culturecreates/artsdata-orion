    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Black Dog l’esprit de Led Zeppelin"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Souper Spectacle 92$/billet + taxes ouverture des portes à 18h évènement réservé aux adultes Black Dog Hommage à Led Zeppelin, vous transporte au coeur des performances enflammées de Led Zeppelin avec une passion et une authenticité inégalées. Basé à Montréal, ce collectif magistral séduit les amateurs de rock lors de chaque événement, festival ou soirée privée à travers le Québec. Avec une énergie brute et une dextérité scénique qui rappellent les jeunes années de Led Zep, Black Dog transcende la simple imitation pour offrir une expérience immersive et électrisante. Nul besoin de voyager dans le temps, leurs interprétations captivantes et leur audace en improvisation vous plongent instantanément dans l’univers soul et rock’n’roll du légendaire groupe anglais."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
