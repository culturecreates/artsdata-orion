  {
    "@id": "https://voir.lactualite.com/evenements/a-special-activity-for-the-kids-6555a3",
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "fr-ca",
        "@value": "VOIR — L’actualité"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "🎄 A special activity for the kids! 🎄 —… | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 14 décembre 2026 à 0 h, à Lieu à préciser – Sainte-Anne-de-Bellevue (Sainte-Anne-de-Bellevue). This workshop will help futur little elves create this magnificent Christmas tree, a decoration that can be hanged on THE tree, posted on a wall or a door or even wrapped up to offer to a special…"
      }
    ],
