    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Conte de Noël avec la mairesse"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Laissez-vous emporter par la magie des fêtes lors d’une heure du conte présentée par la mairesse Kim Méthot. Dans une ambiance chaleureuse et féérique, petits et grands sont invités à partager un moment d’émerveillement, de douceur et de magie à travers une histoire de Noël. Les places étant limitées, l’inscription à cette activité est obligatoire via la plateforme Sport-Plus. Cette activité est offerte sans frais pour tous les résidents de Saint-Basile-le-Grand. Pour les non-résidents, un coût de 5 $, taxes incluses, s’applique, sous réserve de places disponibles."
      }
    ],
