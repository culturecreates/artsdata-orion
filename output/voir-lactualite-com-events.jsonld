        "@language": "fr",
        "@value": "CARTE PERSONNALISÉE AVEC CRICUT :\nDÉCOUVERTE DES CARTES À INSERT"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Création des cartes de souhaits uniques grâce au système de cartes à insert Cricut. Les participants découvriront les fonctions de base de Cricut Design Space et apprendront à personnaliser leurs créations avec des motifs, du texte ou des illustrations réalisées avec les stylos Cricut. Préparation, découpe et assemblage de cartes."
      }
    ],
