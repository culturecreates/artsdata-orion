  {
    "@id": "https://voir.lactualite.com/genid/0e21d07abcacd7f4",
    "@type": [
      "http://schema.org/ComedyEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-12-05T20:00:00-05:00"
      }
    ],
