    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "ATELIER CONCERTINA"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dans cet atelier je vous propose une évolution à votre rythme dans les sujets et les styles qui vous intéressent. Cet atelier s'adresse à une clientèle d'artistes q'ont déjà acquis une certaine autonomie en peinture. Je vous propose un accompagnement personnalisé au besoin et au rythme de chacun. Vous devez arriver avec votre projet. Apporter des exemples de ce que vous peignez ( photos ou toile) Pour maximaliser cet atelier il est préférable de le suivre sur 4 jours."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
