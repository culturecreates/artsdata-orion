    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Contes autour du feu"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "En après-midi, rassemblez-vous autour du feu pour écouter deux histoires racontées par les naturalistes de GUEPE et découvrir la nature à travers des contes et des artéfacts. Au programme : Comment devenir une chauve-souris et La robe du corbeau. Les participants pourront également faire griller quelques guimauves autour du feu."
      }
    ],
