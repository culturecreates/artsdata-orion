    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "ENSEMBLE MURMUROSI · Chants polyphoniques d'hiver"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le trio Murmurosi vous invite à un voyage au cœur des traditions vocales ukrainiennes avec un concert a cappella mettant en lumière la richesse du répertoire hivernal du pays. À travers une sélection de koliadky et de schedrivky, ces chants associés aux célébrations de Noël et du Nouvel An, les trois voix tissent un paysage sonore empreint de spiritualité, de joie et de poésie. Puisant principalement dans les traditions des régions de Kyiv et de Poltava, Murmurosi fait revivre des mélodies transmises de génération en génération. Tantôt méditatifs, tantôt festifs, ces chants racontent les espoirs, les bénédictions et les rituels qui accompagnent la saison hivernale dans les villages ukrainiens. Porté par la pureté des voix et la richesse des harmonies vocales, ce concert révèle toute la beauté d'un patrimoine vivant où chaque chanson est porteuse d'histoire, de mémoire et de communauté. Une expérience musicale intime et lumineuse, qui célèbre la force de la tradition orale et l'émotion du chant partagé."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
