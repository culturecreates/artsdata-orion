    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Charles Beauchesne parle des Nazis"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "L’humoriste Charles Beauchesne est de retour avec une autre de ses loufoques conférences sur des pires moments de l’Histoire. Dans ce volet, venez découvrir les dynamiques à l’interne de quelques-uns des plus méchants individus sur terre: le cercle rapproché d’Hitler. Qui étaient les nazis? À quoi croyaient-ils vraiment? Pourquoi se détestaient-ils tous entre eux en fin de compte? Toutes ces choses et bien plus dans un heureux moment d’humour ludique, et qui sait, peut-être éducatif, avec diapositives bien sûr!"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
