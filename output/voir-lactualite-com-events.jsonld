    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Arnaud Soly"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Arnaud Soly est humoriste. Son premier one-man-show, Stand-Up, a attiré près de 70 000 spectateurs, et il compte des milliers d'abonnés sur les réseaux sociaux. En 2024, il a obtenu deux nominations au Gala Les Olivier, dans les catégories Olivier de l'année et Émission humoristique télé de l'année pour Club Soly. Dans son premier spectacle, il a notamment joué de la flûte avec son nez."
      }
    ],
