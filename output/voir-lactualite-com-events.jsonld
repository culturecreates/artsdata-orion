      {
        "@language": "fr-ca",
        "@value": "Bibi Club — Rimouski | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 24 octobre 2026 à 20 h 30, à Coop Bains Publics (Rimouski). Bibi Club est le projet musical d'Adèle Trottier-Rivard, voix et claviers, et de Nicolas Basque, guitares. Iels explorent le spectre sensible entre l’ici et le là-bas, en nous pointant l’amour, la nature et la communauté comme seule…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://voir.lactualite.com/evenements/bibi-club-158251"
      }
