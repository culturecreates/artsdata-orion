    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Colombie, tout en couleur"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Colombie, tout en couleur est un film réalisé par Julie Corbeil et présenté par Les Grands Explorateurs. Inspirée par des échanges avec des membres de la communauté colombienne du Québec, la réalisatrice porte sa caméra sur un pays longtemps associé à l'instabilité sociale et politique. De Bogotá à la région du café, en passant par les Andes et Medellín, le film rencontre artistes, entrepreneurs, cultivateurs de café et de cacao, jeunes engagés et citoyens qui participent au changement. Journaliste et enseignante en communications, Julie Corbeil produit depuis près de 20 ans des œuvres documentaires axées sur les rencontres. Ses films précédents présentés aux Grands Explorateurs portent sur le Japon, le Guatemala, Mexico et Copenhague."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
