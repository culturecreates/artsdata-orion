    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 19 novembre 2026 à 21 h, à Le Saint-Jean Comédie Club (Québec). Avec plus de 10 millions de vuessur ses capsules web, Alex Lapointe vous entraîne dans son univers avec ses anecdotes bien senties, son style unique et un sens du punch qui frappe toujours dans le mille. Entre observations…"
      }
    ],
