    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Conférence – Madagascar – au pays des lémuriens et des baobabs"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Pendant 2 mois, Pierre-Luc Côté a sillonné Madagascar à pied, en pirogue, en taxi-brousse et même en charrette à zébu, multipliant les aventures et les rencontres marquantes. À l’occasion de la Semaine québécoise des rencontres interculturelles, il vous invite à découvrir les richesses culturelles de cette île fascinante à travers ses échanges avec les peuples Vezo et Betsileo, leurs traditions, leurs rites et leur mode de vie. De plus, vous en apprendrez davantage sur des parcs nationaux spectaculaires, des villages isolés et une faune unique au monde. Cette conférence propose une immersion captivante au cœur du pays des lémuriens, des baobabs et de la diversité malgache."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
