    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Adam El Mouna"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Adam El Mouna livre un spectacle pop cinématique intense et rassembleur, porté par une énergie scénique immédiate et des productions modernes. Les beats percutants, les refrains accrocheurs et la montée dramatique de chaque morceau créent une expérience immersive qui capte le public dès les premières minutes. Entre puissance et émotion, le spectacle se marque par son impact, sa dynamique et sa capacité à faire vibrer la salle du début à la fin."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
