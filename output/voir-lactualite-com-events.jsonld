    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Célébrons Noël ensemble !"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Célébrons Noël ensemble ! est une activité proposée par la FADOQ, sur son site de l'île de Montréal, sous la forme d'un dîner dansant de Noël. Présentée comme une nouveauté, il s'agit du tout premier dîner dansant de Noël de l'organisme. L'activité est pensée comme un moment festif pour se retrouver, partager un repas, danser et terminer l'année dans une ambiance chaleureuse et conviviale."
      }
    ],
