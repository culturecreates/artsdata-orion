    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Becky à la plage"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Spectacle présenté dans le cadre du Dimanche des tout-petits Grâce à son imagination débordante, Becky vit dans un paradis fantaisiste où sable, soleil et vague la suivent partout. Au fil du spectacle, elle entraîne le public dans un voyage sous-marin extraordinaire où les prouesses de cirque se mêlent à la comédie et à de multiples surprises. Billets en vente dès le 25 août, 13 h"
      }
    ],
