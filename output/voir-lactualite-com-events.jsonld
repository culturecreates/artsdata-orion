      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Alexandre Forest"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Alexandre Forest est un humoriste dont l'univers, tel que décrit dans les présentations de ses spectacles, repose sur un alliage d'autodérision et de finesse d'esprit. Il y observe les petites et grandes incongruités de la vie quotidienne. Lors de présentations antérieures, il entamait le rodage de son premier one man show. Les sources consultées ne précisent pas le contenu du spectacle offert à Weedon."
      }
    ],
