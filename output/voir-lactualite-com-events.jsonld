    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le jeudi 19 novembre 2026 à 19 h, Palais Montcalm (Québec). Pour célébrer ses 20 ans, le Festival International Bach Montréal fait escale à Québec et réunit…"
      }
    ],
    "http://ogp.me/ns#url": [
