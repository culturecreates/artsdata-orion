      {
        "@id": "https://voir.lactualite.com/evenements/beer-fair-22c0e9"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Beer Fair"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "A celebration where everyone can find their style, the Beer Fair is taking over Parc Durocher on September 25 and 26. Just in time for Oktoberfest, brewers, local producers, restaurants, and artists will bring this hop-filled tradition to life in the heart of Québec City’s Saint-Sauveur neighbourhood. Purchase your official festival glass to enjoy tastings throughout the event."
      }
    ],
