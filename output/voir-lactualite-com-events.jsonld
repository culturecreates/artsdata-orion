    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Bach Incognito — Mr. Bach’s Memories"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "During the Festival International Bach Montréal, spend an afternoon with the family learning about Johann Sebastian Bach. Delightful anecdotes, funny moments, and deeply moving trials come to life through the music of a harpsichordist-actor, accompanied by the violin, flute, and cello. A show that blends humour and emotion, storytelling and music, for children 8 and up."
      }
    ],
