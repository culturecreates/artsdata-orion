    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Charles Brunet"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Charles Brunet est un humoriste. Son spectacle précédent, Très très bon show, a été présenté notamment au Théâtre Palace de Saguenay et à la Salle Albert-Rousseau, en représentation supplémentaire. Dans le texte de présentation de ce spectacle, l'humoriste, alors âgé de 24 ans, explique que le propos touche un peu à tout, de TikTok à MSN, et qu'il s'adresse autant aux jeunes qu'aux plus vieux. Il le décrit comme l'œuvre dont il est le plus fier dans sa jeune carrière."
      }
    ],
    "http://schema.org/inLanguage": [
