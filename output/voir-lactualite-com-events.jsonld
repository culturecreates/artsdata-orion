    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Bora Bora"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Partez à la découverte de quelques-unes des plus belles îles de la Polynésie française : la vibrante Tahiti, l’envoûtante Moorea, la naturelle Huahine et l’idyllique Bora Bora. À travers le regard d’une sympathique famille, plongez au cœur d’une culture authentique et de panoramas spectaculaires : lagons turquoise, montagnes majestueuses, plages immaculées et une faune marine exceptionnelle. Un véritable rendez-vous avec l’émerveillement - dans ce paradis terrestre !"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
