    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Christian Clermont"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Après plus de 25 ans de succès en composition musicale pour la télévision et le cinéma, le pianiste Christian Clermont dévoile une facette plus personnelle avec Lac des Sables, son premier album sorti en 2025. Ses compositions néo-classiques, à la fois intimistes et universelles, promettent un voyage dans un univers riche et nuancé, où piano et violoncelle s’entrelacent mélodieusement sur scène."
      }
    ],
