    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Bredouille le clown rêve de devenir lutin du père Noël. Entre costume, goûter, cadeaux à emballer et sapin à décorer, il relève plusieurs défis. Mais ses idées clownesques feront-elles de lui un lutin vraiment efficace ?"
      }
