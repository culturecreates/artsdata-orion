      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/chante-joe-dassin-lp1-1821"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Chante Joe Dassin !"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Après avoir conquis le public québécois, Julien Dassin chante Joe Dassin est de retour pour une nouvelle tournée célébrant l’œuvre intemporelle de l’une des plus grandes figures de la chanson francophone. Porté par l’émotion, la sincérité et le profond attachement qui l’unit à l’héritage de son père, Julien Dassin fait revivre les chansons qui ont marqué plusieurs générations. Accompagné de six musiciens d’exception du Band Paris Tour Eiffel, il revisite les grands succès de Joe Dassin, dont Les Champs-Élysées, Et si tu n’existais pas, L’Été indien, Le Jardin du Luxembourg et bien d’autres. Un moment rare et poignant où la musique devient un pont entre passé et présent, entre mémoire et renaissance."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
