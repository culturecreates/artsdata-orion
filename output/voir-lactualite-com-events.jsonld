    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Bruno Pelletier 3 & Moi"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Bruno Pelletier, chanteur reconnu de la francophonie, présente «3 & Moi», une tournée conçue comme un moment de partage privilégié. Entouré de trois musiciens, l'artiste y propose une interprétation dépouillée de ses plus grands succès et de chansons coups de coeur choisies avec soin. Ce format épuré met l'accent sur les harmonies vocales, des arrangements délicats et une proximité sincère avec le public, dans une ambiance conviviale."
      }
    ],
