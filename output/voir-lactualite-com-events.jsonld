      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Jusqu’au 11 décembre 2026, Cégep de Victoriaville (Victoriaville). J’apprécie l’art sous toutes ses formes. L’art abstrait me passionne tout particulièrement.…"
      }
    ],
    "http://ogp.me/ns#url": [
