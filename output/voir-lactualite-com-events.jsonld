    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Benny Benassi"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Véritable pionnier de l’électro house, le DJ et producteur italien Benny Benassi sera de passage à Trois-Rivières pour la toute première fois le vendredi 19 février. Reconnu mondialement pour son succès Satisfaction, qui a marqué plusieurs générations, il promet tout un party électro sur la scène Artik oxio, au parc portuaire, pour lancer le week-end de l’ArtikFest en grand. Lauréat d’un Grammy Award, il s’est imposé comme une figure emblématique de la scène électronique internationale et a collaboré avec des artistes de renom comme Madonna et Chris Brown au fil de ses deux décennies de carrière."
      }
    ],
    "http://schema.org/eventStatus": [
