    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Crochet sur jute"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Laissez-vous guider par deux artisanes qui vous accompagneront dans l’apprentissage de la technique du crochet sur jute afin de créer des œuvres collectives avec de la matière recyclée. Très populaire dès le XIXe siècle dans les Maritimes où les sacs de pommes de terre et de grains servent de canevas de base, la mode du tapis « hooké » se répand grâce au fait que le matériel est gratuit, accessible et permet la réutilisation."
      }
    ],
    "http://schema.org/inLanguage": [
      {
