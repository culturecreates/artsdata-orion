    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/2b84f678a08e6090"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/anesthesia-lp5-116"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "AnesthesiA"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "AnesthesiA – l’hommage à Metallica par excellence! Fort de l’énorme succès de leur formule hommage à Metallica symphonique, présentée avec l’Orchestre symphonique de Québec, l’Orchestre symphonique de Trois-Rivières et l’Orchestre FILMharmonique dans les plus grandes salles au Québec notamment à Montréal, Québec, Trois-Rivières, Gatineau, St-Jérôme, la meilleure formation hommage à Metallica par AnesthesiA s’arrête à la salle Kingsey avec leur formule hommage à Metallica standard (4 musiciens) pour rendre un hommage dynamique, décapant et fidèle à la carrière de nos fameux californiens préférés! Les savants connaisseurs de rock qui se présenteront à la salle Kingsey vendredi, le 30 avril 2027 en auront plein la vue et les oreilles alors que la formation AnesthesiA leur livrera le meilleur des années 80 et 90 de Metallica! C’est littéralement la crème de la crème qui vous sera servie pour l’occasion! Un événement à ne pas manquer pour tout amateur de rock lourd! Billets en vente dès maintenant!"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
