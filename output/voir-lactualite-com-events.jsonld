    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le résultat est un son novateur, une technique virtuose et une passion musicale partagée qui ont fait de 40 FINGERS l'un des ensembles de guitares crossover les plus captivants de la scène musicale internationale. Fondé en 2017, le quatuor italien - Matteo Brenci, Emanuele Grafit…"
      }
