    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 15 octobre 2026 à 12 h 30, à Atwater Library (Westmount). For the Atwater Library Lunchtime Series, writer and artist Wayne Larsen gives an illustrated presentation on the life and work of Newfoundland-born Montreal painter Robert W. Pilot (1898–1967). To REGISTER and get the Zoom link, click…"
      }
    ],
