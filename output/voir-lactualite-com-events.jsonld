    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Cycle Martin Mcdonagh à Montréal — 19 nov.–1er déc. 2026 | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Prochaine date le jeudi 19 novembre 2026 à 20 h, Cinémathèque québécoise (Montréal), et 1 autre date jusqu’au 1er décembre 2026. Pour la saison la plus sombre…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://voir.lactualite.com/evenements/cycle-martin-mcdonagh-a-la-cinematheque-quebecoise-df5702"
