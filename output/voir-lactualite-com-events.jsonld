  {
    "@id": "https://voir.lactualite.com/evenements/atelier-pour-les-9-12-ans-flash-info-jeunesse-au-journal-tel-f23277",
    "http://ogp.me/ns#type": [
      {
        "@language": "fr-ca",
        "@value": "article"
      }
    ],
    "http://ogp.me/ns#site_name": [
      {
        "@language": "fr-ca",
        "@value": "VOIR — L’actualité"
      }
    ],
    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Atelier pour les 9-12 ans | Flash info jeunesse au journal… | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 12 décembre 2026 à 14 h, à Bibliothèque Laure-Conan (Laval). Découvrez toutes les étapes de la création d’un journal télévisé, de la préparation des sujets à la présentation devant la caméra. En équipe, écrivez un bulletin clair, explorez divers rôles et enregistrez votre propre émission. Une…"
      }
    ],
