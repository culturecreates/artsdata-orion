      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 28 décembre 2026 à 14 h, à Bibliothèque Laure-Conan (Laval). Avec la comédienne Aouatef Krikrou, découvrez les bases du théâtre dans une ambiance amusante et créative. Vous pourrez inventer et improviser votre propre scène, et vous apprendrez les techniques pour captiver votre public et briller!"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
