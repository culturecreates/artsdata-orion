    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "V.I.E - Voyage Intérieur Expérimental — Québec | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 24 novembre 2026 à 20 h, à Grand Théâtre de Québec (Québec). Il y a des spectacles qui divertissent et d’autres qui ouvrent des portes! Le spectacle V.I.E. (pour Voyage Intérieur Expérimental) est une expérience d’un nouveau genre. Dans ce mélange de rêve éveillé, de méditation guidée, d’humour…"
      }
    ],
    "http://ogp.me/ns#url": [
