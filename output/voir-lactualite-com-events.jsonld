    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Bon jus"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Arnaud Soly présente Bon Jus, son deuxième one-man-show. Selon lui, il s'agit de son meilleur spectacle à ce jour, et le choix du titre serait, selon ses mots, difficile à expliquer. Le texte est signé par Arnaud Soly et Julien Corriveau, qui signe aussi la musique avec France Basilic. L'éclairage et le décor sont de Robin Kittel-Ouimet, et Charles Dauphinais conseille la mise en scène."
      }
    ],
