    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Bricolage libre familial"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Venez bricoler, dessiner ou peindre, au moyen de diverses techniques et au gré de votre imagination lors de la journée pédagogique du lundi 5 octobre, de 10 h à 12 h à la bibliothèque « Le Survenant » (145, rue George). Animation: bibliothèques de Sorel-Tracy Pour toute la famille (8 ans et moins accompagné(e)s d'un adulte) Aucune inscription requise Pour plus de renseignements, vous pouvez contacter l'équipe des bibliothèques en composant le [phone], poste 4753, ou en écrivant à [email] Le local où se déroulera l'activité est accessible aux personnes à mobilité réduite, via la porte d'entrée située à l'arrière de la bibliothèque."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
