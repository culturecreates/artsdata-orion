  },
  {
    "@id": "https://voir.lactualite.com/genid/9ec6e57f62bbb1b3",
    "@type": [
      "http://schema.org/MusicEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-11T19:30:00-05:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-11T22:30:00-05:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://voir.lactualite.com/genid/de4a2b306ab58061"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://voir.lactualite.com/evenements/cc-duo-1c031f"
