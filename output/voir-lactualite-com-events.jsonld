  {
    "@id": "https://voir.lactualite.com/genid/ef30ff57917c6af2",
    "@type": [
      "http://schema.org/DanceEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-15T13:15:00-05:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-15T16:15:00-05:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://voir.lactualite.com/genid/9e19299129217a77"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://voir.lactualite.com/evenements/contact-improvisation-gatineau-8d683c"
      }
    ],
    "http://schema.org/offers": [
