      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Pour clôturer les activités du 40º anniversaire, la Société historique de Bellechasse vous invite à un magnifi que concert de Noël présenté par Le Choeur de Bellechasse sous la direction musicale de Michel Aubert. Un spectacle spécialement conçu pour vous mettre dans l'ambiance du temps des Fêtes avec des prestations originales qui vous raviront. Un Concert de Noël qui vous promet de belles surprises !"
      }
    ],
