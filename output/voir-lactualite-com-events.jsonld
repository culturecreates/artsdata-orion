    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Charlie et le Moyen-Âge"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Parachuté à l’époque des chevaliers de la Table ronde, Charlie rencontre la reine Guenièvre, prisonnière de son propre château, qui lui confie un message destiné au roi Arthur. Pour l’acheminer, Charlie devra se faire troubadour, obtiendra l’aide de Gros-Pierre – paysan bourru mais au grand cœur -, visitera l’atelier d’un enlumineur… Heureusement, Merlin l’enchanteur n’est jamais loin : avec lui comme guide, Charlie est sur la bonne voie ! Un spectacle haut en couleurs, ponctué de trompette et de jonglerie !"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
