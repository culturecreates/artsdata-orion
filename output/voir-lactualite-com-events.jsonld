    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 23 octobre 2026 à 21 h 30, à The Wiggle Room (Montréal). Beckoning you to indulge in late night fantasies and intimate whispers, you are invited to Cabaret PM. Featuring Burlesque artists from across Canada, each artist was told to bring their sexiest act."
      }
    ],
