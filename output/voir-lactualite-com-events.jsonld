    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Alex Lapointe en rodage"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Avec plus de 10 millions de vuessur ses capsules web, Alex Lapointe vous entraîne dans son univers avec ses anecdotes bien senties, son style unique et un sens du punch qui frappe toujours dans le mille. Entre observations mordantes, anecdotes croustillantes et réflexions bien senties, Alex vous livre un rodage sans filtre où tout peut arriver. Une occasion en or de découvrir l’un des humoristes les plus prometteurs de sa génération — brut, drôle, vrai."
      }
    ],
    "http://schema.org/inLanguage": [
