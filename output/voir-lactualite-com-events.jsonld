    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le dimanche 27 décembre 2026 à 14 h, Bibliothèque Marius-Barbeau (Laval). Vous pensez que l’humour est un don? Bonne nouvelle : ça s’apprend! En compagnie…"
