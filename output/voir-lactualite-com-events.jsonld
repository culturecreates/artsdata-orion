      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/creuser-les-pixels-les-mineraux-dans-les-jeux-videos-116b4b"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "CREUSER LES PIXELS. Les minéraux dans les jeux vidéos"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Dès le 10 juin 2026, avec la collaboration d’Agnico Eagle, le Musée minéralogique de l’Abitibi-Témiscamingue présentera l’exposition Creuser les pixels : les minéraux dans les jeux vidéo, une expérience interactive qui propose d’explorer les liens fascinants entre le monde minéral et l’univers vidéoludique. À travers différents univers inspirés des jeux vidéo, les visiteurs seront invités à découvrir comment les minéraux, métaux et pierres précieuses sont représentés dans les mondes numériques. L’exposition permettra également de comparer les propriétés réelles des minéraux avec leurs représentations fictives dans les jeux, entre fidélité scientifique et libertés créatives. Pensée pour un public de tous âges, Creuser les pixels combine science, culture populaire et imaginaire numérique dans une approche à la fois ludique et éducative. Petits et grands pourront ainsi partir à la découverte des ressources minérales qui façonnent les mondes virtuels autant que notre réalité."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
