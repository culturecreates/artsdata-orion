    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "3 & moi"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Bruno Pelletier présente « 3 & moi », un spectacle intimiste et chaleureux. Entouré de trois musiciens complices, il propose une relecture dépouillée de ses grands succès ainsi que de pièces choisies pour leur résonance personnelle. Dans ce format épuré, les harmonies vocales et les arrangements délicats occupent une place centrale, pour une soirée conçue comme un moment de simplicité partagée, où l'on chante, rit et se laisse toucher."
      }
    ],
