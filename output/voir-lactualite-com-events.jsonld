      {
        "@language": "fr",
        "@value": "ARcade by Moment Factory at the Casino de Montréal – 1 h"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "ARcade est une expérience multijoueur augmentée créée par Moment Factory, présentée au Casino de Montréal pour une durée d'une heure. Le principe consiste à jouer à un jeu vidéo projeté sur le sol, les participants servant eux-mêmes de manette, sans écran ni casque de réalité virtuelle. L'accès est réservé aux personnes âgées de 18 ans et plus."
      }
    ],
