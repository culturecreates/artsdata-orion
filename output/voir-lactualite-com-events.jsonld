  {
    "@id": "https://voir.lactualite.com/genid/3285c3a8eb075dfb",
    "@type": [
      "http://schema.org/TheaterEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-01-09T15:00:00-05:00"
      }
    ],
