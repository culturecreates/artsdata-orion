    "http://ogp.me/ns#title": [
      {
        "@language": "fr-ca",
        "@value": "Domus: Vues d’intérieurs à Rimouski — jusqu’au 22 nov. 2026 | VOIR"
      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Jusqu’au 22 novembre 2026, Musée de Rimouski (Rimouski). L’exposition Domus: Vues d’intérieurs de Massimo Guerrera s’inscrit dans la vision artistique…"
      }
    ],
    "http://ogp.me/ns#url": [
      {
        "@language": "fr-ca",
        "@value": "https://voir.lactualite.com/evenements/domus-vues-d-interieurs-dea844"
