  {
    "@id": "https://voir.lactualite.com/genid/87bb66b8c90c0547",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-20T08:30:00-05:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-20T16:00:00-05:00"
      }
    ],
