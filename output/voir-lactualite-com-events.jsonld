      {
        "@language": "fr",
        "@value": "Activité de Noël – Décoration de bougies"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Laissez libre cours à votre créativité lors de cet atelier festif de décoration de bougies. À l’aide de peinture, de motifs découpés et de divers éléments décoratifs, créez une décoration unique à offrir ou à conserver pour embellir la maison pendant les Fêtes. Tout le matériel est fourni."
      }
    ],
