    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Ben et Jarrod"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Ben et Jarrod forment un duo d'humour qui s'appuie sur les personnages et les sketchs. Connus notamment sous les noms de Brigitte et Christian, un couple, des rappeurs ratés de la banlieue ou encore les frères Greg et Stu Much, ils proposent un reflet imagé et humoristique de notre société. Leur travail rejoint les amateurs d'humour à personnages et d'humour à sketchs, avec un regard différent et rafraîchissant."
      }
    ],
