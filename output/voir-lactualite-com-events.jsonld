    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 18 novembre 2026 à 0 h, à Graffiti Café-Théatre (Port-Cartier). Clément Jacques est un auteur-compositeur-interprète évoluant dans un registre folk pop rock. Son spectacle précédent, Iris, faisait suite à la sortie de son cinquième album et proposait un regard sensible sur les relations…"
      }
