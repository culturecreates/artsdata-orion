        "@id": "https://voir.lactualite.com/evenements/entre-mer-et-monde-atlas-geocircus-6ae06e"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Entre mer et monde Atlas Géocircus"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "SPECTACLE JEUNE PUBLIC - BALCON FERMÉ Inclus dans le programme des Passeurs culturels Embarquez dans une aventure acrobatique et immersive, où chaque numéro de cirque explore un coin du monde et ses particularités culturelles. Les artistes du Atlas Géocircus mélangent acrobatie, jonglerie, équilibre et contorsion pour faire découvrir au jeune public les merveilles du monde et des océans, tout en abordant des thématiques écologiques et culturelles. Un spectacle énergique et éducatif, qui allie arts du cirque, exploration et sensibilisation à la planète!"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
