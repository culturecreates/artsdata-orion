      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 15 octobre 2026 à 19 h, à Centre d'exposition de Blainville (Blainville). Vous êtes créatif? Vous faites de la peinture, du dessin, vous aimez écrire? Vous êtes professionnel, ou amateur-passionné? Cet atelier est pour vous! Laissez-vous inspirer en direct par la musique du guitariste Simon…"
      }
    ],
    "http://ogp.me/ns#url": [
