      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le samedi 13 février 2027 à 14 h, Carrefour culturel Estacade (Gatineau). Dans ce spectacle participatif et rigolo, Béa Bestiole cherche à savoir qui habite…"
      }
    ],
    "http://ogp.me/ns#url": [
