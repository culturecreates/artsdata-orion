    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Le contrebassiste Alex Bellegarde fusionne le jazz latin contemporain, les rythmes afro-cubains et l’improvisation libre. Un concert électrisant mettant en vedette d’excellents musiciens. Alex Bellegarde - Contrebasse Willy Baretto - Piano Nestor Rodrigez - Saxophone Diomer Gonzales - Percussions"
      }
