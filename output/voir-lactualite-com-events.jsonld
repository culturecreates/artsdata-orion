        "@value": "fr_CA"
      }
    ]
  },
  {
    "@id": "https://voir.lactualite.com/genid/082b5e5cbb36656c",
    "@type": [
      "http://schema.org/MusicEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-02-19T20:00:00-05:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-02-19T23:00:00-05:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://voir.lactualite.com/genid/3fb3303f80e8e181"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://voir.lactualite.com/evenements/alexe-11-11-209c3f"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://voir.lactualite.com/genid/637b9e2f294b1311"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://voir.lactualite.com/artistes/alexe-6caef2#artist"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/aec24e6fbd40dd81"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/alexe-11-11-209c3f"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Alexe | 11:11"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Native du Saguenay–Lac-Saint-Jean, Alexe est découverte lors de l’émission La Voix. Elle se fait connaître auprès du public grâce à sa chanson Placebo, qui marque le début de sa carrière d’artiste indépendante. Depuis, elle évolue sur la scène musicale francophone en tant qu’autrice-compositrice-interprète. En 2020, elle se retire temporairement pour vivre pleinement la maternité. En mai dernier, elle revient avec son EP Copier Coller, dévoilant six titres qui témoignent de la maturité artistique acquise au fil des années. Elle y propose une pop francophone raffinée, portée par des mélodies accrocheuses et une interprétation habitée. Alexe prépare actuellement son prochain album, attendu en février 2026. Elle y explore avec justesse et bienveillance des thèmes forts tels que le deuil, la dépendance et le féminisme. Voyagez au son sans pareil de la voix d’Alexe, à travers ses doutes et ses découvertes, dans des chansons qui tracent le chemin de la croissance personnelle, entre résilience et puissance d’être femme."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
