        "@value": "https://co-motion.ca/uploads/Spectacles/_750x9999_fit_center-center_99_none/Olivier-Martineau.jpg"
      }
    ]
  },
  {
    "@id": "https://voir.lactualite.com/genid/bf3e0ced5646a860",
    "@type": [
      "http://schema.org/ComedyEvent"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-12-10T19:30:00-05:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-12-10T22:30:00-05:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://voir.lactualite.com/genid/aeb9b099d15a8be2"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://co-motion.ca/uploads/Spectacles/_750x9999_fit_center-center_99_none/Olivier-Martineau.jpg"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://voir.lactualite.com/evenements/c-est-pas-moi-c-est-toi-2e5907"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://voir.lactualite.com/genid/01efce28b672e7a1"
      }
    ],
    "http://schema.org/performer": [
      {
        "@id": "https://voir.lactualite.com/artistes/olivier-martineau-59ed4a#artist"
      }
    ],
    "http://schema.org/organizer": [
      {
        "@id": "https://voir.lactualite.com/genid/56f964c3edf695e2"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/c-est-pas-moi-c-est-toi-2e5907"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "C'est pas moi, c'est toi"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Société, c’est fini. Oui, on a eu de beaux moments, mais là, c’est trop. T’as changé. Moi, je m’en vais. Je te laisse tes règles farfelues et tes promesses en plastique. J’en ai assez de cette mascarade. C’EST PAS MOI, C’EST TOI, c’est du stand-up pur et dur, un véritable feu roulant de gags où chaque punch frappe en plein cœur. Un regard sans filtre, mordant, mais surtout hilarant, sur une société où la rupture était inévitable. Après trois spectacles, celui-ci est le plus audacieux, le plus osé, le plus authentique. Bref, c’est la fin d’une histoire… et le début d’un show qui décoiffe. Mais moi, je m’en fous, j’ai pas de cheveux."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
