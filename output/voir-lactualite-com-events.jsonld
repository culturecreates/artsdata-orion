    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Bibliothèque vivante / 8 femmes, 8 visages, 8 histoires de vie"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Sous forme d’échanges conviviaux, les citoyens pourront découvrir le parcours inspirant de huit femmes d’ici et leur poser des questions dans un climat d’ouverture. Cette rencontre vise à favoriser le dialogue, le partage des savoirs et le rapprochement intergénérationnel."
      }
    ],
