      }
    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 3 août 2026 à 0 h, à Lieu à préciser – La Prairie (La Prairie). Une exposition des œuvres de Michel R Lalonde Découvrez le fruit d’années de recherches et d’essais pendant lesquelles l’artiste a testé et développé différentes techniques afin de créer des tableaux qui sortent des sentiers battus."
      }
    ],
    "http://ogp.me/ns#url": [
