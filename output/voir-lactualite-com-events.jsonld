    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Daniel Grenier"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Daniel Grenier présente «Cœur d'enfant», un spectacle d'humour. Selon la description du spectacle, garder son cœur d'enfant, c'est refuser de laisser la vie user l'émerveillement, continuer à s'étonner devant les petites choses et garder une certaine légèreté, sans être naïf. Il s'agit d'une soirée présentée comme drôle, sensible et surprenante, où l'humour de Daniel Grenier rappelle que la joie est un instinct qu'on peut nourrir chaque jour. L'artiste a aussi lancé un premier livre jeunesse intitulé «Histoires de balle»."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
