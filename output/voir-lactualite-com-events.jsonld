    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 9 novembre 2026 à 20 h, à Théâtre Gilles-Vigneault (Saint-Jérôme). Daniel Lemire est originaire de Drummondville. Il a commencé sa carrière en 1980 avec son premier spectacle, Parlez-moi d'amour, puis s'est fait connaître du grand public en 1982 aux Lundis des Ah! Ah! et en 1983 au premier…"
      }
    ],
