    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 30 octobre 2026 à 20 h, à Maison de la culture Nouvelle (Nouvelle). Le groupe emblématique du hard folk italien, I Matti delle Giuncaie, rencontre le rocker toscan Borrkia. Avec eux pour la tournée 2026, le charisme latin de Julian Corradini, leader de Terapia Latina, formation historique…"
      }
    ],
