    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Du passé au présent"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Du passé au présent est un concert du saxophoniste, compositeur et arrangeur Jean-Pierre Zanella. Avec son quartet, il revisite des œuvres majeures de Chopin à Villa-Lobos, en passant par Fauré et Beethoven, dont le Prélude opus 28 no 4 de Chopin et Lettre à Élise. Le quartet réunit Pierre François au piano, Rémi-Jean Leblanc à la contrebasse et Paul Brochu aux percussions. Le spectacle est présenté par l'Aramusique dans sa série Apéro-Jazz, en formule cabaret."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
