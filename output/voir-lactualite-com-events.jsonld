    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "ATELIER D’ART EN FAMILLE : Noël à Mull Hall"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Tel que veut la tradition, nous inviterons les familles à créer leurs propres décorations des fêtes, inspirées par l’époque des MacLean (1916-1940). Atelier : Décoration de Noël Des gâteries seront servies. Cet atelier est spécialement conçu pour les familles. 6 à 12 ans, dans le salon MacLean. Légende : Archives de la famille MacLean"
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
