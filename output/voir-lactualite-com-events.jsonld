    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://voir.lactualite.com/evenements/angelique-francis-268116"
      }
    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "ANGELIQUE FRANCIS"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Autrice-compositrice-interprète originaire d'Ottawa, Angelique Francis est une musicienne polyvalente, multi-instrumentiste, dont le travail a été récompensé d'un prix Juno pour le meilleur album blues avec Long River. Sa voix puissante et texturée s'inscrit dans un univers musical mêlant blues, soul, folk, jazz, gospel et rock. Elle a assuré les premières parties de plusieurs artistes reconnus, dont Gary Clark Jr., Beth Hart, Tom Cochrane et Burton Cummings, et s'est produite dans des festivals comme le Festival International de Jazz de Montréal et l'Ottawa Jazz Festival."
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
