    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Ce qui fait la grandeur d’un artiste lyrique - volet I — SAVM"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Au cours du premier volet de cette série, on comparera différentes interprétations d'un même air par plusieurs chanteurs afin de mettre en relief les qualités que l'on attend d'un artiste lyrique d'exception. On reviendra alors sur plusieurs notions importantes et on définira de manière précieuse plusieurs termes et expressions (legato, coloratura, phrasé analytique, chant sur le souffle, etc.). Parmi les airs étudiés : Pourquoi me réveiller du Werther de Massenet et Nessun dorma de Turandot de Puccini."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
