    ],
    "http://ogp.me/ns#description": [
      {
        "@language": "fr-ca",
        "@value": "Le 11 novembre 2026 à 20 h, à Grand Théâtre de Québec (Québec). Clemens Schuldt : chef Bryn Lutek : percussion Lauren Margison : soprano Gordon Bintner : baryton-basse Chœur de l’Orchestre symphonique de Québec David Rompre : chef de chœur MOZART S’INVITE À LA FÊTE AVEC SA QUARANTIÈME Trois…"
      }
    ],
