    ],
    "http://schema.org/name": [
      {
        "@language": "fr",
        "@value": "Bruno Pelletier – 3 et Moi"
      }
    ],
    "http://schema.org/description": [
      {
        "@language": "fr",
        "@value": "Un spectacle festif et chaleureux où la virtuosité rencontre la spontanéité. Accompagné de Martin Bachand, Claude Pineault et Brigitte Marchand, Bruno Pelletier revisite avec authenticité les grandes chansons de sa carrière — Coriace, Ailleurs c’est comme ici, Le temps des cathédrales — ainsi que des coups de coeur personnels, de Supertramp à Elvis Presley, en passant par The Beatles et Grease. Chaque concert devient unique : les musiciens improvisent, se répondent et partagent avec le public le pur plaisir de jouer ensemble. Rock, pop, opéra, folk et country se côtoient dans une atmosphère chaleureuse et libre où tout peut arriver. 3 & Moi, c’est une rencontre sincère entre quatre amis et un public conquis, une soirée enivrante où la complicité et la musique rassemblent."
      }
    ],
    "http://schema.org/inLanguage": [
      {
        "@language": "fr",
        "@value": "fr-CA"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ]
  },
