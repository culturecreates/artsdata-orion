      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://tprowest.ticketpro.ca/en/pages/1696980926/performances/HOR17LS26"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "MJ The Illusion - Re-living the King of Pop"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "\n<p>MJ The Illusion is a one-of-a-kind music concert that will\ntake you on a journey through the music, performances,\nand visuals of the King of Pop, Michael Jackson. Through\nthis live performance experience, you'll be immersed in the\nmagic of Michael Jackson's music, from his breakthrough\nalbum 'Off the Wall' to his timeless hits like 'Thriller' and\n'Smooth Criminal' and of course 'Billie Jean.'</p>\n<p>You'll be transported back in time to the golden era of\nMichael Jackson, with a fully immersive experience that\nwill leave you with unforgettable memories. From the\nchoreography to the lights, costumes, and of course, the\nmusic, get ready for the magic of Michael Jackson. This is\nMJ The Illusion. A must-see for all fans of music. MICHAEL\nKNIGHT as Michael Jackson!</p>\n\n<p><a href='https://www.mjtheillusion.com/' target='_blank'>mjtheillusion.com</a></p>\n\n"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
