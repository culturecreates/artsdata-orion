    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://tprowest.ticketpro.ca/en/pages/1696980919/performances/HOR24JA26"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://tprowest.ticketpro.ca/en/pages/1696980919/performances/HOR24JA26"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Beppie"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "\n<p>Beppie (Stephanie Nhan) is a 2x Juno-nominated children's\nmusician and educator from Edmonton, Alberta, whose\nvibrant, high-energy shows and award-winning songs have\ncaptured the hearts of kids and families across Canada.\nHer original music celebrates the curiosity, creativity, and\nemotions of childhood through fun, humour, and heartfelt\nconnection.</p>\n<p>Since 2017, Beppie has released seven albums, earned\ntwo Juno nominations, joined the Recording Academy,\nand signed with Platoon (Apple Music). She won the 2023\nWCMA Children's Artist of the Year award and has received\nmajor support from organizations including the Canada\nCouncil for the Arts and FACTOR.</p>\n<p>With over 25 years of music teaching experience, Beppie\nperforms more than 70 shows annually, and her music has\nbeen streamed over 2 million times worldwide. </p>\n\n<p><a href='https://www.beppiemusic.com/#/' target='_blank'>beppiemusic.com</a></p>\n\n"
      }
    ],
