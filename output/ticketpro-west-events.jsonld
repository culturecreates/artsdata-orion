      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tprowest.ticketpro.ca/genid/12126bdac4b05959"
      },
      {
        "@id": "https://tprowest.ticketpro.ca/genid/7c4f5a123233cc92"
