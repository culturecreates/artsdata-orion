        "@id": "https://tprowest.ticketpro.ca/genid/57649a5e0811d7ce"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://tprowest.ticketpro.ca/en/pages/1695410429/performances/MST28KS27"
