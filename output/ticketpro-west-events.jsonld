    "http://schema.org/offers": [
      {
        "@id": "https://tprowest.ticketpro.ca/genid/8b9bca27097f7350"
      },
      {
        "@id": "https://tprowest.ticketpro.ca/genid/de92eefc047f5b65"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://tprowest.ticketpro.ca/en/pages/1696980923/performances/HOR26KS26"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://tprowest.ticketpro.ca/en/pages/1696980923/performances/HOR26KS26"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "The Barra MacNeils - An East Coast Christmas"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "\n<p>The Barra MacNeils - An East Coast Christmas is a musical\npotpourri of traditional MacNeil family favourites gleaned\nfrom Christmas ceilidhs, midnight masses and the general\nfestive frolic that accompanies each holiday season.\nWith their captivating vocals, distinctive harmonies and\nextraordinary musicianship, The Barra MacNeils inject new\nlife and energy into the sights and sounds of Christmas...\none moment a rousing chorus, then a hauntingly\nbeautiful Gaelic ballad, the next a flurry of foot-stomping\ninstrumentals, which of course pulls one then another into\na step-dancing revelry.</p>\n<p>For a delightful seasonal celebration, don't miss An East\nCoast Christmas with the Barra MacNeils.</p>\n\n<p><a href='https://barramacneils.com/' target='_blank'>barramacneils.com</a></p>\n\n"
      }
    ],
