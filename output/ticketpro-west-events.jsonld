      {
        "@id": "https://tprowest.ticketpro.ca/en/pages/1699818364/performances/DCC02JS26"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "PWR/UP AC/DC ~ CANADA'S PREMIER TRIBUTE"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>PWR/UP. THE Best AC/DC You'll See Without a Time Machine!<br>\nYoung Lads with a Devilish passion for AC/DC, Bringing it to you with all the attitude and power of 1980 when AC/DC was Young and Hungry!<br>\nPWR/UP singer Jon Bon Johnson AGAIN Wins AC/DC World Singer Contest in Europe.. <br>\nBoth Bon and Brian are sung with all the swagger and character that makes them unique, the Vocal transformation is uncanny, complete down to the body language..<br>\nAngus Tone and Riffs for days!!<br>\nGet ready for a Driving night of the finest High Energy Old School AC/DC Rock'n Roll.<br>\nLet There Be Rock.<br>\nLet there Be<br>\nPWR/UP</p><br>\n\n\n<style>\n@media screen and (max-width: 600px){\niframe{width:100%;}\n}\n</style>"
      }
    ],
