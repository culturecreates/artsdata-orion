      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tprowest.ticketpro.ca/genid/0de75a6b75f79263"
      },
      {
        "@id": "https://tprowest.ticketpro.ca/genid/3152cf20ad4263b3"
