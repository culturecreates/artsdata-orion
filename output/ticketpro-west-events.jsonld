    "http://schema.org/name": [
      {
        "@value": "The Heels"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>The Heels, Nashville's Fastest Rising Country Music Queens, are a dynamic trio from Canada now living in Nashville and the West Coast of Canada. The Heels are making waves in the country music scene with their high-energy shows, three-part harmonies, and good-natured brashness. Bobbi, Brittni, and Kyla blend country, pop, and spiritual sounds, creating a soul-deep genre-bending experience. The show will feature their own country Christmas singles as well as seasonal favorites.</p>\n\n<style>\n.titleTax {display: none !important;}\n</style>\n\n"
      }
