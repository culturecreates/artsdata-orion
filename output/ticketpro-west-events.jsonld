      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://tprowest.ticketpro.ca/en/pages/1696980921/performances/HOR14KS26"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Dubé Diamond - Dueling Impersonators"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "\n<p>Martin Dubé and Steeve Diamond imitate the greatest\nhits of your favourite artists from the 1960s until today\nwith electrifying and fast-paced songs, giving you\nthe ultimate nostalgic experience. 60+ hit songs in\n90 minutes!</p>\n<p>Identical singing impressions of 100+ artists like\nAerosmith, Adele, Maria Callas, Tom Jones, Bocelli,\nFrankie Valli and more! This duo of singing impressionists\nwith a 5-octave range has performed in 20+ countries\nand for major productions like Moulin Rouge and the\nAcademy Awards!</p>\n<p>Come experience their seamless jump between the iconic\nvoices of rock, pop, opera and disco in what can only be\ndescribed as vocal fireworks! </p>\n\n\n"
      }
    ],
