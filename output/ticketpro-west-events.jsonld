    "http://schema.org/image": [
      {
        "@id": "https://tprowest.ticketpro.ca/api/v1/resources/1701364871.jpeg?version=1"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tprowest.ticketpro.ca/genid/1051cb5fc8845b7e"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://tprowest.ticketpro.ca/en/pages/1701364969/performances/BBT08JS26"
