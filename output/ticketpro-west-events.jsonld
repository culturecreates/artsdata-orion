    "http://schema.org/name": [
      {
        "@value": "Dance Into Christmas 2026 - The Richmond Academy of Dance"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Celebrating our 27th annual 'Dance Into Christmas' performance on Friday, Dec 4 at 7:30pm at Massey Theatre. A festive and inspiring evening featuring excerpts from Tchaikovsky's Nutcracker with special Guest Artists from Les Grands Ballets Canadiens who will perform the Nutcracker Pas de Deux. Enjoy specially choreographed works, live musicians, and singers performing alongside the Academy!<br><br>\n\nSure to be a magical tradition for the entire family! Join us! </p>\n\n<style>\n.location-page-temp {display: block!important;}\n@media screen and (max-width: 600px){iframe{width:100%;}}\n</style>\n"
      }
    ],
