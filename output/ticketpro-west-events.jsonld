    "http://schema.org/offers": [
      {
        "@id": "https://tprowest.ticketpro.ca/genid/34d7ab67c0bc96ee"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://tprowest.ticketpro.ca/en/pages/1695193953/performances/HOR13KS26"
