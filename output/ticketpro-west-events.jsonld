    "http://schema.org/name": [
      {
        "@value": "Chris Gowen - Mother's Day Magic Show - Spruce's Sunday Series"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "\n<p>Prepare to be amazed by <b>Christopher Gowen</b>, an award-winning magician and master of sleight-of-hand whose high-energy performances combine incredible magic, quick wit and plenty of comedy.</p>\n<p>For more than 15 years, Christopher has entertained audiences across Canada and currently stars in Alberta's longest-running chamber magic show, <i>Handcrafted Magic</i>. Expect impossible moments, plenty of laughs and interactive, never-before-seen magic that brings the audience into the experience.</p>\n<p>Experience Christopher Gowen live at the Black Box Theatre as part of <b>Spruce's Sunday Series</b>.\n</p>\n\n<p><a href='https://chrisgowen.ca/' target='_blank'>chrisgowen.ca</a></p>"
      }
    ],
