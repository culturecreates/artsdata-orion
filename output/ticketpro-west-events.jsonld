      }
    ],
    "http://schema.org/name": [
      {
        "@value": "The Gift - The Words & Music of Ian Tyson"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "\n<p>The Gift was formed 18 years ago when several of Ian\nTyson's former sidemen, collaborators, and admirers\ncame together to celebrate his remarkable songbook.\nWhat began as a single weekend tribute quickly grew\ninto a critically acclaimed production that continues to\nappear at festivals, concert halls, and theatres across\nAlberta and British Columbia.</p>\n<p>Led by pianist and vocalist Stewart MacDougall, who\nwrote, toured, and recorded with Tyson, The Gift has\ncaptivated audiences at venues including the Jack Singer\nConcert Hall, Edmonton Folk Music Festival, Dauphin\nCountryfest, and Centrepointe Theatre. Featuring several\nTyson alumni and acclaimed Canadian musicians, the\nshow explores more than fifty years of Tyson's music—\nfrom Ian and Sylvia and The Great Speckled Bird to his\ncelebrated cowboy and roots recordings.</p>\n\n<p><a href='https://thegifttribute.com/' target='_blank'>thegifttribute.com</a></p>\n\n"
      }
    ],
