      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://tprowest.ticketpro.ca/en/pages/1696980914/performances/HOR12IS26"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://tprowest.ticketpro.ca/en/pages/1696980914/performances/HOR12IS26"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Teagan Littlechief"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "\n<p>Teagan Littlechief is one of Saskatchewan's best-known\ncountry artists, recognized for her bold, soulful voice and\nmulti-octave range. A proud Cree and Saulteaux woman\nfrom White Bear First Nation, she is respected for her\nauthenticity, vocal talent, and cultural pride.</p>\n<p>With over 20 years of performance experience, Teagan\nhas released 13 singles to Canadian and international\nradio, with four reaching #1 on the Indigenous Music\nCountdown and receiving airplay on SiriusXM.</p>\n<p>Teagan is a SaskMusic Award winner, a three-time SCMA\nIndigenous Artist of the Year (2022-2024), and the first\nIndigenous woman to receive the SCMA Female Artist of\nthe Year award (2024). Her live shows blend high-energy\ncountry-rock with emotional storytelling, captivating\naudiences across the Prairies. </p>\n\n<p><a href='https://teaganlittlechief.com/' target='_blank'>teaganlittlechief.com</a></p>\n\n"
      }
    ],
