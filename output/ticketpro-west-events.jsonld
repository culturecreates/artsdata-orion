    ],
    "http://schema.org/url": [
      {
        "@id": "https://tprowest.ticketpro.ca/en/pages/Maclab_BGSDTB2627/performances/MAC14JS26"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Black Gold School Division Teachers' Band - Maclab Wednesday Series"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Ohpaho, Leduc Comp, our very own Black Gold Community Band and a few of the wonderful Music teachers from around the Black Gold School Division are getting together for a special evening of sharing Music. Students will have the opportunity to showcase the skills they have been developing throughout the years. Families, friends and community members are invited to celebrate learning through performances that include concert band and a percussion ensemble! This event encourages confidence, creativity and a love of music while providing students and teachers alike with a chance to share their accomplishments in a safe and supportive setting. We hope you can join us and share the Music together!</p>\n\n\n<p><b><big>Series Subscriptions on sale now: <a href='https://tpromaclab.ticketpro.ca/en/pages/Maclab_WS2627' target='_blank'>Click here to purchase! </a></big></b></p>\n\n<style>\n.location-page-temp {\n    display: block!important;}\n@media screen and (max-width: 600px){iframe{width:100%;}}\n</style>"
      }
    ],
