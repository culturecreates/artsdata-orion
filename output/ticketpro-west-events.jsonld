    ],
    "http://schema.org/name": [
      {
        "@value": "Leduc Composite High School Presents Chicago Teen Edition"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>A satirical look at fame, justice, and media frenzy set in the Jazz Age of the 1920s. With live show-stopping numbers such as 'All that Jazz' and 'Cell Block Tango' performer Velma Kelly and hopeful up-and-comer Roxie Hart ultimately join forces in search of the 'American Dream': fame, fortune... and acquittal!</p><br>\n\n<p>Tickets are available for $20 directly from cast members or by calling LCHS at 780-986-2248. (** Limited tickets are available online for purchase) </p><br>\n\n<p>NOTE: Babies in Arms require a ticket for admission into the theatre.</p><br>\n\n\n\n<style>\n\n@media screen and (max-width: 600px){\niframe{width:100%;}\n}\n</style>"
      }
    ],
