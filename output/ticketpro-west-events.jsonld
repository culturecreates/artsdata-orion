    "http://schema.org/name": [
      {
        "@value": "Dow Centennial Centre | 2026-2027 Shell Theatre Professional Series"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p><b>The best talent from around the world.</b>\n<ul><li>13 Professional Series Shows for one low price!</li> \n<li>Gift Certificate redeemable for one ticket to each of three shows to bring a friend, starting September 7<sup>th</sup><br> \n(Bangs, Bobs & Banter: Confessions of a Hairstylist, Jake's Gift, Pro Coro 'A Christmas Carol')</li>  \n<li>One Month pass to Dow Centennial Centre Apple Fitness (must be used before May 2027)</li> \n<li>One Entry for the 'Season Series Artist Signed Guitar Draw'</li> \n<li>'Behind the Scenes' tour of the theatre operation</li> \n<li>Front of line access to all special presentations </li></ul></p>\n\n<p><b>Bangs, Bobs & Banter: Confessions of a Hairstylist</b> - Saturday, October 3, 2026<br>\n<b>Up on Cripple Creek: The Songbook of the The Band</b> - Friday, October 9, 2026<br>\n<b>Darcy Oake</b> - Saturday, October 17, 2026<br>\n<b>Aaron Goodvin with Tony Stevens</b> - Wednesday, October 21, 2026<br>\n<b>Jake's Gift</b> - Saturday, November 7, 2026<br>\n<b>Stars and Stories Live - Folsom Prison Revisited</b> - Saturday, November 21, 2026<br>\n<b>Pro Coro - 'A Christmas Carol'</b> - Saturday, November 28, 2026<br>\n<b>Leahy - Celtic Roots and Christmas Cheer</b> - Friday, December 4, 2026<br>\n<b>Darla Daniels- Many Miles to Home</b> - Saturday, January 23, 2027<br>\n<b>Oktopus</b> - Friday, January 29, 2027<br>\n<b>The Dreamboats</b> - Saturday, February 20, 2027<br>\n<b>Donovan Woods</b> - Saturday, February 27, 2027<br>\n<b>Alex Cuba</b> - Tuesday, March 16, 2027</p>\n\n\n<style>\n@media screen and (max-width: 600px){\niframe{width:100%;}\n}\n.location-page-temp {\n    display: block!important;\n}\n</style>"
      }
    ],
