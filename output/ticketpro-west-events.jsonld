    "http://schema.org/description": [
      {
        "@value": "<p><b>Local talents and spotlighted artists in our community</b>\n<ul><li>6 Spotlight Series Shows for one low price!</li> \n<li>Gift Certificate redeemable for one ticket to each of three shows to bring a friend, starting September 7<sup>th</sup><br> \n(Don Ross with Julia Malia)</li></ul></p>\n\n<p><b>Mudmen</b> - Friday, October 16, 2026<br>\n<b>Don Ross with Julie Malia</b> - Friday, November 20, 2026<br>\n<b>20th Anniversary Fort's Got Talent</b> - Saturday, January 30, 2027<br>\n<b>Rare Form Theatre 'Arsenic and Old Lace'</b> - Saturday, February 13, 2027<br>\n<b>'The Music of Adele' ft. the Valkyrie String Quartet</b> - Friday, February 19, 2027<br>\n<b>Lewis & Royal</b> - Friday, March 5, 2027</p>\n\n\n<style>\n@media screen and (max-width: 600px){\niframe{width:100%;}\n}\n.location-page-temp {\n    display: block!important;\n}\n</style>"
      }
    ],
