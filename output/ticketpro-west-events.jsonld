    ],
    "http://schema.org/description": [
      {
        "@value": "<p><b>Make a donation to the Chautauqua Edson Arts Council</b></p>\n\n<p>Love Live Music in Edson? Your support brings world-class artists to our stage, keeps our venue doors open, and shares the magic of live performance with more people in our community. Add a little extra today and make the arts shine even brighter.\nPlease note, tax receipts can not be issued for these donations.</p>"
