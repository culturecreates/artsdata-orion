      },
      {
        "@id": "https://tprowest.ticketpro.ca/genid/bff0131aa40282bf"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://tprowest.ticketpro.ca/en/pages/1695836052/performances/MST06BS27"
