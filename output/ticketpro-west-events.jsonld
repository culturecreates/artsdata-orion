    "http://schema.org/name": [
      {
        "@value": "Valkyrie String Quartet - Spruce's Sunday Series"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "\n<p>Experience the beauty and versatility <b>Valkyrie String Quartet</b>, one of Edmonton's most sought-after string ensembles. Featuring four accomplished musicians with extensive experience in chamber and symphonic performance, the quartet is frequently featured in Fever's Candlelight Concert series, while its members perform with some of Alberta's leading orchestras and ensembles.</p>\n<p>For <b>Spruce's Sunday Series</b>, Valkyrie presents a program of classical works and adaptations of loved pop songs in the intimate setting and outstanding acoustics of the Black Box Theatre.\n</p>\n\n<p><a href='https://www.valkyriequartet.com/' target='_blank'>valkyriequartet.com</a></p>"
      }
