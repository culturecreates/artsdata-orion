    "http://schema.org/name": [
      {
        "@value": "Gateway Events Presents Brent Butt"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Brent Butt has long been considered one of the funniest people in Canada, with a career in stand-up comedy that stretches into five decades, including numerous appearances at major festivals in multiple countries and being voted Best Male Stand-Up in Canada by his peers in the profession. He also created and starred in two successful sitcoms - CORNER GAS ('Funniest Show on TV' as voted by TV Guide Readers, currently in 60 countries) and HICCUPS (multiple Leo and Writers Guild Awards). <br><br>\n\n<a href='https://brentbutt.com/' target='_blank'>brentbutt.com</a></p>\n\n<style>\n@media screen and (max-width: 600px){iframe{width:100%;}}\n.location-page-temp {display: block!important;}\n</style>"
      }
