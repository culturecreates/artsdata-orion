    ],
    "http://schema.org/name": [
      {
        "@value": "Montuno West - Spruce's Sunday Series"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "\n<p>Rooted in Afro-Cuban folklore and driven by the energy of Latin jazz, <b>Montuno West</b> blends traditional rhythms with contemporary jazz harmonies and improvisation to create a vibrant, infectious and uplifting sound.</p>\n<p>Their latest album, <i>Raíces</i>, explores ancestry, identity and cultural memory through original compositions. The album reached #3 on the !earshot National Jazz Chart and helped earn the group a <b>2025 Western Canadian Music Award nomination for Jazz Artist of the Year</b>.</p>\n<p>Experience the rhythms and energy of Montuno West live at the Black Box Theatre as part of <b>Spruce's Sunday Series</b>.\n</p>\n\n<p><a href='https://www.montunowest.com/' target='_blank'>montunowest.com</a></p>"
      }
    ],
