    "http://schema.org/name": [
      {
        "@value": "Secondhand Dreamcar"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "\n<p>Secondhand Dreamcar is an explosive soul, roots, and\nblues band from Edmonton made up of veteran Canadian\nmusicians who have worked on some of Alberta's finest\njazz, funk, folk, soul, and blues projects. Together, they\ncraft a distinct, funky, and lyrically driven sound that\njournalist and programmer Peter North called 'the most\nexciting thing to come out of the city since k.d. lang and\nthe Reclines.'</p>\n<p>A favourite on CKUA Radio, the band's debut album\nAnswer The Call was the station's sixth most-played\nalbum of 2024. In 2025, they became instant Alberta\nfestival favourites, performing at the Edmonton and\nCalgary International Blues Festivals and the Edmonton\nFolk Festival. In 2026, the band received three Canadian\nBlues Music Award nominations and a Juno\nnomination for Blues Album of the Year,\nwith a second album set for release this fall.</p>\n\n<p><a href='https://secondhanddreamcar.com/' target='_blank'>secondhanddreamcar.com</a></p>\n\n"
      }
