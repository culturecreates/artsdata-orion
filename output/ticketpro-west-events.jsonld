      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tprowest.ticketpro.ca/genid/51fe62f769f09a3f"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://tprowest.ticketpro.ca/en/pages/1691795679/performances/LSC24IS26"
