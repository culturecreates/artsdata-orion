    "http://schema.org/description": [
      {
        "@value": "<p>Somebody's got the TV remote and their changing the channels! See what happens at the TV station when the shows and commercials go crazy during our fall youth theatre program.  Under the guidance of our outstanding instructors, starting Monday with auditions, participants will create a show in just one week!  Then two great chances for everyone to see and enjoy the show on Saturday!</p>\n\n\n<style>\n@media screen and (max-width: 600px){iframe{width:100%;}}\n.location-page-temp {display: block!important;}\n</style>"
