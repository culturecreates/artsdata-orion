    "http://schema.org/description": [
      {
        "@value": "<p>Includes a ticket to each of the 7 events presented this season:</p>\n\n<p><b>Kellie Loder</b> - Wednesday, October 28, 2026<br>\n<b>Prairie Debut presents Ménestrel with guest artist Vincent Lauzer</b> - Wednesday, November 18, 2026<br>\n<b>The Johner Brothers</b> - Saturday, January 16, 2027<br>\n<b>Oktopus</b> - Wednesday, January 27, 2027<br>\n<b>Sitruc James</b> - Saturday, March 20, 2027<br>\n<b>Jessica Rhaye with Preeper and MacKay</b> - Tueday, April 13, 2027<br>\n<b>The Fugitives</b> - Thursday, April 29, 2027</p>\n\n<style>\n/*-----cache les onglet select seat------*/\n.mat-mdc-tab-header{display:none;}\n</style>\n\n\n"
      }
