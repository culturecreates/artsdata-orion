      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://tprowest.ticketpro.ca/api/v1/resources/1683102301.jpeg?version=1"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tprowest.ticketpro.ca/genid/fea74f6eeec6637e"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://tprowest.ticketpro.ca/en/pages/1683102401/performances/DCC09IS26"
