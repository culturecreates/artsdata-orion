    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://tprowest.ticketpro.ca/en/pages/Maclab_VUDFC/performances/MAC24CS27"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://tprowest.ticketpro.ca/en/pages/Maclab_VUDFC/performances/MAC24CS27"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Viter Ukrainian Dancers and Folk Choir - Maclab Wednesday Series"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Edmonton's Viter Ukrainian Dancers and Folk Choir have become recognized internationally for their energy, innovation, and passion for Ukrainian culture. In over 30 years, Viter has evolved from being a small and enthusiastic group of dancers to a well-rounded and accomplished ensemble, composed of both dancers and choristers. In 2008 Viter's ensemble was further enhanced when a group of singers was formed to expand Viter from a dance group to an ensemble. The result is a group of dancers, choristers, and musicians that create an entertaining and harmonious blend of storytelling, which is unique to Viter. Viter continues to attract talented members with diverse training and extraordinary devotion to preserving and sharing Ukrainian culture and traditions. </p>\n\n<p>Since its inception, Viter has shared their productions with appreciative audiences in Edmonton, across Canada, and around the world. The ensemble has performed to enthusiastic audiences in Brazil, Argentina, Croatia, Austria, and is proud to have returned to Ukraine on 5 separate occasions. Today, Viter is proud to have taken its place among the major performing ensembles in Canada and is recognized for infusing the folk art of traditional Ukrainian song and dance with modern themes that resonate with today's audiences. We invite you to enjoy the sensory spectacle and cultural splendor that is the Viter Ukrainian Dancers and Folk Choir!</p>\n\n<p><a href='https://www.viter.ca/' target='_blank'>Viter.ca</a></p>\n\n<p><b><big>Series Subscriptions on sale now: <a href='https://tpromaclab.ticketpro.ca/en/pages/Maclab_WS2627' target='_blank'>Click here to purchase! </a></big></b></p>\n\n<style>\n.location-page-temp {\n    display: block!important;}\n@media screen and (max-width: 600px){iframe{width:100%;}}\n</style>"
      }
    ],
