    "http://schema.org/name": [
      {
        "@value": "Annika - Spruce's Sunday Series"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "\n<p>Calgary's <b>ANNIKA</b> combines country songwriting with soulful piano playing and rich, melodic vocals, mixing the warmth of country, the groove of soul, the edge of pop and the depth of blues. An iHeartRadio Future Star and <i>Canadian Idol</i> Top 11 finalist, ANNIKA has earned more than one million global streams and collaborated with Canadian country stars Brett Kissel, Chad Brownlee and Carolyn Dawn Johnson.</p>\n<p>Experience ANNIKA's authentic, passionate performance live at the Black Box Theatre as part of <b>Spruce's Sunday Series</b>.\n</p>\n\n<p><a href='https://www.annikamusicofficial.com/' target='_blank'>annikamusicofficial.com</a></p>"
      }
    ],
