    ],
    "http://schema.org/description": [
      {
        "@value": "<b>Doors: 5:00 p.m. | Dinner 6:00 p.m. | Concert: 8:00 p.m.</b><br><br>\n\nAward-winning Canadian singer-songwriter and multi-instrumentalist Shari Ulrich has spent over four decades captivating audiences across North America with insightful songs, warmth, and charisma, recording 25 albums solo and with renowned bands.<br><br>\n\nPlease contact Birgit at Korner Kitchen directly for any dietary restrictions/requests: <a href='mailto:braggskornerkitchen@gmail.com'>braggskornerkitchen@gmail.com</a>.\n\n<style>\n.location-page-temp {display: block!important;}\n</style>"
