    "http://schema.org/name": [
      {
        "@value": "Adam Johnson"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "\n<p>Adam Johnson is an emerging Canadian country\nrock artist from Saskatoon, Saskatchewan. Adam has\nquickly become one of the hottest rising stars on the\nSaskatchewan scene, with five SCMA (Saskatchewan\nCountry Music Association) awards, including Album of\nthe Year and Songwriter of the Year. In addition, he has\nreceived the Male Vocalist of the Year award from the\nPCMA (Prairie Country Music Association), completed\nmultiple Western Canadian tours, and had extensive radio\nsuccess, including three #1's on the Canadian Country\nCountdown and several top 100 songs on the Mediabase\ncharts. With half a million all-time streams and his\nsophomore album scheduled for the fall of 2026,\nJohnson is primed to continue his meteoric rise on\nthe country scene</p>\n\n<p><a href='https://adamjohnsonmusic.net/' target='_blank'>adamjohnsonmusic.net</a></p>\n\n"
      }
