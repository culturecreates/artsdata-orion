    "http://schema.org/name": [
      {
        "@value": "Brent Butt"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Brent Butt has long been considered one of the funniest people in Canada, with a career in stand-up comedy that stretches into five decades, including numerous appearances at major festivals in multiple countries and being voted <b>Best Male Stand-Up in Canada</b> by his peers in the profession. He also created and starred in two successful sitcoms &ndash; <b style='color: red;'>CORNER GAS</b> <i>(&ldquo;Funniest Show on TV&rdquo;i as voted by TV Guide Readers, currently in 60 countries)</i> and <b style='color: red;'>HICCUPS</b> <i>(multiple Leo and Writers Guild Awards)</i></p>\n\n<p><a href='https://brentbutt.com/' target='_blank'>https://brentbutt.com/</a></p>\n\n<p> New book &ldquo;Huge&rdquo; out now</p>\n"
      }
    ],
