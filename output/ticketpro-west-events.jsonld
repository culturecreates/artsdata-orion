      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://tprowest.ticketpro.ca/en/pages/1696980934/performances/HOR10DS27"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://tprowest.ticketpro.ca/en/pages/1696980934/performances/HOR10DS27"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Becoming The Beatles"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "\n<p>An immersive behind-the-scenes journey into the story of\nthe world's most influential band. Featuring 20 live songs,\nmore than 300 projections, and powerful storytelling, the\nshow transcends mere tribute by exploring the origins,\nstruggles, and cultural influences that shaped The Beatles\nand their rise to global fame.</p>\n<p>Through music and historical insight, creator Haley Marie\nreveals how a post-war generation was transformed by\nheartbreak, resilience, classical music, and the influence\nof Black musicians in the American South. Audiences\ndiscover the remarkable story of a band rejected by most\nof the English recording industry before becoming the\nmost successful musical group in history.</p>\n<p>Haley Marie is a touring musician, music historian, and\nthree-time Carnegie Hall performer with a Master of\nMusic from Yale University. </p>\n\n<p><a href='https://www.haley-marie.com/' target='_blank'>haley-marie.com</a></p>\n\n"
      }
    ],
