    ],
    "http://schema.org/description": [
      {
        "@value": "<p>BSSD is a proudly not for profit organization that fosters an appreciation for the arts and the love of dance. We provide students with a respectful and inclusive community in which they can develop important life skills.</p>\n \n<p>BSSD delivers affordable, high quality dance instruction; a leader in the region for dancers at all levels. In doing so, our community of dancers experiences opportunities which lead to personal growth, ongoing development and success within dance and beyond.</p>\n\n<p><a href='https://www.beaumontdance.ab.ca/' target='_blank'>beaumontdance.ab.ca</a></p>\n\n<p><b><big>Series Subscriptions on sale now: <a href='https://tpromaclab.ticketpro.ca/en/pages/Maclab_WS2627' target='_blank'>Click here to purchase! </a></big></b></p>\n\n<style>\n.location-page-temp {\n    display: block!important;}\n@media screen and (max-width: 600px){iframe{width:100%;}}\n</style>"
