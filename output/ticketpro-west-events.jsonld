    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tprowest.ticketpro.ca/genid/a1f987a893ba3240"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://tprowest.ticketpro.ca/en/pages/1694091708/performances/FMC16LS26"
