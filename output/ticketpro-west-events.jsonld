    "http://schema.org/description": [
      {
        "@value": "<p><strong>SUBSCRIPTION:</strong><br />\nIncludes all ten Stars for Saskatchewan Events:</p>\n\n<p><b>Dan Mangan</b> - Saturday, October 3, 2026<br>\n<b>Kellie Loder</b> - Monday, October 26, 2026<br>\n<b>Ménestrel with guest artist Vincent Lauzer</b> - Saturday, November 21, 2026<br>\n<b>Amanda Hagel: These Roots - Take me Home Country Roads Christmas</b> - Sunday, December 6, 2026<br>\n<b>Last Birds</b> - Friday, January 29, 2027<br>\n<b>Sitruc James</b> - Saturday, February 27, 2027<br>\n<b>Burnstick</b> - Saturday, March 13, 2027<br>\n<b>Jessica Rhaye with Preeper and MacKay</b> - Friday, April 9, 2027<br>\n<b>The Fugitives</b> - Wednesday, April 28, 2027<br>\n<b>The Johner Brothers</b> - Thursday, May 13, 2027</p>\n\n<style>\n.location-page-temp {display: block!important;}\n</style>"
      }
