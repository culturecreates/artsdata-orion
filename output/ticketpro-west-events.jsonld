    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://tprowest.ticketpro.ca/en/pages/1695410441/performances/MAC14KS26"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://tprowest.ticketpro.ca/en/pages/1695410441/performances/MAC14KS26"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Paquette Entertainment Presents Walk Like A Man - Featuring Music from Frankie Valli & The Four Seasons"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Walk Like A Man is the ultimate celebration of Frankie Valli & The Four Seasons,\nrecreating the iconic powerful falsetto with perfection.\nProduced by its very own West End star, Mark Halliday, Walk Like A Man has\namazed audiences across the globe from Cardiff to Columbia, from London to\nLithuania, with their incredible vocals, slick moves, infectious charm and timeless\nhits.</p>\n<p>This stunning show will have you hooked from the very beginning and audiences\nwill not be able to resist classics such as 'Can't Take My Eyes Off You', Walk Like a\nMan', 'Sherry', Big Girls Don't Cry', 'Oh, What a Night' and many more.</p>\n<p>Putting their own spin on timeless classics with incredible harmonies and a\ngenuine admiration for the music, this show is a powerhouse not to be missed.\nYou'll see why this show receives standing ovations wherever it goes!</p>\n\n<style>\n@media screen and (max-width: 600px){iframe{width:100%;}}\n.location-page-temp {display: block!important;}\n</style>"
      }
    ],
