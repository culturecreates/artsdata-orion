    "http://schema.org/name": [
      {
        "@value": "Double Bill: Mia Kelly and Eliza Mary Doyle Band"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Two powerhouse voices on one unforgettable night at New Moon Folk Club. Eliza Mary Doyle brings feisty, banjo‑driven alt‑country/folk, all high‑octane energy, sharp songwriting, and 'sweet as honey and raw as hide' delivery. Sharing the bill, rising star Mia Kelly offers a soulful, bilingual blend of folk, rock, and blues, pairing a stunning voice with poetic, emotionally rich storytelling. Together, they deliver a double-dose of fearless songwriting, virtuosic musicianship, and big-hearted stage presence—an intimate, high-energy evening where songs, stories, and harmonies shine.</p>\n\n\n<style>\n.global-tax-label-temp{display:none;}\n\n.location-page-temp {\n    display: block!important;\n}\n@media screen and (max-width: 600px){iframe{width:100%;}}\n</style>"
      }
    ],
