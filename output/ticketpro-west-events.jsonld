    "http://schema.org/name": [
      {
        "@value": "Drive-In Movie Fundraiser - Hocus Pocus: 8:00 P.M. | Nosferatu: 9:30 P.M."
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "\n\nPlease join us for a fun-filled Halloween movie drive in! We are showing a double feature, fan fav 'Hocus Pocus with Bette Midler' and the 1922 silent film (with musical score!) 'Nosferatu'. <br>\n\nPopcorn included in ticket price! We will have soda's for sale, and the Powderhorn saloon will be doing a food special! <br>\n\n<b><i>Bring your snacks, your fav pooch, and your whole fam for a fun-filled night at the drive in with proceeds going directly to the Calgary Humane Society to help animals in need.</b></i>\n\n<style>\n.location-page-temp {display: block!important;}\n</style>"
      }
    ],
