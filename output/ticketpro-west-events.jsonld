    "http://schema.org/name": [
      {
        "@value": "Backyard Betties - Spruce's Sunday Series"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "\n<p>Calgary's <b>Backyard Betties</b> are a vibrant four-piece folk/Americana band celebrated for heartfelt songwriting, rich harmonies and engaging live performances. Blending roots music with clever storytelling, warmth and humour, the Betties bring stories of love, life and loss to the stage. Winners of the <b>2024 YYC Music Award for Folk Recording of the Year</b> for <i>The High</i>, they followed that success with two more YYC Music Award nominations in 2025.</p>\n<p>Experience the Backyard Betties live at the Black Box Theatre as part of <b>Spruce's Sunday Series.\n</b>\n</p>\n\n<p><a href='https://www.backyardbetties.ca/' target='_blank'>backyardbetties.ca</a></p>\n\n"
      }
    ],
