    "http://schema.org/url": [
      {
        "@id": "https://tprowest.ticketpro.ca/en/pages/Maclab_OffTheRails2627/performances/MAC02FS27"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Off The Rails - Maclab Wednesday Series"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p><b>OFF THE RAILS</b> is a family band featuring siblings and cousins april irwin, Brent Cheek, Melanie Cheek, and Judy and Lloyd Jackson. Their rich harmonies and dynamic instrumentation are shaped by years of singing together around the piano and guitar, with their deep-rooted family connection adding an undeniable magic to their sound.</p>\n\n<p>A little old, a little new, and a touch of the unexpected. OFF THE RAILS brings together folk, pop, and original music, blending classic and contemporary influences. Their carefully curated setlist features each of them in turn as lead vocalist, and pays tribute to legendary songwriters like Neil Young, Leonard Cohen, and Glen Campbell, while lauding other Canadian tunes by Fred Eaglesmith, Great Big Sea, William Prince and The Indigo Girls. These alongside Alberta talents Pat Hatherly, Mike Plume, and Jenny Orenstein, and favourite's by Brandi Carlile make for a heady mix of soulful renderings and light hearted toe tappers.</p>\n\n<p><b><a href='https://www.facebook.com/OffTheRails3' target='_blank'>facebook.com/OffTheRails</a></b></p>\n\n<p><b><big>Series Subscriptions on sale now: <a href='https://tpromaclab.ticketpro.ca/en/pages/Maclab_WS2627' target='_blank'>Click here to purchase! </a></big></b></p>\n\n<style>\n.location-page-temp {\n    display: block!important;}\n@media screen and (max-width: 600px){iframe{width:100%;}}\n</style>"
      }
