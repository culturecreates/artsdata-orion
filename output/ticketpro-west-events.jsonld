    "http://schema.org/name": [
      {
        "@value": "Little Miss Higgins - Maclab Performance Series"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Get ready for another fantastic celebration of the bounty through song and story with the incredible country blues artist, <b>Little Miss Higgins</b>. Her 2nd annual Harvest Tour, <b>CORNUCOPIA</b>, is an event not to be missed. With tunes both new and old, Higgins cultivates a heartwarming stage show with her Manitoba Ruckus Band, as well as, a market atmosphere on the merch table with LMH-grown garlic, handmade soap, and much more.</p>\n\n<p><b><a href='http://www.littlemisshiggins.com/' target='_blank'>littlemisshiggins.com</a></b></p>\n<iframe width='560' height='315' src='https://www.youtube.com/embed/kx9SatlINoo?si=11dspDLQGCcu_DqP' title='YouTube video player' frameborder='0' allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share' referrerpolicy='strict-origin-when-cross-origin' allowfullscreen></iframe>\n\n<p><b><big>Subscriptions on sale now: <a href='https://tpromaclab.ticketpro.ca/en/pages/Maclab_2627' target='_blank'>CLICK HERE TO PURCHASE</a></big></b></p> \n\n<style>\n.location-page-temp {\n    display: block!important;}\n@media screen and (max-width: 600px){iframe{width:100%;}}\n</style>"
      }
