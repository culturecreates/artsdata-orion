    "http://schema.org/description": [
      {
        "@value": "<p><b>The Rod Show - The Ultimate Rod Stewart Tribute</b> - Saturday, September 26, 2026<br>\n<b>The Mudmen</b> - Saturday, October 17, 2026<br>\n<b>Gaslighter - Songs of The Dixie Chicks</b> - Saturday, November 14, 2026<br>\n<b>The Ultimate Tribute to the Bee Gees - One Night Only</b> - Saturday, January 23, 2027<br>\n<b>The Ultimate Hits: Tribute to Garth Brooks</b> - Saturday, February 27, 2027<br>\n<b>Brigade - Heart Tribute</b> - Saturday, March 20, 2027<br>\n<b>The Bromantics</b> - Saturday, April 10, 2027</p>\n"
