    ],
    "http://schema.org/url": [
      {
        "@id": "https://tprowest.ticketpro.ca/en/pages/1700388322/performances/MST13BS27"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "I'm A Soulman - A Tribute To The Blues Brothers"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Chris and Geoff Dahl, real brothers from London, Ontario, Canada shared the stage with some of the world's top R&B legends including Buddy Guy, BB King, Chicago Pete, Downchild Blues Band, Powder Blues Band, The Contours, The Miracles, Martha Reeves, Dutch Mason & Jeff Healy to name a few.<br><br>\n\nIt was in 1994 that the real brothers first donned the stage gear made famous by John Belushi and Dan Aykroyd ,during an impromptu Halloween performance at the Old Chicago's blues festival. Following this performance the brothers never looked back and began working their full time R&B tribute under the name of THE SOUL BROTHERS! The Ultimate Tribute to BLUES, RYTHYM & BLUES AND SOUL ! This 2 hour live SOUL BROTHERS show has taken the brothers (Chris and Geoff Dahl) all over the world performing all the hits of legendary r&b recording artists The Blues Brothers, The Isley Brothers, Sam and Dave, James Brown, Ray Charles and more...<br><br>\n\n<iframe width='560' height='315' src='https://www.youtube.com/embed/QnrN7IHYAxk?si=xoaTXUmN5IxgpLBv' title='YouTube video player' frameborder='0' allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share' referrerpolicy='strict-origin-when-cross-origin' allowfullscreen></iframe>\n\n<style>\n.location-page-temp {display: block!important;}\n@media screen and (max-width: 600px){iframe{width:100%;}}\n</style>\n"
      }
    ],
