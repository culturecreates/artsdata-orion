    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://tprowest.ticketpro.ca/en/pages/Maclab_JayGilday/performances/MAC01JS26"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://tprowest.ticketpro.ca/en/pages/Maclab_JayGilday/performances/MAC01JS26"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Jay Gilday - Maclab Indigenous Series"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "\n<p>A vagabond turned mailman, Jay Gilday has searched for himself in the depths of Folk, blues, traditional, rock and soul music. The quest continues as Jay takes his experiences as a half Dene, half Canadian Irish youth travelling the roads of Canada, the daily roller-coaster of work, family, and performance and weaves them into song. Jay's live performance is executed with a trained voice and a passion to drive it backed up by a heavy hitting guitar, finger-style or flat-picked, your choice!</p>\n\n<p><a href='https://www.facebook.com/JayGildayMusic' target='_blank'>Jay Gilday - Facebook</a><br>\n<a href='https://youtube.com/@jaygilday1700?si=TLd9xQsJ4tmHKYhl' target='_blank'>Jay Gilday - Youtube</a><br>\n<a href='https://jaygilday.bandcamp.com/album/faster-than-light' target='_blank'>Jay Gilday - Bandcamp</a><br>\n<a href='https://www.instagram.com/jaygilday' target='_blank'>Jay Gilday - Instagram</a></p>\n\n<style>\n.location-page-temp {\n    display: block!important;}\n@media screen and (max-width: 600px){iframe{width:100%;}}\n</style>"
      }
    ],
