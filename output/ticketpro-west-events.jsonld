      {
        "@value": "Chautauqua Edson Arts Council | 2027 SEASON SUBSCRIPTION"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p><strong>SUBSCRIPTION:</strong><br />\nIncludes all 2027 season events:</p>\n\n<p><b>Ollee Owens</b> - Saturday, January 9, 2027<br>\n<b>Chautauqua Coffee House presents Terra Spenser</b> - Wednesday, February 10, 2027<br>\n<b>Secondhand Dreamcar</b> - Friday, February 26, 2027<br>\n<b>The Unfaithful Servants</b> - Saturday, March 20, 2027<br>\n<b>Trio Fibonacci</b> - Friday, April 23, 2027</p>\n\n\n<p><img src='https://ww2.ticketpro.ca/images/AFA_LOGO.jpg' alt='' width='20%' /></p>\n"
      }
    ],
