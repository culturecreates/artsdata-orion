      },
      {
        "@id": "https://tprowest.ticketpro.ca/genid/dbf6c0ea42b67aae"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://tprowest.ticketpro.ca/en/pages/1688813084/performances/MAJ27AS27"
