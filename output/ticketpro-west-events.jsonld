      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>A Story the Whole Family Will Love!<br>\nWhen Queen Elsa's extraordinary powers plunge Arendelle into an eternal winter, her fearless sister Anna sets off on an unforgettable adventure to bring her home. Joined by the lovable snowman Olaf, rugged mountain man Kristoff, and his loyal reindeer Sven, Anna discovers that the greatest magic of all is the power of love, courage, and family.</p>\n\n\n\n<style>\n\n@media screen and (max-width: 600px){\niframe{width:100%;}\n}\n</style>"
      }
