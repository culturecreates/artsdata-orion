      {
        "@value": "Rare Form Theatre \"Arsenic and Old Lace\""
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Watch what you drink! 'Arsenic and Old Lace' follows a drama critic who discovers his sweet, elderly aunts are poisoning lonely old men with a splash of elderberry wine as an act of 'charity'. See why this screwball farce will have you laughing out loud when Rare Form Theatre returns to the Shell Theatre with two great shows.</p>\n\n<p>Written by: Joseph Kesselring</p>\n\n<p><a href='https://rareformtheatre.com/' target='_blank'>rareformtheatre.com</a></p>\n\n\n<style>\n@media screen and (max-width: 600px){iframe{width:100%;}}\n.location-page-temp {display: block!important;}\n</style>"
      }
    ],
