    "http://schema.org/url": [
      {
        "@id": "https://tprowest.ticketpro.ca/en/pages/1696980925/performances/HOR12LS26"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "God is a Scottish Drag Queen - Christmas Special"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "\n<p>Dressed in an all-new holiday power suit, God returns\nto set the record straight on everything from Yule,\nSaturnalia, and the Winter Solstice to holiday foods,\nChristmas carols, Star Wars, the Nativity story, and\neven Tiny Tim. Blending nostalgia, sharp humour,\nand heartwarming reflection, this holiday favourite\nhas become the most popular show in the series—\nand you'll never look at eggnog the same way again.</p>\n<p>Created and performed by Mike Delamont, a critically\nacclaimed comedian whose credits include CBC's The\nDebaters and Laugh Out Loud, SiriusXM's Top Comic,\nJust For Laughs, and major comedy festivals across\nNorth America. His God Is a Scottish Drag Queen series\nhas sold out theatres across North America for more\nthan a decade.</p>\n\n<p><a href='https://www.mikedelamont.com/' target='_blank'>mikedelamont.com</a></p>\n\n"
      }
    ],
