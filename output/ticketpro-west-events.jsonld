      }
    ],
    "http://schema.org/name": [
      {
        "@value": "A Holly Jolly - Jill Barber Christmas"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Join Jill Barber and her jingly jangly jazz quartet as they take you on a nostalgic musical sleigh ride through decades of beloved Christmas standards. You'll enjoy hot cocoa classics like I'll be Home for Christmas and Rudolph the Red-Nosed Reindeer, seasonal favourites like You're a Mean One, Mr Grinch, and heartfelt originals composed by Barber herself. Expect laughter and tears, and a cup of good cheer, as Jill shares her best Christmas stories and favourite festive songs. A contemporary cross between Judy Gardland and Bing Crosby, a Holly Jolly Jill Barber Christmas is the perfect gift for family and friends, both young and old!</p>\n\n<style>\n.location-page-temp {\n    display: block!important;\n}\n</style>"
      }
    ],
