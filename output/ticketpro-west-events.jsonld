    ],
    "http://schema.org/name": [
      {
        "@value": "The 11 O'clock Number - Christmas Special - Spruce's Sunday Series"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "\n<p>Get ready for a holiday musical unlike any you've seen before! <b>Grindstone Theatre's The 11 O'clock Number - Christmas Special</b> is an award-winning improvised musical comedy where the cast creates a brand-new musical completely on the spot from audience suggestions.</p>\n<p>Accompanied by a live pianist, the performers invent characters, songs, choreography and storylines in real time, turning audience inspiration into a one-of-a-kind Christmas musical that has never been performed before, and will never be performed again.\nCelebrate the season with Grindstone Theatre at the Black Box Theatre as part of <b>Spruce's Sunday Series.\n</b>\n</p>\n\n<p><a href='https://www.grindstonetheatre.ca/' target='_blank'>grindstonetheatre.ca</a></p>"
      }
    ],
