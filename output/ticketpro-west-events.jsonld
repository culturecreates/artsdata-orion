    "http://schema.org/name": [
      {
        "@value": "Tim Isberg"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<b>Doors: 5:00 p.m. | Dinner 6:00 p.m. | Concert: 8:00 p.m.</b><br><br>\n\nFrom Rwanda to Afghanistan, award-nominated singer-songwriter and veteran soldier Tim Isberg shares well-crafted songs and stories inspired by a lifetime of experience. Join us for an evening of music, storytelling, and remembrance.<br><br>\n\nPlease contact Birgit at Korner Kitchen directly for any dietary restrictions/requests: <a href='mailto:braggskornerkitchen@gmail.com'>braggskornerkitchen@gmail.com</a>.\n\n<style>\n.location-page-temp {display: block!important;}\n</style>"
      }
    ],
