      }
    ]
  },
  {
    "@id": "https://persephonetheatre.org/event/where-the-wild-things-are-4/#event",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/description": [
      {
        "@language": "en",
        "@value": ""
      },
      {
        "@language": "en",
        "@value": "Presented by: Sail away to the land of the Wild Things! Jump in and help Max transform his bedroom into an exotic jungle, then transport yourself to where the wild things are. After being crowned king of these magical creatures, Max must make a decision: stay and rule the Wild Things or return home. Together, young ones and their adults can join this wild rumpus – based on the timeless children’s book, Where the Wild Things Are by Maurice Sendak. This production of Where the Wild Things Are is an interactive experience. Audience members will be seated around the performance area on three large mats, with limited chairs provided at the back for grownups who may require a seat. “Based on the iconic children’s book, this production is a perfect introduction to theatre for young audiences, who are invited to visit the fantastical island of the Wild Things, and join the fun in a Wild Rumpus!” – Heather Cant, Artistic Director"
      }
    ],
