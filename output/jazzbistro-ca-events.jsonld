    "http://schema.org/description": [
      {
        "@value": "Shelley Hamilton – vocals Carrie Chesnutt – saxopohone, flute, vocals Sean Bray – guitar Joe Palawan – keys, vocals Roger Williams – bass Paul Antonio – drums The Sade Experience is an immersive, living journey into the heart and soul of a global icon. Created and performed by Shelley Hamilton, this ensemble delivers the ultimate “quiet storm” experience, bringing unparalleled depth and presence to the stage – every song curated for pure immersion. COVER: $20"
      }
