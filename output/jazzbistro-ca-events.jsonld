  {
    "@id": "https://jazzbistro.ca/genid/63b101bd8de8d4b9",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/url": [
      {
        "@id": "https://jazzbistro.ca/event/a-jewish-boys-christmas-3/"
      }
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-12-20T18:30:00-05:00"
      }
    ],
    "http://schema.org/endDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-12-20T21:00:00-05:00"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://jazzbistro.ca/event/a-jewish-boys-christmas-3/"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "A Jewish Boy’s Christmas"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "Sam Broverman – vocals Whitney Ross-Barris – vocals Peter Hill – piano Jordan O’Connor – bass Tony Quarrington – guitar Special Guests: Joseph Landau – vocals and Jordan Chad – author Like a cozy blanket that comforts us on a cold winter night, Christmas music surrounds us and warms our hearts (at least until Christmas is over). So much of the popular music associated with Christmas was written by Jewish songwriters – White Christmas (Irving Berlin), Let It Snow (Sammy Cahn and Jule Styne), The Christmas Song (Mel Torme), to name a few. Sam Broverman brings the joy of Christmas with Christmas standards, hilarious parodies and stories behind the music, leaving you with the understanding that Christmas may also be a little bit Jewish. For almost 15 years Sam has been joined by jazz singer Whitney Ross-Barris and the Jewish Boy’s Philharmonic consisting of Peter Hill on piano, Jordan O’Connor and bass and Tony Quarrington on guitar, with additional special guests each year. This year Sam‘s special guests will be singer Joseph Landau and author Jordan Chad who will introduce his new book “Christmas in the Yiddish Tradition”. Join us this year for this perennially sold-out heart-warming show. COVER: $25"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://jazzbistro.ca/wp-content/uploads/2025/11/A-JEWISH-BOYS-CHRISTMAS-2025.jpg"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://jazzbistro.ca/#place"
      }
    ],
    "http://schema.org/additionalType": [
      {
        "@id": "http://kg.artsdata.ca/resource/JazzPerformance"
      }
    ]
  },
