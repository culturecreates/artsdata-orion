    "http://schema.org/name": [
      {
        "@value": "MISS CHINESE MONTREAL PAGEANT"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Now celebrating its <b>42nd anniversary,</b> the <b>2027 Miss Chinese Montreal Pageant</b> returns for a spectacular evening of elegance, entertainment, and cultural celebration. Join us on <b>September 26</b> as this year's exceptional finalists light up the stage with breathtaking cheongsam presentations, dazzling talent performances, and inspiring displays of confidence and grace. Be there to witness the unforgettable crowning of <b>Montreal's next cultural ambassador</b> and celebrate a cherished tradition that has united and inspired our community for over four decades. <b>Reserve your seats today and experience a night you'll never forget!</b></p>\n\n<style>\n@media screen and (max-width: 600px){\niframe{width:100%;}\n}\n\n</style>"
      }
    ],
