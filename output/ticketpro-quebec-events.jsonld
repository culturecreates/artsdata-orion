    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://tprotsd.ticketpro.ca/en/pages/1699818385/performances/BE02KS26"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://tprotsd.ticketpro.ca/en/pages/1699818385/performances/BE02KS26"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "BEAT - ADRIAN BELEW, STEVE VAI, TONY LEVIN, TERRY BOZZIO"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>BEAT Adrian Belew, Steve Vai, Tony Levin, Terry Bozzio\nPerforming the music of King CrimsonFollowing more than one hundred acclaimed performances across North and South America, Europe, and Japan, BEAT returns this fall for the last North American tour. Former King Crimson members Adrian Belew and Tony Levin are joined by guitar virtuoso Steve Vai and legendary drummer Terry Bozzio to perform the music of the three landmark 1980s King Crimson albums - Discipline, Beat, and Three of a Perfect Pair.\n\n<br><br>\nRather than attempting to recreate the original recordings, BEAT brings this extraordinary music to life with the spirit, precision, and adventurousness that made it so enduring. Whether you've lived with these albums for decades or are discovering them for the first time, this is the final opportunity to experience one of progressive music's most celebrated catalogues, performed by four of the most talented musicians on the planet.\n<br><br>\nFor more information click <a href='https://beat-official.com/home' target='_blank'>here</a>.\n<br>\n<iframe width='560' height='315' src='https://www.youtube.com/embed/In1Ck6OX7z8?si=A3brPyaZT7xI1R33' title='YouTube video player' frameborder='0' allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share' referrerpolicy='strict-origin-when-cross-origin' allowfullscreen></iframe>\n</p>\n\n<p><b>VIP1 On-stage Experience</b>\n<ul>\n<li>One premium reserved ticket </li>\n<li>Watch the show from an exclusive on-stage VIP viewing area</li>\n<li>Early entry into the venue</li>\n<li>Exclusive preshow meet & greet with Adrian Belew, Steve Vai, Tony Levin & Terry Bozzio</li>\n<li>Group photograph with Adrian Belew, Steve Vai, Tony Levin & Terry Bozzio</li>\n<li>Access to a pre-show soundcheck </li>\n<li>Limited edition BEAT tour poster; autographed</li>\n<li>Commemorative BEAT ticket magnet </li>\n<li>Specially designed BEAT record bag</li>\n<li>Exclusive VIP merchandise item</li>\n<li>Official side stage laminate & lanyard</li>\n<li>Very Limited availability </li>\n</ul>\n<br>\n<b>VIP2 Meet & Greet / Soundcheck Experience</b>\n<ul>\n<li>One premium reserved ticket located in the first 5 rows</li>\n<li>Early entry into the venue</li>\n<li>Exclusive preshow meet & greet with Adrian Belew, Steve Vai, Tony Levin & Terry Bozzio</li>\n<li>Group photograph with Adrian Belew, Steve Vai, Tony Levin & Terry Bozzio</li>\n<li>Access to a pre-show soundcheck </li>\n<li>Limited edition BEAT tour poster; autographed</li>\n<li>Commemorative BEAT ticket magnet </li>\n<li>Specially designed BEAT record bag</li>\n<li>Exclusive VIP merchandise item</li>\n<li>Official meet & greet laminate & lanyard</li>\n<li>Limited availability </li>\n</ul>\n<br>\n<b>VIP3 VIP tour Package</b>\n<ul>\n<li>One premium reserved ticket located in the first 15 rows </li>\n<li>Limited edition BEAT tour poster; autographed</li>\n<li>Commemorative BEAT ticket magnet </li>\n<li>Specially designed BEAT record bag</li>\n<li>Exclusive VIP merchandise item</li>\n<li>Commemorative tour laminate & lanyard</li>\n<li>Limited availability </li>\n</ul>\n</p>\n\n<style>\n@media screen and (max-width: 600px){\niframe{width:100%;}\n}\n\n</style>"
      }
    ],
