      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/4afbfe1e15cdf348"
      },
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/0cff2e323046d09e"
