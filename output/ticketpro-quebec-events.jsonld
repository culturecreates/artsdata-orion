      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://tprotsd.ticketpro.ca/api/v1/resources/1705919813.jpeg?version=0"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/1038689a3b0304ce"
      },
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/58b98ffd6aabe3b7"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://tprotsd.ticketpro.ca/en/pages/1705919954/performances/FF08KM26"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://tprotsd.ticketpro.ca/en/pages/1705919954/performances/FF08KM26"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "FERLAND AU FÉMININ - ALEX BAY"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Bien plus qu'un simple spectacle hommage, ce projet s'inscrit dans une relation artistique et humaine de longue date. Alex Bay interprète l'œuvre de Jean-Pierre Ferland depuis 1995, développant au fil des années une compréhension intime de son univers. Cette proximité s'est approfondie lorsque l'artiste a eu l'immense privilège de côtoyer Ferland durant les dix dernières années de sa vie, une période marquante qui a nourri ce projet d'une authenticité rare.<br>\nJean-Pierre Ferland était non seulement conscient de cette démarche, mais profondément fier qu'Alex Bay fasse vivre ses chansons sur scène. Il a même pris le temps d'enregistrer une vidéo la présentant personnellement, vidéo que la chanteuse diffuse encore aujourd'hui au début de ses spectacles, comme un passage de flambeau empreint de respect et de reconnaissance.<br>\nBaignant dans la musique depuis l'enfance, Alex Bay chante dès l'âge de trois ans et se distingue très tôt sur les plateaux de télévision, notamment à L'école du Music-hall et Montréal en direct, où elle atteint la finale d'un concours de jeunes talents. Formée en chant, piano, danse, théâtre et comédie musicale, elle développe une carrière artistique.\nDepuis 1995, elle consacre une place centrale à l'œuvre de Jean-Pierre Ferland à travers le spectacle Ferland au Féminin, présenté à de nombreuses reprises au Québec et en Ontario.<br>\nAccompagnée de Nadine Turbide, Gabrielle Gélinas et d'Emmanuelle Caplette<br></p>\n\n<style>\n@media screen and (max-width: 600px){\niframe{width:100%;}\n}\n\n</style>"
      }
    ],
