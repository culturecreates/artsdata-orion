      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://tprotsd.ticketpro.ca/api/v1/resources/1683102302.jpeg?version=2"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/66884637891f549a"
      },
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/17a4dbd54bf34d89"
