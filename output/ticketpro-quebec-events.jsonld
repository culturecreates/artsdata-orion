    "http://schema.org/name": [
      {
        "@value": "Agnes Obel"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Agnes Obel is a Danish singer-songwriter, pianist, and producer known for her enchanting musical world, where piano, strings, and delicate vocals blend to create an atmosphere that is both intimate and cinematic. Based in Berlin, she has captivated international audiences with acclaimed albums such as <i>Philharmonics</i>, <i>Aventine</i>, and <i>Myopia</i>. Don't miss this evening filled with poetry, emotion, and musical beauty.</p>\n\n<style>\n@media screen and (max-width: 600px){iframe{width:100%;}}\n.tw-seats-selectes-plv {display: none;}\ntw-seats-selectes-plv{display: none !important;}\n</style>\n\n"
      }
