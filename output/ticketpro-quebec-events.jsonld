      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/f5e768645d2785f8"
      },
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/e6bcca24454c16e7"
