      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/7ebe2c80b51e25c9"
      },
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/6439ae06ec44c896"
