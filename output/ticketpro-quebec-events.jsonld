    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-03-04T20:00:00-05:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://ticketpro.ca/place/1"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://tprotsd.ticketpro.ca/api/v1/resources/1694788405.jpeg?version=2"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/411cdf40c7453d44"
      },
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/f016a52db5437911"
      },
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/81adee5db0e90b96"
