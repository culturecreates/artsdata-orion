      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://tprotsd.ticketpro.ca/api/v1/resources/1690765301.jpeg?version=2"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/7b4543297ec254ee"
      },
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/4cc7132095c3786e"
