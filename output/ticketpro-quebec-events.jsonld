    "http://schema.org/name": [
      {
        "@value": "LA NOUVELLE ÉCOLE DES SURDOUÉS - PODCAST"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Lancé en 2018, La Nouvelle École des Surdoués (@nsogpodcast) est un balado animé par Alfredson Jr (@alfredsonjr_), Strange Fruit (@strangefruit_tarah) et The Voice (Patrick). Passionné·es de bandes dessinées, de superhéros et de culture populaire, iels proposent des discussions alliant analyses, humour et débats. À travers des entrevues avec des artistes, auteur·trices, illustrateur·trices et cosplayer·ères, NSOG met également en lumière les talents noir·es et racisé·es de la scène geek. Le balado est régulièrement invité à participer à des événements comme Comiccon Montréal, le Festival BD de Montréal et Festipod.</p>\n\n\n\n<style>\n@media screen and (max-width: 600px){\niframe{width:100%;}\n}\n</style>"
      }
    ],
