        "@id": "https://ticketpro.ca/place/1106826700"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://tprotsd.ticketpro.ca/api/v1/resources/1663624938.jpeg?version=0"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/a2cf84057cb3338f"
      },
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/dc62918eeddef75b"
