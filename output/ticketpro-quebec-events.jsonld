    ],
    "http://schema.org/name": [
      {
        "@value": "Sweet Caroline - un hommage à Neil Diamond"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>The Sweet Caroline Tour: A Tribute to Neil Diamond is putting all those well-loved classics back on stage\nand in the spotlight, showcased by a world-class international band and produced especially for the theatre.<br><br>\nStep back into the glory days of music with this beautiful live tribute concert, featuring Sweet Caroline,\nCherry Cherry, Red Red Wine, Crunchy Granola Suite, Shilo, Heartlight, Forever In Blue Jeans, Girl You'll\nBe a Woman Soon and more.</p>\n<style>\n@media screen and (max-width: 600px){\niframe{width:100%;}\n}\n</style>"
      }
    ],
