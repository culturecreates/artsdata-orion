        "@id": "https://tprotsd.ticketpro.ca/api/v1/resources/1688242963.jpeg?version=2"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/f69c8df3dada0db8"
      },
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/13d0a471179b9b1f"
