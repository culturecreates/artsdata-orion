      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/99008b5ea20d93e7"
      },
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/20954c0964161322"
