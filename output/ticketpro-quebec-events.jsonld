  {
    "@id": "https://ticketpro.ca/event/1699195701",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2026-11-19T20:00:00-05:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://ticketpro.ca/place/1"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://tprotsd.ticketpro.ca/api/v1/resources/1685472503.jpeg?version=2"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/7af90688ade62a9f"
      },
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/57d0cb716ecd7441"
      },
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/c7fdb4f92074a3ab"
      },
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/7fa9a1a4d6601bc2"
      },
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/daea9dc96ba42439"
      },
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/0f244fe0b0840d2d"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://tprotsd.ticketpro.ca/en/pages/1685472603/performances/TSD19KS26"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://tprotsd.ticketpro.ca/en/pages/1685472603/performances/TSD19KS26"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Undertale: The Determination Symphony"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p><b><i>UNDERTALE: The Determination Symphony</i></b> is an unforgettable concert experience featuring the most memorable themes from the hit indie game, newly arranged and performed live by a 25- piece orchestra. With gameplay footage displayed on a screen above the stage, audiences will be fully immersed in the world of <i>UNDERTALE</i>, experiencing its story and music like never before.</p>\n\n<p><b><i>Toby Fox</i></b>, creator and composer of <i>UNDERTALE</i>, shared his excitement: <i>'UNDERTALE is a game with a lot of music, it's good when skilled professionals play the music and people listen to it.'</i>;</p>\n\n<p>Concert-goers can look forward to being filled with determination as the performance guides them through the Underground. From the Ruins and Snowdin to Waterfall, Hotland, and finally New Home, the concert brings iconic characters, battles, and emotional moments vividly to life through music.</p>\n\n<style>\n@media screen and (max-width: 600px){iframe{width:100%;}}\n</style>"
      }
    ],
