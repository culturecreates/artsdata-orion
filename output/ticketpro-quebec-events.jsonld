    ],
    "http://schema.org/name": [
      {
        "@value": "Véronic DiCaire"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Véronic DiCaire - back with her BRAND NEW SHOW!<br><br>\n\nFollowing the success of her last show - which won the Félix Award for 'Show of the Year' at the\nADISQ - Véronic is finally back with her brand new show Une soirée avec Vé!</p>\n\nThe multi-talented artist is in the mood to have some fun and is treating audiences to a musical\nshow filled with the greatest hits and the greatest voices. There will undoubtedly be humor and\nimpersonations, but this time around, Véronic wants to put emotions front and center. She is\ntherefore preparing a show that reflects who she is and promises to give us an exceptional\nevening.</p>\n\n<style>\n@media screen and (max-width: 600px){iframe{width:100%;}}\ntw-seats-selectes-plv{display: none !important;}\n</style>\n"
      }
