    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/28be5fbd5b12f17c"
      },
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/52f42f14fa6f4d28"
