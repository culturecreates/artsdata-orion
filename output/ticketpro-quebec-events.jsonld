    "http://schema.org/url": [
      {
        "@id": "https://tprotsd.ticketpro.ca/en/pages/1698308558/performances/12H28CM27"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "12 Hommes en colère"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>A 12-man jury must decide the fate of a young Latin American man accused of killing his father. The evidence against him is overwhelming. A verdict seems imminent. While the deliberations appear to be a mere formality, one juror has the courage to look beyond his own convictions and prejudices and will do everything in his power to raise the inalienable reasonable doubt. A portrait of society that depicts human nature at its best and worst. A profound reflection on America—both of the past and of the present...\n</p>\n\n<style>\n@media screen and (max-width: 600px){\niframe{width:100%;}\n}\n</style>"
      }
    ],
