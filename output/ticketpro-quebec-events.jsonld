    "http://schema.org/name": [
      {
        "@value": "AU CONFESSIONNAL - MASTERCLASS - PODCAST"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Invités : <br>\n<b>Audrey Morissette</b>, participante de <i>Survivor Québec S2</i>, gagnante des <i>Traîtres S2</i> et participante à <i>La Maison des vilains S1</i>.<br>\n<b>Kathrine Huet</b>, participante à <i>Survivor Québec S3</i> et gagnante de <i>Survivor Québec S4</i>.<br>\n<b>Kevin-Kyle</b>, participant à <i>Loft Story S3 et S6</i>, gagnant de <i>Hors réseau : L'expérience S1</i> et participant à <i>La Maison des vilains S1</i>.<br>\n<b>Kevin Lapierre</b>, participant à <i>OD Afrique du Sud, OD Chez Nous et <i>Big Brother Célébrités S1</i>.<br>\n<br><br>Plongez dans l'univers des télé-réalités avec 'Au confessionnal', animé par Marc-Antoine Berthiaume. Chaque semaine, Marc-Antoine explore les coulisses, les stratégies et les secrets de vos émissions préférées avec des analyses percutantes, des entrevues exclusives et des révélations surprenantes.</p>\n\n<style>\n.location-page-temp {display: block!important;}\n@media screen and (max-width: 600px){\niframe{width:100%;}\n}\n</style>"
      }
    ],
