    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://tprotsd.ticketpro.ca/en/pages/1705675402/performances/NDT17JS27"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://tprotsd.ticketpro.ca/en/pages/1705675402/performances/NDT17JS27"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "NEIL DEGRASSE TYSON - COLLISIONS COSMIQUES"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p><b>Cosmic Collisions</b><br><br>\n\nAll the things that go bump in the night (and in the day). And yes, the universe wants to kill you!  On occasion these collisions - asteroid and comets - impacts on Earth and renders life extinct.   Learn why and how this happens and what we are doing about it.<br><br>\n\n<small>All talks fully illustrated with curated slides & occasional videos -NO flash photography or videos allowed.  Suitable for all ages.</small><br><br>\n\n<b>VIP Post Show Question & Answer includes:</b>\n<br> Premium seating along with a post-show talk with Dr. Tyson and a group photo using a professional photographer.  VIP guests will be able to access the photo on a link that will be provided to them along with an autographed poster signed by Dr. Tyson.  Please remain in your seats after the show for additional instructions. </p>\n\n<style>\n@media screen and (max-width: 600px){\niframe{width:100%;}\n}\n\n</style>"
      }
    ],
