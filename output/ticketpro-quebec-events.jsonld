    "http://schema.org/url": [
      {
        "@id": "https://tprotsd.ticketpro.ca/en/pages/1702069525/performances/CMG08JS27"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Christian Marc Gendron - Trilogie - Édition Spéciale - Dernière représentation à Montréal"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Following the phenomenal success of the <i>PianoMan</i> concert series, which has drawn more than 160,000 attendees across Quebec in recent years, Christian Marc Gendron returns to the stage in April 2026 with a brand-new show: <i>Trilogy</i>.</p>. \n<br><br>\nThis unique concept will bring together the best numbers from his last three tours, in addition to featuring new creations inspired by the repertoire of piano legends such as <b>Jerry Lee Lewis, Ray Charles, Stevie Wonder, Elton John, and, of course, Billy Joel</b>. The show will also include a tribute to <b>Gino Vannelli</b> as well as several humorous moments delivered in the way only Christian Marc Gendron knows how.\n<br><br>\nWith <b><i>Trilogy</i></b>, Christian Marc Gendron invites you into his incomparable musical and theatrical world, accompanied as always by his nine-piece band under the musical direction of Simon Godin and featuring a special guest appearance by Manon Séguin.\n</p>\n\n<style>\n@media screen and (max-width: 600px){\niframe{width:100%;}\n}\n\n</style>"
      }
    ],
