    ],
    "http://schema.org/image": [
      {
        "@id": "https://tprotsd.ticketpro.ca/api/v1/resources/1678588398.jpeg?version=2"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/12ae42924c3cafcd"
      },
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/e36e69a25a7fec59"
