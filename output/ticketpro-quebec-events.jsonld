      {
        "@type": "http://schema.org/Date",
        "@value": "2026-12-16T20:30:00-05:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://ticketpro.ca/place/1411850201"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://tprotsd.ticketpro.ca/api/v1/resources/1688242963.jpeg?version=2"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/34425df2f69253a1"
      },
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/3e6c4e782182f765"
      },
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/12f4b5cc9042204b"
