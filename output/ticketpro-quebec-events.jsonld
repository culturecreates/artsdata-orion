    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Le podcast 'Ah Bain' est un podcast humoristique décalé où je reçois un nouvel invité à chaque épisode afin de lui poser un paquet de questions dont on se fout de la réponse! \nIl s'agit également du seul podcast dans un bain, ce qui crée un cadre confortable et convivial, pour des questions impertinentes au possible.\n</p>\n\n\n\n<style>\n@media screen and (max-width: 600px){\niframe{width:100%;}\n}\n</style>"
      }
