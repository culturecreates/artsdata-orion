  {
    "@id": "https://ticketpro.ca/event/1703959201",
    "@type": [
      "http://schema.org/Event"
    ],
    "http://schema.org/startDate": [
      {
        "@type": "http://schema.org/Date",
        "@value": "2027-01-22T20:00:00-05:00"
      }
    ],
    "http://schema.org/location": [
      {
        "@id": "https://ticketpro.ca/place/1411850201"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://tprotsd.ticketpro.ca/api/v1/resources/1686488021.jpeg?version=0"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/00092d91009d37d6"
      },
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/793656f33d20d8f0"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://tprotsd.ticketpro.ca/en/pages/1686265642/performances/MBCS22AS27"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://tprotsd.ticketpro.ca/en/pages/1686265642/performances/MBCS22AS27"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Mathieu Bock-Côté"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p><b>Le Québec à l'épreuve du monde moderne</b><br>\n<i>Une réflexion vivante, suivie d'une discussion ouverte avec la salle</i><br><br>\nAvec Mathieu Bock-Coté<br><br>\nDans un monde en pleine redéfinition, le Québec oscille entre affirmation et effacement.\nFaut-il résister ou s'intégrer à la culture globale ? Entre mémoire et adaptation, identité\net conformisme, une question s'impose : avons-nous encore la volonté de faire des\nchoix clairs face aux défis de l'avenir ?<br><br>\nUne conférence pour bousculer les certitudes et nourrir la réflexion. Situer notre place\ndans le monde, éclairer les enjeux à venir, revisiter notre héritage sans nostalgie ni\nrenoncement.<br><br>\nUn moment pour penser autrement — et pour échanger, librement.<br><br>\n\n<b>Mathieu Bock-Côté</b> est sociologue, essayiste et chroniqueur. Né au Québec, il s'est\nimposé comme l'une des voix influentes du débat intellectuel contemporain sur les\nquestions d'identité, de nation et de culture. Collaborateur régulier dans plusieurs\nmédias au Québec et en France, il est reconnu pour ses analyses critiques du\nmulticulturalisme et de la modernité occidentale. Auteur de nombreux essais, il défend\nune vision enracinée de la société, attachée à la mémoire et à la continuité historique.</p>"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
