    "http://schema.org/offers": [
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/0abbc71cd65fd178"
      },
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/13b485ed670a32a4"
