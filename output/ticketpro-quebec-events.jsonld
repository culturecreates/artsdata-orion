    "http://schema.org/name": [
      {
        "@value": "LES SACOCHES S'A POUD - PODCAST"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Invitée : <b>Josiane Aubuchon</b>\n<br><br>\nFrance D'Amour et Geneviève Gagnon, deux belles sacoches sur le kombucha qui rient et qui parlent trop fort mais à la fois tellement attachantes! Elles jasent sans filtre comme lorsqu'elles se retrouvent autour d'un feu et racontent des anecdotes savoureuses de gaffes sur la scène ou de moments inédits d'histoires de coulisse! Elles reçoivent des artistes de différents univers donc une chose est certaine, on ne s'ennuie pas avec Les Sacoches! </p>\n\n\n<style>\n@media screen and (max-width: 600px){\niframe{width:100%;}\n}\n</style>"
      }
    ],
