    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://tprotsd.ticketpro.ca/en/pages/1663625040/performances/SE13IS26"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://tprotsd.ticketpro.ca/en/pages/1663625040/performances/SE13IS26"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "SERGE FIORI - SEUL ENSEMBLE"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>\n<i>Serge Fiori - Seul ensemble</i>, nouvelle mouture du spectacle présenté pour la première fois le 6 mars 2019 au Théâtre St-Denis, propose une relecture audacieuse et visuelle de l'œuvre de Serge Fiori.<br>\n\nOn y retrouve ses moments forts, enrichis de nouveaux passages inspirés des sept dernières années, dont <i>Kwe</i>, un projet musical dont Serge était particulièrement fier.<br>\n\nLa musique demeure le fil conducteur du spectacle. Revisitées par Louis-Jean Cormier, Alex McMahon et Guillaume Chartrain, les chansons intemporelles de Serge continuent d'unir les générations et de nourrir l'imaginaire collectif.<br>\n\nLe Cirque Éloize, complice de la création originale, est de retour sous la direction de Benoit Landry (<i>Chicago</i>) qui revisitera la mise en scène.<br>\n\nQuant aux décors, détruits lors du déluge du 16 août 2024, ils seront entièrement repensés pour offrir une scénographie renouvelée.<br>\n\n<i>Serge Fiori - Seul ensemble</i>, un voyage musical et visuel où l'âme de Serge Fiori continue de résonner, encore et toujours...</p>"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
