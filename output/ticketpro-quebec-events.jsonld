    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/ba49a96cb76751a6"
      },
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/db3a555e51d5af1d"
