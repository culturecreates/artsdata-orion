    ],
    "http://schema.org/image": [
      {
        "@id": "https://tprotsd.ticketpro.ca/api/v1/resources/1665115354.jpeg?version=1"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/b3d5778354e42e96"
      },
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/6f9849e3a5d8799b"
