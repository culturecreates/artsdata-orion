    "http://schema.org/description": [
      {
        "@value": "<p>Invitée : <b>Mitsou</b>\n<br><br>\nDans Ouvre ton jeu, les invités ouvrent leur cœur à une animatrice aguerrie, autour d'un jeu de cartes unique. Réflexions, prises de conscience, confidences : au hasard des cartes- questions retournées, l'invité de Marie-Claude se révèle comme il ne l'a jamais fait et utilise son pouvoir de joueur pour la faire parler à son tour.</p>\n\n\n\n<style>\n@media screen and (max-width: 600px){\niframe{width:100%;}\n}\n</style>"
      }
