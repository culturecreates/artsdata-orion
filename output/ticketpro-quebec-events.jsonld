    "http://schema.org/name": [
      {
        "@value": "LES ENGAGÉS PUBLICS - PODCAST"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>En pleine campagne électorale québécoise, Les Engagés Publics s'installent au Festipod pour une discussion engagée sur la politique et les grands enjeux sociaux du Québec. Sans trop se prendre au sérieux, Denis Martel reçoit trois créatrices de contenu bien connues : Micha Horswill, Anne-Marie Gagné (Poetry Panacée) et Alexandrine Beauvais-Lamoureux. Trois femmes, trois regards, pour discuter de ce qui anime, divise et fait avancer le Québec.</p>\n\n\n\n<style>\n@media screen and (max-width: 600px){\niframe{width:100%;}\n}\n</style>"
      }
