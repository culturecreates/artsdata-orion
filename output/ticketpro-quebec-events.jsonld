      }
    ],
    "http://schema.org/name": [
      {
        "@value": "Québec-Montréal sur scène"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p><b>The hit production <i>Québec-Montréal sur scène</i> eturns to the stage in 2027 !</b><br><br>\n\nAfter captivating <b>nearly 40,000 audience members</b>, the stage adaptation of the beloved Québec film returns with its entire original cast. <b>Patrick Emmanuel Abellard, Charlotte Aubin, Catherine Brunet, Louis Carrière, Pier-Luc Funk, Mickaël Gouin, Simon Pigeon and Antoine Pilon</b> will reprise their roles under the direction of Pierre-François Legendre.</b>.<br><br>\n\n<b>Synopsis</b><br>\n\n250 kilometres of highway, seven travellers in their thirties, one destination. On Highway 20, three friends discuss ideal love, two colleagues navigate an ambiguous romance, and a young couple faces an impending breakup. Through humour, unspoken feelings and moments of realization, the journey offers a chance to reflect on relationships and the paths life takes.\n\n</p>\n\n<style>\n@media screen and (max-width: 600px){\niframe{width:100%;}\n}\n</style>"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
