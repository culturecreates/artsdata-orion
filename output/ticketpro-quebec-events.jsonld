      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/c9a7f8b3a4a9b588"
      },
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/aacbd62a3aeaf063"
