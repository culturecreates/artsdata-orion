      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/6f1893254e688112"
      },
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/75e2e4cc2f9c926e"
      },
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/08c0d05fd1b538af"
      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://tprotsd.ticketpro.ca/en/pages/1664763303/performances/PUH03KS26"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://tprotsd.ticketpro.ca/en/pages/1664763303/performances/PUH03KS26"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "POUR UNE AUTRE HISTOIRE D'UN SOIR"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Pour une autre histoire d'un soir\nTrois des plus belles voix du Québec, Joe Bocan, Marie Carmen et Marie\nDenise Pelletier, se retrouveront de nouveau ensemble sur scène, avec\n<i>Pour une autre histoire d'un soir</i>, une version revisitée du spectacle qui\nleur a valu le Félix du Spectacle de l'année Variétés/Réinterprétations\nen 2022 et plus de 50,000 spectateurs.<br><br>\nDans une mise en scène renouvelée de Michel Poirier, voici un spectacle\nqui n'aura rien perdu de son charme. Un hommage à l'auteur-\ncompositeur-interprète Germain Gauthier, décédé en août dernier,\ns'inscrira parmi les nouveautés. Et rassurez-vous : la rumeur veut que\n<i>L'aigle noir</i> <i>Repartir à zéro</i> et <i>Tous les cris les S.O.S.</i> soient de nouveau\nau programme !<br><br>\n<i>Pour une autre histoire d'un soir</i> est une occasion pour les fans de la\npremière heure de revivre des moments inoubliables tout en\ndécouvrant quelques surprises. Pour les autres, l'occasion de\ncomprendre pourquoi ce spectacle a récolté tant d'éloges de la part du\npublic et des critiques.<br><br>\n<i>Pour une autre histoire d'un soir</i>, la porte s'ouvre sur une nouvelle\naventure où se reflètent le meilleur du passé et des découvertes de\ngrande envergure.</p>\n\n<p>90 minutes sans entracte</p>\n\n<iframe width='560' height='315' src='https://www.youtube.com/embed/bCRfwKYKBr8?si=gpfGsOYDtOofOiHB' title='YouTube video player' frameborder='0' allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share' referrerpolicy='strict-origin-when-cross-origin' allowfullscreen></iframe>\n<style>\n@media screen and (max-width: 600px){\niframe{width:100%;}\n}\ntw-seats-selectes-plv{display: none !important;}\n</style>"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
