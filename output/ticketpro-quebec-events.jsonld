        "@id": "https://ticketpro.ca/place/1411850201"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://tprotsd.ticketpro.ca/api/v1/resources/1691567709.jpeg?version=0"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/1d3e588e252ad517"
      },
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/ef88b2dadfbeb612"
