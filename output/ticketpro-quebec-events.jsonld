      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://tprotsd.ticketpro.ca/api/v1/resources/1692857375.jpeg?version=2"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/c9e44cec4f9badc7"
      },
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/5047ceda538d671e"
