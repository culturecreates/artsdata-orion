    "http://schema.org/name": [
      {
        "@value": "LA PAIRE D'ÉCOUTEURS - PODCAST"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>La Paire d'Écouteurs est un balado de critiques musicales, de suggestions et de chroniques en lien avec la musique d'ici et d'ailleurs. Récipiendaire de deux prix Lucien pour le balado de l'année lors des galas GAMIQ 2024 et 2025. Animé par Jertrude Battue et ses comparses, c'est la fête de la musique à chaque édition!</p>\n\n\n<style>\n@media screen and (max-width: 600px){\niframe{width:100%;}\n}\n</style>"
      }
    ],
