      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/c56660e7c6862dbe"
      },
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/aef0bfeff05bde5e"
