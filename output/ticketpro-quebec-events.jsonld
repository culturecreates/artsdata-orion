        "@id": "https://ticketpro.ca/place/1"
      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://tprotsd.ticketpro.ca/api/v1/resources/1704353522.jpeg?version=3"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/4d38596243e6c66b"
      },
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/582576e6ae549281"
      },
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/e6bda9720087fa72"
