    "http://schema.org/name": [
      {
        "@value": "ABBA CELEBRATION"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Inspired by the famous Mamma Mia! musical, Montreal presents the ABBA CELEBRATION dinner show, a completely reimagined take on this global phenomenon.\n</p>\n<p><b>Dinner & Shows December Fall 2026</b><br>\nDoors open at 6:00 pm, and the meal is served from 6:30 pm. To fully enjoy your meal, we recommend arriving before 7:00 pm.<br><br>\nDiscover the menu by <a href='https://esd2026.tor1.digitaloceanspaces.com/uploads/menuabba-01.pdf' target='_blank'>clicking here.</a></p>\n\n\n<iframe width='560' height='315' src='https://www.youtube.com/embed/g4btF7youWE?si=052ycsWjz8uH4Pm2' title='YouTube video player' frameborder='0' allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share' referrerpolicy='strict-origin-when-cross-origin' allowfullscreen></iframe>\n\n<style>\n@media screen and (max-width: 600px){iframe{width:100%;}}\n.tw-seats-selectes-plv {display: none;}\ntw-seats-selectes-plv{display: none !important;}\n</style>"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
