      }
    ],
    "http://www.w3.org/ns/prov#wasDerivedFrom": [
      {
        "@id": "https://tprotsd.ticketpro.ca/en/pages/1688813060/performances/CAL19CS27"
      }
    ],
    "http://schema.org/url": [
      {
        "@id": "https://tprotsd.ticketpro.ca/en/pages/1688813060/performances/CAL19CS27"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "CALIENTE!"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "\n<p><b>CALIENTE! - Latin Heat in the Heart of Winter<br>\nStarting March 18, 2027 at the Studio St-Denis</b></p>\n\n<p>In the middle of the Quebec winter, the Studio St-Denis transforms into a vibrant Latin <i>plaza</i> where the party never stops! <b>CALIENTE!</b> is the dinner-show that will melt the cold season away. A Latin-inspired production combining gastronomy, panoramic projections, and fiery performances to warm up the winter. A festive and flavourful evening.</p>\n\n<p>On stage, Franck Gomez, Noderlis Valdes, and Andy Rubal join their voices alongside their musicians and the dancers of Jhaime Vega and the Alliance Dance Company. A whirlwind of southern rhythms—salsa, cha-cha, merengue, bolero, mambo, and bachata. From <i>Chan Chan</i> to <i>Guantanamera</i>, from <i>Suavemente</i> to <i>Danza Kuduro</i>, each scene transports the audience to a new, colourful destination.</p>\n\n<p>Artistic direction and staging are by Vincent Egret, musical direction by Andy Rubal, and electrifying choreography by Jhaime Vega, leader of the Alliance Dance Company.</p>\n\n<p><b>A Total Immersion</b><br>\nThanks to Pierre Raiche's 360° projections and Martin Boisclair's lighting design, the show plunges spectators into a spectacular visual and sonic journey: the streets of Havana, Caribbean beaches, and New York's salsa clubs. A true explosion of energy, colour, and shared joy!</p>\n\n<p><b>The Dinner-Show Experience</b><br>\nTo extend the celebration, Le Molière restaurant offers a Latin-Caribbean sharing board menu.</p>\n\n<p><b>DINNER IS AT THE HEART OF THE SHOW EXPERIENCE!</b><br>\nDiscover the menu by <a href='https://esd2026.tor1.digitaloceanspaces.com/uploads/caliente-1.pdf' target='_blank'>clicking here</a>. The menu may vary without notice.<br>\nDoors open at 6:00 PM, and dinner is served from 6:30 PM. To fully enjoy your meal, we recommend arriving before 7:00 PM.</p>\n\n\n<iframe width='560' height='315' src='https://www.youtube.com/embed/wN0k54r4OyI?si=WBC97HCEGeI5h4xB' title='YouTube video player' frameborder='0' allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share' referrerpolicy='strict-origin-when-cross-origin' allowfullscreen></iframe>\n\n<style>\n@media screen and (max-width: 600px){iframe{width:100%;}}\n.tw-seats-selectes-plv {display: none;}\ntw-seats-selectes-plv{display: none !important;}\n</style>\n\n"
      }
    ],
    "http://schema.org/eventAttendanceMode": [
      {
        "@id": "http://schema.org/OfflineEventAttendanceMode"
      }
    ],
    "http://schema.org/eventStatus": [
      {
        "@id": "http://schema.org/EventScheduled"
      }
    ]
  },
