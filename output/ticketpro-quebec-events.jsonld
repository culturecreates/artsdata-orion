      }
    ],
    "http://schema.org/image": [
      {
        "@id": "https://tprotsd.ticketpro.ca/api/v1/resources/1695797173.jpeg?version=2"
      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/b898ea94ff8fdead"
      },
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/3bbad3b62a92ca92"
      },
      {
