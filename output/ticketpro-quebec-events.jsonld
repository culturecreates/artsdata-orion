    "http://schema.org/url": [
      {
        "@id": "https://tprotsd.ticketpro.ca/en/pages/1701043068/performances/SR09IM26"
      }
    ],
    "http://schema.org/name": [
      {
        "@value": "La relève en spectacle - Hors Programme : l'événement de la rentrée"
      }
    ],
    "http://schema.org/description": [
      {
        "@value": "<p>Before Roxane Bruneau wows her fans, five up-and-coming artists from the music scene will perform for free in front of a live audience in the lobby of Studio St-Denis. These young artists are the winners of Cégeps en spectacle and UQAM en spectacle. This initiative is a collaboration with UQAM and RIASQ, as part of Montréal faites du bruit, with the goal of providing a showcase for up-and-coming artists.\nCome discover <a href='https://www.youtube.com/channel/UCHp4lZyRMht2zT8ya2k0rZA' target='_blank'>Will Verreault</a>, <a href='https://www.youtube.com/channel/UC7xSYxojzi0_UDBi0ttGyGQ' target='_blank'>Ludovick Roussy</a>, <a href='https://www.youtube.com/channel/UCkbwVvPYhRM-NP7Oef6wL4A' target='_blank'>EmbaLe!</a>, <a href='https://www.youtube.com/watch?v=siwAMY8d_8E' target='_blank'>Félix St-Jean</a> and <a href='https://www.youtube.com/channel/UCu-yYHoP_8N2IW3rfMa0nqg' target='_blank'>Scrive</a>\n</p>\n\n<style>\n@media screen and (max-width: 600px){\niframe{width:100%;}\n}\n\n</style>"
      }
    ],
