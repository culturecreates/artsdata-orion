      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/bbc2c3770689c8ba"
      },
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/900f582b6ab8f96b"
