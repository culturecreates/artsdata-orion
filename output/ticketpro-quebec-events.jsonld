    "http://schema.org/offers": [
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/37a2a09afaa8e717"
      },
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/088c1505c3d2428e"
