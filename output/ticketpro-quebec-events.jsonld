      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/bf3a807f104075c1"
      },
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/d7fa9626bfb5eaf0"
