      }
    ],
    "http://schema.org/offers": [
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/9fcd52a8f253bc5a"
      },
      {
        "@id": "https://tprotsd.ticketpro.ca/genid/804b97a407492d65"
