# Custom transform for the persephonetheatre.org crawl
# (.github/workflows/persephonetheatre-org.yml), applied per event page.
#
# The Events Calendar gives each event's location Place a schema:sameAs that
# points to the event's own page on persephonetheatre.org. That link says
# nothing about the venue, so remove it. Other sameAs values (e.g. Wikidata)
# are kept. The workflow also excludes Place sameAs from skolemization so
# the venue keeps the same ID across events.

DELETE {
  ?place <http://schema.org/sameAs> ?sameAs .
}
WHERE {
  ?place a <http://schema.org/Place> ;
    <http://schema.org/sameAs> ?sameAs .
  FILTER(STRSTARTS(STR(?sameAs), "https://persephonetheatre.org/") || STRSTARTS(STR(?sameAs), "http://persephonetheatre.org/"))
}
